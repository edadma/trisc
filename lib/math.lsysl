Math Utilities

Basic integer math operations for the Sysl standard library.
No OS dependency — usable in bare-metal programs.

      abs(x: int) -> int
          if x < 0
              return -x
          x

      min(a: int, b: int) -> int
          if a < b
              return a
          b

      max(a: int, b: int) -> int
          if a > b
              return a
          b

      clamp(x: int, lo: int, hi: int) -> int
          if x < lo
              return lo
          if x > hi
              return hi
          x

      sign(x: int) -> int
          if x < 0
              return -1
          if x > 0
              return 1
          0

      gcd(a: int, b: int) -> int
          var x = abs(a)
          var y = abs(b)
          while y != 0
              val t = y
              y = x % y
              x = t
          x

      pow(base: int, exp: int) -> int
          var result = 1
          var b = base
          var e = exp
          while e > 0
              if e & 1 == 1
                  result *= b
              b *= b
              e = e >> 1
          result
