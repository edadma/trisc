@main
Math Utilities

Basic integer math operations for the Sysl standard library.
No OS dependency — usable in bare-metal programs.
@

@api abs(x) -> int — Return the absolute value of x.

  abs(x: int) -> int
      if x < 0
          return -x
      x

@api min(a, b) -> int — Return the smaller of a and b.

  min(a: int, b: int) -> int
      if a < b
          return a
      b

@api max(a, b) -> int — Return the larger of a and b.

  max(a: int, b: int) -> int
      if a > b
          return a
      b

@api clamp(x, lo, hi) -> int — Clamp x to the range [lo, hi].

  clamp(x: int, lo: int, hi: int) -> int
      if x < lo
          return lo
      if x > hi
          return hi
      x

@api sign(x) -> int — Return -1, 0, or 1 depending on the sign of x.

  sign(x: int) -> int
      if x < 0
          return -1
      if x > 0
          return 1
      0

@api gcd(a, b) -> int — Return the greatest common divisor of a and b using Euclid's algorithm.

  gcd(a: int, b: int) -> int
      var x = abs(a)
      var y = abs(b)
      while y != 0
          val t = y
          y = x % y
          x = t
      x

@api pow(base, exp) -> int — Return base raised to the power exp using exponentiation by squaring. Exp must be non-negative.

  pow(base: int, exp: int) -> int
      var result = 1
      var b = base
      var e = exp
      while e > 0
          if e & 1 == 1
              result *= b
          b *= b
          e = e >> 1
      result
