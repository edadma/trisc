String Utilities

Core string operations for the Sysl standard library.
Operates on null-terminated byte strings.
No OS dependency — usable in bare-metal programs.

      strcmp(a: *byte, b: *byte) -> int
          var i = 0
          while a[i] != 0 && b[i] != 0
              val d = a[i] - b[i]
              if d != 0
                  return d
              i += 1
          a[i] - b[i]

      strncmp(a: *byte, b: *byte, n: int) -> int
          var i = 0
          while i < n && a[i] != 0 && b[i] != 0
              val d = a[i] - b[i]
              if d != 0
                  return d
              i += 1
          if i == n
              return 0
          a[i] - b[i]

      strcpy(dst: *byte, src: *byte)
          var i = 0
          while src[i] != 0
              dst[i] = src[i]
              i += 1
          dst[i] = 0

      strncpy(dst: *byte, src: *byte, n: int)
          var i = 0
          while i < n && src[i] != 0
              dst[i] = src[i]
              i += 1
          while i < n
              dst[i] = 0
              i += 1

      strcat(dst: *byte, src: *byte)
          var i = 0
          while dst[i] != 0
              i += 1
          var j = 0
          while src[j] != 0
              dst[i] = src[j]
              i += 1
              j += 1
          dst[i] = 0

      strchr(s: *byte, c: int) -> int
          var i = 0
          while s[i] != 0
              if s[i] == c
                  return i
              i += 1
          -1

      strrchr(s: *byte, c: int) -> int
          var result = -1
          var i = 0
          while s[i] != 0
              if s[i] == c
                  result = i
              i += 1
          result
