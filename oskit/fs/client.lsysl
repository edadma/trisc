OSKit FS Client Library
=======================

User-facing filesystem API. Talks to VFS (port "fs"), which
routes requests to the appropriate backend filesystem server.

The port is looked up lazily on first use and cached, so
each call after the first is a single IPC send — no per-call
`port_lookup`. If the lookup fails (server not yet registered)
we retry on every call, which means clients that start before
the fs server is up will just see -1 returns until it comes
online.

The protocol command numbers and message layout duplicate the
constants in `oskit/servers/tfs.lsysl` — they're the wire
contract between client and server, so both sides own a copy.

    module oskit.fs

    import oskit.ipc.{port_lookup, ipc_send}
    import oskit.services.{svc_grant_create, svc_grant_revoke, GRANT_READ, GRANT_WRITE}

VFS protocol commands (must match oskit/servers/vfs.lsysl).

    val FS_CMD_OPEN    = 1
    val FS_CMD_READ    = 2
    val FS_CMD_WRITE   = 3
    val FS_CMD_CREATE  = 4
    val FS_CMD_UNLINK  = 5
    val FS_CMD_STAT    = 6
    val FS_CMD_MKDIR   = 7
    val FS_CMD_RMDIR   = 8
    val FS_CMD_READDIR = 9
    val FS_CMD_SYNC    = 10
    val FS_CMD_CHMOD   = 11
    val FS_CMD_RENAME  = 12
    val FS_CMD_CLOSE   = 13
    val FS_CMD_SEEK    = 14
    val FS_CMD_CONNECT = 15
    val FS_CMD_INHERIT = 16
    val FS_CMD_PIPE    = 18
    val FS_CMD_SYMLINK = 30
    val FS_CMD_READLINK = 31

Cached port id (-1 = not yet looked up / last lookup failed).
`fs_srv_name` is a 3-byte null-terminated "fs" buffer; it's
initialized on first call to `fs_get_port`.

`fs_last_ino` holds the inode from the most recent `fs_open` call,
for callers that need the raw inode (e.g., for directory operations
that still take inodes).

    var fs_port = -1
    var fs_last_ino = -1

    fs_get_port() -> int
        if fs_port < 0
            fs_port = port_lookup("fs")
        fs_port

Big-endian 16/32-bit helpers for the protocol message layout.
Local to the client — the server has its own copy.

    fs_msg_read_i32(buf: *byte, off: int) -> int
        ((buf[off] & 0xFF) << 24) | ((buf[off + 1] & 0xFF) << 16) | ((buf[off + 2] & 0xFF) << 8) | (buf[off + 3] & 0xFF)

    fs_msg_write_i32(buf: *byte, off: int, v: int)
        buf[off] = (v >> 24) & 0xFF
        buf[off + 1] = (v >> 16) & 0xFF
        buf[off + 2] = (v >> 8) & 0xFF
        buf[off + 3] = v & 0xFF

Open a file by path. Returns a file ID (VFS open file table index).
The underlying inode is stored in `fs_last_ino` for callers that
need it (e.g., for directory operations). Returns -1 on error.

    fs_open(path: string) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_OPEN
        val plen = len(path)
        val p: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[i + 1] = p[i]
        var reply: [9]byte
        ipc_send(port, msg, plen + 1, reply, 9)
        if reply[0] != 0
            return -1
        fs_last_ino = fs_msg_read_i32(reply, 5)
        fs_msg_read_i32(reply, 1)

Connect to a named resource. Supports scheme-based routing:
`connect("vfs:/etc/passwd")` or `connect("tty:0")`. Paths
without a scheme (starting with "/") default to the filesystem.
Returns a handle, or -1 on error.

    fs_connect(name: string) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_CONNECT
        val nlen = len(name)
        val p: *byte = *byte(name)
        for var i = 0; i < nlen; i++
            msg[i + 1] = p[i]
        var reply: [9]byte
        ipc_send(port, msg, nlen + 1, reply, 9)
        if reply[0] != 0
            return -1
        fs_last_ino = fs_msg_read_i32(reply, 5)
        fs_msg_read_i32(reply, 1)

Read up to `rlen` bytes from open file `fid` into `buf`.
Position is tracked by VFS and advances automatically.
Grant-based: passes buffer address to the server.
Returns number of bytes read, or -1 on error.

    fs_read(fid: int, buf: *byte, rlen: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        val gid = svc_grant_create(int(i64(buf)), rlen, GRANT_WRITE)
        if gid < 0
            return -1
        var msg: [13]byte
        msg[0] = FS_CMD_READ
        fs_msg_write_i32(msg, 1, fid)
        fs_msg_write_i32(msg, 5, rlen)
        fs_msg_write_i32(msg, 9, gid)
        var reply: [5]byte
        val result = ipc_send(port, msg, 13, reply, 5)
        svc_grant_revoke(gid)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        fs_msg_read_i32(reply, 1)

Write `wlen` bytes from `data` to open file `fid`.
Position is tracked by VFS and advances automatically.
Returns number of bytes written, or -1 on error.

    fs_write(fid: int, data: *byte, wlen: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        val gid = svc_grant_create(int(i64(data)), wlen, GRANT_READ)
        if gid < 0
            return -1
        var msg: [13]byte
        msg[0] = FS_CMD_WRITE
        fs_msg_write_i32(msg, 1, fid)
        fs_msg_write_i32(msg, 5, wlen)
        fs_msg_write_i32(msg, 9, gid)
        var reply: [5]byte
        val result = ipc_send(port, msg, 13, reply, 5)
        svc_grant_revoke(gid)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        fs_msg_read_i32(reply, 1)

Close an open file. Frees the VFS open file table entry.

    fs_close(fid: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = FS_CMD_CLOSE
        fs_msg_write_i32(msg, 1, fid)
        var reply: [1]byte
        ipc_send(port, msg, 5, reply, 1)
        int(reply[0])

Seek to a position in an open file.
whence: 0 = SET, 1 = CUR. Returns new position, or -1 on error.

    fs_seek(fid: int, offset: int, whence: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [10]byte
        msg[0] = FS_CMD_SEEK
        fs_msg_write_i32(msg, 1, fid)
        fs_msg_write_i32(msg, 5, offset)
        msg[9] = byte(whence)
        var reply: [5]byte
        val result = ipc_send(port, msg, 10, reply, 5)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        fs_msg_read_i32(reply, 1)

Create a file at a path. `ftype`: 1 = file, 2 = directory.
Returns new inode or -1. Path-based — VFS resolves the parent.
Protocol: [cmd(1), type(1), mode_hi(1), mode_lo(1), path(N)]

    fs_create(path: string, ftype: int, perm: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_CREATE
        msg[1] = byte(ftype)
        msg[2] = (perm >> 8) & 0xFF
        msg[3] = perm & 0xFF
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[4 + i] = pp[i]
        var reply: [5]byte
        val result = ipc_send(port, msg, plen + 4, reply, 5)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        fs_msg_read_i32(reply, 1)

Unlink a file by path.
Protocol: [cmd(1), path(N)]

    fs_unlink(path: string) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_UNLINK
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [1]byte
        val result = ipc_send(port, msg, plen + 1, reply, 1)
        if result != 0
            return -1
        int(reply[0])

Stat a path. Fills `out[0..6]` with mode, nlinks, uid, gid,
size, mtime, ctime. Returns 0 on success, -1 on error.
Protocol: [cmd(1), path(N)]

    fs_stat(path: string, out: *int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_STAT
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [29]byte
        val result = ipc_send(port, msg, plen + 1, reply, 29)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        out[0] = fs_msg_read_i32(reply, 1)
        out[1] = fs_msg_read_i32(reply, 5)
        out[2] = fs_msg_read_i32(reply, 9)
        out[3] = fs_msg_read_i32(reply, 13)
        out[4] = fs_msg_read_i32(reply, 17)
        out[5] = fs_msg_read_i32(reply, 21)
        out[6] = fs_msg_read_i32(reply, 25)
        0

Create a directory at a path.
Protocol: [cmd(1), mode_hi(1), mode_lo(1), path(N)]

    fs_mkdir(path: string, perm: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_MKDIR
        msg[1] = (perm >> 8) & 0xFF
        msg[2] = perm & 0xFF
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[3 + i] = pp[i]
        var reply: [5]byte
        val result = ipc_send(port, msg, plen + 3, reply, 5)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        fs_msg_read_i32(reply, 1)

Remove a directory by path. Must be empty.
Protocol: [cmd(1), path(N)]

    fs_rmdir(path: string) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_RMDIR
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [1]byte
        val result = ipc_send(port, msg, plen + 1, reply, 1)
        if result != 0
            return -1
        int(reply[0])

Read a directory entry by path and index.
Protocol: [cmd(1), index(4), path(N)] → [status(1), ino(4), name(60)]

    fs_readdir(path: string, index: int, out_ino: *int, out_name: *byte) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_READDIR
        fs_msg_write_i32(msg, 1, index)
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[5 + i] = pp[i]
        var reply: [65]byte
        val result = ipc_send(port, msg, plen + 5, reply, 65)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        *out_ino = fs_msg_read_i32(reply, 1)
        var i = 0
        while i < 60
            out_name[i] = reply[i + 5]
            i += 1
        0

Flush superblock to disk.

    fs_sync() -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = FS_CMD_SYNC
        var reply: [1]byte
        val result = ipc_send(port, msg, 1, reply, 1)
        if result != 0
            return -1
        int(reply[0])

Change file permissions by path.
Protocol: [cmd(1), mode_hi(1), mode_lo(1), path(N)]

    fs_chmod(path: string, perm: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [128]byte
        msg[0] = FS_CMD_CHMOD
        msg[1] = (perm >> 8) & 0xFF
        msg[2] = perm & 0xFF
        val plen = len(path)
        val pp: *byte = *byte(path)
        for var i = 0; i < plen; i++
            msg[3 + i] = pp[i]
        var reply: [1]byte
        val result = ipc_send(port, msg, plen + 3, reply, 1)
        if result != 0
            return -1
        int(reply[0])

Rename/move a file. Both paths are full paths.
Protocol: [cmd(1), old_path_len(1), old_path(N), new_path(M)]

    fs_rename(old_path: string, new_path: string) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        val onp = *byte(old_path)
        val onl = len(old_path)
        val nnp = *byte(new_path)
        val nnl = len(new_path)
        var msg: [128]byte
        msg[0] = FS_CMD_RENAME
        msg[1] = byte(onl)
        var i = 0
        while i < onl
            msg[2 + i] = onp[i]
            i += 1
        i = 0
        while i < nnl
            msg[2 + onl + i] = nnp[i]
            i += 1
        var reply: [1]byte
        val result = ipc_send(port, msg, 2 + onl + nnl, reply, 1)
        if result != 0
            return -1
        int(reply[0])

Create a pipe. Returns 0 on success, -1 on error.
On success, writes the read handle to *read_h and the
write handle to *write_h.

    fs_pipe(read_h: *int, write_h: *int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = FS_CMD_PIPE
        var reply: [9]byte
        val result = ipc_send(port, msg, 1, reply, 9)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        *read_h = fs_msg_read_i32(reply, 1)
        *write_h = fs_msg_read_i32(reply, 5)
        0

Create a symbolic link at `linkpath` pointing to `target`. Returns
0 on success, -1 on error.
Protocol: [cmd(1), target_len(2be), target(N), linkpath(M)]

    fs_symlink(target: string, linkpath: string) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        val tlen = len(target)
        val tp: *byte = *byte(target)
        val llen = len(linkpath)
        val lp: *byte = *byte(linkpath)
        var msg: [256]byte
        msg[0] = FS_CMD_SYMLINK
        msg[1] = (tlen >> 8) & 0xFF
        msg[2] = tlen & 0xFF
        for var i = 0; i < tlen; i++
            msg[3 + i] = tp[i]
        for var i = 0; i < llen; i++
            msg[3 + tlen + i] = lp[i]
        var reply: [5]byte
        val result = ipc_send(port, msg, 3 + tlen + llen, reply, 5)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        0

Read the target of a symbolic link at `path` into `buf`. Returns
the number of bytes read (≤ buf_size), 0 if the target is empty,
or -1 on error (path not found, not a symlink, IPC failure).

    fs_readlink(path: string, buf: *byte, buf_size: int) -> int
        val port = fs_get_port()
        if port < 0
            return -1
        val plen = len(path)
        val pp: *byte = *byte(path)
        var msg: [128]byte
        msg[0] = FS_CMD_READLINK
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [251]byte
        val result = ipc_send(port, msg, 1 + plen, reply, 251)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        val n = ((int(reply[1]) & 0xFF) << 8) | (int(reply[2]) & 0xFF)
        var copied = n
        if copied > buf_size
            copied = buf_size
        var i = 0
        while i < copied
            buf[i] = reply[3 + i]
            i += 1
        copied
