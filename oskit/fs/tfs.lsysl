TFS — Tiny Filesystem Library

Portable filesystem implementation. Provides inode-level file
operations: lookup, read, write, create, unlink, mkdir, and stat.

Block I/O is abstracted via extern functions:
- rd_read(lba, buf) -> int — read one filesystem block; 0 ok, -1 fail
- rd_write(lba, buf) -> int — write one filesystem block; 0 ok, -1 fail
The environment must provide these (e.g., ramdisk driver, IPC to
a block device server, etc.). Block size comes from the superblock
and must match the hardware sector size used when the volume was
formatted.

On-disk layout (block 0 = boot, block 1 = superblock):
- Superblock: magic, version, block_size, counts, layout offsets
- Inode bitmap, block bitmap, inode table, data blocks
- Inodes: 32 bytes each (mode, nlinks, uid, gid, size, mtime, ctime,
    6 direct block ptrs, 1 indirect block ptr)
- Dir entries: 64 bytes each (i32be inode + 60-char NUL-padded name)
- Directories store entries through the same direct/indirect chain
  files use, so a directory can hold up to 6 + (block_size / 2) data
  blocks worth of entries (≈131K entries at 4KB blocks).

On-disk version: 2 (Phase 0e — name field grew 14→60, dir_entry
size grew 16→64, dir storage spans direct+indirect like files).
Version 1 volumes are not migrated; the formatter writes v2 fresh
at every boot.


    module oskit.fs

    import oskit.hal.{memcpy, memset}

    // === Block I/O — provided by the environment ===

    extern rd_read(lba: int, addr: *byte) -> int
    extern rd_write(lba: int, addr: *byte) -> int

    // === TFS constants ===

    val TFS_MAGIC     = 0x54465300
    val TFS_VERSION   = 2
    val ROOT_INODE    = 1
    val INODE_SIZE    = 32
    val DIR_ENTRY_SIZE = 64
    val DIR_NAME_LEN  = 60
    val NUM_DIRECT    = 6

    // File type bits (mode >> 12)
    val S_IFREG = 1
    val S_IFDIR = 2
    val S_IFCHR = 3
    val S_IFBLK = 4
    val S_IFLNK = 5

    // === Cached superblock state ===

    var sb_block_size   = 0
    var sb_total_blocks = 0
    var sb_total_inodes = 0
    var sb_inode_bitmap = 0
    var sb_block_bitmap = 0
    var sb_inode_table  = 0
    var sb_first_data   = 0
    var sb_free_blocks  = 0
    var sb_free_inodes  = 0

    // === Block buffers (4KB blocks) ===

    var blkbuf: [4096]byte      // general purpose (file data, superblock, dir blocks, inodes)
    var blkbuf2: [4096]byte     // secondary (bitmaps, indirect blocks)

    // === Big-endian read helpers ===

    read_i16(p: *byte) -> int
        ((p[0] & 0xFF) << 8) | (p[1] & 0xFF)

    read_i32(p: *byte) -> int
        ((p[0] & 0xFF) << 24) | ((p[1] & 0xFF) << 16) | ((p[2] & 0xFF) << 8) | (p[3] & 0xFF)

    write_i16(p: *byte, v: int)
        p[0] = (v >> 8) & 0xFF
        p[1] = v & 0xFF

    write_i32(p: *byte, v: int)
        p[0] = (v >> 24) & 0xFF
        p[1] = (v >> 16) & 0xFF
        p[2] = (v >> 8) & 0xFF
        p[3] = v & 0xFF

    // === Initialization ===

    tfs_init()
        rd_read(1, blkbuf)
        val magic = read_i32(blkbuf)
        if magic != TFS_MAGIC
            return
        val version = read_i16(blkbuf + 4)
        if version != TFS_VERSION
            return
        sb_block_size   = read_i16(blkbuf + 6)
        sb_total_blocks = read_i16(blkbuf + 8)
        sb_total_inodes = read_i16(blkbuf + 10)
        sb_inode_bitmap = read_i16(blkbuf + 12)
        sb_block_bitmap = read_i16(blkbuf + 14)
        sb_inode_table  = read_i16(blkbuf + 16)
        sb_first_data   = read_i16(blkbuf + 18)
        sb_free_blocks  = read_i16(blkbuf + 20)
        sb_free_inodes  = read_i16(blkbuf + 22)

    // === Inode operations ===

inode_offset(ino) — Return the byte offset within the inode table block
for the given inode number.

    inode_block(ino: int) -> int
        sb_inode_table + (ino * INODE_SIZE) / sb_block_size

    inode_off(ino: int) -> int
        (ino * INODE_SIZE) % sb_block_size

tfs_read_inode(ino, buf) — Read inode into buf (32 bytes).
Reads the block containing the inode into blkbuf, then copies 32 bytes.

    tfs_read_inode(ino: int, buf: *byte)
        val blk = inode_block(ino)
        rd_read(blk, blkbuf)
        val off = inode_off(ino)
        val src: *byte = blkbuf + off
        var i = 0
        while i < INODE_SIZE
            buf[i] = src[i]
            i += 1

Inode field accessors — operate on a 32-byte inode buffer.
Layout: mode(2) nlinks(1) uid(1) gid(1) pad(1) size(4) mtime(4) ctime(4)
direct[0..5](12) indirect(2)

    ino_mode(buf: *byte) -> int
        read_i16(buf)

    ino_type(buf: *byte) -> int
        (read_i16(buf) >> 12) & 0xF

    ino_perm(buf: *byte) -> int
        read_i16(buf) & 0x1FF

    ino_nlinks(buf: *byte) -> int
        buf[2] & 0xFF

    ino_uid(buf: *byte) -> int
        buf[3] & 0xFF

    ino_gid(buf: *byte) -> int
        buf[4] & 0xFF

    ino_size(buf: *byte) -> int
        read_i32(buf + 6)

    ino_mtime(buf: *byte) -> int
        read_i32(buf + 10)

    ino_ctime(buf: *byte) -> int
        read_i32(buf + 14)

    ino_direct(buf: *byte, idx: int) -> int
        read_i16(buf + 18 + idx * 2)

    ino_indirect(buf: *byte) -> int
        read_i16(buf + 30)

    ino_set_size(buf: *byte, size: int)
        write_i32(buf + 6, size)

    ino_set_nlinks(buf: *byte, n: int)
        buf[2] = n

    ino_set_direct(buf: *byte, idx: int, blk: int)
        write_i16(buf + 18 + idx * 2, blk)

    ino_set_indirect(buf: *byte, blk: int)
        write_i16(buf + 30, blk)

    ino_set_mode(buf: *byte, mode: int)
        write_i16(buf, mode)

tfs_write_inode(ino, buf) — Write 32-byte inode buffer back to disk.

    tfs_write_inode(ino: int, buf: *byte)
        val blk = inode_block(ino)
        rd_read(blk, blkbuf)
        val off = inode_off(ino)
        val dst: *byte = blkbuf + off
        var i = 0
        while i < INODE_SIZE
            dst[i] = buf[i]
            i += 1
        rd_write(blk, blkbuf)

    // === Block data I/O ===

get_file_block(inode_buf, block_idx) — Return the disk block number for
logical block index within a file. Uses direct pointers (0-5) or the
indirect block (6+).

    get_file_block(ibuf: *byte, idx: int) -> int
        if idx < NUM_DIRECT
            return ino_direct(ibuf, idx)
        // Read indirect block into blkbuf2 (blkbuf used by callers for data).
        // If the disk read fails, return 0 so the caller breaks — otherwise
        // stale blkbuf2 contents from a previous indirect block would be
        // interpreted as live pointers.
        val ind_blk = ino_indirect(ibuf)
        if ind_blk == 0
            return 0
        if rd_read(ind_blk, blkbuf2) < 0
            return 0
        read_i16(blkbuf2 + (idx - NUM_DIRECT) * 2)

    // === Bitmap operations ===

    bitmap_test(bitmap_start: int, idx: int) -> int
        val blk = bitmap_start + idx / (sb_block_size * 8)
        rd_read(blk, blkbuf2)
        val byte_off = (idx % (sb_block_size * 8)) / 8
        val bit = idx % 8
        val p: *byte = blkbuf2 + byte_off
        if (*p & (1 << bit)) != 0
            return 1
        0

    bitmap_set(bitmap_start: int, idx: int)
        val blk = bitmap_start + idx / (sb_block_size * 8)
        rd_read(blk, blkbuf2)
        val byte_off = (idx % (sb_block_size * 8)) / 8
        val bit = idx % 8
        val p: *byte = blkbuf2 + byte_off
        *p = *p | (1 << bit)
        rd_write(blk, blkbuf2)

    bitmap_clear(bitmap_start: int, idx: int)
        val blk = bitmap_start + idx / (sb_block_size * 8)
        rd_read(blk, blkbuf2)
        val byte_off = (idx % (sb_block_size * 8)) / 8
        val bit = idx % 8
        val p: *byte = blkbuf2 + byte_off
        *p = *p & ~(1 << bit)
        rd_write(blk, blkbuf2)

alloc_inode() — Find and allocate a free inode. Returns inode number or -1.

    alloc_inode() -> int
        var i = 2
        while i < sb_total_inodes
            if bitmap_test(sb_inode_bitmap, i) == 0
                bitmap_set(sb_inode_bitmap, i)
                sb_free_inodes -= 1
                return i
            i += 1
        -1

    free_inode(ino: int)
        bitmap_clear(sb_inode_bitmap, ino)
        sb_free_inodes += 1

    alloc_block() -> int
        var i = sb_first_data
        while i < sb_total_blocks
            if bitmap_test(sb_block_bitmap, i) == 0
                bitmap_set(sb_block_bitmap, i)
                sb_free_blocks -= 1
                return i
            i += 1
        -1

    free_block(blk: int)
        bitmap_clear(sb_block_bitmap, blk)
        sb_free_blocks += 1

    // === Superblock sync ===

    sync_superblock()
        rd_read(1, blkbuf)
        write_i16(blkbuf + 20, sb_free_blocks)
        write_i16(blkbuf + 22, sb_free_inodes)
        rd_write(1, blkbuf)

    // === String helpers ===

Compare a NUL-padded on-disk entry name (a, max n bytes) against
a length-delimited name (b, blen bytes). Returns 1 if equal.

    entry_name_eq(a: *byte, n: int, b: *byte, blen: int) -> int
        // Check each byte of the user name against the entry
        var i = 0
        while i < blen
            if i >= n
                return 0
            if a[i] != b[i]
                return 0
            i += 1
        // User name exhausted — entry must be NUL-padded or at end
        if i < n
            if a[i] != 0
                return 0
        1

    // === Directory operations ===

tfs_dir_lookup(dir_ino, name, name_len) -> int
Find a name in a directory. Returns the inode number or -1 if not found.
Walks the directory's direct + indirect block chain (same shape files
use), so a directory of any size up to ~131K entries (4KB blocks) is
searched correctly.

    tfs_dir_lookup(dir_ino: int, name: *byte, name_len: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(dir_ino, ibuf)
        val entries = ino_size(ibuf) / DIR_ENTRY_SIZE
        val per_block = sb_block_size / DIR_ENTRY_SIZE
        var seen = 0
        var blk_idx = 0
        while seen < entries
            val data_blk = get_file_block(ibuf, blk_idx)
            if data_blk == 0
                blk_idx += 1
                continue
            rd_read(data_blk, blkbuf)
            var slots_here = per_block
            if seen + slots_here > entries
                slots_here = entries - seen
            var i = 0
            while i < slots_here
                val off: *byte = blkbuf + i * DIR_ENTRY_SIZE
                val entry_ino = read_i32(off)
                if entry_ino != 0
                    val entry_name: *byte = off + 4
                    if entry_name_eq(entry_name, DIR_NAME_LEN, name, name_len) == 1
                        return entry_ino
                i += 1
            seen += slots_here
            blk_idx += 1
        -1

tfs_lookup(path, path_len) -> int
Resolve a full path (e.g. "/dev/tty0") to an inode number.
Returns -1 if not found.

    tfs_lookup(path: *byte, path_len: int) -> int
        if path_len == 0
            return -1
        if path[0] != 47
            return -1
        var ino = ROOT_INODE
        var pos = 1
        while pos < path_len
            // Find start of component (skip slashes)
            val comp_start = pos
            while pos < path_len
                if path[pos] == 47
                    break
                pos += 1
            val comp_len = pos - comp_start
            if comp_len > 0
                ino = tfs_dir_lookup(ino, path + comp_start, comp_len)
                if ino == -1
                    return -1
            // Skip trailing slash
            if pos < path_len
                pos += 1
        ino

    // === File read ===

tfs_read(ino, buf, offset, len) -> int
Read len bytes from file at inode ino, starting at offset.
Returns bytes read.

When the read covers a full on-disk block starting at a block
boundary, `rd_read` DMAs directly into `buf` (no staging copy).
Partial blocks or unaligned ranges still use `blkbuf` + `memcpy`.

    tfs_read(ino: int, buf: *byte, offset: int, len: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        val file_size = ino_size(ibuf)
        if offset >= file_size
            return 0
        var remaining = len
        if offset + remaining > file_size
            remaining = file_size - offset
        val total = remaining
        var buf_pos = 0
        while remaining > 0
            val blk_idx = (offset + buf_pos) / sb_block_size
            val blk_off = (offset + buf_pos) % sb_block_size
            val disk_blk = get_file_block(ibuf, blk_idx)
            var chunk = sb_block_size - blk_off
            if chunk > remaining
                chunk = remaining
            if disk_blk == 0
                // Sparse hole — POSIX says reads return zeros. Fill
                // the chunk with NULs and continue. Holes are created
                // by `tfs_truncate` extending past the allocated tail
                // and (eventually) by sparse `tfs_write` skips.
                memset(buf + buf_pos, 0, chunk)
            else
                var rd_err = 0
                if blk_off == 0
                    if chunk == sb_block_size
                        rd_err = rd_read(disk_blk, buf + buf_pos)
                    else
                        rd_err = rd_read(disk_blk, blkbuf)
                        if rd_err == 0
                            memcpy(buf + buf_pos, blkbuf, chunk)
                else
                    rd_err = rd_read(disk_blk, blkbuf)
                    if rd_err == 0
                        memcpy(buf + buf_pos, blkbuf + blk_off, chunk)
                if rd_err < 0
                    break
            buf_pos += chunk
            remaining -= chunk
        total - remaining

    // === File write ===

tfs_write(ino, buf, offset, len) -> int
Write len bytes to file at inode ino, starting at offset.
Allocates new blocks as needed. Returns bytes written.

Full-block writes aligned to `sb_block_size` use `rd_write` directly
from `buf` (DMA). Partial or unaligned ranges read-modify-write via
`blkbuf`.

    tfs_write(ino: int, buf: *byte, offset: int, len: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        var remaining = len
        var buf_pos = 0
        var disk_blk = 0
        var blk_idx = 0
        var blk_off = 0
        var chunk = 0
        var ind_blk = 0
        var i = 0
        var dst: *byte = buf
        var new_block = 0
        while remaining > 0
            blk_idx = (offset + buf_pos) / sb_block_size
            blk_off = (offset + buf_pos) % sb_block_size
            disk_blk = get_file_block(ibuf, blk_idx)
            new_block = 0
            if disk_blk == 0
                disk_blk = alloc_block()
                if disk_blk == -1
                    break
                new_block = 1
                if blk_idx < NUM_DIRECT
                    ino_set_direct(ibuf, blk_idx, disk_blk)
                else
                    ind_blk = ino_indirect(ibuf)
                    if ind_blk == 0
                        ind_blk = alloc_block()
                        if ind_blk == -1
                            break
                        ino_set_indirect(ibuf, ind_blk)
                    rd_read(ind_blk, blkbuf2)
                    write_i16(blkbuf2 + (blk_idx - NUM_DIRECT) * 2, disk_blk)
                    rd_write(ind_blk, blkbuf2)
            chunk = sb_block_size - blk_off
            if chunk > remaining
                chunk = remaining
            if blk_off == 0
                if chunk == sb_block_size
                    // Full-block write — bypass blkbuf entirely.
                    rd_write(disk_blk, buf + buf_pos)
                else
                    // Partial write at block start. Newly allocated
                    // blocks must be zero-filled first (alloc_block
                    // returns blocks whose on-disk content is the
                    // stale data from whoever freed them last —
                    // both a correctness *and* an info-leak bug if
                    // we let it through).
                    if new_block == 1
                        memset(blkbuf, 0, sb_block_size)
                    else
                        rd_read(disk_blk, blkbuf)
                    memcpy(blkbuf, buf + buf_pos, chunk)
                    rd_write(disk_blk, blkbuf)
            else
                if new_block == 1
                    memset(blkbuf, 0, sb_block_size)
                else
                    rd_read(disk_blk, blkbuf)
                memcpy(blkbuf + blk_off, buf + buf_pos, chunk)
                rd_write(disk_blk, blkbuf)
            buf_pos += chunk
            remaining -= chunk
        // Update size if we wrote past end
        val new_end = offset + buf_pos
        if new_end > ino_size(ibuf)
            ino_set_size(ibuf, new_end)
        tfs_write_inode(ino, ibuf)
        buf_pos

    // === Directory entry add/remove ===

    dir_add_entry(dir_ino: int, name: *byte, name_len: int, child_ino: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(dir_ino, ibuf)
        val entries = ino_size(ibuf) / DIR_ENTRY_SIZE
        val per_block = sb_block_size / DIR_ENTRY_SIZE

Phase 1 — scan existing dir blocks for a freed slot (inode == 0).
A freed slot left by `dir_remove_entry` is reused before the dir
grows, which keeps the dir's logical size from creeping up forever
on create/unlink cycles.

        var found_blk = 0
        var found_slot = -1
        var seen = 0
        var blk_idx = 0
        while seen < entries
            val data_blk = get_file_block(ibuf, blk_idx)
            if data_blk == 0
                blk_idx += 1
                continue
            rd_read(data_blk, blkbuf)
            var slots_here = per_block
            if seen + slots_here > entries
                slots_here = entries - seen
            var s = 0
            while s < slots_here
                val off: *byte = blkbuf + s * DIR_ENTRY_SIZE
                if read_i32(off) == 0
                    found_blk = data_blk
                    found_slot = s
                    break
                s += 1
            if found_slot >= 0
                break
            seen += slots_here
            blk_idx += 1

        if found_slot >= 0
            val off: *byte = blkbuf + found_slot * DIR_ENTRY_SIZE
            write_i32(off, child_ino)
            val dp: *byte = off + 4
            var j = 0
            while j < DIR_NAME_LEN
                if j < name_len
                    dp[j] = name[j]
                else
                    dp[j] = 0
                j += 1
            rd_write(found_blk, blkbuf)
            return 0

Phase 2 — append a new entry at end-of-dir. May need to allocate a
fresh data block if the current tail block is full (or the dir is
empty), and may need to install that block's pointer in either the
direct array or the indirect block.

        val new_blk_idx = entries / per_block
        val new_slot = entries % per_block
        var data_blk = get_file_block(ibuf, new_blk_idx)
        if data_blk == 0
            data_blk = alloc_block()
            if data_blk == -1
                return -1
            memset(blkbuf2, 0, sb_block_size)
            rd_write(data_blk, blkbuf2)
            if new_blk_idx < NUM_DIRECT
                ino_set_direct(ibuf, new_blk_idx, data_blk)
            else
                var ind_blk = ino_indirect(ibuf)
                if ind_blk == 0
                    ind_blk = alloc_block()
                    if ind_blk == -1
                        return -1
                    memset(blkbuf2, 0, sb_block_size)
                    rd_write(ind_blk, blkbuf2)
                    ino_set_indirect(ibuf, ind_blk)
                rd_read(ind_blk, blkbuf2)
                write_i16(blkbuf2 + (new_blk_idx - NUM_DIRECT) * 2, data_blk)
                rd_write(ind_blk, blkbuf2)

        ino_set_size(ibuf, (entries + 1) * DIR_ENTRY_SIZE)
        tfs_write_inode(dir_ino, ibuf)

        rd_read(data_blk, blkbuf)
        val off: *byte = blkbuf + new_slot * DIR_ENTRY_SIZE
        write_i32(off, child_ino)
        val dp: *byte = off + 4
        var j = 0
        while j < DIR_NAME_LEN
            if j < name_len
                dp[j] = name[j]
            else
                dp[j] = 0
            j += 1
        rd_write(data_blk, blkbuf)
        0

    dir_remove_entry(dir_ino: int, name: *byte, name_len: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(dir_ino, ibuf)
        val entries = ino_size(ibuf) / DIR_ENTRY_SIZE
        val per_block = sb_block_size / DIR_ENTRY_SIZE
        var seen = 0
        var blk_idx = 0
        while seen < entries
            val data_blk = get_file_block(ibuf, blk_idx)
            if data_blk == 0
                blk_idx += 1
                continue
            rd_read(data_blk, blkbuf)
            var slots_here = per_block
            if seen + slots_here > entries
                slots_here = entries - seen
            var i = 0
            while i < slots_here
                val off: *byte = blkbuf + i * DIR_ENTRY_SIZE
                val entry_ino = read_i32(off)
                if entry_ino != 0
                    val en: *byte = off + 4
                    if entry_name_eq(en, DIR_NAME_LEN, name, name_len) == 1
                        write_i32(off, 0)
                        val dp: *byte = off + 4
                        var j = 0
                        while j < DIR_NAME_LEN
                            dp[j] = 0
                            j += 1
                        rd_write(data_blk, blkbuf)
                        return entry_ino
                i += 1
            seen += slots_here
            blk_idx += 1
        -1

    // === Create file/dir ===

tfs_create(parent_ino, name, name_len, type, perm) -> int
Create a new file or directory. Returns inode number or -1 on error.
type: 1=regular, 2=directory, 3=chardev, 4=blockdev

    tfs_create(parent_ino: int, name: *byte, name_len: int, ftype: int, perm: int) -> int
        val ino = alloc_inode()
        if ino == -1
            return -1
        var ibuf: [32]byte
        var i = 0
        while i < INODE_SIZE
            ibuf[i] = 0
            i += 1
        val mode = (ftype << 12) | (perm & 0x1FF)
        ino_set_mode(ibuf, mode)
        ino_set_nlinks(ibuf, 1)
        if ftype == S_IFDIR
            val blk = alloc_block()
            if blk == -1
                free_inode(ino)
                return -1
            ino_set_direct(ibuf, 0, blk)
            ino_set_size(ibuf, 2 * DIR_ENTRY_SIZE)
            ino_set_nlinks(ibuf, 2)
            tfs_write_inode(ino, ibuf)
            // Write . and .. (entry layout: [ino:4be][name:60])
            rd_read(blk, blkbuf)
            var zi = 0
            while zi < sb_block_size
                blkbuf[zi] = 0
                zi += 1
            write_i32(blkbuf, ino)
            val d1: *byte = blkbuf + 4
            d1[0] = 46
            write_i32(blkbuf + DIR_ENTRY_SIZE, parent_ino)
            val d2: *byte = blkbuf + DIR_ENTRY_SIZE + 4
            d2[0] = 46
            d2[1] = 46
            rd_write(blk, blkbuf)
            // Increment parent nlinks
            var pbuf: [32]byte
            tfs_read_inode(parent_ino, pbuf)
            ino_set_nlinks(pbuf, ino_nlinks(pbuf) + 1)
            tfs_write_inode(parent_ino, pbuf)
        else
            tfs_write_inode(ino, ibuf)
        dir_add_entry(parent_ino, name, name_len, ino)
        ino

    // === Create device node ===

tfs_mknod(parent_ino, name, name_len, ftype, major, minor) -> int
Create a device node. Returns inode number or -1.

    tfs_mknod(parent_ino: int, name: *byte, name_len: int, ftype: int, major: int, minor: int) -> int
        val ino = alloc_inode()
        if ino == -1
            return -1
        var ibuf: [32]byte
        var i = 0
        while i < INODE_SIZE
            ibuf[i] = 0
            i += 1
        val mode = (ftype << 12) | 0x1B6
        ino_set_mode(ibuf, mode)
        ino_set_nlinks(ibuf, 1)
        ino_set_direct(ibuf, 0, (major << 8) | (minor & 0xFF))
        tfs_write_inode(ino, ibuf)
        dir_add_entry(parent_ino, name, name_len, ino)
        ino

    // === Unlink ===

tfs_unlink(parent_ino, name, name_len) -> int
Remove a directory entry and free the inode if nlinks reaches 0.
Returns 0 on success, -1 on error.

    tfs_unlink(parent_ino: int, name: *byte, name_len: int) -> int
        val ino = dir_remove_entry(parent_ino, name, name_len)
        if ino == -1
            return -1
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        val nlinks = ino_nlinks(ibuf) - 1
        ino_set_nlinks(ibuf, nlinks)
        if nlinks == 0
            // Free data blocks
            var i = 0
            while i < NUM_DIRECT
                val blk = ino_direct(ibuf, i)
                if blk != 0
                    free_block(blk)
                i += 1
            val ind = ino_indirect(ibuf)
            if ind != 0
                // Free indirect entries
                rd_read(ind, blkbuf2)
                var j = 0
                while j < sb_block_size / 2
                    val b = read_i16(blkbuf2 + j * 2)
                    if b != 0
                        free_block(b)
                    j += 1
                free_block(ind)
            free_inode(ino)
        else
            tfs_write_inode(ino, ibuf)
        0

    // === Stat ===

tfs_stat(ino, out) -> int
Fill stat buffer: out[0]=mode, out[1]=nlinks, out[2]=uid, out[3]=gid,
out[4]=size, out[5]=mtime, out[6]=ctime. Returns 0 on success.

    tfs_stat(ino: int, out: *int) -> int
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        out[0] = ino_mode(ibuf)
        out[1] = ino_nlinks(ibuf)
        out[2] = ino_uid(ibuf)
        out[3] = ino_gid(ibuf)
        out[4] = ino_size(ibuf)
        out[5] = ino_mtime(ibuf)
        out[6] = ino_ctime(ibuf)
        0

    // === Permissions and ownership ===

tfs_chmod(ino, perm) -> int
Change permission bits (lower 9 bits of mode). Preserves file type.
Returns 0 on success.

    tfs_chmod(ino: int, perm: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        val ftype = ino_mode(ibuf) & 0xF000
        ino_set_mode(ibuf, ftype | (perm & 0x1FF))
        tfs_write_inode(ino, ibuf)
        0

tfs_chown(ino, uid, gid) -> int
Change owner and group. Returns 0 on success.

    tfs_chown(ino: int, uid: int, gid: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        ibuf[3] = uid & 0xFF
        ibuf[4] = gid & 0xFF
        tfs_write_inode(ino, ibuf)
        0

    // === Filesystem info ===

tfs_freeblocks() -> int — Return number of free data blocks.

    tfs_freeblocks() -> int
        sb_free_blocks

tfs_freeinodes() -> int — Return number of free inodes.

    tfs_freeinodes() -> int
        sb_free_inodes

    // === Truncate ===

tfs_truncate(ino, new_size) -> int
Set a file to exactly new_size bytes. Shrinks free blocks beyond
the new size; extending past the allocated tail is allowed and
creates a sparse hole — the new bytes read as zeros (`tfs_read`
returns NULs for absent blocks). Returns 0 on success, -1 on
error.

`new_size < 0` is rejected (callers are expected to validate at
the syscall layer, but the floor is enforced here too).

    tfs_truncate(ino: int, new_size: int) -> int
        if new_size < 0
            return -1
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        val old_size = ino_size(ibuf)
        if new_size > old_size
            // Extension: just bump the size field. Reads through
            // the new sparse region return zeros via the hole path
            // in `tfs_read`.
            ino_set_size(ibuf, new_size)
            tfs_write_inode(ino, ibuf)
            return 0
        if new_size == old_size
            return 0
        // Calculate which blocks to keep
        var keep_blocks = new_size / sb_block_size
        if (new_size % sb_block_size) != 0
            keep_blocks += 1
        // Free direct blocks beyond keep_blocks
        var i = keep_blocks
        while i < NUM_DIRECT
            val blk = ino_direct(ibuf, i)
            if blk != 0
                free_block(blk)
                ino_set_direct(ibuf, i, 0)
            i += 1
        // Free indirect blocks beyond keep_blocks
        val ind = ino_indirect(ibuf)
        if ind != 0
            rd_read(ind, blkbuf2)
            var j = 0
            var freed_all = 1
            if keep_blocks < NUM_DIRECT
                j = 0
            else
                j = keep_blocks - NUM_DIRECT
            while j < sb_block_size / 2
                val b = read_i16(blkbuf2 + j * 2)
                if b != 0
                    free_block(b)
                    write_i16(blkbuf2 + j * 2, 0)
                j += 1
            // Check if any indirect entries remain
            j = 0
            freed_all = 1
            while j < sb_block_size / 2
                if read_i16(blkbuf2 + j * 2) != 0
                    freed_all = 0
                    break
                j += 1
            if freed_all == 1
                free_block(ind)
                ino_set_indirect(ibuf, 0)
            else
                rd_write(ind, blkbuf2)
        ino_set_size(ibuf, new_size)
        tfs_write_inode(ino, ibuf)
        0

    // === Remove directory ===

tfs_rmdir(parent_ino, name, name_len) -> int
Remove an empty directory. Returns 0 on success, -1 if not empty or not found.

    tfs_rmdir(parent_ino: int, name: *byte, name_len: int) -> int
        val ino = tfs_dir_lookup(parent_ino, name, name_len)
        if ino == -1
            return -1
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        // Must be a directory
        if ino_type(ibuf) != S_IFDIR
            return -1

Empty-check walks the dir's full block chain, since a v2 directory
may span multiple blocks. Stop early at count > 2 (`.` + `..` is the
empty case; anything more means there's a live entry).

        val entries = ino_size(ibuf) / DIR_ENTRY_SIZE
        val per_block = sb_block_size / DIR_ENTRY_SIZE
        var count = 0
        var seen = 0
        var blk_idx = 0
        while seen < entries
            val data_blk = get_file_block(ibuf, blk_idx)
            if data_blk == 0
                blk_idx += 1
                continue
            rd_read(data_blk, blkbuf)
            var slots_here = per_block
            if seen + slots_here > entries
                slots_here = entries - seen
            var i = 0
            while i < slots_here
                val off: *byte = blkbuf + i * DIR_ENTRY_SIZE
                if read_i32(off) != 0
                    count += 1
                    if count > 2
                        return -1
                i += 1
            seen += slots_here
            blk_idx += 1

Free all data blocks in the dir (direct + indirect entries) and
the indirect block itself, then drop the inode.

        var i = 0
        while i < NUM_DIRECT
            val blk = ino_direct(ibuf, i)
            if blk != 0
                free_block(blk)
            i += 1
        val ind = ino_indirect(ibuf)
        if ind != 0
            rd_read(ind, blkbuf2)
            var j = 0
            while j < sb_block_size / 2
                val b = read_i16(blkbuf2 + j * 2)
                if b != 0
                    free_block(b)
                j += 1
            free_block(ind)
        free_inode(ino)
        // Remove from parent
        dir_remove_entry(parent_ino, name, name_len)
        // Decrement parent nlinks (child's .. no longer points to parent)
        var pbuf: [32]byte
        tfs_read_inode(parent_ino, pbuf)
        ino_set_nlinks(pbuf, ino_nlinks(pbuf) - 1)
        tfs_write_inode(parent_ino, pbuf)
        0

    // === Rename ===

tfs_rename(old_parent, old_name, old_name_len, new_parent, new_name, new_name_len) -> int
Move/rename a file or directory. Returns 0 on success, -1 on error.

    tfs_rename(old_parent: int, old_name: *byte, old_name_len: int, new_parent: int, new_name: *byte, new_name_len: int) -> int
        val ino = dir_remove_entry(old_parent, old_name, old_name_len)
        if ino == -1
            return -1
        dir_add_entry(new_parent, new_name, new_name_len, ino)
        // If moving a directory, update its .. entry
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        if ino_type(ibuf) == S_IFDIR
            val data_blk = ino_direct(ibuf, 0)
            rd_read(data_blk, blkbuf)
            // `..` is the second entry; ino lives at the start of slot 1.
            write_i32(blkbuf + DIR_ENTRY_SIZE, new_parent)
            rd_write(data_blk, blkbuf)
            // Update nlinks: old parent loses one, new parent gains one
            var pbuf: [32]byte
            tfs_read_inode(old_parent, pbuf)
            ino_set_nlinks(pbuf, ino_nlinks(pbuf) - 1)
            tfs_write_inode(old_parent, pbuf)
            tfs_read_inode(new_parent, pbuf)
            ino_set_nlinks(pbuf, ino_nlinks(pbuf) + 1)
            tfs_write_inode(new_parent, pbuf)
        0

    // === Read directory entry ===

tfs_readdir(dir_ino, index, out_ino, out_name) -> int
Read the nth active directory entry. Skips free slots.
Sets out_ino and copies name to out_name (DIR_NAME_LEN bytes).
Walks the directory's direct + indirect chain to find entry `index`.
Returns 0 on success, -1 if index is past the last entry.

    tfs_readdir(dir_ino: int, index: int, out_ino: *int, out_name: *byte) -> int
        var ibuf: [32]byte
        tfs_read_inode(dir_ino, ibuf)
        val entries = ino_size(ibuf) / DIR_ENTRY_SIZE
        val per_block = sb_block_size / DIR_ENTRY_SIZE
        var count = 0
        var seen = 0
        var blk_idx = 0
        while seen < entries
            val data_blk = get_file_block(ibuf, blk_idx)
            if data_blk == 0
                blk_idx += 1
                continue
            rd_read(data_blk, blkbuf)
            var slots_here = per_block
            if seen + slots_here > entries
                slots_here = entries - seen
            var i = 0
            while i < slots_here
                val off: *byte = blkbuf + i * DIR_ENTRY_SIZE
                val entry_ino = read_i32(off)
                if entry_ino != 0
                    if count == index
                        *out_ino = entry_ino
                        val src: *byte = off + 4
                        var j = 0
                        while j < DIR_NAME_LEN
                            out_name[j] = src[j]
                            j += 1
                        return 0
                    count += 1
                i += 1
            seen += slots_here
            blk_idx += 1
        -1

    // === Hard link ===

tfs_link(parent_ino, name, target_ino) -> int
Create a hard link. Adds a directory entry and increments nlinks.
Returns 0 on success, -1 on error.

    tfs_link(parent_ino: int, name: *byte, name_len: int, target_ino: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(target_ino, ibuf)
        // Can't hard-link directories
        if ino_type(ibuf) == S_IFDIR
            return -1
        ino_set_nlinks(ibuf, ino_nlinks(ibuf) + 1)
        tfs_write_inode(target_ino, ibuf)
        dir_add_entry(parent_ino, name, name_len, target_ino)
        0

    // === Symlinks ===

tfs_symlink(parent_ino, name, name_len, target, target_len) -> int
Create an S_IFLNK inode with `target` stored as the file's data
content. Path resolution is NOT auto-followed at the TFS layer —
callers (or the shim) decide whether to follow. Returns the new
inode number, or -1 on error.

The target is bounded to `sb_block_size` bytes (= one data block,
4 KB) — POSIX `PATH_MAX` is far below that and a longer link
target makes no sense.

    tfs_symlink(parent_ino: int, name: *byte, name_len: int, target: *byte, target_len: int) -> int
        if target_len <= 0
            return -1
        if target_len > sb_block_size
            return -1
        val ino = alloc_inode()
        if ino == -1
            return -1
        var ibuf: [32]byte
        var i = 0
        while i < INODE_SIZE
            ibuf[i] = 0
            i += 1
        // 0x1FF = rwxrwxrwx (POSIX symlinks ignore mode but a non-zero
        // value keeps `ls -l` from rendering them with empty perms).
        val mode = (S_IFLNK << 12) | 0x1FF
        ino_set_mode(ibuf, mode)
        ino_set_nlinks(ibuf, 1)
        tfs_write_inode(ino, ibuf)
        // Write the target string as inline file data via tfs_write —
        // exactly the same path tfs_create+tfs_write takes for regular
        // files. Keeps the symlink primitive small (no separate storage).
        val nw = tfs_write(ino, target, 0, target_len)
        if nw != target_len
            // Couldn't allocate a data block; bail out cleanly.
            free_inode(ino)
            return -1
        dir_add_entry(parent_ino, name, name_len, ino)
        ino

tfs_readlink(ino, buf, buf_size) -> int
Read the target string of an S_IFLNK inode into `buf`. Returns the
number of bytes copied (≤ buf_size and ≤ target length), or -1 if
the inode isn't a symlink.

    tfs_readlink(ino: int, buf: *byte, buf_size: int) -> int
        var ibuf: [32]byte
        tfs_read_inode(ino, ibuf)
        if ino_type(ibuf) != S_IFLNK
            return -1
        val sz = ino_size(ibuf)
        var nread = sz
        if nread > buf_size
            nread = buf_size
        if nread <= 0
            return 0
        tfs_read(ino, buf, 0, nread)

tfs_lookup_follow(path, path_len) -> int
Like `tfs_lookup`, but if the terminal component is an `S_IFLNK`
symlink, the target is read and re-resolved, looping until a non-
symlink inode is reached or 40 hops are exhausted (MAXSYMLINKS).

Only absolute targets (those that begin with `/`) are followed for
now. Relative-target symlinks are out of scope for the Phase-1
`/bin/<applet> -> /bin/busybox` use case — supporting them would
require splitting the link's parent directory off the original
path, which we'd rather build once a real user surfaces the need.

Returns the final inode number, or `-1` on lookup failure / cycle /
unsupported relative target.

    tfs_lookup_follow(path: *byte, path_len: int) -> int
        var ino = tfs_lookup(path, path_len)
        var hops = 0
        var ibuf: [32]byte
        var target_buf: [256]byte
        while ino != -1
            tfs_read_inode(ino, ibuf)
            if ino_type(ibuf) != S_IFLNK
                return ino
            if hops >= 40
                return -1
            val n = tfs_readlink(ino, target_buf, 256)
            if n <= 0
                return -1
            // 47 = '/'. Absolute targets only.
            if target_buf[0] != 47
                return -1
            ino = tfs_lookup(target_buf, n)
            hops += 1
        -1
