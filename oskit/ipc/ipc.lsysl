OSKit IPC — Synchronous Rendezvous Message Passing

Port-based IPC with synchronous send/recv/reply. No allocation
needed — callers provide their own buffers, and the kernel
copies data directly between them.

Flow:
1. Server calls port_create() → gets a port ID
2. Server calls recv(port, buf, len) → blocks until message
3. Client calls send(port, msg, len, reply_buf, reply_len) → blocks
4. Kernel copies msg to server's buf, unblocks server
5. Server processes request
6. Server calls reply(client_tid, response, len) → unblocks client
7. Kernel copies response to client's reply_buf

Multiple clients sending to the same port are queued FIFO
per-port. recv always dequeues the oldest waiting sender.

States 11-12 are reserved for IPC (defined in kernel.lsysl
so the scheduler can reference them).

    module oskit.ipc

    import oskit.kernel.*
    import oskit.arch.{vm_v2p, vm_copy_cross, SYSCALL_RETURN_OFFSET, debug_char, debug_hex4}
    import oskit.config.{MAX_PORTS, MAX_THREADS, KERNEL_L1_BASE, DEFAULT_QUANTUM}
    import oskit.services.syscall
    import oskit.hal.memcpy

    val IPC_PORT_FREE = -1
    val IPC_QUEUE_EMPTY = -1

Per-thread IPC state, parallel to the threads[] array. Each
thread has its own IPC context used during send/recv/reply.
wait_next forms an intrusive linked list for per-port FIFO
queues of blocked senders.

    struct IPCContext
        buf: i64
        len: int
        reply_buf: i64
        reply_len: int
        port: int
        sender: int
        actual_len: int
        wait_next: int

    var ipc_ctx: [32]IPCContext  // 32 = MAX_THREADS
    var port_owner: [8]int  // 8 = MAX_PORTS
    var port_wait_head: [8]int  // 8 = MAX_PORTS
    var port_wait_tail: [8]int  // 8 = MAX_PORTS
    var port_name_buf: [64]byte  // 8 ports * 8 bytes per name
    var port_name_len: [8]int   // length of each name
    var port_count = 0

Syscall numbers for IPC (31-37).

    val IPC_TIMEOUT = -2

    val SYS_PORT_CREATE    = 31
    val SYS_IPC_SEND       = 32
    val SYS_IPC_RECV       = 33
    val SYS_IPC_REPLY      = 34
    val SYS_PORT_CLOSE     = 35
    val SYS_PORT_REGISTER  = 36
    val SYS_PORT_LOOKUP    = 37
    val SYS_IPC_SEND_TIMED    = 38
    val SYS_IPC_RECV_NOTIFY   = 39

Copy bytes between memory addresses.

    ipc_memcpy(dst: i64, src: i64, len: int)
        memcpy(*byte(dst), *byte(src), len)

Compare two null-terminated strings. Returns 0 if equal.

    ipc_strcmp(a: *byte, alen: int, b: *byte, blen: int) -> int
        if alen != blen
            return 1
        var i = 0
        while i < alen
            if a[i] != b[i]
                return 1
            i += 1
        0

Per-port FIFO queue operations for blocked senders.

    ipc_queue_push(port: int, tid: int)
        ipc_ctx[tid].wait_next = IPC_QUEUE_EMPTY
        if port_wait_tail[port] == IPC_QUEUE_EMPTY
            port_wait_head[port] = tid
            port_wait_tail[port] = tid
        else
            ipc_ctx[port_wait_tail[port]].wait_next = tid
            port_wait_tail[port] = tid

    ipc_queue_pop(port: int) -> int
        val tid = port_wait_head[port]
        if tid == IPC_QUEUE_EMPTY
            return IPC_QUEUE_EMPTY
        port_wait_head[port] = ipc_ctx[tid].wait_next
        if port_wait_head[port] == IPC_QUEUE_EMPTY
            port_wait_tail[port] = IPC_QUEUE_EMPTY
        ipc_ctx[tid].wait_next = IPC_QUEUE_EMPTY
        tid

Remove a specific thread from a port's wait queue.
Returns 1 if found and removed, 0 if not found.

    ipc_queue_remove(port: int, tid: int) -> int
        if port_wait_head[port] == tid
            // Head of queue
            port_wait_head[port] = ipc_ctx[tid].wait_next
            if port_wait_head[port] == IPC_QUEUE_EMPTY
                port_wait_tail[port] = IPC_QUEUE_EMPTY
            ipc_ctx[tid].wait_next = IPC_QUEUE_EMPTY
            return 1
        // Search for tid in the list
        var prev = port_wait_head[port]
        while prev != IPC_QUEUE_EMPTY
            if ipc_ctx[prev].wait_next == tid
                ipc_ctx[prev].wait_next = ipc_ctx[tid].wait_next
                if port_wait_tail[port] == tid
                    port_wait_tail[port] = prev
                ipc_ctx[tid].wait_next = IPC_QUEUE_EMPTY
                return 1
            prev = ipc_ctx[prev].wait_next
        0

Helper to re-enqueue the current thread so it keeps running
after do_schedule. Used by handlers that don't block.

    ipc_continue_current()
        threads[current_thread].state = STATE_READY
        enqueue(threads[current_thread].priority, current_thread)

Initialize the IPC subsystem. Clears all ports and registers
syscall handlers. Call from kernel_main before creating threads.

    ipc_init()
        var i = 0
        while i < MAX_PORTS
            port_owner[i] = IPC_PORT_FREE
            port_wait_head[i] = IPC_QUEUE_EMPTY
            port_wait_tail[i] = IPC_QUEUE_EMPTY
            port_name_len[i] = 0
            i += 1
        register_syscall(SYS_PORT_CREATE, ipc_port_create_handler)
        register_syscall(SYS_IPC_SEND, ipc_send_handler)
        register_syscall(SYS_IPC_RECV, ipc_recv_handler)
        register_syscall(SYS_IPC_REPLY, ipc_reply_handler)
        register_syscall(SYS_PORT_CLOSE, ipc_port_close_handler)
        register_syscall(SYS_PORT_REGISTER, ipc_port_register_handler)
        register_syscall(SYS_PORT_LOOKUP, ipc_port_lookup_handler)
        register_syscall(SYS_IPC_SEND_TIMED, ipc_send_timed_handler)
        register_syscall(SYS_IPC_RECV_NOTIFY, ipc_recv_notify_handler)
        register_syscall(65, ipc_last_msg_len_handler)
        register_syscall(68, ipc_port_transfer_handler)

    ipc_last_msg_len_handler(arg: int)
        syscall_return(ipc_ctx[current_thread].actual_len)
        ipc_continue_current()

Transfer port ownership to another thread. Used by RS to hand
a dead server's port to the restarted replacement. Clients with
cached port IDs continue to work transparently.

    ipc_port_transfer_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val new_owner = int(args[1])
        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        port_owner[port] = new_owner
        syscall_return(0)
        ipc_continue_current()

Create a new port owned by the current thread. If the current
thread already owns a port (e.g. transferred by RS before
startup), returns that existing port instead of allocating a
new one. This makes server restart transparent — the server
calls port_create as normal and gets the pre-assigned port.

    ipc_port_create_handler(arg: int)
        // Check if this thread already owns a port (transferred by RS)
        var i = 0
        while i < port_count
            if port_owner[i] == current_thread
                syscall_return(i)
                ipc_continue_current()
                return
            i += 1
        if port_count >= MAX_PORTS
            syscall_return(-1)
            ipc_continue_current()
            return
        val id = port_count
        port_owner[id] = current_thread
        port_count += 1
        syscall_return(id)
        ipc_continue_current()

Send a message and wait for reply. The arg is a pointer to
a packed argument block: [port, msg_ptr, msg_len, reply_ptr, reply_len].
Blocks the sender until the server calls reply().
Returns 0 on success, -1 on error (invalid port, port closed).

    ipc_send_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val msg_ptr = args[1]
        val msg_len = int(args[2])
        val rply_buf = args[3]
        val rply_len = int(args[4])
        val me = current_thread

        // Validate port
        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if port_owner[port] == IPC_PORT_FREE
            syscall_return(-1)
            ipc_continue_current()
            return

        // IPC send permission check
        if ipc_check_send_allowed(port) == 0
            syscall_return(-1)
            ipc_continue_current()
            return

        // Store sender's IPC context
        ipc_ctx[me].buf = msg_ptr
        ipc_ctx[me].len = msg_len
        ipc_ctx[me].reply_buf = rply_buf
        ipc_ctx[me].reply_len = rply_len
        ipc_ctx[me].port = port

        // Check if the server is already waiting for a message
        val owner = port_owner[port]
        if ipc_server_waiting(owner, port) == 1
            ipc_deliver_and_wake(owner, me, msg_ptr, msg_len)
            threads[me].state = STATE_SEND_BLOCKED
            threads[me].wake_tick = 0
            return

        // Server not waiting — enqueue sender in port's FIFO
        ipc_queue_push(port, me)

        // Block the sender (waits for reply, no timeout)
        threads[me].state = STATE_SEND_BLOCKED
        threads[me].wake_tick = 0

Check if a server is waiting for a message on a given port.
Returns 1 if waiting (RECV_BLOCKED or RECV_NOTIFY_BLOCKED), 0 otherwise.

    ipc_server_waiting(owner: int, port: int) -> int
        val st = threads[owner].state
        if st == STATE_RECV_BLOCKED
            if ipc_ctx[owner].port == port
                return 1
        else if st == STATE_RECV_NOTIFY_BLOCKED
            if ipc_ctx[owner].port == port
                return 1
        0

Deliver a message from sender to server and wake the server.
Used by send handlers when the server is already waiting.

    ipc_write_saved_r1(tid: int, value: i64)
        val vaddr = int(threads[tid].ssp + SYSCALL_RETURN_OFFSET)
        val paddr = vm_v2p(threads[tid].ptbr, vaddr)
        var p: *i64 = *i64(paddr)
        *p = value

    ipc_deliver_and_wake(owner: int, sender: int, msg_ptr: i64, msg_len: int)
        ipc_deliver(owner, sender, msg_ptr, msg_len)
        ipc_write_saved_r1(owner, sender)
        threads[owner].state = STATE_READY
        threads[owner].quantum = DEFAULT_QUANTUM
        enqueue(threads[owner].priority, owner)

Copy message from sender to receiver's buffer, handling
truncation. Sets actual_len on the receiver's IPC context.

    ipc_deliver(receiver: int, sender: int, msg_ptr: i64, msg_len: int)
        val buf_ptr = ipc_ctx[receiver].buf
        val buf_len = ipc_ctx[receiver].len
        val copy_len = if msg_len > buf_len then buf_len else msg_len
        val sender_ptbr = threads[sender].ptbr
        val receiver_ptbr = threads[receiver].ptbr

        if sender_ptbr == receiver_ptbr
            // Same address space — direct memcpy (fast path)
            ipc_memcpy(buf_ptr, msg_ptr, copy_len)
        else
            // Cross-address-space: DMA with physical address mode
            // (translates both sides via page table, then DMA bypasses MMU)
            vm_copy_cross(sender_ptbr, int(msg_ptr), receiver_ptbr, int(buf_ptr), copy_len)

        ipc_ctx[receiver].actual_len = copy_len
        ipc_ctx[receiver].sender = sender

Receive a message on a port. The arg is a pointer to a packed
argument block: [port, buf_ptr, buf_len].
Returns sender's thread ID, or -1 on error.
Blocks until a client sends a message.

    ipc_recv_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val buf_ptr = args[1]
        val buf_len = int(args[2])
        val me = current_thread

        // Validate: must own the port
        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if port_owner[port] != me
            syscall_return(-1)
            ipc_continue_current()
            return

        // Store receiver's IPC context
        ipc_ctx[me].buf = buf_ptr
        ipc_ctx[me].len = buf_len
        ipc_ctx[me].port = port

        // Check the port's wait queue for a blocked sender
        // Skip stale entries (threads that timed out)
        var sender = ipc_queue_pop(port)
        while sender != IPC_QUEUE_EMPTY
            if threads[sender].state == STATE_SEND_BLOCKED
                // Found a valid sender — deliver their message
                ipc_deliver(me, sender, ipc_ctx[sender].buf, ipc_ctx[sender].len)

                // Return sender ID to the server
                syscall_return(sender)

                // Server stays runnable (re-enqueue)
                threads[me].state = STATE_READY
                threads[me].quantum = DEFAULT_QUANTUM
                enqueue(threads[me].priority, me)
                return
            // Stale entry (timed out) — skip and try next
            sender = ipc_queue_pop(port)

        // No sender waiting — block the receiver
        threads[me].state = STATE_RECV_BLOCKED

Reply to a client. The arg is a pointer to a packed argument
block: [caller_tid, msg_ptr, msg_len].
Copies the reply to the client's reply buffer and unblocks it.
The server continues running (no block).

    ipc_reply_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val caller = int(args[0])
        val msg_ptr = args[1]
        val msg_len = int(args[2])
        val me = current_thread

        // Validate caller
        if caller < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if caller >= thread_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if threads[caller].state != STATE_SEND_BLOCKED
            syscall_return(-1)
            ipc_continue_current()
            return

        // Copy reply from server (me) to caller's reply buffer.
        // Handles cross-address-space copies via page table walks.
        val server_ptbr = threads[me].ptbr
        val caller_ptbr = threads[caller].ptbr
        val rply_len = ipc_ctx[caller].reply_len
        val copy_len = if msg_len > rply_len then rply_len else msg_len

        if server_ptbr == caller_ptbr
            // Same address space — direct memcpy
            ipc_memcpy(ipc_ctx[caller].reply_buf, msg_ptr, copy_len)
        else
            // Cross-address-space: DMA with physical address mode
            vm_copy_cross(server_ptbr, int(msg_ptr), caller_ptbr, int(ipc_ctx[caller].reply_buf), copy_len)

        // Write return value to caller's saved r1 on its SSP
        ipc_write_saved_r1(caller, 0)
        threads[caller].state = STATE_READY
        threads[caller].quantum = DEFAULT_QUANTUM
        threads[caller].wake_tick = 0
        enqueue(threads[caller].priority, caller)

        // Server re-enqueues itself
        ipc_continue_current()

Close a port. Wakes all blocked senders with error (-1).
Only the port owner can close it.

    ipc_port_close_handler(arg: int)
        val port = int(i64(arg))
        val me = current_thread

        // Validate
        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if port_owner[port] != me
            syscall_return(-1)
            ipc_continue_current()
            return

        // Wake all blocked senders with error
        var tid = ipc_queue_pop(port)
        while tid != IPC_QUEUE_EMPTY
            ipc_write_saved_r1(tid, -1)
            threads[tid].state = STATE_READY
            threads[tid].quantum = DEFAULT_QUANTUM
            enqueue(threads[tid].priority, tid)
            tid = ipc_queue_pop(port)

        // Free the port
        port_owner[port] = IPC_PORT_FREE
        syscall_return(0)
        ipc_continue_current()

Register a name for a port. The arg is a pointer to a packed
argument block: [port, name_ptr, name_len]. Only the port owner
can register a name. Returns 0 on success, -1 on error.

    ipc_port_register_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val src: *byte = *byte(args[1])
        val slen = int(args[2])
        val me = current_thread

        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if port_owner[port] != me
            syscall_return(-1)
            ipc_continue_current()
            return

        // Clear any existing port with the same name (handles stale ports
        // from dead servers so the new registration wins in lookups)
        var ci = 0
        while ci < port_count
            if ci != port
                if port_name_len[ci] > 0
                    if ipc_strcmp(src, slen, &port_name_buf[ci * 8], port_name_len[ci]) == 0
                        port_name_len[ci] = 0
            ci += 1

        // Copy name bytes into kernel-owned buffer (safe across address spaces)
        val base = port * 8
        var nlen = slen
        if nlen > 7
            nlen = 7
        var ni = 0
        while ni < nlen
            port_name_buf[base + ni] = src[ni]
            ni += 1
        port_name_len[port] = nlen
        syscall_return(0)
        ipc_continue_current()

Look up a port by name. The arg is a pointer to a packed
argument block: [name_ptr, name_len]. Returns port ID, or
-1 if not found.

    ipc_port_lookup_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val name: *byte = *byte(args[0])
        val nlen = int(args[1])
        var i = 0
        while i < port_count
            if port_owner[i] != IPC_PORT_FREE
                if port_name_len[i] > 0
                    if ipc_strcmp(name, nlen, &port_name_buf[i * 8], port_name_len[i]) == 0
                        syscall_return(i)
                        ipc_continue_current()
                        return
            i += 1
        syscall_return(-1)
        ipc_continue_current()

Send with timeout. Same as ipc_send but with a tick deadline.
The arg is a pointer to a packed argument block:
[port, msg_ptr, msg_len, reply_ptr, reply_len, timeout_ticks].
Returns 0 on success, -1 on error, -2 on timeout.

    ipc_send_timed_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val msg_ptr = args[1]
        val msg_len = int(args[2])
        val rply_buf = args[3]
        val rply_len = int(args[4])
        val timeout = int(args[5])
        val me = current_thread

        // Validate port
        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if port_owner[port] == IPC_PORT_FREE
            syscall_return(-1)
            ipc_continue_current()
            return

        // IPC send permission check
        if ipc_check_send_allowed(port) == 0
            syscall_return(-1)
            ipc_continue_current()
            return

        // Store sender's IPC context
        ipc_ctx[me].buf = msg_ptr
        ipc_ctx[me].len = msg_len
        ipc_ctx[me].reply_buf = rply_buf
        ipc_ctx[me].reply_len = rply_len
        ipc_ctx[me].port = port

        // Check if the server is already waiting
        val owner = port_owner[port]
        if ipc_server_waiting(owner, port) == 1
            ipc_deliver_and_wake(owner, me, msg_ptr, msg_len)
            // Block sender with timeout (waiting for reply)
            threads[me].state = STATE_SEND_BLOCKED
            threads[me].wake_tick = ticks + timeout
            sleepq_insert(me)
            return

        // Server not waiting — enqueue with timeout
        ipc_queue_push(port, me)
        threads[me].state = STATE_SEND_BLOCKED
        threads[me].wake_tick = ticks + timeout
        sleepq_insert(me)

Receive a message OR notification. Like ipc_recv but also
wakes when a notification is sent to this thread.
Returns sender ID for IPC messages, -2 for notifications.
On notification, call notify_read() to get the value.

    ipc_recv_notify_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val buf_ptr = args[1]
        val buf_len = int(args[2])
        val me = current_thread

        // Validate: must own the port
        if port < 0
            syscall_return(-1)
            ipc_continue_current()
            return
        if port >= port_count
            syscall_return(-1)
            ipc_continue_current()
            return
        if port_owner[port] != me
            syscall_return(-1)
            ipc_continue_current()
            return

        // Store receiver's IPC context
        ipc_ctx[me].buf = buf_ptr
        ipc_ctx[me].len = buf_len
        ipc_ctx[me].port = port

        // Check the port's wait queue for a blocked sender FIRST
        // (notifications are frequent — e.g. mouse events — and must not starve IPC)
        var sender = ipc_queue_pop(port)
        while sender != IPC_QUEUE_EMPTY
            if threads[sender].state == STATE_SEND_BLOCKED
                // DEBUG: receiver found queued sender (me←sender)
                debug_char('{')
                debug_hex4(me)
                debug_char('<')
                debug_hex4(sender)
                debug_char('}')
                ipc_deliver(me, sender, ipc_ctx[sender].buf, ipc_ctx[sender].len)
                syscall_return(sender)
                threads[me].state = STATE_READY
                threads[me].quantum = DEFAULT_QUANTUM
                enqueue(threads[me].priority, me)
                return
            // DEBUG: popped non-SEND_BLOCKED sender — state mismatch
            debug_char('{')
            debug_char('!')
            debug_hex4(sender)
            debug_char(':')
            debug_hex4(threads[sender].state)
            debug_char('}')
            sender = ipc_queue_pop(port)

        // No IPC message — check for pending notification
        if threads[me].notify_pending == 1
            // No message delivered — do not leave a stale actual_len from a prior recv.
            ipc_ctx[me].actual_len = 0
            syscall_return(-2)
            ipc_continue_current()
            return

        // No sender, no notification — block waiting for either
        threads[me].state = STATE_RECV_NOTIFY_BLOCKED

Returns the actual byte count of the last received IPC message.
Call after ipc_recv returns to get the message length.

    ipc_last_msg_len() -> int
        ipc_ctx[current_thread].actual_len

Userspace wrappers. These pack arguments and invoke syscalls.

    port_create() -> int
        syscall(SYS_PORT_CREATE, 0)

    port_close(port: int) -> int
        syscall(SYS_PORT_CLOSE, port)

    port_register(port: int, name: string) -> int
        var args: [3]i64
        args[0] = port
        args[1] = i64(*byte(name))
        args[2] = len(name)
        syscall(SYS_PORT_REGISTER, i64(args))

    port_lookup(name: string) -> int
        var args: [2]i64
        args[0] = i64(*byte(name))
        args[1] = len(name)
        syscall(SYS_PORT_LOOKUP, i64(args))

    ipc_send(port: int, msg: *byte, msg_len: int, reply: *byte, reply_len: int) -> int
        var args: [5]i64
        args[0] = port
        args[1] = i64(msg)
        args[2] = msg_len
        args[3] = i64(reply)
        args[4] = reply_len
        syscall(SYS_IPC_SEND, i64(args))

    ipc_recv(port: int, buf: *byte, buf_len: int) -> int
        var args: [3]i64
        args[0] = port
        args[1] = i64(buf)
        args[2] = buf_len
        syscall(SYS_IPC_RECV, i64(args))

    ipc_reply(caller: int, msg: *byte, msg_len: int)
        var args: [3]i64
        args[0] = caller
        args[1] = i64(msg)
        args[2] = msg_len
        syscall(SYS_IPC_REPLY, i64(args))

    ipc_recv_notify(port: int, buf: *byte, buf_len: int) -> int
        var args: [3]i64
        args[0] = port
        args[1] = i64(buf)
        args[2] = buf_len
        syscall(SYS_IPC_RECV_NOTIFY, i64(args))

    ipc_send_timeout(port: int, msg: *byte, msg_len: int, reply: *byte, reply_len: int, timeout: int) -> int
        var args: [6]i64
        args[0] = port
        args[1] = i64(msg)
        args[2] = msg_len
        args[3] = i64(reply)
        args[4] = reply_len
        args[5] = timeout
        syscall(SYS_IPC_SEND_TIMED, i64(args))
