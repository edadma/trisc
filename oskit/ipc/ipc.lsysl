OSKit IPC — Synchronous Rendezvous Message Passing

Port-based IPC with synchronous send/recv/reply. No allocation
needed — callers provide their own buffers, and the kernel
copies data directly between them.

Flow:
1. Server calls port_create() → gets a port ID
2. Server calls recv(port, buf, len) → blocks until message
3. Client calls send(port, msg, len, reply_buf, reply_len) → blocks
4. Kernel copies msg to server's buf, unblocks server
5. Server processes request
6. Server calls reply(client_tid, response, len) → unblocks client
7. Kernel copies response to client's reply_buf

States 11-12 are reserved for IPC (oskit kernel states 0-10).

    module oskit

    val STATE_SEND_BLOCKED = 11
    val STATE_RECV_BLOCKED = 12

    val MAX_PORTS = 8
    val IPC_PORT_FREE = -1

Per-thread IPC state, parallel to the tasks[] array. Each
thread has its own IPC context used during send/recv/reply.

    struct IPCContext
        buf: i64
        len: int
        reply_buf: i64
        reply_len: int
        port: int
        sender: int
        actual_len: int

    var ipc_ctx: [8]IPCContext
    var port_owner: [8]int
    var port_count = 0

Syscall numbers for IPC (31-34).

    val SYS_PORT_CREATE  = 31
    val SYS_IPC_SEND     = 32
    val SYS_IPC_RECV     = 33
    val SYS_IPC_REPLY    = 34

    extern syscall(num: int, arg: i64) -> int

Simple byte copy between memory addresses.

    ipc_memcpy(dst: i64, src: i64, len: int)
        var d: *i8 = *i8(dst)
        var s: *i8 = *i8(src)
        var i = 0
        while i < len
            d[i] = s[i]
            i += 1

Initialize the IPC subsystem. Clears all ports and registers
syscall handlers. Call from kernel_main before creating threads.

    ipc_init()
        var i = 0
        while i < MAX_PORTS
            port_owner[i] = IPC_PORT_FREE
            i += 1
        register_syscall(SYS_PORT_CREATE, ipc_port_create_handler)
        register_syscall(SYS_IPC_SEND, ipc_send_handler)
        register_syscall(SYS_IPC_RECV, ipc_recv_handler)
        register_syscall(SYS_IPC_REPLY, ipc_reply_handler)

Create a new port owned by the current thread.
Returns the port ID in the saved r1 slot on the SSP so the
syscall return value is visible to the caller.

    ipc_port_create_handler(arg: int)
        if port_count >= MAX_PORTS
            syscall_return(-1)
            // Re-enqueue so thread keeps running after do_schedule
            tasks[current_thread].state = STATE_READY
            enqueue(tasks[current_thread].priority, current_thread)
            return
        val id = port_count
        port_owner[id] = current_thread
        port_count += 1
        syscall_return(id)
        // Re-enqueue so thread keeps running after do_schedule
        tasks[current_thread].state = STATE_READY
        enqueue(tasks[current_thread].priority, current_thread)

Send a message and wait for reply. The arg is a pointer to
a packed argument block: [port, msg_ptr, msg_len, reply_ptr, reply_len].
Blocks the sender until the server calls reply().

    ipc_send_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val msg_ptr = args[1]
        val msg_len = int(args[2])
        val rply_buf = args[3]
        val rply_len = int(args[4])
        val me = current_thread

        // Validate port
        if port < 0
            return
        if port >= port_count
            return

        // Store sender's IPC context
        ipc_ctx[me].buf = msg_ptr
        ipc_ctx[me].len = msg_len
        ipc_ctx[me].reply_buf = rply_buf
        ipc_ctx[me].reply_len = rply_len
        ipc_ctx[me].port = port

        // Check if the server is already waiting for a message
        val owner = port_owner[port]
        if tasks[owner].state == STATE_RECV_BLOCKED
            if ipc_ctx[owner].port == port
                // Server is waiting — deliver the message now
                val copy_len = msg_len
                if copy_len > ipc_ctx[owner].len
                    // Message too big: truncate (could return error)
                    // For now, copy what fits
                    ipc_memcpy(ipc_ctx[owner].buf, msg_ptr, ipc_ctx[owner].len)
                    ipc_ctx[owner].actual_len = ipc_ctx[owner].len
                else
                    ipc_memcpy(ipc_ctx[owner].buf, msg_ptr, copy_len)
                    ipc_ctx[owner].actual_len = copy_len
                ipc_ctx[owner].sender = me

                // Wake the server
                tasks[owner].state = STATE_READY
                tasks[owner].quantum = DEFAULT_QUANTUM
                enqueue(tasks[owner].priority, owner)

        // Block the sender (waits for reply)
        tasks[me].state = STATE_SEND_BLOCKED

Receive a message on a port. The arg is a pointer to a packed
argument block: [port, buf_ptr, buf_len].
Blocks until a client sends a message.

    ipc_recv_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val port = int(args[0])
        val buf_ptr = args[1]
        val buf_len = int(args[2])
        val me = current_thread

        // Validate: must own the port
        if port < 0
            return
        if port >= port_count
            return
        if port_owner[port] != me
            return

        // Store receiver's IPC context
        ipc_ctx[me].buf = buf_ptr
        ipc_ctx[me].len = buf_len
        ipc_ctx[me].port = port

        // Check if any thread is send-blocked on this port
        var i = 0
        while i < thread_count
            if tasks[i].state == STATE_SEND_BLOCKED
                if ipc_ctx[i].port == port
                    // Found a waiting sender — deliver their message
                    val msg_len = ipc_ctx[i].len
                    if msg_len > buf_len
                        ipc_memcpy(buf_ptr, ipc_ctx[i].buf, buf_len)
                        ipc_ctx[me].actual_len = buf_len
                    else
                        ipc_memcpy(buf_ptr, ipc_ctx[i].buf, msg_len)
                        ipc_ctx[me].actual_len = msg_len
                    ipc_ctx[me].sender = i

                    // Return sender ID to the server
                    syscall_return(i)

                    // Server stays runnable (re-enqueue)
                    tasks[me].state = STATE_READY
                    tasks[me].quantum = DEFAULT_QUANTUM
                    enqueue(tasks[me].priority, me)
                    return
            i += 1

        // No sender waiting — block the receiver
        tasks[me].state = STATE_RECV_BLOCKED

Reply to a client. The arg is a pointer to a packed argument
block: [caller_tid, msg_ptr, msg_len].
Copies the reply to the client's reply buffer and unblocks it.
The server continues running (no block).

    ipc_reply_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val caller = int(args[0])
        val msg_ptr = args[1]
        val msg_len = int(args[2])
        val me = current_thread

        // Validate caller
        if caller < 0
            return
        if caller >= thread_count
            return
        if tasks[caller].state != STATE_SEND_BLOCKED
            return

        // Copy reply to caller's reply buffer
        val rply_len = ipc_ctx[caller].reply_len
        if msg_len > rply_len
            ipc_memcpy(ipc_ctx[caller].reply_buf, msg_ptr, rply_len)
        else
            ipc_memcpy(ipc_ctx[caller].reply_buf, msg_ptr, msg_len)

        // Unblock the caller
        tasks[caller].state = STATE_READY
        tasks[caller].quantum = DEFAULT_QUANTUM
        enqueue(tasks[caller].priority, caller)

        // Server re-enqueues itself
        tasks[me].state = STATE_READY
        tasks[me].quantum = DEFAULT_QUANTUM
        enqueue(tasks[me].priority, me)

Userspace wrappers. These pack arguments and invoke syscalls.

    port_create() -> int
        syscall(SYS_PORT_CREATE, 0)

    ipc_send(port: int, msg: *i8, msg_len: int, reply: *i8, reply_len: int) -> int
        var args: [5]i64
        args[0] = port
        args[1] = i64(msg)
        args[2] = msg_len
        args[3] = i64(reply)
        args[4] = reply_len
        syscall(SYS_IPC_SEND, i64(&args[0]))

    ipc_recv(port: int, buf: *i8, buf_len: int) -> int
        var args: [3]i64
        args[0] = port
        args[1] = i64(buf)
        args[2] = buf_len
        syscall(SYS_IPC_RECV, i64(&args[0]))

    ipc_reply(caller: int, msg: *i8, msg_len: int)
        var args: [3]i64
        args[0] = caller
        args[1] = i64(msg)
        args[2] = msg_len
        syscall(SYS_IPC_REPLY, i64(&args[0]))
