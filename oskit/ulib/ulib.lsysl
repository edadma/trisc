User Library — Runtime for external programs
=============================================

Provides the SLIX platform layer for standalone programs.
External programs link against this to access OS services
via IPC, following the Minix 3 model: all services are
reached by sending messages to servers through the kernel's
message-passing primitives.

    module oskit.ulib

The `syscall` function is provided by the boot assembly.
External programs include their own copy of the trampoline
(3 instructions: load arg, trap 0, return).

    extern syscall(number: int, arg: i64) -> i64

Syscall numbers — must match the kernel and IPC modules.

    val SYS_SLEEP        = 0
    val SYS_PUTC         = 1
    val SYS_YIELD        = 2
    val SYS_EXIT         = 3
    val SYS_JOIN         = 4
    val SYS_THREAD_ID    = 5
    val SYS_UPTIME       = 6
    val SYS_THREAD_COUNT = 7
    val SYS_THREAD_STATE = 8
    val SYS_THREAD_NAME  = 9
    val SYS_IPC_SEND     = 32
    val SYS_PORT_LOOKUP  = 37
    val SYS_GETPID       = 41
    val SYS_THREAD_PID   = 42
    val SYS_THREAD_NAME_LEN = 43

Command bytes for TFS and TTY server protocols.

    val FS_CMD_OPEN    = 1
    val FS_CMD_READ    = 2
    val FS_CMD_WRITE   = 3
    val FS_CMD_CREATE  = 4
    val FS_CMD_UNLINK  = 5
    val FS_CMD_STAT    = 6
    val FS_CMD_MKDIR   = 7
    val FS_CMD_RMDIR   = 8
    val FS_CMD_READDIR = 9
    val FS_CMD_CHMOD   = 11
    val FS_CMD_RENAME  = 12
    val FS_CMD_CLOSE   = 13
    val FS_CMD_SEEK    = 14
    val FS_CMD_CONNECT = 15
    val FS_CMD_PIPE    = 18
    val TTY_CMD_PUTS   = 3

    val SYS_GETUID  = 61
    val SYS_SETUID  = 62

    val PM_CMD_WAITPID = 1
    val PM_CMD_KILL    = 2
    val PM_CMD_SPAWN   = 3

Big-endian message helpers — pack/unpack 32-bit integers
in IPC message buffers.

    msg_write_i32(buf: *byte, off: int, v: int)
        buf[off]     = byte((v >> 24) & 0xFF)
        buf[off + 1] = byte((v >> 16) & 0xFF)
        buf[off + 2] = byte((v >> 8) & 0xFF)
        buf[off + 3] = byte(v & 0xFF)

    msg_read_i32(buf: *byte, off: int) -> int
        ((buf[off] & 0xFF) << 24) | ((buf[off + 1] & 0xFF) << 16) | ((buf[off + 2] & 0xFF) << 8) | (buf[off + 3] & 0xFF)

IPC — send a message to a server and receive a reply.

    ipc_send(port: int, msg: *byte, msg_len: int, reply: *byte, reply_len: int) -> int
        var args: [5]i64
        args[0] = port
        args[1] = i64(msg)
        args[2] = msg_len
        args[3] = i64(reply)
        args[4] = reply_len
        syscall(SYS_IPC_SEND, i64(&args[0]))

Service discovery — look up a server port by name.

    port_lookup(name: string) -> int
        var args: [2]i64
        args[0] = i64(*byte(name))
        args[1] = len(name)
        syscall(SYS_PORT_LOOKUP, i64(&args[0]))

Thread and process queries.

    get_thread_count() -> int
        syscall(SYS_THREAD_COUNT, 0)

    get_thread_state(id: int) -> int
        syscall(SYS_THREAD_STATE, id)

    get_thread_name(id: int) -> *byte
        syscall(SYS_THREAD_NAME, id)

    get_thread_name_len(id: int) -> int
        syscall(SYS_THREAD_NAME_LEN, id)

    get_thread_pid(id: int) -> int
        syscall(SYS_THREAD_PID, id)

    getpid() -> int
        syscall(SYS_GETPID, 0)

Process control.

    exit()
        syscall(SYS_EXIT, 0)

    exit_with(code: int)
        syscall(SYS_EXIT, code)

    sleep(ticks: int)
        syscall(SYS_SLEEP, ticks)

    yield()
        syscall(SYS_YIELD, 0)

Single character output (fast-path syscall).

    putc(ch: int)
        syscall(SYS_PUTC, ch)

Write a string to stdout (handle 1) via VFS.

    val STDIN  = 0
    val STDOUT = 1
    val STDERR = 2

    write_handle(handle: int, data: *byte, wlen: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [13]byte
        msg[0] = byte(FS_CMD_WRITE)
        msg_write_i32(&msg[0], 1, handle)
        msg_write_i32(&msg[0], 5, wlen)
        msg_write_i32(&msg[0], 9, int(i64(data)))
        var reply: [5]byte
        val result = ipc_send(port, &msg[0], 13, &reply[0], 5)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

    puts(s: string)
        val n = len(s)
        val p = *byte(s)
        write_handle(STDOUT, p, n)

Open a file by path. Returns a file ID or -1 on error.

    open(path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val plen = len(path)
        val pp = *byte(path)
        var m = plen
        if m < 0
            m = 0
        if m > 127
            m = 127
        var msg: [128]byte
        msg[0] = byte(FS_CMD_OPEN)
        for var i = 0; i < m; i++
            msg[i + 1] = pp[i]
        var reply: [9]byte
        ipc_send(port, &msg[0], m + 1, &reply[0], 9)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Read from an open file. Position is tracked by VFS.
Returns the number of bytes read, or -1 on error.

    read(fid: int, buf: *byte, count: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [13]byte
        msg[0] = byte(FS_CMD_READ)
        msg_write_i32(&msg[0], 1, fid)
        msg_write_i32(&msg[0], 5, count)
        msg_write_i32(&msg[0], 9, int(i64(buf)))
        var reply: [5]byte
        val result = ipc_send(port, &msg[0], 13, &reply[0], 5)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Close an open file.

    close(fid: int)
        val port = fs_port()
        if port < 0
            return
        var msg: [5]byte
        msg[0] = byte(FS_CMD_CLOSE)
        msg_write_i32(&msg[0], 1, fid)
        var reply: [1]byte
        ipc_send(port, &msg[0], 5, &reply[0], 1)

Get the filesystem server port (cached).

    var fs_port_cache = -2

    fs_port() -> int
        if fs_port_cache == -2
            fs_port_cache = port_lookup("fs")
        fs_port_cache

Create a file at a path. Returns inode or -1 on error.
Protocol: [cmd(1), type(1), mode_hi(1), mode_lo(1), path(N)]

    create(path: string, ftype: int, mode: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_CREATE)
        msg[1] = byte(ftype)
        msg[2] = byte((mode >> 8) & 0xFF)
        msg[3] = byte(mode & 0xFF)
        for var i = 0; i < plen; i++
            msg[4 + i] = pp[i]
        var reply: [5]byte
        ipc_send(port, &msg[0], 4 + plen, &reply[0], 5)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Remove a file by path.

    unlink(path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_UNLINK)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [1]byte
        ipc_send(port, &msg[0], 1 + plen, &reply[0], 1)
        int(reply[0])

Create a directory at a path.

    mkdir(path: string, mode: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_MKDIR)
        msg[1] = byte((mode >> 8) & 0xFF)
        msg[2] = byte(mode & 0xFF)
        for var i = 0; i < plen; i++
            msg[3 + i] = pp[i]
        var reply: [5]byte
        ipc_send(port, &msg[0], 3 + plen, &reply[0], 5)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Remove a directory by path.

    rmdir(path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_RMDIR)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [1]byte
        ipc_send(port, &msg[0], 1 + plen, &reply[0], 1)
        int(reply[0])

Read a directory entry by path and index. Returns 0 on success, -1 on end.

    readdir(path: string, idx: int, entry_ino: *int, entry_name: *byte) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_READDIR)
        msg_write_i32(&msg[0], 1, idx)
        for var i = 0; i < plen; i++
            msg[5 + i] = pp[i]
        var reply: [19]byte
        ipc_send(port, &msg[0], 5 + plen, &reply[0], 19)
        if reply[0] != 0
            return -1
        *entry_ino = msg_read_i32(&reply[0], 1)
        for var i = 0; i < 14; i++
            entry_name[i] = reply[5 + i]
        0

Get file status by path.

    stat(path: string, st: *int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_STAT)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [29]byte
        ipc_send(port, &msg[0], 1 + plen, &reply[0], 29)
        if reply[0] != 0
            return -1
        for var i = 0; i < 7; i++
            st[i] = msg_read_i32(&reply[0], 1 + i * 4)
        0

Change file permissions by path.

    chmod(path: string, mode: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_CHMOD)
        msg[1] = byte((mode >> 8) & 0xFF)
        msg[2] = byte(mode & 0xFF)
        for var i = 0; i < plen; i++
            msg[3 + i] = pp[i]
        var reply: [1]byte
        ipc_send(port, &msg[0], 3 + plen, &reply[0], 1)
        int(reply[0])

Rename/move a file by path.

    rename(old_path: string, new_path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val onp = *byte(old_path)
        val onlen = len(old_path)
        val nnp = *byte(new_path)
        val nnlen = len(new_path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_RENAME)
        msg[1] = byte(onlen)
        for var i = 0; i < onlen; i++
            msg[2 + i] = onp[i]
        for var i = 0; i < nnlen; i++
            msg[2 + onlen + i] = nnp[i]
        var reply: [1]byte
        ipc_send(port, &msg[0], 2 + onlen + nnlen, &reply[0], 1)
        int(reply[0])

System queries and control.

    uptime() -> int
        syscall(SYS_UPTIME, 0)

    getuid() -> int
        syscall(SYS_GETUID, 0)

    setuid(uid: int)
        syscall(SYS_SETUID, uid)

Read one byte from stdin (handle 0). Blocks until data
is available. Returns the byte value or -1 on error.

    getc() -> int
        var buf: [1]byte
        val n = read(STDIN, &buf[0], 1)
        if n <= 0
            return -1
        int(buf[0])

Connect to a named resource via VFS. Supports scheme-based
routing: `connect("tty:0")`, `connect("vfs:/etc/passwd")`.
Returns a handle or -1 on error.

    connect(name: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(name)
        val nlen = len(name)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_CONNECT)
        for var i = 0; i < nlen; i++
            msg[i + 1] = pp[i]
        var reply: [9]byte
        ipc_send(port, &msg[0], nlen + 1, &reply[0], 9)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Seek to a position in an open file.
whence: 0 = SET, 1 = CUR. Returns new position, or -1.

    seek(fid: int, offset: int, whence: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [10]byte
        msg[0] = byte(FS_CMD_SEEK)
        msg_write_i32(&msg[0], 1, fid)
        msg_write_i32(&msg[0], 5, offset)
        msg[9] = byte(whence)
        var reply: [5]byte
        ipc_send(port, &msg[0], 10, &reply[0], 5)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Create a pipe. Writes read/write handles to pointers.
Returns 0 on success, -1 on error.

    pipe(read_h: *int, write_h: *int) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(FS_CMD_PIPE)
        var reply: [9]byte
        val result = ipc_send(port, &msg[0], 1, &reply[0], 9)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        *read_h = msg_read_i32(&reply[0], 1)
        *write_h = msg_read_i32(&reply[0], 5)
        0

PM IPC — process management.

Look up the PM server port (cached).

    var pm_port_cache = -2

    pm_port() -> int
        if pm_port_cache == -2
            pm_port_cache = port_lookup("pm")
        pm_port_cache

Wait for a child process to exit. Returns exit code or -1.

    pm_waitpid(pid: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(PM_CMD_WAITPID)
        msg_write_i32(&msg[0], 1, pid)
        var reply: [5]byte
        ipc_send(port, &msg[0], 5, &reply[0], 5)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Kill a process by PID. Returns 0 on success.

    pm_kill(pid: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(PM_CMD_KILL)
        msg_write_i32(&msg[0], 1, pid)
        var reply: [1]byte
        ipc_send(port, &msg[0], 5, &reply[0], 1)
        int(reply[0])

Spawn a process with no handle inheritance.

    pm_spawn(path: string, args: string) -> int
        pm_spawn_handles(path, args, *byte(0), 0)

Spawn a process with handle inheritance. handle_pairs is
an array of (parent_handle, child_slot) byte pairs.
Returns child PID or -1 on error.

    pm_spawn_handles(path: string, args: string, handle_pairs: *byte, num_handles: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        val plen = len(path)
        val alen = len(args)
        var msg: [128]byte
        msg[0] = byte(PM_CMD_SPAWN)
        msg[1] = byte(plen)
        msg[2] = byte(alen)
        msg[3] = byte(num_handles)
        val pp = *byte(path)
        var i = 0
        while i < plen
            msg[4 + i] = pp[i]
            i += 1
        val ap = *byte(args)
        i = 0
        while i < alen
            msg[4 + plen + i] = ap[i]
            i += 1
        i = 0
        while i < num_handles * 2
            msg[4 + plen + alen + i] = handle_pairs[i]
            i += 1
        var reply: [5]byte
        ipc_send(port, &msg[0], 4 + plen + alen + num_handles * 2, &reply[0], 5)
        if reply[0] != 0
            return -1
        msg_read_i32(&reply[0], 1)

Print an integer to stdout.

    putint(n: int)
        if n < 0
            puts("-")
            putint(-n)
            return
        if n >= 10
            putint(n / 10)
        var buf: [1]byte
        buf[0] = byte('0' + n % 10)
        write_handle(STDOUT, &buf[0], 1)

Program arguments — stored at a well-known address by the
shell before launching the program. This convention will be
replaced by proper exec() argument passing when the MMU
and process manager land.

    val PROG_ARGS_ADDR = 0xBF000

    get_args() -> string
        val p = *byte(PROG_ARGS_ADDR)
        var n = 0
        while p[n] != 0
            n += 1
        if n == 0
            return ""
        string(p, n)

Skip past argv[0] (the program name) and any following spaces.
Returns the remaining arguments as a string, or "" if none.

    skip_arg0(s: string) -> string
        val p = *byte(s)
        val n = len(s)
        // Skip non-space (argv[0])
        var i = 0
        while i < n
            if p[i] == byte(' ')
                break
            i += 1
        // Skip spaces
        while i < n
            if p[i] != byte(' ')
                break
            i += 1
        if i >= n
            return ""
        string(p + i, n - i)
