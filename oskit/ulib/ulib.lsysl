User Library — Runtime for external programs
=============================================

Provides the SLIX platform layer for standalone programs.
External programs link against this to access OS services
via IPC, following the Minix 3 model: all services are
reached by sending messages to servers through the kernel's
message-passing primitives.

    module oskit.ulib

The `syscall` function is provided by the boot assembly.
External programs include their own copy of the trampoline
(3 instructions: load arg, trap 0, return).

    extern syscall(number: int, arg: i64) -> i64

Multi-arg variant for syscalls registered via `register_syscall6`.
The asm wrapper (per-arch) arranges for the kernel's 6-arg dispatch
path to receive a0..a5 in the appropriate saved-frame slots.

    extern syscall6(number: int, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64

Syscall numbers — must match the kernel and IPC modules.

    val SYS_SLEEP        = 0
    val SYS_PUTC         = 1
    val SYS_YIELD        = 2
    val SYS_EXIT         = 3
    val SYS_JOIN         = 4
    val SYS_THREAD_ID    = 5
    val SYS_UPTIME       = 6
    val SYS_THREAD_COUNT = 7
    val SYS_THREAD_STATE = 8
    val SYS_THREAD_NAME  = 9
    val SYS_IPC_SEND     = 32
    val SYS_PORT_LOOKUP  = 37
    val SYS_GETPID       = 41
    val SYS_THREAD_PID   = 42
    val SYS_THREAD_NAME_LEN = 43

Command bytes for TFS and TTY server protocols.

    val FS_CMD_OPEN    = 1
    val FS_CMD_READ    = 2
    val FS_CMD_WRITE   = 3
    val FS_CMD_CREATE  = 4
    val FS_CMD_UNLINK  = 5
    val FS_CMD_STAT    = 6
    val FS_CMD_MKDIR   = 7
    val FS_CMD_RMDIR   = 8
    val FS_CMD_READDIR = 9
    val FS_CMD_CHMOD   = 11
    val FS_CMD_RENAME  = 12
    val FS_CMD_CLOSE   = 13
    val FS_CMD_SEEK    = 14
    val FS_CMD_CONNECT = 15
    val FS_CMD_PIPE    = 18
    val FS_CMD_ACCEPT  = 19
    val TTY_CMD_PUTS   = 3

    val SYS_GETUID  = 61
    val SYS_SETUID  = 62

    val SYS_NOTIFY_WAIT      = 24
    val SYS_NOTIFY_READ      = 25
    val SYS_TIMER_SUBSCRIBE  = 81

    val SYS_GRANT_CREATE = 71
    val SYS_GRANT_REVOKE = 72

    val GRANT_READ  = 1
    val GRANT_WRITE = 2
    val GRANT_RW    = 3

    grant_create(vaddr: u64, len: int, flags: int) -> int
        int(syscall6(SYS_GRANT_CREATE, i64(vaddr), i64(len), i64(flags), 0, 0, 0))

    grant_revoke(grant_id: int)
        syscall(SYS_GRANT_REVOKE, i64(grant_id))

    val PM_CMD_WAITPID = 1
    val PM_CMD_KILL    = 2
    val PM_CMD_SPAWN   = 3
    val PM_CMD_SPAWN_SUSP    = 7
    val PM_CMD_TRANSPLANT_FD = 8
    val PM_CMD_RESUME        = 9

Big-endian message helpers — pack/unpack 32-bit integers
in IPC message buffers.

    msg_write_i32(buf: *byte, off: int, v: int)
        buf[off]     = byte((v >> 24) & 0xFF)
        buf[off + 1] = byte((v >> 16) & 0xFF)
        buf[off + 2] = byte((v >> 8) & 0xFF)
        buf[off + 3] = byte(v & 0xFF)

    msg_read_i32(buf: *byte, off: int) -> int
        ((buf[off] & 0xFF) << 24) | ((buf[off + 1] & 0xFF) << 16) | ((buf[off + 2] & 0xFF) << 8) | (buf[off + 3] & 0xFF)

IPC — send a message to a server and receive a reply.

    ipc_send(port: int, msg: *byte, msg_len: int, reply: *byte, reply_len: int) -> int
        int(syscall6(SYS_IPC_SEND, i64(port), i64(msg), i64(msg_len), i64(reply), i64(reply_len), 0))

Service discovery — look up a server port by name.

    port_lookup(name: string) -> int
        int(syscall6(SYS_PORT_LOOKUP, i64(*byte(name)), i64(len(name)), 0, 0, 0, 0))

Thread and process queries.

    get_thread_count() -> int
        syscall(SYS_THREAD_COUNT, 0)

    get_thread_state(id: int) -> int
        syscall(SYS_THREAD_STATE, id)

Copy the name of thread `id` into the caller-provided buffer of
`cap` bytes. Writes at most `cap-1` bytes plus a terminating NUL.
Returns the number of name bytes copied (not counting the NUL), or
0 if `cap <= 0`.

First consumer of the 6-arg dispatch path — kills the old handler's
INFO_PAGE_VA+0x100 scratch region. Handler runs under the caller's
PTBR so the buffer VA is written directly.

    get_thread_name(id: int, buf: *byte, cap: int) -> int
        int(syscall6(SYS_THREAD_NAME, i64(id), i64(buf), i64(cap), 0, 0, 0))

    get_thread_name_len(id: int) -> int
        syscall(SYS_THREAD_NAME_LEN, id)

    get_thread_pid(id: int) -> int
        syscall(SYS_THREAD_PID, id)

    getpid() -> int
        syscall(SYS_GETPID, 0)

Process control.

    exit()
        syscall(SYS_EXIT, 0)

    exit_with(code: int)
        syscall(SYS_EXIT, code)

    ulib_putc(ch: int)
        syscall(SYS_PUTC, ch)

    sleep(ticks: int)
        syscall(SYS_SLEEP, ticks)

    yield()
        syscall(SYS_YIELD, 0)

Single character output (fast-path syscall).

    putc(ch: int)
        syscall(SYS_PUTC, ch)

Write a string to stdout (handle 1) via VFS.

    val STDIN  = 0
    val STDOUT = 1
    val STDERR = 2

    val WRITE_INLINE_MAX = 100

    write_handle(handle: int, data: *byte, wlen: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        // Short writes skip the grant-create/revoke dance entirely
        // and inline the payload into the FS_CMD_WRITE message
        // itself. VFS already buffers through a 128-byte scratch,
        // so the server-side grant_map + copy + unmap chain is
        // pure overhead for anything that fits. grant_id = -1 is
        // the "inline" sentinel; data starts at offset 13.
        if wlen >= 0 && wlen <= WRITE_INLINE_MAX
            var msg: [128]byte
            msg[0] = byte(FS_CMD_WRITE)
            msg_write_i32(msg, 1, handle)
            msg_write_i32(msg, 5, wlen)
            msg_write_i32(msg, 9, -1)
            var i = 0
            while i < wlen
                msg[13 + i] = data[i]
                i += 1
            var reply: [5]byte
            val result = ipc_send(port, msg, 13 + wlen, reply, 5)
            if result != 0
                return -1
            if reply[0] != 0
                return -1
            return msg_read_i32(reply, 1)
        // Long writes still go via a grant — the server-side
        // mapping avoids copying the whole payload into our IPC
        // buffer just to copy it again on the far side.
        val gid = grant_create(u64(data), wlen, GRANT_READ)
        if gid < 0
            return -1
        var msg: [13]byte
        msg[0] = byte(FS_CMD_WRITE)
        msg_write_i32(msg, 1, handle)
        msg_write_i32(msg, 5, wlen)
        msg_write_i32(msg, 9, gid)
        var reply: [5]byte
        val result = ipc_send(port, msg, 13, reply, 5)
        grant_revoke(gid)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

    puts(s: string)
        val n = len(s)
        val p = *byte(s)
        write_handle(STDOUT, p, n)

Open a file by path. Returns a file ID or -1 on error.

    open(path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val plen = len(path)
        val pp = *byte(path)
        var m = plen
        if m < 0
            m = 0
        if m > 127
            m = 127
        var msg: [128]byte
        msg[0] = byte(FS_CMD_OPEN)
        for var i = 0; i < m; i++
            msg[i + 1] = pp[i]
        var reply: [9]byte
        ipc_send(port, msg, m + 1, reply, 9)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Read from an open file. Position is tracked by VFS.
Returns the number of bytes read, or -1 on error.

    read(fid: int, buf: *byte, count: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val gid = grant_create(u64(buf), count, GRANT_WRITE)
        if gid < 0
            return -1
        var msg: [13]byte
        msg[0] = byte(FS_CMD_READ)
        msg_write_i32(msg, 1, fid)
        msg_write_i32(msg, 5, count)
        msg_write_i32(msg, 9, gid)
        var reply: [5]byte
        val result = ipc_send(port, msg, 13, reply, 5)
        grant_revoke(gid)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Close an open file.

    close(fid: int)
        val port = fs_port()
        if port < 0
            return
        var msg: [5]byte
        msg[0] = byte(FS_CMD_CLOSE)
        msg_write_i32(msg, 1, fid)
        var reply: [1]byte
        ipc_send(port, msg, 5, reply, 1)

Get the filesystem server port (cached).

    var fs_port_cache = -2

    fs_port() -> int
        if fs_port_cache == -2
            fs_port_cache = port_lookup("fs")
        fs_port_cache

Create a file at a path. Returns inode or -1 on error.
Protocol: [cmd(1), type(1), mode_hi(1), mode_lo(1), path(N)]

    create(path: string, ftype: int, mode: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_CREATE)
        msg[1] = byte(ftype)
        msg[2] = byte((mode >> 8) & 0xFF)
        msg[3] = byte(mode & 0xFF)
        for var i = 0; i < plen; i++
            msg[4 + i] = pp[i]
        var reply: [5]byte
        ipc_send(port, msg, 4 + plen, reply, 5)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Remove a file by path.

    unlink(path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_UNLINK)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [1]byte
        ipc_send(port, msg, 1 + plen, reply, 1)
        int(reply[0])

Create a directory at a path.

    mkdir(path: string, mode: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_MKDIR)
        msg[1] = byte((mode >> 8) & 0xFF)
        msg[2] = byte(mode & 0xFF)
        for var i = 0; i < plen; i++
            msg[3 + i] = pp[i]
        var reply: [5]byte
        ipc_send(port, msg, 3 + plen, reply, 5)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Remove a directory by path.

    rmdir(path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_RMDIR)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [1]byte
        ipc_send(port, msg, 1 + plen, reply, 1)
        int(reply[0])

Read a directory entry by path and index. Returns 0 on success, -1 on end.

    readdir(path: string, idx: int, entry_ino: *int, entry_name: *byte) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_READDIR)
        msg_write_i32(msg, 1, idx)
        for var i = 0; i < plen; i++
            msg[5 + i] = pp[i]
        var reply: [65]byte
        ipc_send(port, msg, 5 + plen, reply, 65)
        if reply[0] != 0
            return -1
        *entry_ino = msg_read_i32(reply, 1)
        for var i = 0; i < 60; i++
            entry_name[i] = reply[5 + i]
        0

Get file status by path.

    stat(path: string, st: *int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_STAT)
        for var i = 0; i < plen; i++
            msg[1 + i] = pp[i]
        var reply: [29]byte
        ipc_send(port, msg, 1 + plen, reply, 29)
        if reply[0] != 0
            return -1
        for var i = 0; i < 7; i++
            st[i] = msg_read_i32(reply, 1 + i * 4)
        0

Change file permissions by path.

    chmod(path: string, mode: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(path)
        val plen = len(path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_CHMOD)
        msg[1] = byte((mode >> 8) & 0xFF)
        msg[2] = byte(mode & 0xFF)
        for var i = 0; i < plen; i++
            msg[3 + i] = pp[i]
        var reply: [1]byte
        ipc_send(port, msg, 3 + plen, reply, 1)
        int(reply[0])

Rename/move a file by path.

    rename(old_path: string, new_path: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val onp = *byte(old_path)
        val onlen = len(old_path)
        val nnp = *byte(new_path)
        val nnlen = len(new_path)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_RENAME)
        msg[1] = byte(onlen)
        for var i = 0; i < onlen; i++
            msg[2 + i] = onp[i]
        for var i = 0; i < nnlen; i++
            msg[2 + onlen + i] = nnp[i]
        var reply: [1]byte
        ipc_send(port, msg, 2 + onlen + nnlen, reply, 1)
        int(reply[0])

System queries and control.

    uptime() -> int
        syscall(SYS_UPTIME, 0)

    getuid() -> int
        syscall(SYS_GETUID, 0)

    setuid(uid: int)
        syscall(SYS_SETUID, uid)

Periodic timer / notify wrappers for user programs. `svc_timer_subscribe`
registers the calling thread for a periodic `notify_send(tid, 2)` every
`period` ticks — used by tests that need to prove the kernel timer path
fires reliably during a quiet channel. `notify_wait` blocks until any
notify arrives; `notify_read_self` reads and clears the pending value.

    svc_timer_subscribe(period: int) -> int
        syscall(SYS_TIMER_SUBSCRIBE, i64(period))

    notify_wait()
        syscall(SYS_NOTIFY_WAIT, 0)

    notify_read_self() -> int
        syscall(SYS_NOTIFY_READ, 0)

Read one byte from stdin (handle 0). Blocks until data
is available. Returns the byte value or -1 on error.

    getc() -> int
        var buf: [1]byte
        val n = read(STDIN, buf, 1)
        if n <= 0
            return -1
        int(buf[0])

Connect to a named resource via VFS. Supports scheme-based
routing: `connect("tty:0")`, `connect("vfs:/etc/passwd")`.
Returns a handle or -1 on error.

    connect(name: string) -> int
        val port = fs_port()
        if port < 0
            return -1
        val pp = *byte(name)
        val nlen = len(name)
        var msg: [128]byte
        msg[0] = byte(FS_CMD_CONNECT)
        for var i = 0; i < nlen; i++
            msg[i + 1] = pp[i]
        var reply: [9]byte
        ipc_send(port, msg, nlen + 1, reply, 9)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Accept a connection on a `tcp-listen:` handle. Blocks until a
peer completes the three-way handshake, then returns a new
handle that `read`/`write_handle`/`close` already work on — no
tcp_* wrappers needed. Fills `peer_ip` (4 bytes) and `peer_port`
(2 bytes, big-endian) if non-null. Returns the child handle on
success or -1 on error.

    accept(h: int, peer_ip: *byte, peer_port: *byte) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(FS_CMD_ACCEPT)
        msg_write_i32(msg, 1, h)
        var reply: [11]byte
        ipc_send(port, msg, 5, reply, 11)
        if reply[0] != 0
            return -1
        if i64(peer_ip) != i64(0)
            peer_ip[0] = reply[5]
            peer_ip[1] = reply[6]
            peer_ip[2] = reply[7]
            peer_ip[3] = reply[8]
        if i64(peer_port) != i64(0)
            peer_port[0] = reply[9]
            peer_port[1] = reply[10]
        msg_read_i32(reply, 1)

Seek to a position in an open file.
whence: 0 = SET, 1 = CUR. Returns new position, or -1.

    seek(fid: int, offset: int, whence: int) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [10]byte
        msg[0] = byte(FS_CMD_SEEK)
        msg_write_i32(msg, 1, fid)
        msg_write_i32(msg, 5, offset)
        msg[9] = byte(whence)
        var reply: [5]byte
        ipc_send(port, msg, 10, reply, 5)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Create a pipe. Writes read/write handles to pointers.
Returns 0 on success, -1 on error.

    pipe(read_h: *int, write_h: *int) -> int
        val port = fs_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(FS_CMD_PIPE)
        var reply: [9]byte
        val result = ipc_send(port, msg, 1, reply, 9)
        if result != 0
            return -1
        if reply[0] != 0
            return -1
        *read_h = msg_read_i32(reply, 1)
        *write_h = msg_read_i32(reply, 5)
        0

PM IPC — process management.

Look up the PM server port (cached).

    var pm_port_cache = -2

    pm_port() -> int
        if pm_port_cache == -2
            pm_port_cache = port_lookup("pm")
        pm_port_cache

Wait for a child process to exit. Returns exit code or -1.

    pm_waitpid(pid: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(PM_CMD_WAITPID)
        msg_write_i32(msg, 1, pid)
        var reply: [5]byte
        ipc_send(port, msg, 5, reply, 5)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Kill a process by PID. Returns 0 on success.

    pm_kill(pid: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(PM_CMD_KILL)
        msg_write_i32(msg, 1, pid)
        var reply: [1]byte
        ipc_send(port, msg, 5, reply, 1)
        int(reply[0])

Serialize argv for transport to PM across the SPAWN IPC. Writes
to `blob` starting at offset 0. Returns the total blob size, or
-1 if it wouldn't fit in `cap` bytes.

Wire format: `[argc(4)] [pad(4)] [arg0\0 arg1\0 ... argN-1\0]`.
No pointer array — PM walks the NUL-separated string data
directly and builds the System V init stack frame in the child's
address space (see `pm_build_sysv_stack`). This is a purely
internal wire format between the client-side `pm_spawn_handles`
helper and the PM server; user code never touches it.

    build_argv_blob(argv: *string, argc: int, blob: *byte, cap: int) -> int
        if 8 > cap
            return -1
        // argc (little-endian i32) + 4 padding zeros.
        blob[0] = byte(argc & 0xFF)
        blob[1] = byte((argc >> 8) & 0xFF)
        blob[2] = byte((argc >> 16) & 0xFF)
        blob[3] = byte((argc >> 24) & 0xFF)
        blob[4] = 0
        blob[5] = 0
        blob[6] = 0
        blob[7] = 0
        var pos = 8
        var i = 0
        while i < argc
            val arg = argv[i]
            val alen = len(arg)
            if pos + alen + 1 > cap
                return -1
            val ap = *byte(arg)
            var j = 0
            while j < alen
                blob[pos + j] = ap[j]
                j += 1
            blob[pos + alen] = 0
            pos = pos + alen + 1
            i += 1
        pos

Spawn a process with handle inheritance. handle_pairs is an
array of (parent_handle, child_slot) byte pairs. argv is an
array of argc strings; argv[0] is conventionally the program
name. Returns child PID or -1 on error.

    pm_spawn_handles(path: string, argv: *string, argc: int, handle_pairs: *byte, num_handles: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        val plen = len(path)
        var msg: [512]byte
        // Reserve header bytes; fill in after computing blob size:
        //   [0]    cmd
        //   [1]    path_len
        //   [2-3]  blob_len (little-endian u16)
        //   [4]    num_handles
        //   [5..]  path
        //   [5+plen..]  blob
        //   [5+plen+blob_len..] handle_pairs
        val blob_off = 5 + plen
        val cap = 512 - blob_off - num_handles * 2
        val blob_len = build_argv_blob(argv, argc, &msg[blob_off], cap)
        if blob_len < 0
            return -1
        msg[0] = byte(PM_CMD_SPAWN)
        msg[1] = byte(plen)
        msg[2] = byte(blob_len & 0xFF)
        msg[3] = byte((blob_len >> 8) & 0xFF)
        msg[4] = byte(num_handles)
        val pp = *byte(path)
        var i = 0
        while i < plen
            msg[5 + i] = pp[i]
            i += 1
        i = 0
        while i < num_handles * 2
            msg[blob_off + blob_len + i] = handle_pairs[i]
            i += 1
        var reply: [5]byte
        ipc_send(port, msg, blob_off + blob_len + num_handles * 2, reply, 5)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Spawn a process with no handle inheritance.

    pm_spawn(path: string, argv: *string, argc: int) -> int
        pm_spawn_handles(path, argv, argc, *byte(0), 0)

Spawn a process suspended (no handles inherited, no auto-resume).
Caller follows up with `pm_transplant_fd` and `pm_resume`. Used
for fd-transplant flows where the parent wants to set up the
child's fd table before it starts running.

    pm_spawn_susp(path: string, argv: *string, argc: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        val plen = len(path)
        var msg: [512]byte
        val blob_off = 5 + plen
        val cap = 512 - blob_off
        val blob_len = build_argv_blob(argv, argc, &msg[blob_off], cap)
        if blob_len < 0
            return -1
        msg[0] = byte(PM_CMD_SPAWN_SUSP)
        msg[1] = byte(plen)
        msg[2] = byte(blob_len & 0xFF)
        msg[3] = byte((blob_len >> 8) & 0xFF)
        msg[4] = 0
        val pp = *byte(path)
        var i = 0
        while i < plen
            msg[5 + i] = pp[i]
            i += 1
        var reply: [5]byte
        ipc_send(port, msg, blob_off + blob_len, reply, 5)
        if reply[0] != 0
            return -1
        msg_read_i32(reply, 1)

Copy one of the calling process's posix_fd_table slots into
a destination process's slot. dst_fd must be unused on the
target side (caller's responsibility to close any prior
occupant). Returns 0 on success or a negative status byte
forwarded from PM. Used in tandem with `pm_spawn_susp` /
`pm_resume`.

    pm_transplant_fd(dst_pid: int, src_fd: int, dst_fd: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(PM_CMD_TRANSPLANT_FD)
        msg[1] = byte(dst_pid & 0xff)
        msg[2] = byte((dst_pid >> 8) & 0xff)
        msg[3] = byte(src_fd & 0xff)
        msg[4] = byte(dst_fd & 0xff)
        var reply: [1]byte
        ipc_send(port, msg, 5, reply, 1)
        var rc = int(reply[0])
        if rc >= 128
            rc = rc - 256
        rc

Resume a previously SPAWN_SUSP-ed child.

    pm_resume(pid: int) -> int
        val port = pm_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(PM_CMD_RESUME)
        msg_write_i32(msg, 1, pid)
        var reply: [1]byte
        ipc_send(port, msg, 5, reply, 1)
        int(reply[0])

Print an integer to stdout.

    putint(n: int)
        if n < 0
            puts("-")
            putint(-n)
            return
        if n >= 10
            putint(n / 10)
        var buf: [1]byte
        buf[0] = byte('0' + n % 10)
        write_handle(STDOUT, buf, 1)

