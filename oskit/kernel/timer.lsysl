TOS Timer Driver

Handles timer IRQ 0. Acknowledges the timer device so it can
fire again. The tick counting and thread wake logic lives in
the kernel's schedule() function, which runs after every
context switch.

Device registers (MCU-style timer, word-aligned):
- 0x100040 + 0-3  = ARR (auto-reload/period, 32-bit)
- 0x100040 + 4-7  = CNT (counter, 32-bit)
- 0x100040 + 8-9  = PSC (prescaler, 16-bit)
- 0x100040 + 10   = CR  (control: bit 0 = enable)
- 0x100040 + 11   = SR  (status: bit 0 = overflow, write-1-to-clear)
- 0x100040 + 12   = IER (interrupt enable: bit 0 = overflow)


    module oskit.kernel

    val TIMER_BASE = 0x100040
    val TIMER_ARR  = 0x100040
    val TIMER_CR   = 0x10004A
    val TIMER_SR   = 0x10004B
    val TIMER_IER  = 0x10004C
    val TIMER_IRQ  = 0

    extern register_irq(irq: int, handler: i64)

    timer_init(period: int)
        register_irq(TIMER_IRQ, timer_handler)

        // Write ARR period via u32 pointer
        val arr: *u32 = *u32(TIMER_ARR)
        *arr = u32(period)

        // Enable overflow interrupt and start timer
        val ier: *byte = *byte(TIMER_IER)
        *ier = 1
        val cr: *byte = *byte(TIMER_CR)
        *cr = 1

timer_handler -- Called by the generic IRQ dispatcher in boot.asm.
Just acknowledges the timer device. The dispatcher handles the
context switch, and schedule() handles tick counting and waking.

    timer_handler()
        val sr: *byte = *byte(TIMER_SR)
        *sr = 1
