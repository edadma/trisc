Keyboard buffer. The keyboard ISR (in kbd module) writes events
here via kernel-exported functions. The TTY server reads events
via kbhit/getkey syscalls.

    val KB_BUF_SIZE = 16
    var kb_buf: [16]int
    var kb_head = 0
    var kb_tail = 0
    var kb_count = 0
    var kb_notify_tid = -1

    keyboard_set_notify(tid: int)
        kb_notify_tid = tid

Virtio IRQ target. Set via `svc_virtio_set_notify(tid)`; the
aarch64 GIC handler reads this after writing the device-side
`INT_ACK` and fires a 1-valued notification so the nic server
(or any future virtio consumer) wakes up. -1 means "no target,
drop the wake" — keyboard path mirrors this on boot.

    var virtio_notify_tid = -1

    virtio_set_notify(tid: int)
        virtio_notify_tid = tid

    kb_has_key() -> int
        if kb_count > 0
            return 1
        0

    kb_read_key() -> int
        if kb_count == 0
            return 0
        val evt = kb_buf[kb_head]
        kb_head = (kb_head + 1) % KB_BUF_SIZE
        kb_count -= 1
        evt

    kb_enqueue(evt: int)
        if kb_count < KB_BUF_SIZE
            kb_buf[kb_tail] = evt
            kb_tail = (kb_tail + 1) % KB_BUF_SIZE
            kb_count += 1

Thread-local storage. A flat 2D array indexed by [thread_id][slot].
Each thread gets TLS_SLOTS slots of int-sized values. Access is
O(1) via tls_set/tls_get kernel functions.

    var tls: [128]int  // 128 = MAX_THREADS(32) * TLS_SLOTS(4)

Software timers. A fixed pool of one-shot timers that fire a
callback function after a specified number of ticks. The timer
queue is scanned each tick in schedule().

Each timer has:
- active: 1 if armed, 0 if free
- fire_tick: absolute tick when the timer fires
- callback: function pointer to call (unit -> unit)


    struct SoftTimer
        active: int
        fire_tick: int
        callback: i64

    var timers: [8]SoftTimer  // 8 = MAX_TIMERS
    var irq_handlers: [8]i64  // 8 = MAX_IRQS

    register_irq(irq: int, handler: i64)
        irq_handlers[irq] = handler

ensure_queues_init -- Lazily initialize queues on first use.
Global arrays default to 0 but queues need QUEUE_EMPTY (-1).

    ensure_queues_init()
        if queues_initialized == 0
            init_queues()
            queues_initialized = 1

Queue operations -- enqueue, dequeue, and remove from run queues.
These maintain the ready_mask invariant.

    enqueue(pri: int, idx: int)
        threads[idx].next = QUEUE_EMPTY
        if queue_head[pri] == QUEUE_EMPTY
            queue_head[pri] = idx
            queue_tail[pri] = idx
        else
            threads[queue_tail[pri]].next = idx
            queue_tail[pri] = idx
        ready_mask = ready_mask | (1 << pri)

    dequeue(pri: int) -> int
        val idx = queue_head[pri]
        if idx == QUEUE_EMPTY
            return QUEUE_EMPTY
        queue_head[pri] = threads[idx].next
        if queue_head[pri] == QUEUE_EMPTY
            queue_tail[pri] = QUEUE_EMPTY
            ready_mask = ready_mask & ~(1 << pri)
        threads[idx].next = QUEUE_EMPTY
        idx

    init_queues()
        var i = 0
        while i < NUM_PRIORITIES
            queue_head[i] = QUEUE_EMPTY
            queue_tail[i] = QUEUE_EMPTY
            i += 1
        ready_mask = 0

    create_thread(entry_point: i64, usp: i64, ssp: i64, name: string) -> int =
        create_thread_pri(entry_point, usp, ssp, name, 0, kernel_ptbr())

Create a thread with a specific page table. The ptbr is set
atomically before the thread is enqueued, preventing a race
where the scheduler picks up the thread with the wrong ptbr.

    create_thread_vm(entry_point: i64, usp: i64, ssp: i64, name: string, ptbr: u64) -> int =
        create_thread_pri(entry_point, usp, ssp, name, 0, ptbr)

Lower priority number = higher priority. Priority 0 runs first.

Allocates a thread slot: reuses the lowest-index STATE_TERMINATED slot if any,
otherwise appends at thread_count (if below MAX_THREADS). Returns the thread
index, or -1 if every slot is in use. Without reuse, short-lived /bin programs
would monotonically bump thread_count and walk off the end of threads[].

    create_thread_pri(entry_point: i64, usp: i64, ssp: i64, name: string, priority: int, ptbr_val: u64) -> int
        arch_cli()
        ensure_queues_init()
        var idx = -1
        var i = 0
        while i < thread_count
            if threads[i].state == STATE_TERMINATED
                idx = i
                break
            i += 1
        if idx < 0
            if thread_count >= MAX_THREADS
                arch_sti()
                return -1
            idx = thread_count
            thread_count += 1
        val sp = build_stack_frame(entry_point, usp, ssp)
        threads[idx].ssp = sp
        threads[idx].state = STATE_READY
        threads[idx].wake_ms = 0
        // Copy name into kernel-owned buffer (caller's pointer may be
        // in an isolated server's address space and become invalid)
        val np = *byte(name)
        var nlen = len(name)
        if nlen > 15
            nlen = 15
        var ni = 0
        while ni < nlen
            threads[idx].name_buf[ni] = np[ni]
            ni += 1
        threads[idx].name_buf[ni] = 0
        threads[idx].name = string(threads[idx].name_buf[:nlen])
        threads[idx].priority = priority
        threads[idx].join_target = -1
        threads[idx].quantum = DEFAULT_QUANTUM
        threads[idx].next = QUEUE_EMPTY
        threads[idx].ctx_switches = 0
        threads[idx].cpu_ticks = 0
        threads[idx].consec_quanta = 0
        threads[idx].notify_value = 0
        threads[idx].notify_pending = 0
        threads[idx].base_priority = priority
        threads[idx].blocked_on = 0
        threads[idx].ptbr = ptbr_val
        threads[idx].pid = 0
        threads[idx].kstack_top = 0
        threads[idx].sigmask = 0
        threads[idx].sigpending = 0
        if current_thread >= 0
            threads[idx].uid = threads[current_thread].uid
        else
            threads[idx].uid = 0
        // Write stack canary at bottom of user stack (skip for process threads
        // where USP overlaps with code base)
        if ptbr_val == kernel_ptbr()
            var canary_addr: *int = *int(usp)
            *canary_addr = STACK_CANARY
        enqueue(priority, idx)
        // No sti here — callers are boot setup (no scheduler yet)
        // or slow-path handlers (do_schedule does sti before rte)
        idx

    sleep_current(nticks: int)
        threads[current_thread].state = STATE_BLOCKED
        // `wake_ms` is in `monotonic_ms_count` units (wall-clock
        // ms since boot). `nticks` is the legacy 10-ms-tick unit
        // (shim's `shim_timespec_to_ticks` converts ns → 10ms ticks),
        // so multiply by 10 to land on the same scale.
        threads[current_thread].wake_ms = int(monotonic_ms_count) + nticks * 10
        threads[current_thread].consec_quanta = 0
        sleepq_insert(current_thread)

    sleep_until_current(target_tick: int)
        threads[current_thread].state = STATE_BLOCKED
        // `target_tick` is also in 10-ms-tick units; convert to ms.
        threads[current_thread].wake_ms = target_tick * 10
        threads[current_thread].consec_quanta = 0
        sleepq_insert(current_thread)

    yield_current()
        threads[current_thread].consec_quanta = 0
        threads[current_thread].quantum = DEFAULT_QUANTUM

    query_thread_state(id: int) -> int
        threads[id].state

    query_thread_name(id: int) -> *byte
        *byte(threads[id].name)

    query_thread_name_len(id: int) -> int
        len(threads[id].name)

    kernel_getuid() -> int
        threads[current_thread].uid

    kernel_setuid(uid: int)
        threads[current_thread].uid = uid

    query_thread_pid(id: int) -> int
        threads[id].pid

    query_thread_ctx_switches(id: int) -> int
        threads[id].ctx_switches

    query_thread_cpu_ticks(id: int) -> int
        threads[id].cpu_ticks

    query_total_ctx_switches() -> int
        total_ctx_switches

    kernel_set_watchdog(limit: int)
        watchdog_limit = limit

Also wakes any threads that are joining on this thread,
enqueueing them back into their priority run queue.

    terminate_current(exit_code: int)
        threads[current_thread].state = STATE_TERMINATED

        // If this thread belongs to a process, mark it as zombie
        // and notify PM so it can handle reaping
        val pid = threads[current_thread].pid
        if pid > 0
            processes[pid].exit_code = exit_code
            processes[pid].state = PROC_ZOMBIE
            if kernel_pm_tid >= 0
                notify_send(kernel_pm_tid, pid)

        // Wake threads waiting to join on this thread
        // (used for kernel threads; processes use PM)
        var i = 0
        while i < thread_count
            if threads[i].state == STATE_JOINING
                if threads[i].join_target == current_thread
                    threads[i].state = STATE_READY
                    threads[i].quantum = DEFAULT_QUANTUM
                    enqueue(threads[i].priority, i)
            i += 1

If the target is already terminated, returns immediately without
blocking. Otherwise sets state to STATE_JOINING and records the
target thread ID so terminate_current can wake us.

    join_current(target_id: int)
        if threads[target_id].state == STATE_TERMINATED
            return
        threads[current_thread].state = STATE_JOINING
        threads[current_thread].join_target = target_id
        threads[current_thread].consec_quanta = 0

Process management. create_process allocates a process table
entry and creates a thread for it. waitpid blocks the caller
until the process exits. getpid returns the current thread's
process ID (0 for kernel threads).

    create_process(entry_point: i64, usp: i64, ssp: i64, name: string, ptbr_val: u64) -> int
        // Allocate PID
        var pid = -1
        var i = 1
        while i < MAX_PROCESSES
            if processes[i].state == PROC_FREE
                pid = i
                break
            i += 1
        if pid < 0
            return -1

        // Create the thread
        val tid = create_thread_pri(entry_point, usp, ssp, name, 0, ptbr_val)
        if tid < 0
            return -1

        // Set up process entry (use thread's kernel-owned name copy)
        processes[pid].state = PROC_RUNNING
        processes[pid].ptbr = ptbr_val
        processes[pid].parent_tid = current_thread
        processes[pid].exit_code = 0
        processes[pid].main_tid = tid
        processes[pid].name = threads[tid].name
        for w in 0..<8
            processes[pid].syscall_allow[w] = i64(-1)
        processes[pid].ipc_send_mask = 0xFFFF
        vma_tree_init(&processes[pid].vma_tree)
        vma_seed_default_layout(pid)
        process_sigact_clear(pid)

        // Link thread to process
        threads[tid].pid = pid
        pid

Create a process but leave its thread suspended (STATE_SUSPENDED).
The caller must call resume_process(pid) after setup is complete.
Unlike create_process, the thread is never enqueued — no race.

    // (p10_watch removed — Process.state is now volatile)

    create_process_suspended(entry_point: i64, usp: i64, ssp: i64, name: string, ptbr_val: u64) -> int
        // Allocate PID
        var pid = -1
        var i = 1
        while i < MAX_PROCESSES
            if processes[i].state == PROC_FREE
                pid = i
                break
            i += 1
        if pid < 0
            return -1

        // Create thread slot without enqueuing
        arch_cli()
        ensure_queues_init()
        var idx = -1
        i = 0
        while i < thread_count
            if threads[i].state == STATE_TERMINATED
                idx = i
                break
            i += 1
        if idx < 0
            if thread_count >= MAX_THREADS
                arch_sti()
                return -1
            idx = thread_count
            thread_count += 1

        // Allocate per-process kernel stack (2 pages = 8KB) from the
        // boot-time slab. See oskit/kernel/kstack.lsysl. The slab
        // guarantees the two pages are contiguous, replacing the
        // chunk-3 follow-up linear scan that walked up to 256 pages.
        val kstack_page = kstack_alloc()
        if kstack_page == u64(0)
            arch_sti()
            return -1
        val kstack_top_val = i64(kstack_page + u64(4 * PAGE_SIZE))
        threads[idx].kstack_top = kstack_top_val
        // Build context frame (arch-specific: x86 builds on kernel stack,
        // TRISC builds in buffer and copies to child's SSP)
        threads[idx].ssp = arch_setup_process_frame(entry_point, usp, ssp, kstack_top_val, ptbr_val)
        // Write thread_exit return address into child's user stack.
        // Uses `kernel_vm_copy_to`, which at this point sees an
        // orphan ptbr (the Process slot isn't populated until line
        // ~2133 below) and falls back to the unconditional
        // allocate-on-write path for any vaddr inside
        // `[VMA_USER_VA_BOT, VMA_USER_VA_TOP)`. That's the same
        // behaviour the arch-level `vm_copy_to` had pre-Phase-C.
        var exit_addr: i64 = i64(&thread_exit)
        kernel_vm_copy_to(ptbr_val, u64(usp - i64(8)), *byte(&exit_addr), 8)
        threads[idx].state = STATE_SUSPENDED
        threads[idx].wake_ms = 0
        val np2 = *byte(name)
        var nlen2 = len(name)
        if nlen2 > 15
            nlen2 = 15
        var ni2 = 0
        while ni2 < nlen2
            threads[idx].name_buf[ni2] = np2[ni2]
            ni2 += 1
        threads[idx].name_buf[ni2] = 0
        threads[idx].name = string(threads[idx].name_buf[:nlen2])
        threads[idx].priority = 0
        threads[idx].join_target = -1
        threads[idx].quantum = DEFAULT_QUANTUM
        threads[idx].next = QUEUE_EMPTY
        threads[idx].ctx_switches = 0
        threads[idx].cpu_ticks = 0
        threads[idx].consec_quanta = 0
        threads[idx].notify_value = 0
        threads[idx].notify_pending = 0
        threads[idx].base_priority = 0
        threads[idx].blocked_on = 0
        threads[idx].ptbr = ptbr_val
        threads[idx].pid = 0
        threads[idx].sigmask = 0
        threads[idx].sigpending = 0
        if current_thread >= 0
            threads[idx].uid = threads[current_thread].uid
        else
            threads[idx].uid = 0
        // No sti — slow-path handler keeps cli; do_schedule does sti
        val tid = idx

        // Set up process entry

        processes[pid].state = PROC_RUNNING
        processes[pid].ptbr = ptbr_val
        processes[pid].parent_tid = current_thread
        processes[pid].exit_code = 0
        processes[pid].main_tid = tid
        processes[pid].name = threads[tid].name
        for w in 0..<8
            processes[pid].syscall_allow[w] = i64(-1)
        processes[pid].ipc_send_mask = 0xFFFF
        vma_tree_init(&processes[pid].vma_tree)
        vma_seed_default_layout(pid)
        process_sigact_clear(pid)

        // Link thread to process
        threads[tid].pid = pid
        pid

Resume a suspended process (created with create_process_suspended).

    resume_process(pid: int)
        if pid > 0
            if pid < MAX_PROCESSES
                val tid = processes[pid].main_tid
                resume_thread(tid)


Phase 1 chunk 6 — `fork()`.

Duplicate the calling process. The child gets a fresh PID and
PTBR, a deep copy of the parent's VMA tree, and shared (RO,
COW-on-write) mappings of every currently-resident user page.
File-table cloning, signal disposition copying, etc. are
placeholders until those subsystems exist (Phase 2 / chunk
follow-ups).

Return value semantics, per POSIX:
  * **Parent** sees the child's PID — written by the syscall
    dispatcher into the parent's saved RAX/x0 from the i64 we
    return here.
  * **Child** sees 0 — written into the child's saved
    return-value register slot inside `arch_setup_fork_frame`,
    so when the scheduler eventually picks up the child its
    `restore_context` / ERET replays exactly the parent's
    post-syscall state but with rc=0.

Failure modes return -1 to the parent and leave no observable
state behind. Rollback walks the partially-built child via
`vma_unmap_all_pages` + `vma_clear_all` + `vm_free_process_pt`
— the same shape `reap_process` uses, which correctly drops the
parent's bumped refcounts on the shared frames and releases the
child's PT pages. `kstack_free` and the thread/process slot
cleanup are inline mirrors of the same teardown.

The handler runs in parent's context (PTBR=parent), but
`vm_install_user_page` writes into the child's PTBR via the
identity-map of the page-pool window — same trick `vma_handle_
fault`'s COW path relies on. No PTBR switch is needed.

    kernel_fork() -> int
        if current_thread < 0
            return -1
        val parent_pid = threads[current_thread].pid
        if parent_pid <= 0
            return -1
        if parent_pid >= MAX_PROCESSES
            return -1
        val parent_tid = current_thread
        val parent_ptbr = threads[parent_tid].ptbr
        val parent_ssp  = syscall_ssp

        // Allocate child PID.
        var child_pid = -1
        var pi = 1
        while pi < MAX_PROCESSES
            if processes[pi].state == PROC_FREE
                child_pid = pi
                break
            pi += 1
        if child_pid < 0
            return -1

        // Reserve the slot eagerly so a parallel fork on another
        // CPU can't grab it under us. Cleared on rollback.
        processes[child_pid].state = PROC_RUNNING

        val child_ptbr = vm_create_process_pt()
        if child_ptbr == u64(0)
            processes[child_pid].state = PROC_FREE
            return -1

        // Initialize the child's VMA tree and clone the parent's.
        // `vma_clone_for_fork` shares frames, demotes parent PTEs
        // to RO, and bumps refcounts. On any failure roll back via
        // the standard reap shape (drops every refcount we bumped
        // and frees the child's PT).
        vma_tree_init(&processes[child_pid].vma_tree)
        if vma_clone_for_fork(&processes[parent_pid].vma_tree,
                              &processes[child_pid].vma_tree,
                              parent_ptbr, child_ptbr) != 0
            vma_unmap_all_pages(&processes[child_pid].vma_tree, child_ptbr)
            vma_clear_all(&processes[child_pid].vma_tree)
            vm_free_process_pt(child_ptbr)
            processes[child_pid].state = PROC_FREE
            return -1

        // Phase D.2 retired the x86 legacy `[0xCC000, 0x100000)`
        // eager-mapped region; both arches now use the
        // 0x60000000 user carve-out with full COW fork driven by
        // `vma_clone_for_fork`. The `arch_fork_clone_eager` shim
        // that used to copy parent's text into the child's
        // freshly-allocated eager pages is gone — there are no
        // eager pages to copy, and COW handles everything inside
        // the VMA-tracked range.

        // Allocate a fresh kstack for the child's main thread.
        arch_cli()
        ensure_queues_init()
        val kstack_page = kstack_alloc()
        if kstack_page == u64(0)
            vma_unmap_all_pages(&processes[child_pid].vma_tree, child_ptbr)
            vma_clear_all(&processes[child_pid].vma_tree)
            vm_free_process_pt(child_ptbr)
            processes[child_pid].state = PROC_FREE
            arch_sti()
            return -1
        val kstack_top_val = i64(kstack_page + u64(4 * PAGE_SIZE))

        // Allocate a thread slot, preferring a recyclable terminated
        // slot — same scan order as `create_process_suspended` so we
        // don't grow `thread_count` past `MAX_THREADS` unnecessarily.
        var idx = -1
        var ti = 0
        while ti < thread_count
            if threads[ti].state == STATE_TERMINATED
                idx = ti
                break
            ti += 1
        if idx < 0
            if thread_count >= MAX_THREADS
                kstack_free(kstack_page)
                vma_unmap_all_pages(&processes[child_pid].vma_tree, child_ptbr)
                vma_clear_all(&processes[child_pid].vma_tree)
                vm_free_process_pt(child_ptbr)
                processes[child_pid].state = PROC_FREE
                arch_sti()
                return -1
            idx = thread_count
            thread_count += 1

        // Build the child's saved exception frame from a copy of
        // the parent's, with the syscall-return register zeroed.
        threads[idx].ssp = arch_setup_fork_frame(parent_ssp, kstack_top_val)
        threads[idx].kstack_top = kstack_top_val
        threads[idx].state = STATE_READY
        threads[idx].wake_ms = 0
        // Copy the parent's name (already kernel-owned) into the
        // child's name buffer so debug output identifies the new
        // thread; same name is fine for now (PID disambiguates).
        val pname  = threads[parent_tid].name
        val pnp    = *byte(pname)
        var pnlen  = len(pname)
        if pnlen > 15
            pnlen = 15
        var ni = 0
        while ni < pnlen
            threads[idx].name_buf[ni] = pnp[ni]
            ni += 1
        threads[idx].name_buf[ni] = 0
        threads[idx].name = string(threads[idx].name_buf[:pnlen])
        threads[idx].priority      = threads[parent_tid].priority
        threads[idx].base_priority = threads[parent_tid].priority
        threads[idx].join_target   = -1
        threads[idx].quantum       = DEFAULT_QUANTUM
        threads[idx].next          = QUEUE_EMPTY
        threads[idx].ctx_switches  = 0
        threads[idx].cpu_ticks     = 0
        threads[idx].consec_quanta = 0
        threads[idx].notify_value  = 0
        threads[idx].notify_pending = 0
        threads[idx].blocked_on    = 0
        threads[idx].ptbr          = child_ptbr
        threads[idx].pid           = child_pid
        threads[idx].uid           = threads[parent_tid].uid
        // POSIX: child inherits parent's sigmask; pending is per-thread
        // and not inherited across fork (the child starts with no
        // pending signals — POSIX leaves this implementation-defined
        // but Linux/glibc/musl all clear pending on fork).
        threads[idx].sigmask       = threads[parent_tid].sigmask
        threads[idx].sigpending    = 0

        // Set up the child's process slot. parent_tid is the parent's
        // *main* tid — same convention `create_process_suspended` uses
        // — so PM's exit notifications, reparenting walks, and the
        // pm_handle_exit fan-out all see consistent topology.
        processes[child_pid].ptbr        = child_ptbr
        processes[child_pid].parent_tid  = processes[parent_pid].main_tid
        processes[child_pid].exit_code   = 0
        processes[child_pid].main_tid    = idx
        processes[child_pid].name        = threads[idx].name
        // Inherit syscall_allow + ipc_send_mask from the parent so the
        // child has identical privileges. Kernel-only `0` PIDs keep
        // their original 0xFFFF mask via the parent's slot.
        for w in 0..<8
            processes[child_pid].syscall_allow[w] = processes[parent_pid].syscall_allow[w]
        processes[child_pid].ipc_send_mask = processes[parent_pid].ipc_send_mask
        // POSIX: fork() inherits the parent's signal disposition table.
        process_sigact_copy(child_pid, parent_pid)

        // Enqueue at the child's priority. The dispatcher returns
        // child_pid to the parent next, and `do_schedule` either
        // picks the child immediately (FIFO sibling at same priority)
        // or picks it on the next quantum boundary.
        enqueue(threads[idx].priority, idx)
        // Slow-path handler convention: stay cli; do_schedule does sti.
        child_pid


SYS_FORK (91): clone the calling process. Returns the child's
PID to the parent (>0), 0 to the child, -1 on failure (via
the dispatcher writing the i64 result into the parent's saved
return register; the child gets 0 from `arch_setup_fork_frame`).

    sys_fork_handler(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
        i64(kernel_fork())

Phase 2 chunk 1 — POSIX signal state plumbing.

Shape (recap of `project_slix_phase2_roadmap.md`): sigaction is a
per-process table indexed by signo, sigmask + sigpending are
per-thread u64 bitmaps with bit (signo-1). Chunk 1 only stores
and queries this state — no handler ever runs, and `kill(pid,
signo)` keeps its placeholder semantics from PM. The svcs below
are addressed by the POSIX shim, which translates between musl's
152-byte `struct sigaction` wire format and the compact 32-byte
kernel form.

`process_sigact_clear` resets every signo's disposition to
SIG_DFL (handler=0, flags=0, mask=0, restorer=0). Called from
both `create_process` paths and from `create_process_suspended`.

    process_sigact_clear(pid: int)
        if pid < 0
            return
        if pid >= MAX_PROCESSES
            return
        var i = 0
        while i <= 64
            processes[pid].sigact[i].handler  = i64(0)
            processes[pid].sigact[i].flags    = 0
            processes[pid].sigact[i]._pad     = 0
            processes[pid].sigact[i].mask     = i64(0)
            processes[pid].sigact[i].restorer = i64(0)
            i += 1

`process_sigact_copy` clones a parent's disposition table into a
child slot. Called from `kernel_fork`; POSIX says the child
inherits the parent's signal actions verbatim. (execve will
later be expected to reset custom dispositions to SIG_DFL while
keeping SIG_IGN — that lives in chunk 3 / 4, after we actually
deliver signals.)

    process_sigact_copy(child_pid: int, parent_pid: int)
        if child_pid < 0 || child_pid >= MAX_PROCESSES
            return
        if parent_pid < 0 || parent_pid >= MAX_PROCESSES
            return
        var i = 0
        while i <= 64
            processes[child_pid].sigact[i].handler  = processes[parent_pid].sigact[i].handler
            processes[child_pid].sigact[i].flags    = processes[parent_pid].sigact[i].flags
            processes[child_pid].sigact[i]._pad     = processes[parent_pid].sigact[i]._pad
            processes[child_pid].sigact[i].mask     = processes[parent_pid].sigact[i].mask
            processes[child_pid].sigact[i].restorer = processes[parent_pid].sigact[i].restorer
            i += 1

`how` values for `kernel_sigmask_set`. The numeric mapping matches
POSIX `SIG_BLOCK`/`SIG_UNBLOCK`/`SIG_SETMASK` so the shim can
pass musl's `how` argument through untranslated, but the kernel
itself isn't taking POSIX as an import — these are just the
agreed-upon enum values for the kernel API.

    val KSIG_HOW_BLOCK   = 0
    val KSIG_HOW_UNBLOCK = 1
    val KSIG_HOW_SETMASK = 2

`SIGKILL` (signo 9) and `SIGSTOP` (signo 19) cannot be blocked,
ignored, or have their handler changed. Bits for these signals
are silently dropped from any sigmask change, and `kernel_sigaction_set`
returns -2 when asked to override their disposition.

    val SIG_UNMASKABLE = i64(1 << 8) | i64(1 << 18)   // bit (SIGKILL-1) | bit (SIGSTOP-1)

Kernel-side signal API for the POSIX shim. The shim owns all
wire-format conversion (musl's 152-byte `struct sigaction`,
128-byte `sigset_t`); the kernel exposes a small set of native-
typed helpers that read/write the per-process/per-thread state.
Both calls operate on the caller (current thread, current
thread's process) — chunk 2 will introduce explicit-target
variants when `tkill` and cross-thread `kill` land.

`kernel_sigaction_set` updates one disposition slot, returning
the previous disposition through the `*out_*` pointers (which
may be 0 to skip the read-back). Returns 0 on success, -1 on a
signo outside the 1..64 range, -2 on a SIGKILL/SIGSTOP override
attempt.

    kernel_sigaction_set(signo: int,
                         new_handler: i64, new_flags: i32, new_mask: i64, new_restorer: i64,
                         install_new: int,
                         out_handler: *i64, out_flags: *i32, out_mask: *i64, out_restorer: *i64) -> int
        if signo <= 0 || signo > 64
            return -1
        if signo == 9 || signo == 19
            if install_new != 0
                return -2
        val pid = threads[current_thread].pid
        if i64(out_handler) != i64(0)
            *out_handler  = processes[pid].sigact[signo].handler
        if i64(out_flags) != i64(0)
            *out_flags    = i32(processes[pid].sigact[signo].flags)
        if i64(out_mask) != i64(0)
            *out_mask     = processes[pid].sigact[signo].mask
        if i64(out_restorer) != i64(0)
            *out_restorer = processes[pid].sigact[signo].restorer
        if install_new != 0
            processes[pid].sigact[signo].handler  = new_handler
            processes[pid].sigact[signo].flags    = int(new_flags)
            processes[pid].sigact[signo]._pad     = 0
            processes[pid].sigact[signo].mask     = new_mask & ~SIG_UNMASKABLE
            processes[pid].sigact[signo].restorer = new_restorer
        0

`kernel_sigmask_set` reads/modifies the caller's per-thread
blocked-signal mask. Returns the *previous* mask. `how == -1`
means "query only" (no modification). For BLOCK/UNBLOCK/SETMASK
the bits for SIGKILL/SIGSTOP are silently dropped from `newmask`
so the unblockables stay deliverable.

    kernel_sigmask_set(how: int, newmask: i64) -> i64
        val old = threads[current_thread].sigmask
        if how == -1
            return old
        val bits = newmask & ~SIG_UNMASKABLE
        if how == KSIG_HOW_BLOCK
            threads[current_thread].sigmask = old | bits
        else if how == KSIG_HOW_UNBLOCK
            threads[current_thread].sigmask = old & ~bits
        else if how == KSIG_HOW_SETMASK
            threads[current_thread].sigmask = bits
        old

`kernel_sigpending_get` reports the caller-thread's pending
bitmap. Used by `sigpending(2)`; bit (signo-1) is set iff that
signal was generated while blocked.

    kernel_sigpending_get() -> i64
        threads[current_thread].sigpending

Phase 2 chunk 2 — signal generation (kill / tkill / raise).

`kernel_sig_send_to_thread` sets the pending bit for `signo` on
the per-thread bitmap of `tid`. SIGKILL (9) takes the synchronous
fast path — POSIX says SIGKILL cannot be caught, blocked, or
ignored, and on a thread it still terminates the whole process —
so we route to `kernel_kill_process` directly without touching the
bitmap. `signo == 0` is the POSIX existence-check: validate the
thread is in-use and return 0 without modifying state. Returns 0
on success, -3 (ESRCH) on a bad/free thread, -1 (EINVAL) on a
signo outside 1..64.

    kernel_sig_send_to_thread(tid: int, signo: int) -> int
        if tid < 0
            return -3
        if tid >= thread_count
            return -3
        if signo < 0 || signo > 64
            return -1
        if threads[tid].state == STATE_TERMINATED
            return -3
        if signo == 0
            return 0
        if signo == 9
            kernel_kill_process(threads[tid].pid)
            return 0
        val bit: i64 = i64(1) << (signo - 1)
        threads[tid].sigpending = threads[tid].sigpending | bit
        0

`kernel_sig_send_to_process` broadcasts `signo` to every thread
belonging to `pid` by OR-ing the pending bit. POSIX prescribes
"some thread", but chunk 2 has no delivery side yet — chunk 3
will pick the lowest-eligible thread off the broadcast set, and
chunk 9 (pthread) will need a real selection policy. SIGKILL
short-circuits to `kernel_kill_process(pid)` for the same reason
as the thread variant. `signo == 0` is the existence-check.
Returns 0 on success, -3 (ESRCH) if the pid is free/zombie,
-1 (EINVAL) on a signo outside 1..64.

    kernel_sig_send_to_process(pid: int, signo: int) -> int
        if pid <= 0
            return -3
        if pid >= MAX_PROCESSES
            return -3
        if signo < 0 || signo > 64
            return -1
        if processes[pid].state == PROC_FREE
            return -3
        if processes[pid].state == PROC_ZOMBIE
            return -3
        if signo == 0
            return 0
        if signo == 9
            kernel_kill_process(pid)
            return 0
        val bit: i64 = i64(1) << (signo - 1)
        var i = 0
        while i < thread_count
            if threads[i].pid == pid
                if threads[i].state != STATE_TERMINATED
                    threads[i].sigpending = threads[i].sigpending | bit
            i += 1
        0

Phase 1 chunk 7 — synthetic ELF64 selftest. The kernel-side
`sys_elf_selftest_handler` (SYS_ELF_SELFTEST = 92) builds a tiny
two-LOAD-segment ELF in a 256-byte BSS buffer, runs it through
`oskit.lib.elf` accessors, and compares each field to a
hardcoded expected value. Returns 0 on pass, 1..N for the
failing step. There is no userspace ELF-file producer wired up
yet (sysl-built binaries are TRB after objcopy), so this stand-
in exists to lock down the parser's behavior — and therefore
chunk 8's `execve` and chunk 9's PT_INTERP handoff — before any
real ELF flows through the loader.

Little-endian field writers used only by the selftest. Kept
local to the kernel module so `oskit.lib.elf` stays a read-only
parser; if a future user ever needs to *produce* ELF in-kernel
the writers here can move out, but until then they're dead code
to everyone except the selftest.

    elf_write_u16_le(p: *byte, v: int)
        p[0] = byte(v & 0xFF)
        p[1] = byte((v >> 8) & 0xFF)

    elf_write_u32_le(p: *byte, v: i64)
        p[0] = byte(int(v) & 0xFF)
        p[1] = byte(int(v >> 8) & 0xFF)
        p[2] = byte(int(v >> 16) & 0xFF)
        p[3] = byte(int(v >> 24) & 0xFF)

    elf_write_u64_le(p: *byte, v: i64)
        p[0] = byte(int(v) & 0xFF)
        p[1] = byte(int(v >> 8) & 0xFF)
        p[2] = byte(int(v >> 16) & 0xFF)
        p[3] = byte(int(v >> 24) & 0xFF)
        p[4] = byte(int(v >> 32) & 0xFF)
        p[5] = byte(int(v >> 40) & 0xFF)
        p[6] = byte(int(v >> 48) & 0xFF)
        p[7] = byte(int(v >> 56) & 0xFF)

`elf64_selftest` returns 0 on pass, 1..N on the failing step. The
synthetic image describes two LOAD segments laid out the way a
real ELF would: a R+X text segment at 0x60001000 (memsz > filesz
so it has a tail of "padding" but no .bss because text is fully
initialized) and a R+W data segment at 0x60010000 with a 0x1000-
byte .bss tail. Step numbers are deliberately stable across the
positive and negative cases so a regression in any one accessor
is greppable from the test output.

    elf64_selftest() -> int
        var buf: [256]byte
        var i = 0
        while i < 256
            buf[i] = byte(0)
            i += 1

        buf[0] = 0x7F
        buf[1] = byte('E')
        buf[2] = byte('L')
        buf[3] = byte('F')
        buf[4] = byte(2)
        buf[5] = byte(1)

        elf_write_u64_le(&buf[24], i64(0x60001000))
        elf_write_u64_le(&buf[32], i64(64))
        elf_write_u16_le(&buf[54], 56)
        elf_write_u16_le(&buf[56], 2)

        val ph0 = 64
        elf_write_u32_le(&buf[ph0 + 0],  i64(ELF_PT_LOAD))
        elf_write_u32_le(&buf[ph0 + 4],  i64(ELF_PF_R | ELF_PF_X))
        elf_write_u64_le(&buf[ph0 + 8],  i64(0x100))
        elf_write_u64_le(&buf[ph0 + 16], i64(0x60001000))
        elf_write_u64_le(&buf[ph0 + 32], i64(0x1500))
        elf_write_u64_le(&buf[ph0 + 40], i64(0x2000))

        val ph1 = 120
        elf_write_u32_le(&buf[ph1 + 0],  i64(ELF_PT_LOAD))
        elf_write_u32_le(&buf[ph1 + 4],  i64(ELF_PF_R | ELF_PF_W))
        elf_write_u64_le(&buf[ph1 + 8],  i64(0x2000))
        elf_write_u64_le(&buf[ph1 + 16], i64(0x60010000))
        elf_write_u64_le(&buf[ph1 + 32], i64(0x2000))
        elf_write_u64_le(&buf[ph1 + 40], i64(0x3000))

        val pbuf: *byte = &buf[0]
        val total_len = ph1 + 56

        if elf64_validate(pbuf, total_len) != ELF_OK
            return 1
        if elf64_entry(pbuf) != u64(0x60001000)
            return 2
        if elf64_phnum(pbuf) != 2
            return 3

        if elf64_ph_type(pbuf, 0) != ELF_PT_LOAD
            return 4
        if elf64_ph_vaddr(pbuf, 0) != u64(0x60001000)
            return 5
        if elf64_ph_filesz(pbuf, 0) != i64(0x1500)
            return 6
        if elf64_ph_memsz(pbuf, 0) != i64(0x2000)
            return 7
        if elf64_pf_to_vma_prot(elf64_ph_flags(pbuf, 0)) != 5
            return 8

        if elf64_ph_type(pbuf, 1) != ELF_PT_LOAD
            return 9
        if elf64_ph_vaddr(pbuf, 1) != u64(0x60010000)
            return 10
        if elf64_ph_filesz(pbuf, 1) != i64(0x2000)
            return 11
        if elf64_ph_memsz(pbuf, 1) != i64(0x3000)
            return 12
        if elf64_pf_to_vma_prot(elf64_ph_flags(pbuf, 1)) != 3
            return 13

Negative-path tests. Mutate the buffer to break each invariant
in turn and verify `elf64_validate` returns the right error
code, then restore. The buffer is restored between mutations so
each negative case stands on its own.

        buf[0] = byte(0xFF)
        if elf64_validate(pbuf, total_len) != ELF_ERR_NOT_ELF
            return 14
        buf[0] = 0x7F

        if elf64_validate(pbuf, 32) != ELF_ERR_TRUNCATED
            return 15

        0

SYS_ELF_SELFTEST (92): runs the kernel-side ELF parser selftest
and returns its 0/N result. Debug-only — exists so the chunk-7
test program can validate `oskit.lib.elf` end-to-end without
yet having a real ELF binary in the ramdisk (that capability
arrives in chunk 8 with `exec()`).

    sys_elf_selftest_handler(arg: int)
        val rc = elf64_selftest()
        syscall_return(i64(rc))
        kernel_continue_current()

Phase 1 chunk 8 — `execve` cross-PTBR primitives.

`SYS_PROC_REPLACE_IMAGE_PREP` (93) drops the user pages and the VMA
tree of a target process, leaving the page table itself intact for
the caller to seed fresh VMAs and load a new image into. It mirrors
the first two steps of `reap_process` exactly so a partially-prepped
target stays consistent with what reap would do at any moment if the
process is killed mid-execve. The kstack and PT pages are untouched
— the calling thread of the target is suspended in IPC waiting for
PM's reply, so its kstack frame is still alive.

Caller is PM, exclusively. Wired through `register_syscall(...)` so
the privilege bit is set in PM's allow mask the same way every other
PM-only syscall is granted.

    sys_proc_replace_image_prep_handler(arg: int)
        val pid = arg
        if pid <= 0
            syscall_return(-1)
            kernel_continue_current()
            return
        if pid >= MAX_PROCESSES
            syscall_return(-1)
            kernel_continue_current()
            return
        if processes[pid].state == PROC_FREE
            syscall_return(-1)
            kernel_continue_current()
            return
        vma_unmap_all_pages(&processes[pid].vma_tree, processes[pid].ptbr)
        vma_clear_all(&processes[pid].vma_tree)
        syscall_return(0)
        kernel_continue_current()

`SYS_EXECVE_FINALIZE` (94) atomically (a) overwrites the saved
instruction pointer + user stack pointer in a thread's exception
frame and (b) wakes the thread from `STATE_SEND_BLOCKED` to
`STATE_READY` without touching its IPC reply buffer. PM calls this as
the *last* step of an `execve` — at which point the caller's old
address space is gone and a normal `ipc_reply` would `vm_copy_cross`
the reply byte into whatever frame now backs the old reply-buf VA
(typically a page in the new SysV init stack), silently corrupting
the new image.

By skipping the reply-buf copy entirely we avoid that hazard. The
new program never needs to read a reply byte: it starts executing at
`entry` with `RSP = usp`, and the saved syscall return register
keeps whatever value the IPC dispatcher wrote at send-time (zero or
the partial transfer count) — which the new image's CRT0 doesn't
read.

Args: a0=tid, a1=new entry pc, a2=new user stack pointer.

The slot offsets come from arch (`ARCH_FRAME_PC_OFFSET`,
`ARCH_FRAME_USP_OFFSET`) so this stays one routine across x86_64 and
aarch64. The kstack slab guarantees PA-contiguous neighbours, so a
single `vm_v2p` of the SSP plus offset arithmetic reaches both
slots safely (no per-slot translation needed).

    sys_execve_finalize_handler(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
        val tid = int(a0)
        if tid < 0
            return i64(-1)
        if tid >= MAX_THREADS
            return i64(-1)
        val ssp_va = u64(threads[tid].ssp)
        // Direct write — kstack pages are reachable as kernel VAs via the
        // kernel's high-half identity map (TTBR1 on aarch64) and the
        // 0..0xCB user PT entries on x86. The kstack slab guarantees PA
        // contiguity so offset arithmetic doesn't escape the 4-page slot.
        var pc_p: *i64 = *i64(ssp_va + u64(ARCH_FRAME_PC_OFFSET))
        *pc_p = a1
        var sp_p: *i64 = *i64(ssp_va + u64(ARCH_FRAME_USP_OFFSET))
        *sp_p = a2
        arch_invalidate_icache_all()
        if threads[tid].state == STATE_SEND_BLOCKED
            threads[tid].state = STATE_READY
            threads[tid].quantum = DEFAULT_QUANTUM
            threads[tid].wake_ms = 0
            enqueue(threads[tid].priority, tid)
        i64(0)

    reap_process(pid: int)
        grant_revoke_all(pid)
        // Phase 1 chunk 6: walk the VMA tree and drop the process's
        // reference on every leaf page it had mapped. Required so a
        // forked-and-COW'd child returns its share of jointly-held
        // frames to the page pool when it exits, and so chunk-3's
        // raw-allocated `vm_copy_to` frames don't leak — both arches'
        // `vm_free_process_pt` only walks PT *structure*, not user
        // VMA-mapped leaves outside the legacy 0xCC..0xFF region.
        // Order matters: VMAs first (read live PTEs to find frames),
        // then `vm_free_process_pt` (tear down the PT pages
        // themselves; clears descriptors that the unmap loop above
        // already left at zero).
        vma_unmap_all_pages(&processes[pid].vma_tree, processes[pid].ptbr)
        vma_clear_all(&processes[pid].vma_tree)
        // Free per-process kernel stack (2 pages, allocated for ring 3 threads)
        // Guard: only free if the thread slot still belongs to this process.
        // Thread slots can be reused by create_process_suspended before reap runs.
        val rtid = processes[pid].main_tid
        if threads[rtid].pid == pid
            if threads[rtid].kstack_top != 0
                kstack_free(u64(threads[rtid].kstack_top - i64(4 * PAGE_SIZE)))
                threads[rtid].kstack_top = 0
        vm_free_process_pt(processes[pid].ptbr)
        processes[pid].state = PROC_FREE

    waitpid_current(pid: int)
        if pid < 0
            return
        if pid >= MAX_PROCESSES
            return
        if processes[pid].state == PROC_ZOMBIE
            reap_process(pid)
            return
        if processes[pid].state == PROC_FREE
            return
        // Block on the process's main thread
        val tid = processes[pid].main_tid
        if threads[tid].state == STATE_TERMINATED
            reap_process(pid)
            return
        threads[current_thread].state = STATE_JOINING
        threads[current_thread].join_target = tid
        threads[current_thread].consec_quanta = 0

    getpid_current(arg: int)
        syscall_return(threads[current_thread].pid)
        kernel_continue_current()

Kill a process by PID. Terminates its main thread and marks
the process as zombie. Returns 0 on success, -1 on error.

    kernel_kill_process(pid: int) -> int
        if pid <= 0
            return -1
        if pid >= MAX_PROCESSES
            return -1
        // Skip state check — processes[].state may read as wrong value
        // on x86 due to the val-reads-wrong codegen bug. The state is
        // set via PROC_RUNNING (val) but checked against literal 1.
        // Just verify process has a valid thread.
        val tid = processes[pid].main_tid
        if tid < 0
            return -1
        if tid >= thread_count
            return -1

        arch_cli()
        threads[tid].state = STATE_TERMINATED

        // Mark as zombie and notify PM (like terminate_current).
        // PM handles VFS cleanup, waitpid, reparenting, and RS notification.
        processes[pid].exit_code = -1
        processes[pid].state = PROC_ZOMBIE
        if kernel_pm_tid >= 0
            notify_send(kernel_pm_tid, pid)

        // Wake threads joining on this thread
        var i = 0
        while i < thread_count
            if threads[i].state == STATE_JOINING
                if threads[i].join_target == tid
                    threads[i].state = STATE_READY
                    threads[i].quantum = DEFAULT_QUANTUM
                    enqueue(threads[i].priority, i)
            i += 1
        // No sti — slow-path handler keeps cli; do_schedule does sti
        0

Returns next thread's SSP, or 0 if no threads are READY.
When 0 is returned, the assembly caller does wfi + retries.

Steps:
1. Increment tick counter
2. Save current thread's SSP and accumulate CPU tick
3. Handle quantum expiry (move to back of queue if expired)
4. Check watchdog (terminate thread if over limit)
5. Fire any expired software timers
6. Wake any blocked threads whose sleep time has expired
7. Pick the highest-priority non-empty queue and dequeue its front
8. Return its SSP, or 0 if all queues are empty


    sched_pick_next() -> int
        var pri = 0
        while pri < NUM_PRIORITIES
            if (ready_mask & (1 << pri)) != 0
                val next = dequeue(pri)
                if next != QUEUE_EMPTY
                    if threads[next].state == STATE_TERMINATED
                        // Skip killed threads still in ready queue.
                        // Don't advance pri — re-check same queue.
                        continue
                    return next
            pri += 1
        -1

    schedule(current_ssp: i64) -> i64
        ticks += 1
        timer_scan_subs()

        // Save current thread (skip when idle, current_thread == -1)
        if current_thread >= 0
            threads[current_thread].ssp = current_ssp
            threads[current_thread].cpu_ticks += 1
            if threads[current_thread].state == STATE_RUNNING
                // Decrement quantum and handle expiry
                threads[current_thread].quantum -= 1
                threads[current_thread].state = STATE_READY
                if threads[current_thread].quantum <= 0
                    // Full quantum consumed without voluntary yield
                    threads[current_thread].quantum = DEFAULT_QUANTUM
                    threads[current_thread].consec_quanta += 1
                    // Watchdog check
                    if watchdog_limit > 0
                        if threads[current_thread].consec_quanta >= watchdog_limit
                            threads[current_thread].state = STATE_TERMINATED
                // Re-enqueue if still ready (watchdog may have terminated)
                if threads[current_thread].state == STATE_READY
                    enqueue(threads[current_thread].priority, current_thread)

        // Wake threads whose sleep/timeout has expired (heap-based, O(log n))
        // Uses lazy deletion: threads woken early (e.g., by IPC) are skipped on pop
        // wake_ms is in `monotonic_ms_count` units (wall-clock ms),
        // not the schedule-call counter `ticks` — see sleep_current.
        // Cache the wall-clock now once per scheduler entry.
        val wall_now = int(monotonic_ms_count)
        while _sq_len > 0
            val tid = _sq_peek()
            if threads[tid].wake_ms > wall_now
                break  // earliest deadline not yet reached
            val _ = _sq_pop()
            // Lazy deletion: skip if thread was already woken by another path
            if threads[tid].state == STATE_BLOCKED
                threads[tid].state = STATE_READY
                threads[tid].quantum = DEFAULT_QUANTUM
                enqueue(threads[tid].priority, tid)
            else if threads[tid].state == STATE_SLEEP_OR_NOTIFY
                // Tick deadline reached without a notify. Wake on the
                // ready queue; the sys_sleep_or_notify wrapper checks
                // notify_pending after returning to detect which path
                // fired (timeout vs early notify).
                threads[tid].state = STATE_READY
                threads[tid].quantum = DEFAULT_QUANTUM
                enqueue(threads[tid].priority, tid)
            else if threads[tid].state == STATE_SEND_BLOCKED
                if threads[tid].wake_ms > 0
                    // IPC send timeout expired — wake with -2 in saved r1
                    syscall_return_for(tid, -2)
                    threads[tid].state = STATE_READY
                    threads[tid].quantum = DEFAULT_QUANTUM
                    threads[tid].wake_ms = 0
                    enqueue(threads[tid].priority, tid)

        // Find highest-priority non-empty queue (lowest number)
        val next = sched_pick_next()
        if next >= 0
            current_thread = next
            threads[next].state = STATE_RUNNING
            threads[next].ctx_switches += 1
            total_ctx_switches += 1
            vm_set_ptbr(threads[next].ptbr)
            tss_set_rsp0(threads[next].kstack_top)
            return threads[next].ssp

        // No ready threads — return 0 to signal idle
        current_thread = -1
        vm_set_ptbr(kernel_ptbr())
        0

Called by boot.asm after kernel_main() returns, so boot can
context-switch into the first thread. Dequeues from the
highest-priority non-empty queue.

    first_thread_ssp() -> i64
        // Dequeue the highest-priority thread
        var pri = 0
        while pri < NUM_PRIORITIES
            if (ready_mask & (1 << pri)) != 0
                val next = dequeue(pri)
                if next != QUEUE_EMPTY
                    current_thread = next
                    threads[next].state = STATE_RUNNING
                    threads[next].ctx_switches += 1
                    total_ctx_switches += 1
                    vm_set_ptbr(threads[next].ptbr)
                    tss_set_rsp0(threads[next].kstack_top)
                    return threads[next].ssp
            pri += 1
        0

The callback is a function pointer (int) that will be called
after delay ticks. One-shot: fires once then deactivates.

    timer_arm(delay: int, callback: i64) -> int
        var i = 0
        while i < MAX_TIMERS
            if timers[i].active == 0
                timers[i].active = 1
                timers[i].fire_tick = ticks + delay
                timers[i].callback = callback
                return i
            i += 1
        -1

    timer_cancel(id: int)
        if id >= 0
            if id < MAX_TIMERS
                timers[id].active = 0

Terminates every thread and sets current_thread to -1.
The CPU will enter the idle loop and halt once the cycle
limit is reached (or wfi forever in production).

    kernel_panic()
        var i = 0
        while i < thread_count
            threads[i].state = STATE_TERMINATED
            i += 1
        current_thread = -1
        init_queues()

Reads the value at the base of the thread's user stack (the
address passed as usp during create_thread). If it still equals
STACK_CANARY, the stack has not overflowed.

    check_stack_canary(id: int) -> int
        // usp was stored in the initial stack frame — we need to
        // recover it. For now, check the canary at a known location.
        // The canary is at the usp address passed to create_thread.
        // We don't store usp separately, so this needs the caller
        // to pass the original usp.
        0

    check_stack_at(addr: i64) -> int
        var p: *int = *int(addr)
        if *p == STACK_CANARY
            return 1
        0

Sets state to STATE_SUSPENDED. The thread will not be scheduled
until resume_thread is called. Does not affect the thread's
stack or context -- it can be resumed exactly where it left off.

    suspend_thread(id: int)
        // NOTE: caller must ensure interrupts are disabled (cli).
        if threads[id].state != STATE_TERMINATED
            if threads[id].state != STATE_SUSPENDED
                threads[id].state = STATE_SUSPENDED

    resume_thread(id: int)
        arch_cli()
        if threads[id].state == STATE_SUSPENDED
            threads[id].state = STATE_READY
            threads[id].quantum = DEFAULT_QUANTUM
            enqueue(threads[id].priority, id)
        // No sti — callers handle: fast-path does sti+rte,
        // slow-path handler keeps cli until do_schedule

    kernel_tls_set(packed: int)
        val slot = (packed >> 24) & 0xFF
        val value = packed & 0xFFFFFF
        tls[current_thread * TLS_SLOTS + slot] = value

    kernel_tls_get(slot: int) -> int
        tls[current_thread * TLS_SLOTS + slot]

    kernel_set_idle_hook(hook: i64)
        idle_hook = hook

    kernel_set_tick_hook(hook: i64)
        tick_hook = hook

Sets the target thread's notify_value and marks it as pending.
If the target is waiting for a notification (STATE_NOTIFY_WAIT),
it is woken and re-enqueued.

    notify_send(target_id: int, value: int)
        // NOTE: caller must ensure interrupts are disabled (cli).
        // Called from terminate_current (syscall handler) and IRQ handlers,
        // both of which already have cli. Adding sti here would prematurely
        // re-enable interrupts inside those handlers.
        threads[target_id].notify_value = value
        threads[target_id].notify_pending = 1
        val st = threads[target_id].state
        if st == STATE_NOTIFY_WAIT
            threads[target_id].state = STATE_READY
            threads[target_id].quantum = DEFAULT_QUANTUM
            enqueue(threads[target_id].priority, target_id)
        else if st == STATE_RECV_NOTIFY_BLOCKED
            // Wake with -2 to indicate notification (not IPC message)
            syscall_return_for(target_id, -2)
            threads[target_id].state = STATE_READY
            threads[target_id].quantum = DEFAULT_QUANTUM
            enqueue(threads[target_id].priority, target_id)
        else if st == STATE_SLEEP_OR_NOTIFY
            // Thread is in the sleep heap; lazy deletion in the
            // tick-wake path will skip it once it's STATE_READY.
            // wake_ms stays set — the heap pop sees state != BLOCKED
            // and ignores the stale entry.
            threads[target_id].state = STATE_READY
            threads[target_id].quantum = DEFAULT_QUANTUM
            enqueue(threads[target_id].priority, target_id)

If a notification is already pending, returns immediately.
Otherwise sets state to STATE_NOTIFY_WAIT and the scheduler
will skip this thread until notify_send wakes it.

    notify_wait_current()
        if threads[current_thread].notify_pending == 1
            return
        threads[current_thread].state = STATE_NOTIFY_WAIT
        threads[current_thread].consec_quanta = 0

Sleep for `nticks` OR until a notification arrives, whichever
comes first. If a notification is already pending, returns
immediately (matching `notify_wait_current`'s fast path so the
shim doesn't have to check both before calling). Caller checks
`notify_read_self()` afterwards to learn which path fired.

    sleep_or_notify_current(nticks: int)
        if threads[current_thread].notify_pending == 1
            return
        if nticks <= 0
            return
        threads[current_thread].state = STATE_SLEEP_OR_NOTIFY
        // `wake_ms` in monotonic_ms units; nticks is 10-ms ticks.
        threads[current_thread].wake_ms = int(monotonic_ms_count) + nticks * 10
        threads[current_thread].consec_quanta = 0
        sleepq_insert(current_thread)

Syscall handlers for the notification system. The services layer
packs target_id and value into a single i64 argument:
notify_send: (id << 24) | (value & 0xFFFFFF)

    sys_notify_send_handler(arg: int)
        val target = (arg >> 24) & 0xFF
        val value = arg & 0xFFFFFF
        notify_send(target, value)
        kernel_continue_current()

    sys_notify_wait_handler(arg: int)
        notify_wait_current()

    sys_sleep_or_notify_handler(arg: int)
        sleep_or_notify_current(arg)

    sys_notify_read_handler(arg: int)
        val v = notify_read(current_thread)
        syscall_return(v)
        kernel_continue_current()

    sys_event_wait_handler(arg: int)
        val wait_all = (arg >> 24) & 0xFF
        val mask = arg & 0xFFFFFF
        event_wait_current(mask, wait_all)

    sys_event_set_handler(arg: int)
        val target = (arg >> 24) & 0xFF
        val bits = arg & 0xFFFFFF
        notify_send(target, bits)
        kernel_continue_current()

    sys_event_clear_handler(arg: int)
        val target = (arg >> 24) & 0xFF
        val bits = arg & 0xFFFFFF
        threads[target].notify_value = threads[target].notify_value & ~bits
        kernel_continue_current()

    notify_read(id: int) -> int
        val v = threads[id].notify_value
        threads[id].notify_pending = 0
        threads[id].notify_value = 0
        v

Uses notify_value as the event bits. wait_all=1 means all bits
in mask must be set. wait_all=0 means any bit in mask suffices.
The caller should check the bits after waking (Mesa semantics).

Event groups are per-thread -- each thread's notify_value doubles
as its event bits. Other threads set bits via notify_send.

    event_wait_current(mask: int, wait_all: int)
        if wait_all != 0
            if (threads[current_thread].notify_value & mask) == mask
                return
        else
            if (threads[current_thread].notify_value & mask) != 0
                return
        threads[current_thread].state = STATE_NOTIFY_WAIT
        threads[current_thread].consec_quanta = 0

    event_set_bits(target_id: int, bits: int)
        threads[target_id].notify_value = threads[target_id].notify_value | bits
        threads[target_id].notify_pending = 1
        if threads[target_id].state == STATE_NOTIFY_WAIT
            threads[target_id].state = STATE_READY
            threads[target_id].quantum = DEFAULT_QUANTUM
            enqueue(threads[target_id].priority, target_id)

    event_clear_bits(target_id: int, bits: int)
        threads[target_id].notify_value = threads[target_id].notify_value & ~bits

Priority inheritance support. PIMutex is a kernel-managed mutex
that prevents priority inversion: when a high-priority thread
blocks on a mutex held by a low-priority thread, the holder is
temporarily boosted to the blocker's priority.

PIMutex struct layout (3 fields, each int-sized):
- offset 0: owner -- thread ID of holder (-1 = unlocked)
- offset 8: wait_head -- first waiting thread index (QUEUE_EMPTY = none)
- offset 16: wait_tail -- last waiting thread index


    struct PIMutex
        owner: int
        wait_head: int
        wait_tail: int

    pimutex_init_kernel(m: *PIMutex)
        m.owner = -1
        m.wait_head = QUEUE_EMPTY
        m.wait_tail = QUEUE_EMPTY

remove_from_queue -- Remove a specific thread from a priority run queue.
Needed when boosting a READY thread's priority: remove from old queue,
re-enqueue at new priority.

    remove_from_queue(pri: int, idx: int)
        if queue_head[pri] == idx
            queue_head[pri] = threads[idx].next
            if queue_head[pri] == QUEUE_EMPTY
                queue_tail[pri] = QUEUE_EMPTY
                ready_mask = ready_mask & ~(1 << pri)
            threads[idx].next = QUEUE_EMPTY
            return
        var prev = queue_head[pri]
        while prev != QUEUE_EMPTY
            if threads[prev].next == idx
                threads[prev].next = threads[idx].next
                if queue_tail[pri] == idx
                    queue_tail[pri] = prev
                threads[idx].next = QUEUE_EMPTY
                if queue_head[pri] == QUEUE_EMPTY
                    ready_mask = ready_mask & ~(1 << pri)
                return
            prev = threads[prev].next

boost_thread_priority -- Boost a thread's effective priority.
Handles the thread regardless of state:
- RUNNING: just change priority (takes effect at next schedule)
- READY: move between run queues
- MUTEX_WAIT: change priority and propagate to the mutex owner
    (transitive inheritance)


    boost_thread_priority(id: int, new_pri: int)
        if new_pri >= threads[id].priority
            return
        val old_pri = threads[id].priority
        threads[id].priority = new_pri
        if threads[id].state == STATE_READY
            remove_from_queue(old_pri, id)
            enqueue(new_pri, id)
        else if threads[id].state == STATE_MUTEX_WAIT
            if threads[id].blocked_on != 0
                var bm: *PIMutex = *int(threads[id].blocked_on)
                if bm.owner >= 0
                    boost_thread_priority(bm.owner, new_pri)

If the mutex is free, acquire immediately. If held, boost the
owner's priority if needed, add ourselves to the wait queue,
and block with STATE_MUTEX_WAIT. The scheduler will not touch
us until pimutex_unlock_kernel wakes us.

    pimutex_lock_kernel(m: *PIMutex)
        if m.owner == -1
            m.owner = current_thread
            return
        val owner = m.owner
        if threads[current_thread].priority < threads[owner].priority
            boost_thread_priority(owner, threads[current_thread].priority)
        threads[current_thread].next = QUEUE_EMPTY
        if m.wait_head == QUEUE_EMPTY
            m.wait_head = current_thread
            m.wait_tail = current_thread
        else
            threads[m.wait_tail].next = current_thread
            m.wait_tail = current_thread
        threads[current_thread].state = STATE_MUTEX_WAIT
        threads[current_thread].blocked_on = i64(m)
        threads[current_thread].consec_quanta = 0

Restores the caller's priority to base_priority. If there are
waiters, transfers ownership to the first waiter (FIFO order)
and wakes it. The scheduler will then pick the highest-priority
runnable thread.

    pimutex_unlock_kernel(m: *PIMutex)
        val me = current_thread
        threads[me].priority = threads[me].base_priority
        if m.wait_head == QUEUE_EMPTY
            m.owner = -1
            return
        val waiter = m.wait_head
        m.wait_head = threads[waiter].next
        if m.wait_head == QUEUE_EMPTY
            m.wait_tail = QUEUE_EMPTY
        threads[waiter].next = QUEUE_EMPTY
        m.owner = waiter
        threads[waiter].state = STATE_READY
        threads[waiter].blocked_on = 0
        threads[waiter].quantum = DEFAULT_QUANTUM
        enqueue(threads[waiter].priority, waiter)
