        syscall_return(0)
        kernel_continue_current()

SYS_SET_THREAD_PTBR (50): Set a thread's page table base.
Args: a0=tid, a1=ptbr.

    sys_set_thread_ptbr_handler(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
        kernel_set_thread_ptbr(int(a0), u64(a1))
        kernel_continue_current()
        i64(0)

SYS_VM_SET_PTBR (51): Set the hardware PTBR.
Arg = address.

    sys_vm_set_ptbr_handler(arg: int)
