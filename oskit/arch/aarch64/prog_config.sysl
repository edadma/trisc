// Address layout for aarch64 user programs and servers.
//
// Programs and servers both live in the L3 carve-out at VA
// 0x60000000..0x60080000 (128 pages of code/data/bss/heap), stack
// at 0x60080000..0x6008FFFF (16 pages). Per-process VMA layout is
// the single source of truth — see `oskit/kernel/vma.lsysl::
// VMA_DEFAULT_*`. Initial-SP / stack-low values are surfaced to PM
// and RS via `svc_vma_default_initial_sp` / `svc_vma_default_stack_low`
// (syscalls 96/97) — no fixed PROG_USP/PROG_SSP constants here.
//
// Mirrors the structure of oskit/arch/x86_64/prog_config.sysl: just
// the cross-target constants a standalone user program needs, none
// of the kernel-side externs that live in cpu.lsysl/vm.lsysl/exc.lsysl.
//
// SRV_USP/SRV_SSP are PHASE 1 REPLACEMENT TARGETS — Phase D folds
// server stack provisioning into the same VMA-driven path as programs.

module oskit.arch

val SRV_USP  = 0x60090000
val SRV_SSP  = 0x60080000

// AT_PLATFORM string for the SysV initial stack auxv. ld-musl reads
// this via `__init_libc` -> `__libc.platform` and uses it to pick
// HWCAP-gated string routines. Must match what musl was built for —
// we cross-build aarch64-slix-linux-musl, so the platform name is
// the unprefixed arch name.
val PLATFORM_NAME = "aarch64"

// Server-side VA of the MMIO page granted by vm_create_server_pt
// (L3[256] under the user carve-out). Must match the kernel-side
// definition in oskit/arch/aarch64/vm.lsysl. Sub-page register
// blocks land at MMIO_SERVER_VA + (PA & 0xfff).
val MMIO_SERVER_VA: i64 = 0x60100000

// virtio-mmio slot 31 on QEMU virt lives at MMIO_SERVER_VA + 0xe00
// (PA 0x0a003e00, 31 * 0x200 from VIRTIO_MMIO_BASE 0x0a000000).
// The RS grant on this arch maps the slot 24..31 page at
// MMIO_SERVER_VA, so the driver sees it at the offset above.
val VIRTIO_NET_SLOT_OFFSET: i64 = 0xe00
