hello — aarch64 sysl kernel entry (QEMU virt)
=============================================

Boot path for the QEMU virt board. Provides the platform-side
implementations of `arch_dispatch_sync`, `arch_dispatch_irq`, and
`arch_schedule_after_exc`, then drives one of three demos:

  DEMO_MODE = 0   — kernel-integrated: create two kernel threads
                    via `create_thread`, then `first_thread_ssp()` +
                    `arch_resume_process()` to kick off the first.
                    Timer IRQ flows through the real `schedule()`.
  DEMO_MODE = 1   — ad-hoc: own two-thread scheduler (no kernel).
                    Useful for regression testing the context-switch
                    asm without dragging in the full kernel.
  DEMO_MODE = 2   — EL0 demo: drop to EL0 with a `b .` program and
                    watch timer preemption count ticks. Predates
                    everything else; kept as a sanity check.

    module oskit.arch.aarch64.board.virt

    import oskit.arch.{page_alloc_zero, kernel_ptbr, vm_flush_tlb,
        vm_create_process_pt, vm_set_ptbr, read_sctlr_el1,
        read_esr_el1, abort,
        last_user_code_page, last_user_stack_page, drop_to_el0,
        sync_icache_line, vm_v2p, vm_copy_to, vm_copy_from,
        cntfrq_el0, cntp_tval_set, cntp_ctl_set,
        build_stack_frame, arch_resume_process,
        STACK_FRAME_SIZE, arch_cli, arch_sti,
        PROG_USP, PROG_SSP}
    import oskit.kernel.{kernel_init, create_thread, create_thread_pri,
        first_thread_ssp,
        kernel_stack_usp, kernel_stack_ssp, schedule,
        syscall_table, syscall_table_6, syscall_ssp_set, syscall_check_allowed,
        create_process_suspended, resume_process,
        register_syscall, syscall_return,
        terminate_current,
        kb_enqueue, kb_notify_tid, notify_send,
        virtio_notify_tid,
        kernel_set_system_info,
        kernel_get_thread_pid, kernel_get_process_main_tid,
        current_thread, ticks}
    import oskit.config.{NUM_PRIORITIES, MAX_SYSCALLS}
    import oskit.ipc.{ipc_init, port_create, port_register, port_lookup,
        ipc_send, ipc_recv, ipc_reply}
    import oskit.services.{get_thread_count, uptime, sleep, yield}
    import oskit.hal.memset
    import oskit.drivers.virtio.{virtio_device_id, virtio_present,
        VIRTIO_MMIO_BASE, VIRTIO_MMIO_STRIDE, VIRTIO_MMIO_MAX, VIRTIO_DEV_NET}

    extern arch_syscall_call(arg: i64, handler: i64)
    extern arch_syscall_call6(handler: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64

    val DEMO_MODE = 5             // 0=kernel+IPC, 1=ad-hoc, 2=EL0 legacy, 3=user proc, 4=user+kern IPC, 5=rs-as-userspace

Render `v` as a 16-digit hex number (prefixed `0x`) to the UART.

    uart_puthex(v: u64)
        uart_puts("0x")
        var shift = 60
        while shift >= 0
            val d = int((v >> u64(shift)) & u64(0xF))
            if d < 10
                uart_putc(int('0') + d)
            else
                uart_putc(int('A') + d - 10)
            shift -= 4

GICv2 programming — QEMU virt wires the distributor at 0x08000000
and the per-CPU CPU interface at 0x08010000.

    val GICD_CTLR:        u64 = u64(0x08000000)
    val GICD_ISENABLER0:  u64 = u64(0x08000100)
    val GICD_ISENABLER1:  u64 = u64(0x08000104)  // SPIs 32..63
    val GICD_ISENABLER2:  u64 = u64(0x08000108)  // SPIs 64..95
    val GICD_IPRIORITYR:  u64 = u64(0x08000400)  // 1 byte per IRQ
    val GICD_ITARGETSR:   u64 = u64(0x08000800)  // 1 byte per IRQ (SPIs only)
    val GICC_CTLR:        u64 = u64(0x08010000)
    val GICC_PMR:         u64 = u64(0x08010004)
    val GICC_IAR:         u64 = u64(0x0801000C)
    val GICC_EOIR:        u64 = u64(0x08010010)
    val IRQ_TIMER:       int = 30          // EL1 phys timer (PPI 14)
    val IRQ_UART:        int = 33          // PL011 on QEMU virt (SPI 1)
    val IRQ_VIRTIO_NET:  int = 79          // virtio-mmio slot 31 (SPI 47)

    gic_init()
        var dctl: *i32 = *i32(GICD_CTLR)
        *dctl = i32(1)
        // Enable IRQ 30 (timer, PPI) in ISENABLER0.
        var isen0: *i32 = *i32(GICD_ISENABLER0)
        *isen0 = i32(0x40000000)
        var prio_timer: *byte = *byte(GICD_IPRIORITYR + u64(IRQ_TIMER))
        *prio_timer = byte(0xA0)
        // Enable IRQ 33 (PL011, SPI 1) in ISENABLER1, route to CPU 0,
        // priority 0xA0 matching the timer.
        var isen1: *i32 = *i32(GICD_ISENABLER1)
        *isen1 = i32(1 << 1)               // bit 1 = IRQ 33
        var prio_uart: *byte = *byte(GICD_IPRIORITYR + u64(IRQ_UART))
        *prio_uart = byte(0xA0)
        var target_uart: *byte = *byte(GICD_ITARGETSR + u64(IRQ_UART))
        *target_uart = byte(1)             // CPU 0
        // Enable IRQ 79 (virtio-mmio slot 31, SPI 47) in ISENABLER2 at
        // bit (79 - 64) = 15. Priority + target match the UART.
        var isen2: *i32 = *i32(GICD_ISENABLER2)
        *isen2 = i32(1 << 15)
        var prio_vnet: *byte = *byte(GICD_IPRIORITYR + u64(IRQ_VIRTIO_NET))
        *prio_vnet = byte(0xA0)
        var target_vnet: *byte = *byte(GICD_ITARGETSR + u64(IRQ_VIRTIO_NET))
        *target_vnet = byte(1)             // CPU 0
        var pmr: *i32 = *i32(GICC_PMR)
        *pmr = i32(0xFF)
        var cctl: *i32 = *i32(GICC_CTLR)
        *cctl = i32(1)
        // Unmask PL011 RX at the UART itself.
        uart_enable_rx_irq()

    gic_ack() -> int
        var iarp: *i32 = *i32(GICC_IAR)
        int(*iarp) & 0x3FF

    gic_eoi(irq: int)
        var eoip: *i32 = *i32(GICC_EOIR)
        *eoip = i32(irq)

Serial RX handler. Drains all pending PL011 bytes into the kernel's
keyboard buffer as raw-ASCII events (bit 17 = raw flag, bit 16 =
press flag, bits 31..24 = ASCII), matching x86 runtime.lsysl's
serial_handler format. TTY server's tty_process_keyboard picks
them up via kbhit/getkey and skips scancode translation on the
raw-ASCII path. Acks the PL011 interrupt before GIC EOI.

    serial_handler()
        var got = 0
        while uart_rx_empty() == 0
            val ch = uart_rx_read()
            kb_enqueue((ch << 24) | 0x30000)   // raw(17) | press(16)
            got = 1
        uart_ack_rx_irq()
        if got == 1
            if kb_notify_tid >= 0
                notify_send(kb_notify_tid, 1)

Virtio-mmio IRQ handler. virtio-mmio slot 31 (virtio-net) is the
only device we route; its INT_STATUS/INT_ACK registers live at
fixed PA 0x0a003e00, directly reachable from kernel Device map.
Must clear the device-side pending bits before the GIC EOI,
otherwise the level-sensitive line re-asserts immediately.

Kernel doesn't know what queue fired — the nic server walks used
rings itself. We just ack the device and wake the registered
notify TID (set via `svc_virtio_set_notify`).

    val VIRTIO_NET_IRQ_PA: u64 = u64(0x0a003e00)
    val VIRTIO_REG_INT_STATUS_OFF: u64 = u64(0x60)
    val VIRTIO_REG_INT_ACK_OFF:    u64 = u64(0x64)

    virtio_handler()
        var sp: *i32 = *i32(VIRTIO_NET_IRQ_PA + VIRTIO_REG_INT_STATUS_OFF)
        val status = *sp
        if status != i32(0)
            var ap: *i32 = *i32(VIRTIO_NET_IRQ_PA + VIRTIO_REG_INT_ACK_OFF)
            *ap = status
        if virtio_notify_tid >= 0
            notify_send(virtio_notify_tid, 1)

    timer_init_periodic(interval_ticks: u64)
        cntp_tval_set(interval_ticks)
        cntp_ctl_set(u64(1))

    var tick_count: int = 0

Ad-hoc kernel-thread demo state (DEMO_MODE = 1).

    val MAX_KT = 2
    val KT_STACK_BYTES = 4096

    var kt_stacks: [2][4096]byte
    var kt_ssp: [2]i64
    var kt_current: int = -1
    var kt_active: int = 0

    kthread_a()
        while true
            uart_puts("[kt A tick]\n")
            arch_wfi()

    kthread_b()
        while true
            uart_puts("[kt B tick]\n")
            arch_wfi()

    extern arch_wfi()

    kt_init(slot: int, entry: i64)
        var i = 0
        while i < KT_STACK_BYTES
            kt_stacks[slot][i] = 0
            i += 1
        val top = i64(&kt_stacks[slot][0]) + i64(KT_STACK_BYTES)
        kt_ssp[slot] = build_stack_frame(entry, top, top)

Sync dispatcher — decode ESR and route.

    extern read_far_el1() -> u64

    arch_dispatch_sync(esr: u64, frame: u64)
        val ec = int((esr >> u64(26)) & u64(0x3F))
        if ec == 0x15
            syscall_dispatch(frame)
        else
            uart_puts("[unhandled sync, ESR=")
            uart_puthex(esr)
            uart_puts(" FAR=")
            uart_puthex(read_far_el1())
            uart_puts(" ELR=")
            var fp: *i64 = *i64(frame)
            var elr_p: *i64 = *i64(frame + u64(0x108))
            uart_puthex(u64(*elr_p))
            uart_puts("]\n")
            abort()

IRQ dispatcher — GIC ack, handle, EOI. Any printing is conditional
on DEMO_MODE because in DEMO_MODE=0 every timer tick drives a real
scheduler pass and the kernel threads themselves produce output.

    arch_dispatch_irq(frame: u64)
        val irq = gic_ack()
        if irq == IRQ_TIMER
            tick_count += 1
            if DEMO_MODE == 2
                uart_puts("[tick ")
                uart_puthex(u64(tick_count))
                uart_puts("]\n")
            cntp_tval_set(cntfrq_el0() / u64(100))
        else if irq == IRQ_UART
            serial_handler()
        else if irq == IRQ_VIRTIO_NET
            virtio_handler()
        gic_eoi(irq)

Scheduler hook. Five shapes:
  DEMO_MODE == 0 → delegate to the kernel's real schedule(ssp)
  DEMO_MODE == 1 → ad-hoc round-robin across kt_ssp[]
  DEMO_MODE == 2 → identity (EL0 demo has nothing to schedule)
  DEMO_MODE == 3 → same as 0, but idle=halt so the user-proc test
                   terminates cleanly after the sole process exits
  DEMO_MODE == 4 → same as 3 (user process + kernel echo server,
                   both go through schedule(); idle halts)

When the kernel's schedule() returns 0, there are no ready threads.
arch_resume_process(0) would trash SP_EL1; instead we spin on wfi
so the VM halts cleanly (or waits for an interrupt in richer setups).

    // Fast-path skip flag. Set by `syscall_dispatch` when a short
    // syscall (putc/thread_id/uptime) completes entirely in dispatch
    // and doesn't want the scheduler to re-evaluate (which would
    // FIFO-swap the thread with any peer at equal priority — the
    // visible symptom is per-byte interleave of boot banners).
    // Matches x86 boot.s's fast-path-then-iretq pattern.
    var skip_schedule = false

    arch_schedule_after_exc(ssp: i64) -> i64
        if skip_schedule
            skip_schedule = false
            return ssp
        if DEMO_MODE == 0 || DEMO_MODE == 3 || DEMO_MODE == 4 || DEMO_MODE == 5
            val next = schedule(ssp)
            if next == i64(0)
                // The idle thread (created in kernel_main_rs) is always
                // READY at priority NUM_PRIORITIES-1, so schedule() should
                // never come back with 0 once it's been registered.
                // Keep a wfi spin as a last-resort safety net for modes
                // that don't spawn an idle thread.
                arch_sti()
                while true
                    arch_wfi()
            return next
        if DEMO_MODE == 1
            if kt_active <= 0
                return ssp
            if kt_current >= 0
                kt_ssp[kt_current] = ssp
            val next = (kt_current + 1) % kt_active
            kt_current = next
            return kt_ssp[next]
        ssp

Idle thread body. Sits at NUM_PRIORITIES-1 (lowest) so
`sched_pick_next` only picks it when no other thread is ready.
Runs on its own kernel stack (slot 0), so we avoid the previous
problem of arch_schedule_after_exc entering an infinite wfi loop
inside a caller's stack frame and leaking that frame every time
we idle. Unlike the old inline loop, every "idle, wake, run real
thread, idle again" cycle cleanly resets this thread's ssp via
the standard schedule() save/restore path.

arch_sti is redundant on entry (SPSR = 0x5 already clears DAIF at
ERET), but keeps the invariant explicit for readers who find this
via grep.

    idle_thread_body()
        arch_sti()
        while true
            arch_wfi()

SVC dispatcher. Looks up the kernel's registered handler in
syscall_table[num], runs the privilege check, and tail-calls the
handler via the arch_syscall_call asm helper. Handlers write
their return value into the saved frame by calling syscall_return
(which reads syscall_ssp).

DEMO_MODE == 2 keeps the old EL0 demo behavior (SYS_EXIT=93 halts,
SYS_PUTHEX=1 prints) so legacy output still works when the shared
kernel isn't in play.

    syscall_dispatch(frame: u64)
        var fp: *i64 = *i64(frame)
        val num = int(fp[8])
        val a0 = fp[0]

        if DEMO_MODE == 2
            if num == 1
                uart_puts("[EL0 says ")
                uart_puthex(u64(a0))
                uart_puts("]\n")
                fp[0] = i64(0)
                return
            if num == 93
                uart_puts("[EL0 exited, code=")
                uart_puthex(u64(a0))
                uart_puts("]\n")
                abort()

        if num < 0 || num >= MAX_SYSCALLS
            fp[0] = i64(-1)
            return

        // Fast path: putc/thread_id/uptime don't touch scheduler state
        // and are the common case for boot-time printing. Handle
        // inline, set skip_schedule so arch_schedule_after_exc returns
        // the current ssp directly. Matches the x86 fast-path in
        // boot.s that jumps to restore_context without touching
        // syscall_table. Without this, every putc FIFO-swaps two
        // printing threads, interleaving each byte.
        if num == 1
            uart_putc(int(a0) & 0xFF)
            fp[0] = i64(0)
            skip_schedule = true
            return
        if num == 5
            fp[0] = i64(current_thread)
            skip_schedule = true
            return
        if num == 6
            fp[0] = i64(ticks)
            skip_schedule = true
            return

        // POSIX shim range (128-511): multi-arg handlers. Musl-linked
        // programs enter here with x0..x5 carrying up to six args in
        // standard AArch64 ABI order. The native single-arg
        // arch_syscall_call path (below) can't express that, so these
        // syscalls route through posix_dispatch which picks the args
        // it needs off the saved frame.
        if num >= 128
            syscall_ssp_set(i64(frame))
            if syscall_check_allowed(num) == 0
                fp[0] = i64(-1)
                return
            fp[0] = posix_dispatch(num, fp[0], fp[1], fp[2], fp[3], fp[4], fp[5])
            return

        // 6-arg path: check syscall_table_6 first. Handlers here
        // take all six i64 args and return i64; dispatcher writes
        // the result to fp[0].
        val handler6 = syscall_table_6[num]
        if handler6 != i64(0)
            syscall_ssp_set(i64(frame))
            if syscall_check_allowed(num) == 0
                fp[0] = i64(-1)
                return
            fp[0] = arch_syscall_call6(handler6, fp[0], fp[1], fp[2], fp[3], fp[4], fp[5])
            return

        val handler = syscall_table[num]
        if handler == i64(0)
            fp[0] = i64(-1)
            return

        syscall_ssp_set(i64(frame))

        if syscall_check_allowed(num) == 0
            fp[0] = i64(-1)
            return

        arch_syscall_call(a0, handler)

POSIX fd table
==============

Per-process POSIX file descriptor table. Each process gets 64
slots; slots 0/1/2 are lazily initialized to STDIN/STDOUT/STDERR
so a fresh musl process can `write(1, ...)` without any explicit
setup from PM.

Slot kinds:

- `POSIX_FD_FREE` — slot is available for allocation.
- `POSIX_FD_STDIN` — read returns EOF, write is rejected.
- `POSIX_FD_STDOUT` / `POSIX_FD_STDERR` — write goes directly to
  the PL011 UART (retained fast-path until TTY routing lands),
  read is rejected.
- `POSIX_FD_UDP_SOCKET` — `target` holds the inet server's
  socket id; read/write/close/sendto/recvfrom route through
  `ipc_send` to the inet port.

Generation tracking uses `processes[pid].main_tid` as the sentinel:
when a pid slot is reused by a new process, the new `main_tid`
differs from the last-initialized value, which triggers a fresh
table reset. That avoids leaking fd state across process reuse
without a PM-side cleanup hook.

Not handled in this pass: process-exit cleanup of held socket
handles on the inet server side (the inet record still quotes the
terminated thread as owner). Future work tracked under the
posix_fd_bridge memory.

    val POSIX_FD_FREE        = 0
    val POSIX_FD_STDIN       = 1
    val POSIX_FD_STDOUT      = 2
    val POSIX_FD_STDERR      = 3
    val POSIX_FD_UDP_SOCKET  = 4
    val POSIX_FD_TCP_SOCKET  = 5

    val POSIX_FDS_PER_PROC   = 64

    struct PosixFd
        kind: int
        target: int
        flags: int
        pos: i64

    var posix_fd_table: [1024]PosixFd     // 16 procs * 64 fds
    var posix_fd_last_gen: [16]int        // main_tid when last initialized

    posix_fd_init_pid(pid: int)
        val base = pid * POSIX_FDS_PER_PROC
        var i = 0
        while i < POSIX_FDS_PER_PROC
            posix_fd_table[base + i].kind = POSIX_FD_FREE
            posix_fd_table[base + i].target = 0
            posix_fd_table[base + i].flags = 0
            posix_fd_table[base + i].pos = i64(0)
            i += 1
        posix_fd_table[base + 0].kind = POSIX_FD_STDIN
        posix_fd_table[base + 1].kind = POSIX_FD_STDOUT
        posix_fd_table[base + 2].kind = POSIX_FD_STDERR

    posix_fd_ensure_init(pid: int)
        val gen = kernel_get_process_main_tid(pid)
        if posix_fd_last_gen[pid] != gen
            posix_fd_init_pid(pid)
            posix_fd_last_gen[pid] = gen

    posix_fd_current_pid() -> int
        kernel_get_thread_pid(current_thread)

    posix_fd_kind(fd: int) -> int
        if fd < 0
            return POSIX_FD_FREE
        if fd >= POSIX_FDS_PER_PROC
            return POSIX_FD_FREE
        val pid = posix_fd_current_pid()
        if pid <= 0
            return POSIX_FD_FREE
        if pid >= 16
            return POSIX_FD_FREE
        posix_fd_ensure_init(pid)
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].kind

    posix_fd_target(fd: int) -> int
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].target

    posix_fd_flags(fd: int) -> int
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].flags

    posix_fd_set_flags(fd: int, flags: int)
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].flags = flags

    posix_fd_alloc(kind: int, target: int) -> int
        val pid = posix_fd_current_pid()
        if pid <= 0
            return -1
        if pid >= 16
            return -1
        posix_fd_ensure_init(pid)
        val base = pid * POSIX_FDS_PER_PROC
        var i = 3
        while i < POSIX_FDS_PER_PROC
            if posix_fd_table[base + i].kind == POSIX_FD_FREE
                posix_fd_table[base + i].kind = kind
                posix_fd_table[base + i].target = target
                posix_fd_table[base + i].flags = 0
                posix_fd_table[base + i].pos = i64(0)
                return i
            i += 1
        -1

    posix_fd_clear(fd: int)
        val pid = posix_fd_current_pid()
        if pid <= 0
            return
        if pid >= 16
            return
        if fd < 0
            return
        if fd >= POSIX_FDS_PER_PROC
            return
        val idx = pid * POSIX_FDS_PER_PROC + fd
        posix_fd_table[idx].kind = POSIX_FD_FREE
        posix_fd_table[idx].target = 0
        posix_fd_table[idx].flags = 0
        posix_fd_table[idx].pos = i64(0)


INET client helpers (shim-side)
-------------------------------

Minimal wire helpers that mirror `oskit/servers/inet.lsysl`'s
message layout. The shim talks to the inet server via the same
IPC protocol that `oskit/net/client.lsysl` uses from user space;
we replicate the writers here instead of importing `oskit.net` to
keep the kernel link free of the full socket-API module.

    val INET_CMD_SOCKET      = 1
    val INET_CMD_BIND        = 2
    val INET_CMD_SENDTO      = 3
    val INET_CMD_RECVFROM    = 4
    val INET_CMD_CLOSE       = 5
    val INET_CMD_TCP_CONNECT = 10
    val INET_CMD_TCP_SEND    = 11
    val INET_CMD_TCP_RECV    = 12
    val INET_CMD_TCP_CLOSE   = 13
    val INET_CMD_TCP_LISTEN  = 14
    val INET_CMD_TCP_ACCEPT  = 15
    val INET_CMD_UDP_GETNAME = 24
    val INET_CMD_TCP_GETNAME = 25
    val INET_CMD_RECVFROM_TIMEOUT = 18
    val INET_CMD_TCP_RECV_NB = 26
    val INET_CMD_TCP_SHUTDOWN = 27

    val INET_MAX_TCP_SEG     = 480

    val POSIX_AF_INET        = 2
    val POSIX_SOCK_DGRAM     = 2
    val POSIX_SOCK_STREAM    = 1

POSIX `O_NONBLOCK` is Linux octal 04000 = 2048. We only honour this
flag today; other open(2) flags (O_APPEND etc.) would need the
shim to actually track them, so we mask them off on `F_SETFL`.

    val POSIX_O_NONBLOCK     = 2048

fcntl command codes (`<fcntl.h>` in musl arch).

    val POSIX_F_DUPFD        = 0
    val POSIX_F_GETFD        = 1
    val POSIX_F_SETFD        = 2
    val POSIX_F_GETFL        = 3
    val POSIX_F_SETFL        = 4

    var inet_port_cached = -1

    inet_get_port() -> int
        if inet_port_cached < 0
            inet_port_cached = port_lookup("inet")
        inet_port_cached

    shim_write_u16(p: *byte, off: int, v: int)
        p[off]     = byte((v >> 8) & 0xff)
        p[off + 1] = byte(v & 0xff)

    shim_read_u16(p: *byte, off: int) -> int
        ((int(p[off]) & 0xff) << 8) | (int(p[off + 1]) & 0xff)


POSIX shim dispatch. Musl's aarch64-slix arch/ uses SLIX-local
syscall numbers starting at 128 (see `slix/musl/arch/aarch64-slix
/bits/syscall.h.in`). Handlers take the raw user-space args and
return bytes-written / 0-on-success / -errno as i64, which the
dispatcher writes into the saved x0 slot.

All fd-carrying syscalls route through the per-process fd table
above; see `posix_fd_kind` / `posix_fd_target`. Socket syscalls
translate to inet-server IPC, giving musl programs direct access
to the same UDP stack that native sysl programs use via
`oskit.net.client`.

    posix_dispatch(num: int, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
        if num == 128
            return sys_write(int(a0), a1, int(a2))
        if num == 129
            terminate_current(int(a0))
            return i64(0)
        if num == 130
            return sys_read(int(a0), a1, int(a2))
        if num == 131
            return sys_accept(int(a0), a1, a2)
        if num == 135
            return sys_bind(int(a0), a1, int(a2))
        if num == 147
            return sys_close(int(a0))
        if num == 148
            return sys_connect(int(a0), a1, int(a2))
        if num == 217
            return sys_listen(int(a0), int(a1))
        if num == 276
            return sys_recvfrom(int(a0), a1, int(a2), int(a3), a4, a5)
        if num == 307
            return sys_sendto(int(a0), a1, int(a2), int(a3), a4, int(a5))
        if num == 171
            return sys_fcntl(int(a0), int(a1), int(a2))
        if num == 192
            return sys_getpeername(int(a0), a1, a2)
        if num == 203
            return sys_getsockname(int(a0), a1, a2)
        if num == 204
            return sys_getsockopt(int(a0), int(a1), int(a2), a3, a4)
        if num == 326
            return sys_setsockopt(int(a0), int(a1), int(a2), a3, int(a4))
        if num == 334
            return sys_shutdown(int(a0), int(a1))
        if num == 337
            return sys_socket(int(a0), int(a1), int(a2))
        i64(-38)            // -ENOSYS

SYS_WRITE. Looks up `fd` in the process's POSIX fd table and
dispatches by kind. STDOUT/STDERR take the direct UART fast-path
(musl output stays quick); TCP sockets chunk at
`INET_MAX_TCP_SEG=480` and loop until the full payload is
buffered. UDP sockets are rejected (use `sendto`). Any FREE slot
→ -EBADF. The user's buffer lives in the current ptbr which EL1
inherits, so pointers dereference directly without vm_copy_from.

    sys_write(fd: int, buf: i64, len: int) -> i64
        val k = posix_fd_kind(fd)
        if k == POSIX_FD_STDOUT || k == POSIX_FD_STDERR
            var p: *byte = *byte(buf)
            var i = 0
            while i < len
                uart_putc(int(p[i]))
                i += 1
            return i64(len)
        if k == POSIX_FD_TCP_SOCKET
            val inet_fd = posix_fd_target(fd)
            if inet_fd < 0
                return i64(-107)    // -ENOTCONN
            val port = inet_get_port()
            if port < 0
                return i64(-19)
            val ubuf: *byte = *byte(buf)
            var sent_total = 0
            while sent_total < len
                var chunk = len - sent_total
                if chunk > INET_MAX_TCP_SEG
                    chunk = INET_MAX_TCP_SEG
                var msg: [485]byte
                msg[0] = byte(INET_CMD_TCP_SEND)
                shim_write_u16(msg, 1, inet_fd)
                shim_write_u16(msg, 3, chunk)
                var i = 0
                while i < chunk
                    msg[5 + i] = ubuf[sent_total + i]
                    i += 1
                var reply: [3]byte
                val r = ipc_send(port, msg, 5 + chunk, reply, 3)
                if r < 0
                    if sent_total > 0
                        return i64(sent_total)
                    return i64(-5)
                if reply[0] != 0
                    if sent_total > 0
                        return i64(sent_total)
                    return i64(-32)     // -EPIPE
                val n = shim_read_u16(reply, 1)
                if n <= 0
                    // Send buffer full. Non-blocking mode reports
                    // -EAGAIN if nothing has been queued yet; other-
                    // wise return the partial count so musl can
                    // decide whether to retry.
                    if sent_total == 0
                        if (posix_fd_flags(fd) & POSIX_O_NONBLOCK) != 0
                            return i64(-11)     // -EAGAIN
                    return i64(sent_total)
                sent_total += n
            return i64(sent_total)
        i64(-9)             // -EBADF

SYS_READ. STDIN returns 0 (EOF) — no kernel-side keyboard path
yet; TTY routing is on the bridge memory's todo list. TCP sockets
block in the inet server until data arrives or peer FINs. Write-
only STDIO kinds and UDP (which should use recvfrom) are rejected.

    sys_read(fd: int, buf: i64, len: int) -> i64
        val k = posix_fd_kind(fd)
        if k == POSIX_FD_STDIN
            return i64(0)
        if k == POSIX_FD_TCP_SOCKET
            val inet_fd = posix_fd_target(fd)
            if inet_fd < 0
                return i64(-107)
            if len <= 0
                return i64(0)
            val port = inet_get_port()
            if port < 0
                return i64(-19)
            var cap_len = len
            if cap_len > INET_MAX_TCP_SEG
                cap_len = INET_MAX_TCP_SEG
            val nb = posix_fd_flags(fd) & POSIX_O_NONBLOCK
            var msg: [5]byte
            if nb != 0
                msg[0] = byte(INET_CMD_TCP_RECV_NB)
            else
                msg[0] = byte(INET_CMD_TCP_RECV)
            shim_write_u16(msg, 1, inet_fd)
            shim_write_u16(msg, 3, cap_len)
            var reply: [540]byte
            val r = ipc_send(port, msg, 5, reply, 540)
            if r < 0
                return i64(-5)
            if nb != 0
                val raw = int(reply[0]) & 0xff
                if raw != 0
                    if raw >= 128
                        return i64(raw - 256)
                    return i64(raw)
            if reply[0] != 0
                return i64(-5)
            val rlen = shim_read_u16(reply, 1)
            val ubuf: *byte = *byte(buf)
            var i = 0
            while i < rlen
                ubuf[i] = reply[3 + i]
                i += 1
            return i64(rlen)
        i64(-9)             // -EBADF

SYS_CLOSE. For socket kinds, tell the inet server to drop the
backend record; the fd slot is cleared either way so a subsequent
op returns -EBADF. Pre-connect / pre-listen TCP sockets (target
still -1) skip the inet call — no backend was ever allocated.

    sys_close(fd: int) -> i64
        val k = posix_fd_kind(fd)
        if k == POSIX_FD_FREE
            return i64(-9)  // -EBADF
        if k == POSIX_FD_UDP_SOCKET
            val inet_fd = posix_fd_target(fd)
            val port = inet_get_port()
            if port >= 0
                var msg: [2]byte
                msg[0] = byte(INET_CMD_CLOSE)
                msg[1] = byte(inet_fd & 0xff)
                var reply: [1]byte
                ipc_send(port, msg, 2, reply, 1)
        if k == POSIX_FD_TCP_SOCKET
            val inet_fd = posix_fd_target(fd)
            if inet_fd >= 0
                val port = inet_get_port()
                if port >= 0
                    var msg: [3]byte
                    msg[0] = byte(INET_CMD_TCP_CLOSE)
                    shim_write_u16(msg, 1, inet_fd)
                    var reply: [1]byte
                    ipc_send(port, msg, 3, reply, 1)
        posix_fd_clear(fd)
        i64(0)

SYS_SOCKET. Supports AF_INET + SOCK_DGRAM/SOCK_STREAM. Datagram
sockets eagerly ask inet for a UDP slot. Stream sockets return an
unconnected POSIX fd (target = -1); the inet-side socket is
allocated lazily by `sys_connect` or `sys_listen` so we don't have
to map a "pre-connect" state into the inet protocol.

    sys_socket(family: int, stype: int, proto: int) -> i64
        if family != POSIX_AF_INET
            return i64(-97)     // -EAFNOSUPPORT
        if stype == POSIX_SOCK_DGRAM
            val port = inet_get_port()
            if port < 0
                return i64(-19)     // -ENODEV
            var msg: [4]byte
            msg[0] = byte(INET_CMD_SOCKET)
            msg[1] = byte(family & 0xff)
            msg[2] = byte(stype & 0xff)
            msg[3] = byte(proto & 0xff)
            var reply: [2]byte
            val r = ipc_send(port, msg, 4, reply, 2)
            if r < 0
                return i64(-5)      // -EIO
            if reply[0] != 0
                return i64(-5)
            val inet_fd = int(reply[1]) & 0xff
            val posix_fd = posix_fd_alloc(POSIX_FD_UDP_SOCKET, inet_fd)
            if posix_fd < 0
                var close_msg: [2]byte
                close_msg[0] = byte(INET_CMD_CLOSE)
                close_msg[1] = byte(inet_fd & 0xff)
                var close_rep: [1]byte
                ipc_send(port, close_msg, 2, close_rep, 1)
                return i64(-24)     // -EMFILE
            return i64(posix_fd)
        if stype == POSIX_SOCK_STREAM
            val posix_fd = posix_fd_alloc(POSIX_FD_TCP_SOCKET, -1)
            if posix_fd < 0
                return i64(-24)
            return i64(posix_fd)
        i64(-93)                    // -EPROTONOSUPPORT

SYS_BIND. For UDP sockets, forward to inet's BIND. For TCP
sockets, stash the bound port in `slot.pos` so a subsequent
`listen()` can use it — inet allocates the actual listen slot
lazily in `sys_listen`. The user's `sockaddr_in` is 16 bytes:
family(2), port(2, BE), addr(4), zero(8).

    sys_bind(fd: int, addr_ptr: i64, addrlen: int) -> i64
        val k = posix_fd_kind(fd)
        if addrlen < 16
            return i64(-22)
        val a: *byte = *byte(addr_ptr)
        val sin_port = shim_read_u16(a, 2)
        if k == POSIX_FD_TCP_SOCKET
            val pid = posix_fd_current_pid()
            posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].pos = i64(sin_port)
            return i64(0)
        if k != POSIX_FD_UDP_SOCKET
            return i64(-9)
        val inet_fd = posix_fd_target(fd)
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        var msg: [9]byte
        msg[0] = byte(INET_CMD_BIND)
        msg[1] = byte(inet_fd & 0xff)
        msg[2] = byte(POSIX_AF_INET)
        msg[3] = byte(sin_port >> 8)
        msg[4] = byte(sin_port & 0xff)
        msg[5] = a[4]
        msg[6] = a[5]
        msg[7] = a[6]
        msg[8] = a[7]
        var reply: [1]byte
        val r = ipc_send(port, msg, 9, reply, 1)
        if r < 0
            return i64(-5)
        if reply[0] != 0
            return i64(-98)     // -EADDRINUSE
        i64(0)

SYS_SENDTO. Args: (fd, buf, len, flags, dst_addr, addrlen).
Copies the payload into an in-kernel staging buffer (avoids
re-reading user memory during ipc_deliver's cross-PT walk) and
forwards to the inet server. `flags` is ignored for v1.

    sys_sendto(fd: int, buf: i64, len: int, flags: int, addr_ptr: i64, addrlen: int) -> i64
        if posix_fd_kind(fd) != POSIX_FD_UDP_SOCKET
            return i64(-9)
        if addrlen < 16
            return i64(-22)
        if len < 0
            return i64(-22)
        if len > 512
            return i64(-90)     // -EMSGSIZE
        val inet_fd = posix_fd_target(fd)
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        val a: *byte = *byte(addr_ptr)
        val dst_port = shim_read_u16(a, 2)
        val ubuf: *byte = *byte(buf)
        var msg: [523]byte
        msg[0] = byte(INET_CMD_SENDTO)
        msg[1] = byte(inet_fd & 0xff)
        msg[2] = byte(POSIX_AF_INET)
        msg[3] = byte(dst_port >> 8)
        msg[4] = byte(dst_port & 0xff)
        msg[5] = a[4]
        msg[6] = a[5]
        msg[7] = a[6]
        msg[8] = a[7]
        msg[9] = byte((len >> 8) & 0xff)
        msg[10] = byte(len & 0xff)
        var i = 0
        while i < len
            msg[11 + i] = ubuf[i]
            i += 1
        var reply: [3]byte
        val r = ipc_send(port, msg, 11 + len, reply, 3)
        if r < 0
            return i64(-5)
        if reply[0] != 0
            return i64(-101)    // -ENETUNREACH
        i64(shim_read_u16(reply, 1))

SYS_RECVFROM. Args: (fd, buf, len, flags, src_addr, addrlen_ptr).
Blocks until a datagram is available. Writes the source's family
+ port + addr into `src_addr` (16-byte sockaddr_in) if non-null,
updates `*addrlen_ptr` to 16, and copies the payload into `buf`.

    sys_recvfrom(fd: int, buf: i64, len: int, flags: int, addr_ptr: i64, addrlen_ptr: i64) -> i64
        if posix_fd_kind(fd) != POSIX_FD_UDP_SOCKET
            return i64(-9)
        if len < 0
            return i64(-22)
        val inet_fd = posix_fd_target(fd)
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        var cap_len = len
        if cap_len > 512
            cap_len = 512
        val nonblock = posix_fd_flags(fd) & POSIX_O_NONBLOCK
        var reply: [540]byte
        if nonblock != 0
            // Non-blocking: reuse RECVFROM_TIMEOUT with a zero
            // timeout — the inet handler will reply with status=1
            // (no data) immediately if the queue is empty.
            var nmsg: [8]byte
            nmsg[0] = byte(INET_CMD_RECVFROM_TIMEOUT)
            nmsg[1] = byte(inet_fd & 0xff)
            nmsg[2] = byte((cap_len >> 8) & 0xff)
            nmsg[3] = byte(cap_len & 0xff)
            nmsg[4] = byte(0)
            nmsg[5] = byte(0)
            nmsg[6] = byte(0)
            nmsg[7] = byte(0)
            val nr = ipc_send(port, nmsg, 8, reply, 540)
            if nr < 0
                return i64(-5)
            if reply[0] == byte(1)
                return i64(-11)         // -EAGAIN
            if reply[0] != 0
                return i64(-5)
        else
            var msg: [4]byte
            msg[0] = byte(INET_CMD_RECVFROM)
            msg[1] = byte(inet_fd & 0xff)
            msg[2] = byte((cap_len >> 8) & 0xff)
            msg[3] = byte(cap_len & 0xff)
            val r = ipc_send(port, msg, 4, reply, 540)
            if r < 0
                return i64(-5)
            if reply[0] != 0
                return i64(-5)
        val src_port = shim_read_u16(reply, 2)
        val payload_len = shim_read_u16(reply, 8)
        if addr_ptr != i64(0)
            val a: *byte = *byte(addr_ptr)
            a[0] = byte(POSIX_AF_INET & 0xff)
            a[1] = byte((POSIX_AF_INET >> 8) & 0xff)
            a[2] = byte(src_port >> 8)
            a[3] = byte(src_port & 0xff)
            a[4] = reply[4]
            a[5] = reply[5]
            a[6] = reply[6]
            a[7] = reply[7]
            var z = 8
            while z < 16
                a[z] = byte(0)
                z += 1
        if addrlen_ptr != i64(0)
            val alp: *i32 = *i32(addrlen_ptr)
            *alp = i32(16)
        val ubuf: *byte = *byte(buf)
        var copy_len = payload_len
        if copy_len > len
            copy_len = len
        var i = 0
        while i < copy_len
            ubuf[i] = reply[10 + i]
            i += 1
        i64(copy_len)

SYS_CONNECT. TCP active open. Issues `INET_CMD_TCP_CONNECT` which
parks the caller until ESTABLISHED; on success the inet server
replies with its socket id. We stash that id as the slot's backend
target so subsequent read/write/close route to the right TCP
record. The user's sockaddr_in gives dst_ip (4 bytes) and
dst_port (BE u16) at the usual offsets.

    sys_connect(fd: int, addr_ptr: i64, addrlen: int) -> i64
        if posix_fd_kind(fd) != POSIX_FD_TCP_SOCKET
            return i64(-9)
        if addrlen < 16
            return i64(-22)
        if posix_fd_target(fd) >= 0
            return i64(-56)             // -EISCONN
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        val a: *byte = *byte(addr_ptr)
        var msg: [7]byte
        msg[0] = byte(INET_CMD_TCP_CONNECT)
        msg[1] = a[4]
        msg[2] = a[5]
        msg[3] = a[6]
        msg[4] = a[7]
        msg[5] = a[2]                   // sin_port high byte (already BE)
        msg[6] = a[3]                   // sin_port low byte
        var reply: [2]byte
        val r = ipc_send(port, msg, 7, reply, 2)
        if r < 0
            return i64(-5)
        if reply[0] != 0
            return i64(-111)            // -ECONNREFUSED
        val inet_fd = int(reply[1]) & 0xff
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].target = inet_fd
        i64(0)

SYS_LISTEN. Requires a prior bind() to have set the local port in
`slot.pos`. Forwards to `INET_CMD_TCP_LISTEN` and stashes the
returned listen fd as the backend target. `backlog` is advisory —
inet uses a fixed `TCP_LISTEN_BACKLOG` internally.

    sys_listen(fd: int, backlog: int) -> i64
        if posix_fd_kind(fd) != POSIX_FD_TCP_SOCKET
            return i64(-9)
        if posix_fd_target(fd) >= 0
            return i64(-22)             // already listening or connected
        val pid = posix_fd_current_pid()
        val local_port = int(posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].pos)
        if local_port <= 0
            return i64(-22)             // -EINVAL — must bind first
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        var msg: [3]byte
        msg[0] = byte(INET_CMD_TCP_LISTEN)
        shim_write_u16(msg, 1, local_port)
        var reply: [2]byte
        val r = ipc_send(port, msg, 3, reply, 2)
        if r < 0
            return i64(-5)
        if reply[0] != 0
            return i64(-98)             // -EADDRINUSE
        val listen_fd = int(reply[1]) & 0xff
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].target = listen_fd
        i64(0)

SYS_ACCEPT. Blocks until a child connection arrives. inet replies
with the child's socket id + peer's ip/port; we allocate a fresh
POSIX slot for the child, populate `*addr` with the peer's
sockaddr_in (if non-null), and return the new POSIX fd. Inet may
also send data + FIN before accept returns, so the child can be in
CLOSE_WAIT on arrival — read/close paths handle that already.

    sys_accept(fd: int, addr_ptr: i64, addrlen_ptr: i64) -> i64
        if posix_fd_kind(fd) != POSIX_FD_TCP_SOCKET
            return i64(-9)
        val listen_fd = posix_fd_target(fd)
        if listen_fd < 0
            return i64(-22)
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        var msg: [3]byte
        msg[0] = byte(INET_CMD_TCP_ACCEPT)
        shim_write_u16(msg, 1, listen_fd)
        var reply: [8]byte
        val r = ipc_send(port, msg, 3, reply, 8)
        if r < 0
            return i64(-5)
        if reply[0] != 0
            return i64(-5)
        val child_inet_fd = int(reply[1]) & 0xff
        val peer_port = shim_read_u16(reply, 6)
        if addr_ptr != i64(0)
            val a: *byte = *byte(addr_ptr)
            a[0] = byte(POSIX_AF_INET & 0xff)
            a[1] = byte(0)
            a[2] = byte(peer_port >> 8)
            a[3] = byte(peer_port & 0xff)
            a[4] = reply[2]
            a[5] = reply[3]
            a[6] = reply[4]
            a[7] = reply[5]
            var z = 8
            while z < 16
                a[z] = byte(0)
                z += 1
        if addrlen_ptr != i64(0)
            val alp: *i32 = *i32(addrlen_ptr)
            *alp = i32(16)
        val new_fd = posix_fd_alloc(POSIX_FD_TCP_SOCKET, child_inet_fd)
        if new_fd < 0
            var close_msg: [3]byte
            close_msg[0] = byte(INET_CMD_TCP_CLOSE)
            shim_write_u16(close_msg, 1, child_inet_fd)
            var close_rep: [1]byte
            ipc_send(port, close_msg, 3, close_rep, 1)
            return i64(-24)             // -EMFILE
        i64(new_fd)

SYS_SHUTDOWN. MVP implementation: no-op returning success. Proper
half-close (SHUT_WR sends FIN while leaving reads open) requires
a dedicated inet IPC op that phase 2 doesn't land; programs that
depend on peer seeing EOF without our close() will hang until we
do. Documented in the phase-2 handoff memory.

    sys_shutdown(fd: int, how: int) -> i64
        val k = posix_fd_kind(fd)
        if k != POSIX_FD_TCP_SOCKET
            return i64(-9)
        val inet_fd = posix_fd_target(fd)
        if inet_fd < 0
            return i64(-107)            // -ENOTCONN
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        var msg: [4]byte
        msg[0] = byte(INET_CMD_TCP_SHUTDOWN)
        shim_write_u16(msg, 1, inet_fd)
        msg[3] = byte(how & 0xff)
        var reply: [1]byte
        val r = ipc_send(port, msg, 4, reply, 1)
        if r < 0
            return i64(-5)
        if reply[0] != 0
            return i64(-5)
        i64(0)

SYS_SETSOCKOPT / SYS_GETSOCKOPT. Accept-and-ignore MVP: the inet
server doesn't track per-socket options today, so we accept the
handful of `(level, optname)` pairs that real programs reflexively
call before doing anything (DHCP clients setting SO_BROADCAST, TCP
servers setting SO_REUSEADDR, latency-sensitive clients toggling
TCP_NODELAY) and return success without any side effect. Anything
outside the accept-list returns `-ENOPROTOOPT` so genuine
misconfiguration still surfaces.

Linux `SOL_SOCKET = 1`; `SO_REUSEADDR = 2`, `SO_ERROR = 4`,
`SO_BROADCAST = 6`, `SO_KEEPALIVE = 9`, `SO_REUSEPORT = 15`.
`IPPROTO_TCP = 6`; `TCP_NODELAY = 1`.

    sys_setsockopt(fd: int, level: int, optname: int, optval: i64, optlen: int) -> i64
        val k = posix_fd_kind(fd)
        if k != POSIX_FD_UDP_SOCKET
            if k != POSIX_FD_TCP_SOCKET
                return i64(-9)          // -EBADF
        if level == 1
            if optname == 2
                return i64(0)
            if optname == 6
                return i64(0)
            if optname == 9
                return i64(0)
            if optname == 15
                return i64(0)
        if level == 6
            if optname == 1
                return i64(0)
        i64(-92)                        // -ENOPROTOOPT

`val` is a pointer to the option buffer; `len_ptr` points at an
i32 that the caller seeded with the buffer capacity. We write 0
into the first 4 bytes (every option we support is an int-sized
boolean/integer and we never actually track its state) and set
`*len_ptr = 4`. `-ENOPROTOOPT` is returned for anything outside
the accept-list (same set as setsockopt); the option buffer is
left untouched in that case.

    sys_getsockopt(fd: int, level: int, optname: int, optval: i64, len_ptr: i64) -> i64
        val k = posix_fd_kind(fd)
        if k != POSIX_FD_UDP_SOCKET
            if k != POSIX_FD_TCP_SOCKET
                return i64(-9)          // -EBADF
        var accept = 0
        if level == 1
            if optname == 2
                accept = 1
            if optname == 4
                accept = 1
            if optname == 6
                accept = 1
            if optname == 9
                accept = 1
            if optname == 15
                accept = 1
        if level == 6
            if optname == 1
                accept = 1
        if accept == 0
            return i64(-92)             // -ENOPROTOOPT
        if len_ptr == i64(0)
            return i64(-14)             // -EFAULT
        val lp: *i32 = *i32(len_ptr)
        val cap = int(*lp)
        if cap < 4
            return i64(-22)             // -EINVAL
        if optval == i64(0)
            return i64(-14)
        val vp: *i32 = *i32(optval)
        *vp = i32(0)
        *lp = i32(4)
        i64(0)

SYS_GETSOCKNAME / SYS_GETPEERNAME. Both return a 16-byte
`sockaddr_in` at `addr_ptr` and write the length (always 16)
into `*addrlen_ptr`. For UDP: getsockname reports the bound
endpoint (or 0.0.0.0:0 if unbound); getpeername short-circuits
with -ENOTCONN since we don't support connected UDP. For TCP:
both flavours ask the inet server via INET_CMD_TCP_GETNAME and
relay its status byte. Unallocated TCP sockets (no inet-side
slot yet — e.g. right after socket(SOCK_STREAM) before
connect/listen) report `0.0.0.0:0` for getsockname and
-ENOTCONN for getpeername.

Shared helper that drives the actual IPC + sockaddr formatting;
the two entry points differ only in "which" flag and in UDP's
peer short-circuit.

    shim_write_sockaddr(addr_ptr: i64, port: int, ip_octets: *byte)
        if addr_ptr == i64(0)
            return
        val a: *byte = *byte(addr_ptr)
        a[0] = byte(POSIX_AF_INET & 0xff)
        a[1] = byte(0)
        a[2] = byte(port >> 8)
        a[3] = byte(port & 0xff)
        a[4] = ip_octets[0]
        a[5] = ip_octets[1]
        a[6] = ip_octets[2]
        a[7] = ip_octets[3]
        var z = 8
        while z < 16
            a[z] = byte(0)
            z += 1

    shim_write_addrlen(addrlen_ptr: i64, n: int)
        if addrlen_ptr == i64(0)
            return
        val alp: *i32 = *i32(addrlen_ptr)
        *alp = i32(n)

    sys_getsockname(fd: int, addr_ptr: i64, addrlen_ptr: i64) -> i64
        val k = posix_fd_kind(fd)
        if k == POSIX_FD_UDP_SOCKET
            val inet_fd = posix_fd_target(fd)
            if inet_fd < 0
                return i64(-9)
            val port = inet_get_port()
            if port < 0
                return i64(-19)
            var msg: [2]byte
            msg[0] = byte(INET_CMD_UDP_GETNAME)
            msg[1] = byte(inet_fd & 0xff)
            var reply: [7]byte
            val r = ipc_send(port, msg, 2, reply, 7)
            if r < 0
                return i64(-5)
            if reply[0] != 0
                return i64(-5)
            val p = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
            shim_write_sockaddr(addr_ptr, p, &reply[3])
            shim_write_addrlen(addrlen_ptr, 16)
            return i64(0)
        if k == POSIX_FD_TCP_SOCKET
            val tcp_fd = posix_fd_target(fd)
            if tcp_fd < 0
                // Unallocated TCP socket → 0.0.0.0:0 for getsockname.
                var zero: [4]byte
                zero[0] = byte(0)
                zero[1] = byte(0)
                zero[2] = byte(0)
                zero[3] = byte(0)
                shim_write_sockaddr(addr_ptr, 0, &zero[0])
                shim_write_addrlen(addrlen_ptr, 16)
                return i64(0)
            val port = inet_get_port()
            if port < 0
                return i64(-19)
            var msg: [4]byte
            msg[0] = byte(INET_CMD_TCP_GETNAME)
            shim_write_u16(msg, 1, tcp_fd)
            msg[3] = byte(0)               // which=0 → local
            var reply: [7]byte
            val r = ipc_send(port, msg, 4, reply, 7)
            if r < 0
                return i64(-5)
            val raw = int(reply[0]) & 0xff
            if raw != 0
                if raw >= 128
                    return i64(raw - 256)
                return i64(raw)
            val p = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
            shim_write_sockaddr(addr_ptr, p, &reply[3])
            shim_write_addrlen(addrlen_ptr, 16)
            return i64(0)
        i64(-9)                             // -EBADF

    sys_getpeername(fd: int, addr_ptr: i64, addrlen_ptr: i64) -> i64
        val k = posix_fd_kind(fd)
        if k == POSIX_FD_UDP_SOCKET
            return i64(-107)               // -ENOTCONN (no connected UDP)
        if k != POSIX_FD_TCP_SOCKET
            return i64(-9)
        val tcp_fd = posix_fd_target(fd)
        if tcp_fd < 0
            return i64(-107)
        val port = inet_get_port()
        if port < 0
            return i64(-19)
        var msg: [4]byte
        msg[0] = byte(INET_CMD_TCP_GETNAME)
        shim_write_u16(msg, 1, tcp_fd)
        msg[3] = byte(1)                   // which=1 → peer
        var reply: [7]byte
        val r = ipc_send(port, msg, 4, reply, 7)
        if r < 0
            return i64(-5)
        val status = i8(reply[0])
        if int(status) != 0
            return i64(int(status))
        val p = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
        shim_write_sockaddr(addr_ptr, p, &reply[3])
        shim_write_addrlen(addrlen_ptr, 16)
        i64(0)

SYS_FCNTL. MVP dispatch for the handful of cmd codes musl programs
actually exercise before doing I/O:

- `F_GETFL` (3): return the slot's stored flags. Only O_NONBLOCK is
  meaningful today; other bits echo back whatever was set so
  `getfl | O_NONBLOCK` round-trips cleanly.
- `F_SETFL` (4): store `arg & O_NONBLOCK` in the slot. We mask so
  the shim can't be tricked into remembering unsupported flags and
  acting surprisingly later.
- `F_GETFD` (1) / `F_SETFD` (2): file-descriptor flags (mainly
  FD_CLOEXEC). SLIX has no `exec` yet, so CLOEXEC is a no-op.
  GETFD returns 0; SETFD accepts any value and returns 0. The
  day an exec path lands, this is the place to start tracking.
- `F_DUPFD` (0): not implemented — socket dup requires a separate
  fd-aliasing design (see POSIX-fd-bridge memory). Returns -EINVAL.

Unknown command → -EINVAL so real misuse surfaces.

    sys_fcntl(fd: int, cmd: int, arg: int) -> i64
        val k = posix_fd_kind(fd)
        if k == POSIX_FD_FREE
            return i64(-9)              // -EBADF
        if cmd == POSIX_F_GETFL
            return i64(posix_fd_flags(fd))
        if cmd == POSIX_F_SETFL
            posix_fd_set_flags(fd, arg & POSIX_O_NONBLOCK)
            return i64(0)
        if cmd == POSIX_F_GETFD
            return i64(0)
        if cmd == POSIX_F_SETFD
            return i64(0)
        if cmd == POSIX_F_DUPFD
            return i64(-22)             // -EINVAL (no dup yet)
        i64(-22)

Kernel-thread entries for the kernel-integrated demo. kentry_a
is the echo server: creates a port, registers "echo", then
loops on ipc_recv and echoes each message back. kentry_b is
the client: yields once so A registers, looks up "echo", sends
a handful of messages, and prints each reply before wfi-ing out.

    var kt_reply_buf: [32]byte
    var kt_send_buf:  [32]byte

    kentry_a()
        uart_puts("[kern A] starting echo server\n")
        val port = port_create()
        if port < 0
            uart_puts("[kern A] port_create failed\n")
            while true
                arch_wfi()
        val reg = port_register(port, "echo")
        if reg < 0
            uart_puts("[kern A] port_register failed\n")
            while true
                arch_wfi()
        uart_puts("[kern A] echo server ready on port ")
        uart_puthex(u64(port))
        uart_puts("\n")
        while true
            val sender = ipc_recv(port, *byte(kt_reply_buf), 32)
            if sender < 0
                uart_puts("[kern A] ipc_recv failed\n")
                arch_wfi()
            else
                uart_puts("[kern A] got msg from tid=")
                uart_puthex(u64(sender))
                uart_puts("\n")
                ipc_reply(sender, *byte(kt_reply_buf), 1)

    kentry_b()
        yield()
        uart_puts("[kern B] looking up echo\n")
        val port = port_lookup("echo")
        if port < 0
            uart_puts("[kern B] port_lookup failed\n")
            while true
                arch_wfi()
        uart_puts("[kern B] found port ")
        uart_puthex(u64(port))
        uart_puts("\n")
        var seq = 0
        while seq < 3
            kt_send_buf[0] = byte('A' + seq)
            val r = ipc_send(port, *byte(kt_send_buf), 1,
                *byte(kt_reply_buf), 1)
            uart_puts("[kern B] reply=")
            uart_putc(int(kt_reply_buf[0]))
            uart_puts(" r=")
            uart_puthex(u64(r))
            uart_puts("\n")
            seq += 1
        while true
            arch_wfi()

Walk the 32 virtio-mmio slots QEMU virt exposes and print a
one-line summary of every present device. Diagnostic only; the
net driver's real init runs in `virtio_net_bringup` below.

    virtio_probe()
        var i = 0
        var found = 0
        while i < VIRTIO_MMIO_MAX
            val base: i64 = VIRTIO_MMIO_BASE + i64(i) * VIRTIO_MMIO_STRIDE
            if virtio_present(base) != 0
                val dev = virtio_device_id(base)
                if dev != 0
                    uart_puts("virtio: slot @ ")
                    uart_puthex(base)
                    uart_puts(" dev=")
                    uart_puthex(i64(dev))
                    if dev == VIRTIO_DEV_NET
                        uart_puts(" (net)")
                    uart_puts("\n")
                    found += 1
            i += 1
        if found == 0
            uart_puts("virtio: no devices\n")

    kernel_main()
        uart_puts("SLIX aarch64 boot (sysl, MMU on)\n")
        uart_puts("Hello, aarch64!\n")

        uart_puts("kernel_ptbr=")
        uart_puthex(kernel_ptbr())
        uart_puts("\n")

        virtio_probe()

        if DEMO_MODE == 0
            kernel_main_kern()
        else if DEMO_MODE == 1
            kernel_main_kt()
        else if DEMO_MODE == 3
            kernel_main_user()
        else if DEMO_MODE == 4
            kernel_main_user_ipc()
        else if DEMO_MODE == 5
            kernel_main_rs()
        else
            kernel_main_el0()

Kernel-integrated boot path. Uses the shared oskit/kernel scheduler,
create_thread, and first_thread_ssp. The timer IRQ routes through
the real schedule(), which picks the next thread from the run
queue. Both kernel threads print on every scheduler pass.

    kernel_main_kern()
        uart_puts("[kern] kernel_init...\n")
        kernel_init()
        ipc_init()

        uart_puts("[kern] creating threads\n")
        create_thread(i64(&kentry_a), kernel_stack_usp(0),
            kernel_stack_ssp(0), "kA")
        create_thread(i64(&kentry_b), kernel_stack_usp(1),
            kernel_stack_ssp(1), "kB")

        gic_init()
        timer_init_periodic(cntfrq_el0() / u64(100))
        uart_puts("[kern] gic + timer initialised\n")

        arch_cli()
        val first = first_thread_ssp()
        if first == i64(0)
            uart_puts("[kern] first_thread_ssp returned 0\n")
            abort()
        uart_puts("[kern] resuming first thread\n")
        arch_resume_process(first)
        uart_puts("unexpected return from arch_resume_process\n")

Ad-hoc two-thread demo (no kernel dependency). Used as a smoke
test for the context-switch asm.

    kernel_main_kt()
        uart_puts("[kt] initialising two kernel threads\n")
        kt_init(0, i64(&kthread_a))
        kt_init(1, i64(&kthread_b))
        kt_active = 2

        gic_init()
        timer_init_periodic(cntfrq_el0() / u64(100))
        uart_puts("gic + timer initialised\n")

        arch_cli()
        kt_current = 0
        uart_puts("[kt] resuming thread 0\n")
        arch_resume_process(kt_ssp[0])
        uart_puts("unexpected return from arch_resume_process\n")

User-process demo (DEMO_MODE=3). Loads the embedded user program
(compiled from oskit/bin/<USER_PROG>.lsysl via build_prog.sh,
copied to user_prog.bin, embedded as _binary_user_prog_bin_*
symbols by objcopy -I binary) into a fresh process page table
and resumes. Default USER_PROG=test_putc calls putc('O'),
putc('K'), putc('\n'), exit() — so we expect "OK\n" on the UART
then a clean halt. Other USER_PROG binaries plug in here.

DEMO_MODE=4 is the same idea plus a kernel-thread echo server
(kentry_a) spawned first, so the user program can validate
cross-address-space IPC by doing port_lookup("echo") + ipc_send.

User binaries no longer live inside the kernel ELF. Instead the
build packs them into bootinfo.img (see MakeAarch64BootInfoMain),
which QEMU loads at BOOT_INFO_PA via `-device loader,file=...,
addr=0x44000000`. The kernel parses the SLIX header on demand and
copies the requested module's payload into the new process.

    val BOOT_INFO_PA: u64 = u64(0x44000000)

Little-endian readers — boot info uses the same encoding as x86.

    bi_read_u32(p: *byte) -> i64
        i64(p[0] & 0xff) | (i64(p[1] & 0xff) << 8) | (i64(p[2] & 0xff) << 16) | (i64(p[3] & 0xff) << 24)

    bi_read_i64(p: *byte) -> i64
        bi_read_u32(p) | (bi_read_u32(p + 4) << 32)

Validate magic + return module count; -1 if header is bad.

    bi_module_count() -> int
        var p: *byte = *byte(BOOT_INFO_PA)
        if p[0] != byte('S')
            return -1
        if p[1] != byte('L')
            return -1
        if p[2] != byte('I')
            return -1
        if p[3] != byte('X')
            return -1
        int(bi_read_u32(p + 4))

Look up a module by name. Returns physical addr (0 if not found)
and writes the size to *size_out.

    bi_find(name: string, size_out: *int) -> i64
        val count = bi_module_count()
        if count < 0
            return i64(0)
        val nb: *byte = *byte(name)
        val nl = len(name)
        var i = 0
        while i < count
            val entry: *byte = *byte(BOOT_INFO_PA + u64(8 + i * 24))
            // Compare name (NUL-padded to 8)
            var j = 0
            var matched = true
            while j < nl && j < 8
                if entry[j] != nb[j]
                    matched = false
                    break
                j += 1
            if matched
                if nl < 8 && entry[nl] != 0
                    matched = false
            if matched
                val off = bi_read_i64(entry + 8)
                val sz  = bi_read_i64(entry + 16)
                *size_out = int(sz)
                return i64(BOOT_INFO_PA) + off
            i += 1
        i64(0)

SYS_PUTC handler: write a single byte to the PL011 UART. Registered
into syscall_table so user programs can print via ulib.putc().

    sys_putc_handler(arg: int)
        uart_putc(arg & 0xFF)
        syscall_return(i64(0))


SYS_PUTS handler: write a whole buffer to the PL011 UART in one
syscall. Callers pack the args as `[buf_ptr(i64), len(i64)]` and
pass the array's address. The handler loops in kernel context,
saving N-1 user/kernel transitions compared to SYS_PUTC × N.

Used by the TTY server's `tty_handle_puts` so every string that
reaches the UART via VFS → TTY does one syscall instead of one
per byte. That collapses `puts("foo")` from 3 syscalls on the
TTY side to 1, and brings the per-`puts`-call overhead back
down to IPC-and-grant latency instead of `O(N bytes)`.

Because we're running at EL1 on the caller's PTBR (TTY's), the
caller-side `buf_ptr` is already accessible directly — no
copy-in needed.

    sys_puts_handler(arg: int)
        var args: *i64 = *i64(i64(arg))
        val buf = *byte(args[0])
        val len = int(args[1])
        var i = 0
        while i < len
            uart_putc(int(buf[i]) & 0xFF)
            i += 1
        syscall_return(i64(0))

Load `len` bytes from `src` into the process's user code region,
walking its L3 entries so the binary spans multiple 4KB pages.
VA 0x60000000..0x6000FFFF is identity-mapped in the user PT from
vm_create_process_pt; since we're still under the kernel PTBR when
this runs we reach each physical page directly.

    user_load_program(ptbr: u64, src_va: i64, len: int)
        // src_va points at the kernel-side blob; iterate one byte
        // at a time walking the user PT to find each destination
        // physical address. Slow but simple; replace with a stride-
        // per-page memcpy once we have a real block copy.
        var i = 0
        while i < len
            val user_va = u64(0x60000000) + u64(i)
            val dst_pa = vm_v2p(ptbr, user_va)
            if dst_pa == u64(0)
                uart_puts("[user] load: unmapped VA at offset ")
                uart_puthex(u64(i))
                uart_puts("\n")
                abort()
            var dst: *byte = *byte(dst_pa)
            var sp: *byte = *byte(src_va + i64(i))
            dst[0] = sp[0]
            i += 1

Flush the I-cache for every line covering `len` bytes starting at
the user code region's first physical page. We walk the L3 entries
again to get each page's PA, then clean + invalidate one cache
line per 64 bytes of code.

    user_sync_icache(ptbr: u64, len: int)
        var off = 0
        while off < len
            val user_va = u64(0x60000000) + u64(off)
            val pa = vm_v2p(ptbr, user_va)
            if pa != u64(0)
                sync_icache_line(i64(pa))
            off += 64

    kernel_main_user()
        uart_puts("[user] kernel_init...\n")
        kernel_init()
        ipc_init()
        register_syscall(1, sys_putc_handler)
        register_syscall(82, sys_puts_handler)

        uart_puts("[user] creating process PT\n")
        val new_pt = vm_create_process_pt()
        if new_pt == 0
            uart_puts("[user] vm_create_process_pt failed\n")
            abort()

        var blob_len = 0
        val blob_start = bi_find("user", &blob_len)
        if blob_start == i64(0) || blob_len <= 0
            uart_puts("[user] boot module 'user' not found\n")
            abort()
        uart_puts("[user] loading user blob=")
        uart_puthex(u64(blob_start))
        uart_puts(" len=")
        uart_puthex(u64(blob_len))
        uart_puts("\n")

        user_load_program(new_pt, blob_start, blob_len)
        user_sync_icache(new_pt, blob_len)

        // Build a minimal argc=0 System V init stack (40 bytes →
        // 48 for 16-byte alignment, all zeros) so the user program's
        // `_start` (which reads argc from [sp]) sees a valid empty
        // frame instead of whatever lives at PROG_USP.
        var user_stack_buf: [48]byte
        memset(&user_stack_buf[0], 0, 48)
        val user_sp = i64(PROG_USP) - 48
        vm_copy_to(new_pt, u64(user_sp), user_stack_buf, 48)

        val pid = create_process_suspended(
            i64(0x60000000), user_sp, i64(PROG_SSP),
            "user1", new_pt)
        if pid <= 0
            uart_puts("[user] create_process_suspended failed pid=")
            uart_puthex(u64(pid))
            uart_puts("\n")
            abort()
        uart_puts("[user] created pid=")
        uart_puthex(u64(pid))
        uart_puts("\n")

        resume_process(pid)

        gic_init()
        timer_init_periodic(cntfrq_el0() / u64(100))
        uart_puts("[user] gic + timer initialised\n")

        arch_cli()
        val first = first_thread_ssp()
        if first == i64(0)
            uart_puts("[user] no ready thread\n")
            abort()
        uart_puts("[user] resuming first thread\n")
        arch_resume_process(first)

Cross-AS IPC demo (DEMO_MODE=4). Spawns kentry_a as a kernel-
thread echo server, then loads the embedded user program into
its own page table and resumes. If USER_PROG is a test that
does port_lookup("echo") + ipc_send, this round-trips a message
from the user process (its own PTBR) through the kernel's IPC
machinery to kentry_a (kernel PTBR) and back. Validates
ipc_deliver's cross-address-space vm_copy_cross path plus
ipc_write_saved_r1 / syscall_return_for PTBR-awareness.

    kernel_main_user_ipc()
        uart_puts("[uipc] kernel_init...\n")
        kernel_init()
        ipc_init()
        register_syscall(1, sys_putc_handler)
        register_syscall(82, sys_puts_handler)

        uart_puts("[uipc] creating echo server thread\n")
        create_thread(i64(&kentry_a), kernel_stack_usp(0),
            kernel_stack_ssp(0), "kA")

        uart_puts("[uipc] creating process PT\n")
        val new_pt = vm_create_process_pt()
        if new_pt == 0
            uart_puts("[uipc] vm_create_process_pt failed\n")
            abort()

        var blob_len = 0
        val blob_start = bi_find("user", &blob_len)
        if blob_start == i64(0) || blob_len <= 0
            uart_puts("[uipc] boot module 'user' not found\n")
            abort()
        uart_puts("[uipc] loading user_prog len=")
        uart_puthex(u64(blob_len))
        uart_puts("\n")

        user_load_program(new_pt, blob_start, blob_len)
        user_sync_icache(new_pt, blob_len)

        // argc=0 SysV frame — see comment on the same pattern in
        // kernel_main_user_process above.
        var uipc_stack_buf: [48]byte
        memset(&uipc_stack_buf[0], 0, 48)
        val uipc_sp = i64(PROG_USP) - 48
        vm_copy_to(new_pt, u64(uipc_sp), uipc_stack_buf, 48)

        val pid = create_process_suspended(
            i64(0x60000000), uipc_sp, i64(PROG_SSP),
            "user1", new_pt)
        if pid <= 0
            uart_puts("[uipc] create_process_suspended failed\n")
            abort()
        uart_puts("[uipc] created pid=")
        uart_puthex(u64(pid))
        uart_puts("\n")

        resume_process(pid)

        gic_init()
        timer_init_periodic(cntfrq_el0() / u64(100))
        uart_puts("[uipc] gic + timer initialised\n")

        arch_cli()
        val first = first_thread_ssp()
        if first == i64(0)
            uart_puts("[uipc] no ready thread\n")
            abort()
        uart_puts("[uipc] resuming first thread\n")
        arch_resume_process(first)

RS-as-userspace bootstrap (DEMO_MODE=5). Mirrors x86's `kernel_main`
in app_nsh.sysl: find the "rs" boot module, load it into a fresh
server PT, write the info page (RS TID placeholder + ramdisk
placeholder + boot info header copy with offsets converted to
absolute PAs), create the process suspended, resume it, then kick
the scheduler. RS itself takes it from there (prints the banner,
tries to load each remaining server in turn; with no other
servers packed yet it prints "disk MISSING" and exits cleanly —
which is the baseline we want for this commit).

    kernel_main_rs()
        uart_puts("[rs] kernel_init...\n")
        kernel_init()
        ipc_init()
        register_syscall(1, sys_putc_handler)
        register_syscall(82, sys_puts_handler)

        // Populate kernel-side system info so sys_getinfo can
        // answer RS and server queries without the per-process
        // INFO_PAGE_VA scratch page.
        kernel_set_system_info(i64(0x50000000), i64(0x800000), i64(BOOT_INFO_PA))

        // Create the idle thread at the lowest priority. It runs
        // `arch_sti(); wfi()` in a loop on its own kernel stack
        // (slot 0), so when every real thread is blocked the
        // scheduler picks the idle thread instead of bouncing
        // through the recursive-wfi path in arch_schedule_after_exc
        // (which leaked a frame on the last-active thread's kstack
        // every time through).
        create_thread_pri(i64(&idle_thread_body),
            kernel_stack_usp(0), kernel_stack_ssp(0),
            "idle", NUM_PRIORITIES - 1, kernel_ptbr())

        uart_puts("[rs] creating process PT\n")
        val new_pt = vm_create_process_pt()
        if new_pt == 0
            uart_puts("[rs] vm_create_process_pt failed\n")
            abort()

        var blob_len = 0
        val blob_start = bi_find("rs", &blob_len)
        if blob_start == i64(0) || blob_len <= 0
            uart_puts("[rs] boot module 'rs' not found\n")
            abort()
        uart_puts("[rs] loading rs blob=")
        uart_puthex(u64(blob_start))
        uart_puts(" len=")
        uart_puthex(u64(blob_len))
        uart_puts("\n")

        user_load_program(new_pt, blob_start, blob_len)
        user_sync_icache(new_pt, blob_len)

        // RS reads ramdisk info + boot info blob via sys_getinfo at
        // startup — no per-process info page to build or copy.

        val pid = create_process_suspended(
            i64(0x60000000), i64(PROG_USP), i64(PROG_SSP),
            "rs", new_pt)
        if pid <= 0
            uart_puts("[rs] create_process_suspended failed\n")
            abort()
        uart_puts("[rs] created pid=")
        uart_puthex(u64(pid))
        uart_puts("\n")

        resume_process(pid)

        gic_init()
        timer_init_periodic(cntfrq_el0() / u64(100))
        uart_puts("[rs] gic + timer initialised\n")

        arch_cli()
        val first = first_thread_ssp()
        if first == i64(0)
            uart_puts("[rs] no ready thread\n")
            abort()
        uart_puts("[rs] resuming first thread\n")
        arch_resume_process(first)

Legacy EL0 demo.

    kernel_main_el0()
        uart_puts("sctlr_el1=")
        uart_puthex(read_sctlr_el1())
        uart_puts("\n")

        val p1 = page_alloc_zero()
        val p2 = page_alloc_zero()
        uart_puts("page_alloc_zero 1=")
        uart_puthex(p1)
        uart_puts(" 2=")
        uart_puthex(p2)
        uart_puts("\n")

        vm_flush_tlb()
        uart_puts("vm_flush_tlb ok\n")

        val new_pt = vm_create_process_pt()
        uart_puts("new_pt=")
        uart_puthex(new_pt)
        uart_puts("\n")

        val code_pa = last_user_code_page
        uart_puts("user code_pa=")
        uart_puthex(code_pa)
        uart_puts("\n")

        var code_word: *i32 = *i32(code_pa)
        code_word[0] = i32(0x14000000)
        sync_icache_line(i64(code_pa))

        vm_set_ptbr(new_pt)
        uart_puts("after vm_set_ptbr: still alive\n")

        gic_init()
        timer_init_periodic(cntfrq_el0() / u64(100))
        uart_puts("gic + timer initialised\n")

        uart_puts("dropping to EL0...\n")
        drop_to_el0(i64(0x60000000), i64(0x60020000))
        uart_puts("unexpected return from EL0 drop\n")
