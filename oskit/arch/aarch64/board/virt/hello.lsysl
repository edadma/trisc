hello — aarch64 sysl kernel entry (QEMU virt)
=============================================

Minimal `kernel_main` for the QEMU virt board. Prints greetings
via the PL011 UART module and returns; `boot.s` halts in wfi
after we come back.

    module oskit.arch.aarch64.board.virt

    import oskit.arch.{page_alloc_zero, kernel_ptbr, vm_flush_tlb,
        vm_create_process_pt, vm_set_ptbr, read_sctlr_el1,
        read_esr_el1, abort,
        last_user_code_page, last_user_stack_page, drop_to_el0,
        sync_icache_line, vm_v2p, vm_copy_to, vm_copy_from}

Render `v` as a 16-digit hex number (prefixed `0x`) to the UART.
Useful for the boot-time sanity prints below; deliberately crude
since the kernel will grow a real formatter later.

    uart_puthex(v: u64)
        uart_puts("0x")
        var shift = 60
        while shift >= 0
            val d = int((v >> u64(shift)) & u64(0xF))
            if d < 10
                uart_putc(int('0') + d)
            else
                uart_putc(int('A') + d - 10)
            shift -= 4

Synchronous exception handler for lower EL (EL0). Called from the
`low64_sync` stub in `vectors.s` after it has saved the full EL0
register state. `frame` points to the saved frame on the kernel
stack; the first 31 i64 slots are x0..x30 in order, so `fp[0]` is
x0, `fp[8]` is x8, etc. (Linux aarch64 calling convention: x8 is
the syscall number, x0..x5 are args, return goes back in x0.)

SVC (EC=0x15) dispatches through `syscall_dispatch`. Anything else
is fatal at this stage.

    handle_sync_lower(frame: u64)
        val esr = read_esr_el1()
        val ec = int((esr >> u64(26)) & u64(0x3F))
        if ec == 0x15
            syscall_dispatch(frame)
        else
            uart_puts("[unhandled sync from EL0, ESR=")
            uart_puthex(esr)
            uart_puts("]\n")
            abort()

Tiny syscall table. Numbers mirror Linux's aarch64 convention where
it makes sense (exit=93); our custom calls sit below that.

  SYS_PUTHEX(1, u64 v)  — print `v` as 16-digit hex, return 0
  SYS_EXIT(93, int code) — print exit code and halt the CPU

    syscall_dispatch(frame: u64)
        var fp: *i64 = *i64(frame)
        val num = u64(fp[8])
        val a0 = u64(fp[0])
        if num == u64(1)
            uart_puts("[EL0 says ")
            uart_puthex(a0)
            uart_puts("]\n")
            fp[0] = i64(0)
        else if num == u64(93)
            uart_puts("[EL0 exited, code=")
            uart_puthex(a0)
            uart_puts("]\n")
            abort()
        else
            uart_puts("[unknown syscall num=")
            uart_puthex(num)
            uart_puts("]\n")
            fp[0] = i64(-1)

    kernel_main()
        uart_puts("SLIX aarch64 boot (sysl, MMU on)\n")
        uart_puts("Hello, aarch64!\n")

        uart_puts("kernel_ptbr=")
        uart_puthex(kernel_ptbr())
        uart_puts("\n")

        // Dump SCTLR_EL1 so we can inspect which control bits the
        // boot path left set. Bit 19 (WXN) in particular would make
        // any EL0-writable mapping execute-never at EL1 — i.e. the
        // kernel would fault as soon as we flip AP[1] on RAM.
        uart_puts("sctlr_el1=")
        uart_puthex(read_sctlr_el1())
        uart_puts("\n")

        // Allocate a couple of zeroed pages and confirm they live at
        // distinct, page-aligned addresses. Proves the page pool and
        // the zero-fill path are functional under the new MMU map.
        val p1 = page_alloc_zero()
        val p2 = page_alloc_zero()
        uart_puts("page_alloc_zero 1=")
        uart_puthex(p1)
        uart_puts(" 2=")
        uart_puthex(p2)
        uart_puts("\n")

        vm_flush_tlb()
        uart_puts("vm_flush_tlb ok\n")

        // Create a per-process page table (a clone of the kernel map
        // at this stage) and switch TTBR0 to it. If the kernel keeps
        // running and the UART still works, the switch landed.
        val new_pt = vm_create_process_pt()
        uart_puts("new_pt=")
        uart_puthex(new_pt)
        uart_puts("\n")

        // Capture the L3 user page physical addresses before any
        // later call to vm_create_process_pt can clobber them.
        val code_pa = last_user_code_page
        val stack_pa = last_user_stack_page
        uart_puts("user code_pa=")
        uart_puthex(code_pa)
        uart_puts(" stack_pa=")
        uart_puthex(stack_pa)
        uart_puts("\n")

        // Write a tiny EL0 "user program" into the code page. Uses
        // movz (0xD2800000 | (imm16 << 5) | Rd) and svc (0xD4000001)
        // directly so we don't need to link user code.
        //   mov x0, #0xAA      0xD2801540
        //   mov x8, #1         0xD2800028   (SYS_PUTHEX)
        //   svc #0             0xD4000001
        //   mov x0, #0xBB      0xD2801760
        //   svc #0             0xD4000001   (reuses x8=1)
        //   mov x0, #1         0xD2800020   (exit code)
        //   mov x8, #93        0xD2800BA8   (SYS_EXIT)
        //   svc #0             0xD4000001
        //   b .                0x14000000   (should never be reached)
        var code_word: *i32 = *i32(code_pa)
        code_word[0] = i32(0xD2801540)
        code_word[1] = i32(0xD2800028)
        code_word[2] = i32(0xD4000001)
        code_word[3] = i32(0xD2801760)
        code_word[4] = i32(0xD4000001)
        code_word[5] = i32(0xD2800020)
        code_word[6] = i32(0xD2800BA8)
        code_word[7] = i32(0xD4000001)
        code_word[8] = i32(0x14000000)

        // A72 has split I/D caches on — the stores land in D-cache;
        // the I-cache must be made to see them before we try to
        // execute. All instructions fit in one 64B cache line (they
        // start at a page boundary), so one sync is sufficient.
        sync_icache_line(i64(code_pa))

        // Sanity-check vm_v2p against what we know: VA 0x60000000
        // under new_pt should translate to code_pa, and VA 0x60001000
        // to stack_pa.
        uart_puts("vm_v2p(new_pt, 0x60000000)=")
        uart_puthex(vm_v2p(new_pt, u64(0x60000000)))
        uart_puts("\nvm_v2p(new_pt, 0x60001000)=")
        uart_puthex(vm_v2p(new_pt, u64(0x60001000)))
        uart_puts("\n")

        vm_set_ptbr(new_pt)
        uart_puts("after vm_set_ptbr: still alive\n")

        // Drop to EL0 with user code at VA 0x60000000 and user stack
        // top at VA 0x60002000 (the stack page covers 0x60001000..
        // 0x60001FFF). SVC #0x42 from EL0 must vector to low64_sync
        // (VBAR+0x400, V=8) with ESR_EL1 EC=0x15, ISS[15:0]=0x42.
        uart_puts("dropping to EL0...\n")
        drop_to_el0(i64(0x60000000), i64(0x60002000))
        uart_puts("unexpected return from EL0 drop\n")
