OSKit Arch -- x86_64 Virtual Memory (Four-Level Paging)

x86_64 four-level page tables: PML4 → PDPT → PD → PT.
Each table is 4KB with 512 × 8-byte entries.

PTE format (64-bit):
  Bit 0: Present (P)
  Bit 1: Read/Write (R/W)
  Bit 2: User/Supervisor (U/S)
  Bit 7: Page Size (PS) — 2MB page (PD level only)
  Bits 12-51: Physical address (4KB aligned)

Boot.s identity-maps first 32MB using 2MB pages. vm_init splits
PD[0] into 4KB pages so the program region (0xCC000-0xFFFFF) can
be remapped per-process.

    module oskit.arch

    import oskit.config.{PAGE_SIZE, KERNEL_L1_BASE, PAGE_POOL_BASE}

    // x86_64 has more RAM than TRISC; page pool can extend up to 32MB
    // (QEMU default is 128MB). This overrides oskit.config.PAGE_POOL_END
    // which is constrained to 0x7FD000 by TRISC's 8MB device boundary.
    val PAGE_POOL_END: u64 = 0x2000000
    import oskit.hal.{memcpy, memset}

x86_64 PTE flags (i64 — PTEs are 64-bit on x86_64).

    val PTE_P:  i64 = 1       // present
    val PTE_W:  i64 = 2       // writable
    val PTE_U:  i64 = 4       // user accessible
    val PTE_PS: i64 = 0x80    // 2MB page size (PD level)

Mask for extracting physical address from a PTE (bits 12-51).

    val PTE_ADDR_MASK: i64 = 0x000FFFFFFFFFF000

Legacy TRISC PTE flag names (used by kernel for nothing, but
keep exports stable).

    val PTE_V = 1
    val PTE_R = 2
    val PTE_X = 0
    val PTE_G = 0

Page pool state.

    var page_pool_next: u64 = 0
    var page_pool_init = false
    var page_free_list: u64 = 0

Hardware page table operations (boot.s).

    extern vm_set_ptbr(addr: u64)
    extern vm_flush_tlb()
    extern vm_get_ptbr() -> u64
    extern debug_char(c: int)
    extern debug_hex4(v: int)
    extern debug_hex8(v: int)

Kernel PML4 address, recorded at boot.

    var kernel_pml4: u64 = 0

Return the kernel page table base address. Used by the kernel
instead of the TRISC-specific KERNEL_L1_BASE constant.

    kernel_ptbr() -> u64
        kernel_pml4

Write a 64-bit PTE at a given address.

    vm_write_pte64(addr: u64, pte: i64)
        var p: *i64 = *i64(addr)
        *p = pte

Read a 64-bit PTE from a given address.

    vm_read_pte64(addr: u64) -> i64
        var p: *i64 = *i64(addr)
        *p

Legacy 32-bit PTE write (unused on x86_64 but kept for interface).

    vm_write_pte(addr: u64, pte: int)
        vm_write_pte64(addr, i64(pte))


vm_init -- Split PD[0] from a 2MB superpage into 512 × 4KB
page table entries. This gives fine-grained control for the
program region while keeping PD[1..15] as 2MB superpages.

    vm_init()
        kernel_pml4 = vm_get_ptbr()

        // Walk PML4[0] → PDPT → PD to find the PD address
        val pdpt_addr = u64(vm_read_pte64(kernel_pml4) & PTE_ADDR_MASK)
        val pd_addr = u64(vm_read_pte64(pdpt_addr) & PTE_ADDR_MASK)

        // Allocate a PT for the first 2MB (replaces the 2MB superpage at PD[0])
        val pt = page_alloc_zero()
        if pt == 0
            return

        // Fill PT[0..511] with identity-mapped 4KB entries (present + writable)
        var i = 0
        while i < 512
            val phys = i64(u64(i) * u64(PAGE_SIZE))
            vm_write_pte64(pt + u64(i) * 8, phys | PTE_P | PTE_W)
            i += 1

        // Replace PD[0] with pointer to PT (remove PS bit → 4KB pages)
        vm_write_pte64(pd_addr, i64(pt) | PTE_P | PTE_W)
        vm_flush_tlb()


Physical page allocator -- same bump + free list as TRISC.
Page pool must start after kernel BSS AND after any multiboot
modules (ramdisk, boot info) to avoid overwriting them.
Boot.s sets page_pool_min_addr before kernel_init runs.

    extern _heap_start: byte
    var page_pool_min_addr: u64 = 0

    page_alloc() -> u64
        if !page_pool_init
            var base = u64(PAGE_POOL_BASE)
            val bss_end = u64(&_heap_start)
            val aligned = (bss_end + u64(PAGE_SIZE - 1)) & ~u64(PAGE_SIZE - 1)
            if aligned > base
                base = aligned
            if page_pool_min_addr > base
                base = page_pool_min_addr
            page_pool_next = base
            page_pool_init = true
        if page_free_list != 0
            val page = page_free_list
            var next: *i64 = *i64(page)
            page_free_list = u64(*next)
            return page
        if page_pool_next >= u64(PAGE_POOL_END)
            return 0
        val page = page_pool_next
        page_pool_next += u64(PAGE_SIZE)
        page

    page_free(addr: u64)
        var p: *i64 = *i64(addr)
        *p = i64(page_free_list)
        page_free_list = addr

    page_alloc_zero() -> u64
        val page = page_alloc()
        if page != 0
            memset(*byte(page), 0, PAGE_SIZE)
        page


Create a per-process page table. Allocates PML4 + PDPT + PD + PT
and fresh physical pages for the program region (0xCC000-0xFFFFF).
Kernel pages (first 2MB except program region) are identity-mapped.
PD[1..15] use 2MB superpages copied from the kernel PD.
Returns PML4 address, or 0 on failure.

    vm_create_process_pt() -> u64
        val pml4 = page_alloc_zero()
        if pml4 == 0
            return 0
        val pdpt = page_alloc_zero()
        if pdpt == 0
            return 0
        val pd = page_alloc_zero()
        if pd == 0
            return 0
        val pt = page_alloc_zero()
        if pt == 0
            return 0

        // PML4[0] → PDPT
        vm_write_pte64(pml4, i64(pdpt) | PTE_P | PTE_W | PTE_U)

        // PDPT[0] → PD
        vm_write_pte64(pdpt, i64(pd) | PTE_P | PTE_W | PTE_U)

        // PD[0] → PT (4KB pages)
        vm_write_pte64(pd, i64(pt) | PTE_P | PTE_W | PTE_U)

        // PD[1..15]: copy 2MB superpages from kernel PD
        val k_pdpt = u64(vm_read_pte64(kernel_pml4) & PTE_ADDR_MASK)
        val k_pd = u64(vm_read_pte64(k_pdpt) & PTE_ADDR_MASK)
        var j = 1
        while j < 16
            val k_pde = vm_read_pte64(k_pd + u64(j) * 8)
            vm_write_pte64(pd + u64(j) * 8, k_pde)
            j += 1

        // PDPT[1..3]: copy kernel's hi PDs covering 1-4GB. Kernel
        // mode (ring 0) ISRs must be able to reach MMIO regardless
        // of which process's cr3 is live — otherwise the virtio
        // IRQ handler faults while dereferencing vpci_isr from an
        // unrelated process's context. The underlying pd_hi{1,2,3}
        // entries carry U=0 (see boot.s), so ring 3 user code still
        // can't touch 1-4GB — vm_create_server_pt separately
        // installs a U=1 PD[3] for the nic server.
        var pi = 1
        while pi < 4
            val k_pdpte = vm_read_pte64(k_pdpt + u64(pi) * 8)
            vm_write_pte64(pdpt + u64(pi) * 8, k_pdpte)
            pi += 1

        // PT[0x00..0xCB]: kernel region, identity-mapped (present + writable)
        // Exception:
        //   0xCB: guard page — left non-present so stack overflow past the
        //        bottom of the program stack region (0xCC000) traps instead
        //        of silently corrupting low memory. Safe to drop here since
        //        x86 kernel loads at 0x100000 and doesn't use this area.
        var i = 0
        while i < 0xCC
            if i == 0xCB
                // Guard page: non-present (PTE = 0)
                vm_write_pte64(pt + u64(i) * 8, i64(0))
            else
                vm_write_pte64(pt + u64(i) * 8, i64(u64(i) * u64(PAGE_SIZE)) | PTE_P | PTE_W)
            i += 1

        // PT[0xCC..0xFF]: program region, fresh physical pages (present + writable + user)
        while i < 0x100
            val page = page_alloc()
            if page == 0
                return 0
            vm_write_pte64(pt + u64(i) * 8, i64(page) | PTE_P | PTE_W | PTE_U)
            i += 1

        // PT[0x100..0x1FF]: kernel code/data/BSS region, identity-mapped
        // The kernel loads at 0x100000 (page 0x100). ISR handlers, syscall
        // entry, and all kernel functions live here. Without this mapping,
        // int $0x80 from a child process would triple-fault.
        while i < 0x200
            vm_write_pte64(pt + u64(i) * 8, i64(u64(i) * u64(PAGE_SIZE)) | PTE_P | PTE_W)
            i += 1

        pml4


Create a server page table with MMIO grant. Like
vm_create_process_pt but additionally grants user access to one
I/O page (page 0xBF for the RS info page, always) and — when
`io_page != 0` — maps the kernel's 3-4GB identity region into
the server's PDPT[3] so it can reach virtio-pci BARs that QEMU
places in the PCI hole near 0xFEBF0000.

PDPT[1..3] normally stay unmapped in per-process PTs (boot.s
comment documents this), keeping MMIO out of user address
spaces. The nic server is the one exception today: granting
PDPT[3] shares the kernel's static 2MB-superpage PD for 3-4GB,
which includes all standard virtio-pci device BARs on QEMU's
default q35/i440fx machine configs.

The `io_page` arg is overloaded: on aarch64 it's a physical
frame number to map at L3[256] (MMIO_SERVER_VA). On x86 the
value itself is ignored — any non-zero flags the PDPT[3] share.
That's fine because only the nic server passes a non-zero value
today (other servers pass 0 and skip the MMIO grant entirely).

    vm_create_server_pt(io_page: int) -> u64
        val pml4 = vm_create_process_pt()
        if pml4 == 0
            return 0
        // Grant user access to page 0xBF (0xBF000) for RS info page
        // (RS TID, ramdisk base/size written before server starts)
        val pdpt = u64(vm_read_pte64(pml4) & PTE_ADDR_MASK)
        val pd = u64(vm_read_pte64(pdpt) & PTE_ADDR_MASK)
        val pt = u64(vm_read_pte64(pd) & PTE_ADDR_MASK)
        val old_pte = vm_read_pte64(pt + u64(0xBF) * 8)
        vm_write_pte64(pt + u64(0xBF) * 8, old_pte | PTE_U)

        if io_page != 0
            // Build a fresh PD for 3-4GB with PTE_U=1 on every 2MB
            // superpage so ring 3 code in the server can reach virtio-
            // pci BARs (QEMU places them near 0xFEBF0000 by default).
            // Kernel's boot.s pd_hi3 has PTE_U=0 and is shared by
            // every kernel thread; giving the server its own PD keeps
            // the U=0 invariant for non-server contexts.
            val pd3 = page_alloc_zero()
            if pd3 == 0
                return 0
            var k = 0
            while k < 512
                val base = u64(0xC0000000) + u64(k) * u64(0x200000)
                vm_write_pte64(pd3 + u64(k) * 8,
                    i64(base) | PTE_P | PTE_W | PTE_U | PTE_PS)
                k += 1
            vm_write_pte64(pdpt + u64(3) * 8,
                i64(pd3) | PTE_P | PTE_W | PTE_U)
        pml4


Grant mapping region for zero-copy IPC.
PD[16] maps virtual addresses starting at 0x2000000 (32MB).

    val GRANT_PD_IDX = 16
    val GRANT_REGION_BASE: u64 = 0x2000000
    val GRANT_REGION_PAGES = 512


Ensure a page table exists at PD[16] for the grant mapping
region. If not present, allocates one. Returns PT address or 0.

    vm_grant_ensure_pt(ptbr: u64) -> u64
        // Walk PML4 → PDPT → PD to find PD[16]
        val pml4e = vm_read_pte64(ptbr)
        val pdpt = u64(pml4e & PTE_ADDR_MASK)
        val pdpte = vm_read_pte64(pdpt)
        val pd = u64(pdpte & PTE_ADDR_MASK)
        val pde = vm_read_pte64(pd + u64(GRANT_PD_IDX) * 8)
        if (pde & PTE_P) != 0
            // PT already exists
            return u64(pde & PTE_ADDR_MASK)
        // Allocate new PT
        val pt = page_alloc_zero()
        if pt == 0
            return 0
        vm_write_pte64(pd + u64(GRANT_PD_IDX) * 8, i64(pt) | PTE_P | PTE_W | PTE_U)
        pt


Scan the grant region PT for `count` contiguous free (non-present)
entries. Returns the starting virtual address or 0 if not found.

    vm_grant_find_free(ptbr: u64, count: int) -> u64
        val pt = vm_grant_ensure_pt(ptbr)
        if pt == 0
            return 0
        var run = 0
        var start = 0
        var i = 0
        while i < GRANT_REGION_PAGES
            val pte = vm_read_pte64(pt + u64(i) * 8)
            if (pte & PTE_P) == 0
                if run == 0
                    start = i
                run += 1
                if run >= count
                    return GRANT_REGION_BASE + u64(start) * 4096
            else
                run = 0
            i += 1
        0


Map a single physical page at a specific virtual address in the
grant region.

    vm_grant_map_page(ptbr: u64, vaddr: u64, paddr: u64, writable: int)
        val pt = vm_grant_ensure_pt(ptbr)
        if pt == 0
            return
        val idx = (vaddr - GRANT_REGION_BASE) / 4096
        var flags = PTE_P | PTE_U
        if writable != 0
            flags = flags | PTE_W
        vm_write_pte64(pt + idx * 8, i64(paddr) | flags)


Clear PTEs for `count` pages starting at `vaddr` in the grant
region. Flushes TLB after unmapping.

    vm_grant_unmap_pages(ptbr: u64, vaddr: u64, count: int)
        val pt = vm_grant_ensure_pt(ptbr)
        if pt == 0
            return
        val start_idx = (vaddr - GRANT_REGION_BASE) / 4096
        var i = 0
        while i < count
            vm_write_pte64(pt + (start_idx + u64(i)) * 8, i64(0))
            i += 1
        vm_flush_tlb()


Free all pages allocated for a process page table.

    vm_free_process_pt(l1_addr: u64)
        if l1_addr == 0
            return
        if l1_addr == kernel_pml4
            return

        // Walk PML4[0] → PDPT[0] → PD[0] → PT
        val pdpt = u64(vm_read_pte64(l1_addr) & PTE_ADDR_MASK)
        if pdpt == 0
            return
        val pd = u64(vm_read_pte64(pdpt) & PTE_ADDR_MASK)
        if pd == 0
            return
        val pt = u64(vm_read_pte64(pd) & PTE_ADDR_MASK)
        if pt == 0
            return

        // Free program pages (PT entries 0xCC-0xFF)
        var i = 0xCC
        while i < 0x100
            val pte = vm_read_pte64(pt + u64(i) * 8)
            if (pte & PTE_P) != 0
                val phys = u64(pte & PTE_ADDR_MASK)
                page_free(phys)
            i += 1

        // Free the page table structures
        page_free(pt)
        page_free(pd)
        page_free(pdpt)
        page_free(l1_addr)


Software four-level page table walk. Translates a virtual
address to physical using the given PML4.

    vm_v2p(ptbr: u64, vaddr: u64) -> u64
        val pml4_idx = (vaddr >> 39) & u64(0x1FF)
        val pdpt_idx = (vaddr >> 30) & u64(0x1FF)
        val pd_idx   = (vaddr >> 21) & u64(0x1FF)
        val pt_idx   = (vaddr >> 12) & u64(0x1FF)
        val offset   = vaddr & u64(0xFFF)

        // PML4 → PDPT
        val pml4e = vm_read_pte64(ptbr + pml4_idx * 8)
        if (pml4e & PTE_P) == 0
            return 0
        val pdpt_addr = u64(pml4e & PTE_ADDR_MASK)

        // PDPT → PD (1GB pages not used)
        val pdpte = vm_read_pte64(pdpt_addr + pdpt_idx * 8)
        if (pdpte & PTE_P) == 0
            return 0
        val pd_addr = u64(pdpte & PTE_ADDR_MASK)

        // PD → check for 2MB page (PS bit)
        val pde = vm_read_pte64(pd_addr + pd_idx * 8)
        if (pde & PTE_P) == 0
            return 0
        if (pde & PTE_PS) != 0
            // 2MB superpage
            val base = u64(pde & PTE_ADDR_MASK)
            return base | (vaddr & u64(0x1FFFFF))

        // PT → 4KB page
        val pt_addr = u64(pde & PTE_ADDR_MASK)
        val pte = vm_read_pte64(pt_addr + pt_idx * 8)
        if (pte & PTE_P) == 0
            return 0
        val page = u64(pte & PTE_ADDR_MASK)
        page | offset


Copy data into another address space using physical addressing.

    vm_copy_to(dst_ptbr: u64, dst_vaddr: u64, src: *byte, len: int)
        var copied = 0
        while copied < len
            val pa = vm_v2p(dst_ptbr, dst_vaddr + u64(copied))
            val page_off = int((dst_vaddr + u64(copied)) & u64(0xFFF))
            var chunk = PAGE_SIZE - page_off
            if chunk > len - copied
                chunk = len - copied
            memcpy(*byte(pa), src + copied, chunk)
            copied += chunk

Copy data from another address space using physical addressing.

    vm_copy_from(src_ptbr: u64, src_vaddr: u64, dst: *byte, len: int)
        var copied = 0
        while copied < len
            val pa = vm_v2p(src_ptbr, src_vaddr + u64(copied))
            val page_off = int((src_vaddr + u64(copied)) & u64(0xFFF))
            var chunk = PAGE_SIZE - page_off
            if chunk > len - copied
                chunk = len - copied
            memcpy(dst + copied, *byte(pa), chunk)
            copied += chunk

Copy data between two address spaces via physical addresses.

    vm_copy_cross(src_ptbr: u64, src_vaddr: u64, dst_ptbr: u64, dst_vaddr: u64, len: int)
        var copied = 0
        while copied < len
            val src_pa = vm_v2p(src_ptbr, src_vaddr + u64(copied))
            val dst_pa = vm_v2p(dst_ptbr, dst_vaddr + u64(copied))
            val src_off = int((src_vaddr + u64(copied)) & u64(0xFFF))
            val dst_off = int((dst_vaddr + u64(copied)) & u64(0xFFF))
            var chunk = PAGE_SIZE - src_off
            val dst_chunk = PAGE_SIZE - dst_off
            if dst_chunk < chunk
                chunk = dst_chunk
            if chunk > len - copied
                chunk = len - copied
            memcpy(*byte(dst_pa), *byte(src_pa), chunk)
            copied += chunk
