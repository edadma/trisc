// Two threads printing alternately — tests real kernel scheduler
// with timer preemption on x86_64.

import oskit.kernel.{create_thread, kernel_stack_usp, kernel_stack_ssp, first_thread_ssp}
import oskit.arch.x86_64.{uart_puts, uart_putc}

thread_a()
    var i = 0
    while i < 20
        uart_putc(65)  // 'A'
        var j = 0
        while j < 500000
            j += 1
        i += 1

thread_b()
    var i = 0
    while i < 20
        uart_putc(66)  // 'B'
        var j = 0
        while j < 500000
            j += 1
        i += 1

kernel_main() -> i64
    create_thread(i64(thread_a), kernel_stack_usp(0), kernel_stack_ssp(0), "A")
    create_thread(i64(thread_b), kernel_stack_usp(1), kernel_stack_ssp(1), "B")
    uart_puts("[kernel_main] two threads created\n")
    first_thread_ssp()
