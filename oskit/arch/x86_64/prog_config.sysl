// Address layout for x86_64 user programs and servers.
//
// Programs: code at 0xE0000, 80KB stack (0xCC000..0xDFFFF).
// On x86 everything runs in ring 0, so syscall handlers share the
// program stack; generous stack space is essential.
//
// Servers: code at 0xD4000, 32KB stack. Servers have large BSS
// (RS ~128KB) and need ~176KB to 0x100000.

module oskit.arch

val PROG_USP = 0xE0000
val PROG_SSP = 0xDF000
val SRV_USP  = 0xD4000
val SRV_SSP  = 0xD3000

// Scratch page used by the kernel to pass per-process bring-up info
// (RS TID, ramdisk base/size, boot info) and by PM for argv. On x86
// this is the low-address args page at 0xBF000.
val INFO_PAGE_VA: i64 = 0xBF000
