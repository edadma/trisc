// Test app: boots full server stack, then spawns /bin/test_putc.
// Used to verify PM spawn + loader + external execution on x86_64.

import oskit.kernel.{create_thread, kernel_stack_usp, kernel_stack_ssp, first_thread_ssp}
import oskit.servers.{rs_main, rs_set_init_fn, pm_spawn_handles, pm_waitpid}
import oskit.services.{rs_ready, putc}
import oskit.fs.{fs_connect, fs_open, fs_read, fs_close, fs_get_port}
import oskit.arch.x86_64.uart_puts
import oskit.drivers.disk.{get_mboot_mod_start, get_mboot_mod_end, disk_capacity}
import oskit.ipc.ipc_init

// Simple hex printer for debug
print_hex(v: int)
    val hex = "0123456789ABCDEF"
    val hp = *byte(hex)
    putc(byte('0'))
    putc(byte('x'))
    var shift = 28
    while shift >= 0
        putc(hp[(v >> shift) & 0xF])
        shift -= 4

x86_test_init()
    rs_ready()
    uart_puts("[init] servers ready, spawning /bin/test_putc\n")

    // Debug: show multiboot module info
    val mod_start = get_mboot_mod_start()
    val mod_end = get_mboot_mod_end()
    uart_puts("[init] ramdisk: start=")
    print_hex(mod_start)
    uart_puts(" end=")
    print_hex(mod_end)
    uart_puts(" size=")
    print_hex(mod_end - mod_start)
    putc(byte('\n'))

    // Debug: check disk capacity
    val cap = disk_capacity()
    uart_puts("[init] disk capacity=")
    print_hex(cap)
    putc(byte('\n'))

    // Debug: check if VFS port is accessible
    val fs_port = fs_get_port()
    uart_puts("[init] fs port=")
    if fs_port >= 0
        putc(byte('0') + fs_port)
    else
        uart_puts("FAIL")
    putc(byte('\n'))

    // Debug: try opening a file
    val fid = fs_open("/etc/ttytab")
    uart_puts("[init] open /etc/ttytab fid=")
    if fid >= 0
        putc(byte('0') + fid)
    else
        uart_puts("FAIL")
    putc(byte('\n'))

    if fid >= 0
        var buf: [64]byte
        val nr = fs_read(fid, buf, 63)
        uart_puts("[init] read ")
        if nr > 0
            putc(byte('0') + nr)
            uart_puts(" bytes: ")
            buf[nr] = 0
            var k = 0
            while k < nr
                putc(buf[k])
                k += 1
        else
            uart_puts("FAIL")
        putc(byte('\n'))
        fs_close(fid)

    // Open TTY handles for child
    val h_in = fs_connect("tty:0")
    val h_out = fs_connect("tty:0")
    val h_err = fs_connect("tty:0")

    uart_puts("[init] TTY handles: ")
    putc(byte('0') + h_in)
    putc(byte(' '))
    putc(byte('0') + h_out)
    putc(byte(' '))
    putc(byte('0') + h_err)
    putc(byte('\n'))

    var hmap: [6]byte
    hmap[0] = byte(h_in)
    hmap[1] = 0
    hmap[2] = byte(h_out)
    hmap[3] = 1
    hmap[4] = byte(h_err)
    hmap[5] = 2

    val pid = pm_spawn_handles("/bin/test_putc", "test_putc", &hmap[0], 3)
    uart_puts("[init] spawn returned pid=")
    if pid >= 0
        putc(byte('0') + pid)
    else
        putc(byte('-'))
        putc(byte('0') - pid)
    putc(byte('\n'))

    if pid >= 0
        uart_puts("[init] waiting for child...\n")
        val ec = pm_waitpid(pid)
        uart_puts("[init] child exited, code=")
        putc(byte('0') + ec)
        putc(byte('\n'))
    else
        uart_puts("[init] spawn FAILED\n")

    uart_puts("[init] done\n")

kernel_main() -> i64
    ipc_init()
    rs_set_init_fn(i64(x86_test_init))
    create_thread(i64(rs_main), kernel_stack_usp(0), kernel_stack_ssp(0), "rs")
    uart_puts("[kernel_main] RS thread created\n")
    first_thread_ssp()
