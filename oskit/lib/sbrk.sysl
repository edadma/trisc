module posix.unistd

/*
 * sbrk for SLIX — uses linker-defined heap region.
 * Heap grows upward from _heap_start. Stacks are in upper
 * RAM (0x80000+), so heap ceiling is set to 0x7E000.
 */

extern _heap_start: i8

val HEAP_CEILING: i64 = 0x7E000

var _brk: *i8 = *i8(0)
var _brk_initialized = false

sbrk(increment: int) -> *i8
    if !_brk_initialized
        _brk = &_heap_start
        _brk_initialized = true
    if increment == 0
        return _brk
    val old_brk = _brk
    val new_brk = old_brk + increment
    if i64(new_brk) > HEAP_CEILING
        return *i8(-1)
    _brk = new_brk
    old_brk
