OSKit String Library

POSIX-style string utilities for userspace programs.

    module oskit.lib

strtok(str, delim) — POSIX strtok. First call passes the string;
subsequent calls pass a null pointer (0) to continue tokenizing.
Modifies the string in place (replaces delimiters with null bytes).
Returns pointer to the next token, or null (0) when exhausted.
The delim argument is a string — any character in it is a delimiter.

    var _strtok_pos: i64 = 0

    _is_delim(c: i8, delim: *i8) -> int
        var i = 0
        while delim[i] != 0
            if delim[i] == c
                return 1
            i += 1
        0

    strtok(str: *i8, delim: *i8) -> *i8
        var p: *i8
        if i64(str) != 0
            p = str
        else if _strtok_pos == 0
            return *i8(0)
        else
            p = *i8(_strtok_pos)
        // Skip leading delimiters
        while *p != 0
            if _is_delim(*p, delim) == 0
                break
            p += 1
        // End of string — no more tokens
        if *p == 0
            _strtok_pos = 0
            return *i8(0)
        // Mark start of token
        val start: *i8 = p
        // Find end of token
        while *p != 0
            if _is_delim(*p, delim) == 1
                *p = 0
                _strtok_pos = i64(p + 1)
                return start
            p += 1
        // Reached end of string
        _strtok_pos = 0
        start

streq(a, b) — Compare two null-terminated strings.
Returns 1 if equal, 0 otherwise.

    streq(a: *i8, b: *i8) -> int
        var i = 0
        while a[i] != 0
            if a[i] != b[i]
                return 0
            i += 1
        if b[i] != 0
            return 0
        1

strlen(s) — Return the length of a null-terminated string.

    strlen(s: *i8) -> int
        var i = 0
        while s[i] != 0
            i += 1
        i

strcpy(dst, src) — Copy a null-terminated string.

    strcpy(dst: *i8, src: *i8)
        var i = 0
        while src[i] != 0
            dst[i] = src[i]
            i += 1
        dst[i] = 0

strcat(dst, src) — Append src to the end of dst.

    strcat(dst: *i8, src: *i8)
        var i = 0
        while dst[i] != 0
            i += 1
        var j = 0
        while src[j] != 0
            dst[i] = src[j]
            i += 1
            j += 1
        dst[i] = 0

