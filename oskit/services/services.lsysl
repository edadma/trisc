TOS System Services

User-facing API for TOS kernel services.

Syscall numbers:
- 0 = sleep -- block for N timer ticks
- 1 = putc -- write character to stdout
- 2 = yield -- voluntary context switch
- 3 = exit -- terminate current thread
- 4 = join -- wait for another thread to terminate
- 5 = thread_id -- get current thread index
- 6 = uptime -- get tick counter
- 7 = thread_count -- get number of created threads
- 8 = thread_state -- get state of a thread
- 9 = thread_name -- get name pointer of a thread
- 10 = sleep_until -- block until absolute tick
- 11 = ctx_switches -- get context switch count for a thread
- 12 = cpu_ticks -- get CPU ticks for a thread
- 13 = total_switches -- get global context switch count
- 14 = set_watchdog -- set watchdog quanta limit (0 = disable)

    module oskit.services

    // No kernel imports — all services go through syscalls

    extern syscall(number: int, arg: i64) -> i64

    val SYS_SLEEP          = 0
    val SYS_PUTC           = 1
    val SYS_YIELD          = 2
    val SYS_EXIT           = 3
    val SYS_JOIN           = 4
    val SYS_THREAD_ID      = 5
    val SYS_UPTIME         = 6
    val SYS_THREAD_COUNT   = 7
    val SYS_THREAD_STATE   = 8
    val SYS_THREAD_NAME    = 9
    val SYS_SLEEP_UNTIL    = 10
    val SYS_KBHIT          = 11
    val SYS_GETKEY         = 12
    val SYS_CTX_SWITCHES   = 13
    val SYS_CPU_TICKS      = 14
    val SYS_TOTAL_SWITCHES = 15
    val SYS_SET_WATCHDOG   = 16
    val SYS_PANIC          = 17
    val SYS_CHECK_STACK    = 18
    val SYS_SUSPEND        = 19
    val SYS_RESUME         = 20
    val SYS_TLS_SET        = 21
    val SYS_TLS_GET        = 22
    val SYS_NOTIFY_SEND    = 23
    val SYS_NOTIFY_WAIT    = 24
    val SYS_NOTIFY_READ    = 25
    val SYS_EVENT_WAIT     = 26
    val SYS_EVENT_SET      = 27
    val SYS_EVENT_CLEAR    = 28

    sleep(ticks: int)
        syscall(SYS_SLEEP, ticks)

    putc(ch: char)
        syscall(SYS_PUTC, ch)

    yield()
        syscall(SYS_YIELD, 0)

    exit()
        syscall(SYS_EXIT, 0)

    exit_with(code: int)
        syscall(SYS_EXIT, code)

    join(id: int)
        syscall(SYS_JOIN, id)

    thread_id() -> int
        syscall(SYS_THREAD_ID, 0)

    uptime() -> int
        syscall(SYS_UPTIME, 0)

    get_thread_count() -> int
        syscall(SYS_THREAD_COUNT, 0)

    get_thread_state(id: int) -> int
        syscall(SYS_THREAD_STATE, id)

    get_thread_name(id: int) -> *byte
        syscall(SYS_THREAD_NAME, id)

    sleep_until(tick: int)
        syscall(SYS_SLEEP_UNTIL, tick)

    kbhit() -> int
        syscall(SYS_KBHIT, 0)

    getkey() -> int
        syscall(SYS_GETKEY, 0)

    get_ctx_switches(id: int) -> int
        syscall(SYS_CTX_SWITCHES, id)

    get_cpu_ticks(id: int) -> int
        syscall(SYS_CPU_TICKS, id)

    get_total_switches() -> int
        syscall(SYS_TOTAL_SWITCHES, 0)

    set_watchdog(limit: int)
        syscall(SYS_SET_WATCHDOG, limit)

    panic()
        syscall(SYS_PANIC, 0)

    check_stack(addr: i64) -> int
        syscall(SYS_CHECK_STACK, addr)

    suspend(id: int)
        syscall(SYS_SUSPEND, id)

    resume(id: int)
        syscall(SYS_RESUME, id)

    putstr(s: *byte)
        var i = 0
        while s[i] != 0
            putc(s[i])
            i += 1

    notify_send_to(id: int, value: int)
        syscall(SYS_NOTIFY_SEND, (id << 24) | (value & 0xFFFFFF))

    notify_wait()
        syscall(SYS_NOTIFY_WAIT, 0)

    notify_read_self() -> int
        syscall(SYS_NOTIFY_READ, 0)

    event_wait(mask: int, wait_all: int)
        syscall(SYS_EVENT_WAIT, (wait_all << 24) | (mask & 0xFFFFFF))

    event_set(id: int, bits: int)
        syscall(SYS_EVENT_SET, (id << 24) | (bits & 0xFFFFFF))

    event_clear(id: int, bits: int)
        syscall(SYS_EVENT_CLEAR, (id << 24) | (bits & 0xFFFFFF))

RS (Restart Server) ready signal. Each server calls rs_ready()
after completing initialization. The notification goes to the
RS thread which waits for it before starting the next server.

    var rs_tid = -1

    rs_set_tid(tid: int)
        rs_tid = tid

    rs_ready()
        if rs_tid >= 0
            notify_send_to(rs_tid, 1)

Packs slot (8 bits) and value (24 bits) into one syscall arg.
Slot range: 0-3. Value range: 0 to 16777215.

    tls_set(slot: int, value: int)
        syscall(SYS_TLS_SET, (slot << 24) | (value & 0xFFFFFF))

    tls_get(slot: int) -> int
        syscall(SYS_TLS_GET, slot)

    val SYS_PIMUTEX_LOCK   = 29
    val SYS_PIMUTEX_UNLOCK = 30
    val SYS_WAITPID        = 40
    val SYS_GETPID         = 41
    val SYS_THREAD_PID     = 42

    pimutex_lock_sys(addr: i64)
        syscall(SYS_PIMUTEX_LOCK, addr)

    pimutex_unlock_sys(addr: i64)
        syscall(SYS_PIMUTEX_UNLOCK, addr)

    waitpid(pid: int)
        syscall(SYS_WAITPID, pid)

    getpid() -> int
        syscall(SYS_GETPID, 0)

    get_thread_pid(id: int) -> int
        syscall(SYS_THREAD_PID, id)

    val SYS_KB_SET_NOTIFY = 64

    svc_kb_set_notify(tid: int)
        syscall(SYS_KB_SET_NOTIFY, tid)

    val SYS_VM_CREATE_SERVER_PT = 63

    svc_vm_create_server_pt(io_page: int) -> int
        syscall(SYS_VM_CREATE_SERVER_PT, io_page)

    val SYS_GETUID = 61
    val SYS_SETUID = 62

    getuid() -> int
        syscall(SYS_GETUID, 0)

    setuid(uid: int)
        syscall(SYS_SETUID, uid)

Server isolation syscalls. These allow PM and VFS to call
kernel functions through the syscall interface instead of
importing them directly.

    val SYS_VM_CREATE_PT       = 44
    val SYS_CREATE_PROC_SUSP   = 45
    val SYS_RESUME_PROC        = 46
    val SYS_REAP_PROC          = 47
    val SYS_KILL_PROC          = 48
    val SYS_REGISTER_PM        = 49
    val SYS_SET_THREAD_PTBR    = 50
    val SYS_VM_SET_PTBR_SC     = 51
    val SYS_GET_THREAD_PID     = 52
    val SYS_GET_THREAD_PTBR    = 53
    val SYS_VM_COPY_TO         = 54
    val SYS_VM_COPY_FROM       = 55
    val SYS_PROC_STATE         = 56
    val SYS_PROC_EXIT_CODE     = 57
    val SYS_PROC_MAIN_TID      = 58
    val SYS_PROC_PARENT_TID    = 59
    val SYS_PROC_SET_PARENT_TID = 60

    svc_vm_create_pt() -> int
        syscall(SYS_VM_CREATE_PT, 0)

    svc_create_proc_susp(entry: i64, usp: i64, ssp: i64, name: string, ptbr: int) -> int
        var args: [6]i64
        args[0] = entry
        args[1] = usp
        args[2] = ssp
        args[3] = i64(*byte(name))
        args[4] = len(name)
        args[5] = ptbr
        syscall(SYS_CREATE_PROC_SUSP, i64(&args[0]))

    svc_resume_proc(pid: int)
        syscall(SYS_RESUME_PROC, pid)

    svc_reap_proc(pid: int)
        syscall(SYS_REAP_PROC, pid)

    svc_kill_proc(pid: int) -> int
        syscall(SYS_KILL_PROC, pid)

    svc_register_pm(tid: int)
        syscall(SYS_REGISTER_PM, tid)

    svc_set_thread_ptbr(tid: int, ptbr: int)
        var args: [2]i64
        args[0] = tid
        args[1] = ptbr
        syscall(SYS_SET_THREAD_PTBR, i64(&args[0]))

    svc_vm_set_ptbr(addr: int)
        syscall(SYS_VM_SET_PTBR_SC, addr)

    svc_get_thread_pid(tid: int) -> int
        syscall(SYS_GET_THREAD_PID, tid)

    svc_get_thread_ptbr(tid: int) -> int
        syscall(SYS_GET_THREAD_PTBR, tid)

    svc_vm_copy_to(dst_ptbr: int, dst_vaddr: int, src: *byte, vlen: int)
        var args: [4]i64
        args[0] = dst_ptbr
        args[1] = dst_vaddr
        args[2] = i64(src)
        args[3] = vlen
        syscall(SYS_VM_COPY_TO, i64(&args[0]))

    svc_vm_copy_from(src_ptbr: int, src_vaddr: int, dst: *byte, vlen: int)
        var args: [4]i64
        args[0] = src_ptbr
        args[1] = src_vaddr
        args[2] = i64(dst)
        args[3] = vlen
        syscall(SYS_VM_COPY_FROM, i64(&args[0]))

    svc_proc_state(pid: int) -> int
        syscall(SYS_PROC_STATE, pid)

    svc_proc_exit_code(pid: int) -> int
        syscall(SYS_PROC_EXIT_CODE, pid)

    svc_proc_main_tid(pid: int) -> int
        syscall(SYS_PROC_MAIN_TID, pid)

    svc_proc_parent_tid(pid: int) -> int
        syscall(SYS_PROC_PARENT_TID, pid)

    svc_proc_set_parent_tid(pid: int, parent_tid: int)
        var args: [2]i64
        args[0] = pid
        args[1] = parent_tid
        syscall(SYS_PROC_SET_PARENT_TID, i64(&args[0]))

Translate a virtual address to physical using the current
thread's page table. Used by drivers that need DMA addresses.

    val SYS_VM_V2P = 66

    svc_vm_v2p(vaddr: int) -> int
        syscall(SYS_VM_V2P, vaddr)

    val SYS_PORT_TRANSFER = 68

    svc_port_transfer(port: int, new_owner_tid: int)
        var args: [2]i64
        args[0] = port
        args[1] = new_owner_tid
        syscall(SYS_PORT_TRANSFER, i64(&args[0]))

    val SYS_PHYS_READ = 67

    svc_phys_read(src_phys: int, dst: *byte, vlen: int)
        var args: [3]i64
        args[0] = src_phys
        args[1] = i64(dst)
        args[2] = vlen
        syscall(SYS_PHYS_READ, i64(&args[0]))
