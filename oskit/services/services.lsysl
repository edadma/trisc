TOS System Services

User-facing API for TOS kernel services.

Syscall numbers:
- 0 = sleep -- block for N timer ticks
- 1 = putc -- write character to stdout
- 2 = yield -- voluntary context switch
- 3 = exit -- terminate current thread
- 4 = join -- wait for another thread to terminate
- 5 = thread_id -- get current thread index
- 6 = uptime -- get tick counter
- 7 = thread_count -- get number of created threads
- 8 = thread_state -- get state of a thread
- 9 = thread_name -- get name pointer of a thread
- 10 = sleep_until -- block until absolute tick
- 11 = ctx_switches -- get context switch count for a thread
- 12 = cpu_ticks -- get CPU ticks for a thread
- 13 = total_switches -- get global context switch count
- 14 = set_watchdog -- set watchdog quanta limit (0 = disable)

    module oskit.services

    // No kernel imports — all services go through syscalls

    extern syscall(number: int, arg: i64) -> i64
    extern syscall6(number: int, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64

    val SYS_SLEEP          = 0
    val SYS_PUTC           = 1
    val SYS_YIELD          = 2
    val SYS_EXIT           = 3
    val SYS_JOIN           = 4
    val SYS_THREAD_ID      = 5
    val SYS_UPTIME         = 6
    val SYS_THREAD_COUNT   = 7
    val SYS_THREAD_STATE   = 8
    val SYS_THREAD_NAME    = 9
    val SYS_SLEEP_UNTIL    = 10
    val SYS_KBHIT          = 11
    val SYS_GETKEY         = 12
    val SYS_CTX_SWITCHES   = 13
    val SYS_CPU_TICKS      = 14
    val SYS_TOTAL_SWITCHES = 15
    val SYS_SET_WATCHDOG   = 16
    val SYS_PANIC          = 17
    val SYS_CHECK_STACK    = 18
    val SYS_SUSPEND        = 19
    val SYS_RESUME         = 20
    val SYS_TLS_SET        = 21
    val SYS_TLS_GET        = 22
    val SYS_NOTIFY_SEND    = 23
    val SYS_NOTIFY_WAIT    = 24
    val SYS_NOTIFY_READ    = 25
    val SYS_EVENT_WAIT     = 26
    val SYS_EVENT_SET      = 27
    val SYS_EVENT_CLEAR    = 28

    sleep(ticks: int)
        syscall(SYS_SLEEP, ticks)

    putc(ch: char)
        syscall(SYS_PUTC, ch)

    yield()
        syscall(SYS_YIELD, 0)

    exit()
        syscall(SYS_EXIT, 0)

    exit_with(code: int)
        syscall(SYS_EXIT, code)

    join(id: int)
        syscall(SYS_JOIN, id)

    thread_id() -> int
        syscall(SYS_THREAD_ID, 0)

    uptime() -> int
        syscall(SYS_UPTIME, 0)

    get_thread_count() -> int
        syscall(SYS_THREAD_COUNT, 0)

    get_thread_state(id: int) -> int
        syscall(SYS_THREAD_STATE, id)

    get_thread_name(id: int) -> *byte
        syscall(SYS_THREAD_NAME, id)

    sleep_until(tick: int)
        syscall(SYS_SLEEP_UNTIL, tick)

    kbhit() -> int
        syscall(SYS_KBHIT, 0)

    getkey() -> int
        syscall(SYS_GETKEY, 0)

    get_ctx_switches(id: int) -> int
        syscall(SYS_CTX_SWITCHES, id)

    get_cpu_ticks(id: int) -> int
        syscall(SYS_CPU_TICKS, id)

    get_total_switches() -> int
        syscall(SYS_TOTAL_SWITCHES, 0)

    set_watchdog(limit: int)
        syscall(SYS_SET_WATCHDOG, limit)

    panic()
        syscall(SYS_PANIC, 0)

    check_stack(addr: i64) -> int
        syscall(SYS_CHECK_STACK, addr)

    suspend(id: int)
        syscall(SYS_SUSPEND, id)

    resume(id: int)
        syscall(SYS_RESUME, id)

    putstr(s: *byte)
        var i = 0
        while s[i] != 0
            putc(s[i])
            i += 1

    notify_send_to(id: int, value: int)
        syscall(SYS_NOTIFY_SEND, (id << 24) | (value & 0xFFFFFF))

    notify_wait()
        syscall(SYS_NOTIFY_WAIT, 0)

    notify_read_self() -> int
        syscall(SYS_NOTIFY_READ, 0)

    event_wait(mask: int, wait_all: int)
        syscall(SYS_EVENT_WAIT, (wait_all << 24) | (mask & 0xFFFFFF))

    event_set(id: int, bits: int)
        syscall(SYS_EVENT_SET, (id << 24) | (bits & 0xFFFFFF))

    event_clear(id: int, bits: int)
        syscall(SYS_EVENT_CLEAR, (id << 24) | (bits & 0xFFFFFF))

RS (Restart Server) ready signal. Each server calls rs_ready()
after completing initialization. The notification goes to the
RS thread which waits for it before starting the next server.

    var rs_tid = -1

    rs_set_tid(tid: int)
        rs_tid = tid

    rs_ready()
        if rs_tid >= 0
            notify_send_to(rs_tid, 1)

Packs slot (8 bits) and value (24 bits) into one syscall arg.
Slot range: 0-3. Value range: 0 to 16777215.

    tls_set(slot: int, value: int)
        syscall(SYS_TLS_SET, (slot << 24) | (value & 0xFFFFFF))

    tls_get(slot: int) -> int
        syscall(SYS_TLS_GET, slot)

    val SYS_PIMUTEX_LOCK   = 29
    val SYS_PIMUTEX_UNLOCK = 30
    val SYS_WAITPID        = 40
    val SYS_GETPID         = 41
    val SYS_THREAD_PID     = 42

    pimutex_lock_sys(addr: i64)
        syscall(SYS_PIMUTEX_LOCK, addr)

    pimutex_unlock_sys(addr: i64)
        syscall(SYS_PIMUTEX_UNLOCK, addr)

    waitpid(pid: int)
        syscall(SYS_WAITPID, pid)

    getpid() -> int
        syscall(SYS_GETPID, 0)

    get_thread_pid(id: int) -> int
        syscall(SYS_THREAD_PID, id)

    val SYS_KB_SET_NOTIFY = 64

    svc_kb_set_notify(tid: int)
        syscall(SYS_KB_SET_NOTIFY, tid)

    val SYS_VM_CREATE_SERVER_PT = 63

    svc_vm_create_server_pt(io_page: int) -> u64
        u64(syscall(SYS_VM_CREATE_SERVER_PT, io_page))

    val SYS_GETUID = 61
    val SYS_SETUID = 62

    getuid() -> int
        syscall(SYS_GETUID, 0)

    setuid(uid: int)
        syscall(SYS_SETUID, uid)

Server isolation syscalls. These allow PM and VFS to call
kernel functions through the syscall interface instead of
importing them directly.

    val SYS_VM_CREATE_PT       = 44
    val SYS_CREATE_PROC_SUSP   = 45
    val SYS_RESUME_PROC        = 46
    val SYS_REAP_PROC          = 47
    val SYS_KILL_PROC          = 48
    val SYS_REGISTER_PM        = 49
    val SYS_SET_THREAD_PTBR    = 50
    val SYS_VM_SET_PTBR_SC     = 51
    val SYS_GET_THREAD_PID     = 52
    val SYS_GET_THREAD_PTBR    = 53
    val SYS_VM_COPY_TO         = 54
    val SYS_VM_COPY_FROM       = 55
    val SYS_PROC_STATE         = 56
    val SYS_PROC_EXIT_CODE     = 57
    val SYS_PROC_MAIN_TID      = 58
    val SYS_PROC_PARENT_TID    = 59
    val SYS_PROC_SET_PARENT_TID = 60

    svc_vm_create_pt() -> u64
        u64(syscall(SYS_VM_CREATE_PT, 0))

    svc_create_proc_susp(entry: i64, usp: i64, ssp: i64, name: string, ptbr: u64) -> int
        int(syscall6(SYS_CREATE_PROC_SUSP, entry, usp, ssp, i64(*byte(name)), i64(len(name)), i64(ptbr)))

    svc_resume_proc(pid: int)
        syscall(SYS_RESUME_PROC, pid)

    svc_reap_proc(pid: int)
        syscall(SYS_REAP_PROC, pid)

    svc_kill_proc(pid: int) -> int
        syscall(SYS_KILL_PROC, pid)

    svc_register_pm(tid: int)
        syscall(SYS_REGISTER_PM, tid)

    svc_set_thread_ptbr(tid: int, ptbr: u64)
        syscall6(SYS_SET_THREAD_PTBR, i64(tid), i64(ptbr), 0, 0, 0, 0)

    svc_vm_set_ptbr(addr: u64)
        syscall(SYS_VM_SET_PTBR_SC, i64(addr))

    svc_get_thread_pid(tid: int) -> int
        syscall(SYS_GET_THREAD_PID, tid)

    svc_get_thread_ptbr(tid: int) -> u64
        u64(syscall(SYS_GET_THREAD_PTBR, tid))

    svc_vm_copy_to(dst_ptbr: u64, dst_vaddr: u64, src: *byte, vlen: int)
        syscall6(SYS_VM_COPY_TO, i64(dst_ptbr), i64(dst_vaddr), i64(src), i64(vlen), 0, 0)

    svc_vm_copy_from(src_ptbr: u64, src_vaddr: u64, dst: *byte, vlen: int)
        syscall6(SYS_VM_COPY_FROM, i64(src_ptbr), i64(src_vaddr), i64(dst), i64(vlen), 0, 0)

    svc_proc_state(pid: int) -> int
        syscall(SYS_PROC_STATE, pid)

    svc_proc_exit_code(pid: int) -> int
        syscall(SYS_PROC_EXIT_CODE, pid)

    svc_proc_main_tid(pid: int) -> int
        syscall(SYS_PROC_MAIN_TID, pid)

    svc_proc_parent_tid(pid: int) -> int
        syscall(SYS_PROC_PARENT_TID, pid)

    svc_proc_set_parent_tid(pid: int, parent_tid: int)
        syscall6(SYS_PROC_SET_PARENT_TID, i64(pid), i64(parent_tid), 0, 0, 0, 0)

Translate a virtual address to physical using the current
thread's page table. Used by drivers that need DMA addresses.

    val SYS_VM_V2P = 66

    svc_vm_v2p(vaddr: u64) -> u64
        u64(syscall(SYS_VM_V2P, i64(vaddr)))

    val SYS_PORT_TRANSFER = 68
    val SYS_SET_PRIV      = 69

    svc_set_priv(pid: int, allow_lo: i64, allow_hi: i64, ipc_mask: int)
        syscall6(SYS_SET_PRIV, i64(pid), allow_lo, allow_hi, i64(ipc_mask), 0, 0)

    svc_port_transfer(port: int, new_owner_tid: int)
        syscall6(SYS_PORT_TRANSFER, i64(port), i64(new_owner_tid), 0, 0, 0, 0)

    val SYS_SET_IPC_MASK = 70

    svc_set_ipc_mask(pid: int, mask: int)
        syscall(SYS_SET_IPC_MASK, (pid << 16) | (mask & 0xFFFF))

    val SYS_PHYS_READ = 67

    svc_phys_read(src_phys: u64, dst: *byte, vlen: int)
        syscall6(SYS_PHYS_READ, i64(src_phys), i64(dst), i64(vlen), 0, 0, 0)

Grant-based IPC. Clients create grants to allow servers
to access their memory. The kernel mediates copies.

    val SYS_GRANT_CREATE = 71
    val SYS_GRANT_REVOKE = 72
    val SYS_GRANT_COPY   = 73

    val GRANT_READ  = 1
    val GRANT_WRITE = 2
    val GRANT_RW    = 3

    svc_grant_create(vaddr: u64, len: int, flags: int) -> int
        int(syscall6(SYS_GRANT_CREATE, i64(vaddr), i64(len), i64(flags), 0, 0, 0))

    svc_grant_revoke(grant_id: int)
        syscall(SYS_GRANT_REVOKE, grant_id)

    svc_grant_copy(grant_id: int, offset: int, local_buf: *byte, len: int, direction: int) -> int
        int(syscall6(SYS_GRANT_COPY, i64(grant_id), i64(offset), i64(local_buf), i64(len), i64(direction), 0))

    val SYS_GRANT_MAP   = 74
    val SYS_GRANT_UNMAP = 75

    svc_grant_map(grant_id: int, offset: int, len: int) -> int
        int(syscall6(SYS_GRANT_MAP, i64(grant_id), i64(offset), i64(len), 0, 0, 0))

    svc_grant_unmap(grant_id: int)
        syscall(SYS_GRANT_UNMAP, grant_id)

Register caller's thread as the recipient of virtio-device IRQ
notifications. Exactly one thread at a time (last caller wins).
Pass -1 to unregister. Nic server uses this to avoid polling on
every IPC wake.

    val SYS_VIRTIO_SET_NOTIFY = 76

    svc_virtio_set_notify(tid: int)
        syscall(SYS_VIRTIO_SET_NOTIFY, tid)

System info (sys_getinfo) — replaces the per-process INFO_PAGE_VA.
Types:
  0 = RS TID
  1 = ramdisk physical base
  2 = ramdisk size in bytes
  3 = boot info blob (copy-out; buf+cap must be large enough for
      the SLIX-magic header + module entries)

    val SYS_GETINFO    = 77
    val SYS_SET_RS_TID = 78

    val GETINFO_RS_TID        = 0
    val GETINFO_RAMDISK_BASE  = 1
    val GETINFO_RAMDISK_SIZE  = 2
    val GETINFO_BOOT_INFO     = 3

    svc_getinfo(info_type: int, buf: *byte, cap: int) -> i64
        syscall6(SYS_GETINFO, i64(info_type), i64(buf), i64(cap), 0, 0, 0)

    svc_get_rs_tid() -> int
        int(syscall6(SYS_GETINFO, i64(GETINFO_RS_TID), 0, 0, 0, 0, 0))

    svc_get_ramdisk_base() -> u64
        u64(syscall6(SYS_GETINFO, i64(GETINFO_RAMDISK_BASE), 0, 0, 0, 0, 0))

    svc_get_ramdisk_size() -> u64
        u64(syscall6(SYS_GETINFO, i64(GETINFO_RAMDISK_SIZE), 0, 0, 0, 0, 0))

    svc_set_rs_tid_self()
        syscall6(SYS_SET_RS_TID, 0, 0, 0, 0, 0, 0)

Grant the POSIX syscall range (128-511) to a process. Called by
PM after spawning an ELF binary so musl-linked programs can invoke
POSIX shim syscalls without each bit being set individually.

    val SYS_GRANT_POSIX_RANGE = 79

    svc_grant_posix_range(pid: int)
        syscall6(SYS_GRANT_POSIX_RANGE, i64(pid), 0, 0, 0, 0, 0)

Fetch the virtio-pci cap addresses cached by the kernel's
one-shot PCI probe. Fills `out` (40 bytes = 5 × i64): common_pa,
notify_pa, notify_mult, isr_pa, device_pa. All zero if no
virtio-net was found or on arches without virtio-pci. x86 nic
server uses this to `v_attach_pci(...)` without needing PCI
config-space access.

Renumbered 77 → 80 during the dev→slix merge on 2026-04-24 to
avoid collision with dev's SYS_GETINFO.

    val SYS_VIRTIO_PCI_INFO = 80

    svc_virtio_pci_info(out: *byte)
        syscall(SYS_VIRTIO_PCI_INFO, i64(out))

Subscribe the calling thread to periodic timer notifications.
Returns subscription index (>=0) or -1 on failure. Every
`period` ticks the kernel fires `notify_send(tid, 2)` so a
notify_wait/ipc_recv_notify loop can drive background scans
(retransmits, TIME_WAIT expiry) without needing incoming
frames for liveness.

Renumbered 78 → 81 during the dev→slix merge to avoid
collision with dev's SYS_SET_RS_TID.

    val SYS_TIMER_SUBSCRIBE = 81

    svc_timer_subscribe(period: int) -> int
        syscall(SYS_TIMER_SUBSCRIBE, i64(period))


Bulk write to the console. The kernel handler loops `uart_putc`
in kernel context, avoiding the per-byte user/kernel transition
that `SYS_PUTC` × N incurs. Used by the TTY server so every
`puts` that reaches the UART is one syscall, not one-per-byte.

Currently registered on aarch64 only (see
`oskit/arch/aarch64/board/virt/hello.lsysl::sys_puts_handler`).
x86 is sidelined; when it's reactivated, add a parallel
handler registration there — otherwise tty_handle_puts on x86
silently fails.

Renumbered 79 → 82 during the dev→slix merge to avoid
collision with dev's SYS_GRANT_POSIX_RANGE.

    val SYS_PUTS = 82

    svc_puts(buf: *byte, len: int) -> int
        var args: [2]i64
        args[0] = i64(buf)
        args[1] = len
        syscall(SYS_PUTS, i64(args))
