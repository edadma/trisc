test_iov — writev / readv vectored I/O
========================================

POSIX writev(fd, iovec[], iovcnt) — gathered write — and readv —
scattered read — are universal vectored-I/O calls. libc's stdio
buffer flushes hit writev (multiple iovs for header + body).
libuv's TCP send/recv path uses both routinely.

Test:
  1. Listen 127.0.0.1:9103, connect, accept.
  2. writev(client, [{"X","Y","Z"}], 3) on TCP — total 3 bytes.
  3. read on child returns "XYZ".
  4. write(child, "abcd", 4).
  5. readv(client, [{2-byte buf, 2-byte buf}], 2) — total 4.
     First iov gets "ab", second gets "cd".

Pass = `iov: ok`.

    module oskit.bin.test_iov

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_WRITE      = 128
    val NR_READ       = 130
    val NR_ACCEPT     = 131
    val NR_BIND       = 135
    val NR_CLOSE      = 147
    val NR_CONNECT    = 148
    val NR_LISTEN     = 217
    val NR_READV      = 274
    val NR_WRITEV     = 372
    val NR_SOCKET     = 337

    val AF_INET_V     = 2
    val SOCK_STREAM_V = 1


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("iov: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    write_ptr_le(p: *byte, off: int, v: i64)
        var i = 0
        while i < 8
            p[off + i] = byte(int((v >> i64(i * 8))) & 0xff)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_accept(fd: int, addr: *byte, addrlen: *int) -> int
        int(syscall6(NR_ACCEPT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_write(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_WRITE, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_read(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_READ, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_writev(fd: int, iov: *byte, iovcnt: int) -> int
        int(syscall6(NR_WRITEV, i64(fd), i64(iov), i64(iovcnt), 0, 0, 0))

    posix_readv(fd: int, iov: *byte, iovcnt: int) -> int
        int(syscall6(NR_READV, i64(fd), i64(iov), i64(iovcnt), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val ls = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if ls < 0
            fail_with(1)
            return
        var bind_addr: [16]byte
        fill_sockaddr(&bind_addr[0], 9103, 0, 0, 0, 0)
        if posix_bind(ls, &bind_addr[0], 16) != 0
            fail_with(2)
            return
        if posix_listen(ls, 4) != 0
            fail_with(3)
            return

        val cl = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if cl < 0
            fail_with(4)
            return
        var conn_addr: [16]byte
        fill_sockaddr(&conn_addr[0], 9103, 127, 0, 0, 1)
        if posix_connect(cl, &conn_addr[0], 16) != 0
            fail_with(5)
            return

        var peer: [16]byte
        var peer_len = 16
        val ch = posix_accept(ls, &peer[0], &peer_len)
        if ch < 0
            fail_with(6)
            return

        // Build 3 single-byte iovs pointing at 'X', 'Y', 'Z'.
        var bX: [1]byte
        bX[0] = byte('X')
        var bY: [1]byte
        bY[0] = byte('Y')
        var bZ: [1]byte
        bZ[0] = byte('Z')
        var iov_w: [48]byte
        write_ptr_le(&iov_w[0], 0, i64(&bX[0]))
        write_ptr_le(&iov_w[0], 8, i64(1))
        write_ptr_le(&iov_w[0], 16, i64(&bY[0]))
        write_ptr_le(&iov_w[0], 24, i64(1))
        write_ptr_le(&iov_w[0], 32, i64(&bZ[0]))
        write_ptr_le(&iov_w[0], 40, i64(1))
        if posix_writev(cl, &iov_w[0], 3) != 3
            fail_with(7)
            return

        var rbuf: [3]byte
        var got = 0
        while got < 3
            val r = posix_read(ch, &rbuf[got], 3 - got)
            if r <= 0
                fail_with(8)
                return
            got += r
        if rbuf[0] != byte('X')
            fail_with(9)
            return
        if rbuf[1] != byte('Y')
            fail_with(10)
            return
        if rbuf[2] != byte('Z')
            fail_with(11)
            return

        // Now child writes "abcd"; client readv splits across two iovs.
        var m2: [4]byte
        m2[0] = byte('a')
        m2[1] = byte('b')
        m2[2] = byte('c')
        m2[3] = byte('d')
        if posix_write(ch, &m2[0], 4) != 4
            fail_with(12)
            return

        var p1: [2]byte
        var p2: [2]byte
        var iov_r: [32]byte
        write_ptr_le(&iov_r[0], 0, i64(&p1[0]))
        write_ptr_le(&iov_r[0], 8, i64(2))
        write_ptr_le(&iov_r[0], 16, i64(&p2[0]))
        write_ptr_le(&iov_r[0], 24, i64(2))
        var rgot = 0
        while rgot < 4
            val r = posix_readv(cl, &iov_r[0], 2)
            if r <= 0
                fail_with(13)
                return
            rgot += r
        if rgot != 4
            fail_with(14)
            return
        if p1[0] != byte('a')
            fail_with(15)
            return
        if p1[1] != byte('b')
            fail_with(16)
            return
        if p2[0] != byte('c')
            fail_with(17)
            return
        if p2[1] != byte('d')
            fail_with(18)
            return

        posix_close(ch)
        posix_close(cl)
        posix_close(ls)
        puts("iov: ok\n")
        exit()
