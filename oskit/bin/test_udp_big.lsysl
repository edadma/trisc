test_udp_big — UDP datagram larger than 512 bytes
====================================================

Sanity check that the bumped UDP datagram cap (512 → 1472)
actually works end-to-end through sendto / recvfrom. Sends a
1024-byte UDP datagram via 127.0.0.1 loopback and verifies the
full body comes back unchanged.

Body pattern: byte i = (i & 0xff). Catches truncation at the
old 512 boundary and any buffer-overrun corruption.

Prints `udpbig: ok` on pass or `udpbig: bad <step>` on failure.

    module oskit.bin.test_udp_big

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE      = 147
    val NR_BIND       = 135
    val NR_RECVFROM   = 276
    val NR_SENDTO     = 307
    val NR_SOCKET     = 337

    val AF_INET_V     = 2
    val SOCK_DGRAM_V  = 2

    val MSG_LEN       = 1024


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("udpbig: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_sendto(fd: int, buf: *byte, blen: int, flags: int,
                 addr: *byte, addrlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen)))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
                   addr: *byte, addrlen_ptr: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_ptr)))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val rx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if rx < 0
            fail_with(1)
            return
        var rx_addr: [16]byte
        fill_sockaddr(&rx_addr[0], 7797, 0, 0, 0, 0)
        if posix_bind(rx, &rx_addr[0], 16) < 0
            fail_with(2)
            return

        val tx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if tx < 0
            fail_with(3)
            return

        var dst: [16]byte
        fill_sockaddr(&dst[0], 7797, 127, 0, 0, 1)
        var msg: [1024]byte
        var i = 0
        while i < MSG_LEN
            msg[i] = byte(i & 0xff)
            i += 1
        val sent = posix_sendto(tx, &msg[0], MSG_LEN, 0, &dst[0], 16)
        if sent != MSG_LEN
            fail_with(4)
            return

        var rbuf: [1500]byte
        var src: [16]byte
        var src_len: i32 = i32(16)
        val got = posix_recvfrom(rx, &rbuf[0], 1500, 0, &src[0], &src_len)
        if got != MSG_LEN
            fail_with(5)
            return

        i = 0
        while i < MSG_LEN
            if rbuf[i] != byte(i & 0xff)
                fail_with(6)
                return
            i += 1

        posix_close(tx)
        posix_close(rx)
        puts("udpbig: ok\n")
        exit()
