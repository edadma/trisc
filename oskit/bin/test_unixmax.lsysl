test_unixmax — AF_UNIX socket-pool exhaustion
================================================

Phase 0c chunk 3: validates the unix server's
`UNIX_MAX_SOCKETS = 16` slot pool. Loops `socket(AF_UNIX, DGRAM)`
until the server returns -ENOMEM, then verifies that closing one
socket frees the slot for reuse.

The unix server's slot pool is global, not per-process. Slots
held by other processes at test launch (nsh holds none today,
but defensive headroom is wise) reduce the observed count.

Test plan
---------

  1. socket(AF_UNIX, SOCK_DGRAM, 0) in a loop. Each success
     records the fd. The Nth call past the cap returns the unix
     server's -ENOMEM (-12) — *not* -EMFILE (-24), since the
     unix server's slot pool fills before the per-process posix
     fd-table.
  2. Success count should be in [10, 16] — defensive band
     around the expected 16 to account for any slots held by
     other processes.
  3. Close one fd. Reallocate — must succeed.
  4. Close everything. Print `unixmax: ok`.

Pass criterion: prints `unixmax: ok`.

    module oskit.bin.test_unixmax

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE  = 147
    val NR_SOCKET = 337

    val AF_UNIX_V    = 1
    val SOCK_DGRAM_V = 2

    val ENOMEM_V = 12
    val EMFILE_V = 24


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixmax: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    main(argv: []string)
        var fds: [32]int
        var n = 0

Step 1: allocate AF_UNIX DGRAM sockets until exhaustion.

        while n < 32
            val r = int(syscall6(NR_SOCKET, i64(AF_UNIX_V), i64(SOCK_DGRAM_V), i64(0), i64(0), i64(0), i64(0)))
            if r < 0
                if r != -ENOMEM_V
                    puts("unixmax: unexpected errno ")
                    print_idec(r)
                    puts("\n")
                    fail(1)
                    return
                if n < 10
                    puts("unixmax: cap too low: ")
                    print_idec(n)
                    puts("\n")
                    fail(2)
                    return
                if n > 16
                    puts("unixmax: cap too high: ")
                    print_idec(n)
                    puts("\n")
                    fail(3)
                    return
                break
            fds[n] = r
            n += 1

        if n >= 32
            puts("unixmax: loop exhausted without ENOMEM; cap regressed?\n")
            fail(4)
            return

Step 2: close one fd, verify next allocation succeeds.

        val cr = int(syscall6(NR_CLOSE, i64(fds[0]), i64(0), i64(0), i64(0), i64(0), i64(0)))
        if cr != 0
            puts("unixmax: close returned ")
            print_idec(cr)
            puts("\n")
            fail(5)
            return

        val refd = int(syscall6(NR_SOCKET, i64(AF_UNIX_V), i64(SOCK_DGRAM_V), i64(0), i64(0), i64(0), i64(0)))
        if refd < 0
            puts("unixmax: realloc after close returned ")
            print_idec(refd)
            puts("\n")
            fail(6)
            return
        fds[0] = refd

Step 3: clean up.

        var i = 0
        while i < n
            syscall6(NR_CLOSE, i64(fds[i]), i64(0), i64(0), i64(0), i64(0), i64(0))
            i += 1

        puts("unixmax: ok\n")
        exit()
