grep — search for lines matching a pattern
=============================================

Filters input lines containing a substring match.

Usage: `grep pattern [file]`
- With file argument: reads from the file.
- Without file argument: reads from stdin (handle 0).

Outputs each matching line to stdout (handle 1).

    module oskit.bin.grep

    import oskit.ulib.{open, read, close, puts, exit, get_args, skip_arg0, write_handle, STDIN, STDOUT}

    val GREP_BUF_SIZE = 4096

Check if `haystack` (length hlen) contains `needle` (length nlen)
as a substring. Returns 1 if found, 0 otherwise.

    contains(haystack: *byte, hlen: int, needle: *byte, nlen: int) -> int
        if nlen == 0
            return 1
        if nlen > hlen
            return 0
        var i = 0
        while i <= hlen - nlen
            var j = 0
            while j < nlen
                if haystack[i + j] != needle[j]
                    break
                j += 1
            if j == nlen
                return 1
            i += 1
        0

Process a buffer of input, printing lines that contain pattern.
Handles partial lines at the end by returning the offset of the
last unprocessed bytes.

    grep_buf(buf: *byte, buflen: int, pattern: *byte, plen: int) -> int
        var line_start = 0
        var i = 0
        while i < buflen
            if buf[i] == 10  // newline
                val line_len = i - line_start
                if contains(buf + line_start, line_len, pattern, plen) == 1
                    write_handle(STDOUT, buf + line_start, line_len + 1)
                line_start = i + 1
            i += 1
        line_start

    main()
        val args = get_args()
        val rest = skip_arg0(args)

        // Parse pattern (first word)
        val rp = *byte(rest)
        val rlen = len(rest)
        var pattern_end = 0
        while pattern_end < rlen
            if rp[pattern_end] == 32  // space
                break
            pattern_end += 1
        if pattern_end == 0
            puts("usage: grep pattern [file]\n")
            exit()
            return

        val pattern = rp
        val plen = pattern_end

        // Check for file argument
        var file_start = pattern_end
        while file_start < rlen
            if rp[file_start] != 32
                break
            file_start += 1

        var fid = -1
        if file_start < rlen
            // File argument given
            val file_path = string(rp + file_start, rlen - file_start)
            fid = open(file_path)
            if fid < 0
                puts(file_path)
                puts(": not found\n")
                exit()
                return
        else
            // No file — read from stdin
            fid = STDIN

        // Read and grep
        var buf: [4096]byte
        var nr = read(fid, buf, GREP_BUF_SIZE)
        while nr > 0
            val consumed = grep_buf(buf, nr, pattern, plen)
            // Move leftover bytes to start
            var leftover = nr - consumed
            var j = 0
            while j < leftover
                buf[j] = buf[consumed + j]
                j += 1
            nr = read(fid, &buf[leftover], GREP_BUF_SIZE - leftover)
            if nr > 0
                nr += leftover
            else if leftover > 0
                // Process final partial line
                if contains(buf, leftover, pattern, plen) == 1
                    write_handle(STDOUT, buf, leftover)
                    write_handle(STDOUT, *byte("\n"), 1)

        if fid != STDIN
            close(fid)
        exit()
