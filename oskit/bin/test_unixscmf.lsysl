test_unixscmf — file fd through AF_UNIX SCM_RIGHTS
====================================================

Validates Phase 2B chunk 4 — STREAM SCM_RIGHTS now carries
`POSIX_FD_FILE` tuples, with vfs's new `oft_queued_refs` counter
keeping the underlying OFT entry alive across the
sender-closes / receiver-drains race.

Test plan
---------

Single-process choreography:

1. Unix STREAM pair on path "SCFL" (listen/connect/accept).
2. `openat("/etc/passwd")` — file fd `fdf`. The OFT entry
   underneath is what `oft_queued_refs` will track.
3. `sendmsg(uc, "go", cmsg=[fdf])`. Sender shim does
   `VFS_CMD_OFT_QUEUE_REF_BY_HANDLE(+1)` to bump the OFT's
   queued_refs and grab the OFT idx for the cmsg payload.
4. `close(fdf)`. `vfs_oft_free` decrements `oft_ref` to 0 but
   skips the type-specific close-end action because
   `oft_queued_refs > 0` — the OFT survives.
5. `recvmsg(us)` returns "go" + a fresh `fdf2`. Receiver shim
   calls `VFS_CMD_REGISTER_FD_BY_OFT(my_pid, oft_idx)` to mint
   the new handle, then `VFS_CMD_OFT_QUEUE_REF(-1)` to
   balance.
6. `read(fdf2, ...)` returns the first 5 bytes of /etc/passwd
   ("root:"). The OFT survived the close-before-drain; the
   resurrected handle reads from the same backing file.

Pass criterion: prints `unixscmf: ok`.

    module oskit.bin.test_unixscmf

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_BIND       = 135
    val NR_CONNECT    = 148
    val NR_LISTEN     = 217
    val NR_ACCEPT     = 131
    val NR_CLOSE      = 147
    val NR_SOCKET     = 337
    val NR_RECVMSG    = 278
    val NR_SENDMSG    = 306
    val NR_READ       = 130
    val NR_OPENAT     = 254

    val AF_UNIX_V     = 1
    val SOCK_STREAM_V = 1

    val SOL_SOCKET_V  = 1
    val SCM_RIGHTS_V  = 1

    val AT_FDCWD      = -100
    val O_RDONLY      = 0


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixscmf: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, plen: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < plen
            out[2 + i] = path[i]
            i += 1
        out[2 + plen] = byte(0)
        2 + plen + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_accept(fd: int, addr: *byte, alp: *i32) -> int
        int(syscall6(NR_ACCEPT, i64(fd), i64(addr), i64(alp), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_sendmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_SENDMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))

    posix_recvmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_RECVMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))

    posix_read(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_READ, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_openat(dirfd: int, path: *byte, oflags: int, mode: int) -> int
        int(syscall6(NR_OPENAT, i64(dirfd), i64(path),
            i64(oflags), i64(mode), 0, 0))


    write_i64(p: *byte, off: int, v: i64)
        var i = 0
        while i < 8
            p[off + i] = byte((v >> (i * 8)) & i64(0xff))
            i += 1

    write_i32(p: *byte, off: int, v: int)
        p[off]     = byte(v & 0xff)
        p[off + 1] = byte((v >> 8) & 0xff)
        p[off + 2] = byte((v >> 16) & 0xff)
        p[off + 3] = byte((v >> 24) & 0xff)

    read_i32(p: *byte, off: int) -> int
        val b0 = int(p[off]) & 0xff
        val b1 = int(p[off + 1]) & 0xff
        val b2 = int(p[off + 2]) & 0xff
        val b3 = int(p[off + 3]) & 0xff
        b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)


    main(argv: []string)

Step 1 — unix STREAM pair on "SCFL".

        var nm: [4]byte
        nm[0] = 'S'; nm[1] = 'C'; nm[2] = 'F'; nm[3] = 'L'
        var sa: [128]byte
        val al = fill_sockaddr_un(&sa[0], &nm[0], 4)

        val ul = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if ul < 0
            fail(1)
            return
        if posix_bind(ul, &sa[0], al) != 0
            fail(2)
            return
        if posix_listen(ul, 4) != 0
            fail(3)
            return
        val uc = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if uc < 0
            fail(4)
            return
        if posix_connect(uc, &sa[0], al) != 0
            fail(5)
            return
        var aa: [128]byte
        var aal: i32 = 128
        val us = posix_accept(ul, &aa[0], &aal)
        if us < 0
            fail(6)
            return

Step 2 — open /etc/passwd.

        var path: [12]byte
        path[0] = '/'; path[1] = 'e'; path[2] = 't'; path[3] = 'c'
        path[4] = '/'; path[5] = 'p'; path[6] = 'a'; path[7] = 's'
        path[8] = 's'; path[9] = 'w'; path[10] = 'd'; path[11] = byte(0)
        val fdf = posix_openat(AT_FDCWD, &path[0], O_RDONLY, 0)
        if fdf < 0
            fail(7)
            return

Step 3 — sendmsg(uc, "go", cmsg=[fdf]).

        var ctrl_send: [32]byte
        write_i64(&ctrl_send[0], 0, i64(20))
        write_i32(&ctrl_send[0], 8, SOL_SOCKET_V)
        write_i32(&ctrl_send[0], 12, SCM_RIGHTS_V)
        write_i32(&ctrl_send[0], 16, fdf)

        var msg_payload: [2]byte
        msg_payload[0] = 'g'; msg_payload[1] = 'o'

        var send_iov: [16]byte
        write_i64(&send_iov[0], 0, i64(&msg_payload[0]))
        write_i64(&send_iov[0], 8, i64(2))

        var send_mh: [56]byte
        write_i64(&send_mh[0], 0, i64(0))
        write_i32(&send_mh[0], 8, 0)
        write_i32(&send_mh[0], 12, 0)
        write_i64(&send_mh[0], 16, i64(&send_iov[0]))
        write_i32(&send_mh[0], 24, 1)
        write_i32(&send_mh[0], 28, 0)
        write_i64(&send_mh[0], 32, i64(&ctrl_send[0]))
        write_i32(&send_mh[0], 40, 20)
        write_i32(&send_mh[0], 44, 0)
        write_i32(&send_mh[0], 48, 0)

        val ns = posix_sendmsg(uc, &send_mh[0], 0)
        if ns != 2
            puts("unixscmf: scm sendmsg ")
            print_idec(ns)
            puts("\n")
            fail(8)
            return

Step 4 — close fdf BEFORE drain. The OFT survives via
`oft_queued_refs > 0`.

        if posix_close(fdf) != 0
            fail(9)
            return

Step 5 — recvmsg(us) returns "go" + cmsg=[fdf2].

        var recv_payload: [16]byte
        var recv_iov: [16]byte
        write_i64(&recv_iov[0], 0, i64(&recv_payload[0]))
        write_i64(&recv_iov[0], 8, i64(16))
        var ctrl_recv: [32]byte
        var recv_mh: [56]byte
        write_i64(&recv_mh[0], 0, i64(0))
        write_i32(&recv_mh[0], 8, 0)
        write_i32(&recv_mh[0], 12, 0)
        write_i64(&recv_mh[0], 16, i64(&recv_iov[0]))
        write_i32(&recv_mh[0], 24, 1)
        write_i32(&recv_mh[0], 28, 0)
        write_i64(&recv_mh[0], 32, i64(&ctrl_recv[0]))
        write_i32(&recv_mh[0], 40, 32)
        write_i32(&recv_mh[0], 44, 0)
        write_i32(&recv_mh[0], 48, 0)
        val nr = posix_recvmsg(us, &recv_mh[0], 0)
        if nr != 2
            puts("unixscmf: scm recvmsg ")
            print_idec(nr)
            puts("\n")
            fail(10)
            return
        if recv_payload[0] != 'g'
            fail(11)
            return
        if recv_payload[1] != 'o'
            fail(12)
            return

        val ctrl_used = read_i32(&recv_mh[0], 40)
        if ctrl_used != 20
            puts("unixscmf: ctrl_used ")
            print_idec(ctrl_used)
            puts("\n")
            fail(13)
            return
        val cmsg_level = read_i32(&ctrl_recv[0], 8)
        val cmsg_type  = read_i32(&ctrl_recv[0], 12)
        if cmsg_level != SOL_SOCKET_V
            fail(14)
            return
        if cmsg_type != SCM_RIGHTS_V
            fail(15)
            return
        val fdf2 = read_i32(&ctrl_recv[0], 16)
        if fdf2 < 0
            fail(16)
            return

Step 6 — read first 5 bytes through the resurrected fd.

        var rb: [5]byte
        var got = 0
        while got < 5
            val r = posix_read(fdf2, &rb[got], 5 - got)
            if r <= 0
                puts("unixscmf: read=")
                print_idec(r)
                puts("\n")
                fail(17)
                return
            got += r
        if rb[0] != 'r'
            fail(18)
            return
        if rb[1] != 'o'
            fail(19)
            return
        if rb[2] != 'o'
            fail(20)
            return
        if rb[3] != 't'
            fail(21)
            return
        if rb[4] != ':'
            fail(22)
            return

        posix_close(fdf2)
        posix_close(us)
        posix_close(uc)
        posix_close(ul)
        puts("unixscmf: ok\n")
        exit()
