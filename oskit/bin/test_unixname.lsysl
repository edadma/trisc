test_unixname — getsockname/getpeername on AF_UNIX
===================================================

Validates AF_UNIX `getsockname(2)` and `getpeername(2)`.

Cases:
  1. STREAM bound: getsockname returns the bound path.
  2. STREAM connected, server end: getsockname returns the
     listener's path; getpeername returns the connector's
     bound path.
  3. STREAM connected, client end: getpeername returns the
     listener's path; getsockname returns the client's
     bound path.
  4. DGRAM bound: getsockname returns bound path.
  5. DGRAM unconnected: getpeername returns -ENOTCONN.
  6. STREAM unbound (just socket()): getsockname returns
     empty path with addrlen=2.
  7. STREAM listener: getpeername returns -ENOTCONN.

Pass criterion: prints `unixname: ok`.

    module oskit.bin.test_unixname

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_ACCEPT     = 131
    val NR_BIND       = 135
    val NR_CLOSE      = 147
    val NR_CONNECT    = 148
    val NR_GETPEERNAME = 192
    val NR_GETSOCKNAME = 203
    val NR_LISTEN     = 217
    val NR_SOCKET     = 337

    val AF_UNIX_V     = 1
    val SOCK_STREAM_V = 1
    val SOCK_DGRAM_V  = 2

    val ENOTCONN_V    = 107


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixname: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, path_len: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < path_len
            out[2 + i] = path[i]
            i += 1
        out[2 + path_len] = byte(0)
        2 + path_len + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_accept(fd: int, addr: *byte, addrlen_p: *i32) -> int
        int(syscall6(NR_ACCEPT, i64(fd), i64(addr), i64(addrlen_p), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_getsockname(fd: int, addr: *byte, alp: *i32) -> int
        int(syscall6(NR_GETSOCKNAME, i64(fd), i64(addr), i64(alp), 0, 0, 0))

    posix_getpeername(fd: int, addr: *byte, alp: *i32) -> int
        int(syscall6(NR_GETPEERNAME, i64(fd), i64(addr), i64(alp), 0, 0, 0))


Path-equality helper: compare `n` bytes of the sockaddr's
sun_path (offset 2) against expected. Returns 1 on match.

    sun_path_eq(addr: *byte, expected: *byte, n: int) -> int
        var i = 0
        while i < n
            if addr[2 + i] != expected[i]
                return 0
            i += 1
        1


    main(argv: []string)

Case 1+6: STREAM unbound socket → empty path, addrlen=2.
Then bind it and re-query → expected path.

        val a = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if a < 0
            fail(1)
            return

        var addr_buf: [128]byte
        var alen: i32 = 128
        if posix_getsockname(a, &addr_buf[0], &alen) != 0
            fail(2)
            return
        if addr_buf[0] != byte(AF_UNIX_V)
            fail(3)
            return
        if alen != i32(2)
            puts("unixname: empty alen=")
            print_idec(int(alen))
            puts("\n")
            fail(4)
            return

        var path_a: [2]byte
        path_a[0] = 'A'; path_a[1] = 'A'
        var sa_a: [128]byte
        val al_a = fill_sockaddr_un(&sa_a[0], &path_a[0], 2)
        if posix_bind(a, &sa_a[0], al_a) != 0
            fail(5)
            return

        alen = 128
        if posix_getsockname(a, &addr_buf[0], &alen) != 0
            fail(6)
            return
        if alen != i32(5)
            puts("unixname: bound alen=")
            print_idec(int(alen))
            puts("\n")
            fail(7)
            return
        if sun_path_eq(&addr_buf[0], &path_a[0], 2) == 0
            fail(8)
            return
        if addr_buf[4] != byte(0)
            fail(9)
            return

Case 2+3+7: STREAM listener bound to "BB"; connector bound
to "CC" then connect; accept yields server_end. Verify all
four name queries.

        val l = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if l < 0
            fail(10)
            return
        var path_l: [2]byte
        path_l[0] = 'B'; path_l[1] = 'B'
        var sa_l: [128]byte
        val al_l = fill_sockaddr_un(&sa_l[0], &path_l[0], 2)
        if posix_bind(l, &sa_l[0], al_l) != 0
            fail(11)
            return
        if posix_listen(l, 4) != 0
            fail(12)
            return

Case 7: getpeername on listener → -ENOTCONN.

        if posix_getpeername(l, &addr_buf[0], &alen) != -ENOTCONN_V
            fail(13)
            return

        val cl = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if cl < 0
            fail(14)
            return
        var path_c: [2]byte
        path_c[0] = 'C'; path_c[1] = 'C'
        var sa_c: [128]byte
        val al_c = fill_sockaddr_un(&sa_c[0], &path_c[0], 2)
        if posix_bind(cl, &sa_c[0], al_c) != 0
            fail(15)
            return
        if posix_connect(cl, &sa_l[0], al_l) != 0
            fail(16)
            return

        var peer_addr: [128]byte
        var peer_alen: i32 = 128
        val sv = posix_accept(l, &peer_addr[0], &peer_alen)
        if sv < 0
            fail(17)
            return

Case 2: getsockname(server_end) → "BB" (listener path).

        alen = 128
        if posix_getsockname(sv, &addr_buf[0], &alen) != 0
            fail(18)
            return
        if alen != i32(5)
            puts("unixname: sv-name alen=")
            print_idec(int(alen))
            puts("\n")
            fail(19)
            return
        if sun_path_eq(&addr_buf[0], &path_l[0], 2) == 0
            fail(20)
            return

Case 2: getpeername(server_end) → "CC" (connector path).

        alen = 128
        if posix_getpeername(sv, &addr_buf[0], &alen) != 0
            fail(21)
            return
        if alen != i32(5)
            puts("unixname: sv-peer alen=")
            print_idec(int(alen))
            puts("\n")
            fail(22)
            return
        if sun_path_eq(&addr_buf[0], &path_c[0], 2) == 0
            fail(23)
            return

Case 3: getpeername(client) → "BB" (listener path, since the
server end now carries it via the accept-time copy).

        alen = 128
        if posix_getpeername(cl, &addr_buf[0], &alen) != 0
            fail(24)
            return
        if alen != i32(5)
            puts("unixname: cl-peer alen=")
            print_idec(int(alen))
            puts("\n")
            fail(25)
            return
        if sun_path_eq(&addr_buf[0], &path_l[0], 2) == 0
            fail(26)
            return

Case 3: getsockname(client) → "CC".

        alen = 128
        if posix_getsockname(cl, &addr_buf[0], &alen) != 0
            fail(27)
            return
        if alen != i32(5)
            puts("unixname: cl-name alen=")
            print_idec(int(alen))
            puts("\n")
            fail(28)
            return
        if sun_path_eq(&addr_buf[0], &path_c[0], 2) == 0
            fail(29)
            return

        posix_close(sv)
        posix_close(cl)
        posix_close(l)
        posix_close(a)

Case 4+5: DGRAM bound + getpeername unconnected → -ENOTCONN.

        val g = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if g < 0
            fail(30)
            return
        var path_g: [2]byte
        path_g[0] = 'G'; path_g[1] = 'G'
        var sa_g: [128]byte
        val al_g = fill_sockaddr_un(&sa_g[0], &path_g[0], 2)
        if posix_bind(g, &sa_g[0], al_g) != 0
            fail(31)
            return
        alen = 128
        if posix_getsockname(g, &addr_buf[0], &alen) != 0
            fail(32)
            return
        if alen != i32(5)
            fail(33)
            return
        if sun_path_eq(&addr_buf[0], &path_g[0], 2) == 0
            fail(34)
            return
        if posix_getpeername(g, &addr_buf[0], &alen) != -ENOTCONN_V
            fail(35)
            return
        posix_close(g)

        puts("unixname: ok\n")
        exit()
