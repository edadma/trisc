test_unixemf — recvmsg cleans up SCM_RIGHTS slots on EMFILE
=============================================================

Validates the EMFILE-on-recvmsg cleanup fix: when the
receiver's posix_fd_table is full and `posix_fd_alloc`
fails for an SCM_RIGHTS-transferred slot, the shim sends
`UNIX_CMD_CLOSE` to release the receiver's co-ownership.
Combined with the original sender closing its handle, that
frees the unix-server slot — no leak across the failure
boundary.

Test plan
---------

  1. Open `alpha`, `beta`, `gamma`. Bind alpha→"EMA",
     beta→"EMB", gamma→"EMG".
  2. Open dummy AF_UNIX DGRAM sockets in a loop until
     `socket()` returns -EMFILE — fills posix_fd_table.
  3. `sendmsg(alpha → "EMB", payload + cmsg=[gamma])` —
     queues gamma's slot index for transfer.
  4. `recvmsg(beta)` — payload arrives but the cmsg has 0
     fds (every posix_fd_alloc fails). The shim should
     have issued `UNIX_CMD_CLOSE` for the transferred slot,
     releasing the receiver's co-ownership.
  5. `close(gamma)` — drops the original handle. With
     the receiver's co-ownership released in step 4, the
     unix-server slot now has owners_count=0 and
     `unix_full_close` clears `bound_path`.
  6. Close two dummy sockets to free posix_fd entries.
  7. Open a fresh socket and `bind` it to "EMG" — should
     succeed iff the slot was correctly cleaned up. If the
     fix were missing, the path would still be bound by the
     leaked slot and bind would fail with EADDRINUSE.

Pass criterion: prints `unixemf: ok`.

    module oskit.bin.test_unixemf

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE      = 147
    val NR_BIND       = 135
    val NR_EVENTFD2   = 156
    val NR_RECVMSG    = 278
    val NR_SENDMSG    = 306
    val NR_SOCKET     = 337

    val AF_UNIX_V     = 1
    val SOCK_DGRAM_V  = 2

    val SOL_SOCKET_V  = 1
    val SCM_RIGHTS_V  = 1


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixemf: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, path_len: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < path_len
            out[2 + i] = path[i]
            i += 1
        out[2 + path_len] = byte(0)
        2 + path_len + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_sendmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_SENDMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))

    posix_recvmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_RECVMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))

    posix_eventfd2(initval: int, flags: int) -> int
        int(syscall6(NR_EVENTFD2, i64(initval), i64(flags), 0, 0, 0, 0))


    write_i64(p: *byte, off: int, v: i64)
        var i = 0
        while i < 8
            p[off + i] = byte((v >> (i * 8)) & i64(0xff))
            i += 1


    write_i32(p: *byte, off: int, v: int)
        p[off]     = byte(v & 0xff)
        p[off + 1] = byte((v >> 8) & 0xff)
        p[off + 2] = byte((v >> 16) & 0xff)
        p[off + 3] = byte((v >> 24) & 0xff)


    read_i32(p: *byte, off: int) -> int
        (int(p[off]) & 0xff) | ((int(p[off + 1]) & 0xff) << 8) | ((int(p[off + 2]) & 0xff) << 16) | ((int(p[off + 3]) & 0xff) << 24)


    main(argv: []string)

Step 1: open three working sockets and bind each to a path.

        val alpha = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if alpha < 0
            fail(1)
            return
        val beta = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if beta < 0
            fail(2)
            return
        val gamma = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if gamma < 0
            fail(3)
            return

        var path_a: [3]byte
        path_a[0] = 'E'; path_a[1] = 'M'; path_a[2] = 'A'
        var path_b: [3]byte
        path_b[0] = 'E'; path_b[1] = 'M'; path_b[2] = 'B'
        var path_g: [3]byte
        path_g[0] = 'E'; path_g[1] = 'M'; path_g[2] = 'G'

        var sa_a: [128]byte
        val al_a = fill_sockaddr_un(&sa_a[0], &path_a[0], 3)
        if posix_bind(alpha, &sa_a[0], al_a) != 0
            fail(4)
            return
        var sa_b: [128]byte
        val al_b = fill_sockaddr_un(&sa_b[0], &path_b[0], 3)
        if posix_bind(beta, &sa_b[0], al_b) != 0
            fail(5)
            return
        var sa_g: [128]byte
        val al_g = fill_sockaddr_un(&sa_g[0], &path_g[0], 3)
        if posix_bind(gamma, &sa_g[0], al_g) != 0
            fail(6)
            return

Step 2: fill the posix_fd_table with `eventfd` slots —
they're not capped by a per-server slot limit (unlike
AF_UNIX which caps at 16 server-side), so we can push the
table to its real ceiling (POSIX_FDS_PER_PROC = 64) and
guarantee `posix_fd_alloc` fails on the recvmsg path.

        var dummies: [80]int
        var n_dummies = 0
        while n_dummies < 80
            val d = posix_eventfd2(0, 0)
            if d < 0
                break
            dummies[n_dummies] = d
            n_dummies += 1
        if n_dummies < 30
            puts("unixemf: dummies=")
            print_idec(n_dummies)
            puts("\n")
            fail(7)
            return

Step 3: sendmsg(alpha → beta, cmsg=[gamma]).

        var ctrl_send: [32]byte
        write_i64(&ctrl_send[0], 0, i64(20))
        write_i32(&ctrl_send[0], 8, SOL_SOCKET_V)
        write_i32(&ctrl_send[0], 12, SCM_RIGHTS_V)
        write_i32(&ctrl_send[0], 16, gamma)

        var send_payload: [4]byte
        send_payload[0] = 'h'; send_payload[1] = 'e'
        send_payload[2] = 'l'; send_payload[3] = 'o'

        var send_iov: [16]byte
        write_i64(&send_iov[0], 0, i64(&send_payload[0]))
        write_i64(&send_iov[0], 8, i64(4))

        var send_mh: [56]byte
        write_i64(&send_mh[0], 0, i64(&sa_b[0]))
        write_i32(&send_mh[0], 8, al_b)
        write_i32(&send_mh[0], 12, 0)
        write_i64(&send_mh[0], 16, i64(&send_iov[0]))
        write_i32(&send_mh[0], 24, 1)
        write_i32(&send_mh[0], 28, 0)
        write_i64(&send_mh[0], 32, i64(&ctrl_send[0]))
        write_i32(&send_mh[0], 40, 20)
        write_i32(&send_mh[0], 44, 0)
        write_i32(&send_mh[0], 48, 0)

        val ns = posix_sendmsg(alpha, &send_mh[0], 0)
        if ns != 4
            puts("unixemf: sendmsg=")
            print_idec(ns)
            puts("\n")
            fail(8)
            return

Step 4: recvmsg on beta. Payload should arrive but cmsg
should report 0 fds because posix_fd_alloc fails.

        var recv_payload: [8]byte
        var src_addr: [128]byte

        var recv_iov: [16]byte
        write_i64(&recv_iov[0], 0, i64(&recv_payload[0]))
        write_i64(&recv_iov[0], 8, i64(8))

        var ctrl_recv: [32]byte
        var recv_mh: [56]byte
        write_i64(&recv_mh[0], 0, i64(&src_addr[0]))
        write_i32(&recv_mh[0], 8, 128)
        write_i32(&recv_mh[0], 12, 0)
        write_i64(&recv_mh[0], 16, i64(&recv_iov[0]))
        write_i32(&recv_mh[0], 24, 1)
        write_i32(&recv_mh[0], 28, 0)
        write_i64(&recv_mh[0], 32, i64(&ctrl_recv[0]))
        write_i32(&recv_mh[0], 40, 32)
        write_i32(&recv_mh[0], 44, 0)
        write_i32(&recv_mh[0], 48, 0)

        val nr = posix_recvmsg(beta, &recv_mh[0], 0)
        if nr != 4
            puts("unixemf: recvmsg=")
            print_idec(nr)
            puts("\n")
            fail(9)
            return
        if recv_payload[0] != 'h' || recv_payload[3] != 'o'
            fail(10)
            return

The shim should have failed posix_fd_alloc for the
transferred slot (table is full) and emitted UNIX_CMD_CLOSE
in cleanup. ctrl_used should be 0 since no fd was granted.

        val ctrl_used = read_i32(&recv_mh[0], 40)
        if ctrl_used != 0
            puts("unixemf: ctrl_used=")
            print_idec(ctrl_used)
            puts("\n")
            fail(11)
            return

Step 5: close gamma — drops the original owner. Combined
with the receiver-side close from step 4, the unix-server
slot should now be fully freed (owners=0, queues=0).

        posix_close(gamma)

Step 6: free a couple of dummy slots so we can open + bind
again to verify cleanup.

        if n_dummies < 2
            fail(12)
            return
        posix_close(dummies[0])
        posix_close(dummies[1])

Step 7: bind a fresh socket to "EMG". Should succeed iff
the gamma slot's bound_path was cleared (i.e., cleanup
worked).

        val probe = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if probe < 0
            fail(13)
            return
        val br = posix_bind(probe, &sa_g[0], al_g)
        if br != 0
            puts("unixemf: rebind=")
            print_idec(br)
            puts("\n")
            fail(14)
            return

        posix_close(probe)
        posix_close(alpha)
        posix_close(beta)
        var di = 2
        while di < n_dummies
            posix_close(dummies[di])
            di += 1
        puts("unixemf: ok\n")
        exit()
