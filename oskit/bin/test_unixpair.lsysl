test_unixpair — AF_UNIX SOCK_STREAM socketpair
===============================================

Validates `socketpair(AF_UNIX, SOCK_STREAM, 0, sv)`.

Cases:
  1. Plain socketpair: two distinct, non-negative fds; write on
     sv[0] is read by sv[1].
  2. Bidirectional: write on sv[1] is read by sv[0].
  3. EOF semantics: close sv[0] → read on sv[1] returns 0.
  4. SOCK_NONBLOCK propagation: read on empty sv[0] returns
     -EAGAIN; fcntl(F_GETFL) reports O_NONBLOCK on both fds.
  5. AF_INET socketpair → -EAFNOSUPPORT.
  6. AF_UNIX SOCK_DGRAM socketpair → -EOPNOTSUPP (deferred).

Pass criterion: prints `unixpair: ok`.

    module oskit.bin.test_unixpair

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE       = 147
    val NR_READ        = 130
    val NR_WRITE       = 128
    val NR_FCNTL       = 171
    val NR_SOCKETPAIR  = 338

    val AF_UNIX_V      = 1
    val AF_INET_V      = 2
    val SOCK_STREAM_V  = 1
    val SOCK_DGRAM_V   = 2
    val SOCK_NONBLOCK_V = 2048

    val F_GETFL_V      = 3
    val O_NONBLOCK_V   = 2048

    val EAGAIN_V       = 11
    val EOPNOTSUPP_V   = 95
    val EAFNOSUPPORT_V = 97


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixpair: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    posix_socketpair(family: int, stype: int, proto: int,
            sv: *int) -> int
        int(syscall6(NR_SOCKETPAIR, i64(family), i64(stype),
            i64(proto), i64(sv), 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_read(fd: int, buf: *byte, n: int) -> int
        int(syscall6(NR_READ, i64(fd), i64(buf), i64(n), 0, 0, 0))

    posix_write(fd: int, buf: *byte, n: int) -> int
        int(syscall6(NR_WRITE, i64(fd), i64(buf), i64(n), 0, 0, 0))

    posix_fcntl(fd: int, cmd: int, arg: i64) -> int
        int(syscall6(NR_FCNTL, i64(fd), i64(cmd), arg, 0, 0, 0))


Compare `n` bytes of `a` against `b`. Returns 1 on full match.

    bytes_eq(a: *byte, b: *byte, n: int) -> int
        var i = 0
        while i < n
            if a[i] != b[i]
                return 0
            i += 1
        1


    main(argv: []string)

Case 1+2: STREAM socketpair, bidirectional round-trip.

        var sv: [2]int
        sv[0] = -1
        sv[1] = -1
        if posix_socketpair(AF_UNIX_V, SOCK_STREAM_V, 0, &sv[0]) != 0
            fail(1)
            return
        if sv[0] < 0
            fail(2)
            return
        if sv[1] < 0
            fail(3)
            return
        if sv[0] == sv[1]
            fail(4)
            return

        var send_a: [4]byte
        send_a[0] = 'p'; send_a[1] = 'i'; send_a[2] = 'n'; send_a[3] = 'g'
        if posix_write(sv[0], &send_a[0], 4) != 4
            fail(5)
            return
        var recv_a: [4]byte
        if posix_read(sv[1], &recv_a[0], 4) != 4
            fail(6)
            return
        if bytes_eq(&recv_a[0], &send_a[0], 4) == 0
            fail(7)
            return

        var send_b: [4]byte
        send_b[0] = 'p'; send_b[1] = 'o'; send_b[2] = 'n'; send_b[3] = 'g'
        if posix_write(sv[1], &send_b[0], 4) != 4
            fail(8)
            return
        var recv_b: [4]byte
        if posix_read(sv[0], &recv_b[0], 4) != 4
            fail(9)
            return
        if bytes_eq(&recv_b[0], &send_b[0], 4) == 0
            fail(10)
            return

Case 3: closing one end → read on the other returns 0 (EOF).

        if posix_close(sv[0]) != 0
            fail(11)
            return
        var eof_buf: [1]byte
        if posix_read(sv[1], &eof_buf[0], 1) != 0
            fail(12)
            return
        if posix_close(sv[1]) != 0
            fail(13)
            return

Case 4: SOCK_NONBLOCK propagation.

        var sv2: [2]int
        sv2[0] = -1
        sv2[1] = -1
        val nb_type = SOCK_STREAM_V | SOCK_NONBLOCK_V
        if posix_socketpair(AF_UNIX_V, nb_type, 0, &sv2[0]) != 0
            fail(14)
            return

        val fl0 = posix_fcntl(sv2[0], F_GETFL_V, i64(0))
        if (fl0 & O_NONBLOCK_V) == 0
            fail(15)
            return
        val fl1 = posix_fcntl(sv2[1], F_GETFL_V, i64(0))
        if (fl1 & O_NONBLOCK_V) == 0
            fail(16)
            return

        var nb_buf: [1]byte
        val r = posix_read(sv2[0], &nb_buf[0], 1)
        if r != -EAGAIN_V
            puts("unixpair: nb_read r=")
            print_idec(r)
            puts("\n")
            fail(17)
            return

        if posix_close(sv2[0]) != 0
            fail(18)
            return
        if posix_close(sv2[1]) != 0
            fail(19)
            return

Case 5: AF_INET socketpair → -EAFNOSUPPORT.

        var sv3: [2]int
        sv3[0] = -1
        sv3[1] = -1
        val r5 = posix_socketpair(AF_INET_V, SOCK_STREAM_V, 0, &sv3[0])
        if r5 != -EAFNOSUPPORT_V
            puts("unixpair: af_inet r=")
            print_idec(r5)
            puts("\n")
            fail(20)
            return

Case 6: AF_UNIX SOCK_DGRAM → -EOPNOTSUPP.

        val r6 = posix_socketpair(AF_UNIX_V, SOCK_DGRAM_V, 0, &sv3[0])
        if r6 != -EOPNOTSUPP_V
            puts("unixpair: dgram r=")
            print_idec(r6)
            puts("\n")
            fail(21)
            return

        puts("unixpair: ok\n")
        exit()
