NSH — Native SLIX Shell
=======================

Idiomatic sysl shell with no POSIX dependencies. Uses sysl
string type throughout. Runs as an external `/bin/nsh` program.

Built-in commands:
- pwd              — print working directory
- cd [path]        — change directory
- kill pid         — terminate a process
- help             — list commands

All other commands are external /bin/ programs loaded via PM spawn.

    module oskit.bin.nsh

    import oskit.ulib.{write_handle, getc, open, close, read, stat,
        connect, pm_waitpid, pm_kill, pm_spawn_handles,
        sleep, exit, get_args, skip_arg0, STDOUT}


Shell state.

    var cwd: string
    var nsh_background = 0

Buffered output. All output accumulates in nsh_out and is
sent to stdout in a single write on flush. This batches
output to reduce IPC round-trips.

    var nsh_out: [140]byte
    var nsh_outpos = 0

    nsh_flush()
        if nsh_outpos > 0
            write_handle(STDOUT, &nsh_out[0], nsh_outpos)
            nsh_outpos = 0

    nsh_putc(ch: char)
        if nsh_outpos >= 120
            nsh_flush()
        nsh_out[nsh_outpos] = byte(ch)
        nsh_outpos += 1

    nsh_print(s: string)
        val p = *byte(s)
        val n = len(s)
        for var i = 0; i < n; i++
            if nsh_outpos >= 120
                nsh_flush()
            nsh_out[nsh_outpos] = p[i]
            nsh_outpos += 1

    nsh_newline()
        nsh_putc('\n')
        nsh_flush()

    nsh_putint(n: int)
        if n < 0
            nsh_putc('-')
            nsh_putint(-n)
            return
        if n >= 10
            nsh_putint(n / 10)
        nsh_putc('0' + (n % 10))

Tokenizer. Splits a line buffer into string tokens separated
by spaces. Returns the number of tokens found.

    val MAX_ARGS = 16

    tokenize(buf: *byte, buflen: int, argv: *string) -> int
        var argc = 0
        var pos = 0
        while pos < buflen
            // Skip spaces
            while pos < buflen
                if buf[pos] != ' '
                    break
                pos += 1
            if pos >= buflen
                break
            // Start of token
            val start = pos
            while pos < buflen
                if buf[pos] == ' '
                    break
                pos += 1
            if argc < MAX_ARGS
                argv[argc] = string(buf + start, pos - start)
                argc += 1
        argc

Command history. Circular buffer of recent commands for
up/down arrow recall.

    val HIST_MAX = 16
    val HIST_LINE_MAX = 128
    var hist_buf: [2048]byte  // 16 * 128
    var hist_len: [16]int
    var hist_count = 0
    var hist_next = 0

    hist_add(buf: *byte, blen: int)
        if blen == 0
            return
        val slot = hist_next
        val base = slot * HIST_LINE_MAX
        var n = blen
        if n > HIST_LINE_MAX - 1
            n = HIST_LINE_MAX - 1
        var i = 0
        while i < n
            hist_buf[base + i] = buf[i]
            i += 1
        hist_len[slot] = n
        hist_next = (hist_next + 1) % HIST_MAX
        if hist_count < HIST_MAX
            hist_count += 1

    hist_get(idx: int, buf: *byte) -> int
        val slot = (hist_next - 1 - idx + HIST_MAX * 2) % HIST_MAX
        val base = slot * HIST_LINE_MAX
        val n = hist_len[slot]
        var i = 0
        while i < n
            buf[i] = hist_buf[base + i]
            i += 1
        n

Line editing. Reads a line from stdin with arrow keys,
Home/End, Delete, Backspace, and character insertion.

    val PROMPT_LEN = 2

Append a CSI sequence with numeric parameter to a buffer.

    nsh_append_csi(out: *byte, pos: int, n: int, ch: byte) -> int
        var p = pos
        out[p] = 27
        p += 1
        out[p] = '['
        p += 1
        if n >= 100
            out[p] = byte('0' + n / 100)
            p += 1
        if n >= 10
            out[p] = byte('0' + (n / 10) % 10)
            p += 1
        out[p] = byte('0' + n % 10)
        p += 1
        out[p] = ch
        p += 1
        p

Emit a CSI sequence directly.

    nsh_csi_num(n: int, ch: char)
        nsh_putc(27)
        nsh_putc('[')
        if n >= 100
            nsh_putc('0' + n / 100)
        if n >= 10
            nsh_putc('0' + (n / 10) % 10)
        nsh_putc('0' + n % 10)
        nsh_putc(ch)
        nsh_flush()

Redraw the full line in a single batched write.

    nsh_refresh_line(buf: *byte, blen: int, cursor: int, prompt_len: int)
        nsh_flush()
        var p = 0
        nsh_out[p] = 13
        p += 1
        // Write prompt (cwd + "> ")
        val pp = *byte(cwd)
        val plen = len(cwd)
        for var i = 0; i < plen; i++
            nsh_out[p] = pp[i]
            p += 1
        nsh_out[p] = '>'
        p += 1
        nsh_out[p] = ' '
        p += 1
        // Copy line content
        for var i = 0; i < blen; i++
            if p >= 120
                write_handle(STDOUT, &nsh_out[0], p)
                p = 0
            nsh_out[p] = buf[i]
            p += 1
        // ESC[K — clear to end of line
        p = nsh_append_csi(nsh_out, p, 0, byte('K'))
        // ESC[nG — cursor to column (1-based)
        p = nsh_append_csi(nsh_out, p, prompt_len + cursor + 1, byte('G'))
        write_handle(STDOUT, &nsh_out[0], p)

    nsh_readline(buf: *byte, maxlen: int, prompt_len: int) -> int
        var blen = 0
        var cursor = 0
        var hist_pos = -1
        while blen < maxlen - 1
            val ch = getc()
            if ch == '\n'
                nsh_newline()
                buf[blen] = 0
                hist_add(buf, blen)
                return blen
            else if ch == 8
                if cursor > 0
                    var i = cursor - 1
                    while i < blen - 1
                        buf[i] = buf[i + 1]
                        i += 1
                    blen -= 1
                    cursor -= 1
                    nsh_refresh_line(buf, blen, cursor, prompt_len)
            else if ch == 27
                val c2 = getc()
                if c2 == '['
                    val c3 = getc()
                    if c3 == 'A'
                        // Up arrow — older history
                        if hist_pos + 1 < hist_count
                            hist_pos += 1
                            blen = hist_get(hist_pos, buf)
                            cursor = blen
                            nsh_refresh_line(buf, blen, cursor, prompt_len)
                    else if c3 == 'B'
                        // Down arrow — newer history
                        if hist_pos > 0
                            hist_pos -= 1
                            blen = hist_get(hist_pos, buf)
                            cursor = blen
                            nsh_refresh_line(buf, blen, cursor, prompt_len)
                        else if hist_pos == 0
                            hist_pos = -1
                            blen = 0
                            cursor = 0
                            nsh_refresh_line(buf, blen, cursor, prompt_len)
                    else if c3 == 'C'
                        if cursor < blen
                            cursor += 1
                            nsh_csi_num(prompt_len + cursor + 1, 'G')
                    else if c3 == 'D'
                        if cursor > 0
                            cursor -= 1
                            nsh_csi_num(prompt_len + cursor + 1, 'G')
                    else if c3 == 'H'
                        cursor = 0
                        nsh_csi_num(prompt_len + 1, 'G')
                    else if c3 == 'F'
                        cursor = blen
                        nsh_csi_num(prompt_len + cursor + 1, 'G')
                    else if c3 == '3'
                        val c4 = getc()
                        if c4 == '~'
                            if cursor < blen
                                var i = cursor
                                while i < blen - 1
                                    buf[i] = buf[i + 1]
                                    i += 1
                                blen -= 1
                                nsh_refresh_line(buf, blen, cursor, prompt_len)
                    else
                        var cx = c3
                        while cx >= 0
                            if cx != '['
                                if cx >= 64
                                    if cx <= 126
                                        break
                            cx = getc()
            else if ch >= ' '
                if blen < maxlen - 1
                    var i = blen
                    while i > cursor
                        buf[i] = buf[i - 1]
                        i -= 1
                    buf[cursor] = byte(ch)
                    blen += 1
                    cursor += 1
                    if cursor == blen
                        nsh_putc(ch)
                        nsh_flush()
                    else
                        nsh_refresh_line(buf, blen, cursor, prompt_len)
        buf[blen] = 0
        blen

Build a full absolute path from a possibly-relative argument.

    nsh_full_path(path: string) -> string
        if path[0] == '/'
            return path
        if len(cwd) > 1
            return cwd + "/" + path
        cwd + path

Extract the basename from a path.

    nsh_basename(path: string) -> string
        var last_slash = -1
        for var i = 0; i < len(path); i++
            if path[i] == '/'
                last_slash = i
        if last_slash == -1
            return path
        string(*byte(path) + last_slash + 1, len(path) - last_slash - 1)

Strip leading `./` segments so `./echo` and `echo` resolve to the same basename.

    nsh_strip_dot_slash(path: string) -> string
        var s = path
        while len(s) >= 2
            if s[0] == '.'
                if s[1] == '/'
                    s = string(*byte(s) + 2, len(s) - 2)
                    continue
            break
        s

Executable name for `/bin/<name>` lookup: `./echo` → `echo`, `/bin/echo` → `echo`.

    nsh_external_bin_key(cmd: string) -> string
        nsh_basename(nsh_strip_dot_slash(cmd))

Built-in commands.

    cmd_pwd(argc: int, argv: *string)
        nsh_print(cwd)
        nsh_newline()

    cmd_cd(argc: int, argv: *string)
        if argc < 2
            cwd = "/"
            return
        val full = nsh_full_path(argv[1])
        // Verify it exists and is a directory
        var st: [7]int
        if stat(full, st) < 0
            nsh_print(argv[1])
            nsh_print(": not found\n")
            return
        val ftype = (st[0] >> 12) & 0xF
        if ftype != 2
            nsh_print("not a directory\n")
            return
        cwd = full

    cmd_kill(argc: int, argv: *string)
        if argc < 2
            nsh_print("usage: kill <pid>\n")
            return
        val arg = argv[1]
        val p = *byte(arg)
        var pid = 0
        var i = 0
        while i < len(arg)
            val ch = int(p[i])
            if ch < '0'
                nsh_print("kill: invalid pid\n")
                return
            if ch > '9'
                nsh_print("kill: invalid pid\n")
                return
            pid = pid * 10 + (ch - '0')
            i += 1
        val result = pm_kill(pid)
        if result < 0
            nsh_print("kill: no such process\n")

    cmd_help(argc: int, argv: *string)
        nsh_print("builtins: pwd cd kill help\n")
        nsh_print("/bin: cat echo ls touch write mkdir rm rmdir\n")
        nsh_print("      mv chmod stat uptime whoami ps grep wc\n")

Command dispatch.

    nsh_dispatch(argc: int, argv: *string)
        if argc == 0
            return
        argv[0] match
            "pwd"  -> cmd_pwd(argc, argv)
            "cd"   -> cmd_cd(argc, argv)
            "kill" -> cmd_kill(argc, argv)
            "help" -> cmd_help(argc, argv)
            else   -> nsh_try_external(argc, argv)

Try to run an external command from `/bin/` via PM spawn.

    nsh_try_external(argc: int, argv: *string)
        val cmd = argv[0]
        val bin_path = "/bin/" + nsh_external_bin_key(cmd)

        // Build args string: "cmd arg1 arg2 ..."
        var args_buf: [256]byte
        var pos = 0
        for var i = 0; i < argc; i++
            if pos >= 240
                break
            if i > 0
                args_buf[pos] = byte(' ')
                pos += 1
            val arg = argv[i]
            val ap = *byte(arg)
            for var j = 0; j < len(arg); j++
                if pos >= 240
                    break
                args_buf[pos] = ap[j]
                pos += 1
        val args = string(&args_buf[0], pos)

        // Open TTY handles for stdin/stdout/stderr
        val h_in = connect("tty:0")
        val h_out = connect("tty:0")
        val h_err = connect("tty:0")

        // Handle map: (parent_handle, child_slot) pairs
        var hmap: [6]byte
        hmap[0] = byte(h_in)
        hmap[1] = 0  // child stdin
        hmap[2] = byte(h_out)
        hmap[3] = 1  // child stdout
        hmap[4] = byte(h_err)
        hmap[5] = 2  // child stderr

        val pid = pm_spawn_handles(bin_path, args, &hmap[0], 3)

        // Close parent's copies of the TTY handles
        close(h_in)
        close(h_out)
        close(h_err)

        nsh_flush()
        if pid >= 0
            if nsh_background != 0
                nsh_print("[")
                nsh_putint(pid)
                nsh_print("]\n")
            else
                val exit_code = pm_waitpid(pid)
                // Ensure prompt starts on a fresh line
                nsh_putc('\n')
                if exit_code != 0
                    nsh_print("exit ")
                    nsh_putint(exit_code)
                    nsh_print("\n")
        else
            nsh_print(cmd)
            nsh_print(": not found\n")

The shell entry point. Home directory is passed via args
(e.g. "nsh /root"). If no args, defaults to "/".

    main()
        val args = skip_arg0(get_args())
        if len(args) > 0
            cwd = args
            // Verify home exists
            var st: [7]int
            if stat(cwd, st) < 0
                cwd = "/"
        else
            cwd = "/"
        sleep(5)

        var line: [256]byte
        var argv: [16]string

        while 1 == 1
            // Print prompt: "cwd> "
            nsh_print(cwd)
            nsh_putc('>')
            nsh_putc(' ')
            nsh_flush()

            // Prompt length = cwd length + 2 ("> ")
            val prompt_len = len(cwd) + 2

            // Read a line
            val blen = nsh_readline(line, 256, prompt_len)
            if blen == 0
                continue

            // Tokenize
            var argc = tokenize(line, blen, argv)

            // Check for trailing &
            nsh_background = 0
            if argc > 0
                if argv[argc - 1] == "&"
                    nsh_background = 1
                    argc -= 1

            // Dispatch
            nsh_dispatch(argc, argv)
            nsh_flush()
