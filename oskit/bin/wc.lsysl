wc — word, line, and byte count
=================================

Counts lines, words, and bytes from input.

Usage: `wc [file]`
- With file argument: reads from the file.
- Without file argument: reads from stdin (handle 0).

Outputs: `  lines  words  bytes`

    module oskit.bin.wc

    import oskit.ulib.{open, read, close, puts, exit, get_args, skip_arg0, write_handle, STDIN, STDOUT}

    val WC_BUF_SIZE = 4096

Print a right-justified integer in a field of width 6.

    wc_print_num(n: int)
        var buf: [12]byte
        var pos = 0
        var v = n
        if v == 0
            buf[0] = 48  // '0'
            pos = 1
        else
            while v > 0
                buf[pos] = byte(48 + v % 10)
                pos += 1
                v /= 10
        // Right-justify in 6 chars
        var pad = 6 - pos
        var spaces: [6]byte
        var i = 0
        while i < pad
            spaces[i] = 32  // space
            i += 1
        if pad > 0
            write_handle(STDOUT, spaces, pad)
        // Print digits in reverse
        i = pos - 1
        while i >= 0
            write_handle(STDOUT, &buf[i], 1)
            i -= 1

    main()
        val args = get_args()
        val rest = skip_arg0(args)
        val rp = *byte(rest)
        val rlen = len(rest)

        // Skip leading spaces to find file argument
        var file_start = 0
        while file_start < rlen
            if rp[file_start] != 32
                break
            file_start += 1

        var fid = -1
        if file_start < rlen
            val file_path = string(rp + file_start, rlen - file_start)
            fid = open(file_path)
            if fid < 0
                puts(file_path)
                puts(": not found\n")
                exit()
                return
        else
            fid = STDIN

        var lines = 0
        var words = 0
        var bytes = 0
        var in_word = 0

        var buf: [4096]byte
        var nr = read(fid, buf, WC_BUF_SIZE)
        while nr > 0
            var i = 0
            while i < nr
                bytes += 1
                val ch = int(buf[i])
                if ch == 10  // newline
                    lines += 1
                    in_word = 0
                else if ch == 32  // space
                    in_word = 0
                else if ch == 9  // tab
                    in_word = 0
                else
                    if in_word == 0
                        words += 1
                        in_word = 1
                i += 1
            nr = read(fid, buf, WC_BUF_SIZE)

        if fid != STDIN
            close(fid)

        wc_print_num(lines)
        wc_print_num(words)
        wc_print_num(bytes)
        puts("\n")
        exit()
