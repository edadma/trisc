wc — word, line, and byte count
=================================

Counts lines, words, and bytes from input.

Usage: `wc [file]`
- With file argument: reads from the file.
- Without file argument: reads from stdin (handle 0).

Outputs: `  lines  words  bytes`

    module oskit.bin.wc

    import oskit.ulib.{open, read, close, puts, exit, write_handle, STDIN, STDOUT}

    val WC_BUF_SIZE = 4096

Print a right-justified integer in a field of width 6.

    wc_print_num(n: int)
        var digits: [12]byte
        var pos = 0
        var v = n
        if v == 0
            digits[0] = 48
            pos = 1
        else
            while v > 0
                digits[pos] = byte(48 + v % 10)
                pos += 1
                v /= 10
        // Build output: right-justified in 6 chars
        var out: [6]byte
        var pad = 6 - pos
        var i = 0
        while i < pad
            out[i] = 32
            i += 1
        // Digits in reverse
        var j = pos - 1
        while j >= 0
            out[i] = digits[j]
            i += 1
            j -= 1
        puts(string(out, 6))

    main(argv: []string)
        var fid = -1
        if len(argv) > 1
            val file_path = argv[1]
            fid = open(file_path)
            if fid < 0
                puts(file_path)
                puts(": not found\n")
                return
        else
            fid = STDIN

        var lines = 0
        var words = 0
        var bytes = 0
        var in_word = 0

        var buf: [4096]byte
        var nr = read(fid, buf, WC_BUF_SIZE)
        while nr > 0
            var i = 0
            while i < nr
                bytes += 1
                val ch = int(buf[i])
                if ch == 10  // newline
                    lines += 1
                    in_word = 0
                else if ch == 32  // space
                    in_word = 0
                else if ch == 9  // tab
                    in_word = 0
                else
                    if in_word == 0
                        words += 1
                        in_word = 1
                i += 1
            nr = read(fid, buf, WC_BUF_SIZE)

        if fid != STDIN
            close(fid)

        wc_print_num(lines)
        wc_print_num(words)
        wc_print_num(bytes)
        puts("\n")
        exit()
