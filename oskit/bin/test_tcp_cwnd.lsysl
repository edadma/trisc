test_tcp_cwnd — TCP congestion-window growth observability
==============================================================

Connects to the host echo server on 10.0.2.2:18080, samples
`snd_cwnd` / `snd_ssthresh` immediately after ESTABLISHED,
sends 900 bytes, waits for ACKs to flow back, samples again.

Exercises:

- Initial cwnd is `TCP_INIT_CWND` right after handshake.
- Slow start grows cwnd by roughly SMSS per cumulative ACK.
- After a pipelined 900-byte send (two segments at
  TCP_MAX_SEG=480) the peer's ACKs should have bumped cwnd
  beyond its starting value.

Output is three lines:

```
test_tcp_cwnd: initial cwnd=N ssthresh=M
test_tcp_cwnd: after cwnd=N ssthresh=M
test_tcp_cwnd: ok
```

The Aarch64NshTest parses N/M out of `initial`/`after` and
asserts:

- initial cwnd == 1440
- initial ssthresh == 65535
- after cwnd > initial cwnd

    module oskit.bin.test_tcp_cwnd

    import oskit.ulib.{puts, exit, exit_with, sleep}
    import oskit.net.{tcp_connect, tcp_send, tcp_close, tcp_debug,
        TcpDebug}
    import std.net.ipv4

    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var buf: [1]byte
        buf[0] = byte('0' + (v % 10))
        puts(string(&buf[0], 1))

    print_int(prefix: string, v: int)
        puts(prefix)
        if v < 0
            puts("-")
            print_udec(0 - v)
        else
            print_udec(v)


    main(argv: []string)
        val dst = ipv4(10, 0, 2, 2)
        var fd = -1
        var attempts = 0
        while fd < 0 && attempts < 5
            fd = tcp_connect(dst, 18080)
            if fd < 0
                sleep(20)
            attempts += 1
        if fd < 0
            puts("test_tcp_cwnd: connect failed\n")
            exit_with(1)
            return

        var d0: TcpDebug
        if tcp_debug(fd, &d0) < 0
            puts("test_tcp_cwnd: debug(initial) failed\n")
            tcp_close(fd)
            exit_with(2)
            return
        puts("test_tcp_cwnd: initial")
        print_int(" cwnd=", d0.snd_cwnd)
        print_int(" ssthresh=", d0.snd_ssthresh)
        puts("\n")

Fill a 900-byte payload with a simple ramp so the host echo
server has something to echo back. The content isn't asserted;
only the cwnd evolution is.

        var payload: [900]byte
        var j = 0
        while j < 900
            payload[j] = byte(j & 0xff)
            j += 1
        val sent = tcp_send(fd, &payload[0], 900)
        if sent < 0
            puts("test_tcp_cwnd: send failed\n")
            tcp_close(fd)
            exit_with(3)
            return
        print_int("test_tcp_cwnd: sent=", sent)
        puts("\n")

Give ACKs time to flow back and cwnd time to grow. The host
echo server also sends an echo; we don't need to read it, but
we do need at least one RTT to pass so our ACK processing runs.

        sleep(50)

        var d1: TcpDebug
        if tcp_debug(fd, &d1) < 0
            puts("test_tcp_cwnd: debug(after) failed\n")
            tcp_close(fd)
            exit_with(4)
            return
        puts("test_tcp_cwnd: after")
        print_int(" cwnd=", d1.snd_cwnd)
        print_int(" ssthresh=", d1.snd_ssthresh)
        puts("\n")

        tcp_close(fd)
        puts("test_tcp_cwnd: ok\n")
        exit()
