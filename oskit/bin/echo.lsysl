echo — echo arguments
======================

Prints each argument separated by a single space, followed by a newline.

    module oskit.bin.echo

    import oskit.ulib.{puts, exit}

    main(argv: []string)
        val n = len(argv)
        for var i = 1; i < n; i++
            if i > 1
                puts(" ")
            puts(argv[i])
        puts("\n")
