test_posix_udp — POSIX socket syscalls over UDP loopback
========================================================

Exercises the aarch64 POSIX shim's socket path end-to-end:

  sys_socket (337)  → allocate POSIX fd backed by an inet UDP id
  sys_bind   (135)  → bind to 127.0.0.1:7799 via sockaddr_in
  sys_sendto (307)  → datagram into the same stack (loopback hit)
  sys_recvfrom (276) → pick it up, parse the returned sockaddr_in
  sys_close  (147)  → release both POSIX slots + inet records

The shim translates sockaddr_in payloads to/from the inet server's
IPC wire format. Everything routes through the per-process POSIX
fd table added alongside these syscalls.

Pass criterion: the program prints `got N from A.B.C.D:P 'text'`
matching what was sent, then `done`.

    module oskit.bin.test_posix_udp

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE      = 147
    val NR_BIND       = 135
    val NR_RECVFROM   = 276
    val NR_SENDTO     = 307
    val NR_SOCKET     = 337

    val AF_INET_V     = 2
    val SOCK_DGRAM_V  = 2


Decimal writer for small ints.

    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var buf: [1]byte
        buf[0] = byte('0' + (v % 10))
        puts(string(&buf[0], 1))


Populate a 16-byte `sockaddr_in` buffer with family=AF_INET,
port in network byte order, and a.b.c.d literal IPv4.

    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


Raw POSIX syscall wrappers. Pass pointers via `i64(…)` casts — the
kernel reads them through the caller's ptbr.

    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_sendto(fd: int, buf: *byte, blen: int, flags: int,
                 addr: *byte, addrlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen)))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
                   addr: *byte, addrlen_ptr: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_ptr)))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val rx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if rx < 0
            puts("test_posix_udp: socket rx failed\n")
            exit_with(1)
            return

        var rx_addr: [16]byte
        fill_sockaddr(&rx_addr[0], 7799, 127, 0, 0, 1)
        if posix_bind(rx, &rx_addr[0], 16) < 0
            puts("test_posix_udp: bind failed\n")
            exit_with(2)
            return

        val tx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if tx < 0
            puts("test_posix_udp: socket tx failed\n")
            exit_with(3)
            return

        var dst: [16]byte
        fill_sockaddr(&dst[0], 7799, 127, 0, 0, 1)
        var msg: [5]byte
        msg[0] = byte('p')
        msg[1] = byte('o')
        msg[2] = byte('s')
        msg[3] = byte('i')
        msg[4] = byte('x')
        val sent = posix_sendto(tx, &msg[0], 5, 0, &dst[0], 16)
        if sent != 5
            puts("test_posix_udp: sendto returned unexpected count\n")
            exit_with(4)
            return

        var rbuf: [32]byte
        var src: [16]byte
        var src_len: i32 = i32(16)
        val got = posix_recvfrom(rx, &rbuf[0], 32, 0, &src[0], &src_len)
        if got < 0
            puts("test_posix_udp: recvfrom failed\n")
            exit_with(5)
            return

        val src_port = ((int(src[2]) & 0xff) << 8) | (int(src[3]) & 0xff)
        puts("test_posix_udp: got ")
        print_udec(got)
        puts(" from ")
        print_udec(int(src[4]) & 0xff)
        puts(".")
        print_udec(int(src[5]) & 0xff)
        puts(".")
        print_udec(int(src[6]) & 0xff)
        puts(".")
        print_udec(int(src[7]) & 0xff)
        puts(":")
        print_udec(src_port)
        puts(" '")
        puts(string(&rbuf[0], got))
        puts("'\n")

        posix_close(tx)
        posix_close(rx)
        puts("test_posix_udp: done\n")
        exit()
