test_pmtfd3 — PM_CMD_TRANSPLANT_FD across processes (file fd)
================================================================

Phase 2B chunk 1 of arbitrary-kind SCM_RIGHTS. Validates that
`posix_fd_transplant` now fans out `VFS_CMD_DUP_HANDLE` when the
source slot kind is `POSIX_FD_FILE`. End-to-end:

  1. Parent open()s `/etc/passwd` (deterministic content,
     `runLogin` writes `"root:x:0:0:..."` at byte 0).
  2. Parent reads 5 bytes — verify `"root:"`. This both proves
     the open worked and advances the *shared* OFT pos to 5.
  3. Parent spawns `/bin/test_pmtfd3c` suspended.
  4. `pm_transplant_fd` copies the parent's file slot into the
     child's slot 3. The shim sees `kind == POSIX_FD_FILE` and
     issues `VFS_CMD_DUP_HANDLE(parent_pid, parent_handle,
     child_pid)` so vfs mints a fresh dst-side handle pointing
     at the same OFT entry. The dst slot's `target` is rewritten
     to that new handle.
  5. Parent closes its own fd. With the new handle in dst,
     vfs's `oft_ref` was bumped during DUP_HANDLE, so the close
     drops it back to 1 and the OFT entry survives.
  6. Parent resumes the child.
  7. Child reads 1 byte from fd 3 — should get `'x'` (the byte
     at offset 5, since OFT pos is shared and parent advanced
     it to 5 in step 2).
  8. Child writes "OK\n" to stdout (so we can see something on
     a fail path) and exits 0.
  9. Parent waitpid().

Pass criterion: prints `pmtfd3: ok`. Earlier failures print
`pmtfd3: bad <N>` so the failing step is obvious.

    module oskit.bin.test_pmtfd3

    import oskit.ulib.{puts, exit, exit_with, syscall6,
        pm_spawn_susp, pm_transplant_fd, pm_resume,
        pm_waitpid}


    val NR_READ      = 130
    val NR_CLOSE     = 147
    val NR_OPENAT    = 254

    val AT_FDCWD     = -100
    val O_RDONLY     = 0


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("pmtfd3: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    posix_openat(dirfd: int, path: *byte, oflags: int, mode: int) -> int
        int(syscall6(NR_OPENAT, i64(dirfd), i64(path),
            i64(oflags), i64(mode), 0, 0))

    posix_read(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_READ, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        var path: [12]byte
        path[0] = byte('/')
        path[1] = byte('e')
        path[2] = byte('t')
        path[3] = byte('c')
        path[4] = byte('/')
        path[5] = byte('p')
        path[6] = byte('a')
        path[7] = byte('s')
        path[8] = byte('s')
        path[9] = byte('w')
        path[10] = byte('d')
        path[11] = byte(0)

        val fd = posix_openat(AT_FDCWD, &path[0], O_RDONLY, 0)
        if fd < 0
            fail(1)
            return

        var rb: [5]byte
        var got = 0
        while got < 5
            val r = posix_read(fd, &rb[got], 5 - got)
            if r <= 0
                puts("pmtfd3: read=")
                print_idec(r)
                puts("\n")
                fail(2)
                return
            got += r
        if rb[0] != byte('r')
            fail(3)
            return
        if rb[1] != byte('o')
            fail(4)
            return
        if rb[2] != byte('o')
            fail(5)
            return
        if rb[3] != byte('t')
            fail(6)
            return
        if rb[4] != byte(':')
            fail(7)
            return

        var noargs: [1]string
        noargs[0] = "test_pmtfd3c"
        val pid = pm_spawn_susp("/bin/test_pmtfd3c", &noargs[0], 1)
        if pid <= 0
            puts("pmtfd3: spawn=")
            print_idec(pid)
            puts("\n")
            fail(8)
            return

        val tr = pm_transplant_fd(pid, fd, 3)
        if tr != 0
            puts("pmtfd3: transplant=")
            print_idec(tr)
            puts("\n")
            fail(9)
            return

        if posix_close(fd) != 0
            fail(10)
            return

        if pm_resume(pid) != 0
            fail(11)
            return

        val rc = pm_waitpid(pid)
        if rc != 0
            puts("pmtfd3: waitpid=")
            print_idec(rc)
            puts("\n")
            fail(12)
            return

        puts("pmtfd3: ok\n")
        exit()
