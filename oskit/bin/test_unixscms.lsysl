test_unixscms — AF_UNIX STREAM SCM_RIGHTS fd-passing
=====================================================

Validates STREAM SCM_RIGHTS — sendmsg/recvmsg with cmsg fds
on a connected SOCK_STREAM pair. The cmsg anchors at the
position of the first byte of its sendmsg call; a recvmsg
whose drain crosses that position receives the fds.

Test plan
---------

Single-process, connected STREAM pair via listen/connect/accept:

- listener bound to "SCS1"
- client connect()s, server accept()s → (client_fd, server_fd)

Two cases:

1. STREAM sendmsg(client_fd → server_fd) with payload "ABCD" +
   cmsg=[gamma]. recvmsg(server_fd) returns those 4 bytes plus
   a fresh aliased fd `gamma2`.
2. close(gamma); bind(gamma2, "SCSG") — proves the slot stayed
   alive via gamma2's co-ownership. Probe round-trip via DGRAM
   "probe" → "SCSG" confirms the inherited fd is fully usable.

Pass criterion: prints `unixscms: ok`.

    module oskit.bin.test_unixscms

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_BIND       = 135
    val NR_CONNECT    = 148
    val NR_LISTEN     = 217
    val NR_ACCEPT     = 131
    val NR_CLOSE      = 147
    val NR_SOCKET     = 337
    val NR_RECVFROM   = 276
    val NR_RECVMSG    = 278
    val NR_SENDMSG    = 306
    val NR_SENDTO     = 307

    val AF_UNIX_V     = 1
    val SOCK_STREAM_V = 1
    val SOCK_DGRAM_V  = 2

    val SOL_SOCKET_V  = 1
    val SCM_RIGHTS_V  = 1


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixscms: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, plen: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < plen
            out[2 + i] = path[i]
            i += 1
        out[2 + plen] = byte(0)
        2 + plen + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_accept(fd: int, addr: *byte, alp: *i32) -> int
        int(syscall6(NR_ACCEPT, i64(fd), i64(addr), i64(alp), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_sendto(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen)))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen_p: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_p)))

    posix_sendmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_SENDMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))

    posix_recvmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_RECVMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))


    write_i64(p: *byte, off: int, v: i64)
        var i = 0
        while i < 8
            p[off + i] = byte((v >> (i * 8)) & i64(0xff))
            i += 1

    write_i32(p: *byte, off: int, v: int)
        p[off]     = byte(v & 0xff)
        p[off + 1] = byte((v >> 8) & 0xff)
        p[off + 2] = byte((v >> 16) & 0xff)
        p[off + 3] = byte((v >> 24) & 0xff)

    read_i32(p: *byte, off: int) -> int
        val b0 = int(p[off]) & 0xff
        val b1 = int(p[off + 1]) & 0xff
        val b2 = int(p[off + 2]) & 0xff
        val b3 = int(p[off + 3]) & 0xff
        b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)


    main(argv: []string)

Set up a connected STREAM pair via listen/connect/accept on
"SCS1".

        var nm: [4]byte
        nm[0] = 'S'; nm[1] = 'C'; nm[2] = 'S'; nm[3] = '1'
        var sa: [128]byte
        val al = fill_sockaddr_un(&sa[0], &nm[0], 4)

        val l = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if l < 0
            fail(1)
            return
        if posix_bind(l, &sa[0], al) != 0
            fail(2)
            return
        if posix_listen(l, 4) != 0
            fail(3)
            return
        val c = posix_socket(AF_UNIX_V, SOCK_STREAM_V, 0)
        if c < 0
            fail(4)
            return
        if posix_connect(c, &sa[0], al) != 0
            fail(5)
            return
        var aa: [128]byte
        var aal: i32 = 128
        val s = posix_accept(l, &aa[0], &aal)
        if s < 0
            fail(6)
            return

Case 1: STREAM sendmsg with cmsg=[gamma]. The receiver gets
"ABCD" + a fresh fd that aliases gamma's slot.

        val gamma = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if gamma < 0
            fail(12)
            return

        var ctrl_send: [32]byte
        write_i64(&ctrl_send[0], 0, i64(20))
        write_i32(&ctrl_send[0], 8, SOL_SOCKET_V)
        write_i32(&ctrl_send[0], 12, SCM_RIGHTS_V)
        write_i32(&ctrl_send[0], 16, gamma)

        var msg_payload: [4]byte
        msg_payload[0] = 'A'; msg_payload[1] = 'B'
        msg_payload[2] = 'C'; msg_payload[3] = 'D'

        var send_iov: [16]byte
        write_i64(&send_iov[0], 0, i64(&msg_payload[0]))
        write_i64(&send_iov[0], 8, i64(4))

        var send_mh: [56]byte
        write_i64(&send_mh[0], 0, i64(0))
        write_i32(&send_mh[0], 8, 0)
        write_i32(&send_mh[0], 12, 0)
        write_i64(&send_mh[0], 16, i64(&send_iov[0]))
        write_i32(&send_mh[0], 24, 1)
        write_i32(&send_mh[0], 28, 0)
        write_i64(&send_mh[0], 32, i64(&ctrl_send[0]))
        write_i32(&send_mh[0], 40, 20)
        write_i32(&send_mh[0], 44, 0)
        write_i32(&send_mh[0], 48, 0)

        val ns = posix_sendmsg(c, &send_mh[0], 0)
        if ns != 4
            puts("unixscms: scm sendmsg ")
            print_idec(ns)
            puts("\n")
            fail(13)
            return

        var recv_payload: [16]byte
        var recv_iov: [16]byte
        write_i64(&recv_iov[0], 0, i64(&recv_payload[0]))
        write_i64(&recv_iov[0], 8, i64(16))
        var ctrl_recv: [32]byte
        var recv_mh: [56]byte
        write_i64(&recv_mh[0], 0, i64(0))
        write_i32(&recv_mh[0], 8, 0)
        write_i32(&recv_mh[0], 12, 0)
        write_i64(&recv_mh[0], 16, i64(&recv_iov[0]))
        write_i32(&recv_mh[0], 24, 1)
        write_i32(&recv_mh[0], 28, 0)
        write_i64(&recv_mh[0], 32, i64(&ctrl_recv[0]))
        write_i32(&recv_mh[0], 40, 32)
        write_i32(&recv_mh[0], 44, 0)
        write_i32(&recv_mh[0], 48, 0)
        val nr = posix_recvmsg(s, &recv_mh[0], 0)
        if nr != 4
            puts("unixscms: scm recvmsg ")
            print_idec(nr)
            puts("\n")
            fail(14)
            return
        if recv_payload[0] != 'A'
            fail(15)
            return
        if recv_payload[1] != 'B'
            fail(16)
            return
        if recv_payload[2] != 'C'
            fail(17)
            return
        if recv_payload[3] != 'D'
            fail(18)
            return

        val ctrl_used = read_i32(&recv_mh[0], 40)
        if ctrl_used != 20
            puts("unixscms: ctrl_used ")
            print_idec(ctrl_used)
            puts("\n")
            fail(19)
            return
        val cmsg_level = read_i32(&ctrl_recv[0], 8)
        val cmsg_type  = read_i32(&ctrl_recv[0], 12)
        if cmsg_level != SOL_SOCKET_V
            fail(20)
            return
        if cmsg_type != SCM_RIGHTS_V
            fail(21)
            return
        val gamma2 = read_i32(&ctrl_recv[0], 16)
        if gamma2 < 0
            fail(22)
            return

Case 3: drop the original gamma; bind gamma2 to "SCSG" and
prove it's a fully functional DGRAM fd via a probe round-trip.

        if posix_close(gamma) != 0
            fail(23)
            return

        var path_g: [4]byte
        path_g[0] = 'S'; path_g[1] = 'C'; path_g[2] = 'S'; path_g[3] = 'G'
        var sa_g: [128]byte
        val al_g = fill_sockaddr_un(&sa_g[0], &path_g[0], 4)
        if posix_bind(gamma2, &sa_g[0], al_g) != 0
            fail(24)
            return

        val probe = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if probe < 0
            fail(25)
            return

        var send_buf: [4]byte
        send_buf[0] = byte(0xAA)
        send_buf[1] = byte(0xBB)
        send_buf[2] = byte(0xCC)
        send_buf[3] = byte(0xDD)
        val nps = posix_sendto(probe, &send_buf[0], 4, 0, &sa_g[0], al_g)
        if nps != 4
            fail(26)
            return

        var probe_recv: [4]byte
        var probe_src: [128]byte
        var probe_alen: i32 = 128
        val npr = posix_recvfrom(gamma2, &probe_recv[0], 4, 0,
            &probe_src[0], &probe_alen)
        if npr != 4
            fail(27)
            return
        if probe_recv[0] != byte(0xAA)
            fail(28)
            return
        if probe_recv[1] != byte(0xBB)
            fail(29)
            return
        if probe_recv[2] != byte(0xCC)
            fail(30)
            return
        if probe_recv[3] != byte(0xDD)
            fail(31)
            return

        posix_close(probe)
        posix_close(gamma2)
        posix_close(s)
        posix_close(c)
        posix_close(l)
        puts("unixscms: ok\n")
        exit()
