test_vma_4 — vm_copy_to refuses writes outside the VMA list
============================================================

Phase 1 chunk 3.7 (Phase C of the per-process VMA-list invariant):
the kernel-side `kernel_vm_copy_to` now consults the destination
process's VMA tree as the authority for whether an unmapped
destination page may be allocate-on-write installed. The arch-
level `vm_copy_to` is a stride+memcpy primitive that no longer
implements allocate-on-write; the legacy `[0x60000000,
0x60200000)` literal-range gate is gone.

This test drives the new path through a debug syscall
`SYS_VMA_TRY_COPY` (98) that routes a kernel-side copy via the
calling thread's own ptbr + VMA tree.

Two probes:

  * **In-VMA destination** — `0x60050000` is inside the default
    seeded code/data/heap VMA `[0x60000000, 0x60080000)` but
    past every test binary's segments + BSS, so the destination
    page starts non-present. `kernel_vm_copy_to` looks up the
    VMA, allocates a fresh zero frame via
    `vm_install_user_page`, then memcpys.  Expect rc=0 and the
    payload bytes readable back.

  * **Out-of-VMA destination, in carve-out** — `0x60150000`
    lies inside the user carve-out `[0x60000000, 0x60200000)`
    but past both seeded VMAs `[0x60000000, 0x60080000)` +
    `[0x60080000, 0x60090000)`, and this test never `mmap`s.
    Phase D.1's strict in-carve-out check fires: pid is the
    test process (known, has VMA tree); `vma_lookup_addr`
    returns `VMA_NIL`; `kernel_vm_copy_to` returns -1.

  * **Unmappable destination** — `0x100000000` (4 GiB) lies
    above the top-level page-table entry that
    `vm_create_process_pt` installs (PML4[0] on x86_64, L0[0]
    on aarch64).  Outside the strict-check range, but
    `vm_install_user_page` returns -1 because the intermediate
    level is missing.  `kernel_vm_copy_to` returns -1.  Covers
    the same "no install possible" rejection that protected
    out-of-VMA writes before Phase D.1 added strict-check.

Pass criterion: prints `vma4: ok`.

    module oskit.bin.test_vma_4

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val SYS_VMA_TRY_COPY = 98


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("vma4: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    main(argv: []string)
        var payload: [16]byte
        var i = 0
        while i < 16
            payload[i] = byte(0xA0 + i)
            i += 1

        // Probe 1 — in-VMA destination.  Touches an unmapped page
        // inside the seeded heap VMA; the kernel must allocate-on-
        // write and copy.  Expect rc=0.
        val in_vma_dst: i64 = i64(0x60050000)
        val rc_in = int(syscall6(SYS_VMA_TRY_COPY, in_vma_dst,
                                 i64(&payload[0]), i64(16), 0, 0, 0))
        if rc_in != 0
            fail(1)
            return

        // Verify the payload actually landed (the page was allocated
        // and memcpy completed end-to-end).
        var rp: *byte = *byte(u64(in_vma_dst))
        var j = 0
        while j < 16
            if rp[j] != byte(0xA0 + j)
                fail(2)
                return
            j += 1

        // Probe 2 — out-of-VMA inside the carve-out at 0x60150000.
        // Phase D.1's strict in-carve-out check rejects this: no
        // seeded or mmap'd VMA covers it.
        val in_carveout_no_vma: i64 = i64(0x60150000)
        val rc_carveout = int(syscall6(SYS_VMA_TRY_COPY, in_carveout_no_vma,
                                       i64(&payload[0]), i64(16), 0, 0, 0))
        if rc_carveout != -1
            fail(3)
            return

        // Probe 3 — unmappable destination at 4 GiB.  Above PML4[0]
        // / L0[0], so `vm_install_user_page` returns -1 (no
        // intermediate level).  Different rejection path than
        // probe 2, same observable outcome.
        val unmappable_dst: i64 = i64(0x100000000)
        val rc_unmap = int(syscall6(SYS_VMA_TRY_COPY, unmappable_dst,
                                    i64(&payload[0]), i64(16), 0, 0, 0))
        if rc_unmap != -1
            fail(4)
            return

        puts("vma4: ok\n")
        exit()
