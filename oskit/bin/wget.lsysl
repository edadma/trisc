wget — minimal HTTP/1.0 fetcher
================================

End-to-end "real net app" from the guest: parse a URL, resolve the
host to an IP via DNS, open a TCP connection, issue `GET`, read
until peer FIN, print the response body to stdout.

Usage: `wget <url>`, or `wget <url> <dns_server_ip> <dns_port>` to
explicitly route DNS at a non-default server.

The URL must be `http://host[:port]/path`. `host` is either a
dotted-quad (skips DNS entirely) or a DNS name (resolved via
`oskit.net.dns_resolve`). `port` defaults to 80. `path` must begin
with `/`; an empty path is rejected.

Exits with the HTTP status class: 0 on 2xx, 4 on 4xx, 5 on 5xx,
and 1 on transport/parse/resolve error. Body is written to stdout
so the shell can capture/redirect it just like any other binary.

Out of scope for this cut: HTTPS (no TLS), redirects (no Location
chasing), chunked transfer-encoding (HTTP/1.0 doesn't use it), and
keep-alive (each `wget` invocation is one connection).

    module oskit.bin.wget

    import oskit.ulib.{puts, exit, exit_with, write_handle, STDOUT}
    import oskit.net.{tcp_connect, tcp_send, tcp_recv, tcp_close, dns_resolve}
    import std.net.{parse_ipv4, ipv4_octet}


Decimal helper — used for log lines and port numbers.

    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var buf: [1]byte
        buf[0] = byte('0' + (v % 10))
        puts(string(&buf[0], 1))


Dotted-quad render of a host-order u32.

    print_ipv4(ip: u32)
        print_udec(ipv4_octet(ip, 0))
        puts(".")
        print_udec(ipv4_octet(ip, 1))
        puts(".")
        print_udec(ipv4_octet(ip, 2))
        puts(".")
        print_udec(ipv4_octet(ip, 3))


### parse_uint

Parse a non-negative decimal integer. Returns the value or `-1` on
any malformed input (including empty strings, non-digits, or
negative values).

    parse_uint(s: string) -> int
        val n = len(s)
        if n <= 0
            return -1
        val p = *byte(s)
        var v = 0
        var i = 0
        while i < n
            val c = int(p[i]) & 0xff
            if c < int('0') || c > int('9')
                return -1
            v = v * 10 + (c - int('0'))
            i += 1
        return v


### byte_range_eq

Compare the `n` bytes starting at `buf[off]` against the ASCII
content of `prefix`. Returns 1 on match, 0 otherwise. Used for
checking the `http://` prefix and status-line framing.

    byte_range_eq(buf: *byte, off: int, prefix: string) -> int
        val n = len(prefix)
        if n <= 0
            return 0
        val p = *byte(prefix)
        var i = 0
        while i < n
            if buf[off + i] != p[i]
                return 0
            i += 1
        1


URL slot — a packed view of the parsed components. `host` holds
the raw host chars (no null terminator); `host_len` counts them.
Same for `path`. Lengths are clamped by the fixed array sizes so
overlong inputs are rejected at parse time rather than overflowing.

    struct WgetUrl
        host: [256]byte
        host_len: int
        port: int
        path: [512]byte
        path_len: int


### parse_url

Accept `http://host[:port]/path` and split it into the `WgetUrl`
fields. Returns 0 on success, `-1` on malformed input. Empty host,
empty path, missing `/` after host, and ports outside 1..65535
all reject.

    parse_url(url: string, out: *WgetUrl) -> int
        val prefix = "http://"
        val plen = len(prefix)
        val ulen = len(url)
        if ulen <= plen
            return -1
        val up = *byte(url)
        val pp = *byte(prefix)
        var i = 0
        while i < plen
            if up[i] != pp[i]
                return -1
            i += 1

After the scheme, scan host chars up to `:` (port) or `/` (path).
Neither `@` (userinfo) nor `?` (query) are supported in this cut.

        var cur = plen
        val host_start = cur
        while cur < ulen && up[cur] != byte(':') && up[cur] != byte('/')
            cur += 1
        val host_len = cur - host_start
        if host_len <= 0 || host_len > 255
            return -1
        var hi = 0
        while hi < host_len
            out.host[hi] = up[host_start + hi]
            hi += 1
        out.host_len = host_len

        out.port = 80
        if cur < ulen && up[cur] == byte(':')
            cur += 1
            val port_start = cur
            while cur < ulen && up[cur] != byte('/')
                cur += 1
            val port_len = cur - port_start
            if port_len <= 0 || port_len > 5
                return -1
            var pbuf: [6]byte
            var pi = 0
            while pi < port_len
                pbuf[pi] = up[port_start + pi]
                pi += 1
            pbuf[port_len] = byte(0)
            val port = parse_uint(string(&pbuf[0], port_len))
            if port <= 0 || port > 65535
                return -1
            out.port = port

The path starts at the first `/` and runs to end-of-string.
HTTP/1.0 requires a request-URI, so an empty path is rejected —
clients that want "root" should pass `/`.

        if cur >= ulen || up[cur] != byte('/')
            return -1
        val path_start = cur
        val path_len = ulen - path_start
        if path_len <= 0 || path_len > 511
            return -1
        var pi = 0
        while pi < path_len
            out.path[pi] = up[path_start + pi]
            pi += 1
        out.path_len = path_len
        0


### host_is_ipv4_literal

Return 1 if the host slot looks like a dotted-quad (ASCII digits
and dots only, 4 octets). Callers skip DNS when this fires.

    host_is_ipv4_literal(u: *WgetUrl) -> int
        var dots = 0
        var i = 0
        while i < u.host_len
            val c = int(u.host[i]) & 0xff
            if c == int('.')
                dots += 1
            else if c < int('0') || c > int('9')
                return 0
            i += 1
        if dots == 3
            return 1
        return 0


### send_request

Build and emit the HTTP GET request in one tcp_send — well under
the 480-byte cap even with a 256-byte host and 512-byte path in
the worst case (our URL struct caps enforce this). Headers sent:
Host, User-Agent, Connection: close (explicit close-after-response
so HTTP/1.0 semantics are predictable across servers that default
to keep-alive).

    send_request(fd: int, u: *WgetUrl) -> int
        var req: [1400]byte
        var off = 0

        req[off] = byte('G'); off += 1
        req[off] = byte('E'); off += 1
        req[off] = byte('T'); off += 1
        req[off] = byte(' '); off += 1
        var i = 0
        while i < u.path_len
            req[off] = u.path[i]
            off += 1
            i += 1
        req[off] = byte(' '); off += 1
        val http = "HTTP/1.0\r\nHost: "
        val hlen = len(http)
        val hp = *byte(http)
        var k = 0
        while k < hlen
            req[off] = hp[k]
            off += 1
            k += 1
        i = 0
        while i < u.host_len
            req[off] = u.host[i]
            off += 1
            i += 1
        val tail = "\r\nUser-Agent: slix-wget/0.1\r\nConnection: close\r\n\r\n"
        val tlen = len(tail)
        val tp = *byte(tail)
        k = 0
        while k < tlen
            req[off] = tp[k]
            off += 1
            k += 1

        if off > 480
            puts("wget: request too large for one segment\n")
            return -1
        val sent = tcp_send(fd, &req[0], off)
        if sent < 0
            return -1
        if sent != off
            return -1
        0


### fetch_response

Drain everything from `fd` into `rbuf` until EOF or the buffer
fills. Returns the total byte count, or `-1` on recv error.

    fetch_response(fd: int, rbuf: *byte, cap: int) -> int
        var used = 0
        while used < cap
            val got = tcp_recv(fd, &rbuf[used], cap - used)
            if got < 0
                return -1
            if got == 0
                return used
            used += got
        used


### find_crlfcrlf

Same shape as the CRLFCRLF scanner in httpd, duplicated here so
wget doesn't grow a dependency on httpd-internal helpers. Returns
the offset one past the marker's last byte, or `-1` if not found.

    find_crlfcrlf(buf: *byte, used: int) -> int
        if used < 4
            return -1
        val stop = used - 3
        var i = 0
        while i < stop
            if buf[i] == byte(0x0d) && buf[i+1] == byte(0x0a) && buf[i+2] == byte(0x0d) && buf[i+3] == byte(0x0a)
                return i + 4
            i += 1
        return -1


### parse_status

Given a buffer whose first line is the HTTP status line, pull the
3-digit status code out. Returns the status, or `-1` on malformed
input. Only the tag `HTTP/1.` is checked (tolerating both `1.0` and
`1.1` servers that reply to our HTTP/1.0 request).

    parse_status(buf: *byte, used: int) -> int
        if used < 12
            return -1
        if byte_range_eq(buf, 0, "HTTP/1.") == 0
            return -1
        // Byte 7 is the minor version digit; byte 8 must be space.
        val minor = int(buf[7]) & 0xff
        if minor < int('0') || minor > int('9')
            return -1
        if buf[8] != byte(' ')
            return -1
        if used < 12
            return -1
        var v = 0
        var i = 9
        while i < 12
            val c = int(buf[i]) & 0xff
            if c < int('0') || c > int('9')
                return -1
            v = v * 10 + (c - int('0'))
            i += 1
        v


Main. Parse argv, (optionally) resolve, connect, send, receive,
print body. Each failure produces a specific diagnostic and a
non-zero exit code so the test harness can pinpoint which step
broke without having to diff the whole log.

    main(argv: []string)
        if len(argv) != 2 && len(argv) != 4
            puts("wget: usage: wget <url> [dns_server_ip dns_port]\n")
            exit_with(1)
            return

        var url: WgetUrl
        url.host_len = 0
        url.path_len = 0
        url.port = 0
        if parse_url(argv[1], &url) != 0
            puts("wget: bad URL\n")
            exit_with(1)
            return

        var dns_ip: u32 = u32(0)
        var dns_port: int = 0
        if len(argv) == 4
            if parse_ipv4(argv[2], &dns_ip) != 0
                puts("wget: bad DNS IP\n")
                exit_with(1)
                return
            dns_port = parse_uint(argv[3])
            if dns_port <= 0 || dns_port > 65535
                puts("wget: bad DNS port\n")
                exit_with(1)
                return

        puts("wget: host=")
        puts(string(url.host, url.host_len))
        puts(" port=")
        print_udec(url.port)
        puts(" path=")
        puts(string(url.path, url.path_len))
        puts("\n")

        var target_ip: u32 = u32(0)
        if host_is_ipv4_literal(&url) == 1
            val host_str = string(url.host, url.host_len)
            if parse_ipv4(host_str, &target_ip) != 0
                puts("wget: host looks numeric but parse failed\n")
                exit_with(1)
                return
        else
            if dns_port == 0
                puts("wget: need dns_server_ip + dns_port to resolve ")
                puts(string(url.host, url.host_len))
                puts("\n")
                exit_with(1)
                return
            val host_str = string(url.host, url.host_len)
            val rc = dns_resolve(host_str, dns_ip, dns_port,
                                 &target_ip, 5000)
            if rc == -2
                puts("wget: DNS timeout\n")
                exit_with(1)
                return
            if rc != 0
                puts("wget: DNS failed\n")
                exit_with(1)
                return
            puts("wget: resolved ")
            puts(string(url.host, url.host_len))
            puts(" -> ")
            print_ipv4(target_ip)
            puts("\n")

        val fd = tcp_connect(target_ip, url.port)
        if fd < 0
            puts("wget: connect failed\n")
            exit_with(1)
            return
        puts("wget: connected fd=")
        print_udec(fd)
        puts("\n")

        if send_request(fd, &url) != 0
            puts("wget: send failed\n")
            tcp_close(fd)
            exit_with(1)
            return

        var rbuf: [4096]byte
        val got = fetch_response(fd, &rbuf[0], 4096)
        tcp_close(fd)
        if got < 0
            puts("wget: recv failed\n")
            exit_with(1)
            return
        puts("wget: received=")
        print_udec(got)
        puts(" bytes\n")

        val status = parse_status(&rbuf[0], got)
        if status < 0
            puts("wget: malformed status line\n")
            exit_with(1)
            return
        puts("wget: status=")
        print_udec(status)
        puts("\n")

        val body_start = find_crlfcrlf(&rbuf[0], got)
        if body_start < 0
            puts("wget: no header terminator\n")
            exit_with(1)
            return
        val body_len = got - body_start
        write_handle(STDOUT, &rbuf[body_start], body_len)
        puts("wget: done\n")

        if status >= 500 && status <= 599
            exit_with(5)
            return
        if status >= 400 && status <= 499
            exit_with(4)
            return
        exit()
