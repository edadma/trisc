test_tcp_dwait — TCP recvfrom with MSG_DONTWAIT
=================================================

Verify recvfrom on a TCP fd honors MSG_DONTWAIT (per-call NB)
without requiring fcntl. Steps:

  1. listen socket on 127.0.0.1:9101.
  2. client connect.
  3. accept the child.
  4. recvfrom(child, MSG_DONTWAIT) — no data yet → -EAGAIN.
  5. write "hi" from client to child.
  6. recvfrom(child, MSG_DONTWAIT) — must return 2 bytes "hi".
  7. fcntl(child, F_GETFL) — must still be 0 (per-call only).

Pass = `tcpdw: ok`.

    module oskit.bin.test_tcp_dwait

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_WRITE      = 128
    val NR_ACCEPT     = 131
    val NR_BIND       = 135
    val NR_CLOSE      = 147
    val NR_CONNECT    = 148
    val NR_FCNTL      = 171
    val NR_LISTEN     = 217
    val NR_RECVFROM   = 276
    val NR_SOCKET     = 337

    val AF_INET_V     = 2
    val SOCK_STREAM_V = 1

    val F_GETFL       = 3
    val MSG_DONTWAIT  = 0x40


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("tcpdw: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_accept(fd: int, addr: *byte, addrlen: *int) -> int
        int(syscall6(NR_ACCEPT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_write(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_WRITE, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
                   addr: *byte, alp: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(alp)))

    posix_fcntl(fd: int, cmd: int, arg: int) -> int
        int(syscall6(NR_FCNTL, i64(fd), i64(cmd), i64(arg), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val ls = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if ls < 0
            fail_with(1)
            return
        var bind_addr: [16]byte
        fill_sockaddr(&bind_addr[0], 9101, 0, 0, 0, 0)
        if posix_bind(ls, &bind_addr[0], 16) != 0
            fail_with(2)
            return
        if posix_listen(ls, 4) != 0
            fail_with(3)
            return

        val cl = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if cl < 0
            fail_with(4)
            return
        var conn_addr: [16]byte
        fill_sockaddr(&conn_addr[0], 9101, 127, 0, 0, 1)
        if posix_connect(cl, &conn_addr[0], 16) != 0
            fail_with(5)
            return

        var peer: [16]byte
        var peer_len = 16
        val ch = posix_accept(ls, &peer[0], &peer_len)
        if ch < 0
            fail_with(6)
            return

        // Pre-data MSG_DONTWAIT recv on child must return -EAGAIN.
        var rbuf: [16]byte
        var alen: i32 = i32(16)
        val r1 = posix_recvfrom(ch, &rbuf[0], 16, MSG_DONTWAIT,
            &peer[0], &alen)
        if r1 != -11
            fail_with(7)
            return

        // Send 2 bytes from client.
        var msg: [2]byte
        msg[0] = byte('h')
        msg[1] = byte('i')
        if posix_write(cl, &msg[0], 2) != 2
            fail_with(8)
            return

        // Re-attempt MSG_DONTWAIT recv until data arrives — TCP
        // delivery may not be synchronous.
        var got = 0
        var attempts = 0
        while attempts < 50
            val r2 = posix_recvfrom(ch, &rbuf[0], 16, MSG_DONTWAIT,
                &peer[0], &alen)
            if r2 > 0
                got = r2
                attempts = 50
            else
                attempts += 1
        if got != 2
            fail_with(9)
            return
        if rbuf[0] != byte('h')
            fail_with(10)
            return
        if rbuf[1] != byte('i')
            fail_with(11)
            return

        // child fd flags must still be 0 — MSG_DONTWAIT was per-call.
        if posix_fcntl(ch, F_GETFL, 0) != 0
            fail_with(12)
            return

        posix_close(ch)
        posix_close(cl)
        posix_close(ls)
        puts("tcpdw: ok\n")
        exit()
