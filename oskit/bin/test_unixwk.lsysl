test_unixwk — epoll_create1/ctl/wait on AF_UNIX socket
========================================================

Validates the new UNIX_CMD_EPOLL_SUB / UNSUB / INST_CLOSE
plumbing. The shim's `epoll_subscribe` / `epoll_unsubscribe`
/ `epoll_inst_close_all` now route through the unix server,
so an AF_UNIX fd registered via `epoll_ctl(EPOLL_CTL_ADD)`
gets a row in the unix server's subscriber table — and any
sendto/sendmsg targeting that fd posts a `notify_send_to`
to the epoll-owning thread.

In single-thread the wake itself isn't directly observable
(the test thread doesn't block on epoll_wait), but the
SUB/UNSUB IPC plumbing is exercised end-to-end via
epoll_ctl ADD/DEL and the level-triggered scan path
already used by test_unixpoll.

Test plan
---------

  1. epoll_create1(0) → epfd.
  2. Two DGRAM sockets a, b. Bind a→"WKA", b→"WKB".
  3. epoll_ctl(epfd, ADD, b, EPOLLIN) — calls
     UNIX_CMD_EPOLL_SUB internally.
  4. epoll_pwait(epfd, ev, 1, timeout=0) → 0 events
     (queue empty).
  5. sendto(a → "WKB", "hi") — server's bump path posts a
     notify to the test thread (via the new sub).
  6. epoll_pwait(epfd, ev, 1, timeout=0) → 1 event with
     EPOLLIN set, data = 0xdeadbeef (we set this via ev.data).
  7. recvfrom drains.
  8. epoll_pwait → 0 events again.
  9. epoll_ctl(epfd, DEL, b, NULL) — calls
     UNIX_CMD_EPOLL_UNSUB.
 10. close(epfd) — triggers UNIX_CMD_EPOLL_INST_CLOSE for
     any remaining subs.

Pass criterion: prints `unixwk: ok`.

    module oskit.bin.test_unixwk

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_BIND          = 135
    val NR_CLOSE         = 147
    val NR_EPOLL_CREATE1 = 153
    val NR_EPOLL_CTL     = 154
    val NR_EPOLL_PWAIT   = 155
    val NR_RECVFROM      = 276
    val NR_SENDTO        = 307
    val NR_SOCKET        = 337

    val AF_UNIX_V        = 1
    val SOCK_DGRAM_V     = 2

    val EPOLL_CTL_ADD    = 1
    val EPOLL_CTL_DEL    = 2
    val EPOLLIN_V        = 0x001


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixwk: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, path_len: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < path_len
            out[2 + i] = path[i]
            i += 1
        out[2 + path_len] = byte(0)
        2 + path_len + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_sendto(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen)))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen_p: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_p)))

    posix_epoll_create1(flags: int) -> int
        int(syscall6(NR_EPOLL_CREATE1, i64(flags), 0, 0, 0, 0, 0))

    posix_epoll_ctl(epfd: int, op: int, fd: int, ev: *byte) -> int
        int(syscall6(NR_EPOLL_CTL, i64(epfd), i64(op), i64(fd), i64(ev), 0, 0))

    posix_epoll_pwait(epfd: int, events: *byte, maxevents: int,
            timeout_ms: int) -> int
        int(syscall6(NR_EPOLL_PWAIT, i64(epfd), i64(events),
            i64(maxevents), i64(timeout_ms), 0, 0))


epoll_event layout (slix-musl, 16 bytes):
  off 0: events (u32 LE)
  off 4: pad   (u32)
  off 8: data  (i64 LE)

    write_epoll_event(p: *byte, off: int, events: int, data: i64)
        p[off]     = byte(events & 0xff)
        p[off + 1] = byte((events >> 8) & 0xff)
        p[off + 2] = byte((events >> 16) & 0xff)
        p[off + 3] = byte((events >> 24) & 0xff)
        var pi = 4
        while pi < 8
            p[off + pi] = byte(0)
            pi += 1
        var i = 0
        while i < 8
            p[off + 8 + i] = byte((data >> (i * 8)) & i64(0xff))
            i += 1


    read_epoll_events(p: *byte, off: int) -> int
        (int(p[off]) & 0xff) | ((int(p[off + 1]) & 0xff) << 8) | ((int(p[off + 2]) & 0xff) << 16) | ((int(p[off + 3]) & 0xff) << 24)


    main(argv: []string)

Step 1: epoll_create1.

        val epfd = posix_epoll_create1(0)
        if epfd < 0
            fail(1)
            return

Step 2: two DGRAM sockets bound to "WKA" / "WKB".

        val a = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if a < 0
            fail(2)
            return
        val b = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if b < 0
            fail(3)
            return

        var path_a: [3]byte
        path_a[0] = 'W'; path_a[1] = 'K'; path_a[2] = 'A'
        var path_b: [3]byte
        path_b[0] = 'W'; path_b[1] = 'K'; path_b[2] = 'B'

        var sa_a: [128]byte
        val al_a = fill_sockaddr_un(&sa_a[0], &path_a[0], 3)
        if posix_bind(a, &sa_a[0], al_a) != 0
            fail(4)
            return
        var sa_b: [128]byte
        val al_b = fill_sockaddr_un(&sa_b[0], &path_b[0], 3)
        if posix_bind(b, &sa_b[0], al_b) != 0
            fail(5)
            return

Step 3: epoll_ctl(ADD, b, EPOLLIN, data=0xdeadbeef).

        var ev_in: [16]byte
        write_epoll_event(&ev_in[0], 0, EPOLLIN_V, i64(0xdeadbeef))
        if posix_epoll_ctl(epfd, EPOLL_CTL_ADD, b, &ev_in[0]) != 0
            fail(6)
            return

Step 4: empty queue → 0 events.

        var ev_out: [16]byte
        val n0 = posix_epoll_pwait(epfd, &ev_out[0], 1, 0)
        if n0 != 0
            puts("unixwk: n0=")
            print_idec(n0)
            puts("\n")
            fail(7)
            return

Step 5: sendto fires data.

        var probe: [4]byte
        probe[0] = 'h'; probe[1] = 'i'
        probe[2] = '!'; probe[3] = byte(0)
        if posix_sendto(a, &probe[0], 4, 0, &sa_b[0], al_b) != 4
            fail(8)
            return

Step 6: epoll_pwait returns 1 event with POLLIN.

        val n1 = posix_epoll_pwait(epfd, &ev_out[0], 1, 0)
        if n1 != 1
            puts("unixwk: n1=")
            print_idec(n1)
            puts("\n")
            fail(9)
            return
        val ev = read_epoll_events(&ev_out[0], 0)
        if (ev & EPOLLIN_V) == 0
            puts("unixwk: ev=")
            print_idec(ev)
            puts("\n")
            fail(10)
            return

Step 7: drain.

        var rb: [16]byte
        var src: [128]byte
        var sl: i32 = 128
        if posix_recvfrom(b, &rb[0], 16, 0, &src[0], &sl) != 4
            fail(11)
            return

Step 8: empty again.

        val n2 = posix_epoll_pwait(epfd, &ev_out[0], 1, 0)
        if n2 != 0
            puts("unixwk: n2=")
            print_idec(n2)
            puts("\n")
            fail(12)
            return

Step 9: epoll_ctl DEL — calls UNIX_CMD_EPOLL_UNSUB.

        if posix_epoll_ctl(epfd, EPOLL_CTL_DEL, b, &ev_in[0]) != 0
            fail(13)
            return

Step 10: close epfd — calls UNIX_CMD_EPOLL_INST_CLOSE.

        posix_close(epfd)
        posix_close(a)
        posix_close(b)
        puts("unixwk: ok\n")
        exit()
