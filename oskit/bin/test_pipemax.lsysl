test_pipemax — VFS pipe pool exhaustion
=========================================

Phase 0c chunk 2: validates the VFS server's `MAX_PIPES = 4`
slot pool. The Nth pipe2() call past the cap must return
-EMFILE cleanly (no crash, no kernel panic), and closing both
ends of a pipe must free the slot for reuse.

Pipes consume two posix-fd slots per allocation (read + write
ends). With MAX_PIPES = 4 and POSIX_FDS_PER_PROC = 64, the
posix-fd cap is well above what 4 pipes need (8 fds), so the
VFS pipe-pool cap hits first.

Test plan
---------

  1. pipe2(0) in a loop. Each success records the two fds.
     The Nth call past the cap returns -EMFILE.
  2. Success count should be exactly 4 (MAX_PIPES). Defensive
     band [3, 4] in case the system holds one slot at boot.
  3. Close one pipe (both ends). Call pipe2 again — must
     succeed.
  4. Close everything. Print `pipemax: ok`.

Pass criterion: prints `pipemax: ok`.

    module oskit.bin.test_pipemax

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE = 147
    val NR_PIPE2 = 256

    val EMFILE_V = 24


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("pipemax: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    main(argv: []string)

Step 1: allocate pipes until we hit -EMFILE. Allow up to 8
slots in the buffer for headroom over the expected 4.

        var rfds: [8]int
        var wfds: [8]int
        var n = 0

        while n < 8
            var pair: [2]int
            pair[0] = -1
            pair[1] = -1
            val r = int(syscall6(NR_PIPE2, i64(&pair[0]), i64(0), i64(0), i64(0), i64(0), i64(0)))
            if r < 0
                if r != -EMFILE_V
                    puts("pipemax: unexpected errno ")
                    print_idec(r)
                    puts("\n")
                    fail(1)
                    return
                if n < 3
                    puts("pipemax: cap too low: ")
                    print_idec(n)
                    puts("\n")
                    fail(2)
                    return
                if n > 6
                    puts("pipemax: cap too high: ")
                    print_idec(n)
                    puts("\n")
                    fail(3)
                    return
                break
            rfds[n] = pair[0]
            wfds[n] = pair[1]
            n += 1

        if n >= 8
            puts("pipemax: loop exhausted without EMFILE; cap regressed?\n")
            fail(4)
            return

Step 2: free one pipe — both ends — then verify reallocation
succeeds.

        val cr = int(syscall6(NR_CLOSE, i64(rfds[0]), i64(0), i64(0), i64(0), i64(0), i64(0)))
        if cr != 0
            puts("pipemax: close rfd returned ")
            print_idec(cr)
            puts("\n")
            fail(5)
            return
        val cw = int(syscall6(NR_CLOSE, i64(wfds[0]), i64(0), i64(0), i64(0), i64(0), i64(0)))
        if cw != 0
            puts("pipemax: close wfd returned ")
            print_idec(cw)
            puts("\n")
            fail(6)
            return

        var pair2: [2]int
        pair2[0] = -1
        pair2[1] = -1
        val r2 = int(syscall6(NR_PIPE2, i64(&pair2[0]), i64(0), i64(0), i64(0), i64(0), i64(0)))
        if r2 < 0
            puts("pipemax: realloc after close returned ")
            print_idec(r2)
            puts("\n")
            fail(7)
            return
        rfds[0] = pair2[0]
        wfds[0] = pair2[1]

Step 3: clean up.

        var i = 0
        while i < n
            syscall6(NR_CLOSE, i64(rfds[i]), i64(0), i64(0), i64(0), i64(0), i64(0))
            syscall6(NR_CLOSE, i64(wfds[i]), i64(0), i64(0), i64(0), i64(0), i64(0))
            i += 1

        puts("pipemax: ok\n")
        exit()
