write — write text to a file
============================

Opens a file and writes the remaining arguments (joined with spaces) to it.

Usage: `write <file> <text...>`

    module oskit.bin.write

    import oskit.ulib.{puts, exit, open, write_handle, close}

    main(argv: []string)
        val n = len(argv)
        if n < 3
            puts("usage: write <file> <text>\n")
            return
        val path = argv[1]
        val fid = open(path)
        if fid < 0
            puts(path)
            puts(": not found\n")
            return
        val sp = " "
        for var i = 2; i < n; i++
            if i > 2
                write_handle(fid, *byte(sp), 1)
            val a = argv[i]
            write_handle(fid, *byte(a), len(a))
        close(fid)
