test_tcp_mcl — multi-client passive-open stress test
=====================================================

Listens on port 7890. Accepts `N=3` clients in sequence, each gets
its inbound bytes echoed back plus a one-byte iteration tag so the
host-side test can verify ordering. Closes each child as soon as
the echo is out, then the listen socket after all N complete.

The expected stress pattern on a parallel dial from the host is:
    client 0's SYN    → guest SYN_RCVD → ESTABLISHED → enqueued
    client 1's SYN    → guest SYN_RCVD → ESTABLISHED → enqueued
    client 2's SYN    → guest SYN_RCVD → ESTABLISHED → enqueued
    server accept() dequeues client 0 → recv/send/close
    server accept() dequeues client 1 → recv/send/close
    server accept() dequeues client 2 → recv/send/close

Prints one `accept[i] cfd=C from A.B.C.D:P` per accept so the
harness can assert each one landed, and `test_tcp_mcl: ok` at the
very end.

    module oskit.bin.test_tcp_mcl

    import oskit.ulib.{puts, exit, exit_with}
    import oskit.net.{tcp_listen, tcp_accept, tcp_send, tcp_recv, tcp_close}


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var buf: [1]byte
        buf[0] = byte('0' + (v % 10))
        puts(string(&buf[0], 1))


    main(argv: []string)
        // N=3 exercises the accept queue with two children waiting
        // while the first is being echoed — deeper than the N=2
        // "one pending" case. Must stay in sync with the Scala
        // test's N.
        val n = 3
        val lfd = tcp_listen(7890)
        if lfd < 0
            puts("test_tcp_mcl: listen failed\n")
            exit_with(1)
            return
        puts("test_tcp_mcl: listening fd=")
        print_udec(lfd)
        puts("\n")

        var peer_ip: [4]byte
        var peer_port: [2]byte
        var i = 0
        while i < n
            val cfd = tcp_accept(lfd, &peer_ip[0], &peer_port[0])
            if cfd < 0
                puts("test_tcp_mcl: accept failed at i=")
                print_udec(i)
                puts("\n")
                tcp_close(lfd)
                exit_with(2)
                return
            puts("test_tcp_mcl: accept[")
            print_udec(i)
            puts("] cfd=")
            print_udec(cfd)
            puts(" from ")
            print_udec(int(peer_ip[0]) & 0xff)
            puts(".")
            print_udec(int(peer_ip[1]) & 0xff)
            puts(".")
            print_udec(int(peer_ip[2]) & 0xff)
            puts(".")
            print_udec(int(peer_ip[3]) & 0xff)
            puts(":")
            val pp = ((int(peer_port[0]) & 0xff) << 8) | (int(peer_port[1]) & 0xff)
            print_udec(pp)
            puts("\n")

            var rbuf: [34]byte
            val got = tcp_recv(cfd, &rbuf[0], 32)
            if got < 0
                puts("test_tcp_mcl: recv failed at i=")
                print_udec(i)
                puts("\n")
                tcp_close(cfd)
                tcp_close(lfd)
                exit_with(3)
                return
            // Tag the echo with "#i" so the host can verify each
            // child's reply belongs to a distinct accept slot.
            var payload_len = got
            if payload_len > 0
                if rbuf[payload_len - 1] == '\n'
                    payload_len -= 1
            rbuf[payload_len]     = byte('#')
            rbuf[payload_len + 1] = byte('0' + i)
            val sent = tcp_send(cfd, &rbuf[0], payload_len + 2)
            if sent < 0
                puts("test_tcp_mcl: send failed at i=")
                print_udec(i)
                puts("\n")
                tcp_close(cfd)
                tcp_close(lfd)
                exit_with(4)
                return

            val cr = tcp_close(cfd)
            if cr < 0
                puts("test_tcp_mcl: close cfd failed at i=")
                print_udec(i)
                puts("\n")
                tcp_close(lfd)
                exit_with(5)
                return
            i += 1

        val lr = tcp_close(lfd)
        if lr < 0
            puts("test_tcp_mcl: close lfd failed\n")
            exit_with(6)
            return
        puts("test_tcp_mcl: ok\n")
        exit()
