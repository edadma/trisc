cat — concatenate and print files
==================================

Reads a file and writes its contents to the terminal.

Builds the path from [[PROG_ARGS_ADDR]] into a stack buffer before [[open]],
same idea as `/bin/echo`: avoids passing a `string` view tied to the shared
args page through IPC (unreliable in the external-program bootstrap path).

Read path matches the demo volume: ramdisk sectors and TFS `sb_block_size`
are **4096** bytes (`TriscCli` ramdisk + `TFS.format`). Each `read(..., 4096)`
lets `tfs_read` use full-block `rd_read` into this buffer when aligned.

Output goes through [[puts]] in slices of at most **125** bytes — that is the
payload cap enforced by [[oskit.ulib.puts]] (128-byte TTY IPC message minus
the 3-byte header).

    module oskit.bin.cat

    import oskit.ulib.{open, read, close, puts, exit, get_args, skip_arg0, STDIN}

    val CAT_READ_CHUNK = 4096
    val PUTS_PAYLOAD_MAX = 125

    main()
        val args = get_args()
        val path = skip_arg0(args)
        var buf: [4096]byte
        var fid = -1

        if len(path) == 0
            // No file argument — read from stdin (for pipes)
            fid = STDIN
        else
            fid = open(path)
            if fid < 0
                puts(path)
                puts(": not found\n")
                exit()
                return

        var nr = read(fid, buf, CAT_READ_CHUNK)
        while nr > 0
            var sent = 0
            while sent < nr
                var k = nr - sent
                if k > PUTS_PAYLOAD_MAX
                    k = PUTS_PAYLOAD_MAX
                puts(string(&buf[sent], k))
                sent += k
            nr = read(fid, buf, CAT_READ_CHUNK)
        if fid != STDIN
            close(fid)
        if nr < 0
            puts("cat: read error\n")
        exit()
