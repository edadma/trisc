test_truncate — O_TRUNC + ftruncate
=====================================

Validates Phase 0a item 1 — `O_TRUNC` on `openat()` and the new
`sys_ftruncate(181)` syscall, plus the underlying TFS truncate
primitive (shrink + extend with sparse-hole reads-as-zero).

Test plan
---------

1. Create `/tmp/trunc1` with `"hello world"` (11 bytes), close.
2. `openat(/tmp/trunc1, O_WRONLY|O_TRUNC)`. The O_TRUNC plumbing
   in `sys_openat` should issue `VFS_CMD_TRUNCATE(handle, 0)`
   *after* a successful open, so the file is now empty.
3. `fstat` and check `size == 0`.
4. Write `"abc"` (3 bytes), close, reopen O_RDONLY, read back —
   must be exactly `"abc"`.
5. `ftruncate(fd, 10)` on an open file extends it to 10 bytes.
6. Read past the original tail — bytes 3..9 must come back as
   NULs (sparse-hole semantics from `tfs_read`).
7. `ftruncate(fd, 5)` shrinks back to 5 bytes; reading past the
   end must hit EOF (return 0).
8. `ftruncate(fd, -1)` rejected with `-EINVAL`.

Pass criterion: prints `truncate: ok`.

    module oskit.bin.test_truncate

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_READ       = 130
    val NR_WRITE      = 128
    val NR_LSEEK      = 221
    val NR_CLOSE      = 147
    val NR_OPENAT     = 254
    val NR_UNLINKAT   = 365
    val NR_FTRUNCATE  = 181

    val AT_FDCWD      = -100
    val O_RDONLY      = 0
    val O_WRONLY      = 1
    val O_RDWR        = 2
    val O_CREAT       = 64
    val O_TRUNC       = 512

    val EINVAL        = 22


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("truncate: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    posix_openat(dirfd: int, path: *byte, oflags: int, mode: int) -> int
        int(syscall6(NR_OPENAT, i64(dirfd), i64(path),
            i64(oflags), i64(mode), 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_read(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_READ, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_write(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_WRITE, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_lseek(fd: int, offset: i64, whence: int) -> i64
        syscall6(NR_LSEEK, i64(fd), offset, i64(whence), 0, 0, 0)

    posix_ftruncate(fd: int, length: i64) -> i64
        syscall6(NR_FTRUNCATE, i64(fd), length, 0, 0, 0, 0)

    posix_unlinkat(dirfd: int, path: *byte, flags: int) -> int
        int(syscall6(NR_UNLINKAT, i64(dirfd), i64(path),
            i64(flags), 0, 0, 0))


    fill_path(out: *byte)
        out[0]  = byte('/')
        out[1]  = byte('t')
        out[2]  = byte('m')
        out[3]  = byte('p')
        out[4]  = byte('/')
        out[5]  = byte('t')
        out[6]  = byte('r')
        out[7]  = byte('u')
        out[8]  = byte('n')
        out[9]  = byte('c')
        out[10] = byte('1')
        out[11] = byte(0)


    main(argv: []string)
        var path: [12]byte
        fill_path(&path[0])

        // Best-effort cleanup from a previous run. Errors ignored —
        // first run won't have the file yet.
        posix_unlinkat(AT_FDCWD, &path[0], 0)

Step 1 — create with `"hello world"`.

        val fd1 = posix_openat(AT_FDCWD, &path[0],
            O_WRONLY | O_CREAT, 0x1B6)
        if fd1 < 0
            fail(1)
            return
        var msg: [11]byte
        msg[0]  = byte('h')
        msg[1]  = byte('e')
        msg[2]  = byte('l')
        msg[3]  = byte('l')
        msg[4]  = byte('o')
        msg[5]  = byte(' ')
        msg[6]  = byte('w')
        msg[7]  = byte('o')
        msg[8]  = byte('r')
        msg[9]  = byte('l')
        msg[10] = byte('d')
        val nw = posix_write(fd1, &msg[0], 11)
        if nw != 11
            puts("truncate: write1=")
            print_idec(nw)
            puts("\n")
            fail(2)
            return
        posix_close(fd1)

Step 2 — re-open with O_TRUNC, expect file to be empty.

        val fd2 = posix_openat(AT_FDCWD, &path[0],
            O_WRONLY | O_TRUNC, 0)
        if fd2 < 0
            fail(3)
            return
        // SEEK_END returns the size; should be 0 after O_TRUNC.
        val sz_after_trunc = posix_lseek(fd2, i64(0), 2)
        if sz_after_trunc != i64(0)
            puts("truncate: size_after_O_TRUNC=")
            print_idec(int(sz_after_trunc))
            puts("\n")
            fail(4)
            return

Step 3 — write "abc", close, reopen, read back.

        var abc: [3]byte
        abc[0] = byte('a'); abc[1] = byte('b'); abc[2] = byte('c')
        if posix_write(fd2, &abc[0], 3) != 3
            fail(5)
            return
        posix_close(fd2)

        val fd3 = posix_openat(AT_FDCWD, &path[0], O_RDWR, 0)
        if fd3 < 0
            fail(6)
            return
        var rb: [3]byte
        if posix_read(fd3, &rb[0], 3) != 3
            fail(7)
            return
        if rb[0] != byte('a')
            fail(8)
            return
        if rb[1] != byte('b')
            fail(9)
            return
        if rb[2] != byte('c')
            fail(10)
            return

Step 4 — ftruncate to 10. Bytes 3..9 must read as NUL.

        if posix_ftruncate(fd3, i64(10)) != i64(0)
            fail(11)
            return
        if posix_lseek(fd3, i64(0), 2) != i64(10)
            fail(12)
            return
        if posix_lseek(fd3, i64(0), 0) != i64(0)
            fail(13)
            return
        var rb2: [10]byte
        var got = 0
        while got < 10
            val r = posix_read(fd3, &rb2[got], 10 - got)
            if r <= 0
                fail(14)
                return
            got += r
        if rb2[0] != byte('a')
            fail(15)
            return
        if rb2[2] != byte('c')
            fail(16)
            return
        if rb2[3] != byte(0)
            puts("truncate: hole_byte_3=")
            print_idec(int(rb2[3]))
            puts("\n")
            fail(17)
            return
        if rb2[9] != byte(0)
            fail(18)
            return

Step 5 — shrink to 5. Reads past 5 must return 0 (EOF).

        if posix_ftruncate(fd3, i64(5)) != i64(0)
            fail(19)
            return
        if posix_lseek(fd3, i64(0), 2) != i64(5)
            fail(20)
            return
        if posix_lseek(fd3, i64(5), 0) != i64(5)
            fail(21)
            return
        var trail: [4]byte
        if posix_read(fd3, &trail[0], 4) != 0
            fail(22)
            return

Step 6 — negative length rejected.

        val bad = posix_ftruncate(fd3, i64(-1))
        if bad != i64(-EINVAL)
            puts("truncate: neg=")
            print_idec(int(bad))
            puts("\n")
            fail(23)
            return

        posix_close(fd3)
        posix_unlinkat(AT_FDCWD, &path[0], 0)
        puts("truncate: ok\n")
        exit()
