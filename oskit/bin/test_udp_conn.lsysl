test_udp_connect — UDP connect()/send()/recv()
================================================

POSIX `connect()` on a UDP socket sets a default peer that
subsequent send() calls (sendto with NULL addr) target. After
this:

- `send(fd, buf, len)` works without an address argument.
- `connect(fd, AF_UNSPEC...)` dissolves the binding; subsequent
  send returns -ENOTCONN.

Test flow:

  1. Create rx UDP socket, bind to 7795 / 127.0.0.1.
  2. Create tx UDP socket, connect to 127.0.0.1:7795.
  3. send(tx, "abcdef", 6) — uses the saved peer.
  4. recvfrom(rx, ...) — verify length 6 + content.
  5. Dissolve via connect(tx, AF_UNSPEC); send returns -ENOTCONN.

Prints `udpcon: ok` on pass or `udpcon: bad <step>` on failure.

    module oskit.bin.test_udp_conn

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE      = 147
    val NR_BIND       = 135
    val NR_CONNECT    = 148
    val NR_RECVFROM   = 276
    val NR_SENDTO     = 307
    val NR_SOCKET     = 337

    val AF_INET_V     = 2
    val AF_UNSPEC_V   = 0
    val SOCK_DGRAM_V  = 2


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("udpcon: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_send(fd: int, data: *byte, dlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(data), i64(dlen), 0, 0, 0))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
                   addr: *byte, addrlen_ptr: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_ptr)))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val rx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if rx < 0
            fail_with(1)
            return
        var rx_addr: [16]byte
        fill_sockaddr(&rx_addr[0], 7795, 127, 0, 0, 1)
        if posix_bind(rx, &rx_addr[0], 16) < 0
            fail_with(2)
            return

        val tx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if tx < 0
            fail_with(3)
            return

        var peer: [16]byte
        fill_sockaddr(&peer[0], 7795, 127, 0, 0, 1)
        if posix_connect(tx, &peer[0], 16) != 0
            fail_with(4)
            return

        var msg: [6]byte
        msg[0] = byte('a')
        msg[1] = byte('b')
        msg[2] = byte('c')
        msg[3] = byte('d')
        msg[4] = byte('e')
        msg[5] = byte('f')
        val sent = posix_send(tx, &msg[0], 6)
        if sent != 6
            fail_with(5)
            return

        var rbuf: [16]byte
        var src: [16]byte
        var src_len: i32 = i32(16)
        val got = posix_recvfrom(rx, &rbuf[0], 16, 0, &src[0], &src_len)
        if got != 6
            fail_with(6)
            return
        var i = 0
        while i < 6
            if rbuf[i] != msg[i]
                fail_with(7)
                return
            i += 1

        // POSIX dissolve: connect with sa_family = AF_UNSPEC.
        var dis: [16]byte
        dis[0] = byte(AF_UNSPEC_V & 0xff)
        dis[1] = byte(0)
        var z = 2
        while z < 16
            dis[z] = byte(0)
            z += 1
        if posix_connect(tx, &dis[0], 16) != 0
            fail_with(8)
            return

        // Subsequent send (no addr) should now fail with -ENOTCONN.
        val send2 = posix_send(tx, &msg[0], 6)
        if send2 != -107
            fail_with(9)
            return

        posix_close(tx)
        posix_close(rx)
        puts("udpcon: ok\n")
        exit()
