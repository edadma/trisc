test_pipe — minimal pipe test
==============================

    module oskit.bin.test_pipe

    import oskit.ulib.{putc, pipe, close, exit}

    main()
        putc('1')
        var rd = 0
        var wr = 0
        putc('2')
        val r = pipe(&rd, &wr)
        putc('3')
        if r == 0
            putc('Y')
            close(rd)
            close(wr)
        else
            putc('N')
        putc('\n')
        exit()
