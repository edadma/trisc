test_msg_dwait — MSG_DONTWAIT recvfrom flag
=============================================

POSIX MSG_DONTWAIT (0x40) overrides the fd's blocking mode for
a single call. Without this flag in slix, the only way to do a
non-blocking recv was fcntl(F_SETFL, O_NONBLOCK) — which is
slow and races with other pollers sharing the fd.

Test:
  1. Open UDP socket, bind 127.0.0.1:7787.
  2. recvfrom with MSG_DONTWAIT on empty queue → -EAGAIN.
  3. fd is still in blocking mode (fcntl F_GETFL == 0).
  4. recvfrom WITHOUT the flag would block forever — skipped.

Prints `mdwait: ok` on pass or `mdwait: bad <step>` on failure.

    module oskit.bin.test_msg_dwait

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE      = 147
    val NR_BIND       = 135
    val NR_RECVFROM   = 276
    val NR_SOCKET     = 337
    val NR_FCNTL      = 171

    val AF_INET_V     = 2
    val SOCK_DGRAM_V  = 2

    val F_GETFL       = 3
    val MSG_DONTWAIT  = 0x40


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("mdwait: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_recvfrom_f(fd: int, buf: *byte, blen: int, flags: int,
                     addr: *byte, addrlen_ptr: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_ptr)))

    posix_fcntl(fd: int, cmd: int, arg: int) -> int
        int(syscall6(NR_FCNTL, i64(fd), i64(cmd), i64(arg), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val fd = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if fd < 0
            fail_with(1)
            return
        var addr: [16]byte
        fill_sockaddr(&addr[0], 7787, 127, 0, 0, 1)
        if posix_bind(fd, &addr[0], 16) < 0
            fail_with(2)
            return

        // recvfrom with MSG_DONTWAIT on empty queue → -EAGAIN.
        var rbuf: [16]byte
        var alen: i32 = i32(16)
        val got = posix_recvfrom_f(fd, &rbuf[0], 16, MSG_DONTWAIT,
            &addr[0], &alen)
        if got != -11
            fail_with(3)
            return

        // The fd must still be in blocking mode — flag was per-call.
        val fl = posix_fcntl(fd, F_GETFL, 0)
        if fl != 0
            fail_with(4)
            return

        posix_close(fd)
        puts("mdwait: ok\n")
        exit()
