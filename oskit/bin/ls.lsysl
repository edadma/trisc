ls — list directory contents
============================

Lists the contents of a directory, skipping `.` and `..`.

    module oskit.bin.ls

    import oskit.ulib.{puts, exit, readdir}

    main(argv: []string)
        var dir = "/"
        if len(argv) > 1
            dir = argv[1]
        var entry_ino: int
        var entry_name: [60]byte
        var idx = 0
        while readdir(dir, idx, &entry_ino, entry_name) == 0
            // Find name length (NUL-padded)
            var n = 0
            while n < 60
                if entry_name[n] == 0
                    break
                n += 1
            if n > 0
                // Skip . and ..
                var skip = 0
                if entry_name[0] == byte('.')
                    if n == 1
                        skip = 1
                    else if entry_name[1] == byte('.')
                        if n == 2
                            skip = 1
                if skip == 0
                    puts(string(entry_name, n))
                    puts("\n")
            idx += 1
