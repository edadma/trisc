ls — list directory contents
============================

Lists the contents of a directory, skipping `.` and `..`.

    module oskit.bin.ls

    import oskit.ulib.{puts, exit, get_args, skip_arg0, readdir}

    main()
        val args = skip_arg0(get_args())
        var dir = "/"
        if len(args) > 0
            dir = args
        var entry_ino: int
        var entry_name: [14]byte
        var idx = 0
        while readdir(dir, idx, &entry_ino, entry_name) == 0
            // Find name length (NUL-padded)
            var n = 0
            while n < 14
                if entry_name[n] == 0
                    break
                n += 1
            if n > 0
                // Skip . and ..
                var skip = 0
                if entry_name[0] == byte('.')
                    if n == 1
                        skip = 1
                    else if entry_name[1] == byte('.')
                        if n == 2
                            skip = 1
                if skip == 0
                    puts(string(entry_name, n))
                    puts("\n")
            idx += 1
        exit()
