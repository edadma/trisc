test_udp_filt — UDP recv-side peer filter on connected sockets
================================================================

POSIX (Linux) `connect()` on a UDP socket also gates the receive
path: datagrams from any source other than the connected peer
are dropped on arrival. Slix implements this in the shim — when
sys_recvfrom dequeues a non-peer datagram it loops back to the
inet IPC instead of handing it to the user.

Test flow:

  1. Create rx UDP, bind to 127.0.0.1:7794.
  2. Create tx1 UDP, bind to 127.0.0.1:7791.
  3. Create tx2 UDP, bind to 127.0.0.1:7792.
  4. connect(rx) to 127.0.0.1:7791 — peer is tx1.
  5. Send "BAD" from tx2 → should be dropped at recv.
  6. Send "OK"  from tx1 → should be delivered.
  7. fcntl(rx, O_NONBLOCK) so recv can't block on missing data.
  8. recvfrom(rx) — must return "OK" (BAD silently filtered).

Prints `udpfilt: ok` on pass or `udpfilt: bad <step>` on failure.

    module oskit.bin.test_udp_filt

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE      = 147
    val NR_BIND       = 135
    val NR_CONNECT    = 148
    val NR_RECVFROM   = 276
    val NR_SENDTO     = 307
    val NR_SOCKET     = 337
    val NR_FCNTL      = 25

    val AF_INET_V     = 2
    val SOCK_DGRAM_V  = 2

    val F_SETFL       = 4
    val O_NONBLOCK    = 0x800


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("udpfilt: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_sendto(fd: int, buf: *byte, blen: int, flags: int,
                 addr: *byte, addrlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen)))

    posix_recv_nb(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            0, 0, 0))

    posix_fcntl(fd: int, cmd: int, arg: int) -> int
        int(syscall6(NR_FCNTL, i64(fd), i64(cmd), i64(arg), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val rx = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if rx < 0
            fail_with(1)
            return
        var rx_addr: [16]byte
        fill_sockaddr(&rx_addr[0], 7794, 127, 0, 0, 1)
        if posix_bind(rx, &rx_addr[0], 16) < 0
            fail_with(2)
            return

        val tx1 = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if tx1 < 0
            fail_with(3)
            return
        var tx1_addr: [16]byte
        fill_sockaddr(&tx1_addr[0], 7791, 127, 0, 0, 1)
        if posix_bind(tx1, &tx1_addr[0], 16) < 0
            fail_with(4)
            return

        val tx2 = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if tx2 < 0
            fail_with(5)
            return
        var tx2_addr: [16]byte
        fill_sockaddr(&tx2_addr[0], 7792, 127, 0, 0, 1)
        if posix_bind(tx2, &tx2_addr[0], 16) < 0
            fail_with(6)
            return

        if posix_connect(rx, &tx1_addr[0], 16) != 0
            fail_with(7)
            return

        var rx_dst: [16]byte
        fill_sockaddr(&rx_dst[0], 7794, 127, 0, 0, 1)
        var bad: [3]byte
        bad[0] = byte('B')
        bad[1] = byte('A')
        bad[2] = byte('D')
        if posix_sendto(tx2, &bad[0], 3, 0, &rx_dst[0], 16) != 3
            fail_with(9)
            return

        var ok: [2]byte
        ok[0] = byte('O')
        ok[1] = byte('K')
        if posix_sendto(tx1, &ok[0], 2, 0, &rx_dst[0], 16) != 2
            fail_with(10)
            return

        // Make rx non-blocking so the recv that follows the
        // (filtered) BAD doesn't park if no peer datagram arrives.
        // Order matters: we set NB after BOTH datagrams are queued,
        // so the recv loop dequeues both synchronously without
        // racing the inet receiver.
        if posix_fcntl(rx, F_SETFL, O_NONBLOCK) != 0
            fail_with(8)
            return

        var rbuf: [16]byte
        val got = posix_recv_nb(rx, &rbuf[0], 16)
        if got != 2
            fail_with(11)
            return
        if rbuf[0] != byte('O')
            fail_with(12)
            return
        if rbuf[1] != byte('K')
            fail_with(13)
            return

        posix_close(tx2)
        posix_close(tx1)
        posix_close(rx)
        puts("udpfilt: ok\n")
        exit()
