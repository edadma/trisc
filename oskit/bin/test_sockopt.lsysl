test_sockopt — setsockopt / getsockopt accept-and-ignore + bufsize
==================================================================

Exercises the setsockopt / getsockopt paths in the POSIX shim:

- The accept-and-ignore set (SO_REUSEADDR, SO_BROADCAST,
  SO_KEEPALIVE, SO_REUSEPORT, TCP_NODELAY) on a UDP fd —
  always returns 0, getsockopt writes 0.
- Phase E real plumbing for SO_SNDBUF / SO_RCVBUF on a TCP fd:
  setsockopt persists the requested size on the shim fd, and
  getsockopt echoes it back.  At connect/listen time the size
  is forwarded to inet via the extended CONNECT/LISTEN wire.

Pass criteria (UDP):
- `setsockopt SO_REUSEADDR = 1` returns 0
- `setsockopt SO_BROADCAST = 1` returns 0
- `setsockopt TCP_NODELAY = 1` returns 0
- `setsockopt <unknown>` returns -92
- `getsockopt SO_REUSEADDR` returns 0, writes value=0, optlen=4
- `getsockopt <unknown>` returns -92

Pass criteria (TCP):
- `setsockopt SO_SNDBUF = 2048` returns 0; getsockopt echoes 2048
- `setsockopt SO_RCVBUF = 4096` returns 0; getsockopt echoes 4096

Final marker: `sockopt: done`.

    module oskit.bin.test_sockopt

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_SETSOCKOPT = 326
    val NR_GETSOCKOPT = 204
    val NR_SOCKET     = 337
    val NR_CLOSE      = 147

    val AF_INET_V     = 2
    val SOCK_DGRAM_V  = 2
    val SOCK_STREAM_V = 1

    val SOL_SOCKET    = 1
    val SO_REUSEADDR  = 2
    val SO_ERROR      = 4
    val SO_BROADCAST  = 6
    val SO_SNDBUF     = 7
    val SO_RCVBUF     = 8
    val SO_LINGER     = 13
    val IPPROTO_TCP   = 6
    val TCP_NODELAY   = 1
    val TCP_KEEPIDLE  = 4
    val TCP_KEEPINTVL = 5
    val TCP_KEEPCNT   = 6


Decimal printer for small signed ints (handles the negative
`-errno` we report for unknown options).

    print_sdec(v: int)
        if v < 0
            puts("-")
            print_sdec(-v)
            return
        if v >= 10
            print_sdec(v / 10)
        var buf: [1]byte
        buf[0] = byte('0' + (v % 10))
        puts(string(&buf[0], 1))


Raw POSIX syscall wrappers.

    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_setsockopt(fd: int, level: int, optname: int,
                     optval: *byte, vlen: int) -> int
        int(syscall6(NR_SETSOCKOPT, i64(fd), i64(level), i64(optname),
            i64(optval), i64(vlen), 0))

    posix_getsockopt(fd: int, level: int, optname: int,
                     optval: *byte, lenp: *i32) -> int
        int(syscall6(NR_GETSOCKOPT, i64(fd), i64(level), i64(optname),
            i64(optval), i64(lenp), 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val fd = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if fd < 0
            puts("sockopt: socket failed\n")
            exit_with(1)
            return

        var v: [4]byte
        v[0] = byte(1)
        v[1] = byte(0)
        v[2] = byte(0)
        v[3] = byte(0)

        val r1 = posix_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &v[0], 4)
        puts("sockopt: set SO_REUSEADDR = ")
        print_sdec(r1)
        puts("\n")
        if r1 != 0
            puts("sockopt: FAIL SO_REUSEADDR\n")
            exit_with(2)
            return

        val r2 = posix_setsockopt(fd, SOL_SOCKET, SO_BROADCAST, &v[0], 4)
        puts("sockopt: set SO_BROADCAST = ")
        print_sdec(r2)
        puts("\n")
        if r2 != 0
            puts("sockopt: FAIL SO_BROADCAST\n")
            exit_with(3)
            return

        val r3 = posix_setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &v[0], 4)
        puts("sockopt: set TCP_NODELAY = ")
        print_sdec(r3)
        puts("\n")
        if r3 != 0
            puts("sockopt: FAIL TCP_NODELAY\n")
            exit_with(4)
            return

        // Unknown option — should report -ENOPROTOOPT (-92).
        val r4 = posix_setsockopt(fd, SOL_SOCKET, 999, &v[0], 4)
        puts("sockopt: set unknown = ")
        print_sdec(r4)
        puts("\n")
        if r4 != -92
            puts("sockopt: FAIL unknown (expected -92)\n")
            exit_with(5)
            return

        var outv: [8]byte
        outv[0] = byte(0xaa)
        outv[1] = byte(0xbb)
        outv[2] = byte(0xcc)
        outv[3] = byte(0xdd)
        var olen: i32 = i32(8)
        val r5 = posix_getsockopt(fd, SOL_SOCKET, SO_REUSEADDR,
                                  &outv[0], &olen)
        puts("sockopt: get SO_REUSEADDR = ")
        print_sdec(r5)
        puts(" olen=")
        print_sdec(int(olen))
        puts(" val=")
        print_sdec(int(outv[0]))
        puts("\n")
        if r5 != 0
            puts("sockopt: FAIL get SO_REUSEADDR\n")
            exit_with(6)
            return
        if int(olen) != 4
            puts("sockopt: FAIL olen not 4\n")
            exit_with(7)
            return
        // The persistence pass echoes the actually-set value; we set
        // SO_REUSEADDR=1 above, so getsockopt must read back 1.
        if int(outv[0]) != 1
            puts("sockopt: FAIL val not 1 (expected echoed REUSEADDR=1)\n")
            exit_with(8)
            return

        val r6 = posix_getsockopt(fd, SOL_SOCKET, 999,
                                  &outv[0], &olen)
        puts("sockopt: get unknown = ")
        print_sdec(r6)
        puts("\n")
        if r6 != -92
            puts("sockopt: FAIL get unknown (expected -92)\n")
            exit_with(9)
            return

        posix_close(fd)

        // Phase E: TCP fd round-trip for SO_SNDBUF / SO_RCVBUF.
        val tfd = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if tfd < 0
            puts("sockopt: tcp socket failed\n")
            exit_with(10)
            return

        var sb: [4]byte
        sb[0] = byte(0)
        sb[1] = byte(8)        // 0x0800 LE = 2048
        sb[2] = byte(0)
        sb[3] = byte(0)
        val r7 = posix_setsockopt(tfd, SOL_SOCKET, SO_SNDBUF, &sb[0], 4)
        puts("sockopt: set SO_SNDBUF = ")
        print_sdec(r7)
        puts("\n")
        if r7 != 0
            puts("sockopt: FAIL set SO_SNDBUF\n")
            exit_with(11)
            return

        var rb: [4]byte
        rb[0] = byte(0)
        rb[1] = byte(16)       // 0x1000 LE = 4096
        rb[2] = byte(0)
        rb[3] = byte(0)
        val r8 = posix_setsockopt(tfd, SOL_SOCKET, SO_RCVBUF, &rb[0], 4)
        puts("sockopt: set SO_RCVBUF = ")
        print_sdec(r8)
        puts("\n")
        if r8 != 0
            puts("sockopt: FAIL set SO_RCVBUF\n")
            exit_with(12)
            return

        // Echo back via getsockopt — pre-connect, the shim returns
        // the pending value (no inet slot yet).
        var snd_out: [4]byte
        snd_out[0] = byte(0xff)
        snd_out[1] = byte(0xff)
        snd_out[2] = byte(0xff)
        snd_out[3] = byte(0xff)
        var snd_olen: i32 = i32(4)
        val r9 = posix_getsockopt(tfd, SOL_SOCKET, SO_SNDBUF,
                                  &snd_out[0], &snd_olen)
        val snd_b0 = int(snd_out[0]) & 0xff
        val snd_b1 = int(snd_out[1]) & 0xff
        val snd_b2 = int(snd_out[2]) & 0xff
        val snd_b3 = int(snd_out[3]) & 0xff
        val snd_val = snd_b0 | (snd_b1 << 8) | (snd_b2 << 16) | (snd_b3 << 24)
        puts("sockopt: get SO_SNDBUF = ")
        print_sdec(r9)
        puts(" val=")
        print_sdec(snd_val)
        puts("\n")
        if r9 != 0 || snd_val != 2048
            puts("sockopt: FAIL get SO_SNDBUF round-trip\n")
            exit_with(13)
            return

        var rcv_out: [4]byte
        rcv_out[0] = byte(0xff)
        rcv_out[1] = byte(0xff)
        rcv_out[2] = byte(0xff)
        rcv_out[3] = byte(0xff)
        var rcv_olen: i32 = i32(4)
        val r10 = posix_getsockopt(tfd, SOL_SOCKET, SO_RCVBUF,
                                   &rcv_out[0], &rcv_olen)
        val rcv_b0 = int(rcv_out[0]) & 0xff
        val rcv_b1 = int(rcv_out[1]) & 0xff
        val rcv_b2 = int(rcv_out[2]) & 0xff
        val rcv_b3 = int(rcv_out[3]) & 0xff
        val rcv_val = rcv_b0 | (rcv_b1 << 8) | (rcv_b2 << 16) | (rcv_b3 << 24)
        puts("sockopt: get SO_RCVBUF = ")
        print_sdec(r10)
        puts(" val=")
        print_sdec(rcv_val)
        puts("\n")
        if r10 != 0 || rcv_val != 4096
            puts("sockopt: FAIL get SO_RCVBUF round-trip\n")
            exit_with(14)
            return

        // TCP_NODELAY round-trip: the persistence pass echoes the
        // set value via getsockopt.  No behavioural enforcement
        // (slix has no Nagle), so this is option-introspection only.
        var nd: [4]byte
        nd[0] = byte(1)
        nd[1] = byte(0)
        nd[2] = byte(0)
        nd[3] = byte(0)
        val r11 = posix_setsockopt(tfd, IPPROTO_TCP, TCP_NODELAY, &nd[0], 4)
        puts("sockopt: set TCP_NODELAY tfd = ")
        print_sdec(r11)
        puts("\n")
        if r11 != 0
            puts("sockopt: FAIL set TCP_NODELAY tfd\n")
            exit_with(15)
            return

        var nd_out: [4]byte
        nd_out[0] = byte(0xff)
        nd_out[1] = byte(0xff)
        nd_out[2] = byte(0xff)
        nd_out[3] = byte(0xff)
        var nd_olen: i32 = i32(4)
        val r12 = posix_getsockopt(tfd, IPPROTO_TCP, TCP_NODELAY,
                                   &nd_out[0], &nd_olen)
        puts("sockopt: get TCP_NODELAY = ")
        print_sdec(r12)
        puts(" val=")
        print_sdec(int(nd_out[0]))
        puts("\n")
        if r12 != 0 || int(nd_out[0]) != 1
            puts("sockopt: FAIL get TCP_NODELAY round-trip\n")
            exit_with(16)
            return

        // SO_LINGER round-trip — struct linger is (i32 l_onoff,
        // i32 l_linger) = 8 bytes. Set l_onoff=1 l_linger=0 (the
        // abort-close shortcut) and verify both come back.
        var ls: [8]byte
        ls[0] = byte(1)        // l_onoff i32 LE = 1
        ls[1] = byte(0)
        ls[2] = byte(0)
        ls[3] = byte(0)
        ls[4] = byte(0)        // l_linger i32 LE = 0
        ls[5] = byte(0)
        ls[6] = byte(0)
        ls[7] = byte(0)
        val r13 = posix_setsockopt(tfd, SOL_SOCKET, SO_LINGER, &ls[0], 8)
        puts("sockopt: set SO_LINGER = ")
        print_sdec(r13)
        puts("\n")
        if r13 != 0
            puts("sockopt: FAIL set SO_LINGER\n")
            exit_with(17)
            return

        var ls_out: [8]byte
        var i = 0
        while i < 8
            ls_out[i] = byte(0xff)
            i += 1
        var ls_olen: i32 = i32(8)
        val r14 = posix_getsockopt(tfd, SOL_SOCKET, SO_LINGER,
                                   &ls_out[0], &ls_olen)
        val on_lo = int(ls_out[0]) & 0xff
        val secs_lo = int(ls_out[4]) & 0xff
        puts("sockopt: get SO_LINGER = ")
        print_sdec(r14)
        puts(" olen=")
        print_sdec(int(ls_olen))
        puts(" on=")
        print_sdec(on_lo)
        puts(" secs=")
        print_sdec(secs_lo)
        puts("\n")
        if r14 != 0
            puts("sockopt: FAIL get SO_LINGER\n")
            exit_with(18)
            return
        if int(ls_olen) != 8
            puts("sockopt: FAIL SO_LINGER olen not 8\n")
            exit_with(19)
            return
        if on_lo != 1 || secs_lo != 0
            puts("sockopt: FAIL SO_LINGER round-trip values\n")
            exit_with(20)
            return

        // TCP_KEEPIDLE / TCP_KEEPINTVL / TCP_KEEPCNT round-trip.
        // Pre-connect TCP fd: persists on the shim only; getsockopt
        // reads back the exact seconds the user set.
        var ki: [4]byte
        ki[0] = byte(60)       // 60 seconds LE
        ki[1] = byte(0)
        ki[2] = byte(0)
        ki[3] = byte(0)
        val r15 = posix_setsockopt(tfd, IPPROTO_TCP, TCP_KEEPIDLE, &ki[0], 4)
        puts("sockopt: set TCP_KEEPIDLE = ")
        print_sdec(r15)
        puts("\n")
        if r15 != 0
            puts("sockopt: FAIL set TCP_KEEPIDLE\n")
            exit_with(21)
            return

        var ki_out: [4]byte
        ki_out[0] = byte(0xff)
        ki_out[1] = byte(0xff)
        ki_out[2] = byte(0xff)
        ki_out[3] = byte(0xff)
        var ki_olen: i32 = i32(4)
        val r16 = posix_getsockopt(tfd, IPPROTO_TCP, TCP_KEEPIDLE,
                                   &ki_out[0], &ki_olen)
        val ki_b0 = int(ki_out[0]) & 0xff
        val ki_b1 = int(ki_out[1]) & 0xff
        val ki_val = ki_b0 | (ki_b1 << 8)
        puts("sockopt: get TCP_KEEPIDLE = ")
        print_sdec(r16)
        puts(" val=")
        print_sdec(ki_val)
        puts("\n")
        if r16 != 0 || ki_val != 60
            puts("sockopt: FAIL get TCP_KEEPIDLE\n")
            exit_with(22)
            return

        var kv: [4]byte
        kv[0] = byte(15)
        kv[1] = byte(0)
        kv[2] = byte(0)
        kv[3] = byte(0)
        val r17 = posix_setsockopt(tfd, IPPROTO_TCP, TCP_KEEPINTVL, &kv[0], 4)
        puts("sockopt: set TCP_KEEPINTVL = ")
        print_sdec(r17)
        puts("\n")
        if r17 != 0
            puts("sockopt: FAIL set TCP_KEEPINTVL\n")
            exit_with(23)
            return

        var kv_out: [4]byte
        kv_out[0] = byte(0xff)
        kv_out[1] = byte(0xff)
        kv_out[2] = byte(0xff)
        kv_out[3] = byte(0xff)
        var kv_olen: i32 = i32(4)
        val r18 = posix_getsockopt(tfd, IPPROTO_TCP, TCP_KEEPINTVL,
                                   &kv_out[0], &kv_olen)
        val kv_b0 = int(kv_out[0]) & 0xff
        val kv_b1 = int(kv_out[1]) & 0xff
        val kv_val = kv_b0 | (kv_b1 << 8)
        puts("sockopt: get TCP_KEEPINTVL = ")
        print_sdec(r18)
        puts(" val=")
        print_sdec(kv_val)
        puts("\n")
        if r18 != 0 || kv_val != 15
            puts("sockopt: FAIL get TCP_KEEPINTVL\n")
            exit_with(24)
            return

        var kc: [4]byte
        kc[0] = byte(7)
        kc[1] = byte(0)
        kc[2] = byte(0)
        kc[3] = byte(0)
        val r19 = posix_setsockopt(tfd, IPPROTO_TCP, TCP_KEEPCNT, &kc[0], 4)
        puts("sockopt: set TCP_KEEPCNT = ")
        print_sdec(r19)
        puts("\n")
        if r19 != 0
            puts("sockopt: FAIL set TCP_KEEPCNT\n")
            exit_with(25)
            return

        var kc_out: [4]byte
        kc_out[0] = byte(0xff)
        kc_out[1] = byte(0xff)
        kc_out[2] = byte(0xff)
        kc_out[3] = byte(0xff)
        var kc_olen: i32 = i32(4)
        val r20 = posix_getsockopt(tfd, IPPROTO_TCP, TCP_KEEPCNT,
                                   &kc_out[0], &kc_olen)
        val kc_val = int(kc_out[0]) & 0xff
        puts("sockopt: get TCP_KEEPCNT = ")
        print_sdec(r20)
        puts(" val=")
        print_sdec(kc_val)
        puts("\n")
        if r20 != 0 || kc_val != 7
            puts("sockopt: FAIL get TCP_KEEPCNT\n")
            exit_with(26)
            return

        // SO_ERROR — fresh TCP fd reads back 0 (clean state). The
        // read-and-clear behaviour is exercised by test_icmperr (the
        // ICMP-error pickup path sets last_error before recvfrom
        // returns -ECONNREFUSED, so a follow-up SO_ERROR returns 111
        // once and 0 thereafter).
        var er_out: [4]byte
        er_out[0] = byte(0xff)
        er_out[1] = byte(0xff)
        er_out[2] = byte(0xff)
        er_out[3] = byte(0xff)
        var er_olen: i32 = i32(4)
        val r21 = posix_getsockopt(tfd, SOL_SOCKET, SO_ERROR,
                                   &er_out[0], &er_olen)
        val er_b0 = int(er_out[0]) & 0xff
        val er_b1 = int(er_out[1]) & 0xff
        val er_b2 = int(er_out[2]) & 0xff
        val er_b3 = int(er_out[3]) & 0xff
        val er_val = er_b0 | (er_b1 << 8) | (er_b2 << 16) | (er_b3 << 24)
        puts("sockopt: get SO_ERROR fresh = ")
        print_sdec(r21)
        puts(" val=")
        print_sdec(er_val)
        puts("\n")
        if r21 != 0 || er_val != 0
            puts("sockopt: FAIL get SO_ERROR fresh\n")
            exit_with(27)
            return

        posix_close(tfd)
        puts("sockopt: done\n")
        exit()
