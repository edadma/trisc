test_pmtutcp — TCP MSS clamping driven by PMTU cache
=====================================================

Final piece of Option B Session 2: the TCP egress drain
consults the PMTU cache before deciding segment size, so a
peer that reports `Fragmentation Needed` with a small
Next-Hop MTU shrinks our segments without us having to
fragment IP.

Test flow:

  1. Listen on 127.0.0.1:9101, connect from a second socket.
  2. accept() — both ends established (loopback fastpath).
  3. Inject ICMP type-3 code-4 with `Next-Hop MTU = 350` for
     127.0.0.1 via `pmtu_discover_inject` (exercises the real
     RFC 1191 path, not the test-only setter).
     - PMTU=350 → effective MSS = 350 - IP(20) - TCP(40) = 290.
  4. Snapshot `inet_tcp_data_seg_emit_count`.
  5. write(900 bytes) on the client.
  6. read(900 bytes) on the accepted child to drain.
  7. Snapshot the counter again. Without PMTU clamping
     TCP_MAX_SEG=480 means at most ⌈900/480⌉ = 2 segments;
     with clamping ⌈900/290⌉ = 4 segments minimum. We assert
     `delta >= 3` so a regression that reverts the clamp
     fails this test.

Pass criterion: prints `pmtutcp: ok`.

    module oskit.bin.test_pmtutcp

    import oskit.ulib.{puts, exit, exit_with, syscall6}
    import oskit.net.{pmtu_discover_inject, tcp_data_seg_emit_count}


    val NR_WRITE   = 128
    val NR_READ    = 130
    val NR_ACCEPT  = 131
    val NR_BIND    = 135
    val NR_CLOSE   = 147
    val NR_CONNECT = 148
    val NR_LISTEN  = 217
    val NR_SOCKET  = 337

    val AF_INET_V     = 2
    val SOCK_STREAM_V = 1

    val SEND_LEN = 900


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_accept(fd: int, addr: *byte, addrlen: *int) -> int
        int(syscall6(NR_ACCEPT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_write(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_WRITE, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_read(fd: int, buf: *byte, blen: int) -> int
        int(syscall6(NR_READ, i64(fd), i64(buf), i64(blen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    fail(code: int)
        puts("pmtutcp: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    main(argv: []string)
        val ls = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if ls < 0
            fail(1)
            return

        var bind_addr: [16]byte
        fill_sockaddr(&bind_addr[0], 9101, 0, 0, 0, 0)
        if posix_bind(ls, &bind_addr[0], 16) != 0
            fail(2)
            return
        if posix_listen(ls, 4) != 0
            fail(3)
            return

        val cl = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if cl < 0
            fail(4)
            return

        var conn_addr: [16]byte
        fill_sockaddr(&conn_addr[0], 9101, 127, 0, 0, 1)
        if posix_connect(cl, &conn_addr[0], 16) != 0
            fail(5)
            return

        var peer_addr: [16]byte
        var peer_len: int = 16
        val sv = posix_accept(ls, &peer_addr[0], &peer_len)
        if sv < 0
            fail(6)
            return

Inject a Frag-Needed ICMP for 127.0.0.1 with MTU=350. Reply
must echo 350 (proves the parser ran and the cache holds it).

        val cached = pmtu_discover_inject(127, 0, 0, 1, 350)
        if cached != 350
            puts("pmtutcp: inject got ")
            print_idec(cached)
            puts("\n")
            fail(7)
            return

        val before = tcp_data_seg_emit_count()
        if before < 0
            fail(8)
            return

Build a deterministic 900-byte payload (byte i = i & 0xff).
Receiver side validates a sample to catch any clamp-induced
truncation.

        var send_buf: [900]byte
        var i = 0
        while i < SEND_LEN
            send_buf[i] = byte(i & 0xff)
            i += 1

Hand off the whole buffer in one write(). The shim's TCP
sendto path appends to send_buf and the drain emits multiple
segments based on the PMTU clamp. This is one IPC into inet
that produces N emit-frame calls inside.

        val sent = posix_write(cl, &send_buf[0], SEND_LEN)
        if sent != SEND_LEN
            puts("pmtutcp: write returned ")
            print_idec(sent)
            puts("\n")
            fail(9)
            return

Drain on the accepted child until we've read all 900 bytes.
Loopback ACKs are synchronous so the drain completes quickly,
but the receive buffer is small (1024 default) so multiple
read() calls are needed.

        var recv_buf: [900]byte
        var got = 0
        while got < SEND_LEN
            val r = posix_read(sv, &recv_buf[got], SEND_LEN - got)
            if r <= 0
                puts("pmtutcp: read returned ")
                print_idec(r)
                puts("\n")
                fail(10)
                return
            got += r

Spot-check a few bytes — full byte-by-byte loop would mask the
test's intent but a regression that drops content from the
clamp path would corrupt the trailing bytes.

        if recv_buf[0] != byte(0)
            fail(11)
            return
        if recv_buf[SEND_LEN - 1] != byte((SEND_LEN - 1) & 0xff)
            fail(12)
            return

        val after = tcp_data_seg_emit_count()
        if after < 0
            fail(13)
            return
        val delta = after - before

Without the PMTU clamp the drain would emit ⌈900 / 480⌉ = 2
data segments. With it ⌈900 / 290⌉ = 4. Allow some slack
(retransmits, window constraints) but reject anything ≤ 2 —
that would mean the clamp didn't engage.

        if delta < 3
            puts("pmtutcp: delta=")
            print_idec(delta)
            puts("\n")
            fail(14)
            return

        posix_close(sv)
        posix_close(cl)
        posix_close(ls)
        puts("pmtutcp: ok\n")
        exit()
