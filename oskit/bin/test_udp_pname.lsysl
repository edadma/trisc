test_udp_pname — getpeername + shutdown on UDP
================================================

POSIX:
- `getpeername()` on a connected UDP fd returns the saved peer
  set by `connect()`. Unconnected → -ENOTCONN.
- `shutdown()` on UDP is accepted as a no-op (Linux compat —
  some apps call shutdown(udp_fd, SHUT_WR) before close).

Without these, libuv-style UDP code that probes the connect
state via getpeername falls back to error paths.

Test:
  1. Open UDP socket.
  2. getpeername (no connect yet) → -ENOTCONN (-107).
  3. shutdown(SHUT_WR) → 0 (no-op, even pre-connect).
  4. connect to 127.0.0.1:7786.
  5. getpeername → 0 with peer = 127.0.0.1:7786.
  6. shutdown(SHUT_RDWR) → 0.

Prints `udppeer: ok` on pass, `udppeer: bad <step>` on failure.

    module oskit.bin.test_udp_pname

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_CLOSE        = 147
    val NR_CONNECT      = 148
    val NR_SOCKET       = 337
    val NR_SHUTDOWN     = 334
    val NR_GETPEERNAME  = 192

    val AF_INET_V       = 2
    val SOCK_DGRAM_V    = 2

    val SHUT_WR         = 1
    val SHUT_RDWR       = 2


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fail_with(code: int)
        puts("udppeer: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_connect(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_CONNECT, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_getpeername(fd: int, addr: *byte, alp: *i32) -> int
        int(syscall6(NR_GETPEERNAME, i64(fd), i64(addr), i64(alp), 0, 0, 0))

    posix_shutdown(fd: int, how: int) -> int
        int(syscall6(NR_SHUTDOWN, i64(fd), i64(how), 0, 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    main(argv: []string)
        val fd = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if fd < 0
            fail_with(1)
            return

        // getpeername pre-connect → -ENOTCONN.
        var peer: [16]byte
        var alen: i32 = i32(16)
        val gp1 = posix_getpeername(fd, &peer[0], &alen)
        if gp1 != -107
            fail_with(2)
            return

        // shutdown(SHUT_WR) on unconnected UDP → 0 (no-op).
        if posix_shutdown(fd, SHUT_WR) != 0
            fail_with(3)
            return

        // connect to 127.0.0.1:7786.
        var dst: [16]byte
        fill_sockaddr(&dst[0], 7786, 127, 0, 0, 1)
        if posix_connect(fd, &dst[0], 16) != 0
            fail_with(4)
            return

        // getpeername now returns the saved peer.
        alen = i32(16)
        if posix_getpeername(fd, &peer[0], &alen) != 0
            fail_with(5)
            return
        if int(alen) != 16
            fail_with(6)
            return
        // family field
        if peer[0] != byte(AF_INET_V & 0xff)
            fail_with(7)
            return
        // port (BE)
        val pp = ((int(peer[2]) & 0xff) << 8) | (int(peer[3]) & 0xff)
        if pp != 7786
            fail_with(8)
            return
        if peer[4] != byte(127)
            fail_with(9)
            return
        if peer[5] != byte(0)
            fail_with(10)
            return
        if peer[6] != byte(0)
            fail_with(11)
            return
        if peer[7] != byte(1)
            fail_with(12)
            return

        // shutdown(SHUT_RDWR) on connected UDP → 0.
        if posix_shutdown(fd, SHUT_RDWR) != 0
            fail_with(13)
            return

        posix_close(fd)
        puts("udppeer: ok\n")
        exit()
