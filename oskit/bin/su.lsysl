su — Switch User

Authenticate as another user and spawn a shell.
Usage: su [username]  (default: root)

    module oskit.bin.su

    import oskit.ulib.{write_handle, getc, open, read, close,
        sleep, setuid, exit, connect, pm_spawn_handles, pm_waitpid,
        get_args, skip_arg0,
        STDOUT}
    import std.crypto.pbkdf2.{pbkdf2_hmac_sha256}

Buffered output.

    var su_out: [140]byte
    var su_outpos = 0

    su_flush()
        if su_outpos > 0
            write_handle(STDOUT, su_out, su_outpos)
            su_outpos = 0

    su_putc(ch: char)
        if su_outpos >= 120
            su_flush()
        su_out[su_outpos] = byte(ch)
        su_outpos += 1

    su_print(s: string)
        val p = *byte(s)
        val n = len(s)
        for var i = 0; i < n; i++
            if su_outpos >= 120
                su_flush()
            su_out[su_outpos] = p[i]
            su_outpos += 1

    su_newline()
        su_putc('\n')
        su_flush()

Read a line without echo (for password).

    su_readline(buf: *byte, maxlen: int) -> int
        var blen = 0
        while blen < maxlen - 1
            val ch = getc()
            if ch == '\n'
                su_newline()
                buf[blen] = 0
                return blen
            else if ch == 8
                if blen > 0
                    blen -= 1
            else if ch == 27
                val c2 = getc()
                if c2 == '['
                    var cx = getc()
                    while cx >= 0
                        if cx != '['
                            if cx >= 64
                                if cx <= 126
                                    break
                        cx = getc()
                else if c2 == 'O'
                    val _ss3 = getc()
            else if ch >= ' '
                buf[blen] = byte(ch)
                blen += 1
        buf[blen] = 0
        blen

Compare two byte buffers.

    su_bufcmp(a: *byte, alen: int, b: *byte, blen: int) -> int
        if alen != blen
            return 0
        for var i = 0; i < alen; i++
            if a[i] != b[i]
                return 0
        1

Read a file into a buffer.

    su_read_file(path: string, buf: *byte, maxlen: int) -> int
        val fid = open(path)
        if fid < 0
            return -1
        val nr = read(fid, buf, maxlen)
        close(fid)
        nr

Parse a colon-delimited field.

    su_parse_field(buf: *byte, pos: int, limit: int, field_start: *int, field_len: *int) -> int
        *field_start = pos
        var p = pos
        while p < limit
            if buf[p] == ':'
                *field_len = p - pos
                return p + 1
            if buf[p] == '\n'
                *field_len = p - pos
                return p + 1
            p += 1
        *field_len = p - pos
        p

Find a line matching a username.

    su_find_user_line(buf: *byte, buflen: int, user: *byte, userlen: int) -> int
        var pos = 0
        while pos < buflen
            var eol = pos
            while eol < buflen
                if buf[eol] == '\n'
                    break
                eol += 1
            var fstart: int
            var flen: int
            su_parse_field(buf, pos, eol, &fstart, &flen)
            if su_bufcmp(buf + fstart, flen, user, userlen) != 0
                return pos
            pos = eol + 1
        -1

Parsed home directory.

    var su_home: [128]byte
    var su_home_len = 0

Look up user in /etc/passwd. Returns uid or -1.

    su_lookup_passwd(user: *byte, userlen: int) -> int
        var filebuf: [4096]byte
        val nr = su_read_file("/etc/passwd", filebuf, 4096)
        if nr <= 0
            return -1
        val line = su_find_user_line(filebuf, nr, user, userlen)
        if line < 0
            return -1
        var fstart: int
        var flen: int
        var pos = line
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        var uid = 0
        for var i = 0; i < flen; i++
            uid = uid * 10 + int(filebuf[fstart + i]) - '0'
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        su_home_len = flen
        for var i = 0; i < flen; i++
            su_home[i] = filebuf[fstart + i]
        uid

    su_hex_nibble(ch: int) -> int
        if ch >= '0'
            if ch <= '9'
                return ch - '0'
        if ch >= 'a'
            if ch <= 'f'
                return ch - 'a' + 10
        if ch >= 'A'
            if ch <= 'F'
                return ch - 'A' + 10
        -1

Check password against /etc/shadow.

    su_check_shadow(user: *byte, userlen: int, pass: *byte, passlen: int) -> int
        var filebuf: [4096]byte
        val nr = su_read_file("/etc/shadow", filebuf, 4096)
        if nr <= 0
            return 0
        val line = su_find_user_line(filebuf, nr, user, userlen)
        if line < 0
            return 0
        var fstart: int
        var flen: int
        var pos = line
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        pos = su_parse_field(filebuf, pos, nr, &fstart, &flen)
        val salt_start = fstart
        val salt_len = flen
        su_parse_field(filebuf, pos, nr, &fstart, &flen)
        val hash_start = fstart
        val hash_len = flen
        if hash_len != 64
            return 0
        var pass_buf: [64]byte
        for var i = 0; i < passlen; i++
            pass_buf[i] = byte(pass[i])
        var salt_buf: [64]byte
        for var i = 0; i < salt_len; i++
            salt_buf[i] = byte(filebuf[salt_start + i])
        var computed: [32]byte
        pbkdf2_hmac_sha256(pass_buf[:passlen], salt_buf[:salt_len], 1, computed[:])
        for var i = 0; i < 32; i++
            val b = int(computed[i])
            val hi = su_hex_nibble(int(filebuf[hash_start + i * 2]))
            val lo = su_hex_nibble(int(filebuf[hash_start + i * 2 + 1]))
            if hi < 0
                return 0
            if lo < 0
                return 0
            if b != hi * 16 + lo
                return 0
        1

Spawn a shell as the target user.

    su_spawn_shell()
        val home_str = string(su_home, su_home_len)
        var argv: [2]string
        argv[0] = "nsh"
        argv[1] = home_str
        val h_in = connect("tty:0")
        val h_out = connect("tty:0")
        val h_err = connect("tty:0")
        var hmap: [6]byte
        hmap[0] = byte(h_in)
        hmap[1] = 0
        hmap[2] = byte(h_out)
        hmap[3] = 1
        hmap[4] = byte(h_err)
        hmap[5] = 2
        val pid = pm_spawn_handles("/bin/nsh", argv, 2, hmap, 3)
        close(h_in)
        close(h_out)
        close(h_err)
        if pid >= 0
            pm_waitpid(pid)

    main(argv: []string)
        // Parse argument — default to "root"
        var user: [64]byte
        var userlen = 4
        user[0] = 'r'; user[1] = 'o'; user[2] = 'o'; user[3] = 't'

        if len(argv) > 1
            val arg = argv[1]
            val p = *byte(arg)
            userlen = len(arg)
            if userlen > 63
                userlen = 63
            var i = 0
            while i < userlen
                user[i] = p[i]
                i += 1

        val uid = su_lookup_passwd(user, userlen)
        if uid < 0
            su_print("su: unknown user\n")
            su_flush()
            exit()
            return

        su_print("Password: ")
        su_flush()
        var pass: [64]byte
        val plen = su_readline(pass, 64)

        if su_check_shadow(user, userlen, pass, plen) == 0
            sleep(3)
            su_print("su: authentication failure\n")
            su_flush()
            exit()
            return

        setuid(uid)
        su_spawn_shell()
