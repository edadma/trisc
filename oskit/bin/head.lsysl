head — output the first N lines
=================================

Usage: `head [-n N] [file]`
- Default: 10 lines.
- Reads from stdin if no file argument.

    module oskit.bin.head

    import oskit.ulib.{open, read, close, puts, exit, get_args, skip_arg0, write_handle, STDIN, STDOUT}

    val HEAD_BUF = 4096

Parse a decimal integer from a byte pointer. Returns the value.

    parse_int(p: *byte, plen: int) -> int
        var v = 0
        var i = 0
        while i < plen
            val ch = int(p[i])
            if ch < '0'
                break
            if ch > '9'
                break
            v = v * 10 + (ch - '0')
            i += 1
        v

    main()
        val args = get_args()
        var rest = skip_arg0(args)
        var count = 10

        // Parse -n N or -N
        val rp = *byte(rest)
        val rlen = len(rest)
        if rlen > 1
            if rp[0] == byte('-')
                if rp[1] == byte('n')
                    // Skip "-n "
                    var i = 2
                    while i < rlen
                        if rp[i] != byte(' ')
                            break
                        i += 1
                    // Parse number
                    count = parse_int(rp + i, rlen - i)
                    // Skip past number and spaces to find file
                    while i < rlen
                        if rp[i] == byte(' ')
                            break
                        i += 1
                    while i < rlen
                        if rp[i] != byte(' ')
                            break
                        i += 1
                    rest = string(rp + i, rlen - i)
                else
                    // -N shorthand
                    count = parse_int(rp + 1, rlen - 1)
                    var i = 1
                    while i < rlen
                        if rp[i] == byte(' ')
                            break
                        i += 1
                    while i < rlen
                        if rp[i] != byte(' ')
                            break
                        i += 1
                    rest = string(rp + i, rlen - i)

        if count <= 0
            exit()
            return

        // Open file or stdin
        var fid = -1
        if len(rest) > 0
            fid = open(rest)
            if fid < 0
                puts(rest)
                puts(": not found\n")
                exit()
                return
        else
            fid = STDIN

        // Read and output lines until count reached
        var lines = 0
        var buf: [4096]byte
        var nr = read(fid, buf, HEAD_BUF)
        while nr > 0
            var i = 0
            while i < nr
                if lines >= count
                    break
                // Find end of line
                var eol = i
                while eol < nr
                    if buf[eol] == byte('\n')
                        break
                    eol += 1
                if eol < nr
                    // Found newline — output line including newline
                    write_handle(STDOUT, &buf[i], eol - i + 1)
                    lines += 1
                    i = eol + 1
                else
                    // Partial line at end of buffer — output what we have
                    write_handle(STDOUT, &buf[i], eol - i)
                    i = eol
            if lines >= count
                break
            nr = read(fid, buf, HEAD_BUF)

        if fid != STDIN
            close(fid)
        exit()
