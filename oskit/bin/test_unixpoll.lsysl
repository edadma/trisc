test_unixpoll — ppoll(2) on AF_UNIX socket fires on data arrival
=================================================================

Validates the new UNIX_CMD_POLL path. ppoll on an AF_UNIX
DGRAM socket should:

  - return 0 events when the queue is empty (timeout=0).
  - return 1 event with POLLIN set after a sendto puts data
    on the queue.
  - return 0 events again after recvfrom drains.

This is the readiness-query path. Edge-triggered subscription
(EPOLL_SUB) is a separate followup.

Pass criterion: prints `unixpoll: ok`.

    module oskit.bin.test_unixpoll

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_BIND       = 135
    val NR_CLOSE      = 147
    val NR_PPOLL      = 258
    val NR_RECVFROM   = 276
    val NR_SENDTO     = 307
    val NR_SOCKET     = 337

    val AF_UNIX_V     = 1
    val SOCK_DGRAM_V  = 2

    val POLLIN_V      = 0x001
    val POLLOUT_V     = 0x004


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixpoll: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, path_len: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < path_len
            out[2 + i] = path[i]
            i += 1
        out[2 + path_len] = byte(0)
        2 + path_len + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_sendto(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen: int) -> int
        int(syscall6(NR_SENDTO, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen)))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen_p: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_p)))

A `pollfd` is `i32 fd + i16 events + i16 revents` = 8 bytes.
A `timespec` is `i64 tv_sec + i64 tv_nsec` = 16 bytes.

    posix_ppoll(fds: *byte, nfds: int, ts: *byte) -> int
        int(syscall6(NR_PPOLL, i64(fds), i64(nfds), i64(ts), 0, 0, 0))


    write_pollfd(p: *byte, off: int, fd: int, events: int)
        p[off]     = byte(fd & 0xff)
        p[off + 1] = byte((fd >> 8) & 0xff)
        p[off + 2] = byte((fd >> 16) & 0xff)
        p[off + 3] = byte((fd >> 24) & 0xff)
        p[off + 4] = byte(events & 0xff)
        p[off + 5] = byte((events >> 8) & 0xff)
        p[off + 6] = 0
        p[off + 7] = 0


    read_revents(p: *byte, off: int) -> int
        (int(p[off + 6]) & 0xff) | ((int(p[off + 7]) & 0xff) << 8)


    main(argv: []string)

Step 1: open + bind two DGRAM sockets.

        val a = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if a < 0
            fail(1)
            return
        val b = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if b < 0
            fail(2)
            return

        var path_a: [3]byte
        path_a[0] = 'P'; path_a[1] = 'L'; path_a[2] = 'A'
        var path_b: [3]byte
        path_b[0] = 'P'; path_b[1] = 'L'; path_b[2] = 'B'

        var sa_a: [128]byte
        val al_a = fill_sockaddr_un(&sa_a[0], &path_a[0], 3)
        if posix_bind(a, &sa_a[0], al_a) != 0
            fail(3)
            return
        var sa_b: [128]byte
        val al_b = fill_sockaddr_un(&sa_b[0], &path_b[0], 3)
        if posix_bind(b, &sa_b[0], al_b) != 0
            fail(4)
            return

Step 2: ppoll(b, POLLIN, timeout=0). Empty queue → 0 events.

        var pfds: [8]byte
        write_pollfd(&pfds[0], 0, b, POLLIN_V)
        var ts: [16]byte
        var i = 0
        while i < 16
            ts[i] = byte(0)
            i += 1
        val r1 = posix_ppoll(&pfds[0], 1, &ts[0])
        if r1 != 0
            puts("unixpoll: r1=")
            print_idec(r1)
            puts("\n")
            fail(5)
            return

Step 3: sendto a→b. ppoll(b, POLLIN, timeout=0) → 1 event,
revents has POLLIN set.

        var msg: [4]byte
        msg[0] = 'p'; msg[1] = 'i'
        msg[2] = 'n'; msg[3] = 'g'
        if posix_sendto(a, &msg[0], 4, 0, &sa_b[0], al_b) != 4
            fail(6)
            return

        write_pollfd(&pfds[0], 0, b, POLLIN_V)
        val r2 = posix_ppoll(&pfds[0], 1, &ts[0])
        if r2 != 1
            puts("unixpoll: r2=")
            print_idec(r2)
            puts("\n")
            fail(7)
            return
        val ev2 = read_revents(&pfds[0], 0)
        if (ev2 & POLLIN_V) == 0
            puts("unixpoll: ev2=")
            print_idec(ev2)
            puts("\n")
            fail(8)
            return

Step 4: recvfrom drains. ppoll → 0 events again.

        var rb: [16]byte
        var src: [128]byte
        var sl: i32 = 128
        if posix_recvfrom(b, &rb[0], 16, 0, &src[0], &sl) != 4
            fail(9)
            return

        write_pollfd(&pfds[0], 0, b, POLLIN_V)
        val r3 = posix_ppoll(&pfds[0], 1, &ts[0])
        if r3 != 0
            puts("unixpoll: r3=")
            print_idec(r3)
            puts("\n")
            fail(10)
            return

Step 5: ppoll for POLLOUT — should always fire (slix doesn't
enforce send-side backpressure on the source-fd).

        write_pollfd(&pfds[0], 0, b, POLLOUT_V)
        val r4 = posix_ppoll(&pfds[0], 1, &ts[0])
        if r4 != 1
            puts("unixpoll: r4=")
            print_idec(r4)
            puts("\n")
            fail(11)
            return
        val ev4 = read_revents(&pfds[0], 0)
        if (ev4 & POLLOUT_V) == 0
            puts("unixpoll: ev4=")
            print_idec(ev4)
            puts("\n")
            fail(12)
            return

        posix_close(a)
        posix_close(b)
        puts("unixpoll: ok\n")
        exit()
