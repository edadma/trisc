test_sockinfo — SO_TYPE / SO_DOMAIN / SO_PROTOCOL / SO_ACCEPTCONN
==================================================================

Verifies the four read-only introspection getsockopts that the
shim now reports off the fd kind + is_listen flag:

- `SO_TYPE` (3)        — SOCK_STREAM (1) for TCP, SOCK_DGRAM (2) for UDP
- `SO_ACCEPTCONN` (30) — 1 iff sys_listen has been called on the fd
- `SO_PROTOCOL` (38)   — IPPROTO_TCP (6) or IPPROTO_UDP (17)
- `SO_DOMAIN` (39)     — always AF_INET (2)

Three fds exercised:
  1. UDP socket (no listen): TYPE=2, PROTO=17, DOMAIN=2, ACCEPTCONN=0
  2. TCP socket pre-listen:  TYPE=1, PROTO=6,  DOMAIN=2, ACCEPTCONN=0
  3. TCP socket post-listen: TYPE=1, PROTO=6,  DOMAIN=2, ACCEPTCONN=1

Output: `sockinfo: ok` / `sockinfo: bad <code>`.

    module oskit.bin.test_sockinfo

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_GETSOCKOPT = 204
    val NR_BIND       = 135
    val NR_LISTEN     = 217
    val NR_CLOSE      = 147
    val NR_SOCKET     = 337

    val AF_INET_V     = 2
    val SOCK_DGRAM_V  = 2
    val SOCK_STREAM_V = 1


    print_udec(v: int)
        if v >= 10
            print_udec(v / 10)
        var b: [1]byte
        b[0] = byte('0' + (v % 10))
        puts(string(&b[0], 1))


    fill_sockaddr(a: *byte, port: int, b0: int, b1: int, b2: int, b3: int)
        a[0] = byte(AF_INET_V & 0xff)
        a[1] = byte(0)
        a[2] = byte((port >> 8) & 0xff)
        a[3] = byte(port & 0xff)
        a[4] = byte(b0 & 0xff)
        a[5] = byte(b1 & 0xff)
        a[6] = byte(b2 & 0xff)
        a[7] = byte(b3 & 0xff)
        var i = 8
        while i < 16
            a[i] = byte(0)
            i += 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_listen(fd: int, backlog: int) -> int
        int(syscall6(NR_LISTEN, i64(fd), i64(backlog), 0, 0, 0, 0))

    posix_getsockopt(fd: int, level: int, optname: int,
                     optval: *byte, lenp: *i32) -> int
        int(syscall6(NR_GETSOCKOPT, i64(fd), i64(level), i64(optname),
            i64(optval), i64(lenp), 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))


    fail_with(code: int)
        puts("sockinfo: bad ")
        print_udec(code)
        puts("\n")
        exit_with(code)


Read one int-sized opt and compare its low byte. All values we
test (1, 2, 6, 17) fit in a byte so just inspecting `outv[0]` is
enough — and matches the existing `test_sockopt` pattern.
Returns 0 on match, negative on any mismatch.

    want_byte(fd: int, level: int, optname: int, want: int) -> int
        var outv: [4]byte
        outv[0] = byte(0xff)
        outv[1] = byte(0xff)
        outv[2] = byte(0xff)
        outv[3] = byte(0xff)
        var olen: i32 = i32(4)
        val rc = posix_getsockopt(fd, level, optname, &outv[0], &olen)
        if rc != 0
            return -1
        if int(olen) != 4
            return -2
        if (int(outv[0]) & 0xff) != want
            return -3
        0


    main(argv: []string)
        // 1. UDP fd
        val u = posix_socket(AF_INET_V, SOCK_DGRAM_V, 0)
        if u < 0
            fail_with(1)
            return
        if want_byte(u, 1, 3, 2) != 0           // SO_TYPE = SOCK_DGRAM
            fail_with(2)
            return
        if want_byte(u, 1, 38, 17) != 0         // SO_PROTOCOL = UDP
            fail_with(3)
            return
        if want_byte(u, 1, 39, 2) != 0          // SO_DOMAIN = AF_INET
            fail_with(4)
            return
        if want_byte(u, 1, 30, 0) != 0          // SO_ACCEPTCONN = 0
            fail_with(5)
            return

        // 2. TCP fd, pre-listen
        val t = posix_socket(AF_INET_V, SOCK_STREAM_V, 0)
        if t < 0
            fail_with(6)
            return
        if want_byte(t, 1, 3, 1) != 0           // SO_TYPE = SOCK_STREAM
            fail_with(7)
            return
        if want_byte(t, 1, 38, 6) != 0          // SO_PROTOCOL = TCP
            fail_with(8)
            return
        if want_byte(t, 1, 39, 2) != 0          // SO_DOMAIN = AF_INET
            fail_with(9)
            return
        if want_byte(t, 1, 30, 0) != 0          // pre-listen ACCEPTCONN = 0
            fail_with(10)
            return

        // 3. TCP fd, post-listen
        var addr: [16]byte
        fill_sockaddr(&addr[0], 9101, 0, 0, 0, 0)
        if posix_bind(t, &addr[0], 16) != 0
            fail_with(11)
            return
        if posix_listen(t, 4) != 0
            fail_with(12)
            return
        if want_byte(t, 1, 30, 1) != 0          // post-listen ACCEPTCONN = 1
            fail_with(13)
            return
        // Other introspection bits are unaffected by listen state.
        if want_byte(t, 1, 3, 1) != 0
            fail_with(14)
            return
        if want_byte(t, 1, 38, 6) != 0
            fail_with(15)
            return

        posix_close(t)
        posix_close(u)
        puts("sockinfo: ok\n")
        exit()
