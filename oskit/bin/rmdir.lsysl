rmdir — remove an empty directory
=================================

Removes an empty directory at the given path.

    module oskit.bin.rmdir

    import oskit.ulib.{puts, exit, get_args, skip_arg0, rmdir}

    main()
        val path = skip_arg0(get_args())
        if len(path) == 0
            puts("usage: rmdir <path>\n")
            exit()
            return
        val result = rmdir(path)
        if result != 0
            puts("error\n")
        exit()
