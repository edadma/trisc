mv — move or rename a file
=========================

Renames or moves a file from one path to another.

    module oskit.bin.mv

    import oskit.ulib.{puts, exit, get_args, skip_arg0, rename}

    main()
        val raw = skip_arg0(get_args())
        // Split into src and dst at first space
        val p = *byte(raw)
        val n = len(raw)
        var sp = 0
        while sp < n
            if p[sp] == byte(' ')
                break
            sp += 1
        if sp == 0
            puts("usage: mv <src> <dst>\n")
            exit()
            return
        if sp >= n
            puts("usage: mv <src> <dst>\n")
            exit()
            return
        val src = string(p, sp)
        // Skip spaces
        var ds = sp
        while ds < n
            if p[ds] != byte(' ')
                break
            ds += 1
        if ds >= n
            puts("usage: mv <src> <dst>\n")
            exit()
            return
        val dst = string(p + ds, n - ds)
        val result = rename(src, dst)
        if result != 0
            puts("error\n")
        exit()
