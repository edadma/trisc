test_unixsmrf — recvfrom-drains-sendmsg-entry releases fd queue-refs
=====================================================================

Validates the Part-1 fix to the sendmsg / recvfrom interaction:
when `recvfrom(2)` drains a queue entry that was put there by
`sendmsg(... SCM_RIGHTS ...)`, the cmsg fds are dropped (recvfrom
doesn't carry ancillary) **and** their `nrefs_in_queues`
counters are decremented. Before the fix the counters leaked,
preventing the underlying slot from ever being orphan-freed.

Test plan
---------

  1. alpha→"SMA", beta→"SMB", gamma→"SMG" — three bound DGRAM
     sockets in one process.
  2. `sendmsg(alpha → "SMB", payload + cmsg=[gamma])` — queues
     gamma's slot index for transfer; bumps gamma's
     `nrefs_in_queues`.
  3. `recvfrom(beta)` — drains data + path. Cmsg is silently
     dropped. Without the fix, gamma's `nrefs_in_queues`
     stays incremented forever.
  4. `close(gamma)` — drops the original owner. With the fix,
     gamma's owners=0 + nrefs_in_queues=0, so
     `unix_full_close` runs and clears `bound_path "SMG"`.
  5. Open a fresh socket and `bind` it to "SMG". Should
     succeed iff gamma's slot was correctly cleaned up.

Pass criterion: prints `unixsmrf: ok`.

    module oskit.bin.test_unixsmrf

    import oskit.ulib.{puts, exit, exit_with, syscall6}


    val NR_BIND       = 135
    val NR_CLOSE      = 147
    val NR_RECVFROM   = 276
    val NR_SENDMSG    = 306
    val NR_SOCKET     = 337

    val AF_UNIX_V     = 1
    val SOCK_DGRAM_V  = 2

    val SOL_SOCKET_V  = 1
    val SCM_RIGHTS_V  = 1


    print_idec(v: int)
        var n = v
        if n < 0
            puts("-")
            n = -n
        if n >= 10
            print_idec(n / 10)
        var b: [1]byte
        b[0] = byte('0' + (n % 10))
        puts(string(&b[0], 1))


    fail(code: int)
        puts("unixsmrf: bad ")
        print_idec(code)
        puts("\n")
        exit_with(code)


    fill_sockaddr_un(out: *byte, path: *byte, path_len: int) -> int
        out[0] = byte(AF_UNIX_V & 0xff)
        out[1] = byte(0)
        var i = 0
        while i < path_len
            out[2 + i] = path[i]
            i += 1
        out[2 + path_len] = byte(0)
        2 + path_len + 1


    posix_socket(family: int, stype: int, proto: int) -> int
        int(syscall6(NR_SOCKET, i64(family), i64(stype), i64(proto), 0, 0, 0))

    posix_bind(fd: int, addr: *byte, addrlen: int) -> int
        int(syscall6(NR_BIND, i64(fd), i64(addr), i64(addrlen), 0, 0, 0))

    posix_close(fd: int) -> int
        int(syscall6(NR_CLOSE, i64(fd), 0, 0, 0, 0, 0))

    posix_sendmsg(fd: int, mh: *byte, flags: int) -> int
        int(syscall6(NR_SENDMSG, i64(fd), i64(mh), i64(flags), 0, 0, 0))

    posix_recvfrom(fd: int, buf: *byte, blen: int, flags: int,
            addr: *byte, addrlen_p: *i32) -> int
        int(syscall6(NR_RECVFROM, i64(fd), i64(buf), i64(blen),
            i64(flags), i64(addr), i64(addrlen_p)))


    write_i64(p: *byte, off: int, v: i64)
        var i = 0
        while i < 8
            p[off + i] = byte((v >> (i * 8)) & i64(0xff))
            i += 1


    write_i32(p: *byte, off: int, v: int)
        p[off]     = byte(v & 0xff)
        p[off + 1] = byte((v >> 8) & 0xff)
        p[off + 2] = byte((v >> 16) & 0xff)
        p[off + 3] = byte((v >> 24) & 0xff)


    main(argv: []string)

Step 1: bind alpha, beta, gamma.

        val alpha = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if alpha < 0
            fail(1)
            return
        val beta = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if beta < 0
            fail(2)
            return
        val gamma = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if gamma < 0
            fail(3)
            return

        var path_a: [3]byte
        path_a[0] = 'S'; path_a[1] = 'M'; path_a[2] = 'A'
        var path_b: [3]byte
        path_b[0] = 'S'; path_b[1] = 'M'; path_b[2] = 'B'
        var path_g: [3]byte
        path_g[0] = 'S'; path_g[1] = 'M'; path_g[2] = 'G'

        var sa_a: [128]byte
        val al_a = fill_sockaddr_un(&sa_a[0], &path_a[0], 3)
        if posix_bind(alpha, &sa_a[0], al_a) != 0
            fail(4)
            return
        var sa_b: [128]byte
        val al_b = fill_sockaddr_un(&sa_b[0], &path_b[0], 3)
        if posix_bind(beta, &sa_b[0], al_b) != 0
            fail(5)
            return
        var sa_g: [128]byte
        val al_g = fill_sockaddr_un(&sa_g[0], &path_g[0], 3)
        if posix_bind(gamma, &sa_g[0], al_g) != 0
            fail(6)
            return

Step 2: sendmsg(alpha → "SMB", payload + cmsg=[gamma]).

        var ctrl_send: [32]byte
        write_i64(&ctrl_send[0], 0, i64(20))
        write_i32(&ctrl_send[0], 8, SOL_SOCKET_V)
        write_i32(&ctrl_send[0], 12, SCM_RIGHTS_V)
        write_i32(&ctrl_send[0], 16, gamma)

        var payload: [4]byte
        payload[0] = 'h'; payload[1] = 'i'
        payload[2] = '!'; payload[3] = byte(0)

        var iov: [16]byte
        write_i64(&iov[0], 0, i64(&payload[0]))
        write_i64(&iov[0], 8, i64(4))

        var mh: [56]byte
        write_i64(&mh[0], 0, i64(&sa_b[0]))
        write_i32(&mh[0], 8, al_b)
        write_i32(&mh[0], 12, 0)
        write_i64(&mh[0], 16, i64(&iov[0]))
        write_i32(&mh[0], 24, 1)
        write_i32(&mh[0], 28, 0)
        write_i64(&mh[0], 32, i64(&ctrl_send[0]))
        write_i32(&mh[0], 40, 20)
        write_i32(&mh[0], 44, 0)
        write_i32(&mh[0], 48, 0)

        val ns = posix_sendmsg(alpha, &mh[0], 0)
        if ns != 4
            puts("unixsmrf: sendmsg=")
            print_idec(ns)
            puts("\n")
            fail(7)
            return

Step 3: recvfrom(beta) drains the entry. Cmsg fds are dropped
silently — but their queue-refs must be released by the
server.

        var rb: [16]byte
        var src_addr: [128]byte
        var src_alen: i32 = 128
        val nr = posix_recvfrom(beta, &rb[0], 16, 0,
            &src_addr[0], &src_alen)
        if nr != 4
            puts("unixsmrf: recvfrom=")
            print_idec(nr)
            puts("\n")
            fail(8)
            return
        if rb[0] != 'h' || rb[1] != 'i' || rb[2] != '!'
            fail(9)
            return

Step 4: close gamma. With the fix, gamma's owners=0 +
nrefs_in_queues=0 → unix_full_close → "SMG" cleared.

        posix_close(gamma)

Step 5: re-bind "SMG" on a fresh socket. Should succeed.

        val probe = posix_socket(AF_UNIX_V, SOCK_DGRAM_V, 0)
        if probe < 0
            fail(10)
            return
        val br = posix_bind(probe, &sa_g[0], al_g)
        if br != 0
            puts("unixsmrf: rebind=")
            print_idec(br)
            puts("\n")
            fail(11)
            return

        posix_close(probe)
        posix_close(alpha)
        posix_close(beta)
        puts("unixsmrf: ok\n")
        exit()
