TOF Loader — Load executable TOF files into memory
===================================================

Loads executables from either the TRB v1 binary format (magic `TRB` + 0x01) or the TOF text
format. This is the OS-side equivalent of the emulator's `TOF.load()` / `TriscBinary` on the JVM.

TOF text format (executable, fully linked):
```
TOF v1
TYPE:executable
ENTRY:main
SEGMENT:code,d0000
DATA:hexhexhex...
RES:100
SEGMENT:data,d1000
DATA:hexhexhex...
```

The loader reads the file, parses each line, and copies
decoded data to the addresses specified by each segment.
RES lines advance the address without writing (BSS).
The entry point is resolved from the ENTRY name by
matching it against SYMBOL declarations.

Zero-allocation design: all parsing works directly on the
raw buffer using pointer arithmetic and byte comparisons.
No string temporaries are created, so there is no heap
pressure regardless of file size.

    module oskit.loader

    import oskit.fs.{fs_open, fs_read, fs_close}
    import std.alloc.{malloc, free}
    import oskit.hal.{memcpy, memset}
    import oskit.services.svc_vm_copy_to

Error codes returned when loading fails.

    val LOAD_ERR_NOT_FOUND = -1
    val LOAD_ERR_READ      = -2
    val LOAD_ERR_FORMAT    = -3
    val LOAD_ERR_NO_ENTRY  = -4

Hex nibble value: '0'-'9' → 0-9, 'a'-'f'/'A'-'F' → 10-15.
Returns -1 on invalid character.

    hex_val(ch: int) -> int
        if ch >= '0'
            if ch <= '9'
                return ch - '0'
        if ch >= 'a'
            if ch <= 'f'
                return ch - 'a' + 10
        if ch >= 'A'
            if ch <= 'F'
                return ch - 'A' + 10
        -1

Decode hex bytes from a raw buffer region and write to a
memory address. Returns the number of bytes written,
or -1 on error. Works directly with buffer pointers —
no string allocation.

    hex_decode_buf(src: *byte, hex_len: int, dst: *byte) -> int
        if hex_len % 2 != 0
            return -1
        val pairs = hex_len / 2
        for var i = 0; i < pairs; i++
            val hi = hex_val(src[i * 2])
            val lo = hex_val(src[i * 2 + 1])
            if hi < 0
                return -1
            if lo < 0
                return -1
            dst[i] = byte(hi * 16 + lo)
        pairs

Parse a hex number from a raw buffer region. Returns -1
on error. Works directly with buffer pointers.

    parse_hex_buf(src: *byte, n: int) -> i64
        if n == 0
            return -1
        var result: i64 = 0
        for var i = 0; i < n; i++
            val v = hex_val(src[i])
            if v < 0
                return -1
            result = result * 16 + i64(v)
        result

Check if buffer region starts with a given prefix.

    buf_has_prefix(p: *byte, plen: int, prefix: *byte, prefix_len: int) -> bool
        if plen < prefix_len
            return false
        for var i = 0; i < prefix_len; i++
            if p[i] != prefix[i]
                return false
        true

Find a byte in a buffer region. Returns offset or -1.

    buf_index_byte(p: *byte, n: int, ch: byte) -> int
        for var i = 0; i < n; i++
            if p[i] == ch
                return i
        -1

Compare two buffer regions for equality.

    buf_equal(a: *byte, alen: int, b: *byte, blen: int) -> bool
        if alen != blen
            return false
        for var i = 0; i < alen; i++
            if a[i] != b[i]
                return false
        true

Parse a TOF file from a buffer and load it into memory.
Returns the entry point address, or a negative error code.

The buffer contains the entire TOF file as text. We parse
it line by line, tracking the current segment base address
and a write cursor within each segment.

Zero-allocation for the text parser: comparisons and hex decoding work
directly on `buf` pointers. TRB PROGBITS copies and TOF `RES` / TRB NOBITS
zero-fill use `std.mem.memcpy` / `memset` (DMA-backed, one-shot in the emulator).

Little-endian u32 at `p` (unsigned, returned as i64).

    read_u32_le(p: *byte) -> i64
        i64(p[0] & 0xff) | (i64(p[1] & 0xff) << 8) | (i64(p[2] & 0xff) << 16) | (i64(p[3] & 0xff) << 24)

TRB v1 binary image: magic `TRB` + 0x01, u32 entry, u32 record count, then records
(u32 org, u32 kind, u32 size [, size bytes if kind==0]). kind 0 = PROGBITS, 1 = NOBITS (zero-fill).

    load_trb1_from_buf(buf: *byte, buflen: int) -> i64
        if buflen < 12
            return LOAD_ERR_FORMAT
        val entry = read_u32_le(buf + 4)
        val nrec = int(read_u32_le(buf + 8))
        var pos = 12
        var ri = 0
        while ri < nrec
            if pos + 12 > buflen
                return LOAD_ERR_FORMAT
            val hp = buf + pos
            val org = read_u32_le(hp)
            val kind = int(read_u32_le(hp + 4))
            val sz = int(read_u32_le(hp + 8))
            pos += 12
            if kind == 0
                if pos + sz > buflen
                    return LOAD_ERR_FORMAT
                memcpy(*byte(org), buf + pos, sz)
                pos += sz
            else if kind == 1
                memset(*byte(org), byte(0), sz)
            else
                return LOAD_ERR_FORMAT
            ri += 1
        if pos != buflen
            return LOAD_ERR_FORMAT
        entry

    load_tof_from_buf(buf: *byte, buflen: int) -> i64
        if buflen >= 4
            if buf[0] == byte('T')
                if buf[1] == byte('R')
                    if buf[2] == byte('B')
                        if buf[3] != byte(1)
                            return LOAD_ERR_FORMAT
                        return load_trb1_from_buf(buf, buflen)
        var pos = 0
        var seg_base: i64 = 0
        var seg_cursor: i64 = 0
        var entry_name_start = -1
        var entry_name_len = 0
        var entry_addr: i64 = -1
        var header_seen = false

        while pos < buflen
            // Find end of current line
            var eol = pos
            while eol < buflen
                if buf[eol] == '\n'
                    break
                eol += 1

            // Find first non-whitespace character
            var first = pos
            while first < eol
                if buf[first] != ' '
                    if buf[first] != '\t'
                        break
                first += 1

            val line_start = first
            val line_len = eol - first

            // Find last non-whitespace for trimmed end
            var last = eol - 1
            while last >= first
                if buf[last] != ' '
                    if buf[last] != '\t'
                        break
                last -= 1
            val trimmed_len = last - first + 1

            if trimmed_len > 0
                val p = buf + first

                // Skip comments
                if p[0] == '#'
                    pos = eol + 1
                    continue

                if !header_seen
                    // Check for "TOF v"
                    var tof_v: [5]byte
                    tof_v[0] = byte('T')
                    tof_v[1] = byte('O')
                    tof_v[2] = byte('F')
                    tof_v[3] = byte(' ')
                    tof_v[4] = byte('v')
                    if !buf_has_prefix(p, trimmed_len, tof_v, 5)
                        return LOAD_ERR_FORMAT
                    header_seen = true
                else if trimmed_len >= 8
                    // Check "SEGMENT:"
                    var seg_pfx: [8]byte
                    seg_pfx[0] = byte('S')
                    seg_pfx[1] = byte('E')
                    seg_pfx[2] = byte('G')
                    seg_pfx[3] = byte('M')
                    seg_pfx[4] = byte('E')
                    seg_pfx[5] = byte('N')
                    seg_pfx[6] = byte('T')
                    seg_pfx[7] = byte(':')
                    if buf_has_prefix(p, trimmed_len, seg_pfx, 8)
                        // Find comma after segment name
                        val rest = p + 8
                        val rest_len = trimmed_len - 8
                        val comma = buf_index_byte(rest, rest_len, byte(','))
                        if comma < 0
                            return LOAD_ERR_FORMAT
                        seg_base = parse_hex_buf(rest + comma + 1, rest_len - comma - 1)
                        if seg_base < 0
                            return LOAD_ERR_FORMAT
                        seg_cursor = seg_base
                        pos = eol + 1
                        continue

                if trimmed_len >= 5
                    // Check "DATA:"
                    var data_pfx: [5]byte
                    data_pfx[0] = byte('D')
                    data_pfx[1] = byte('A')
                    data_pfx[2] = byte('T')
                    data_pfx[3] = byte('A')
                    data_pfx[4] = byte(':')
                    if header_seen
                        if buf_has_prefix(p, trimmed_len, data_pfx, 5)
                            val hex_start = p + 5
                            val hex_len = trimmed_len - 5
                            val n = hex_decode_buf(hex_start, hex_len, *byte(seg_cursor))
                            if n < 0
                                return LOAD_ERR_FORMAT
                            seg_cursor = seg_cursor + i64(n)
                            pos = eol + 1
                            continue

                if trimmed_len >= 4
                    // Check "RES:"
                    if header_seen
                        if p[0] == 'R'
                            if p[1] == 'E'
                                if p[2] == 'S'
                                    if p[3] == ':'
                                        val sz64 = parse_hex_buf(p + 4, trimmed_len - 4)
                                        if sz64 < 0
                                            return LOAD_ERR_FORMAT
                                        val sz = int(sz64)
                                        val dest = *byte(seg_cursor)
                                        memset(dest, byte(0), sz)
                                        seg_cursor = seg_cursor + i64(sz)
                                        pos = eol + 1
                                        continue

                if trimmed_len >= 6
                    // Check "ENTRY:"
                    if header_seen
                        if p[0] == 'E'
                            if p[1] == 'N'
                                if p[2] == 'T'
                                    if p[3] == 'R'
                                        if p[4] == 'Y'
                                            if p[5] == ':'
                                                val name_start = first + 6
                                                val name_len = trimmed_len - 6
                                                // Copy entry name past buffer end
                                                for var i = 0; i < name_len; i++
                                                    buf[buflen + i] = p[6 + i]
                                                entry_name_start = buflen
                                                entry_name_len = name_len
                                                pos = eol + 1
                                                continue

                if trimmed_len >= 7
                    // Check "SYMBOL:"
                    if header_seen
                        if p[0] == 'S'
                            if p[1] == 'Y'
                                if p[2] == 'M'
                                    if p[3] == 'B'
                                        if p[4] == 'O'
                                            if p[5] == 'L'
                                                if p[6] == ':'
                                                    val rest = p + 7
                                                    val rest_len = trimmed_len - 7
                                                    val comma1 = buf_index_byte(rest, rest_len, byte(','))
                                                    if comma1 >= 0
                                                        if entry_name_start >= 0
                                                            // Compare symbol name with entry name
                                                            if buf_equal(rest, comma1, buf + entry_name_start, entry_name_len)
                                                                // Parse offset after first comma
                                                                val after1 = rest + comma1 + 1
                                                                val after1_len = rest_len - comma1 - 1
                                                                val comma2 = buf_index_byte(after1, after1_len, byte(','))
                                                                if comma2 >= 0
                                                                    val off = parse_hex_buf(after1, comma2)
                                                                    if off >= 0
                                                                        entry_addr = seg_base + off

            pos = eol + 1

        if entry_addr < 0
            return LOAD_ERR_NO_ENTRY
        entry_addr

Load a TOF file from the filesystem. Returns the entry
point address, or a negative error code.

With grant-based I/O, `fs_read` writes directly to our
buffer — no size limit per call. We still loop because
`tfs_read` is limited by file size, not IPC buffer size.

    val LOAD_BUF_SIZE = 262144

    load_tof(path: string) -> i64
        val fid = fs_open(path)
        if fid < 0
            return LOAD_ERR_NOT_FOUND

        val buf = malloc(LOAD_BUF_SIZE)
        if i64(buf) <= 0
            fs_close(fid)
            return LOAD_ERR_READ

        // Read entire file — position advances automatically
        var total = 0
        var nr = fs_read(fid, buf, LOAD_BUF_SIZE)
        while nr > 0
            total += nr
            if total >= LOAD_BUF_SIZE
                break
            nr = fs_read(fid, buf + total, LOAD_BUF_SIZE - total)
        fs_close(fid)

        if total <= 0
            free(buf)
            return LOAD_ERR_READ

        val result = load_tof_from_buf(buf, total)
        free(buf)
        result

Cross-address-space TRB loader. Like `load_trb1_from_buf` but
uses `svc_vm_copy_to` to write PROGBITS/NOBITS into the target
address space identified by `dst_ptbr`. Used by isolated PM to
load binaries without switching its own PTBR.

    load_trb1_to_ptbr(buf: *byte, buflen: int, dst_ptbr: u64) -> i64
        if buflen < 12
            return LOAD_ERR_FORMAT
        val entry = read_u32_le(buf + 4)
        val nrec = int(read_u32_le(buf + 8))
        var pos = 12
        var ri = 0
        while ri < nrec
            if pos + 12 > buflen
                return LOAD_ERR_FORMAT
            val hp = buf + pos
            val org = u64(read_u32_le(hp))
            val kind = int(read_u32_le(hp + 4))
            val sz = int(read_u32_le(hp + 8))
            pos += 12
            if kind == 0
                if pos + sz > buflen
                    return LOAD_ERR_FORMAT
                svc_vm_copy_to(dst_ptbr, org, buf + pos, sz)
                pos += sz
            else if kind == 1
                // Zero-fill: use a local buffer for small chunks
                var zeros: [4096]byte
                var done = 0
                while done < sz
                    var chunk = sz - done
                    if chunk > 4096
                        chunk = 4096
                    svc_vm_copy_to(dst_ptbr, org + u64(done), zeros, chunk)
                    done += chunk
            else
                return LOAD_ERR_FORMAT
            ri += 1
        if pos != buflen
            return LOAD_ERR_FORMAT
        entry

ELF64 cross-address-space loader. Parses ELF program headers
and copies PT_LOAD segments into the target address space.

    val ELF_PT_LOAD = 1

    read_u16_le(p: *byte) -> int
        (int(p[0]) & 0xFF) | ((int(p[1]) & 0xFF) << 8)

    read_u64_le(p: *byte) -> i64
        i64(p[0] & 0xFF) | (i64(p[1] & 0xFF) << 8) | (i64(p[2] & 0xFF) << 16) | (i64(p[3] & 0xFF) << 24) | (i64(p[4] & 0xFF) << 32) | (i64(p[5] & 0xFF) << 40) | (i64(p[6] & 0xFF) << 48) | (i64(p[7] & 0xFF) << 56)

    load_elf64_to_ptbr(buf: *byte, buflen: int, dst_ptbr: i64) -> i64
        // Minimum ELF64 header is 64 bytes
        if buflen < 64
            return LOAD_ERR_FORMAT
        // Verify ELF magic, class (64-bit), endian (little)
        if buf[0] != 0x7F
            return LOAD_ERR_FORMAT
        if buf[1] != byte('E')
            return LOAD_ERR_FORMAT
        if buf[2] != byte('L')
            return LOAD_ERR_FORMAT
        if buf[3] != byte('F')
            return LOAD_ERR_FORMAT
        if buf[4] != 2   // ELFCLASS64
            return LOAD_ERR_FORMAT
        if buf[5] != 1   // ELFDATA2LSB (little-endian)
            return LOAD_ERR_FORMAT

        val entry = read_u64_le(buf + 24)
        val phoff = int(read_u64_le(buf + 32))
        val phentsize = read_u16_le(buf + 54)
        val phnum = read_u16_le(buf + 56)

        if phoff + phnum * phentsize > buflen
            return LOAD_ERR_FORMAT

        // Process PT_LOAD segments
        var i = 0
        while i < phnum
            val ph = buf + phoff + i * phentsize
            val p_type = int(read_u32_le(ph))
            if p_type == ELF_PT_LOAD
                val p_offset = int(read_u64_le(ph + 8))
                val p_vaddr = u64(read_u64_le(ph + 16))
                val p_filesz = int(read_u64_le(ph + 32))
                val p_memsz = int(read_u64_le(ph + 40))
                // Copy file data (PROGBITS)
                if p_filesz > 0
                    if p_offset + p_filesz > buflen
                        return LOAD_ERR_FORMAT
                    svc_vm_copy_to(dst_ptbr, p_vaddr, buf + p_offset, p_filesz)
                // Zero-fill BSS (memsz > filesz)
                if p_memsz > p_filesz
                    var zeros: [4096]byte
                    var done = p_filesz
                    while done < p_memsz
                        var chunk = p_memsz - done
                        if chunk > 4096
                            chunk = 4096
                        svc_vm_copy_to(dst_ptbr, p_vaddr + u64(done), zeros, chunk)
                        done += chunk
            i += 1

        if entry <= 0
            return LOAD_ERR_NO_ENTRY
        entry

Load a binary file into a different address space. Reads the
file via VFS, detects format from magic bytes (ELF or TRB),
and copies segments into the target address space.

    val LOAD_CROSS_BUF_SIZE = 262144

    load_tof_to_ptbr(path: string, dst_ptbr: i64) -> i64
        val fid = fs_open(path)
        if fid < 0
            return LOAD_ERR_NOT_FOUND

        val buf = malloc(LOAD_CROSS_BUF_SIZE)
        if i64(buf) <= 0
            fs_close(fid)
            return LOAD_ERR_READ

        var total = 0
        var nr = fs_read(fid, buf, LOAD_CROSS_BUF_SIZE)
        while nr > 0
            total += nr
            if total >= LOAD_CROSS_BUF_SIZE
                break
            nr = fs_read(fid, buf + total, LOAD_CROSS_BUF_SIZE - total)
        fs_close(fid)

        if total <= 0
            free(buf)
            return LOAD_ERR_READ

        if total < 4
            free(buf)
            return LOAD_ERR_FORMAT

        var result: i64 = LOAD_ERR_FORMAT

        // Detect format from magic bytes
        if buf[0] == 0x7F
            if buf[1] == byte('E')
                if buf[2] == byte('L')
                    if buf[3] == byte('F')
                        result = load_elf64_to_ptbr(buf, total, dst_ptbr)
        if result == LOAD_ERR_FORMAT
            if buf[0] == byte('T')
                if buf[1] == byte('R')
                    if buf[2] == byte('B')
                        if buf[3] == byte(1)
                            result = load_trb1_to_ptbr(buf, total, dst_ptbr)

        free(buf)
        result
