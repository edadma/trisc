x86_64 Ramdisk Driver — Multiboot Module Disk
===============================================

Serves the same IPC protocol as the TRISC disk driver, but reads
from a multiboot module loaded by QEMU instead of MMIO hardware.

The module start/end addresses are set by boot.s from the multiboot
info structure. Sector size is 4096 bytes (matches TFS).

    module oskit.drivers.disk

    import oskit.ipc.{port_create, port_register, port_lookup, ipc_recv, ipc_reply, ipc_send, ipc_last_msg_len}
    import oskit.services.{rs_ready, svc_get_thread_ptbr, svc_vm_copy_to, svc_vm_copy_from, thread_id}
    import oskit.hal.memcpy

    val DISK_CMD_READ     = 1
    val DISK_CMD_WRITE    = 2
    val DISK_CMD_CAPACITY = 3

    val SECTOR_SIZE = 4096

    var disk_port = -1
    var disk_base = 0
    var disk_size = 0

Set ramdisk base address and size. Called before disk_server()
by the wrapper (kernel thread or isolated process).

    disk_set_ramdisk(base: int, size: int)
        disk_base = base
        disk_size = size

Parse a 4-byte big-endian integer from a message buffer.

    disk_read_i32(buf: *byte, off: int) -> int
        ((buf[off] & 0xFF) << 24) | ((buf[off + 1] & 0xFF) << 16) | ((buf[off + 2] & 0xFF) << 8) | (buf[off + 3] & 0xFF)

Write a 4-byte big-endian integer into a message buffer.

    disk_write_i32(buf: *byte, off: int, v: int)
        buf[off] = (v >> 24) & 0xFF
        buf[off + 1] = (v >> 16) & 0xFF
        buf[off + 2] = (v >> 8) & 0xFF
        buf[off + 3] = v & 0xFF

Handle a READ request: copy one sector from module memory
to the caller's buffer (possibly cross-address-space).

    disk_handle_read(sender: int, buf: *byte)
        val lba = disk_read_i32(buf, 1)
        val addr = disk_read_i32(buf, 5)
        val offset = lba * SECTOR_SIZE
        if offset + SECTOR_SIZE > disk_size
            var reply: [1]byte
            reply[0] = -1
            ipc_reply(sender, &reply[0], 1)
            return
        var src: *byte = *byte(disk_base + offset)
        val sender_ptbr = svc_get_thread_ptbr(sender)
        val my_ptbr = svc_get_thread_ptbr(thread_id())
        if sender_ptbr == my_ptbr
            memcpy(*byte(addr), src, SECTOR_SIZE)
        else
            svc_vm_copy_to(sender_ptbr, addr, src, SECTOR_SIZE)
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, &reply[0], 1)

Handle a WRITE request: copy from caller's buffer into module
memory. This modifies the in-memory ramdisk (not persistent).

    disk_handle_write(sender: int, buf: *byte)
        val lba = disk_read_i32(buf, 1)
        val addr = disk_read_i32(buf, 5)
        val offset = lba * SECTOR_SIZE
        if offset + SECTOR_SIZE > disk_size
            var reply: [1]byte
            reply[0] = -1
            ipc_reply(sender, &reply[0], 1)
            return
        var dst: *byte = *byte(disk_base + offset)
        val sender_ptbr = svc_get_thread_ptbr(sender)
        val my_ptbr = svc_get_thread_ptbr(thread_id())
        if sender_ptbr == my_ptbr
            memcpy(dst, *byte(addr), SECTOR_SIZE)
        else
            svc_vm_copy_from(sender_ptbr, addr, dst, SECTOR_SIZE)
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, &reply[0], 1)

Handle a CAPACITY request: return total sector count.

    disk_handle_capacity(sender: int)
        val cap = disk_size / SECTOR_SIZE
        var reply: [5]byte
        reply[0] = 0
        disk_write_i32(&reply[0], 1, cap)
        ipc_reply(sender, &reply[0], 5)

The disk server loop. Reads module addresses from boot globals,
creates port, then loops handling block I/O requests.

    disk_server()
        // disk_base and disk_size must be set via disk_set_ramdisk()
        // before calling this function.

        // Create and register port
        disk_port = port_create()
        port_register(disk_port, "disk")

        // Signal RS that disk is ready
        rs_ready()

        // Server loop
        var buf: [16]byte
        while 1 == 1
            val sender = ipc_recv(disk_port, &buf[0], 16)
            if sender >= 0
                val cmd = int(buf[0])
                if cmd == DISK_CMD_READ
                    disk_handle_read(sender, &buf[0])
                else if cmd == DISK_CMD_WRITE
                    disk_handle_write(sender, &buf[0])
                else if cmd == DISK_CMD_CAPACITY
                    disk_handle_capacity(sender)
                else
                    var reply: [1]byte
                    reply[0] = -1
                    ipc_reply(sender, &reply[0], 1)

Userspace wrappers. Clients use these to talk to the disk server
via IPC. Same API as the TRISC disk driver.

    disk_lookup_port() -> int
        port_lookup("disk")

    disk_read(lba: int, addr: *byte) -> int
        val port = disk_lookup_port()
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = DISK_CMD_READ
        disk_write_i32(&msg[0], 1, lba)
        disk_write_i32(&msg[0], 5, int(i64(addr)))
        var reply: [1]byte
        ipc_send(port, &msg[0], 9, &reply[0], 1)
        int(reply[0])

    disk_write(lba: int, addr: *byte) -> int
        val port = disk_lookup_port()
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = DISK_CMD_WRITE
        disk_write_i32(&msg[0], 1, lba)
        disk_write_i32(&msg[0], 5, int(i64(addr)))
        var reply: [1]byte
        ipc_send(port, &msg[0], 9, &reply[0], 1)
        int(reply[0])

    disk_capacity() -> int
        val port = disk_lookup_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = DISK_CMD_CAPACITY
        var reply: [5]byte
        ipc_send(port, &msg[0], 1, &reply[0], 5)
        if reply[0] != 0
            return -1
        disk_read_i32(&reply[0], 1)
