OSKit Disk Driver — Block Device Server

MINIX 3-style block device server. Owns the ramdisk hardware
and serves read/write requests via IPC. Clients (e.g. the TFS
server) send messages with an LBA and buffer address; the disk
server performs the actual hardware I/O and replies.

This keeps all hardware access in one server — clients never
touch device registers directly.

Message format (byte layout):
- Request:  [cmd(1), lba(4, big-endian), addr(4, big-endian)]
- Reply:    [status(1)]  — 0 = ok, -1 = error

Commands: DISK_CMD_READ=1, DISK_CMD_WRITE=2, DISK_CMD_CAPACITY=3

For DISK_CMD_CAPACITY, the reply is [status(1), capacity(4, big-endian)]
where capacity is the number of hardware sectors (bytes per sector match
the ramdisk format — e.g. 4096 in the demo image).

    module oskit.drivers.disk

    import oskit.ipc.*

    val DISK_CMD_READ     = 1
    val DISK_CMD_WRITE    = 2
    val DISK_CMD_CAPACITY = 3

Ramdisk hardware register layout (aligned — word regs first).
The struct maps 1:1 to the MMIO register block. COMMAND is
last so that writing fields top-to-bottom naturally triggers
the operation after all parameters are set.

    struct RamdiskRegs
        lba:      u32     // +0:  logical block address
        addr:     u32     // +4:  memory address for DMA
        capacity: u32     // +8:  total sectors (read-only)
        count:    u16     // +12: sector count
        status:   byte    // +14: bit0=ready, bit1=error
        command:  byte    // +15: 1=read, 2=write (triggers op)

    val RD_BASE = 0x800140
    val RD_CMD_READ  = 1
    val RD_CMD_WRITE = 2

    var disk_port = -1
    var disk_name: [5]byte

Perform a raw block read from the ramdisk hardware.
Reads one sector (`count` = 1) at the given LBA into addr.

    disk_hw_read(lba: int, addr: i64)
        var rd: *RamdiskRegs = *RamdiskRegs(RD_BASE)
        rd.lba = lba
        rd.addr = addr
        rd.count = 1
        rd.command = RD_CMD_READ

Perform a raw block write to the ramdisk hardware.
Writes one sector from addr to the given LBA.

    disk_hw_write(lba: int, addr: i64)
        var rd: *RamdiskRegs = *RamdiskRegs(RD_BASE)
        rd.lba = lba
        rd.addr = addr
        rd.count = 1
        rd.command = RD_CMD_WRITE

Read the disk capacity (number of sectors) from hardware.

    disk_hw_capacity() -> int
        var rd: *RamdiskRegs = *RamdiskRegs(RD_BASE)
        int(rd.capacity)

Parse a 4-byte big-endian integer from a message buffer.

    disk_read_i32(buf: *byte, off: int) -> int
        ((buf[off] & 0xFF) << 24) | ((buf[off + 1] & 0xFF) << 16) | ((buf[off + 2] & 0xFF) << 8) | (buf[off + 3] & 0xFF)

Write a 4-byte big-endian integer into a message buffer.

    disk_write_i32(buf: *byte, off: int, v: int)
        buf[off] = (v >> 24) & 0xFF
        buf[off + 1] = (v >> 16) & 0xFF
        buf[off + 2] = (v >> 8) & 0xFF
        buf[off + 3] = v & 0xFF

Handle a READ request: read one block and reply.

    disk_handle_read(sender: int, buf: *byte)
        val lba = disk_read_i32(buf, 1)
        val addr = disk_read_i32(buf, 5)
        disk_hw_read(lba, i64(addr))
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, &reply[0], 1)

Handle a WRITE request: write one block and reply.

    disk_handle_write(sender: int, buf: *byte)
        val lba = disk_read_i32(buf, 1)
        val addr = disk_read_i32(buf, 5)
        disk_hw_write(lba, i64(addr))
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, &reply[0], 1)

Handle a CAPACITY request: return sector count.

    disk_handle_capacity(sender: int)
        val cap = disk_hw_capacity()
        var reply: [5]byte
        reply[0] = 0
        disk_write_i32(&reply[0], 1, cap)
        ipc_reply(sender, &reply[0], 5)

The disk server loop. Creates port, registers as "disk",
then loops handling block I/O requests.

    disk_server()
        // Set up name
        disk_name[0] = 100  // d
        disk_name[1] = 105  // i
        disk_name[2] = 115  // s
        disk_name[3] = 107  // k
        disk_name[4] = 0

        // Create and register port
        disk_port = port_create()
        port_register(disk_port, &disk_name[0])

        // Server loop
        var buf: [16]byte
        while 1 == 1
            val sender = ipc_recv(disk_port, &buf[0], 16)
            if sender >= 0
                val cmd = int(buf[0])
                if cmd == DISK_CMD_READ
                    disk_handle_read(sender, &buf[0])
                else if cmd == DISK_CMD_WRITE
                    disk_handle_write(sender, &buf[0])
                else if cmd == DISK_CMD_CAPACITY
                    disk_handle_capacity(sender)
                else
                    // Unknown command — reply with error
                    var reply: [1]byte
                    reply[0] = -1
                    ipc_reply(sender, &reply[0], 1)

Userspace wrappers. Clients use these to talk to the disk server
without building IPC messages manually.

    disk_read(lba: int, addr: *byte) -> int
        val port = port_lookup(&disk_name[0])
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = DISK_CMD_READ
        disk_write_i32(&msg[0], 1, lba)
        disk_write_i32(&msg[0], 5, int(i64(addr)))
        var reply: [1]byte
        ipc_send(port, &msg[0], 9, &reply[0], 1)
        int(reply[0])

    disk_write(lba: int, addr: *byte) -> int
        val port = port_lookup(&disk_name[0])
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = DISK_CMD_WRITE
        disk_write_i32(&msg[0], 1, lba)
        disk_write_i32(&msg[0], 5, int(i64(addr)))
        var reply: [1]byte
        ipc_send(port, &msg[0], 9, &reply[0], 1)
        int(reply[0])

    disk_capacity() -> int
        val port = port_lookup(&disk_name[0])
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = DISK_CMD_CAPACITY
        var reply: [5]byte
        ipc_send(port, &msg[0], 1, &reply[0], 5)
        if reply[0] != 0
            return -1
        disk_read_i32(&reply[0], 1)

