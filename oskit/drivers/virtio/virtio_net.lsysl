Virtio-net driver (split virtqueue, modern v1.0+)
===================================================

Transport-agnostic modern virtio-net. The MMIO-specific register
pokes have been pushed down into `virtio_transport_mmio.lsysl` /
`virtio_transport_pci.lsysl`; this file only knows about the
virtqueue memory layout and the virtio-net spec. One transport is
compiled per build (selected by the arch's build script).

Runs in kernel address space. On aarch64 the 1GB RAM block is
identity-mapped and MMIO is mapped already; on x86 the kernel's
identity map covers low phys and the virtio-pci transport maps
the selected device's BARs. Either way, `page_alloc_zero` returns
pages the device can DMA to directly.

Queue layout:

- Queue 0 = RX. Pre-populated with `VNET_RX_QLEN` single-descriptor
  entries, each pointing at a `VNET_BUF_BYTES`-byte buffer. The
  device writes a `virtio_net_hdr` (12 bytes) followed by the
  incoming Ethernet frame.
- Queue 1 = TX. Used ad-hoc: the driver copies a caller's frame
  into one of `VNET_TX_QLEN` static TX buffers, prepends a zero
  header, fills a descriptor, advances the avail ring, and kicks.

Feature negotiation: we only acknowledge `VIRTIO_F_VERSION_1`
(bit 32) + `VIRTIO_NET_F_MAC` (bit 5). Modern QEMU always offers
them on both transports.

    module oskit.drivers.virtio

    import oskit.arch.{page_alloc_zero}


Tunables. Keep small for first bring-up; growing later is just a
matter of bumping the constants and reallocating.

    val VNET_Q_RX = 0
    val VNET_Q_TX = 1

    val VNET_RX_QLEN  = 16
    val VNET_TX_QLEN  = 8
    val VNET_BUF_BYTES = 2048          // one MTU + virtio hdr + slack


virtio-net header (virtio 1.0, MRG_RXBUF implied by VERSION_1).

    struct VirtioNetHdr
        flags: byte
        gso_type: byte
        hdr_len: u16
        gso_size: u16
        csum_start: u16
        csum_offset: u16
        num_buffers: u16

    static_assert(sizeof(VirtioNetHdr) == 12, "virtio-net hdr must be 12 bytes")


Descriptor flags.

    val VIRTQ_DESC_F_NEXT  = 1
    val VIRTQ_DESC_F_WRITE = 2


Split virtqueue descriptor.

    struct VirtqDesc
        addr: u64
        len:  u32
        flags: u16
        next: u16

    static_assert(sizeof(VirtqDesc) == 16, "virtq desc must be 16 bytes")


Driver state. `vnet_ready` is set at the tail of `virtio_net_init`
so `send`/`recv` can refuse early without race. MAC is loaded
during init if the device offered `VIRTIO_NET_F_MAC`.

    var vnet_ready: int = 0
    var vnet_mac: [6]byte
    var vnet_mac_ok: int = 0
    var vnet_fail: int = 0


Per-queue bookkeeping. We split the state by queue so TX and RX
don't step on each other. Memory for each ring is one page each
(desc/avail/used).

    var vnet_rx_desc_pa: i64 = 0
    var vnet_rx_avail_pa: i64 = 0
    var vnet_rx_used_pa: i64 = 0
    var vnet_rx_last_used: int = 0     // used.idx snapshot we last consumed
    var vnet_rx_avail_idx: int = 0     // monotonic avail.idx we wrote

    var vnet_tx_desc_pa: i64 = 0
    var vnet_tx_avail_pa: i64 = 0
    var vnet_tx_used_pa: i64 = 0
    var vnet_tx_last_used: int = 0
    var vnet_tx_avail_idx: int = 0
    var vnet_tx_next_slot: int = 0     // round-robin TX buffer


Static buffer arrays. Each RX slot owns one `VNET_BUF_BYTES` buffer;
each TX slot owns one. Allocated from `page_alloc_zero` at init
time; stored as physical addresses because we hand them to the
device.

    var vnet_rx_bufs: [16]i64           // = VNET_RX_QLEN
    var vnet_tx_bufs: [8]i64            // = VNET_TX_QLEN


Raw u16 / u32 accessors over kernel-side physical memory.
Identity map makes PA==VA here, so a plain pointer works.

    vnet_write_u16(pa: i64, off: int, v: int)
        var p: *u16 = *u16(pa + i64(off))
        *p = u16(v & 0xffff)

    vnet_read_u16(pa: i64, off: int) -> int
        var p: *u16 = *u16(pa + i64(off))
        int(*p)

    vnet_read_u32(pa: i64, off: int) -> i32
        var p: *i32 = *i32(pa + i64(off))
        *p


Write a VirtqDesc at `desc_pa + idx * 16`.

    vnet_desc_set(desc_pa: i64, idx: int, addr: i64, len: int, flags: int, next: int)
        val entry = desc_pa + i64(idx * 16)
        var p_addr: *u64 = *u64(entry)
        *p_addr = u64(addr)
        var p_len: *u32 = *u32(entry + 8)
        *p_len = i32(len)
        var p_flags: *u16 = *u16(entry + 12)
        *p_flags = u16(flags & 0xffff)
        var p_next: *u16 = *u16(entry + 14)
        *p_next = u16(next & 0xffff)


Pre-populate the RX queue: every descriptor points at one of the
RX buffers and has the WRITE flag set (device-writable). The
avail ring lists every descriptor index in order.

    vnet_rx_prefill()
        var i = 0
        while i < VNET_RX_QLEN
            vnet_rx_bufs[i] = i64(page_alloc_zero())
            vnet_desc_set(vnet_rx_desc_pa, i,
                vnet_rx_bufs[i], VNET_BUF_BYTES,
                VIRTQ_DESC_F_WRITE, 0)
            // avail.ring[i] = i
            vnet_write_u16(vnet_rx_avail_pa, 4 + i * 2, i)
            i += 1
        vnet_rx_avail_idx = VNET_RX_QLEN
        // avail.idx = QLEN
        vnet_write_u16(vnet_rx_avail_pa, 2, vnet_rx_avail_idx)


Allocate TX buffers. The descriptors themselves are filled in
on each `virtio_net_send` call; here we just reserve pages.

    vnet_tx_alloc_bufs()
        var i = 0
        while i < VNET_TX_QLEN
            vnet_tx_bufs[i] = i64(page_alloc_zero())
            i += 1


Report the fail-code from the last failed `virtio_net_init` call.

    virtio_net_last_fail() -> int
        vnet_fail


Diagnostic — read a specific 32-bit feature slice. `sel = 0` for
bits 0-31, `sel = 1` for bits 32-63.

    virtio_net_debug_feats(sel: int) -> i32
        v_debug_feats(sel)


Diagnostic — read the transport version register. MMIO reports
2 for v2; PCI has no exact analog (returns 0).

    virtio_net_debug_version() -> int
        v_debug_version()


Device init handshake — returns 1 on success, 0 on failure. On
failure, `virtio_net_last_fail()` reports a small numeric code
indicating which step blew up (for diagnostics only).

    virtio_net_init() -> int
        if v_find(VIRTIO_DEV_NET) == 0
            vnet_fail = 1
            return 0

Reset the device: status = 0 (virtio spec 4.2.3.1.1 step 1).

        v_status_write(0)

ACKNOWLEDGE (step 2) and DRIVER (step 3) — tell the device we've
noticed it and are going to drive it.

        v_status_or(VIRTIO_STATUS_ACKNOWLEDGE)
        v_status_or(VIRTIO_STATUS_DRIVER)

Feature negotiation. Bit 5 = VIRTIO_NET_F_MAC, bit 32 =
VIRTIO_F_VERSION_1. We require VERSION_1; MAC is optional.

        if v_feat_has(32) == 0
            v_status_or(VIRTIO_STATUS_FAILED)
            vnet_fail = 2
            return 0
        v_feat_ack(32)
        if v_feat_has(5) != 0
            v_feat_ack(5)

FEATURES_OK (step 5 of the handshake) — re-read to confirm the
device accepted our subset. If not, abort.

        v_status_or(VIRTIO_STATUS_FEATURES_OK)
        if (v_status_read() & VIRTIO_STATUS_FEATURES_OK) == 0
            v_status_or(VIRTIO_STATUS_FAILED)
            vnet_fail = 3
            return 0

Allocate ring memory and hand it to the transport for setup.

        vnet_rx_desc_pa  = i64(page_alloc_zero())
        vnet_rx_avail_pa = i64(page_alloc_zero())
        vnet_rx_used_pa  = i64(page_alloc_zero())
        if vnet_rx_desc_pa == 0 || vnet_rx_avail_pa == 0 || vnet_rx_used_pa == 0
            v_status_or(VIRTIO_STATUS_FAILED)
            vnet_fail = 4
            return 0
        if v_queue_setup(VNET_Q_RX, VNET_RX_QLEN,
                vnet_rx_desc_pa, vnet_rx_avail_pa, vnet_rx_used_pa) == 0
            v_status_or(VIRTIO_STATUS_FAILED)
            vnet_fail = 4
            return 0

        vnet_tx_desc_pa  = i64(page_alloc_zero())
        vnet_tx_avail_pa = i64(page_alloc_zero())
        vnet_tx_used_pa  = i64(page_alloc_zero())
        if vnet_tx_desc_pa == 0 || vnet_tx_avail_pa == 0 || vnet_tx_used_pa == 0
            v_status_or(VIRTIO_STATUS_FAILED)
            vnet_fail = 5
            return 0
        if v_queue_setup(VNET_Q_TX, VNET_TX_QLEN,
                vnet_tx_desc_pa, vnet_tx_avail_pa, vnet_tx_used_pa) == 0
            v_status_or(VIRTIO_STATUS_FAILED)
            vnet_fail = 5
            return 0

        vnet_rx_prefill()
        vnet_tx_alloc_bufs()

        // Load MAC from config space (first 6 bytes) if the device
        // offered VIRTIO_NET_F_MAC.
        var i = 0
        while i < 6
            vnet_mac[i] = byte(v_config_byte(i))
            i += 1
        vnet_mac_ok = 1

        // 6. DRIVER_OK — device is live.
        v_status_or(VIRTIO_STATUS_DRIVER_OK)

        // Kick the RX queue so the device sees the descriptors we
        // made available.
        v_queue_notify(VNET_Q_RX)
        vnet_ready = 1
        1


Get the negotiated MAC into `out[0..5]`. Returns 1 if MAC was
configured, 0 otherwise.

    virtio_net_get_mac(out: *byte) -> int
        if vnet_mac_ok == 0
            return 0
        var i = 0
        while i < 6
            out[i] = vnet_mac[i]
            i += 1
        1


Send a raw Ethernet frame. Copies caller's bytes into the next
round-robin TX buffer, prepends a zero `VirtioNetHdr`, wires up
one descriptor, bumps avail.idx, and notifies.

Returns 1 on success, 0 if the driver isn't initialized or the
frame is too large.

    virtio_net_send(frame: *byte, len: int) -> int
        if vnet_ready == 0
            return 0
        if len <= 0
            return 0
        if len + 12 > VNET_BUF_BYTES
            return 0

        val slot = vnet_tx_next_slot
        vnet_tx_next_slot = (slot + 1) % VNET_TX_QLEN

        val buf = vnet_tx_bufs[slot]
        val hdr: *byte = *byte(buf)

Zero the virtio-net header.

        var i = 0
        while i < 12
            hdr[i] = 0
            i += 1

Copy the caller's frame in after the header.

        val body: *byte = *byte(buf + i64(12))
        i = 0
        while i < len
            body[i] = frame[i]
            i += 1

        vnet_desc_set(vnet_tx_desc_pa, slot, buf, 12 + len, 0, 0)

        // avail.ring[avail_idx % QLEN] = slot
        vnet_write_u16(vnet_tx_avail_pa, 4 + (vnet_tx_avail_idx % VNET_TX_QLEN) * 2, slot)
        vnet_tx_avail_idx = (vnet_tx_avail_idx + 1) & 0xffff
        vnet_write_u16(vnet_tx_avail_pa, 2, vnet_tx_avail_idx)

        v_queue_notify(VNET_Q_TX)
        1


Poll the RX used ring once. If a packet is available, copy it
(minus the virtio-net header) into `out` up to `max_len`, make
the descriptor available again, and return the Ethernet frame
length. Returns 0 if no packet is ready, -1 on error.

    virtio_net_recv(out: *byte, max_len: int) -> int
        if vnet_ready == 0
            return -1
        val used_idx = vnet_read_u16(vnet_rx_used_pa, 2)
        if used_idx == vnet_rx_last_used
            return 0

        val slot = vnet_rx_last_used % VNET_RX_QLEN
        // used.ring[slot] = { id:u32, len:u32 }
        val elem_off = 4 + slot * 8
        val desc_id = int(vnet_read_u32(vnet_rx_used_pa, elem_off))
        val raw_len = int(vnet_read_u32(vnet_rx_used_pa, elem_off + 4))
        // raw_len includes the 12-byte virtio-net header.
        var frame_len = raw_len - 12
        if frame_len < 0
            frame_len = 0
        if frame_len > max_len
            frame_len = max_len

        val buf = vnet_rx_bufs[desc_id]
        val src: *byte = *byte(buf + i64(12))
        var i = 0
        while i < frame_len
            out[i] = src[i]
            i += 1

        // Return the descriptor to the device.
        vnet_desc_set(vnet_rx_desc_pa, desc_id,
            buf, VNET_BUF_BYTES, VIRTQ_DESC_F_WRITE, 0)
        vnet_write_u16(vnet_rx_avail_pa,
            4 + (vnet_rx_avail_idx % VNET_RX_QLEN) * 2, desc_id)
        vnet_rx_avail_idx = (vnet_rx_avail_idx + 1) & 0xffff
        vnet_write_u16(vnet_rx_avail_pa, 2, vnet_rx_avail_idx)
        v_queue_notify(VNET_Q_RX)

        vnet_rx_last_used = (vnet_rx_last_used + 1) & 0xffff
        frame_len
