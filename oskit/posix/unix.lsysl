AF_UNIX socket family
=====================

The unix server (oskit/servers/unix.lsysl) is a self-contained
path-keyed registry — no NIC, no filesystem integration. Every
AF_UNIX socket maps to a single server-side slot identified by
a small integer (`target`). Both DGRAM and STREAM allocate the
slot eagerly at `socket(2)` time, unlike the AF_INET TCP path
which defers allocation to listen/connect.

`sockaddr_un` layout (Linux):
  offset 0..1 : sa_family (u16 native, AF_UNIX = 1)
  offset 2..  : sun_path (NUL-terminated C string, ≤108 bytes)

For now the path is interpreted as a C-string starting at
offset 2: bytes are taken up to the first NUL or to addrlen-2,
whichever comes first. Linux abstract-namespace (leading-NUL)
support is deferred — slix's registry is already an abstract
namespace, so a leading NUL just confuses key matching.

    module oskit.posix

    import oskit.ipc.{ipc_send}
    import oskit.kernel.{kernel_get_process_main_tid}


    sys_socket_unix(stype: int) -> i64
        val sock_flag_mask = POSIX_SOCK_NONBLOCK | POSIX_SOCK_CLOEXEC
        val sock_flags = stype & sock_flag_mask
        val base_type = stype & ~sock_flag_mask
        if base_type != POSIX_SOCK_DGRAM
            if base_type != POSIX_SOCK_STREAM
                return i64(-EPROTONOSUPPORT)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var msg: [2]byte
        msg[0] = byte(UNIX_CMD_SOCKET)
        msg[1] = byte(base_type & 0xff)
        var reply: [2]byte
        val r = ipc_send(port, msg, 2, reply, 2)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            return i64(unix_status(reply[0]))
        val unix_fd = int(reply[1]) & 0xff
        val posix_fd = posix_fd_alloc(POSIX_FD_UNIX_SOCKET, unix_fd)
        if posix_fd < 0
            var close_msg: [2]byte
            close_msg[0] = byte(UNIX_CMD_CLOSE)
            close_msg[1] = byte(unix_fd & 0xff)
            var close_rep: [1]byte
            ipc_send(port, close_msg, 2, close_rep, 1)
            return i64(-EMFILE)
        // Stash stype in pos so subsequent helpers can route DGRAM
        // vs STREAM without a second IPC.
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + posix_fd].pos = i64(base_type)
        if (sock_flags & POSIX_SOCK_NONBLOCK) != 0
            val cur = posix_fd_flags(posix_fd)
            posix_fd_set_flags(posix_fd, cur | POSIX_O_NONBLOCK)
        i64(posix_fd)


sys_socketpair for AF_UNIX SOCK_STREAM. Asks the unix server to
allocate two pre-connected slots, then parks each in a fresh
posix-fd slot and writes the pair into `sv_ptr[0..1]` (an
`int[2]` in user memory, matching musl's `socketpair(int sv[2])`
prototype).

`type` may carry `SOCK_NONBLOCK` / `SOCK_CLOEXEC` flags; we mask
them off, propagate `O_NONBLOCK` to both new fds, and accept-and
-ignore CLOEXEC. STREAM and DGRAM are both supported; the server
links the two slots via `peer_idx` and the DGRAM SENDTO path
treats `plen == 0` as "default to peer_idx". `-EAFNOSUPPORT`
for non-AF_UNIX domains (no AF_INET socketpair — Linux itself
returns EOPNOTSUPP there too).

If allocating either posix-fd slot fails, the unix-server slots
are reclaimed via `shim_unix_close` so the server doesn't leak.

    sys_socketpair(family: int, stype: int, proto: int,
            sv_ptr: i64) -> i64
        if family != POSIX_AF_UNIX
            return i64(-EAFNOSUPPORT)
        if sv_ptr == i64(0)
            return i64(-EFAULT)
        val sock_flag_mask = POSIX_SOCK_NONBLOCK | POSIX_SOCK_CLOEXEC
        val sock_flags = stype & sock_flag_mask
        val base_type = stype & ~sock_flag_mask
        if base_type != POSIX_SOCK_STREAM
            if base_type != POSIX_SOCK_DGRAM
                return i64(-EOPNOTSUPP)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var msg: [2]byte
        msg[0] = byte(UNIX_CMD_SOCKETPAIR)
        msg[1] = byte(base_type & 0xff)
        var reply: [3]byte
        val r = ipc_send(port, msg, 2, reply, 3)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            return i64(unix_status(reply[0]))
        val ufd0 = int(reply[1]) & 0xff
        val ufd1 = int(reply[2]) & 0xff
        val pfd0 = posix_fd_alloc(POSIX_FD_UNIX_SOCKET, ufd0)
        if pfd0 < 0
            shim_unix_close(ufd0)
            shim_unix_close(ufd1)
            return i64(-EMFILE)
        val pfd1 = posix_fd_alloc(POSIX_FD_UNIX_SOCKET, ufd1)
        if pfd1 < 0
            sys_close(pfd0)
            shim_unix_close(ufd1)
            return i64(-EMFILE)
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + pfd0].pos = i64(base_type)
        posix_fd_table[pid * POSIX_FDS_PER_PROC + pfd1].pos = i64(base_type)
        if (sock_flags & POSIX_SOCK_NONBLOCK) != 0
            val cur0 = posix_fd_flags(pfd0)
            posix_fd_set_flags(pfd0, cur0 | POSIX_O_NONBLOCK)
            val cur1 = posix_fd_flags(pfd1)
            posix_fd_set_flags(pfd1, cur1 | POSIX_O_NONBLOCK)
        var fdp: *int = *int(sv_ptr)
        fdp[0] = pfd0
        fdp[1] = pfd1
        i64(0)


Read sun_path into `out` and return the effective length.
addrlen ≤ 2 → -1.

Two flavors:

  - **Abstract namespace** (Linux): sun_path[0] is NUL and the
    rest of the bytes up to addrlen are the key (no NUL
    terminator inside; embedded NULs are part of the name).
    We copy the leading NUL plus the remaining bytes into
    `out`, so two abstract sockets named `\0foo` and `\0fo` are
    distinct keys, and the abstract namespace is automatically
    disjoint from filesystem-style keys (which never start
    with NUL).
  - **Filesystem path**: sun_path[0] is non-NUL and the bytes
    up to the first NUL form the key (C-string convention).

Returns -1 if the parsed key is empty or exceeds
UNIX_PATH_MAX.

    shim_unix_read_path(addr_ptr: i64, addrlen: int,
            out: *byte, out_cap: int) -> int
        if addrlen < 3
            return -1
        val src: *byte = *byte(addr_ptr)
        var avail = addrlen - 2
        if avail > out_cap
            avail = out_cap
        if avail > UNIX_PATH_MAX
            avail = UNIX_PATH_MAX
        if avail <= 0
            return -1
        if src[2] == byte(0)
            // Abstract namespace: copy leading NUL + body verbatim
            // (no NUL-terminator scan; embedded NULs are name bytes).
            var n = 0
            while n < avail
                out[n] = src[2 + n]
                n += 1
            if n <= 1
                return -1
            return n
        var n = 0
        var done = 0
        while done == 0
            if n >= avail
                done = 1
            else
                val b = src[2 + n]
                if b == byte(0)
                    done = 1
                else
                    out[n] = b
                    n += 1
        if n <= 0
            return -1
        n


Issue UNIX_CMD_CLOSE for `target`.

    shim_unix_close(target: int)
        if target < 0
            return
        val port = unix_get_port()
        if port < 0
            return
        var msg: [2]byte
        msg[0] = byte(UNIX_CMD_CLOSE)
        msg[1] = byte(target & 0xff)
        var reply: [1]byte
        ipc_send(port, msg, 2, reply, 1)


sys_bind for AF_UNIX. Sends the path key to the unix server.

    sys_bind_unix(fd: int, addr_ptr: i64, addrlen: int) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        var path: [108]byte
        val plen = shim_unix_read_path(addr_ptr, addrlen, &path[0], 108)
        if plen <= 0
            return i64(-EINVAL)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var msg: [128]byte
        msg[0] = byte(UNIX_CMD_BIND)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(plen & 0xff)
        var i = 0
        while i < plen
            msg[3 + i] = path[i]
            i += 1
        var reply: [1]byte
        val r = ipc_send(port, msg, 3 + plen, reply, 1)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        i64(0)


sys_listen for AF_UNIX. STREAM only.

    sys_listen_unix(fd: int, backlog: int) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var bl = backlog
        if bl < 0
            bl = 0
        if bl > 0xff
            bl = 0xff
        var msg: [3]byte
        msg[0] = byte(UNIX_CMD_LISTEN)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(bl & 0xff)
        var reply: [1]byte
        val r = ipc_send(port, msg, 3, reply, 1)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            return i64(unix_status(reply[0]))
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].is_listen = 1
        i64(0)


sys_accept for AF_UNIX. STREAM only. Allocates a fresh
posix fd backed by the new server-end slot. If the listener fd
has `O_NONBLOCK` set, switches to `UNIX_CMD_ACCEPT_NB` so an
empty backlog returns -EAGAIN instead of parking.

    sys_accept_unix(fd: int, addr_ptr: i64, addrlen_ptr: i64) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        val nb = posix_fd_flags(fd) & POSIX_O_NONBLOCK
        var msg: [2]byte
        if nb != 0
            msg[0] = byte(UNIX_CMD_ACCEPT_NB)
        else
            msg[0] = byte(UNIX_CMD_ACCEPT)
        msg[1] = byte(target & 0xff)
        var reply: [128]byte
        val r = ipc_send(port, msg, 2, reply, 128)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            return i64(unix_status(reply[0]))
        val server_end = int(reply[1]) & 0xff
        val plen = int(reply[2]) & 0xff
        val new_posix_fd = posix_fd_alloc(POSIX_FD_UNIX_SOCKET, server_end)
        if new_posix_fd < 0
            shim_unix_close(server_end)
            return i64(-EMFILE)
        val pid = posix_fd_current_pid()
        posix_fd_table[pid * POSIX_FDS_PER_PROC + new_posix_fd].pos = i64(POSIX_SOCK_STREAM)

The reply carries `plen + path[]` from the connector's bound
path (or `plen=0` if the connector was unbound). Fill the
caller's sockaddr_un with `family(2) + path[plen] + NUL` —
matching Linux's "len includes the NUL when the path is
non-empty" convention, and leave `addrlen = 2` for an
unbound connector so callers can distinguish.

        if addr_ptr != i64(0)
            val a: *byte = *byte(addr_ptr)
            a[0] = byte(POSIX_AF_UNIX & 0xff)
            a[1] = byte(0)
            var pcopy = plen
            if pcopy > UNIX_PATH_MAX
                pcopy = UNIX_PATH_MAX
            var i = 0
            while i < pcopy
                a[2 + i] = reply[3 + i]
                i += 1
            if 2 + pcopy < 110
                a[2 + pcopy] = byte(0)
        if addrlen_ptr != i64(0)
            val alp: *i32 = *i32(addrlen_ptr)
            if plen == 0
                *alp = i32(2)
            else
                *alp = i32(2 + plen + 1)
        i64(new_posix_fd)


sys_connect for AF_UNIX. Routes STREAM and DGRAM connect()
(both reuse UNIX_CMD_CONNECT — the server branches on stype).

If `sun_family == AF_UNSPEC`, this is a Linux dissolve: clear
the DGRAM socket's default peer via UNIX_CMD_DISCONNECT, so a
subsequent `send()` (no addr) fails with -ENOTCONN while
explicit `sendto(addr)` keeps working.

    sys_connect_unix(fd: int, addr_ptr: i64, addrlen: int) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        if addrlen < 2
            return i64(-EINVAL)
        if addr_ptr == i64(0)
            return i64(-EFAULT)
        val sa: *byte = *byte(addr_ptr)
        val fam = (int(sa[0]) & 0xff) | ((int(sa[1]) & 0xff) << 8)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        if fam == POSIX_AF_UNSPEC
            var dmsg: [2]byte
            dmsg[0] = byte(UNIX_CMD_DISCONNECT)
            dmsg[1] = byte(target & 0xff)
            var dreply: [1]byte
            val dr = ipc_send(port, dmsg, 2, dreply, 1)
            if dr < 0
                return i64(-EIO)
            if dreply[0] != 0
                val status = unix_status(dreply[0])
                posix_fd_set_error(fd, i64(status))
                return i64(status)
            return i64(0)
        var path: [108]byte
        val plen = shim_unix_read_path(addr_ptr, addrlen, &path[0], 108)
        if plen <= 0
            return i64(-EINVAL)
        var msg: [128]byte
        msg[0] = byte(UNIX_CMD_CONNECT)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(plen & 0xff)
        var i = 0
        while i < plen
            msg[3 + i] = path[i]
            i += 1
        var reply: [1]byte
        val r = ipc_send(port, msg, 3 + plen, reply, 1)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        i64(0)


DGRAM sendto for AF_UNIX.

    sys_sendto_unix_dgram(fd: int, buf: i64, len: int,
            addr_ptr: i64, addrlen: int) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        if len < 0
            return i64(-EINVAL)
        var dlen = len
        if dlen > 256
            dlen = 256
        var path: [108]byte
        var plen = 0
        if addr_ptr != i64(0)
            plen = shim_unix_read_path(addr_ptr, addrlen, &path[0], 108)
            if plen <= 0
                return i64(-EINVAL)

`addr_ptr == NULL` is the "no destination" form used by
`send(2)` / `write(2)` on a connected DGRAM socket
(socketpair pairs, or any future `connect(2)` on DGRAM).
We forward `plen == 0` to the unix server and let it route
via `peer_idx` (returns -ENOTCONN if unset).

        val data: *byte = *byte(buf)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var msg: [512]byte
        msg[0] = byte(UNIX_CMD_SENDTO)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(plen & 0xff)
        var i = 0
        while i < plen
            msg[3 + i] = path[i]
            i += 1
        msg[3 + plen]     = byte((dlen >> 8) & 0xff)
        msg[3 + plen + 1] = byte(dlen & 0xff)
        i = 0
        while i < dlen
            msg[3 + plen + 2 + i] = data[i]
            i += 1
        var reply: [3]byte
        val r = ipc_send(port, msg, 3 + plen + 2 + dlen, reply, 3)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        val nsent = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
        i64(nsent)


STREAM send for AF_UNIX. Used by both `sendto` (with NULL
addr) and `write` on a STREAM unix fd.

    sys_send_unix_stream(fd: int, buf: i64, len: int) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        if len < 0
            return i64(-EINVAL)
        var dlen = len
        if dlen > 2046
            dlen = 2046
        val data: *byte = *byte(buf)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var msg: [2050]byte
        msg[0] = byte(UNIX_CMD_SEND)
        msg[1] = byte(target & 0xff)
        msg[2] = byte((dlen >> 8) & 0xff)
        msg[3] = byte(dlen & 0xff)
        var i = 0
        while i < dlen
            msg[4 + i] = data[i]
            i += 1
        var reply: [3]byte
        val r = ipc_send(port, msg, 4 + dlen, reply, 3)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        val nsent = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
        i64(nsent)


DGRAM recvfrom for AF_UNIX. If the fd is `O_NONBLOCK` (or
`MSG_DONTWAIT` is in flags) and the queue is empty, returns
-EAGAIN via `UNIX_CMD_RECVFROM_NB`. `MSG_PEEK` (0x02) reads
the head dgram without dequeuing, matching the inet path's
peek semantics — the unix server's parked-recv path also
tracks peek so a subsequent sender re-enqueues after
delivering, leaving the dgram observable.

    sys_recvfrom_unix_dgram(fd: int, buf: i64, len: int, flags: int,
            addr_ptr: i64, addrlen_ptr: i64) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        var maxlen = len
        if maxlen < 0
            maxlen = 0
        if maxlen > 256
            maxlen = 256
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var nb = posix_fd_flags(fd) & POSIX_O_NONBLOCK
        if (flags & POSIX_MSG_DONTWAIT) != 0
            nb = POSIX_O_NONBLOCK
        var msg: [5]byte
        if nb != 0
            msg[0] = byte(UNIX_CMD_RECVFROM_NB)
        else
            msg[0] = byte(UNIX_CMD_RECVFROM)
        msg[1] = byte(target & 0xff)
        msg[2] = byte((maxlen >> 8) & 0xff)
        msg[3] = byte(maxlen & 0xff)
        if (flags & POSIX_MSG_PEEK) != 0
            msg[4] = byte(1)
        else
            msg[4] = byte(0)
        var reply: [512]byte
        val r = ipc_send(port, msg, 5, reply, 512)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        val plen = int(reply[1]) & 0xff
        val dlen = ((int(reply[2 + plen]) & 0xff) << 8) | (int(reply[2 + plen + 1]) & 0xff)
        var dcopy = dlen
        if dcopy > maxlen
            dcopy = maxlen
        val dst: *byte = *byte(buf)
        var i = 0
        while i < dcopy
            dst[i] = reply[2 + plen + 2 + i]
            i += 1
        if addr_ptr != i64(0)
            val a: *byte = *byte(addr_ptr)
            a[0] = byte(POSIX_AF_UNIX & 0xff)
            a[1] = byte(0)
            var pcopy = plen
            if pcopy > UNIX_PATH_MAX
                pcopy = UNIX_PATH_MAX
            i = 0
            while i < pcopy
                a[2 + i] = reply[2 + i]
                i += 1
            // NUL-terminate within bounds for C-string callers.
            if 2 + pcopy < 110
                a[2 + pcopy] = byte(0)
        if addrlen_ptr != i64(0)
            val alp: *i32 = *i32(addrlen_ptr)
            *alp = i32(2 + plen)
        i64(dcopy)


STREAM recv for AF_UNIX. Used by `read` (flags=0) and
`recvfrom`/`recvmsg` (flags forwarded). If the fd is
`O_NONBLOCK` (or `MSG_DONTWAIT` is in flags) and rx_buf is
empty *and* the peer is still alive, switches to
`UNIX_CMD_RECV_NB` so the server returns -EAGAIN instead of
parking. EOF (peer closed, no data) still returns 0.

    sys_recv_unix_stream(fd: int, buf: i64, len: int, flags: int) -> i64
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        var maxlen = len
        if maxlen < 0
            maxlen = 0
        if maxlen > 2046
            maxlen = 2046
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var nb = posix_fd_flags(fd) & POSIX_O_NONBLOCK
        if (flags & POSIX_MSG_DONTWAIT) != 0
            nb = POSIX_O_NONBLOCK
        var msg: [4]byte
        if nb != 0
            msg[0] = byte(UNIX_CMD_RECV_NB)
        else
            msg[0] = byte(UNIX_CMD_RECV)
        msg[1] = byte(target & 0xff)
        msg[2] = byte((maxlen >> 8) & 0xff)
        msg[3] = byte(maxlen & 0xff)
        var reply: [2050]byte
        val r = ipc_send(port, msg, 4, reply, 2050)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        val dlen = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
        var dcopy = dlen
        if dcopy > maxlen
            dcopy = maxlen
        val dst: *byte = *byte(buf)
        var i = 0
        while i < dcopy
            dst[i] = reply[3 + i]
            i += 1
        i64(dcopy)


SCM_RIGHTS sendmsg path. Walks the user's `msg_control`
buffer for a single SOL_SOCKET/SCM_RIGHTS cmsg and resolves
each fd into a unix-server slot index. Other cmsg types
are silently skipped (matches Linux: unknown cmsgs aren't
an error). Returns the number of slots written into
`slots[]` on success, -1 on parse error or if any fd isn't
a unix socket.

Used by the DGRAM SENDMSG path, which still rides the 1-byte
(slot-only) wire. The STREAM SENDMSG path uses
`shim_unix_extract_scm_tuples` (4-byte tuples per fd) so it
can carry kind+handle+stype to the unix server.

    shim_unix_extract_scm_rights(ctrl_ptr: i64, ctrl_len: int,
            slots: *byte) -> int
        if ctrl_ptr == i64(0)
            return 0
        if ctrl_len < SHIM_CMSG_HDR_LEN
            return 0
        val cm: *byte = *byte(ctrl_ptr)
        var off = 0
        var nfds = 0
        while off + SHIM_CMSG_HDR_LEN <= ctrl_len
            val cmsg_len = int(shim_read_ptr(cm, off))
            if cmsg_len < SHIM_CMSG_HDR_LEN
                return -1
            if off + cmsg_len > ctrl_len
                return -1
            val cmsg_level = shim_read_i32(cm, off + 8)
            val cmsg_type  = shim_read_i32(cm, off + 12)
            if cmsg_level == SHIM_SOL_SOCKET
                if cmsg_type == SHIM_SCM_RIGHTS
                    val fd_count = (cmsg_len - SHIM_CMSG_HDR_LEN) / 4
                    var i = 0
                    while i < fd_count
                        if nfds >= UNIX_SCM_MAX_FDS
                            return -1
                        val user_fd = shim_read_i32(cm,
                            off + SHIM_CMSG_HDR_LEN + i * 4)
                        val k = posix_fd_kind(user_fd)
                        if k != POSIX_FD_UNIX_SOCKET
                            return -1
                        val slot_idx = posix_fd_target(user_fd)
                        slots[nfds] = byte(slot_idx & 0xff)
                        nfds += 1
                        i += 1
            // Advance to next cmsg, aligned to 8 bytes (sizeof size_t).
            var advance = cmsg_len
            advance = (advance + 7) & (~7)
            off += advance
        nfds


STREAM SENDMSG SCM_RIGHTS extractor. Same cmsg parse as
`shim_unix_extract_scm_rights`, but emits a richer per-fd
payload to match the chunk-2 STREAM wire format: each fd
becomes a (kind, handle_be, stype) tuple in the three parallel
output buffers. Returns the number of fds written, -1 on parse
error or kind not supported by the current allow-list.

Phase 2B chunk 4 allow-list: UNIX_SOCKET, TCP_SOCKET,
UDP_SOCKET, and FILE. TCP/UDP rely on inet's queued_refs (see
`INET_CMD_QUEUE_REF`); FILE rides on vfs's `oft_queued_refs`
(see `VFS_CMD_OFT_QUEUE_REF`); both close the
sender-closes-before-receive race. eventfd / timerfd are out
of scope (Linux supports passing them but slix's per-fd
counter state would split incorrectly across processes — see
the Phase 2B handoff). Other kinds return -1 so the caller
surfaces -EOPNOTSUPP.

For each kind:
- UNIX: `handle = posix_fd.target` (unix slot index), `stype =
  posix_fd.pos` (stream/dgram type recorded by the receiver
  shim's freshly minted posix_fd).
- TCP / UDP: `handle = posix_fd.target` (inet slot index, fits
  in a byte). `stype` recorded as 0.
- FILE: `handle = posix_fd.target` (the *per-pid* VFS handle).
  The SENDMSG site rewrites this to the *OFT idx* via the
  lookup-and-bump round-trip before the message goes on the
  wire — the receiver shim needs a global identifier (OFT idx)
  to mint its own per-pid handle. `stype` recorded as 0.

    shim_unix_extract_scm_tuples(ctrl_ptr: i64, ctrl_len: int,
            out_kinds: *byte, out_handles_be: *byte,
            out_stypes: *byte) -> int
        if ctrl_ptr == i64(0)
            return 0
        if ctrl_len < SHIM_CMSG_HDR_LEN
            return 0
        val cm: *byte = *byte(ctrl_ptr)
        var off = 0
        var nfds = 0
        val pid = posix_fd_current_pid()
        while off + SHIM_CMSG_HDR_LEN <= ctrl_len
            val cmsg_len = int(shim_read_ptr(cm, off))
            if cmsg_len < SHIM_CMSG_HDR_LEN
                return -1
            if off + cmsg_len > ctrl_len
                return -1
            val cmsg_level = shim_read_i32(cm, off + 8)
            val cmsg_type  = shim_read_i32(cm, off + 12)
            if cmsg_level == SHIM_SOL_SOCKET
                if cmsg_type == SHIM_SCM_RIGHTS
                    val fd_count = (cmsg_len - SHIM_CMSG_HDR_LEN) / 4
                    var i = 0
                    while i < fd_count
                        if nfds >= UNIX_SCM_MAX_FDS
                            return -1
                        val user_fd = shim_read_i32(cm,
                            off + SHIM_CMSG_HDR_LEN + i * 4)
                        val k = posix_fd_kind(user_fd)
                        var ok = 0
                        if k == POSIX_FD_UNIX_SOCKET
                            ok = 1
                        if k == POSIX_FD_TCP_SOCKET
                            ok = 1
                        if k == POSIX_FD_UDP_SOCKET
                            ok = 1
                        if k == POSIX_FD_FILE
                            ok = 1
                        if ok == 0
                            return -1
                        val handle = posix_fd_target(user_fd)
                        var stype = 0
                        if k == POSIX_FD_UNIX_SOCKET
                            stype = int(posix_fd_table[pid * POSIX_FDS_PER_PROC + user_fd].pos)
                        out_kinds[nfds]                = byte(k & 0xff)
                        out_handles_be[nfds * 2]       = byte((handle >> 8) & 0xff)
                        out_handles_be[nfds * 2 + 1]   = byte(handle & 0xff)
                        out_stypes[nfds]               = byte(stype & 0xff)
                        nfds += 1
                        i += 1
            var advance = cmsg_len
            advance = (advance + 7) & (~7)
            off += advance
        nfds


sys_sendmsg helper for AF_UNIX. Gathers the iovec into a
single buffer, parses any SCM_RIGHTS cmsg for fd-passing,
and dispatches:
- DGRAM: UNIX_CMD_SENDMSG with path + nfds + slots + payload.
- STREAM with no fds: falls through to sys_write (existing
  UNIX_CMD_SEND path).
- STREAM with fds: returns -EOPNOTSUPP — Session 2 wires
  SCM_RIGHTS through DGRAM only.

    sys_sendmsg_unix(fd: int, msghdr_ptr: i64, flags: int) -> i64
        if msghdr_ptr == i64(0)
            return i64(-EFAULT)
        val mh: *byte = *byte(msghdr_ptr)
        val name_ptr = shim_read_ptr(mh, 0)
        val name_len = shim_read_i32(mh, 8)
        val iov_ptr  = shim_read_ptr(mh, 16)
        val iov_len  = shim_read_i32(mh, 24)
        val ctrl_ptr = shim_read_ptr(mh, 32)
        val ctrl_len = shim_read_i32(mh, 40)
        if iov_len < 0
            return i64(-EINVAL)
        if iov_len > SHIM_IOV_MAX
            return i64(-EINVAL)
        if iov_len > 0
            if iov_ptr == i64(0)
                return i64(-EFAULT)
        val pid = posix_fd_current_pid()
        val stype = int(posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].pos)
        if stype == POSIX_SOCK_STREAM
            // Probe the cmsg first using the chunk-2 (kind, handle, stype)
            // extractor. nfds==0 + ctrl_len==0 short-circuits to plain
            // sys_send_unix_stream below; rejection (kind not on the
            // chunk-2 allow-list) returns -EOPNOTSUPP up front.
            var s_kinds: [4]byte
            var s_handles: [8]byte
            var s_stypes_b: [4]byte
            val nfds = shim_unix_extract_scm_tuples(ctrl_ptr, ctrl_len,
                &s_kinds[0], &s_handles[0], &s_stypes_b[0])
            if nfds < 0
                return i64(-EOPNOTSUPP)
            if nfds == 0
                var gather_p: [2048]byte
                var gtotal_p = 0
                val iov_base_p: *byte = *byte(iov_ptr)
                var ii_p = 0
                while ii_p < iov_len
                    val ent_off_p = ii_p * 16
                    val base_p    = shim_read_ptr(iov_base_p, ent_off_p)
                    val seg_len_p = int(shim_read_ptr(iov_base_p, ent_off_p + 8))
                    if seg_len_p > 0
                        if base_p == i64(0)
                            return i64(-EFAULT)
                        val src_p: *byte = *byte(base_p)
                        var jj_p = 0
                        while jj_p < seg_len_p
                            if gtotal_p < 2046
                                gather_p[gtotal_p] = src_p[jj_p]
                                gtotal_p += 1
                            jj_p += 1
                    ii_p += 1
                return sys_send_unix_stream(fd, i64(&gather_p[0]), gtotal_p)
            // STREAM with cmsg → UNIX_CMD_SENDMSG, plen=0 (target is
            // peer; path unused). Per-fd payload is the chunk-2 4-byte
            // tuple `kind(1) + handle_be(2) + stype(1)`. Data still
            // capped at 256 bytes.
            var gather_s: [256]byte
            var gtotal_s = 0
            val iov_base_s: *byte = *byte(iov_ptr)
            var ii_s = 0
            while ii_s < iov_len
                val ent_off_s = ii_s * 16
                val base_s    = shim_read_ptr(iov_base_s, ent_off_s)
                val seg_len_s = int(shim_read_ptr(iov_base_s, ent_off_s + 8))
                if seg_len_s > 0
                    if base_s == i64(0)
                        return i64(-EFAULT)
                    val src_s: *byte = *byte(base_s)
                    var jj_s = 0
                    while jj_s < seg_len_s
                        if gtotal_s < 256
                            gather_s[gtotal_s] = src_s[jj_s]
                            gtotal_s += 1
                        jj_s += 1
                ii_s += 1
            val target_s = posix_fd_target(fd)
            if target_s < 0
                return i64(-EBADF)
            val port_s = unix_get_port()
            if port_s < 0
                return i64(-ENODEV)
            // Phase 2B chunks 3+4 — bump queued_refs on every
            // backed-by-server tuple before SENDMSG. The unix server
            // takes ownership of the +1 once the cmsg lands in
            // pending_scm; if any step from here fails we roll back.
            // Doing this *before* SENDMSG closes the race where the
            // sender process exits (or close()s the source fd)
            // between SENDMSG and the receiver's drain.
            //
            // For FILE the call also remaps the cmsg's "handle" from
            // the per-pid VFS handle (set by the extractor) to the
            // global OFT idx the receiver shim needs to mint its own
            // handle. We rewrite the handle bytes in `s_handles[]`
            // in-place so the wire-pack loop below sees the correct
            // value with no extra plumbing.
            val sender_pid_for_bump = pid
            var bumped = 0
            while bumped < nfds
                val bk = int(s_kinds[bumped]) & 0xff
                if bk == POSIX_FD_TCP_SOCKET || bk == POSIX_FD_UDP_SOCKET
                    val bh_hi = int(s_handles[bumped * 2]) & 0xff
                    val bh_lo = int(s_handles[bumped * 2 + 1]) & 0xff
                    val bh = (bh_hi << 8) | bh_lo
                    if shim_inet_queue_ref(bk, bh, 1) < 0
                        // Roll back any bumps already done.
                        var rb = 0
                        while rb < bumped
                            val rk = int(s_kinds[rb]) & 0xff
                            val rh_hi = int(s_handles[rb * 2]) & 0xff
                            val rh_lo = int(s_handles[rb * 2 + 1]) & 0xff
                            val rh = (rh_hi << 8) | rh_lo
                            if rk == POSIX_FD_TCP_SOCKET || rk == POSIX_FD_UDP_SOCKET
                                shim_inet_queue_ref(rk, rh, -1)
                            else if rk == POSIX_FD_FILE
                                shim_vfs_oft_queue_ref(rh, -1)
                            rb += 1
                        return i64(-EBADF)
                else if bk == POSIX_FD_FILE
                    val per_pid_hi = int(s_handles[bumped * 2]) & 0xff
                    val per_pid_lo = int(s_handles[bumped * 2 + 1]) & 0xff
                    val per_pid_handle = (per_pid_hi << 8) | per_pid_lo
                    val oft_idx = shim_vfs_oft_queue_ref_by_handle(
                        sender_pid_for_bump, per_pid_handle, 1)
                    if oft_idx < 0
                        var rb = 0
                        while rb < bumped
                            val rk = int(s_kinds[rb]) & 0xff
                            val rh_hi = int(s_handles[rb * 2]) & 0xff
                            val rh_lo = int(s_handles[rb * 2 + 1]) & 0xff
                            val rh = (rh_hi << 8) | rh_lo
                            if rk == POSIX_FD_TCP_SOCKET || rk == POSIX_FD_UDP_SOCKET
                                shim_inet_queue_ref(rk, rh, -1)
                            else if rk == POSIX_FD_FILE
                                shim_vfs_oft_queue_ref(rh, -1)
                            rb += 1
                        return i64(-EBADF)
                    s_handles[bumped * 2]     = byte((oft_idx >> 8) & 0xff)
                    s_handles[bumped * 2 + 1] = byte(oft_idx & 0xff)
                bumped += 1
            var msg_s: [512]byte
            msg_s[0] = byte(UNIX_CMD_SENDMSG)
            msg_s[1] = byte(target_s & 0xff)
            msg_s[2] = byte(0)
            msg_s[3] = byte(nfds & 0xff)
            val tuples_off_s = 4
            var i_s = 0
            while i_s < nfds
                msg_s[tuples_off_s + i_s * 4]     = s_kinds[i_s]
                msg_s[tuples_off_s + i_s * 4 + 1] = s_handles[i_s * 2]
                msg_s[tuples_off_s + i_s * 4 + 2] = s_handles[i_s * 2 + 1]
                msg_s[tuples_off_s + i_s * 4 + 3] = s_stypes_b[i_s]
                i_s += 1
            val data_off_s = tuples_off_s + nfds * 4
            msg_s[data_off_s]     = byte((gtotal_s >> 8) & 0xff)
            msg_s[data_off_s + 1] = byte(gtotal_s & 0xff)
            i_s = 0
            while i_s < gtotal_s
                msg_s[data_off_s + 2 + i_s] = gather_s[i_s]
                i_s += 1
            var reply_s: [3]byte
            val rs = ipc_send(port_s, msg_s, data_off_s + 2 + gtotal_s,
                reply_s, 3)
            // Roll back queued_refs on any failure path. Unix's
            // SENDMSG is atomic — it validates the whole cmsg before
            // stashing — so non-zero status means nothing was stashed
            // and the +1s above have no balancer. By this point the
            // FILE handles in `s_handles[]` have been remapped to OFT
            // idxs, so the FILE drop calls take that idx directly.
            if rs < 0
                var rb_e = 0
                while rb_e < nfds
                    val rk_e = int(s_kinds[rb_e]) & 0xff
                    val rh_hi_e = int(s_handles[rb_e * 2]) & 0xff
                    val rh_lo_e = int(s_handles[rb_e * 2 + 1]) & 0xff
                    val rh_e = (rh_hi_e << 8) | rh_lo_e
                    if rk_e == POSIX_FD_TCP_SOCKET || rk_e == POSIX_FD_UDP_SOCKET
                        shim_inet_queue_ref(rk_e, rh_e, -1)
                    else if rk_e == POSIX_FD_FILE
                        shim_vfs_oft_queue_ref(rh_e, -1)
                    rb_e += 1
                return i64(-EIO)
            if reply_s[0] != 0
                var rb_f = 0
                while rb_f < nfds
                    val rk_f = int(s_kinds[rb_f]) & 0xff
                    val rh_hi_f = int(s_handles[rb_f * 2]) & 0xff
                    val rh_lo_f = int(s_handles[rb_f * 2 + 1]) & 0xff
                    val rh_f = (rh_hi_f << 8) | rh_lo_f
                    if rk_f == POSIX_FD_TCP_SOCKET || rk_f == POSIX_FD_UDP_SOCKET
                        shim_inet_queue_ref(rk_f, rh_f, -1)
                    else if rk_f == POSIX_FD_FILE
                        shim_vfs_oft_queue_ref(rh_f, -1)
                    rb_f += 1
                val status_s = unix_status(reply_s[0])
                posix_fd_set_error(fd, i64(status_s))
                return i64(status_s)
            val ns_hi = (int(reply_s[1]) & 0xff) << 8
            val ns_lo = int(reply_s[2]) & 0xff
            val nsent_s = ns_hi | ns_lo
            return i64(nsent_s)

DGRAM path: name is required, gather iovec, build the
SENDMSG wire message. DGRAM still rides the legacy 1-byte-per-fd
SCM_RIGHTS wire (chunk 2 only widened the STREAM side); the
chunk-3 plan extends the same 4-byte-tuple format here.

        var slots: [4]byte
        val nfds = shim_unix_extract_scm_rights(ctrl_ptr, ctrl_len,
            &slots[0])
        if nfds < 0
            return i64(-EINVAL)
        if name_ptr == i64(0)
            return i64(-EINVAL)
        var path: [108]byte
        val plen = shim_unix_read_path(name_ptr, name_len, &path[0], 108)
        if plen <= 0
            return i64(-EINVAL)
        var gather: [256]byte
        var total = 0
        val iov_base: *byte = *byte(iov_ptr)
        var ii = 0
        while ii < iov_len
            val ent_off = ii * 16
            val base    = shim_read_ptr(iov_base, ent_off)
            val seg_len = int(shim_read_ptr(iov_base, ent_off + 8))
            if seg_len > 0
                if base == i64(0)
                    return i64(-EFAULT)
                val src: *byte = *byte(base)
                var jj = 0
                while jj < seg_len
                    if total < 256
                        gather[total] = src[jj]
                        total += 1
                    jj += 1
            ii += 1
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)

Wire layout: cmd(1) + fd(1) + plen(1) + path(P) + nfds(1)
+ slots(F) + dlen_be(2) + data(D). For our caps (path 108
+ 4 fds + 256 data) the worst case is 374 bytes — round to
512 for headroom, matching the server's UNIX_MSG_BUF.

        var msg: [512]byte
        msg[0] = byte(UNIX_CMD_SENDMSG)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(plen & 0xff)
        var i = 0
        while i < plen
            msg[3 + i] = path[i]
            i += 1
        msg[3 + plen] = byte(nfds & 0xff)
        i = 0
        while i < nfds
            msg[3 + plen + 1 + i] = slots[i]
            i += 1
        val slots_off = 3 + plen + 1 + nfds
        msg[slots_off]     = byte((total >> 8) & 0xff)
        msg[slots_off + 1] = byte(total & 0xff)
        i = 0
        while i < total
            msg[slots_off + 2 + i] = gather[i]
            i += 1
        var reply: [3]byte
        val r = ipc_send(port, msg, slots_off + 2 + total, reply, 3)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)
        val nsent = ((int(reply[1]) & 0xff) << 8) | (int(reply[2]) & 0xff)
        i64(nsent)


STREAM recvmsg helper. Reuses the same UNIX_CMD_RECVMSG wire
as DGRAM (server's `unix_handle_recvmsg_stream` returns plen=0
in the reply since STREAM has no per-message src). Allocates
a posix_fd per transferred slot with `pos = POSIX_SOCK_STREAM`
so future ops on the inherited fd dispatch as STREAM.

A zero-byte reply (`status=0, plen=0, nfds=0, dlen=0`)
indicates clean EOF (peer closed or `shut_wr`). Returns 0 to
the caller; iovec / cmsg / namelen left untouched.

    sys_recvmsg_unix_stream(fd: int, mh: *byte, ctrl_ptr: i64,
            ctrl_len: int, iov_ptr: i64, iov_len: int,
            flags: int) -> i64
        var max_nfds = 0
        if ctrl_ptr != i64(0)
            if ctrl_len >= SHIM_CMSG_HDR_LEN
                max_nfds = (ctrl_len - SHIM_CMSG_HDR_LEN) / 4
                if max_nfds > UNIX_SCM_MAX_FDS
                    max_nfds = UNIX_SCM_MAX_FDS
                if max_nfds < 0
                    max_nfds = 0
        var cap = 0
        val iov_base: *byte = *byte(iov_ptr)
        var ii = 0
        while ii < iov_len
            val ent_off = ii * 16
            val seg_len = int(shim_read_ptr(iov_base, ent_off + 8))
            if seg_len > 0
                cap += seg_len
            ii += 1
        if cap > 2046
            cap = 2046
        if cap < 0
            cap = 0
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var nb = posix_fd_flags(fd) & POSIX_O_NONBLOCK
        if (flags & POSIX_MSG_DONTWAIT) != 0
            nb = POSIX_O_NONBLOCK
        var msg: [5]byte
        if nb != 0
            msg[0] = byte(UNIX_CMD_RECVMSG_NB)
        else
            msg[0] = byte(UNIX_CMD_RECVMSG)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(max_nfds & 0xff)
        msg[3] = byte((cap >> 8) & 0xff)
        msg[4] = byte(cap & 0xff)
        var reply: [2070]byte
        val r = ipc_send(port, msg, 5, reply, 2070)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)

Reply layout (Phase 2B chunk 2 wire): status(1) + plen(1)=0 +
nfds(1) + kinds(F) + handles(F*2 BE) + stypes(F) + dlen_be(2) +
data(D). plen is always 0 on STREAM.

        val src_plen = int(reply[1]) & 0xff
        val nfds_in_reply = int(reply[2 + src_plen]) & 0xff
        val kinds_off = 2 + src_plen + 1
        val handles_off = kinds_off + nfds_in_reply
        val stypes_off = handles_off + nfds_in_reply * 2
        val dl_off = stypes_off + nfds_in_reply
        val dl_hi = (int(reply[dl_off]) & 0xff) << 8
        val dl_lo = int(reply[dl_off + 1]) & 0xff
        val dlen = dl_hi | dl_lo
        val data_off = dl_off + 2

Allocate posix_fds for each transferred (kind, handle, stype)
tuple. Phase 2B chunks 3+4 route UNIX_SOCKET, TCP_SOCKET,
UDP_SOCKET, and FILE. The handle's meaning differs by kind:

- UNIX: unix slot index (claim transferred by unix server in
  the drain itself — no inet/vfs side ref to drop here).
- TCP/UDP: inet slot index. Sender bumped queued_refs +1; we
  must always balance with QUEUE_REF(-1), even on alloc
  failure. Successful allocs additionally fan out
  INET_CMD_ADD_OWNER so the inet owners ring tracks us.
- FILE: OFT idx. Sender bumped oft_queued_refs +1; we mint a
  fresh dst-pid handle via REGISTER_FD_BY_OFT, then drop the
  queued ref. On any failure (REGISTER fails, alloc fails)
  the queued ref is still dropped so the counter doesn't leak.

The dedup-on-close fallback for failed allocs differs by kind:
UNIX → shim_unix_close; TCP/UDP → shim_inet_queue_ref(-1);
FILE → shim_vfs_oft_queue_ref(-1).

        var new_fds: [4]int
        var n_new = 0
        val recv_pid = posix_fd_current_pid()
        val recv_main_tid = kernel_get_process_main_tid(recv_pid)
        var nf = 0
        while nf < nfds_in_reply
            val s_kind = int(reply[kinds_off + nf]) & 0xff
            val s_handle_hi = int(reply[handles_off + nf * 2]) & 0xff
            val s_handle_lo = int(reply[handles_off + nf * 2 + 1]) & 0xff
            val s_handle = (s_handle_hi << 8) | s_handle_lo
            val s_stype  = int(reply[stypes_off + nf]) & 0xff
            if s_kind == POSIX_FD_UNIX_SOCKET
                val pfd = posix_fd_alloc(POSIX_FD_UNIX_SOCKET, s_handle)
                if pfd >= 0
                    val pid2 = posix_fd_current_pid()
                    posix_fd_table[pid2 * POSIX_FDS_PER_PROC + pfd].pos = i64(s_stype)
                    new_fds[n_new] = pfd
                    n_new += 1
            else if s_kind == POSIX_FD_TCP_SOCKET || s_kind == POSIX_FD_UDP_SOCKET
                val pfd = posix_fd_alloc(s_kind, s_handle)
                if pfd >= 0
                    // ADD_OWNER lands the receiver's main_tid in the
                    // inet slot's owners ring; QUEUE_REF(-1) drops the
                    // sender's queued +1 now that ownership has been
                    // taken. Order matters: ADD_OWNER first so the
                    // slot can't transition to "no owners and no queue
                    // refs" between the two calls.
                    if shim_inet_add_owner(s_kind, s_handle, recv_main_tid) == 0
                        shim_inet_queue_ref(s_kind, s_handle, -1)
                        new_fds[n_new] = pfd
                        n_new += 1
                    else
                        // ADD_OWNER failed (slot torn down between
                        // unix's claim and our drain). Free the local
                        // posix_fd and drop the queued_ref so the
                        // counter doesn't leak.
                        posix_fd_clear(pfd)
                        shim_inet_queue_ref(s_kind, s_handle, -1)
            else if s_kind == POSIX_FD_FILE
                // s_handle is the global OFT idx. Mint a per-pid
                // handle that points at the same OFT, then alloc
                // a fresh posix_fd referring to that handle.
                val new_handle = shim_vfs_register_fd_by_oft(recv_pid, s_handle)
                if new_handle >= 0
                    val pfd = posix_fd_alloc(POSIX_FD_FILE, new_handle)
                    if pfd >= 0
                        shim_vfs_oft_queue_ref(s_handle, -1)
                        new_fds[n_new] = pfd
                        n_new += 1
                    else
                        // posix_fd table full — release the just-minted
                        // VFS handle so it doesn't leak, then drop the
                        // queued ref. VFS_CMD_CLOSE keys on the IPC
                        // sender's pid, which is the receiver here.
                        val vp = vfs_get_port()
                        if vp >= 0
                            var cm: [5]byte
                            cm[0] = byte(VFS_CMD_CLOSE_C)
                            cm[1] = byte((new_handle >> 24) & 0xff)
                            cm[2] = byte((new_handle >> 16) & 0xff)
                            cm[3] = byte((new_handle >> 8) & 0xff)
                            cm[4] = byte(new_handle & 0xff)
                            var cr: [1]byte
                            ipc_send(vp, &cm[0], 5, &cr[0], 1)
                        shim_vfs_oft_queue_ref(s_handle, -1)
                else
                    // REGISTER_FD_BY_OFT failed (OFT torn down or dst
                    // handle table full). Drop the queued ref.
                    shim_vfs_oft_queue_ref(s_handle, -1)
            nf += 1

        var sidx_closed: [4]int
        var n_closed = 0
        var inet_dropped: [4]int
        var n_inet_dropped = 0
        nf = 0
        while nf < nfds_in_reply
            val s_kind = int(reply[kinds_off + nf]) & 0xff
            val s_handle_hi = int(reply[handles_off + nf * 2]) & 0xff
            val s_handle_lo = int(reply[handles_off + nf * 2 + 1]) & 0xff
            val s_handle = (s_handle_hi << 8) | s_handle_lo
            if s_kind == POSIX_FD_UNIX_SOCKET
                var has_alloc = 0
                var i = 0
                while i < n_new
                    if posix_fd_kind(new_fds[i]) == POSIX_FD_UNIX_SOCKET
                        if posix_fd_target(new_fds[i]) == s_handle
                            has_alloc = 1
                            break
                    i += 1
                if has_alloc == 0
                    var dup = 0
                    i = 0
                    while i < n_closed
                        if sidx_closed[i] == s_handle
                            dup = 1
                            break
                        i += 1
                    if dup == 0
                        shim_unix_close(s_handle)
                        sidx_closed[n_closed] = s_handle
                        n_closed += 1
            else if s_kind == POSIX_FD_TCP_SOCKET || s_kind == POSIX_FD_UDP_SOCKET
                // Was this tuple allocated above? If so we already
                // ran ADD_OWNER + QUEUE_REF(-1); skip. If we hit the
                // alloc-failure branch we also already dropped the
                // queue ref locally — same skip. Otherwise this
                // branch only reaches a tuple whose alloc was
                // skipped (table full at the front, e.g. when n_new
                // ran past 4) and the queue-ref is still un-dropped.
                var found = 0
                var ai = 0
                while ai < n_new
                    if posix_fd_kind(new_fds[ai]) == s_kind
                        if posix_fd_target(new_fds[ai]) == s_handle
                            found = 1
                            break
                    ai += 1
                if found == 0
                    var dup_i = 0
                    var ii = 0
                    while ii < n_inet_dropped
                        if inet_dropped[ii] == (s_kind << 16) | (s_handle & 0xffff)
                            dup_i = 1
                            break
                        ii += 1
                    if dup_i == 0
                        shim_inet_queue_ref(s_kind, s_handle, -1)
                        inet_dropped[n_inet_dropped] = (s_kind << 16) | (s_handle & 0xffff)
                        n_inet_dropped += 1
            nf += 1

Scatter data into the iovec.

        var written = 0
        ii = 0
        while ii < iov_len
            val ent_off = ii * 16
            val base    = shim_read_ptr(iov_base, ent_off)
            val seg_len = int(shim_read_ptr(iov_base, ent_off + 8))
            if seg_len > 0
                if base != i64(0)
                    val dst: *byte = *byte(base)
                    var take = dlen - written
                    if take > seg_len
                        take = seg_len
                    if take < 0
                        take = 0
                    var jj = 0
                    while jj < take
                        dst[jj] = reply[data_off + written + jj]
                        jj += 1
                    written += take
            ii += 1

Build SCM_RIGHTS cmsg in the user's control buffer if fds
were granted.

        var ctrl_used = 0
        if n_new > 0
            if ctrl_ptr != i64(0)
                val cb: *byte = *byte(ctrl_ptr)
                val cmsg_len_v = SHIM_CMSG_HDR_LEN + n_new * 4
                if cmsg_len_v <= ctrl_len
                    var i = 0
                    while i < 8
                        cb[i] = byte((cmsg_len_v >> (i * 8)) & 0xff)
                        i += 1
                    shim_write_i32(cb, 8, SHIM_SOL_SOCKET)
                    shim_write_i32(cb, 12, SHIM_SCM_RIGHTS)
                    var fi = 0
                    while fi < n_new
                        shim_write_i32(cb, SHIM_CMSG_HDR_LEN + fi * 4, new_fds[fi])
                        fi += 1
                    ctrl_used = cmsg_len_v
        shim_write_i32(mh, 40, ctrl_used)
        shim_write_i32(mh, 48, 0)
        i64(written)


sys_recvmsg helper for AF_UNIX. Issues UNIX_CMD_RECVMSG,
unpacks the reply (src_path + ancillary fds + data),
allocates a fresh posix_fd entry per transferred slot,
scatters data into the iovec, and writes a single
SOL_SOCKET/SCM_RIGHTS cmsg into the user's `msg_control`
buffer. Returns the number of payload bytes received.

STREAM dispatches to `sys_recvmsg_unix_stream`; DGRAM stays
in this function.

    sys_recvmsg_unix(fd: int, msghdr_ptr: i64, flags: int) -> i64
        if msghdr_ptr == i64(0)
            return i64(-EFAULT)
        val mh: *byte = *byte(msghdr_ptr)
        val name_ptr = shim_read_ptr(mh, 0)
        val iov_ptr  = shim_read_ptr(mh, 16)
        val iov_len  = shim_read_i32(mh, 24)
        val ctrl_ptr = shim_read_ptr(mh, 32)
        val ctrl_len = shim_read_i32(mh, 40)
        if iov_len < 0
            return i64(-EINVAL)
        if iov_len > SHIM_IOV_MAX
            return i64(-EINVAL)
        if iov_len > 0
            if iov_ptr == i64(0)
                return i64(-EFAULT)
        val pid = posix_fd_current_pid()
        val stype = int(posix_fd_table[pid * POSIX_FDS_PER_PROC + fd].pos)
        if stype == POSIX_SOCK_STREAM
            return sys_recvmsg_unix_stream(fd, mh, ctrl_ptr, ctrl_len,
                iov_ptr, iov_len, flags)

DGRAM path: budget the cmsg buffer for max_nfds, send the
RECVMSG cmd, parse the reply.

        var max_nfds = 0
        if ctrl_ptr != i64(0)
            if ctrl_len >= SHIM_CMSG_HDR_LEN
                max_nfds = (ctrl_len - SHIM_CMSG_HDR_LEN) / 4
                if max_nfds > UNIX_SCM_MAX_FDS
                    max_nfds = UNIX_SCM_MAX_FDS
                if max_nfds < 0
                    max_nfds = 0
        var cap = 0
        val iov_base: *byte = *byte(iov_ptr)
        var ii = 0
        while ii < iov_len
            val ent_off = ii * 16
            val seg_len = int(shim_read_ptr(iov_base, ent_off + 8))
            if seg_len > 0
                cap += seg_len
            ii += 1
        if cap > 256
            cap = 256
        if cap < 0
            cap = 0
        val target = posix_fd_target(fd)
        if target < 0
            return i64(-EBADF)
        val port = unix_get_port()
        if port < 0
            return i64(-ENODEV)
        var nb = posix_fd_flags(fd) & POSIX_O_NONBLOCK
        if (flags & POSIX_MSG_DONTWAIT) != 0
            nb = POSIX_O_NONBLOCK
        var msg: [5]byte
        if nb != 0
            msg[0] = byte(UNIX_CMD_RECVMSG_NB)
        else
            msg[0] = byte(UNIX_CMD_RECVMSG)
        msg[1] = byte(target & 0xff)
        msg[2] = byte(max_nfds & 0xff)
        msg[3] = byte((cap >> 8) & 0xff)
        msg[4] = byte(cap & 0xff)
        var reply: [600]byte
        val r = ipc_send(port, msg, 5, reply, 600)
        if r < 0
            return i64(-EIO)
        if reply[0] != 0
            val status = unix_status(reply[0])
            posix_fd_set_error(fd, i64(status))
            return i64(status)

Reply layout: status(1) + src_plen(1) + src_path(P) +
nfds(1) + slots(F) + stypes(F) + dlen_be(2) + data(D).
The stypes block carries the server-side stype of each
transferred slot (1 = STREAM, 2 = DGRAM) so the new
posix_fd's `pos` matches the underlying server slot.

        val src_plen = int(reply[1]) & 0xff
        val nfds_in_reply = int(reply[2 + src_plen]) & 0xff
        val slots_off = 2 + src_plen + 1
        val stypes_off = slots_off + nfds_in_reply
        val dlen_off = stypes_off + nfds_in_reply
        val dl_hi = (int(reply[dlen_off]) & 0xff) << 8
        val dl_lo = int(reply[dlen_off + 1]) & 0xff
        val dlen = dl_hi | dl_lo
        val data_off = dlen_off + 2

Allocate posix_fds for each transferred slot. Linux's
SCM_RIGHTS leaves the receiver responsible for closing
each new fd. If `posix_fd_alloc` fails (EMFILE) for a
particular slot, the receiver's owners-ring co-ownership
(added by the server during RECVMSG) needs to be
released — but only if NO other allocation in this batch
succeeded for the same sidx. With duplicate cmsg fds, an
early success + later fail must not call `UNIX_CMD_CLOSE`
or it would strip the receiver from owners and dangle the
earlier successful posix_fd.

Two-pass: first try every alloc; then walk the cmsg again
and call CLOSE only for sidx values that ended up with
zero successful allocs (de-duped so same sidx isn't closed
twice).

        var new_fds: [4]int
        var n_new = 0
        var nf = 0
        while nf < nfds_in_reply
            val sidx = int(reply[slots_off + nf]) & 0xff
            val sst  = int(reply[stypes_off + nf]) & 0xff
            val pfd = posix_fd_alloc(POSIX_FD_UNIX_SOCKET, sidx)
            if pfd >= 0
                val pid2 = posix_fd_current_pid()
                posix_fd_table[pid2 * POSIX_FDS_PER_PROC + pfd].pos = i64(sst)
                new_fds[n_new] = pfd
                n_new += 1
            nf += 1

        var sidx_closed: [4]int
        var n_closed = 0
        nf = 0
        while nf < nfds_in_reply
            val sidx = int(reply[slots_off + nf]) & 0xff
            var has_alloc = 0
            var i = 0
            while i < n_new
                if posix_fd_target(new_fds[i]) == sidx
                    has_alloc = 1
                    break
                i += 1
            if has_alloc == 0
                var dup = 0
                i = 0
                while i < n_closed
                    if sidx_closed[i] == sidx
                        dup = 1
                        break
                    i += 1
                if dup == 0
                    shim_unix_close(sidx)
                    sidx_closed[n_closed] = sidx
                    n_closed += 1
            nf += 1

Scatter data into the iovec.

        var written = 0
        ii = 0
        while ii < iov_len
            val ent_off = ii * 16
            val base    = shim_read_ptr(iov_base, ent_off)
            val seg_len = int(shim_read_ptr(iov_base, ent_off + 8))
            if seg_len > 0
                if base != i64(0)
                    val dst: *byte = *byte(base)
                    var take = dlen - written
                    if take > seg_len
                        take = seg_len
                    if take < 0
                        take = 0
                    var jj = 0
                    while jj < take
                        dst[jj] = reply[data_off + written + jj]
                        jj += 1
                    written += take
            ii += 1

Write src_path into msg_name as a sockaddr_un (family +
NUL-terminated path). Update msg_namelen.

        if name_ptr != i64(0)
            val a: *byte = *byte(name_ptr)
            a[0] = byte(POSIX_AF_UNIX & 0xff)
            a[1] = byte(0)
            var pcopy = src_plen
            if pcopy > UNIX_PATH_MAX
                pcopy = UNIX_PATH_MAX
            var i = 0
            while i < pcopy
                a[2 + i] = reply[2 + i]
                i += 1
            if 2 + pcopy < 110
                a[2 + pcopy] = byte(0)
            shim_write_i32(mh, 8, 2 + src_plen)

Build SCM_RIGHTS cmsg in the user's control buffer if
fds were granted and the buffer is non-null.

        var ctrl_used = 0
        if n_new > 0
            if ctrl_ptr != i64(0)
                val cb: *byte = *byte(ctrl_ptr)
                val cmsg_len_v = SHIM_CMSG_HDR_LEN + n_new * 4
                if cmsg_len_v <= ctrl_len
                    var i = 0
                    while i < 8
                        cb[i] = byte((cmsg_len_v >> (i * 8)) & 0xff)
                        i += 1
                    shim_write_i32(cb, 8, SHIM_SOL_SOCKET)
                    shim_write_i32(cb, 12, SHIM_SCM_RIGHTS)
                    var fi = 0
                    while fi < n_new
                        shim_write_i32(cb, SHIM_CMSG_HDR_LEN + fi * 4, new_fds[fi])
                        fi += 1
                    ctrl_used = cmsg_len_v
        shim_write_i32(mh, 40, ctrl_used)
        shim_write_i32(mh, 48, 0)
        i64(written)

