OSKit UNIX server — SCM_RIGHTS sendmsg / recvmsg handlers
=========================================================

Same-module sibling of `unix.lsysl`. Owns the SENDMSG / RECVMSG
ABI, including the DGRAM (1-byte unix-slot ancillary) and STREAM
(4-byte typed-fd ancillary) variants. The flow is symmetric on
both ends — sender validates fd ownership and bumps queue/scm
counters, receiver drains them — so keeping all four paths in one
file makes the cmsg lifecycle easy to follow.

    module oskit.servers

    import oskit.ipc.{ipc_reply}


### SENDMSG handler (DGRAM + STREAM, SCM_RIGHTS)

Bundles an in-band message with up to `UNIX_SCM_MAX_FDS`
ancillary unix-socket fds. The caller passes a list of slot
indices it owns; the server validates ownership, increments
each slot's `nrefs_in_queues`, and queues the cmsg payload
on the destination so a future recvmsg can transfer
co-ownership.

DGRAM dispatch enqueues a `UnixDgram` slot on the target's
`dg_queue`, with the fds attached to that single message.

STREAM dispatch attaches the fds to the next byte the peer
will see — `pending_scm[s].byte_off = peer.rx_total_drained
+ peer.rx_count` is captured *before* `unix_rx_append`, so
the anchor is the position of the first byte appended by
this sendmsg. A future `recvmsg` whose drain crosses the
anchor receives the fds; a plain `recv` whose drain crosses
the anchor silently drops them (matching Linux).

Wire format mirrors SENDTO with a single ancillary block
slotted between the path and the payload:

  - DGRAM (legacy): `cmd(1) + fd(1) + plen(1) + path(P) +
    nfds(1) + slots(F) + dlen_be(2) + data(D)` — 1 byte per
    fd, encoding only the unix slot index. AF_UNIX-only.
  - STREAM (Phase 2B chunk 2): `cmd(1) + fd(1) + plen(1)=0 +
    nfds(1) + tuples(F*4) + dlen_be(2) + data(D)` — 4 bytes
    per fd, each tuple is `kind(1) + handle_be(2) + stype(1)`.
    plen is always 0 on STREAM (target is the connected peer;
    path is unused).

Allow-list (chunk 2): only `kind = POSIX_FD_UNIX_SOCKET (10)`
is accepted on the STREAM path; the receiver-shim's mint path
likewise only knows how to materialize a unix-socket fd. Other
kinds (TCP/UDP/file) are rejected at the sender shim with
-EOPNOTSUPP and never reach this server. Chunk 3 will lift the
allow-list once queued-ref machinery exists in the inet/vfs
backends to survive a sender that closes before the receiver
drains.

DGRAM SENDMSG enqueues onto the target's `dg_queue` (sized at
UNIX_DG_QUEUE) — full queues return -EAGAIN. STREAM SENDMSG
attaches the SCM to the peer's `pending_scm` (sized at
UNIX_STREAM_SCM_QUEUE) — full queues likewise return -EAGAIN
before any data is appended.

    unix_handle_sendmsg(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        if unix_fd_valid(fd, sender) == 0
            var err: [3]byte
            err[0] = byte(-UNIX_EBADF)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        if unix_sockets[fd].stype == UNIX_SOCK_STREAM
            unix_handle_sendmsg_stream(sender, fd, buf)
            return
        if unix_sockets[fd].stype != UNIX_SOCK_DGRAM
            var err: [3]byte
            err[0] = byte(-UNIX_EINVAL)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        val plen = int(buf[2]) & 0xff
        val nfds = int(buf[3 + plen]) & 0xff
        if nfds > UNIX_SCM_MAX_FDS
            var err: [3]byte
            err[0] = byte(-UNIX_EINVAL)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        val slots_off = 3 + plen + 1
        val dlen = unix_read_u16(buf, slots_off + nfds)
        val data: *byte = buf + slots_off + nfds + 2
        val target = unix_find_bound(buf + 3, plen)
        if target < 0
            var err: [3]byte
            err[0] = byte(-UNIX_ECONNREFUSED)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        if unix_sockets[target].stype != UNIX_SOCK_DGRAM
            var err: [3]byte
            err[0] = byte(-UNIX_ECONNREFUSED)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return

Validate every fd up front — if any is bogus, reject the
whole sendmsg without partial transfer. Each slot must be
in range, in_use, and in the sender's owners ring.

        var k = 0
        while k < nfds
            val sidx = int(buf[slots_off + k]) & 0xff
            if sidx < 0
                var err: [3]byte
                err[0] = byte(-UNIX_EINVAL)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return
            if sidx >= UNIX_MAX_SOCKETS
                var err: [3]byte
                err[0] = byte(-UNIX_EINVAL)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return
            if unix_sockets[sidx].in_use == 0
                var err: [3]byte
                err[0] = byte(-UNIX_EBADF)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return
            if unix_slot_has_owner(sidx, sender) == 0
                var err: [3]byte
                err[0] = byte(-UNIX_EBADF)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return
            k += 1

        // Connected-DGRAM filter: silently drop if target is
        // connected to someone other than this sender. Carried fds
        // remain owned by the sender (no nrefs_in_queues bump).
        val tpeer = unix_sockets[target].peer_idx
        if tpeer >= 0
            if tpeer != fd
                var dr: [3]byte
                dr[0] = 0
                var dl_drop = dlen
                if dl_drop > UNIX_DG_DATA_MAX
                    dl_drop = UNIX_DG_DATA_MAX
                unix_write_u16(&dr[0], 1, dl_drop)
                ipc_reply(sender, dr, 3)
                return

        if unix_sockets[target].dg_count >= UNIX_DG_QUEUE
            var err: [3]byte
            err[0] = byte(-UNIX_EAGAIN)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return

Enqueue the datagram, copy the fd slot indices into the
ancillary slot, and bump each transferred slot's queue-ref
counter so the underlying socket stays alive even if all
its current owners close before the receiver drains.

        val nsent = unix_dg_enqueue(target, fd, data, dlen)
        val q = (unix_sockets[target].dg_tail + UNIX_DG_QUEUE - 1) % UNIX_DG_QUEUE
        unix_sockets[target].dg_queue[q].nfds = nfds
        k = 0
        while k < nfds
            val sidx = int(buf[slots_off + k]) & 0xff
            unix_sockets[target].dg_queue[q].fds[k] = sidx
            unix_sockets[sidx].nrefs_in_queues += 1
            k += 1
        var sreply: [3]byte
        sreply[0] = 0
        unix_write_u16(&sreply[0], 1, nsent)
        ipc_reply(sender, sreply, 3)

If a thread is parked on recvfrom or recvmsg for `target`,
drain the head of queue (the entry we just enqueued) and
reply to it. The reply shape depends on the parker:
recvfrom drops the cmsg fds (queue-refs released by
`unix_dg_dequeue_reply`); recvmsg goes through the
recvmsg-drain helper which transfers fd ownership.

        val parked = unix_sockets[target].pending_recv_tid
        if parked >= 0
            val pmaxlen = unix_sockets[target].pending_recv_maxlen
            val pmsg = unix_sockets[target].pending_recv_is_msg
            val pmaxn = unix_sockets[target].pending_recv_max_nfds
            unix_sockets[target].pending_recv_tid = -1
            unix_sockets[target].pending_recv_is_msg = 0
            if pmsg != 0
                unix_dg_drain_for_msg(target, parked, pmaxn, pmaxlen)
            else
                var pr: [512]byte
                val n = unix_dg_dequeue_reply(target, pmaxlen, 0, &pr[0])
                ipc_reply(parked, &pr[0], n)


### SENDMSG handler — STREAM branch

Validates the sender's STREAM connection (peer present, not
shut for write, peer not closed), validates each cmsg fd's
ownership, reserves a `pending_scm` slot at the peer (if
`nfds > 0`), captures the anchor offset, then appends the
data to the peer's rx_buf and finalizes the SCM entry.

The anchor `byte_off = peer.rx_total_drained + peer.rx_count`
is captured *before* `unix_rx_append`, so it points at the
first byte this sendmsg will append. After append, any drain
that crosses the anchor delivers (recvmsg) or drops (recv)
the fds. If the rx_buf is full and `unix_rx_append` returns
0, the cmsg still gets queued at the would-be anchor — a
later send/sendmsg that successfully appends a byte at that
position will surface the cmsg via the next drain.

    unix_handle_sendmsg_stream(sender: int, fd: int, buf: *byte)
        val peer = unix_sockets[fd].peer_idx
        if peer < 0
            var err: [3]byte
            err[0] = byte(-UNIX_ENOTCONN)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        if unix_sockets[fd].peer_closed != 0
            var err: [3]byte
            err[0] = byte(-UNIX_EPIPE)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        if unix_sockets[fd].shut_wr != 0
            var err: [3]byte
            err[0] = byte(-UNIX_EPIPE)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        val plen = int(buf[2]) & 0xff
        val nfds = int(buf[3 + plen]) & 0xff
        if nfds > UNIX_SCM_MAX_FDS
            var err: [3]byte
            err[0] = byte(-UNIX_EINVAL)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        val tuples_off = 3 + plen + 1
        val dlen = unix_read_u16(buf, tuples_off + nfds * 4)
        val data: *byte = buf + tuples_off + nfds * 4 + 2

Validate every cmsg fd up front. Wire format per fd is the
4-byte tuple `kind(1) + handle_be(2) + stype(1)`. Phase 2B
chunk 3 accepts:

- `kind = POSIX_FD_UNIX_SOCKET (10)` — `handle` is the unix
  slot index; in-range / in_use / owned-by-sender are checked
  here.
- `kind = POSIX_FD_TCP_SOCKET  (5)` — `handle` is an inet TCP
  slot index. The sender shim has already incremented the
  inet slot's `queued_refs` via `INET_CMD_QUEUE_REF(+1)` and
  validated ownership; we accept the tuple at face value.
- `kind = POSIX_FD_UDP_SOCKET  (4)` — same as TCP for UDP slots.

Other kinds are rejected with `-EINVAL` (the shim allow-list
rejects them earlier, but defending here keeps us honest).

        var k = 0
        while k < nfds
            val tup_off = tuples_off + k * 4
            val kind = int(buf[tup_off]) & 0xff
            val handle_hi = int(buf[tup_off + 1]) & 0xff
            val handle_lo = int(buf[tup_off + 2]) & 0xff
            val handle = (handle_hi << 8) | handle_lo
            if kind == 10
                if handle < 0
                    var err: [3]byte
                    err[0] = byte(-UNIX_EINVAL)
                    err[1] = 0
                    err[2] = 0
                    ipc_reply(sender, err, 3)
                    return
                if handle >= UNIX_MAX_SOCKETS
                    var err: [3]byte
                    err[0] = byte(-UNIX_EINVAL)
                    err[1] = 0
                    err[2] = 0
                    ipc_reply(sender, err, 3)
                    return
                if unix_sockets[handle].in_use == 0
                    var err: [3]byte
                    err[0] = byte(-UNIX_EBADF)
                    err[1] = 0
                    err[2] = 0
                    ipc_reply(sender, err, 3)
                    return
                if unix_slot_has_owner(handle, sender) == 0
                    var err: [3]byte
                    err[0] = byte(-UNIX_EBADF)
                    err[1] = 0
                    err[2] = 0
                    ipc_reply(sender, err, 3)
                    return
            else if kind == 4 || kind == 5 || kind == 6
                // TCP/UDP/FILE: trust the shim's pre-validated handle
                // (TCP/UDP: inet slot idx; FILE: OFT idx — both already
                // ref-bumped at the source server). Range-check
                // defensively against the 2-byte wire field.
                if handle < 0
                    var err: [3]byte
                    err[0] = byte(-UNIX_EINVAL)
                    err[1] = 0
                    err[2] = 0
                    ipc_reply(sender, err, 3)
                    return
                if handle > 65535
                    var err: [3]byte
                    err[0] = byte(-UNIX_EINVAL)
                    err[1] = 0
                    err[2] = 0
                    ipc_reply(sender, err, 3)
                    return
            else
                var err: [3]byte
                err[0] = byte(-UNIX_EINVAL)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return
            k += 1

If we have cmsg fds, find a free pending_scm slot at peer
before doing anything visible. A full queue must reject the
whole sendmsg with -EAGAIN — partially appending data while
losing the cmsg would silently corrupt the stream's
ancillary anchoring.

        var scm_slot = -1
        if nfds > 0
            var s = 0
            while s < UNIX_STREAM_SCM_QUEUE
                if unix_sockets[peer].pending_scm[s].in_use == 0
                    scm_slot = s
                    s = UNIX_STREAM_SCM_QUEUE
                else
                    s += 1
            if scm_slot < 0
                var err: [3]byte
                err[0] = byte(-UNIX_EAGAIN)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return

Capture anchor *before* the append, then append. The
anchor points at the position of the first byte we'll
write — exactly Linux's "first byte of the corresponding
sendmsg" semantics.

        val drained_off = unix_sockets[peer].rx_total_drained
        val anchor = drained_off + unix_sockets[peer].rx_count
        val nsent = unix_rx_append(peer, data, dlen)
        if nfds > 0
            unix_sockets[peer].pending_scm[scm_slot].in_use = 1
            unix_sockets[peer].pending_scm[scm_slot].byte_off = anchor
            unix_sockets[peer].pending_scm[scm_slot].nfds = nfds
            var k2 = 0
            while k2 < nfds
                val tup_off = tuples_off + k2 * 4
                val kind = int(buf[tup_off]) & 0xff
                val handle_hi = int(buf[tup_off + 1]) & 0xff
                val handle_lo = int(buf[tup_off + 2]) & 0xff
                val handle = (handle_hi << 8) | handle_lo
                val stype = int(buf[tup_off + 3]) & 0xff
                unix_sockets[peer].pending_scm[scm_slot].fd_kinds[k2] = kind
                unix_sockets[peer].pending_scm[scm_slot].fd_handles[k2] = handle
                unix_sockets[peer].pending_scm[scm_slot].fd_stypes[k2] = stype
                if kind == 10
                    unix_sockets[handle].nrefs_in_queues += 1
                k2 += 1
        var sreply: [3]byte
        sreply[0] = 0
        unix_write_u16(&sreply[0], 1, nsent)
        ipc_reply(sender, sreply, 3)

If a thread is parked on recv/recvmsg at the peer, drain and
unblock. recvmsg gets the recvmsg-shaped reply (claims any
cmsg in the drained range); recv gets the recv-shaped reply
(drops cmsg in the drained range).

        val parked = unix_sockets[peer].pending_recv_tid
        if parked >= 0
            val pmaxlen = unix_sockets[peer].pending_recv_maxlen
            val pmsg = unix_sockets[peer].pending_recv_is_msg
            val pmaxn = unix_sockets[peer].pending_recv_max_nfds
            unix_sockets[peer].pending_recv_tid = -1
            unix_sockets[peer].pending_recv_is_msg = 0
            if pmsg != 0
                unix_stream_drain_for_msg(peer, parked, pmaxn, pmaxlen)
            else
                var pr: [2050]byte
                pr[0] = 0
                val n = unix_rx_drain(peer, &pr[3], pmaxlen, 0)
                val end_off = unix_sockets[peer].rx_total_drained
                var dummy: [1]byte
                unix_stream_scm_consume(peer, end_off, -1, 0,
                    &dummy[0], &dummy[0], &dummy[0])
                unix_write_u16(&pr[0], 1, n)
                ipc_reply(parked, &pr[0], 3 + n)


### RECVMSG handler (DGRAM, SCM_RIGHTS)

Drains one queued datagram. For each ancillary fd in the
entry, releases its queue-ref and grants co-ownership to
the recvmsg caller. If the receiver's `max_nfds` budget is
smaller than the queued count, excess fds are dropped (the
queue-ref is released, but no co-ownership granted — those
slots become orphaned candidates for free).

If the queue is empty, returns -EAGAIN. No parking — a
caller wanting blocking semantics should use `recvfrom`.
Recvmsg parking is deferred to a later session.

Wire reply: `status(1) + src_plen(1) + src_path(P) +
nfds(1) + slots(F) + dlen_be(2) + data(D)`.

Drain helper for the recvmsg-shaped reply. Used both by
`unix_handle_recvmsg`'s direct dequeue and by sendto /
sendmsg wakes when the parker is a recvmsg (not recvfrom).
Builds the reply, transfers fd ownership for `min(queued,
max_nfds)` slots, releases queue-refs for *all* slots, and
advances the head pointer.

    unix_dg_drain_for_msg(idx: int, receiver: int, max_nfds: int,
            maxlen: int)
        val slot = unix_sockets[idx].dg_head
        val sp = unix_sockets[idx].dg_queue[slot].src_path_len
        val queued_nfds = unix_sockets[idx].dg_queue[slot].nfds
        var grant = queued_nfds
        if grant > max_nfds
            grant = max_nfds
        var pr: [600]byte
        pr[0] = 0
        pr[1] = byte(sp & 0xff)
        var i = 0
        while i < sp
            pr[2 + i] = unix_sockets[idx].dg_queue[slot].src_path[i]
            i += 1
        pr[2 + sp] = byte(grant & 0xff)
        i = 0
        while i < grant
            val sidx = unix_sockets[idx].dg_queue[slot].fds[i]
            pr[2 + sp + 1 + i] = byte(sidx & 0xff)
            pr[2 + sp + 1 + grant + i] = byte(unix_sockets[sidx].stype & 0xff)
            i += 1
        var dl = unix_sockets[idx].dg_queue[slot].data_len
        if dl > maxlen
            dl = maxlen
        val dlen_off = 2 + sp + 1 + grant + grant
        unix_write_u16(&pr[0], dlen_off, dl)
        i = 0
        while i < dl
            pr[dlen_off + 2 + i] = unix_sockets[idx].dg_queue[slot].data[i]
            i += 1
        i = 0
        while i < queued_nfds
            val sidx = unix_sockets[idx].dg_queue[slot].fds[i]
            unix_sockets[sidx].nrefs_in_queues -= 1
            if i < grant
                unix_slot_add_owner(sidx, receiver)
            if unix_sockets[sidx].owners_count == 0
                if unix_sockets[sidx].nrefs_in_queues == 0
                    if unix_sockets[sidx].in_use != 0
                        unix_full_close(sidx)
            i += 1
        unix_sockets[idx].dg_queue[slot].in_use = 0
        unix_sockets[idx].dg_head = (slot + 1) % UNIX_DG_QUEUE
        unix_sockets[idx].dg_count -= 1
        unix_bump_fire_seq(idx)
        ipc_reply(receiver, &pr[0], dlen_off + 2 + dl)


    unix_handle_recvmsg(sender: int, buf: *byte, no_park: int)
        val fd = int(buf[1]) & 0xff
        if unix_fd_valid(fd, sender) == 0
            var err: [4]byte
            err[0] = byte(-UNIX_EBADF)
            err[1] = 0
            err[2] = 0
            err[3] = 0
            ipc_reply(sender, err, 4)
            return
        val max_nfds_raw = int(buf[2]) & 0xff
        var max_nfds = max_nfds_raw
        if max_nfds > UNIX_SCM_MAX_FDS
            max_nfds = UNIX_SCM_MAX_FDS
        val maxlen = unix_read_u16(buf, 3)
        if unix_sockets[fd].stype == UNIX_SOCK_STREAM
            unix_handle_recvmsg_stream(sender, fd, max_nfds, maxlen, no_park)
            return
        if unix_sockets[fd].stype != UNIX_SOCK_DGRAM
            var err: [4]byte
            err[0] = byte(-UNIX_EINVAL)
            err[1] = 0
            err[2] = 0
            err[3] = 0
            ipc_reply(sender, err, 4)
            return
        // Connected-DGRAM filter (POSIX/Linux): drop pre-connect
        // non-peer dgrams from the head before serving recvmsg.
        unix_dg_drop_nonpeer_head(fd)
        if unix_sockets[fd].dg_count > 0
            unix_dg_drain_for_msg(fd, sender, max_nfds, maxlen)
            return
        if no_park != 0
            var err: [4]byte
            err[0] = byte(-UNIX_EAGAIN)
            err[1] = 0
            err[2] = 0
            err[3] = 0
            ipc_reply(sender, err, 4)
            return
        unix_sockets[fd].pending_recv_tid = sender
        unix_sockets[fd].pending_recv_maxlen = maxlen
        unix_sockets[fd].pending_recv_peek = 0
        unix_sockets[fd].pending_recv_is_msg = 1
        unix_sockets[fd].pending_recv_max_nfds = max_nfds


### RECVMSG handler — STREAM branch

Mirrors `unix_handle_recv` for the EOF/empty/park triage:

- `shut_rd` set: clean EOF (status=0, plen=0, nfds=0, dlen=0).
- `rx_count > 0`: drain via `unix_stream_drain_for_msg`,
  which reads bytes and claims any pending_scm whose anchor
  fell in the drained range.
- Empty + peer gone (peer_idx<0 / peer_closed / peer.shut_wr):
  clean EOF reply, no cmsg.
- Empty + peer alive + `no_park`: -EAGAIN.
- Otherwise park (set `pending_recv_is_msg=1`); a future
  SEND/SENDMSG at the peer will wake via the parker dispatch
  in those handlers, which routes to `unix_stream_drain_for_msg`.

The empty-EOF reply shape matches a successful zero-byte
recvmsg: `status(0) + plen(0) + nfds(0) + dlen_be(0)` = 5
bytes. The shim treats this as a clean stream end.

    unix_handle_recvmsg_stream(sender: int, fd: int, max_nfds: int,
            maxlen: int, no_park: int)
        if unix_sockets[fd].shut_rd != 0
            var pr: [5]byte
            pr[0] = 0
            pr[1] = 0
            pr[2] = 0
            pr[3] = 0
            pr[4] = 0
            ipc_reply(sender, pr, 5)
            return
        if unix_sockets[fd].rx_count > 0
            unix_stream_drain_for_msg(fd, sender, max_nfds, maxlen)
            return
        if unix_sockets[fd].peer_idx < 0
            var pr: [5]byte
            pr[0] = 0
            pr[1] = 0
            pr[2] = 0
            pr[3] = 0
            pr[4] = 0
            ipc_reply(sender, pr, 5)
            return
        if unix_sockets[fd].peer_closed != 0
            var pr: [5]byte
            pr[0] = 0
            pr[1] = 0
            pr[2] = 0
            pr[3] = 0
            pr[4] = 0
            ipc_reply(sender, pr, 5)
            return
        val peer_for_eof = unix_sockets[fd].peer_idx
        if unix_sockets[peer_for_eof].shut_wr != 0
            var pr: [5]byte
            pr[0] = 0
            pr[1] = 0
            pr[2] = 0
            pr[3] = 0
            pr[4] = 0
            ipc_reply(sender, pr, 5)
            return
        if no_park != 0
            var err: [4]byte
            err[0] = byte(-UNIX_EAGAIN)
            err[1] = 0
            err[2] = 0
            err[3] = 0
            ipc_reply(sender, err, 4)
            return
        unix_sockets[fd].pending_recv_tid = sender
        unix_sockets[fd].pending_recv_maxlen = maxlen
        unix_sockets[fd].pending_recv_peek = 0
        unix_sockets[fd].pending_recv_is_msg = 1
        unix_sockets[fd].pending_recv_max_nfds = max_nfds
