OSKit RS — Restart Server (userspace)
======================================

Minix 3-style service manager. Runs as the first userspace
process — the kernel loads RS from a boot module, then RS
loads all other servers and init.

RS reads its configuration from an info page at 0xBF000
written by the kernel before RS starts:
  +0:  RS TID (unused — RS sets its own)
  +8:  ramdisk base physical address (i64)
  +16: ramdisk size (i64)
  +24: boot info header copy (SLIX magic + module entries)

Boot module data lives in physical memory. RS uses
svc_phys_read to copy it into its own address space.

Boot order:
1. Disk server (no dependencies)
2. TFS server (depends on disk)
3. TTY server (no dependencies, but after disk)
4. PM server (no dependencies)
5. VFS server (depends on TFS)
6. Init (depends on VFS)

Each server calls `rs_ready()` after initialization to notify
the RS thread. RS blocks until the notification arrives, then
starts the next server.

    module oskit.servers

    import oskit.services.{thread_id, putc, putstr, notify_send_to, notify_read_self, rs_set_tid, svc_vm_create_server_pt, svc_vm_copy_to, svc_create_proc_susp, svc_resume_proc, svc_phys_read}
    import oskit.ipc.{ipc_recv_notify, port_create}
    import oskit.hal.memset

Ramdisk info, read from info page at startup.

    var rs_ramdisk_base = 0
    var rs_ramdisk_size = 0

Boot info, copied from info page at startup.
Max 256 bytes covers header + plenty of module entries.

    var rs_boot_info: [256]byte
    var rs_boot_info_len = 0

Module loading buffer (128 KB). Boot module TRB/ELF data
is copied here via svc_phys_read before parsing.

    var rs_mod_buf: [131072]byte

Boot message helpers. putc goes straight to MMIO, no TTY needed.

    rs_print(s: string)
        val p = *byte(s)
        val n = len(s)
        var i = 0
        while i < n
            putc(p[i])
            i += 1

Wait for a server to signal ready. RS creates a dummy port
so it can use ipc_recv_notify to block for notifications.

    var rs_port = -1

    rs_wait_ready()
        if rs_port < 0
            rs_port = port_create()
        // Block until notification arrives (result == -2)
        var buf: [1]byte
        val result = ipc_recv_notify(rs_port, &buf[0], 1)
        // result == -2 means notification received
        notify_read_self()

Hardcoded boot order. Each entry has a name and length.

    val RS_NUM_SERVERS = 5

    var rs_boot_names: [48]byte   // 6 entries * 8 bytes each
    var rs_boot_nlen: [6]int

    rs_init_boot_order()
        // disk
        rs_boot_names[0] = 'd'; rs_boot_names[1] = 'i'; rs_boot_names[2] = 's'; rs_boot_names[3] = 'k'; rs_boot_names[4] = 0
        rs_boot_nlen[0] = 4
        // tfs
        rs_boot_names[8] = 't'; rs_boot_names[9] = 'f'; rs_boot_names[10] = 's'; rs_boot_names[11] = 0
        rs_boot_nlen[1] = 3
        // tty
        rs_boot_names[16] = 't'; rs_boot_names[17] = 't'; rs_boot_names[18] = 'y'; rs_boot_names[19] = 0
        rs_boot_nlen[2] = 3
        // pm
        rs_boot_names[24] = 'p'; rs_boot_names[25] = 'm'; rs_boot_names[26] = 0
        rs_boot_nlen[3] = 2
        // vfs
        rs_boot_names[32] = 'v'; rs_boot_names[33] = 'f'; rs_boot_names[34] = 's'; rs_boot_names[35] = 0
        rs_boot_nlen[4] = 3
        // init
        rs_boot_names[40] = 'i'; rs_boot_names[41] = 'n'; rs_boot_names[42] = 'i'; rs_boot_names[43] = 't'; rs_boot_names[44] = 0
        rs_boot_nlen[5] = 4

Boot info parsing. RS reads a copy of the boot info header
from its info page at 0xBF000+24.

    rs_read_u32_le(p: *byte) -> i64
        i64(p[0] & 0xff) | (i64(p[1] & 0xff) << 8) | (i64(p[2] & 0xff) << 16) | (i64(p[3] & 0xff) << 24)

    rs_read_i64_le(p: *byte) -> i64
        rs_read_u32_le(p) | (rs_read_u32_le(p + 4) << 32)

Check if boot info header is valid (magic = "SLIX").

    rs_boot_info_valid() -> bool
        val p = &rs_boot_info[0]
        if p[0] != byte('S')
            return false
        if p[1] != byte('L')
            return false
        if p[2] != byte('I')
            return false
        if p[3] != byte('X')
            return false
        true

Get boot module count from boot info header.

    rs_boot_module_count() -> int
        val p = &rs_boot_info[4]
        int(rs_read_u32_le(p))

Find a boot module by name. Returns index or -1.

    rs_find_boot_module(name: *byte, nlen: int) -> int
        val count = rs_boot_module_count()
        var i = 0
        while i < count
            val entry = &rs_boot_info[8 + i * 24]
            // Compare name (first nlen bytes, NUL-padded)
            var found = true
            var j = 0
            while j < nlen
                if j >= 8
                    break
                if entry[j] != name[j]
                    found = false
                    break
                j += 1
            if found
                // Check rest is NUL or end of name
                if nlen < 8
                    if entry[nlen] != 0
                        found = false
                if found
                    return i
            i += 1
        -1

Get a boot module's physical address and size.

    rs_boot_module_addr(idx: int) -> i64
        rs_read_i64_le(&rs_boot_info[8 + idx * 24 + 8])

    rs_boot_module_size(idx: int) -> int
        int(rs_read_i64_le(&rs_boot_info[8 + idx * 24 + 16]))

Load a TRB v1 boot module into a process address space.
Parses the TRB header from rs_mod_buf (already copied via
svc_phys_read), copies PROGBITS segments into the target
process via vm_copy_to, and zeroes NOBITS (BSS) segments.
Returns entry point or -1 on error.

    val RS_PROG_USP = 0xD0000
    val RS_PROG_SSP = 0xCF000

    rs_load_trb_module(buf: *byte, buflen: int, ptbr: int) -> i64
        if buflen < 12
            return -1
        if buf[0] != byte('T')
            return -1
        if buf[1] != byte('R')
            return -1
        if buf[2] != byte('B')
            return -1
        if buf[3] != byte(1)
            return -1

        val entry = rs_read_u32_le(buf + 4)
        val nrec = int(rs_read_u32_le(buf + 8))
        var pos = 12
        var ri = 0
        while ri < nrec
            if pos + 12 > buflen
                return -1
            val hp = buf + pos
            val org = int(rs_read_u32_le(hp))
            val kind = int(rs_read_u32_le(hp + 4))
            val sz = int(rs_read_u32_le(hp + 8))
            pos += 12
            if kind == 0
                // PROGBITS — copy from boot module to process address space
                if pos + sz > buflen
                    return -1
                svc_vm_copy_to(ptbr, org, buf + pos, sz)
                pos += sz
            else if kind == 1
                // NOBITS (BSS) — zero fill in process address space
                rs_zero_fill_remote(ptbr, org, sz)
            else
                return -1
            ri += 1
        entry

Load an ELF64 boot module into a process address space.
Parses program headers from rs_mod_buf, copies LOAD segments
into the target process via vm_copy_to. Returns entry point
or -1 on error.

    rs_load_elf64_module(buf: *byte, buflen: int, ptbr: int) -> i64
        if buflen < 64
            return -1
        // Check ELF magic
        if buf[0] != 0x7F
            return -1
        if buf[1] != byte('E')
            return -1
        if buf[2] != byte('L')
            return -1
        if buf[3] != byte('F')
            return -1

        val entry = rs_read_i64_le(buf + 24)
        val phoff = int(rs_read_i64_le(buf + 32))
        val phentsize = int(rs_read_u32_le(buf + 54) & 0xFFFF)
        val phnum = int(rs_read_u32_le(buf + 56) & 0xFFFF)

        var i = 0
        while i < phnum
            val ph = buf + phoff + i * phentsize
            val ptype = int(rs_read_u32_le(ph))
            if ptype == 1
                // PT_LOAD
                val offset = int(rs_read_i64_le(ph + 8))
                val vaddr = int(rs_read_i64_le(ph + 16))
                val filesz = int(rs_read_i64_le(ph + 32))
                val memsz = int(rs_read_i64_le(ph + 40))
                if offset + filesz > buflen
                    return -1
                if filesz > 0
                    svc_vm_copy_to(ptbr, vaddr, buf + offset, filesz)
                if memsz > filesz
                    rs_zero_fill_remote(ptbr, vaddr + filesz, memsz - filesz)
            i += 1
        entry

Zero-fill a region in another process's address space.
Uses a local zero buffer and vm_copy_to in chunks.

    rs_zero_fill_remote(ptbr: int, addr: int, sz: int)
        val CHUNK = 1024
        var zero_buf: [1024]byte
        memset(&zero_buf[0], 0, CHUNK)
        var remaining = sz
        var dst = addr
        while remaining > 0
            var chunk = remaining
            if chunk > CHUNK
                chunk = CHUNK
            svc_vm_copy_to(ptbr, dst, &zero_buf[0], chunk)
            remaining -= chunk
            dst += chunk

Start a server from a boot module: create server page table,
copy module data via svc_phys_read, load TRB/ELF binary,
create process, resume it.
io_page = MMIO page to grant (e.g. 0x800 for ramdisk).
Returns 1 on success, 0 on failure.

    rs_start_from_module(mod_idx: int, name: *byte, nlen: int, io_page: int) -> int
        val addr = rs_boot_module_addr(mod_idx)
        val sz = rs_boot_module_size(mod_idx)

        // Copy boot module data from physical memory into our buffer
        if sz > 131072
            return 0
        svc_phys_read(int(addr), &rs_mod_buf[0], sz)
        val buf = &rs_mod_buf[0]

        // Create server page table with MMIO grant
        val ptbr = svc_vm_create_server_pt(io_page)
        if ptbr == 0
            return 0

        // Detect format and load binary into process address space
        var entry: i64 = -1
        if buf[0] == 0x7F
            if buf[1] == byte('E')
                // ELF64 format (x86_64)
                entry = rs_load_elf64_module(buf, sz, ptbr)
        if entry < 0
            // Try TRB format (TRISC)
            entry = rs_load_trb_module(buf, sz, ptbr)
        if entry < 0
            return 0

        // Create process suspended — no PTBR switch needed;
        // create_process_suspended uses vm_copy_to for the stack frame
        val sname = string(name, nlen)
        val pid = svc_create_proc_susp(entry, RS_PROG_USP, RS_PROG_SSP, sname, ptbr)
        if pid < 0
            return 0

        // Write RS info page at 0xBF000:
        //   +0: RS TID (i64)
        //   +8: ramdisk base (i64) — used by disk server
        //  +16: ramdisk size (i64) — used by disk server
        var info_buf: [24]byte
        var ip: *i64 = *i64(&info_buf[0])
        ip[0] = i64(thread_id())
        ip[1] = i64(rs_ramdisk_base)
        ip[2] = i64(rs_ramdisk_size)
        svc_vm_copy_to(ptbr, 0xBF000, &info_buf[0], 24)

        // Resume the process
        svc_resume_proc(pid)
        1

RS monitoring loop. Blocks on the notification port waiting
for server crash notifications. When a notification arrives,
RS logs it. Full crash recovery (restart from boot module)
is future work.

    rs_monitor()
        while true
            var buf: [1]byte
            ipc_recv_notify(rs_port, &buf[0], 1)
            notify_read_self()

The RS main function. Runs as the first userspace process.
Reads config from info page at 0xBF000, then starts all
servers from boot modules in order with synchronous handshake.
After boot, RS stays alive in a monitoring loop.

    val IO_PAGE_DEVICES = 0x800

    rs_main()
        rs_set_tid(thread_id())

        // Read info page at 0xBF000
        val info = *i64(0xBF000)
        rs_ramdisk_base = int(info[1])
        rs_ramdisk_size = int(info[2])

        // Copy boot info header from info page (+24)
        val bi_src = *byte(0xBF018)
        // Read module count to determine copy size
        val mod_count = int(rs_read_u32_le(bi_src + 4))
        rs_boot_info_len = 8 + mod_count * 24
        if rs_boot_info_len > 256
            rs_boot_info_len = 256
        var ci = 0
        while ci < rs_boot_info_len
            rs_boot_info[ci] = bi_src[ci]
            ci += 1

        rs_init_boot_order()

        rs_print("SLIX v0.0.1\nStarting servers:\n")

        if !rs_boot_info_valid()
            rs_print("ERROR: invalid boot info\n")
            return

        // Start the 5 servers + init from boot modules
        // Servers that need MMIO get IO_PAGE_DEVICES; others get 0
        var i = 0
        while i <= RS_NUM_SERVERS
            val name = &rs_boot_names[i * 8]
            val nlen = rs_boot_nlen[i]
            rs_print("  ")
            rs_print(string(name, nlen))

            val mod_idx = rs_find_boot_module(name, nlen)
            if mod_idx < 0
                rs_print(" MISSING\n")
                return

            // pm, vfs, init don't need MMIO
            var io_page = IO_PAGE_DEVICES
            if i >= 3
                io_page = 0
            if rs_start_from_module(mod_idx, name, nlen, io_page) != 1
                rs_print(" FAILED\n")
                return

            rs_print(" [mod]")
            rs_wait_ready()
            rs_print(" ok\n")
            i += 1

        // RS stays alive — monitoring loop
        rs_print("RS monitoring\n")
        rs_monitor()
