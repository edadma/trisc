    const INET_CMD_QUEUE_REF           = 59
    const INET_CMD_TCP_OOO_SELFTEST = 99


Sub-ops for INET_CMD_ARP_PROBE. A single command code fans out
into three operations so RFC 5227 conflict detection can be
driven from userspace:

- `START` arms the probe state with a target IP.
- `SEND` transmits one ARP probe (sender IP = 0.0.0.0).
- `CHECK` returns whether any defending ARP was observed and
  clears the probe state.

    val ARP_PROBE_OP_START    = 0
    val ARP_PROBE_OP_SEND     = 1
    val ARP_PROBE_OP_CHECK    = 2
    val ARP_PROBE_OP_ANNOUNCE = 3


Capacity limits.

    val INET_MAX_SOCKETS = 32
    val INET_MAX_QUEUE   = 2
    val INET_MAX_DATA    = 1472
    val INET_MSG_BUF     = 1500  // cmd(1)+fd(1)+hdr(9)+maxlen(2)+data(1472)+slop


Frame buffer pool (Phase 3 chunk 1) — storage + helpers live in
`inet_proto.lsysl` (cross-file VAR access fails the sysl analyzer
per `feedback_sysl_cross_unit.md`, so the pool follows the same
"every helper sits with the var it touches" rule used by
`inet_count_*_owner`). Forward calls from this file into
`inet_frame_alloc` / `inet_frame_release` / `inet_frame_buf`
work fine — sysl resolves them on the second pass.


A queued datagram awaiting recvfrom. Source address is stored
host-order to simplify comparisons. Sized to the full Ethernet
MTU (1500 - 20 IP - 8 UDP = 1472) so DNS/EDNS(0), QUIC, and
real-world UDP traffic fit without truncation.

    struct InetDgram
        src_ip: u32
        src_port: int
        data: [1472]byte
        data_len: int


Per-socket state. `bound_port == 0` means unbound (port 0 is
reserved for auto-bind, which isn't implemented yet). Queue
depth dropped from 4 → 2 when InetDgram payload jumped from 512
→ 1472 bytes; keeps the inet server binary inside the rs module
buffer cap. Two slots is plenty of burst absorption for normal
traffic.

    struct InetSocket
        in_use: int
        owners: [4]int
        owners_count: int
        // Phase 2B chunk 3: in-flight SCM_RIGHTS references. Bumped
        // by the sender shim before SENDMSG; dropped by the receiver
        // shim after the cmsg drains, or by the UNIX_CMD_CLOSE reply
        // path when a recv-side socket closes with un-drained pending
        // SCM tuples. Slot teardown is gated on
        // `owners_count + queued_refs == 0`.
        queued_refs: int
        bound: int
        bound_ip: u32
        bound_port: int
        queue: [2]InetDgram
        q_head: int
        q_tail: int
        q_count: int
        pending_tid: int
        pending_maxlen: int
        pending_peek: int
        recv_deadline: int
        pending_error: int
        // Phase 3 chunk 2: forward link in the UDP-port hash bucket
        // for `bound_port`. -1 = not in any bucket. Maintained by
        // `inet_udp_hash_insert` / `inet_udp_hash_remove` whenever a
        // socket transitions in/out of the bound state.
        next_in_udp_bucket: int

    var inet_sockets: [32]InetSocket
    var inet_port = -1



RFC 5227 ARP probe state. `arp_probe_target` is the IPv4
address currently being probed (0 = no probe active).
`arp_probe_seen` is set by the ARP RX path when any ARP
request OR reply arrives whose sender IP matches
`arp_probe_target` and whose sender MAC is not our own (NIC
loopback guard per §2.1.1). The dhclient-side probe loop
clears both fields via the CHECK op when the probe window
ends.

    var arp_probe_target: u32 = u32(0)
    var arp_probe_seen:   int = 0


Returns 1 if `frame` is an ARP packet whose sender IP matches
the probe target AND whose sender MAC is not our own. Returns
0 otherwise (including when no probe is active, when the
target doesn't match, or when the frame came from our own MAC
via NIC loopback). Used by the ARP RX path to flag defenders.

    inet_arp_probe_matches(frame: *byte) -> int
        if arp_probe_target == u32(0)
            return 0
        val sender_ip = ipv4(
            int(frame[14 + 14]) & 0xff,
            int(frame[14 + 15]) & 0xff,
            int(frame[14 + 16]) & 0xff,
            int(frame[14 + 17]) & 0xff)
        if sender_ip != arp_probe_target
            return 0
        // Sender MAC lives at frame+14+8..13 (ARP SHA field).
        // Compare against our own MAC to filter out NIC loopback.
        var i = 0
        var same = 1
        while i < 6
            if frame[14 + 8 + i] != inet_our_mac[i]
                same = 0
            i += 1
        if same != 0
            return 0
        1


### Byte-buffer helpers

Read / write the big-endian u16s used in the wire protocol. No
alignment assumptions — pointers come from IPC buffers.

    inet_read_u16(p: *byte, off: int) -> int
        ((int(p[off]) & 0xff) << 8) | (int(p[off + 1]) & 0xff)

    inet_write_u16(p: *byte, off: int, v: int)
        p[off]     = byte((v >> 8) & 0xff)
        p[off + 1] = byte(v & 0xff)

    inet_read_ipv4(p: *byte, off: int) -> u32
        ipv4(int(p[off]), int(p[off + 1]), int(p[off + 2]), int(p[off + 3]))

    inet_write_ipv4(p: *byte, off: int, ip: u32)
        p[off]     = byte(ipv4_octet(ip, 0))
        p[off + 1] = byte(ipv4_octet(ip, 1))
        p[off + 2] = byte(ipv4_octet(ip, 2))
        p[off + 3] = byte(ipv4_octet(ip, 3))


Initialize the socket table once. Called from the server main
loop before `port_register` so sockets are consistent before any
client can reach us.

    inet_init_sockets()
        var i = 0
        while i < INET_MAX_SOCKETS
            inet_sockets[i].in_use = 0
            inet_sockets[i].pending_tid = -1
            inet_sockets[i].pending_peek = 0
            inet_sockets[i].recv_deadline = 0
            inet_sockets[i].pending_error = 0
            inet_sockets[i].next_in_udp_bucket = -1
            inet_sockets[i].queued_refs = 0
            i += 1
        inet_udp_hash_init()
        // Note: `inet_udp_fire_seq` (in inet_proto.lsysl) is left at
        // its default-zeroed state. The shim re-syncs `last_seen_seq`
        // on every EPOLL_CTL_ADD anyway, so a recycled slot's stale
        // counter is harmless — first scan treats it as the live
        // baseline.


### Locate a bound socket

Hash-bucket walk on `port`. Phase 3 chunk 2 — replaces the prior
linear scan over all 32 slots. Average bucket length is ~2 at
INET_MAX_SOCKETS=32 / INET_UDP_HASH_N=16; worst case (all 32 sockets
collide to one bucket) is still O(N) but only ever realized by
bind-by-port-mod-16 patterns the tests don't exercise.

    inet_find_bound(ip: u32, port: int) -> int
        var i = inet_udp_port_hash[inet_udp_bucket(port)]
        while i >= 0
            if inet_sockets[i].in_use != 0
                if inet_sockets[i].bound != 0
                    if inet_sockets[i].bound_port == port
                        val bi = inet_sockets[i].bound_ip
                        if bi == INADDR_ANY
                            return i
                        if bi == ip
                            return i
            i = inet_sockets[i].next_in_udp_bucket
        -1


### Allocate an ephemeral source port

Linear scan from 49152 upward (RFC 6335 suggested range), returning
the first port no existing socket is bound to. Returns -1 if the
entire range is occupied — won't happen in practice with 32 sockets
but the guard keeps the loop bounded.

    inet_alloc_ephemeral_port() -> int
        var port = 49152
        while port < 65536
            if inet_find_bound_port(port) < 0
                return port
            port += 1
        -1


### Locate any socket bound to `port`

Port-only variant for UDP RX dispatch. The guest has a single unicast
IPv4 address plus `INADDR_ANY`, so IP matching on inbound packets
would just restate what's already true (the nic delivered the frame
to our MAC). Returning the first port match keeps the RX path simple
and matches how typical single-homed stacks behave.

    inet_find_bound_port(port: int) -> int
        var i = inet_udp_port_hash[inet_udp_bucket(port)]
        while i >= 0
            if inet_sockets[i].in_use != 0
                if inet_sockets[i].bound != 0
                    if inet_sockets[i].bound_port == port
                        return i
            i = inet_sockets[i].next_in_udp_bucket
        -1


### Enqueue an incoming datagram

Returns 1 on success, 0 if the queue is full (caller drops the
packet per UDP semantics).

    inet_enqueue(fd: int, src_ip: u32, src_port: int, data: *byte, dlen: int) -> int
        if inet_sockets[fd].q_count >= INET_MAX_QUEUE
            return 0
        val slot = inet_sockets[fd].q_tail
        inet_sockets[fd].queue[slot].src_ip = src_ip
        inet_sockets[fd].queue[slot].src_port = src_port
        var copy_len = dlen
        if copy_len > INET_MAX_DATA
            copy_len = INET_MAX_DATA
        var i = 0
        while i < copy_len
            inet_sockets[fd].queue[slot].data[i] = data[i]
            i += 1
        inet_sockets[fd].queue[slot].data_len = copy_len
        inet_sockets[fd].q_tail = (slot + 1) % INET_MAX_QUEUE
        inet_sockets[fd].q_count += 1
        inet_epoll_fire(1, fd)
        1


### Deliver a datagram directly to a socket's pending recvfrom

Used by both the loopback sendto path and the UDP RX path. Assumes
`inet_sockets[fd].pending_tid >= 0`. Clears the waiter slot, builds
the recvfrom reply (same shape as `inet_deliver_head` produces), and
replies via IPC.

When the parked recv was a peek (`pending_peek != 0`), the dgram is
also enqueued so a follow-up non-peek recv sees the same bytes. If
the queue is full we fall back to a direct delivery — the peek loses
its "leave-it-queued" guarantee, but UDP is lossy by definition and
this corner only fires when an app is already over the per-socket
queue cap.

    inet_deliver_to_waiter(fd: int, src_ip: u32, src_port: int, data: *byte, dlen: int)
        val waiter = inet_sockets[fd].pending_tid
        val mlen = inet_sockets[fd].pending_maxlen
        val peek = inet_sockets[fd].pending_peek
        inet_sockets[fd].pending_tid = -1
        inet_sockets[fd].pending_peek = 0
        inet_sockets[fd].recv_deadline = 0
        if peek != 0
            inet_enqueue(fd, src_ip, src_port, data, dlen)
        val widx = inet_frame_alloc()
        val wr = inet_frame_buf(widx)
        var deliver_len = dlen
        if deliver_len > mlen
            deliver_len = mlen
        wr[0] = 0
        wr[1] = byte(AF_INET & 0xff)
        inet_write_u16(wr, 2, src_port)
        inet_write_ipv4(wr, 4, src_ip)
        inet_write_u16(wr, 8, deliver_len)
        var i = 0
        while i < deliver_len
            wr[10 + i] = data[i]
            i += 1
        ipc_reply(waiter, wr, 10 + deliver_len)
        inet_frame_release(widx)


### Deliver one queued datagram to a pending recvfrom

Writes the recvfrom reply into `reply` and returns its length.
Only called when we know there's both a queued dgram and a
waiter. `maxlen` caps how many payload bytes we hand back.

When `peek != 0` (POSIX MSG_PEEK), the head dgram is left in the
queue — `q_head` and `q_count` are not updated. A follow-up recv
without MSG_PEEK then dequeues the same bytes.

    inet_deliver_head(fd: int, maxlen: int, reply: *byte, peek: int) -> int
        val slot = inet_sockets[fd].q_head
        val src_ip = inet_sockets[fd].queue[slot].src_ip
        val src_port = inet_sockets[fd].queue[slot].src_port
        var dlen = inet_sockets[fd].queue[slot].data_len
        if dlen > maxlen
            dlen = maxlen
        reply[0] = 0
        reply[1] = byte(AF_INET & 0xff)
        inet_write_u16(reply, 2, src_port)
        inet_write_ipv4(reply, 4, src_ip)
        inet_write_u16(reply, 8, dlen)
        var i = 0
        while i < dlen
            reply[10 + i] = inet_sockets[fd].queue[slot].data[i]
            i += 1
        if peek == 0
            inet_sockets[fd].q_head = (slot + 1) % INET_MAX_QUEUE
            inet_sockets[fd].q_count -= 1
        10 + dlen


### SOCKET handler

    inet_handle_socket(sender: int, buf: *byte)
        val family = int(buf[1]) & 0xff
        val stype  = int(buf[2]) & 0xff
        if family != AF_INET
            var err: [2]byte
            err[0] = byte(-1)
            err[1] = 0
            ipc_reply(sender, err, 2)
            return
        if stype != SOCK_DGRAM
            var err: [2]byte
            err[0] = byte(-1)
            err[1] = 0
            ipc_reply(sender, err, 2)
            return
        // Phase 2 net-stack quality plan: per-tid cap on UDP
        // slots.  Literal 8 — duplicated in `begin_connect` /
        // `begin_listen` (inet_proto.lsysl) for the TCP pool.
        // Sysl analyzer bug #19 (cross-file val + cross-file fn
        // refs both break analysis) is what forces the per-pool
        // split; a true combined cap would need a fix to the
        // analyzer.
        if inet_count_udp_owner(sender) >= 8
            var err: [2]byte
            err[0] = byte(-1)
            err[1] = 0
            ipc_reply(sender, err, 2)
            return
        var idx = -1
        var i = 0
        while i < INET_MAX_SOCKETS
            if inet_sockets[i].in_use == 0
                idx = i
                i = INET_MAX_SOCKETS
            else
                i += 1
        if idx < 0
            var err: [2]byte
            err[0] = byte(-1)
            err[1] = 0
            ipc_reply(sender, err, 2)
            return
        inet_sockets[idx].in_use = 1
        inet_udp_owners_set(idx, sender)
        inet_sockets[idx].queued_refs = 0
        inet_sockets[idx].bound = 0
        inet_sockets[idx].bound_ip = INADDR_ANY
        inet_sockets[idx].bound_port = 0
        inet_sockets[idx].q_head = 0
        inet_sockets[idx].q_tail = 0
        inet_sockets[idx].q_count = 0
        inet_sockets[idx].pending_tid = -1
        inet_sockets[idx].pending_peek = 0
        inet_sockets[idx].recv_deadline = 0
        inet_sockets[idx].pending_error = 0
        inet_sockets[idx].next_in_udp_bucket = -1
        // No need to reset inet_udp_fire_seq[idx] — see
        // `inet_init_sockets` for why a stale counter is harmless.
        var reply: [2]byte
        reply[0] = 0
        reply[1] = byte(idx & 0xff)
        ipc_reply(sender, reply, 2)


Validate an fd belongs to `sender`. Rejects out-of-range fds,
free slots, and slots whose owners ring doesn't include `sender`
— the latter is the ownership check that prevents process A from
issuing IPC with process B's inet fd (A would need to guess the
fd number today, but the guard makes the surface explicit
regardless). Multi-owner-aware: any tid in the slot's owners ring
passes (added in Phase 2A of the SCM_RIGHTS work). Returns 1 if
OK, 0 otherwise. Call sites pass the IPC `sender` argument.

    inet_fd_valid(fd: int, sender: int) -> int
        if fd < 0
            return 0
        if fd >= INET_MAX_SOCKETS
            return 0
        if inet_sockets[fd].in_use == 0
            return 0
        if inet_udp_owners_has(fd, sender) == 0
            return 0
        1


### BIND handler

    inet_handle_bind(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        if inet_fd_valid(fd, sender) == 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val family = int(buf[2]) & 0xff
        if family != AF_INET
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val req_port = inet_read_u16(buf, 3)
        val ip = inet_read_ipv4(buf, 5)
        if ip != INADDR_ANY
            if ip != INADDR_LOOPBACK
                var err: [1]byte
                err[0] = byte(-1)
                ipc_reply(sender, err, 1)
                return
        // Port 0 → "any free port". POSIX bind(2) gives the kernel
        // an ephemeral port from the local range; required by musl's
        // DNS resolver, which always passes sin_port = 0 on its
        // outbound UDP socket.
        var port = req_port
        if port == 0
            val eph = inet_alloc_ephemeral_port()
            if eph < 0
                var err: [1]byte
                err[0] = byte(-1)
                ipc_reply(sender, err, 1)
                return
            port = eph
        if inet_find_bound(ip, port) >= 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        inet_sockets[fd].bound = 1
        inet_sockets[fd].bound_ip = ip
        inet_sockets[fd].bound_port = port
        inet_udp_hash_insert(fd)
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, reply, 1)


### SENDTO handler

Loopback (`INADDR_LOOPBACK`) is delivered in-process against the
socket table. Non-loopback destinations go out the wire via
`inet_send_udp` — requires the socket to be bound so we have a valid
source port, and requires the gateway MAC to have been learned via
boot ARP. Either failure reports `status=-1, nsent=0`; UDP semantics
let us drop unmatched loopback targets silently with
`status=0, nsent=dlen`.

    inet_handle_sendto(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        if inet_fd_valid(fd, sender) == 0
            var err: [3]byte
            err[0] = byte(-1)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        val family = int(buf[2]) & 0xff
        if family != AF_INET
            var err: [3]byte
            err[0] = byte(-1)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        val dst_port = inet_read_u16(buf, 3)
        val dst_ip = inet_read_ipv4(buf, 5)
        val dlen = inet_read_u16(buf, 9)
        val data: *byte = buf + 11

Auto-bind unbound sockets to an ephemeral src port (matches POSIX
`sendto(2)` semantics). Covers both loopback and wire paths so
receivers always see a non-zero `src_port` in `recvfrom` replies.
Fails sendto only if the ephemeral range is exhausted — 32 sockets
vs. 16K ports, so not in practice.

        if inet_sockets[fd].bound == 0
            val eph = inet_alloc_ephemeral_port()
            if eph < 0
                var err: [3]byte
                err[0] = byte(-1)
                err[1] = 0
                err[2] = 0
                ipc_reply(sender, err, 3)
                return
            inet_sockets[fd].bound = 1
            inet_sockets[fd].bound_ip = INADDR_ANY
            inet_sockets[fd].bound_port = eph
            inet_udp_hash_insert(fd)
        val src_port = inet_sockets[fd].bound_port
        // Loopback fastpath: any address in 127/8 or our own external
        // IP routes to a local socket via the in-memory queue, never
        // touching the NIC. The receiver always sees src_ip = 127.0.0.1
        // so a connect()ed local UDP fd can match its peer regardless
        // of which loopback address the sender used.
        if inet_is_loopback_ip(dst_ip) != 0
            val target = inet_find_bound(dst_ip, dst_port)
            if target >= 0
                if inet_sockets[target].pending_tid >= 0
                    inet_deliver_to_waiter(target, INADDR_LOOPBACK, src_port, data, dlen)
                else
                    inet_enqueue(target, INADDR_LOOPBACK, src_port, data, dlen)
            var reply: [3]byte
            reply[0] = 0
            inet_write_u16(reply, 1, dlen)
            ipc_reply(sender, reply, 3)
            return
        val r = inet_send_udp(sender, dst_ip, dst_port, src_port, data, dlen)
        if r < 0
            var err: [3]byte
            err[0] = byte(-1)
            err[1] = 0
            err[2] = 0
            ipc_reply(sender, err, 3)
            return
        var reply: [3]byte
        reply[0] = 0
        inet_write_u16(reply, 1, dlen)
        ipc_reply(sender, reply, 3)


### RECVFROM handler

If the socket already has queued datagrams, deliver the head
immediately. Otherwise park the sender's thread id in
`pending_tid` and return without replying — the reply is
produced later when a matching sendto arrives.

Only one pending recv per socket. A second recv while one is
already pending is rejected. Good enough for single-threaded
programs; multi-waiter support is on the list.

Wire layout: `cmd(1) + fd(1) + maxlen(2) + peek(1)` = 5 bytes.
The `peek` byte is non-zero when the caller passed MSG_PEEK in
flags; the dgram is read but not dequeued.

    inet_handle_recvfrom(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        if inet_fd_valid(fd, sender) == 0
            var err: [10]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 10)
            return
        val maxlen_raw = inet_read_u16(buf, 2)
        var maxlen = maxlen_raw
        if maxlen > INET_MAX_DATA
            maxlen = INET_MAX_DATA
        val peek = int(buf[4]) & 0xff
        // Pending ICMP error wins over queued data — Linux returns
        // -ECONNREFUSED on the next recv() and only then resumes
        // delivering normal datagrams. We mirror that.
        if inet_sockets[fd].pending_error != 0
            inet_sockets[fd].pending_error = 0
            var er: [10]byte
            er[0] = byte(2)
            ipc_reply(sender, er, 10)
            return
        if inet_sockets[fd].q_count > 0
            val ridx = inet_frame_alloc()
            val reply = inet_frame_buf(ridx)
            val n = inet_deliver_head(fd, maxlen, reply, peek)
            ipc_reply(sender, reply, n)
            inet_frame_release(ridx)
            return
        if inet_sockets[fd].pending_tid >= 0
            var err: [10]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 10)
            return
        inet_sockets[fd].pending_tid = sender
        inet_sockets[fd].pending_maxlen = maxlen
        inet_sockets[fd].pending_peek = peek
        // No reply — deferred until a dgram arrives or close.


### RECVFROM_TIMEOUT handler

Same as RECVFROM but with a bounded wait. Request layout:
`cmd(1) + fd(1) + maxlen(2) + timeout_ms(4) + peek(1)` = 9 bytes.
The reply shape matches RECVFROM so callers can use the same parser.

Status byte in the reply distinguishes outcomes:
- `0` — data delivered
- `1` — timed out (no datagram within `timeout_ms`)
- `-1` — error

`inet_udp_scan_timeouts()` in the server main loop replies with
status=1 when `now >= recv_deadline`. The deadline is expressed
in scheduler ticks (100 Hz → 10 ms each). We round timeout up so
a `1 ms` request still fires on the next tick rather than
possibly firing immediately.

    inet_handle_recvfrom_timeout(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        if inet_fd_valid(fd, sender) == 0
            var err: [10]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 10)
            return
        val maxlen_raw = inet_read_u16(buf, 2)
        var maxlen = maxlen_raw
        if maxlen > INET_MAX_DATA
            maxlen = INET_MAX_DATA
        val tms_hi = inet_read_u16(buf, 4)
        val tms_lo = inet_read_u16(buf, 6)
        val timeout_ms = (tms_hi << 16) | tms_lo
        val peek = int(buf[8]) & 0xff
        if inet_sockets[fd].pending_error != 0
            inet_sockets[fd].pending_error = 0
            var er: [10]byte
            er[0] = byte(2)
            ipc_reply(sender, er, 10)
            return
        if inet_sockets[fd].q_count > 0
            val ridx = inet_frame_alloc()
            val reply = inet_frame_buf(ridx)
            val n = inet_deliver_head(fd, maxlen, reply, peek)
            ipc_reply(sender, reply, n)
            inet_frame_release(ridx)
            return
        if inet_sockets[fd].pending_tid >= 0
            var err: [10]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 10)
            return
        if timeout_ms <= 0
            var tr: [10]byte
            tr[0] = byte(1)
            ipc_reply(sender, tr, 10)
            return
        inet_sockets[fd].pending_tid = sender
        inet_sockets[fd].pending_maxlen = maxlen
        inet_sockets[fd].pending_peek = peek
        inet_sockets[fd].recv_deadline = int(monotonic_ms()) + timeout_ms
        // No reply — deferred until a dgram arrives, timeout
        // expires, or close.


### TCP_DEBUG handler

Expose internal congestion-control state for a TCP socket so
the test harness can assert cwnd / ssthresh / recovery-state
behaviour without having to reverse-engineer it from timing.
Read-only — no state is mutated.

```
request: cmd(1) + fd(2)                 = 3 bytes
reply:   status(1) + state(1)
       + cwnd(4)          + ssthresh(4)
       + snd_una(4)       + snd_nxt(4)
       + snd_wnd(4)       + send_len(4)
       + fast_recovery(4) + dup_ack_count(4)
       + sack_ok(4)       + rexmit_count(4)     = 42 bytes
```

    inet_handle_tcp_debug(sender: int, buf: *byte)
        val fd = inet_read_u16(buf, 1) & 0xffff
        var reply: [42]byte
        if inet_tcp_slot_owned(fd, sender) == 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 42)
            return
        reply[0] = 0
        reply[1] = byte(tcp_sockets[fd].state & 0xff)
        inet_dbg_write_i32(reply, 2,  tcp_sockets[fd].snd_cwnd)
        inet_dbg_write_i32(reply, 6,  tcp_sockets[fd].snd_ssthresh)
        inet_dbg_write_i32(reply, 10, int(tcp_sockets[fd].snd_una))
        inet_dbg_write_i32(reply, 14, int(tcp_sockets[fd].snd_nxt))
        inet_dbg_write_i32(reply, 18, tcp_sockets[fd].snd_wnd)
        inet_dbg_write_i32(reply, 22, tcp_sockets[fd].send_len)
        inet_dbg_write_i32(reply, 26, tcp_sockets[fd].fast_recovery)
        inet_dbg_write_i32(reply, 30, tcp_sockets[fd].dup_ack_count)
        inet_dbg_write_i32(reply, 34, tcp_sockets[fd].sack_ok)
        inet_dbg_write_i32(reply, 38, tcp_sockets[fd].rexmit_count)
        ipc_reply(sender, reply, 42)

    inet_dbg_write_i32(p: *byte, off: int, v: int)
        p[off]     = byte((v >> 24) & 0xff)
        p[off + 1] = byte((v >> 16) & 0xff)
        p[off + 2] = byte((v >>  8) & 0xff)
        p[off + 3] = byte( v        & 0xff)


### ARP probe handler

Four-operation command driven by dhclient for RFC 5227
conflict detection.

```
request: cmd(1) + op(1) + target_ip(4)   = 6 bytes
reply:   status(1) + seen(1)             = 2 bytes
```

`seen` is meaningful only for `CHECK` and is 1 if any
defender was observed since the preceding `START`.

    inet_handle_arp_probe(sender: int, buf: *byte)
        val op = int(buf[1]) & 0xff
        val target_ip = ipv4(
            int(buf[2]) & 0xff,
            int(buf[3]) & 0xff,
            int(buf[4]) & 0xff,
            int(buf[5]) & 0xff)
        var reply: [2]byte
        reply[0] = 0
        reply[1] = 0
        if op == ARP_PROBE_OP_START
            arp_probe_target = target_ip
            arp_probe_seen = 0
        else if op == ARP_PROBE_OP_SEND
            val rc = inet_send_arp_probe(
                ipv4_octet(target_ip, 0),
                ipv4_octet(target_ip, 1),
                ipv4_octet(target_ip, 2),
                ipv4_octet(target_ip, 3))
            if rc < 0
                reply[0] = byte(-1)
        else if op == ARP_PROBE_OP_CHECK
            reply[1] = byte(arp_probe_seen & 0xff)
            arp_probe_target = u32(0)
            arp_probe_seen = 0
        else if op == ARP_PROBE_OP_ANNOUNCE
            val arc = inet_send_arp_announce(
                ipv4_octet(target_ip, 0),
                ipv4_octet(target_ip, 1),
                ipv4_octet(target_ip, 2),
                ipv4_octet(target_ip, 3))
            if arc < 0
                reply[0] = byte(-1)
        else
            reply[0] = byte(-1)
        ipc_reply(sender, reply, 2)


### ICMP echo send / check

`ping`-style: the client registers a ping (id, seq) and asks us
to emit an ECHO_REQUEST to `dst_ip`; later it polls for a
matching ECHO_REPLY. Both operations are non-blocking: SEND
returns immediately after transmit, CHECK returns "still
waiting" if no reply has arrived yet. ARP misses are surfaced
to the caller so it can retry.

```
SEND request:  cmd(1) + dst_ip(4) + id(2) + seq(2)   = 9 bytes
SEND reply:    status(1)                             = 1 byte
CHECK request: cmd(1) + id(2) + seq(2)               = 5 bytes
CHECK reply:   status(1) + src_ip(4) + rtt(4)        = 9 bytes
    status: 0 = reply arrived, 1 = still waiting, -1 = no slot
```

    inet_handle_icmp_send(sender: int, buf: *byte)
        val dst_ip = ipv4(
            int(buf[1]) & 0xff,
            int(buf[2]) & 0xff,
            int(buf[3]) & 0xff,
            int(buf[4]) & 0xff)
        val id  = (int(buf[5]) & 0xff) << 8 | (int(buf[6]) & 0xff)
        val seq = (int(buf[7]) & 0xff) << 8 | (int(buf[8]) & 0xff)
        var reply: [1]byte
        reply[0] = 0
        if inet_ping_register(sender, id, seq, int(monotonic_ms())) < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 1)
            return
        if inet_send_icmp_echo_to(dst_ip, id, seq) < 0
            reply[0] = byte(-1)
        ipc_reply(sender, reply, 1)


    inet_handle_icmp_check(sender: int, buf: *byte)
        val id  = (int(buf[1]) & 0xff) << 8 | (int(buf[2]) & 0xff)
        val seq = (int(buf[3]) & 0xff) << 8 | (int(buf[4]) & 0xff)
        var reply: [9]byte
        var k = 0
        while k < 9
            reply[k] = 0
            k += 1
        var src_ip: u32 = u32(0)
        var rtt: int = 0
        val rc = inet_ping_check(id, seq, &src_ip, &rtt)
        if rc < 0
            reply[0] = byte(-1)
        else if rc == 0
            reply[0] = 1
        else
            reply[0] = 0
            reply[1] = byte(ipv4_octet(src_ip, 0))
            reply[2] = byte(ipv4_octet(src_ip, 1))
            reply[3] = byte(ipv4_octet(src_ip, 2))
            reply[4] = byte(ipv4_octet(src_ip, 3))
            reply[5] = byte((rtt >> 24) & 0xff)
            reply[6] = byte((rtt >> 16) & 0xff)
            reply[7] = byte((rtt >> 8) & 0xff)
            reply[8] = byte(rtt & 0xff)
        ipc_reply(sender, reply, 9)


### UDP recv-timeout scanner

Called from the inet main loop on every wake. Scans every
socket with a pending recvfrom that has a non-zero deadline, and
when the deadline has passed replies with status=1 (timeout). We
clear the waiter before replying so a datagram arriving on the
same tick doesn't wake the thread twice.

Timer wakes happen every ~50 ms (`svc_timer_subscribe(5)` in
inet_server), so worst-case overshoot on an idle port is one
tick period. Good enough for DHCP-scale retransmits.

    inet_udp_scan_timeouts()
        val now = int(monotonic_ms())
        var i = 0
        while i < INET_MAX_SOCKETS
            if inet_sockets[i].in_use != 0
                if inet_sockets[i].pending_tid >= 0
                    val dl = inet_sockets[i].recv_deadline
                    if dl != 0
                        if now >= dl
                            val waiter = inet_sockets[i].pending_tid
                            inet_sockets[i].pending_tid = -1
                            inet_sockets[i].pending_peek = 0
                            inet_sockets[i].recv_deadline = 0
                            var tr: [10]byte
                            tr[0] = byte(1)
                            ipc_reply(waiter, tr, 10)
            i += 1


### CLOSE handler

Closes the slot. If a recv was pending, reply with an error so
the caller doesn't block forever.

    inet_handle_close(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        if inet_fd_valid(fd, sender) == 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        // Phase 2A: drop sender from the owners ring. If another tid
        // still references this slot (e.g. via SCM_RIGHTS or
        // PM_CMD_TRANSPLANT_FD), keep the slot alive — only the last
        // close reaches the actual teardown path.
        val left = inet_udp_owners_remove(fd, sender)
        if left > 0
            var ack: [1]byte
            ack[0] = 0
            ipc_reply(sender, ack, 1)
            return
        // Phase 2B chunk 3: an in-flight SCM_RIGHTS cmsg holds a
        // queue ref on this slot. Defer teardown — the receiver-side
        // drain (or close-with-undrained) will drop the queue ref via
        // INET_CMD_QUEUE_REF(-1), and at that point owners_count and
        // queued_refs are both 0 and the slot tears down there.
        if inet_sockets[fd].queued_refs > 0
            var ack: [1]byte
            ack[0] = 0
            ipc_reply(sender, ack, 1)
            return
        if inet_sockets[fd].pending_tid >= 0
            val waiter = inet_sockets[fd].pending_tid
            inet_sockets[fd].pending_tid = -1
            inet_sockets[fd].pending_peek = 0
            inet_sockets[fd].recv_deadline = 0
            var wr: [10]byte
            wr[0] = byte(-1)
            ipc_reply(waiter, wr, 10)
        if inet_sockets[fd].bound != 0
            inet_udp_hash_remove(fd)
        inet_sockets[fd].in_use = 0
        inet_sockets[fd].bound = 0
        inet_sockets[fd].q_count = 0
        inet_sockets[fd].q_head = 0
        inet_sockets[fd].q_tail = 0
        inet_sockets[fd].pending_error = 0
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, reply, 1)



### inet_handle_set_ip_config

Install a new (ip, mask, gw) triple via `inet_set_ip_config`. Used
by the DHCP client once a lease is bound, and exposed as an IPC op
so any userspace tool (ifconfig, tests) can drive it. Wire format:
cmd(1) + ip(4) + mask(4) + gw(4) = 13 bytes in; 1 byte status out.

    inet_handle_set_ip_config(sender: int, buf: *byte)
        val ip = inet_read_ipv4(buf, 1)
        val mask = inet_read_ipv4(buf, 5)
        val gw = inet_read_ipv4(buf, 9)
        inet_set_ip_config(ip, mask, gw)
        var reply: [1]byte
        reply[0] = byte(0)
        ipc_reply(sender, reply, 1)


### inet_handle_pid_exit

Reclaim every socket whose owners ring contains a terminated
thread. PM sends the dead process's main_tid as a big-endian i32
at buf[1..5]; inet scans both the UDP and TCP tables, removes the
tid from each slot's owners ring, and closes the slot only when
the ring empties (Phase 2A multi-owner support). This is how we
prevent inet_sockets[] / tcp_sockets[] slots from leaking when a
process exits without calling close(). Wire format: cmd(1) +
tid(4) = 5 in, status(1) out. Cleanup is ungraceful — TCP sockets
skip FIN and go straight to CLOSED, which is fine for the
pid-exit case (the process is gone and the peer will observe
connection loss via timeout or a future RST).

    inet_handle_pid_exit(sender: int, buf: *byte)
        val tid = ((int(buf[1]) & 0xff) << 24) | ((int(buf[2]) & 0xff) << 16) | ((int(buf[3]) & 0xff) << 8) | (int(buf[4]) & 0xff)
        var i = 0
        while i < INET_MAX_SOCKETS
            if inet_sockets[i].in_use != 0
                if inet_udp_owners_has(i, tid) != 0
                    val left = inet_udp_owners_remove(i, tid)
                    // Phase 2B chunk 3: same teardown gate as
                    // INET_CMD_CLOSE — defer free while an in-flight
                    // SCM cmsg holds a queued_ref. Receiver-side
                    // QUEUE_REF(-1) reaches the deferred-free path
                    // in inet_handle_queue_ref.
                    if left == 0
                        if inet_sockets[i].queued_refs == 0
                            if inet_sockets[i].bound != 0
                                inet_udp_hash_remove(i)
                            inet_sockets[i].in_use = 0
                            inet_sockets[i].bound = 0
                            inet_sockets[i].q_count = 0
                            inet_sockets[i].q_head = 0
                            inet_sockets[i].q_tail = 0
                            inet_sockets[i].pending_tid = -1
                            inet_sockets[i].recv_deadline = 0
            i += 1
        inet_tcp_cleanup_owner(tid)
        inet_epoll_drop_owner(tid)
        // Phase 2 chunk 3 — auxiliary tables that hold owner_tid:
        // ICMP ping pending replies (4 slots, easy to fill) and
        // ARP-pending UDP datagrams (2 slots, ditto).  Without this
        // a process that pings an unresponsive peer or sends to an
        // unresolved next-hop and then dies leaks the slot until
        // an unrelated id+seq collision or ARP cache eviction frees
        // it.
        inet_ping_cleanup_owner(tid)
        inet_pending_udp_cleanup_owner(tid)
        var reply: [1]byte
        reply[0] = byte(0)
        ipc_reply(sender, reply, 1)


### inet_handle_add_owner

Phase 2A multi-owner support: append `new_tid` to the owners ring
of the addressed slot. Used by `posix_fd_transplant` (and, in
Phase 2B, the SCM_RIGHTS receive path) so a TCP/UDP socket whose
fd was passed cross-process keeps its kernel state alive past the
sender's close().

Wire: cmd(1) + kind(1) + slot_idx_be(2) + new_tid_be(4) = 8 in;
status(1) out. `kind` is 0 for UDP, 1 for TCP. Status: 0 = OK,
-1 = bad kind / bad index / slot free, -2 = ring full.

The handler doesn't validate the *sender* (any caller can add any
tid). Privilege gating happens upstream via the RS syscall
allow-mask: only the shim helper invoked from `SYS_FD_TRANSPLANT`
or the unix server's SCM_RIGHTS path reaches this code path, and
both of those sit inside server-trusted contexts.

    inet_handle_add_owner(sender: int, buf: *byte)
        val kind = int(buf[1]) & 0xff
        val idx = inet_read_u16(buf, 2)
        val nt_hi = inet_read_u16(buf, 4)
        val nt_lo = inet_read_u16(buf, 6)
        val new_tid = (nt_hi << 16) | nt_lo
        var reply: [1]byte
        if kind == 0
            if idx < 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if idx >= INET_MAX_SOCKETS
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if inet_sockets[idx].in_use == 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if inet_udp_owners_add(idx, new_tid) == 0
                reply[0] = byte(-2)
                ipc_reply(sender, reply, 1)
                return
            reply[0] = 0
            ipc_reply(sender, reply, 1)
            return
        if kind == 1
            if idx < 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if idx >= TCP_MAX_SOCKETS
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if tcp_sockets[idx].in_use == 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if inet_tcp_owners_add(idx, new_tid) == 0
                reply[0] = byte(-2)
                ipc_reply(sender, reply, 1)
                return
            reply[0] = 0
            ipc_reply(sender, reply, 1)
            return
        reply[0] = byte(-1)
        ipc_reply(sender, reply, 1)


### inet_handle_queue_ref

Phase 2B chunk 3 — bump or drop a slot's `queued_refs` counter for
in-flight SCM_RIGHTS cmsg. The sender shim does `+1` before
SENDMSG so the slot survives even if the sender's `close()` races
the receiver's drain; the receiver shim (or the closing-side shim
on un-drained pending_scm) does `-1` to balance it.

Reaching `owners_count + queued_refs == 0` triggers the deferred
teardown path that the per-kind close handlers skipped while
either ring/refcount was non-zero.

Wire: `cmd(1) + kind(1) + slot_idx_be(2) + delta(1, signed) =
5 bytes` in; status(1) out. `kind` is 0 for UDP, 1 for TCP.
`delta` is +1 or -1 (any other value rejected). Status: 0 = OK,
-1 = bad kind / bad index / bad delta.

The handler doesn't authenticate the sender. The privilege model
matches `INET_CMD_ADD_OWNER`: only the shim helpers in the
posix-shim path reach this code, and that path is gated upstream.

    inet_handle_queue_ref(sender: int, buf: *byte)
        val kind = int(buf[1]) & 0xff
        val idx = inet_read_u16(buf, 2)
        val delta_raw = int(buf[4]) & 0xff
        var delta = 0
        if delta_raw == 1
            delta = 1
        else if delta_raw == 0xff
            delta = -1
        else
            var bad: [1]byte
            bad[0] = byte(-1)
            ipc_reply(sender, bad, 1)
            return
        var reply: [1]byte
        if kind == 0
            if idx < 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if idx >= INET_MAX_SOCKETS
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if inet_sockets[idx].in_use == 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            inet_sockets[idx].queued_refs += delta
            if inet_sockets[idx].queued_refs < 0
                inet_sockets[idx].queued_refs = 0
            if inet_sockets[idx].owners_count == 0
                if inet_sockets[idx].queued_refs == 0
                    if inet_sockets[idx].bound != 0
                        inet_udp_hash_remove(idx)
                    inet_sockets[idx].in_use = 0
                    inet_sockets[idx].bound = 0
                    inet_sockets[idx].q_count = 0
                    inet_sockets[idx].q_head = 0
                    inet_sockets[idx].q_tail = 0
                    inet_sockets[idx].pending_tid = -1
                    inet_sockets[idx].recv_deadline = 0
                    inet_sockets[idx].pending_error = 0
            reply[0] = 0
            ipc_reply(sender, reply, 1)
            return
        if kind == 1
            if idx < 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if idx >= TCP_MAX_SOCKETS
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            if tcp_sockets[idx].in_use == 0
                reply[0] = byte(-1)
                ipc_reply(sender, reply, 1)
                return
            tcp_sockets[idx].queued_refs += delta
            if tcp_sockets[idx].queued_refs < 0
                tcp_sockets[idx].queued_refs = 0
            if tcp_sockets[idx].owners_count == 0
                if tcp_sockets[idx].queued_refs == 0
                    inet_tcp_close_slot(idx, -1)
            reply[0] = 0
            ipc_reply(sender, reply, 1)
            return
        reply[0] = byte(-1)
        ipc_reply(sender, reply, 1)


### inet_handle_udp_getname

Return the local endpoint of a UDP socket: (port, ip). Used by
`getsockname` from the POSIX shim. UDP has no persistent peer, so
`getpeername` on UDP short-circuits in the shim and this command
never fires with a "peer" variant — hence a single op with no
which-flag. Wire: cmd(1) + fd(u8) = 2 bytes in. Reply: status(1)
+ port(2 BE) + ip(4) = 7 bytes. An unbound socket reports
`0.0.0.0:0`.

    inet_handle_udp_getname(sender: int, buf: *byte)
        val fd = int(buf[1]) & 0xff
        var reply: [7]byte
        if inet_fd_valid(fd, sender) == 0
            reply[0] = byte(-1)
            inet_write_u16(reply, 1, 0)
            inet_write_ipv4(reply, 3, u32(0))
            ipc_reply(sender, reply, 7)
            return
        reply[0] = byte(0)
        if inet_sockets[fd].bound != 0
            inet_write_u16(reply, 1, inet_sockets[fd].bound_port)
            inet_write_ipv4(reply, 3, inet_sockets[fd].bound_ip)
        else
            inet_write_u16(reply, 1, 0)
            inet_write_ipv4(reply, 3, u32(0))
        ipc_reply(sender, reply, 7)


### inet_handle_tcp_getname

Return either the local or peer endpoint of a TCP socket. Wire:
cmd(1) + fd(u16) + which(u8) = 4 bytes in; which == 0 means
local, which == 1 means peer. Reply: status(1) + port(2 BE) +
ip(4) = 7 bytes. Returns `-ENOTCONN` (-107) for a peer query on
a socket that hasn't reached ESTABLISHED. The heavy lifting lives
in `inet_tcp_getname` (inet_proto.lsysl) because it touches
`tcp_sockets[]` state.

    inet_handle_tcp_getname(sender: int, buf: *byte)
        val fd = inet_read_u16(buf, 1) & 0xffff
        val which = int(buf[3]) & 0xff
        var reply: [7]byte
        if inet_tcp_slot_owned(fd, sender) == 0
            reply[0] = byte(-1)
            inet_write_u16(reply, 1, 0)
            inet_write_ipv4(reply, 3, u32(0))
            ipc_reply(sender, reply, 7)
            return
        var port = 0
        var ip = u32(0)
        val status = inet_tcp_getname(fd, which, &port, &ip)
        reply[0] = byte(status)
        inet_write_u16(reply, 1, port)
        inet_write_ipv4(reply, 3, ip)
        ipc_reply(sender, reply, 7)


### inet_handle_tcp_setbuf / inet_handle_tcp_getbuf

setsockopt(SO_SNDBUF) / setsockopt(SO_RCVBUF). The shim translates
the user `int optval` into a 16-bit BE size on the wire (clamped on
the inet side to [TCP_BUF_MIN, TCP_BUF_MAX]). `kind == 0` selects
SNDBUF, `kind == 1` selects RCVBUF.

SET wire: cmd(1) + fd(u16 BE) + kind(1) + size(u16 BE) = 6 bytes in;
reply is 1 byte status (0 = ok, -1 = bad fd / bad kind).

GET wire: cmd(1) + fd(u16 BE) + kind(1) = 4 bytes in; reply is
1 byte status + u16 BE size = 3 bytes out (size 0 on error).

    inet_handle_tcp_setbuf(sender: int, buf: *byte)
        val fd = inet_read_u16(buf, 1) & 0xffff
        val kind = int(buf[3]) & 0xff
        val size = inet_read_u16(buf, 4)
        var reply: [1]byte
        if inet_tcp_slot_owned(fd, sender) == 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 1)
            return
        val rc = inet_tcp_resize_buf(fd, kind, size)
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)

    inet_handle_tcp_getbuf(sender: int, buf: *byte)
        val fd = inet_read_u16(buf, 1) & 0xffff
        val kind = int(buf[3]) & 0xff
        var reply: [3]byte
        if inet_tcp_slot_owned(fd, sender) == 0
            reply[0] = byte(-1)
            inet_write_u16(reply, 1, 0)
            ipc_reply(sender, reply, 3)
            return
        val sz = inet_tcp_get_bufsize(fd, kind)
        if sz < 0
            reply[0] = byte(-1)
            inet_write_u16(reply, 1, 0)
            ipc_reply(sender, reply, 3)
            return
        reply[0] = 0
        inet_write_u16(reply, 1, sz)
        ipc_reply(sender, reply, 3)


### inet_handle_get_ip_config

Return the current (ip, mask, gw). Reply: status(1) + ip(4) +
mask(4) + gw(4) = 13 bytes. Payload-less request (just cmd).

    inet_handle_get_ip_config(sender: int, buf: *byte)
        var reply: [13]byte
        reply[0] = byte(0)
        inet_write_ipv4(reply, 1, inet_get_our_ip())
        inet_write_ipv4(reply, 5, inet_get_mask())
        inet_write_ipv4(reply, 9, inet_get_gw())
        ipc_reply(sender, reply, 13)


Test-only: drive inet_tcp_state_step through a deliberately out-of-
order segment sequence against a scratch socket and verify the
reorder queue yields the right rcv_nxt / recv_buf contents. Reply
is 1 byte: 0 on pass, nonzero error code on failure.

    inet_handle_tcp_ooo_selftest(sender: int, buf: *byte)
        val rc = inet_tcp_ooo_selftest()
        var reply: [1]byte
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)


Test-only: drive `inet_tcp_send_park_selftest` to verify the
park/wake state machine added in Phase 1 — fill send_buf, park a
fake waiter, drain, watch the helper clear the slot.

    inet_handle_tcp_send_park_test(sender: int, buf: *byte)
        val rc = inet_tcp_send_park_selftest()
        var reply: [1]byte
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)


Test-only: drive `inet_tcp_arp_replay_selftest` to verify that
landing an ARP reply re-emits any TCP socket that previously
hit a MAC-miss in `inet_tcp_emit`.

    inet_handle_tcp_arp_replay_test(sender: int, buf: *byte)
        val rc = inet_tcp_arp_replay_selftest()
        var reply: [1]byte
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)


Test-only: drive the Phase 2 chunk 3 PID_EXIT cleanup audit.
Synthesizes a fake owner_tid (-7777, well outside the real tid
space), parks one ICMP ping slot and one pending-UDP slot under
that tid, runs the cleanup helpers, and verifies both slots
freed.  Reply byte breaks down as:
  0          all clear
  0x10..0x1f ping selftest failed (low 4 bits = step)
  0x20..0x2f pending-UDP selftest failed (low 4 bits = step)

    inet_handle_pid_exit_selftest(sender: int, buf: *byte)
        val fake_tid = -7777
        val pr = inet_ping_cleanup_selftest(fake_tid)
        var reply: [1]byte
        if pr != 0
            reply[0] = byte(0x10 | (pr & 0x0f))
            ipc_reply(sender, reply, 1)
            return
        val ur = inet_pending_udp_cleanup_selftest(fake_tid)
        if ur != 0
            reply[0] = byte(0x20 | (ur & 0x0f))
            ipc_reply(sender, reply, 1)
            return
        reply[0] = byte(0)
        ipc_reply(sender, reply, 1)


### inet_handle_get_stats

Phase 2 chunk 4 — caller-side introspection of net-stack
resource use. Lets a process answer "how many sockets and how
much TCP buffer memory am I currently holding?" without parsing
`/proc/net/*` style files. Closes Phase 2 of the netstack-quality
plan.

Wire:

  request:  cmd(1) + tid_be32(4) = 5 bytes.  tid==0 means
            "use the sender's tid"; nonzero is an explicit query
            that lets a parent inspect a child or a test inspect
            a synthetic owner.

  reply:    status(1) + tcp_count_be32(4) + udp_count_be32(4)
            + tcp_buf_bytes_be32(4) + reserved_be32(4) = 17 bytes.
            status==0 on success, 0xff on error (currently the
            handler can't fail — slot scans never error — but we
            keep the byte for symmetry with the rest of the IPC
            ABI and to leave room for ACL gating later).

The three counts are computed by the existing per-owner helpers
(`inet_count_tcp_owner`, `inet_count_udp_owner`,
`inet_tcp_buf_bytes_owner`), so this handler is essentially three
calls plus packing.

    inet_handle_get_stats(sender: int, buf: *byte)
        val t0 = (int(buf[1]) & 0xff) << 24
        val t1 = (int(buf[2]) & 0xff) << 16
        val t2 = (int(buf[3]) & 0xff) <<  8
        val t3 =  int(buf[4]) & 0xff
        val tid_arg = t0 | t1 | t2 | t3
        var whose = tid_arg
        if tid_arg == 0
            whose = sender
        val tcp_n = inet_count_tcp_owner(whose)
        val udp_n = inet_count_udp_owner(whose)
        val buf_b = inet_tcp_buf_bytes_owner(whose)
        var reply: [17]byte
        reply[0] = byte(0)
        reply[1] = byte((tcp_n >> 24) & 0xff)
        reply[2] = byte((tcp_n >> 16) & 0xff)
        reply[3] = byte((tcp_n >>  8) & 0xff)
        reply[4] = byte( tcp_n        & 0xff)
        reply[5] = byte((udp_n >> 24) & 0xff)
        reply[6] = byte((udp_n >> 16) & 0xff)
        reply[7] = byte((udp_n >>  8) & 0xff)
        reply[8] = byte( udp_n        & 0xff)
        reply[ 9] = byte((buf_b >> 24) & 0xff)
        reply[10] = byte((buf_b >> 16) & 0xff)
        reply[11] = byte((buf_b >>  8) & 0xff)
        reply[12] = byte( buf_b        & 0xff)
        reply[13] = byte(0)
        reply[14] = byte(0)
        reply[15] = byte(0)
        reply[16] = byte(0)
        ipc_reply(sender, reply, 17)


`inet_handle_frame_pool_stats` lives in `inet_proto.lsysl` next to
the pool storage. Dispatch wires it from this file via a forward
call.


Test-only: synthesize three IPv4 fragments of a 32-byte UDP
datagram bound for our IP at port 9100, inject them into
`inet_handle_frame` in out-of-order sequence (frag 2, frag 3,
frag 1), and reply 1 byte status (0 on success, nonzero error).
The assembled UDP payload reaches the test program through the
normal RX path — when it calls `recvfrom` it picks up the
reassembled datagram from its bound socket's queue.

UDP layout (post-assembly, IP payload bytes 0..32):
  byte  0..2  src port = 9000
  byte  2..4  dst port = 9100
  byte  4..6  udp length = 32
  byte  6..8  udp checksum = 0 (skip verify)
  byte  8..16 'A' x 8
  byte 16..24 'B' x 8
  byte 24..32 'C' x 8

Fragment plan:
  frag 1: offset=0,  MF=1, body=ud[0..16]   (UDP header + 'A'x8)
  frag 2: offset=16, MF=1, body=ud[16..24]  ('B' x 8)
  frag 3: offset=24, MF=0, body=ud[24..32]  ('C' x 8)

    inet_handle_ip_reasm_selftest(sender: int, buf: *byte)
        val rc = inet_ip_reasm_selftest_run()
        var reply: [1]byte
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)

    inet_ip_reasm_selftest_run() -> int
        var ud: [32]byte
        inet_write_u16(ud, 0, 9000)
        inet_write_u16(ud, 2, 9100)
        inet_write_u16(ud, 4, 32)
        inet_write_u16(ud, 6, 0)
        var bi = 0
        while bi < 8
            ud[8 + bi] = byte('A')
            ud[16 + bi] = byte('B')
            ud[24 + bi] = byte('C')
            bi += 1

        if inet_ip_reasm_inject_frag(0xABCD, 16, 1, ud, 16, 8) != 0
            return 1
        if inet_ip_reasm_inject_frag(0xABCD, 24, 0, ud, 24, 8) != 0
            return 2
        if inet_ip_reasm_inject_frag(0xABCD, 0, 1, ud, 0, 16) != 0
            return 3
        0

Build a single IPv4 fragment frame and feed it through
`inet_handle_frame`. ETH MACs are zeroed — handle_frame doesn't
inspect ETH dst once we're past the NIC.

    inet_ip_reasm_inject_frag(ident_v: int, offset_bytes: int, mf: int,
                              src: *byte, src_off: int, body_len: int) -> int
        var frame: [80]byte
        var i = 0
        while i < 14
            frame[i] = byte(0)
            i += 1
        inet_write_u16(frame, 12, ETHERTYPE_IPV4)

        frame[14] = byte(0x45)
        frame[15] = byte(0)
        inet_write_u16(frame, 16, 20 + body_len)
        inet_write_u16(frame, 18, ident_v)
        val flags_v = (mf << 13) | (offset_bytes / 8)
        inet_write_u16(frame, 20, flags_v)
        frame[22] = byte(64)
        frame[23] = byte(IP_PROTO_UDP)
        inet_write_u16(frame, 24, 0)
        inet_write_ipv4(frame, 26, ipv4(10, 0, 2, 99))
        inet_write_ipv4(frame, 30, inet_get_our_ip())
        inet_write_u16(frame, 24, net_checksum(frame + 14, 20))

        var k = 0
        while k < body_len
            frame[14 + 20 + k] = src[src_off + k]
            k += 1

        inet_handle_frame(frame, 14 + 20 + body_len)
        0


Test-only: RFC 5722 overlap-fragment enforcement. Inject a
first-fragment ('X' x 16) at offset=0, then an overlapping
fragment ('Y' x 8) at offset=8 — overlapping bytes 8..16 of the
existing range. The reassembly slot must be poisoned in
response. Reply 1 byte: 0 on pass, nonzero on failure.

    inet_handle_ip_reasm_overlap_test(sender: int, buf: *byte)
        val rc = inet_ip_reasm_overlap_test_run()
        var reply: [1]byte
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)

    inet_ip_reasm_overlap_test_run() -> int
        val id_v = 0xCAFE
        var ud: [24]byte
        var bi = 0
        while bi < 16
            ud[bi] = byte('X')
            bi += 1
        bi = 0
        while bi < 8
            ud[16 + bi] = byte('Y')
            bi += 1
        if inet_ip_reasm_inject_frag(id_v, 0, 1, ud, 0, 16) != 0
            return 1
        if inet_ip_reasm_inject_frag(id_v, 8, 1, ud, 16, 8) != 0
            return 2
        val s = inet_ip_reasm_find(ipv4(10, 0, 2, 99), inet_get_our_ip(),
                                   id_v, IP_PROTO_UDP)
        if s < 0
            return 3
        val was_poisoned = inet_ip_reasm_table[s].poisoned
        inet_ip_reasm_force_expire(s)
        inet_ip_reasm_scan_timeouts()
        if was_poisoned == 0
            return 4
        0


Test-only: ICMP Time Exceeded emit on reassembly timeout. Inject
one first-fragment, force its deadline past, run the scan sweep,
and verify `inet_ip_reasm_timeouts_sent` advanced by exactly one.
Reply 1 byte: 0 on pass, nonzero on failure.

    inet_handle_ip_reasm_timeout_test(sender: int, buf: *byte)
        val rc = inet_ip_reasm_timeout_test_run()
        var reply: [1]byte
        reply[0] = byte(rc & 0xff)
        ipc_reply(sender, reply, 1)

    inet_ip_reasm_timeout_test_run() -> int
        val before = inet_ip_reasm_timeouts_sent
        val id_v = 0xBABE
        var ud: [16]byte
        var i = 0
        while i < 16
            ud[i] = byte('Q')
            i += 1
        if inet_ip_reasm_inject_frag(id_v, 0, 1, ud, 0, 16) != 0
            return 1
        val s = inet_ip_reasm_find(ipv4(10, 0, 2, 99), inet_get_our_ip(),
                                   id_v, IP_PROTO_UDP)
        if s < 0
            return 2
        inet_ip_reasm_force_expire(s)
        inet_ip_reasm_scan_timeouts()
        val after = inet_ip_reasm_timeouts_sent
        if after - before != 1
            return 3
        if inet_ip_reasm_table[s].in_use != 0
            return 4
        0



### inet_handle_epoll_sub / unsub / inst_close

Wire format for SUB/UNSUB: cmd(1) + kind(1) + fd(2 BE) +
epoll_inst(1) = 5 bytes in. INST_CLOSE: cmd(1) + epoll_inst(1)
= 2 bytes in. Reply is always status(1).

SUB upserts — if the same (kind, fd, owner_tid, epoll_inst)
quad is already registered, it's a no-op success. The shim
calls SUB on every CTL_ADD and CTL_MOD; the `events` mask isn't
shipped because inet's job is just "wake on edge", not filtering.

    inet_handle_epoll_sub(sender: int, buf: *byte)
        val kind = int(buf[1]) & 0xff
        val fd = inet_read_u16(buf, 2) & 0xffff
        val inst = int(buf[4]) & 0xff
        var reply: [1]byte
        val existing = inet_epoll_find_sub(kind, fd, sender, inst)
        if existing >= 0
            reply[0] = byte(0)
            ipc_reply(sender, reply, 1)
            return
        val slot = inet_epoll_alloc_sub()
        if slot < 0
            reply[0] = byte(-28)            // -ENOSPC
            ipc_reply(sender, reply, 1)
            return
        inet_epoll_subs[slot].in_use = 1
        inet_epoll_subs[slot].kind = kind
        inet_epoll_subs[slot].inet_fd = fd
        inet_epoll_subs[slot].owner_tid = sender
        inet_epoll_subs[slot].epoll_inst = inst
        reply[0] = byte(0)
        ipc_reply(sender, reply, 1)

    inet_handle_epoll_unsub(sender: int, buf: *byte)
        val kind = int(buf[1]) & 0xff
        val fd = inet_read_u16(buf, 2) & 0xffff
        val inst = int(buf[4]) & 0xff
        var reply: [1]byte
        val slot = inet_epoll_find_sub(kind, fd, sender, inst)
        if slot >= 0
            inet_epoll_subs[slot].in_use = 0
        reply[0] = byte(0)
        ipc_reply(sender, reply, 1)

    inet_handle_epoll_inst_close(sender: int, buf: *byte)
        val inst = int(buf[1]) & 0xff
        inet_epoll_drop_inst(sender, inst)
        var reply: [1]byte
        reply[0] = byte(0)
        ipc_reply(sender, reply, 1)


### Server main loop

Uses `ipc_recv_notify` so the same loop wakes on both socket IPC
(SOCKET/BIND/SENDTO/...) and async nic RX notifications. On a
notification we drain the nic's RX queue via
`inet_nic_recv_packet` and dispatch each frame through
`inet_handle_frame` (ARP + ICMP echo).

Before the loop, `inet_link_init()` grabs our MAC from the nic,
subscribes for RX notifications, and fires the boot ARP request
for the gateway. It's a best-effort call — if the nic isn't
reachable (e.g. the x86 build, which has no virtio-net yet) we
silently skip link-layer setup and still serve UDP loopback.

    inet_server()
        inet_init_sockets()
        inet_tcp_init()
        inet_epoll_init()
        inet_port = port_create()
        port_register(inet_port, "inet")
        rs_ready()

        inet_link_init()

        // Periodic wakeup for TCP retransmit / TIME_WAIT scans.
        // 5 ticks ≈ 50 ms on a 100 Hz scheduler timer.
        svc_timer_subscribe(5)

        // Borrow a pool slot for the IPC receive buffer; held for
        // the server's entire lifetime so subsequent allocs see
        // baseline `used == 1`.
        val main_idx = inet_frame_alloc()
        val buf = inet_frame_buf(main_idx)
        while 1 == 1
            val r = ipc_recv_notify(inet_port, buf, INET_MSG_BUF)
            inet_tcp_scan_timers()
            inet_udp_scan_timeouts()
            inet_ip_reasm_scan_timeouts()
            if r == -2
                notify_read_self()
                inet_drain_rx()
            else if r >= 0
                val sender = r
                val cmd = int(buf[0]) & 0xff
                cmd match
                    INET_CMD_SOCKET      -> inet_handle_socket(sender, buf)
                    INET_CMD_BIND        -> inet_handle_bind(sender, buf)
                    INET_CMD_SENDTO      -> inet_handle_sendto(sender, buf)
                    INET_CMD_RECVFROM    -> inet_handle_recvfrom(sender, buf)
                    INET_CMD_RECVFROM_TIMEOUT -> inet_handle_recvfrom_timeout(sender, buf)
                    INET_CMD_CLOSE       -> inet_handle_close(sender, buf)
                    INET_CMD_TCP_CONNECT -> inet_handle_tcp_connect(sender, buf)
                    INET_CMD_TCP_SEND    -> inet_handle_tcp_send(sender, buf)
                    INET_CMD_TCP_RECV    -> inet_handle_tcp_recv(sender, buf)
                    INET_CMD_TCP_CLOSE   -> inet_handle_tcp_close(sender, buf)
                    INET_CMD_TCP_SHUTDOWN -> inet_handle_tcp_shutdown(sender, buf)
                    INET_CMD_TCP_LISTEN  -> inet_handle_tcp_listen(sender, buf)
                    INET_CMD_TCP_ACCEPT  -> inet_handle_tcp_accept(sender, buf)
                    INET_CMD_SET_IP_CONFIG -> inet_handle_set_ip_config(sender, buf)
                    INET_CMD_GET_IP_CONFIG -> inet_handle_get_ip_config(sender, buf)
                    INET_CMD_ARP_PROBE   -> inet_handle_arp_probe(sender, buf)
                    INET_CMD_ICMP_SEND   -> inet_handle_icmp_send(sender, buf)
                    INET_CMD_ICMP_CHECK  -> inet_handle_icmp_check(sender, buf)
                    INET_CMD_PID_EXIT    -> inet_handle_pid_exit(sender, buf)
                    INET_CMD_ADD_OWNER   -> inet_handle_add_owner(sender, buf)
                    INET_CMD_QUEUE_REF   -> inet_handle_queue_ref(sender, buf)
                    INET_CMD_UDP_GETNAME -> inet_handle_udp_getname(sender, buf)
                    INET_CMD_TCP_GETNAME -> inet_handle_tcp_getname(sender, buf)
                    INET_CMD_TCP_RECV_NB -> inet_handle_tcp_recv_nb(sender, buf)
                    INET_CMD_POLL        -> inet_handle_poll(sender, buf)
                    INET_CMD_EPOLL_SUB   -> inet_handle_epoll_sub(sender, buf)
                    INET_CMD_EPOLL_UNSUB -> inet_handle_epoll_unsub(sender, buf)
                    INET_CMD_EPOLL_INST_CLOSE -> inet_handle_epoll_inst_close(sender, buf)
                    INET_CMD_TCP_ACCEPT_NB -> inet_handle_tcp_accept_nb(sender, buf)
                    INET_CMD_TCP_CONNECT_NB -> inet_handle_tcp_connect_nb(sender, buf)
                    INET_CMD_TCP_SETBUF  -> inet_handle_tcp_setbuf(sender, buf)
                    INET_CMD_TCP_GETBUF  -> inet_handle_tcp_getbuf(sender, buf)
                    INET_CMD_TCP_ABORT_CLOSE -> inet_handle_tcp_abort_close(sender, buf)
                    INET_CMD_TCP_SET_KEEPALIVE -> inet_handle_tcp_set_keepalive(sender, buf)
                    INET_CMD_TCP_SET_KEEPOPT -> inet_handle_tcp_set_keepopt(sender, buf)
                    INET_CMD_TCP_GET_KEEPOPT -> inet_handle_tcp_get_keepopt(sender, buf)
                    INET_CMD_TCP_GET_ERR -> inet_handle_tcp_get_err(sender, buf)
                    INET_CMD_TCP_INJECT_FAIL -> inet_handle_tcp_inject_fail(sender, buf)
                    INET_CMD_TCP_GET_INFO -> inet_handle_tcp_get_info(sender, buf)
                    INET_CMD_TCP_DEBUG   -> inet_handle_tcp_debug(sender, buf)
                    INET_CMD_ICMP_UNREACH_INJECT -> inet_handle_icmp_unreach_inject(sender, buf)
                    INET_CMD_IP_REASM_SELFTEST -> inet_handle_ip_reasm_selftest(sender, buf)
                    INET_CMD_IP_REASM_OVERLAP_TEST -> inet_handle_ip_reasm_overlap_test(sender, buf)
                    INET_CMD_IP_REASM_TIMEOUT_TEST -> inet_handle_ip_reasm_timeout_test(sender, buf)
                    INET_CMD_TCP_SEND_PARK_TEST -> inet_handle_tcp_send_park_test(sender, buf)
                    INET_CMD_TCP_ARP_REPLAY_TEST -> inet_handle_tcp_arp_replay_test(sender, buf)
                    INET_CMD_PID_EXIT_SELFTEST -> inet_handle_pid_exit_selftest(sender, buf)
                    INET_CMD_GET_STATS         -> inet_handle_get_stats(sender, buf)
                    INET_CMD_FRAME_POOL_STATS  -> inet_handle_frame_pool_stats(sender, buf)
                    INET_CMD_TCP_SET_USERTO    -> inet_handle_tcp_set_userto(sender, buf)
                    INET_CMD_TCP_BLACKHOLE_ACKS_TEST -> inet_handle_tcp_blackhole_acks_test(sender, buf)
                    INET_CMD_PMTU_INJECT_TEST -> inet_handle_pmtu_inject_test(sender, buf)
                    INET_CMD_FRAG_EGRESS_COUNT -> inet_handle_frag_egress_count(sender, buf)
                    INET_CMD_PMTU_DISCOVER_INJECT -> inet_handle_pmtu_discover_inject(sender, buf)
                    INET_CMD_TCP_DATA_SEG_COUNT -> inet_handle_tcp_data_seg_count(sender, buf)
                    INET_CMD_TCP_OOO_SELFTEST -> inet_handle_tcp_ooo_selftest(sender, buf)
                    else ->
                        var reply: [1]byte
                        reply[0] = byte(-1)
                        ipc_reply(sender, reply, 1)
