    const INET_CMD_TCP_INJECT_FAIL = 42
    const INET_CMD_TCP_GET_INFO    = 43
    const INET_CMD_IP_REASM_SELFTEST = 44
    const INET_CMD_IP_REASM_OVERLAP_TEST = 45
    const INET_CMD_IP_REASM_TIMEOUT_TEST = 46
    const INET_CMD_TCP_SEND_PARK_TEST = 47
