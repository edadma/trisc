OSKit VFS Server — Virtual Filesystem Layer

Minix 3-style VFS that owns the "fs" namespace. Clients talk to
VFS; VFS routes requests to the appropriate filesystem backend
via the mount table. Currently only root ("/") is mounted on TFS.

    module oskit.servers

    import oskit.ipc.{port_create, port_register, port_lookup, ipc_recv, ipc_reply, ipc_send, ipc_last_msg_len}
    import oskit.services.{sleep, rs_ready, svc_get_thread_pid, svc_grant_create, svc_grant_revoke, svc_grant_map, svc_grant_unmap, thread_id, notify_send_to, GRANT_READ}
    import oskit.config.MAX_PROCESSES

Open file table. Each open file tracks inode, position, mount
index, and reference count. A slot is free when refcount is 0.

    val VFS_MAX_OPEN_FILES = 32
    val OFT_TYPE_FILE        = 0
    val OFT_TYPE_TTY         = 1
    val OFT_TYPE_PIPE        = 2
    val OFT_TYPE_TCP         = 3
    val OFT_TYPE_TCP_LISTEN  = 4

    var oft_ino: [32]int
    var oft_pos: [32]int
    var oft_mount: [32]int
    var oft_ref: [32]int
    var oft_type: [32]int
    var oft_console: [32]int
    var oft_pipe_id: [32]int
    var oft_pipe_write: [32]int
    var oft_tcp_fd: [32]int
    // Per-OFT monotonic fire counter — bumped by `vfs_epoll_fire`
    // and returned in VFS_CMD_POLL replies so the shim's per-entry
    // EPOLLET tracker can detect "this fd actually fired" without
    // a per-instance bulk last_reported clear.
    var oft_fire_seq: [32]int
    // Phase 2B chunk 4 — in-flight SCM_RIGHTS references on this
    // OFT entry. Bumped by the sender shim before SENDMSG (via
    // VFS_CMD_OFT_QUEUE_REF_BY_HANDLE), dropped by the receiver
    // shim after a successful REGISTER_FD_BY_OFT, or by the unix
    // server's drop-on-close path on abandoned pending_scm tuples.
    // OFT teardown waits for both `oft_ref + queued_refs == 0`.
    var oft_queued_refs: [32]int

Pipe infrastructure. Each pipe is a 512-byte circular buffer
managed entirely within VFS. Deferred-reply pattern: when a
reader reads from an empty pipe, VFS saves its TID and does
not reply until a writer provides data (or write end closes).

    val MAX_PIPES = 4
    val PIPE_BUF_SIZE = 512

Phase A2: epoll subscriber table for VFS-backed fds (pipes, TTY,
regular files). Mirrors `inet_proto`'s `inet_epoll_subs` table.
Each subscription is keyed on `(oft_idx, owner_tid, epoll_inst)`;
the readiness scan re-queries `vfs_oft_poll_bits(oft_idx)` after
a notify wake. Pipe writes/reads/closes call `vfs_epoll_fire`
on the appropriate oft so non-blocking readers/writers wake on
the edge instead of polling.

    val VFS_MAX_EPOLL_SUBS = 32

    var vfs_epoll_oft:        [32]int
    var vfs_epoll_owner_tid:  [32]int
    var vfs_epoll_inst:       [32]int
    var vfs_epoll_in_use:     [32]int

    val POSIX_EPOLLIN_BIT   = 0x0001
    val POSIX_EPOLLOUT_BIT  = 0x0004
    val POSIX_EPOLLERR_BIT  = 0x0008
    val POSIX_EPOLLHUP_BIT  = 0x0010

    var pipe_buf: [4][512]byte
    var pipe_head: [4]int
    var pipe_tail: [4]int
    var pipe_count: [4]int
    var pipe_read_oft: [4]int
    var pipe_write_oft: [4]int
    var pipe_reader_tid: [4]int
    var pipe_reader_buf: [4]int
    var pipe_reader_len: [4]int
    var pipe_reader_grant: [4]int

Allocate an open file table entry. Returns the file ID (index),
or -1 if the table is full.

    vfs_oft_alloc(ino: int, mount_idx: int, ftype: int) -> int
        var i = 0
        while i < VFS_MAX_OPEN_FILES
            if oft_ref[i] == 0
                if oft_queued_refs[i] == 0
                    oft_ino[i] = ino
                    oft_pos[i] = 0
                    oft_mount[i] = mount_idx
                    oft_ref[i] = 1
                    oft_type[i] = ftype
                    oft_console[i] = 0
                    // A recycled OFT slot must start at 0 so the new
                    // user's first POLL doesn't think the previous
                    // owner's edges belonged to them.
                    oft_fire_seq[i] = 0
                    return i
            i += 1
        -1

Free an open file table entry. When a pipe end's refcount
reaches 0, mark that end as closed and wake blocked readers.

    vfs_oft_free(fid: int)
        if fid >= 0
            if fid < VFS_MAX_OPEN_FILES
                oft_ref[fid] -= 1
                if oft_ref[fid] <= 0
                    // Phase 2B chunk 4 — defer the type-specific
                    // close-end actions while an in-flight SCM_RIGHTS
                    // tuple holds a queued ref. The matching
                    // `VFS_CMD_OFT_QUEUE_REF(-1)` runs the same
                    // close-end path when refs hit 0.
                    if oft_queued_refs[fid] == 0
                        if oft_type[fid] == OFT_TYPE_PIPE
                            vfs_pipe_close_end(fid)
                        else if oft_type[fid] == OFT_TYPE_TCP
                            vfs_tcp_close_end(fid)
                        else if oft_type[fid] == OFT_TYPE_TCP_LISTEN
                            vfs_tcp_close_end(fid)

Compute readiness bits for a given oft_idx. Used both by the
shim's `VFS_CMD_POLL` query and by `vfs_epoll_fire` to skip
notifications when the readiness state didn't actually change
between callers. Regular files are always-ready (matches Linux
`poll(2)` semantics for ordinary files); pipes derive
EPOLLIN/EPOLLOUT/EPOLLHUP from the buffer count and peer-end
state; TTYs are output-ready and never input-ready (we don't
yet route TTY input through a subscriber path — see project
`musl_phase2_posix_fd_bridge`); TCP/TCP_LISTEN delegate to
inet via the existing `INET_CMD_POLL`.

    vfs_oft_poll_bits(oft_idx: int) -> int
        if oft_idx < 0
            return POSIX_EPOLLERR_BIT
        if oft_idx >= VFS_MAX_OPEN_FILES
            return POSIX_EPOLLERR_BIT
        if oft_ref[oft_idx] <= 0
            return POSIX_EPOLLERR_BIT
        val t = oft_type[oft_idx]
        if t == OFT_TYPE_FILE
            return POSIX_EPOLLIN_BIT | POSIX_EPOLLOUT_BIT
        if t == OFT_TYPE_TTY
            return POSIX_EPOLLOUT_BIT
        if t == OFT_TYPE_PIPE
            val pipe_id = oft_pipe_id[oft_idx]
            var bits = 0
            if oft_pipe_write[oft_idx] == 1
                // Write end: EPOLLOUT when there's space; HUP when
                // peer (read end) closed.
                if pipe_count[pipe_id] < PIPE_BUF_SIZE
                    bits = bits | POSIX_EPOLLOUT_BIT
                if pipe_read_oft[pipe_id] == -1
                    bits = bits | POSIX_EPOLLHUP_BIT | POSIX_EPOLLERR_BIT
            else
                // Read end: EPOLLIN when there's data; HUP when peer
                // (write end) closed AND buffer is drained.
                if pipe_count[pipe_id] > 0
                    bits = bits | POSIX_EPOLLIN_BIT
                if pipe_write_oft[pipe_id] == -1
                    bits = bits | POSIX_EPOLLHUP_BIT
                    if pipe_count[pipe_id] == 0
                        bits = bits | POSIX_EPOLLIN_BIT
            return bits
        // TCP / TCP_LISTEN: defer to inet (handled by the shim's
        // direct INET_CMD_POLL path; VFS_CMD_POLL on these isn't a
        // current code path but report not-ready as a safe default).
        0


Walk the subscriber table and wake every owner_tid registered for
`oft_idx`. Called from pipe writes/reads/closes — any state change
that could flip a readiness bit must call this so non-blocking
clients waiting in `epoll_pwait` see the edge.

    vfs_epoll_fire(oft_idx: int)
        // Bump the per-OFT fire counter so the shim's per-entry
        // last_seen_seq tracker can recognise "this fd just fired"
        // even when other fds in the same epoll instance also
        // got notified between waits.
        if oft_idx >= 0 && oft_idx < VFS_MAX_OPEN_FILES
            oft_fire_seq[oft_idx] = oft_fire_seq[oft_idx] + 1
        var i = 0
        while i < VFS_MAX_EPOLL_SUBS
            if vfs_epoll_in_use[i] != 0
                if vfs_epoll_oft[i] == oft_idx
                    notify_send_to(vfs_epoll_owner_tid[i], 1)
            i += 1

    vfs_epoll_init()
        var i = 0
        while i < VFS_MAX_EPOLL_SUBS
            vfs_epoll_in_use[i] = 0
            i += 1

    vfs_epoll_find_sub(oft_idx: int, owner_tid: int, inst: int) -> int
        var i = 0
        while i < VFS_MAX_EPOLL_SUBS
            if vfs_epoll_in_use[i] != 0
                if vfs_epoll_oft[i] == oft_idx
                    if vfs_epoll_owner_tid[i] == owner_tid
                        if vfs_epoll_inst[i] == inst
                            return i
            i += 1
        -1

    vfs_epoll_alloc_sub() -> int
        var i = 0
        while i < VFS_MAX_EPOLL_SUBS
            if vfs_epoll_in_use[i] == 0
                return i
            i += 1
        -1

    vfs_epoll_drop_inst(owner_tid: int, inst: int)
        var i = 0
        while i < VFS_MAX_EPOLL_SUBS
            if vfs_epoll_in_use[i] != 0
                if vfs_epoll_owner_tid[i] == owner_tid
                    if vfs_epoll_inst[i] == inst
                        vfs_epoll_in_use[i] = 0
            i += 1

    vfs_epoll_drop_owner(owner_tid: int)
        var i = 0
        while i < VFS_MAX_EPOLL_SUBS
            if vfs_epoll_in_use[i] != 0
                if vfs_epoll_owner_tid[i] == owner_tid
                    vfs_epoll_in_use[i] = 0
            i += 1


Per-process handle table. Each process has up to MAX_HANDLES
entries. A handle maps to an open file table index. The table
is stored as a flat array indexed by (pid * MAX_HANDLES + handle).
Entries are initialized to -1 (unused) at server startup.

    val VFS_MAX_HANDLES = 16

    // 16 processes * 16 handles = 256 entries
    var handle_oft: [256]int
    var handle_inited = 0

    vfs_handle_init()
        var i = 0
        while i < 256
            handle_oft[i] = -1
            i += 1
        handle_inited = 1

Allocate a handle for a process. Returns the handle number,
or -1 if the table is full.

    vfs_handle_alloc(pid: int, oft_idx: int) -> int
        val base = pid * VFS_MAX_HANDLES
        var i = 0
        while i < VFS_MAX_HANDLES
            if handle_oft[base + i] == -1
                handle_oft[base + i] = oft_idx
                return i
            i += 1
        -1

Close a handle. Decrements the open file refcount and frees
the handle slot.

    vfs_handle_close(pid: int, handle: int)
        if handle < 0
            return
        if handle >= VFS_MAX_HANDLES
            return
        val slot = pid * VFS_MAX_HANDLES + handle
        val oft_idx = handle_oft[slot]
        if oft_idx >= 0
            vfs_oft_free(oft_idx)
            handle_oft[slot] = -1

Look up a handle. Returns the open file table index, or -1.

    vfs_handle_lookup(pid: int, handle: int) -> int
        if handle < 0
            return -1
        if handle >= VFS_MAX_HANDLES
            return -1
        handle_oft[pid * VFS_MAX_HANDLES + handle]

Close all handles for a process (called on process exit).

    vfs_handle_close_all(pid: int)
        val base = pid * VFS_MAX_HANDLES
        var i = 0
        while i < VFS_MAX_HANDLES
            val oft_idx = handle_oft[base + i]
            if oft_idx >= 0
                vfs_oft_free(oft_idx)
                handle_oft[base + i] = -1
            i += 1

Initialize pipe state at startup.

    vfs_pipe_init()
        var i = 0
        while i < MAX_PIPES
            pipe_read_oft[i] = -1
            pipe_write_oft[i] = -1
            pipe_reader_tid[i] = -1
            i += 1

Allocate a pipe slot. Returns pipe index or -1 if full.

    vfs_pipe_alloc() -> int
        var i = 0
        while i < MAX_PIPES
            if pipe_read_oft[i] == -1
                if pipe_write_oft[i] == -1
                    return i
            i += 1
        -1

Handle VFS_CMD_PIPE: create a pipe and return two handles.
Request: [cmd(1)]. Response: [status(1), read_handle(4), write_handle(4)].

    vfs_handle_pipe(sender: int)
        val pid = svc_get_thread_pid(sender)
        val pipe_id = vfs_pipe_alloc()
        if pipe_id < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        val read_oft = vfs_oft_alloc(pipe_id, 0, OFT_TYPE_PIPE)
        if read_oft < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val write_oft = vfs_oft_alloc(pipe_id, 0, OFT_TYPE_PIPE)
        if write_oft < 0
            vfs_oft_free(read_oft)
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        oft_pipe_id[read_oft] = pipe_id
        oft_pipe_write[read_oft] = 0
        oft_pipe_id[write_oft] = pipe_id
        oft_pipe_write[write_oft] = 1

        pipe_head[pipe_id] = 0
        pipe_tail[pipe_id] = 0
        pipe_count[pipe_id] = 0
        pipe_read_oft[pipe_id] = read_oft
        pipe_write_oft[pipe_id] = write_oft
        pipe_reader_tid[pipe_id] = -1

        val rh = vfs_handle_alloc(pid, read_oft)
        val wh = vfs_handle_alloc(pid, write_oft)

        var reply: [9]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, rh)
        vfs_msg_write_i32(reply, 5, wh)
        ipc_reply(sender, reply, 9)

Read from a pipe. Blocks if empty and write end open.

    vfs_pipe_read(sender: int, fid: int, grant_id: int, req_len: int)
        val pipe_id = oft_pipe_id[fid]
        val avail = pipe_count[pipe_id]

        if avail > 0
            var n = req_len
            if n > avail
                n = avail
            if n > PIPE_BUF_SIZE
                n = PIPE_BUF_SIZE

            val mapped = svc_grant_map(grant_id, 0, n)
            if mapped > 0
                var dst: *byte = *byte(mapped)
                val head = pipe_head[pipe_id]
                var copied = 0
                while copied < n
                    dst[copied] = pipe_buf[pipe_id][(head + copied) & (PIPE_BUF_SIZE - 1)]
                    copied += 1
                pipe_head[pipe_id] = (head + n) & (PIPE_BUF_SIZE - 1)
                pipe_count[pipe_id] = avail - n
                svc_grant_unmap(grant_id)

            // Wake any epoll subscribers on the write-end oft so a
            // non-blocking writer stuck on EPOLLOUT sees the freed
            // buffer space.
            if pipe_write_oft[pipe_id] >= 0
                vfs_epoll_fire(pipe_write_oft[pipe_id])

            var reply: [5]byte
            reply[0] = 0
            vfs_msg_write_i32(reply, 1, n)
            ipc_reply(sender, reply, 5)
            return

        if pipe_write_oft[pipe_id] == -1
            var reply: [5]byte
            reply[0] = 0
            vfs_msg_write_i32(reply, 1, 0)
            ipc_reply(sender, reply, 5)
            return

        pipe_reader_tid[pipe_id] = sender
        pipe_reader_buf[pipe_id] = 0
        pipe_reader_len[pipe_id] = req_len
        pipe_reader_grant[pipe_id] = grant_id

Write to a pipe. Wakes any deferred reader.

    vfs_pipe_write(sender: int, fid: int, grant_id: int, req_len: int, vfs_buf: *byte)
        val pipe_id = oft_pipe_id[fid]

        if pipe_read_oft[pipe_id] == -1
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        val space = PIPE_BUF_SIZE - pipe_count[pipe_id]
        var n = req_len
        if n > space
            n = space
        if n > PIPE_BUF_SIZE
            n = PIPE_BUF_SIZE

        val tail = pipe_tail[pipe_id]
        if grant_id == -1
            // Inline fast path — payload at vfs_buf+13
            var copied = 0
            while copied < n
                pipe_buf[pipe_id][(tail + copied) & (PIPE_BUF_SIZE - 1)] = vfs_buf[13 + copied]
                copied += 1
        else
            val mapped = svc_grant_map(grant_id, 0, n)
            if mapped <= 0
                var reply: [5]byte
                reply[0] = -1
                ipc_reply(sender, reply, 5)
                return
            var src: *byte = *byte(mapped)
            var copied = 0
            while copied < n
                pipe_buf[pipe_id][(tail + copied) & (PIPE_BUF_SIZE - 1)] = src[copied]
                copied += 1
            svc_grant_unmap(grant_id)
        pipe_tail[pipe_id] = (tail + n) & (PIPE_BUF_SIZE - 1)
        pipe_count[pipe_id] += n

        if pipe_reader_tid[pipe_id] >= 0
            vfs_pipe_wake_reader(pipe_id)

        // Wake any epoll subscribers on the read-end oft so a
        // non-blocking reader stuck in epoll_pwait sees EPOLLIN
        // without having to re-poll.
        if pipe_read_oft[pipe_id] >= 0
            vfs_epoll_fire(pipe_read_oft[pipe_id])

        var reply: [5]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, n)
        ipc_reply(sender, reply, 5)

Wake a deferred reader.

    vfs_pipe_wake_reader(pipe_id: int)
        val avail = pipe_count[pipe_id]
        if avail <= 0
            return
        val reader = pipe_reader_tid[pipe_id]
        if reader < 0
            return

        var n = pipe_reader_len[pipe_id]
        if n > avail
            n = avail
        if n > PIPE_BUF_SIZE
            n = PIPE_BUF_SIZE

        val mapped = svc_grant_map(pipe_reader_grant[pipe_id], pipe_reader_buf[pipe_id], n)
        if mapped > 0
            var dst: *byte = *byte(mapped)
            val head = pipe_head[pipe_id]
            var copied = 0
            while copied < n
                dst[copied] = pipe_buf[pipe_id][(head + copied) & (PIPE_BUF_SIZE - 1)]
                copied += 1
            pipe_head[pipe_id] = (head + n) & (PIPE_BUF_SIZE - 1)
            pipe_count[pipe_id] -= n
            svc_grant_unmap(pipe_reader_grant[pipe_id])

        var reply: [5]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, n)
        ipc_reply(reader, reply, 5)
        pipe_reader_tid[pipe_id] = -1

Resolve a per-process handle to its oft index.
Used by the epoll bridge — the shim ships a VFS handle, we look
up the oft to key the subscription on. Returns -1 on miss so
callers can short-circuit with -EBADF.

    vfs_resolve_handle_to_oft(sender: int, handle: int) -> int
        val pid = svc_get_thread_pid(sender)
        vfs_handle_lookup(pid, handle)


Handle VFS_CMD_POLL: report current readiness bits for a handle.
Request:  [cmd(1), handle_be(4)]
Reply:    [status(1), bits_le_u16(2), fire_seq_le_u32(4)] = 7 bytes.

`bits` is little-endian u16 (matches the `epoll_event.events`
on-the-wire format already used by the shim). `fire_seq` is the
per-OFT monotonic counter that `vfs_epoll_fire` bumps — see
the same field on the inet POLL reply for the rationale. Status
= 0 on success, -EBADF on bad handle.

    vfs_handle_poll(sender: int, buf: *byte)
        val handle = vfs_msg_read_i32(buf, 1)
        val oft = vfs_resolve_handle_to_oft(sender, handle)
        var reply: [7]byte
        if oft < 0
            reply[0] = byte(-9)             // -EBADF
            ipc_reply(sender, reply, 7)
            return
        val bits = vfs_oft_poll_bits(oft)
        val seq = oft_fire_seq[oft]
        reply[0] = 0
        reply[1] = byte(bits & 0xff)
        reply[2] = byte((bits >> 8) & 0xff)
        reply[3] = byte(seq & 0xff)
        reply[4] = byte((seq >> 8) & 0xff)
        reply[5] = byte((seq >> 16) & 0xff)
        reply[6] = byte((seq >> 24) & 0xff)
        ipc_reply(sender, reply, 7)


Handle VFS_CMD_EPOLL_SUB: register an epoll subscription on
a handle. Idempotent — duplicate `(oft, owner_tid, inst)`
tuples are no-op success so the shim can call SUB on every
EPOLL_CTL_ADD/MOD without de-dup logic.
Request:  [cmd(1), handle_be(4), inst(1)]
Reply:    [status(1)]

    vfs_handle_epoll_sub(sender: int, buf: *byte)
        val handle = vfs_msg_read_i32(buf, 1)
        val inst = int(buf[5]) & 0xff
        var reply: [1]byte
        val oft = vfs_resolve_handle_to_oft(sender, handle)
        if oft < 0
            reply[0] = byte(-9)
            ipc_reply(sender, reply, 1)
            return
        val existing = vfs_epoll_find_sub(oft, sender, inst)
        if existing >= 0
            reply[0] = 0
            ipc_reply(sender, reply, 1)
            return
        val slot = vfs_epoll_alloc_sub()
        if slot < 0
            reply[0] = byte(-28)            // -ENOSPC
            ipc_reply(sender, reply, 1)
            return
        vfs_epoll_oft[slot] = oft
        vfs_epoll_owner_tid[slot] = sender
        vfs_epoll_inst[slot] = inst
        vfs_epoll_in_use[slot] = 1
        reply[0] = 0
        ipc_reply(sender, reply, 1)


Handle VFS_CMD_EPOLL_UNSUB. Drop a single subscription if it
exists; missing tuples are a no-op success.

    vfs_handle_epoll_unsub(sender: int, buf: *byte)
        val handle = vfs_msg_read_i32(buf, 1)
        val inst = int(buf[5]) & 0xff
        var reply: [1]byte
        val oft = vfs_resolve_handle_to_oft(sender, handle)
        if oft >= 0
            val slot = vfs_epoll_find_sub(oft, sender, inst)
            if slot >= 0
                vfs_epoll_in_use[slot] = 0
        reply[0] = 0
        ipc_reply(sender, reply, 1)


Handle VFS_CMD_EPOLL_INST_CLOSE. Drop every subscription
belonging to a `(sender, inst)` pair in one IPC — saves the
shim from looping with UNSUB when the epoll fd itself closes.

    vfs_handle_epoll_inst_close(sender: int, buf: *byte)
        val inst = int(buf[1]) & 0xff
        vfs_epoll_drop_inst(sender, inst)
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, reply, 1)


Handle pipe end close.

    vfs_pipe_close_end(fid: int)
        val pipe_id = oft_pipe_id[fid]
        if oft_pipe_write[fid] == 1
            pipe_write_oft[pipe_id] = -1
            if pipe_reader_tid[pipe_id] >= 0
                var reply: [5]byte
                reply[0] = 0
                vfs_msg_write_i32(reply, 1, 0)
                ipc_reply(pipe_reader_tid[pipe_id], reply, 5)
                pipe_reader_tid[pipe_id] = -1
            // Surviving read end: peer closed → EPOLLHUP edge.
            if pipe_read_oft[pipe_id] >= 0
                vfs_epoll_fire(pipe_read_oft[pipe_id])
        else
            pipe_read_oft[pipe_id] = -1
            // Surviving write end: peer closed → EPOLLERR/HUP edge.
            if pipe_write_oft[pipe_id] >= 0
                vfs_epoll_fire(pipe_write_oft[pipe_id])

Scheme registry. Maps scheme names to handler ports. When a
client calls connect("scheme:resource"), VFS looks up the scheme
and forwards the OPEN to the handler. Paths without a scheme
prefix (or with "vfs:") default to the filesystem.

    val VFS_MAX_SCHEMES = 8

    var scheme_port: [8]int
    var scheme_name_len: [8]int
    var scheme_names: [64]byte
    var scheme_count = 0

Register a scheme handler. The name is stored packed (8 bytes
per entry) in scheme_names.

    vfs_register_scheme(name: *byte, name_len: int, port: int) -> int
        if scheme_count >= VFS_MAX_SCHEMES
            return -1
        val idx = scheme_count
        scheme_port[idx] = port
        scheme_name_len[idx] = name_len
        val base = idx * 8
        var i = 0
        while i < name_len
            if i >= 8
                break
            scheme_names[base + i] = name[i]
            i += 1
        scheme_count += 1
        0

Look up a scheme by name. Returns the handler port, or -1.

    vfs_lookup_scheme(name: *byte, name_len: int) -> int
        var i = 0
        while i < scheme_count
            if scheme_name_len[i] == name_len
                val base = i * 8
                var j = 0
                var ok = 1
                while j < name_len
                    if name[j] != scheme_names[base + j]
                        ok = 0
                        break
                    j += 1
                if ok == 1
                    return scheme_port[i]
            i += 1
        -1

Mount table. Each entry maps a path prefix to a backend port.

    val VFS_MAX_MOUNTS = 8

    var mount_port: [8]int
    var mount_prefix_len: [8]int
    var mount_prefix: [256]byte
    var mount_count = 0

VFS port and name.

    var vfs_port = -1

TFS backend port (cached).

    var vfs_tfs_port = -1

    vfs_lookup_tfs() -> int
        if vfs_tfs_port < 0
            vfs_tfs_port = port_lookup("tfs")
        vfs_tfs_port

Mount a filesystem backend at a path prefix. Prefix strings
are packed 32 bytes apart in the `mount_prefix` array.

    vfs_mount(prefix: *byte, prefix_len: int, port: int) -> int
        if mount_count >= VFS_MAX_MOUNTS
            return -1
        val idx = mount_count
        mount_port[idx] = port
        mount_prefix_len[idx] = prefix_len
        val base = idx * 32
        var i = 0
        while i < prefix_len
            mount_prefix[base + i] = prefix[i]
            i += 1
        mount_prefix[base + prefix_len] = 0
        mount_count += 1
        0

Resolve a path to a backend port. Returns the port of the
longest-matching mount prefix, or -1 if no match.

    vfs_resolve(path: *byte, path_len: int) -> int
        var best_port = -1
        var best_len = -1
        var i = 0
        while i < mount_count
            val plen = mount_prefix_len[i]
            if plen <= path_len
                if plen > best_len
                    val base = i * 32
                    var j = 0
                    var ok = 1
                    while j < plen
                        if path[j] != mount_prefix[base + j]
                            ok = 0
                            break
                        j += 1
                    if ok == 1
                        best_port = mount_port[i]
                        best_len = plen
            i += 1
        best_port

Determine reply length for a command. On error (status != 0),
reply is always 1 byte. On success, length depends on command.

    val VFS_CMD_OPEN    = 1
    val VFS_CMD_READ    = 2
    val VFS_CMD_WRITE   = 3
    val VFS_CMD_CREATE  = 4
    val VFS_CMD_UNLINK  = 5
    val VFS_CMD_STAT    = 6
    val VFS_CMD_MKDIR   = 7
    val VFS_CMD_RMDIR   = 8
    val VFS_CMD_READDIR = 9
    val VFS_CMD_SYNC    = 10
    val VFS_CMD_CHMOD   = 11
    val VFS_CMD_RENAME  = 12
    val VFS_CMD_CLOSE   = 13
    val VFS_CMD_SEEK    = 14
    val VFS_CMD_CONNECT = 15
    val VFS_CMD_INHERIT = 16
    val VFS_CMD_EXIT    = 17
    val VFS_CMD_PIPE    = 18
    val VFS_CMD_ACCEPT  = 19
    // Phase A2 epoll bridge — mirrors INET_CMD_EPOLL_*.
    val VFS_CMD_POLL              = 20
    val VFS_CMD_EPOLL_SUB         = 21
    val VFS_CMD_EPOLL_UNSUB       = 22
    val VFS_CMD_EPOLL_INST_CLOSE  = 23
    // Phase 4 chunk 2 — fstat by handle. Same reply shape as STAT.
    val VFS_CMD_FSTAT   = 24
    // Phase 2B chunk 1 — dup a handle from one process into another,
    // sharing the same OFT entry. Used by `posix_fd_transplant` for
    // POSIX_FD_FILE and (Phase 2B chunk 2) by the receiver shim when
    // draining SCM_RIGHTS. Mints a fresh dst-side handle and bumps
    // `oft_ref`. Caller is trusted (kernel-side path) — no auth check.
    val VFS_CMD_DUP_HANDLE = 25
    // Phase 2B chunk 4 — in-flight SCM_RIGHTS ref-counting on OFT
    // entries. `OFT_QUEUE_REF_BY_HANDLE` resolves a (src_pid,
    // src_handle) pair to an OFT idx and applies a ±1 delta to
    // `oft_queued_refs`. The receiver shim later balances the +1
    // via `OFT_QUEUE_REF`, and `REGISTER_FD_BY_OFT` mints a fresh
    // dst-pid handle bound to the same OFT (oft_ref bumped, queued
    // ref left alone).
    val VFS_CMD_OFT_QUEUE_REF_BY_HANDLE = 26
    val VFS_CMD_OFT_QUEUE_REF           = 27
    val VFS_CMD_REGISTER_FD_BY_OFT      = 28

    // Phase 0a (post-2B) — handle-based truncate. Resolves the
    // (pid, handle) pair to an OFT entry, then forwards
    // TFS_CMD_TRUNCATE to the backend with the OFT's inode + the
    // requested new size. Used by `sys_ftruncate` and by
    // `sys_openat`'s O_TRUNC path.
    val VFS_CMD_TRUNCATE = 29

    // Phase 0e — symlink primitive. SYMLINK creates an S_IFLNK
    // inode with the target stored as inline data. READLINK reads
    // the target back. TFS does NOT auto-follow symlinks during
    // path resolution; the shim handles that when it lands a real
    // POSIX symlink layer.
    val VFS_CMD_SYMLINK  = 30
    val VFS_CMD_READLINK = 31

    // Phase 1 chunk — getdents64 enablement. Handle-based READDIR
    // for `opendir → readdir → readdir → ...` loops. The path-based
    // VFS_CMD_READDIR exists as the lower-level primitive but
    // re-resolving the path on every entry would be O(n²) for a
    // directory of n entries. The handle variant reuses the OFT's
    // stored inode (set at open() time) so each call is a single
    // TFS_CMD_READDIR lookup. Cursor (index) is kept by the shim
    // per-fd, not by VFS — VFS is stateless across calls.
    val VFS_CMD_READDIR_H = 32

    vfs_reply_len(cmd: int, status: int) -> int
        if status != 0
            return 1
        if cmd == VFS_CMD_OPEN
            return 9
        if cmd == VFS_CMD_READ
            return 5
        if cmd == VFS_CMD_WRITE
            return 5
        if cmd == VFS_CMD_CREATE
            return 5
        if cmd == VFS_CMD_STAT
            return 29
        if cmd == VFS_CMD_FSTAT
            return 29
        if cmd == VFS_CMD_MKDIR
            return 5
        if cmd == VFS_CMD_READDIR
            return 19
        if cmd == VFS_CMD_SEEK
            return 5
        if cmd == VFS_CMD_PIPE
            return 9
        if cmd == VFS_CMD_ACCEPT
            return 11
        if cmd == VFS_CMD_POLL
            return 3
        if cmd == VFS_CMD_DUP_HANDLE
            return 5
        if cmd == VFS_CMD_OFT_QUEUE_REF_BY_HANDLE
            return 5
        if cmd == VFS_CMD_OFT_QUEUE_REF
            return 1
        if cmd == VFS_CMD_REGISTER_FD_BY_OFT
            return 5
        if cmd == VFS_CMD_TRUNCATE
            return 1
        1

Big-endian message helpers (local to VFS).

    vfs_msg_read_i32(buf: *byte, off: int) -> int
        ((buf[off] & 0xFF) << 24) | ((buf[off + 1] & 0xFF) << 16) | ((buf[off + 2] & 0xFF) << 8) | (buf[off + 3] & 0xFF)

    vfs_msg_write_i32(buf: *byte, off: int, v: int)
        buf[off] = (v >> 24) & 0xFF
        buf[off + 1] = (v >> 16) & 0xFF
        buf[off + 2] = (v >> 8) & 0xFF
        buf[off + 3] = v & 0xFF

Handle OPEN: resolve path via TFS, allocate open file entry
and per-process handle, return handle and inode to client.
Client request:  [cmd(1), path(N)]
Client reply:    [status(1), handle(4), ino(4)]

    vfs_handle_open(sender: int, buf: *byte, msg_len: int, backend: int)
        val pid = svc_get_thread_pid(sender)
        // Forward OPEN to TFS to get inode
        var be_reply: [64]byte
        ipc_send(backend, buf, msg_len, be_reply, 64)
        if be_reply[0] != 0
            // Status 1 = ENOENT (path not found in backend). Distinct
            // from status 2 (EMFILE, OFT/handle exhaustion) so the
            // shim can map each surface to the correct errno without
            // tripping the O_CREAT-then-retry path on a transient
            // resource shortage.
            var err: [1]byte
            err[0] = byte(1)
            ipc_reply(sender, err, 1)
            return
        val ino = vfs_msg_read_i32(be_reply, 1)
        // Allocate open file entry
        val oft_idx = vfs_oft_alloc(ino, 0, OFT_TYPE_FILE)
        if oft_idx < 0
            var err: [1]byte
            err[0] = byte(2)
            ipc_reply(sender, err, 1)
            return
        // Allocate per-process handle
        val handle = vfs_handle_alloc(pid, oft_idx)
        if handle < 0
            vfs_oft_free(oft_idx)
            var err: [1]byte
            err[0] = byte(2)
            ipc_reply(sender, err, 1)
            return
        // Reply with handle and ino
        var reply: [9]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, handle)
        vfs_msg_write_i32(reply, 5, ino)
        ipc_reply(sender, reply, 9)

Handle CONNECT: parse scheme prefix, route to handler.
Client request:  [cmd(1), name(N)]
Client reply:    [status(1), handle(4), ino(4)]

If the name contains ":", the part before it is the scheme and
the part after is the resource. Paths starting with "/" or names
without a scheme default to the "vfs" (filesystem) handler.

    vfs_handle_connect(sender: int, buf: *byte, msg_len: int, backend: int)
        val name: *byte = buf + 1
        val name_len = msg_len - 1

        // Find scheme separator ":"
        var colon = -1
        var i = 0
        while i < name_len
            if name[i] == 58  // ':'
                colon = i
                break
            i += 1

        if colon <= 0
            // No scheme or starts with "/" — default to filesystem open
            vfs_handle_open(sender, buf, msg_len, backend)
            return

        // Check for "tty" scheme
        if colon == 3
            if name[0] == 116  // t
                if name[1] == 116  // t
                    if name[2] == 121  // y
                        vfs_handle_connect_tty(sender, name, colon, name_len)
                        return

        // Check for "tcp" scheme
        if colon == 3
            if name[0] == 116  // t
                if name[1] == 99  // c
                    if name[2] == 112  // p
                        vfs_handle_connect_tcp(sender, name, colon, name_len)
                        return

        // Check for "tcp-listen" scheme
        if colon == 10
            if name[0] == 116 && name[1] == 99 && name[2] == 112 && name[3] == 45
                if name[4] == 108 && name[5] == 105 && name[6] == 115 && name[7] == 116 && name[8] == 101 && name[9] == 110
                    vfs_handle_connect_tcp_listen(sender, name, colon, name_len)
                    return

        // Look up scheme handler
        val handler = vfs_lookup_scheme(name, colon)
        if handler < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return

        // Filesystem scheme — strip prefix, forward as OPEN
        var open_msg: [128]byte
        open_msg[0] = 1  // CMD_OPEN
        val resource_len = name_len - colon - 1
        i = 0
        while i < resource_len
            open_msg[1 + i] = name[colon + 1 + i]
            i += 1
        vfs_handle_open(sender, open_msg, 1 + resource_len, handler)

Handle connect("tty:N") — create a TTY-type open file entry.
No backend OPEN needed; VFS manages TTY handles locally and
forwards read/write to the TTY server.

    vfs_handle_connect_tty(sender: int, name: *byte, colon: int, name_len: int)
        val pid = svc_get_thread_pid(sender)
        // Parse console number (single digit after "tty:")
        var console = 0
        if name_len > colon + 1
            console = int(name[colon + 1]) - 48  // '0'
            if console < 0
                console = 0
            if console > 3
                console = 0

        // Allocate OFT entry (no inode for TTY)
        val oft_idx = vfs_oft_alloc(0, 0, OFT_TYPE_TTY)
        if oft_idx < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        oft_console[oft_idx] = console

        // Allocate per-process handle
        val handle = vfs_handle_alloc(pid, oft_idx)
        if handle < 0
            vfs_oft_free(oft_idx)
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return

        // Reply with handle (ino=0 for TTY)
        var reply: [9]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, handle)
        vfs_msg_write_i32(reply, 5, 0)
        ipc_reply(sender, reply, 9)

Handle connect("tcp:A.B.C.D:P") — parse IPv4 + port, dial inet's
TCP_CONNECT on behalf of the caller, then publish the resulting
socket as a VFS handle so read/write/close go through this server.

Wire format for INET_CMD_TCP_CONNECT (see oskit/servers/inet.lsysl):
  request:  [cmd(1), ip(4), port(2)]
  reply:    [status(1), fd(1)]
The reply is deferred until the 3-way handshake completes, so
VFS's ipc_send blocks here — same pattern as vfs_tty_read.

    vfs_handle_connect_tcp(sender: int, name: *byte, colon: int, name_len: int)
        val pid = svc_get_thread_pid(sender)
        val inet = vfs_lookup_inet()
        if inet < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        // Parse "A.B.C.D:P" starting at offset colon+1
        var i = colon + 1
        var octets: [4]int
        octets[0] = 0
        octets[1] = 0
        octets[2] = 0
        octets[3] = 0
        var oct = 0
        var v = 0
        var ok = 1
        while i < name_len && oct < 4
            val c = int(name[i]) & 0xFF
            if c == 46  // '.'
                if oct >= 3
                    ok = 0
                    break
                octets[oct] = v & 0xFF
                v = 0
                oct += 1
                i += 1
            else if c == 58  // ':'
                break
            else if c >= 48 && c <= 57
                v = v * 10 + (c - 48)
                i += 1
            else
                ok = 0
                break
        if oct != 3
            ok = 0
        octets[3] = v & 0xFF

        // Expect ':' then decimal port
        if ok != 0
            if i >= name_len
                ok = 0
            else if int(name[i]) != 58
                ok = 0
        var port = 0
        if ok != 0
            i += 1
            if i >= name_len
                ok = 0
        if ok != 0
            while i < name_len
                val c2 = int(name[i]) & 0xFF
                if c2 < 48 || c2 > 57
                    ok = 0
                    break
                port = port * 10 + (c2 - 48)
                i += 1
            if port <= 0 || port > 65535
                ok = 0

        if ok == 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        // Send INET_CMD_TCP_CONNECT. Reply is deferred by inet until
        // ESTABLISHED, so ipc_send blocks VFS — one TCP connect at a
        // time per VFS, matching our single-threaded server pattern.
        // Wire is 11 bytes since Phase E (sndbuf/rcvbuf trailer; the
        // VFS bridge always asks for inet defaults).
        var msg: [11]byte
        msg[0] = 10  // INET_CMD_TCP_CONNECT
        msg[1] = byte(octets[0])
        msg[2] = byte(octets[1])
        msg[3] = byte(octets[2])
        msg[4] = byte(octets[3])
        msg[5] = byte((port >> 8) & 0xFF)
        msg[6] = byte(port & 0xFF)
        msg[7] = 0
        msg[8] = 0
        msg[9] = 0
        msg[10] = 0
        var icreply: [2]byte
        ipc_send(inet, msg, 11, icreply, 2)
        if icreply[0] != 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val tcp_fd = int(icreply[1]) & 0xFF

        val oft_idx = vfs_oft_alloc(0, 0, OFT_TYPE_TCP)
        if oft_idx < 0
            // Socket leaks on inet side — acceptable, callers rarely
            // hit OFT exhaustion and the inet slot frees on FIN.
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        oft_tcp_fd[oft_idx] = tcp_fd

        val handle = vfs_handle_alloc(pid, oft_idx)
        if handle < 0
            vfs_oft_free(oft_idx)
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        var reply: [9]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, handle)
        vfs_msg_write_i32(reply, 5, 0)
        ipc_reply(sender, reply, 9)

Inet server port (cached, looked up lazily; may remain -1 on
builds without inet, in which case connect("tcp:...") errors
and FS_CMD_READ/WRITE on a phantom TCP handle short-circuit).

    var vfs_inet_port = -1

    vfs_lookup_inet() -> int
        if vfs_inet_port < 0
            vfs_inet_port = port_lookup("inet")
        vfs_inet_port

Forward FS_CMD_READ on a TCP handle to INET_CMD_TCP_RECV. Blocks
VFS's server loop while inet defers the reply (data arrival or
peer FIN). On wake, copy up to `len` bytes from inet's reply buf
through the caller's grant.

Wire: request [cmd(1), fd(2), maxlen(2)], reply [status(1), len(2), data].
`len == 0` with `status == 0` means peer closed (EOF).

    vfs_tcp_read(sender: int, fid: int, grant_id: int, len: int)
        val inet = vfs_lookup_inet()
        if inet < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        var maxlen = len
        if maxlen > 480
            maxlen = 480
        if maxlen < 0
            maxlen = 0
        val tcp_fd = oft_tcp_fd[fid]
        var msg: [5]byte
        msg[0] = 12  // INET_CMD_TCP_RECV
        msg[1] = byte((tcp_fd >> 8) & 0xFF)
        msg[2] = byte(tcp_fd & 0xFF)
        msg[3] = byte((maxlen >> 8) & 0xFF)
        msg[4] = byte(maxlen & 0xFF)
        var icreply: [540]byte
        ipc_send(inet, msg, 5, icreply, 540)
        if icreply[0] != 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val nread = ((int(icreply[1]) & 0xFF) << 8) | (int(icreply[2]) & 0xFF)
        if nread > 0
            val mapped = svc_grant_map(grant_id, 0, nread)
            if mapped > 0
                var dst: *byte = *byte(mapped)
                var k = 0
                while k < nread
                    dst[k] = icreply[3 + k]
                    k += 1
                svc_grant_unmap(grant_id)
        var reply: [5]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, nread)
        ipc_reply(sender, reply, 5)

Forward FS_CMD_WRITE on a TCP handle to INET_CMD_TCP_SEND. Copies
up to INET_MAX_TCP_SEG (480) bytes from the caller's grant into a
local staging buffer, then sends. Returns bytes buffered by inet.

Wire: request [cmd(1), fd(2), len(2), data], reply [status(1), nsent(2)].

    vfs_tcp_write(sender: int, fid: int, grant_id: int, len: int, vfs_buf: *byte)
        val inet = vfs_lookup_inet()
        if inet < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        var wlen = len
        if wlen > 480
            wlen = 480
        if wlen < 0
            wlen = 0
        val tcp_fd = oft_tcp_fd[fid]
        var msg: [487]byte
        msg[0] = 11  // INET_CMD_TCP_SEND
        msg[1] = byte((tcp_fd >> 8) & 0xFF)
        msg[2] = byte(tcp_fd & 0xFF)
        msg[3] = byte((wlen >> 8) & 0xFF)
        msg[4] = byte(wlen & 0xFF)
        // No SO_SNDTIMEO for vfs forwarder (FS_CMD_WRITE on TCP).
        msg[5] = byte(0)
        msg[6] = byte(0)
        if wlen > 0
            if grant_id == -1
                // Inline payload at vfs_buf+13
                var k = 0
                while k < wlen
                    msg[7 + k] = vfs_buf[13 + k]
                    k += 1
            else
                val mapped = svc_grant_map(grant_id, 0, wlen)
                if mapped <= 0
                    var err: [1]byte
                    err[0] = byte(-1)
                    ipc_reply(sender, err, 1)
                    return
                var src: *byte = *byte(mapped)
                var k = 0
                while k < wlen
                    msg[7 + k] = src[k]
                    k += 1
                svc_grant_unmap(grant_id)
        var icreply: [3]byte
        ipc_send(inet, msg, 7 + wlen, icreply, 3)
        if icreply[0] != 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val nsent = ((int(icreply[1]) & 0xFF) << 8) | (int(icreply[2]) & 0xFF)
        var reply: [5]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, nsent)
        ipc_reply(sender, reply, 5)

Invoked from vfs_oft_free when a TCP OFT slot's refcount hits zero.
Sends INET_CMD_TCP_CLOSE and blocks until inet's close handshake
completes (or errors). Result is ignored — the caller already
replied (or will reply) with status 0 to the user.

    vfs_tcp_close_end(fid: int)
        val inet = vfs_lookup_inet()
        if inet < 0
            return
        val tcp_fd = oft_tcp_fd[fid]
        var msg: [3]byte
        msg[0] = 13  // INET_CMD_TCP_CLOSE
        msg[1] = byte((tcp_fd >> 8) & 0xFF)
        msg[2] = byte(tcp_fd & 0xFF)
        var icreply: [1]byte
        ipc_send(inet, msg, 3, icreply, 1)

Handle connect("tcp-listen:PORT") — parse the local port, bind a
listen socket via INET_CMD_TCP_LISTEN, and publish it as a VFS
handle typed OFT_TYPE_TCP_LISTEN. The returned handle is what the
caller passes to `accept`; it isn't readable/writable directly.
Close on it funnels through vfs_tcp_close_end, which sends
INET_CMD_TCP_CLOSE — inet already handles LISTEN in that path.

Wire for INET_CMD_TCP_LISTEN (oskit/servers/inet.lsysl):
  request:  [cmd(1), port(2), backlog(2)]
  reply:    [status(1), fd(1)]

Caller syntax `connect("tcp-listen:7890")` accepts an optional
backlog after a comma — `connect("tcp-listen:7890,4")` requests
backlog=4. Without the trailer, the default 16 (matches
`tcp_listen` in oskit/net/client.lsysl and inet's
TCP_LISTEN_BACKLOG cap) is used.

    vfs_handle_connect_tcp_listen(sender: int, name: *byte, colon: int, name_len: int)
        val pid = svc_get_thread_pid(sender)
        val inet = vfs_lookup_inet()
        if inet < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        // Parse decimal port after the colon. Stops at the optional
        // ",backlog" separator so the same loop handles both forms.
        var i = colon + 1
        var port = 0
        var ok = 1
        if i >= name_len
            ok = 0
        while i < name_len
            val c = int(name[i]) & 0xFF
            if c == 44   // ','
                break
            if c < 48 || c > 57
                ok = 0
                break
            port = port * 10 + (c - 48)
            i += 1
        if port <= 0 || port > 65535
            ok = 0
        // Optional ",<backlog>" trailer. Caps mirror inet's listen
        // path: 0 → 1 (Linux's "non-positive → 1" rule), >16 → 16
        // (TCP_LISTEN_BACKLOG slot-array cap).
        var backlog = 16
        if ok != 0 && i < name_len
            if int(name[i]) & 0xFF == 44
                i += 1
                var b = 0
                var saw_digit = 0
                while i < name_len
                    val c2 = int(name[i]) & 0xFF
                    if c2 < 48 || c2 > 57
                        ok = 0
                        break
                    b = b * 10 + (c2 - 48)
                    saw_digit = 1
                    i += 1
                if saw_digit == 0
                    ok = 0
                if ok != 0
                    if b < 1
                        b = 1
                    if b > 16
                        b = 16
                    backlog = b
        if ok == 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        // Wire is 9 bytes since Phase E (sndbuf/rcvbuf trailer; VFS
        // listeners always ask for inet defaults).
        var msg: [9]byte
        msg[0] = 14  // INET_CMD_TCP_LISTEN
        msg[1] = byte((port >> 8) & 0xFF)
        msg[2] = byte(port & 0xFF)
        msg[3] = byte((backlog >> 8) & 0xFF)
        msg[4] = byte(backlog & 0xFF)
        msg[5] = 0
        msg[6] = 0
        msg[7] = 0
        msg[8] = 0
        var icreply: [2]byte
        ipc_send(inet, msg, 9, icreply, 2)
        if icreply[0] != 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val tcp_fd = int(icreply[1]) & 0xFF

        val oft_idx = vfs_oft_alloc(0, 0, OFT_TYPE_TCP_LISTEN)
        if oft_idx < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        oft_tcp_fd[oft_idx] = tcp_fd

        val handle = vfs_handle_alloc(pid, oft_idx)
        if handle < 0
            vfs_oft_free(oft_idx)
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        var reply: [9]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, handle)
        vfs_msg_write_i32(reply, 5, 0)
        ipc_reply(sender, reply, 9)

Handle VFS_CMD_ACCEPT on a listen handle. Forwards
INET_CMD_TCP_ACCEPT to inet (reply deferred until a child reaches
ESTABLISHED), then publishes the child as OFT_TYPE_TCP so the
caller's subsequent read/write/close go through the existing
vfs_tcp_* helpers.

Client request: [cmd(1), handle(4)]  (5 bytes)
Client reply:   [status(1), child_handle(4), peer_ip(4), peer_port(2)]  (11 bytes)

Wire for INET_CMD_TCP_ACCEPT (oskit/servers/inet.lsysl):
  request:  [cmd(1), fd(2)]
  reply:    [status(1), child_fd(1), peer_ip(4), peer_port(2)]  (8 bytes)

    vfs_handle_accept(sender: int, buf: *byte)
        val handle = vfs_msg_read_i32(buf, 1)
        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        if fid < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        if oft_type[fid] != OFT_TYPE_TCP_LISTEN
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val inet = vfs_lookup_inet()
        if inet < 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        val tcp_fd = oft_tcp_fd[fid]
        var msg: [3]byte
        msg[0] = 15  // INET_CMD_TCP_ACCEPT
        msg[1] = byte((tcp_fd >> 8) & 0xFF)
        msg[2] = byte(tcp_fd & 0xFF)
        var icreply: [8]byte
        ipc_send(inet, msg, 3, icreply, 8)
        if icreply[0] != 0
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        val child_fd = int(icreply[1]) & 0xFF

        val child_oft = vfs_oft_alloc(0, 0, OFT_TYPE_TCP)
        if child_oft < 0
            // Leaking the inet child is acceptable — OFT exhaustion
            // is rare and the inet slot frees on FIN.
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return
        oft_tcp_fd[child_oft] = child_fd

        val child_handle = vfs_handle_alloc(pid, child_oft)
        if child_handle < 0
            vfs_oft_free(child_oft)
            var err: [1]byte
            err[0] = byte(-1)
            ipc_reply(sender, err, 1)
            return

        var reply: [11]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, child_handle)
        reply[5] = icreply[2]
        reply[6] = icreply[3]
        reply[7] = icreply[4]
        reply[8] = icreply[5]
        reply[9] = icreply[6]
        reply[10] = icreply[7]
        ipc_reply(sender, reply, 11)

TTY server port (cached, looked up lazily).

    var vfs_tty_port = -1

    vfs_lookup_tty() -> int
        if vfs_tty_port < 0
            vfs_tty_port = port_lookup("tty")
        vfs_tty_port

Read from a TTY handle. Sends TTY_CMD_READ to the TTY server
for one character, writes it to the client buffer. Returns 1
byte read (or 0 on error).

    vfs_tty_read(sender: int, fid: int, grant_id: int, len: int)
        val tty = vfs_lookup_tty()
        if tty < 0
            var reply: [5]byte
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        val console = oft_console[fid]
        // Read one character from TTY (blocking)
        var tty_msg: [2]byte
        tty_msg[0] = 2  // TTY_CMD_READ
        tty_msg[1] = byte(console)
        var tty_reply: [2]byte
        ipc_send(tty, tty_msg, 2, tty_reply, 2)
        // Write character to client buffer
        val ch = tty_reply[1]
        val mapped = svc_grant_map(grant_id, 0, 1)
        if mapped > 0
            var dst: *byte = *byte(mapped)
            dst[0] = ch
            svc_grant_unmap(grant_id)
        // Reply: 1 byte read
        var reply: [5]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, 1)
        ipc_reply(sender, reply, 5)

Write to a TTY handle. Sends TTY_CMD_PUTS to the TTY server
with the data from the client buffer.

`grant_id == -1` means the payload was inlined into the
original FS_CMD_WRITE at offset 13 (`vfs_buf + 13`). This is
the fast path taken by short writes — no grant_map, no
grant_unmap, no cross-address-space copy through the grant
abstraction. For larger writes we still grant-map so the
payload doesn't have to traverse the IPC message buffer
twice.

    vfs_tty_write(sender: int, fid: int, grant_id: int, len: int, vfs_buf: *byte)
        val tty = vfs_lookup_tty()
        if tty < 0
            var reply: [5]byte
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        val console = oft_console[fid]
        var wlen = len
        if wlen > 125
            wlen = 125
        var tty_msg: [128]byte
        tty_msg[0] = 3  // TTY_CMD_PUTS
        tty_msg[1] = byte(console)
        tty_msg[2] = byte(wlen)
        if grant_id == -1
            // Inline fast path — payload already in our IPC buf
            var i = 0
            while i < wlen
                tty_msg[3 + i] = vfs_buf[13 + i]
                i += 1
        else
            val mapped = svc_grant_map(grant_id, 0, wlen)
            if mapped <= 0
                var reply: [5]byte
                reply[0] = -1
                ipc_reply(sender, reply, 5)
                return
            var src: *byte = *byte(mapped)
            var i = 0
            while i < wlen
                tty_msg[3 + i] = src[i]
                i += 1
            svc_grant_unmap(grant_id)
        var tty_reply: [1]byte
        ipc_send(tty, tty_msg, 3 + wlen, tty_reply, 1)
        // Reply: bytes written
        var reply: [5]byte
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, wlen)
        ipc_reply(sender, reply, 5)

Handle READ with position tracking and cross-address-space support.
Client request:  [cmd(1), handle(4), len(4), buf_addr(4)]  (13 bytes)
VFS resolves handle → open file table entry, reads at current
position, forwards to TFS, advances position by bytes_read.

    vfs_handle_read(sender: int, buf: *byte, backend: int)
        val handle = vfs_msg_read_i32(buf, 1)
        val len = vfs_msg_read_i32(buf, 5)
        val grant_id = vfs_msg_read_i32(buf, 9)

        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        if fid < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return

        if oft_type[fid] == OFT_TYPE_TTY
            vfs_tty_read(sender, fid, grant_id, len)
            return

        if oft_type[fid] == OFT_TYPE_PIPE
            vfs_pipe_read(sender, fid, grant_id, len)
            return

        if oft_type[fid] == OFT_TYPE_TCP
            vfs_tcp_read(sender, fid, grant_id, len)
            return

        val ino = oft_ino[fid]
        val offset = oft_pos[fid]

        // Build TFS-format message: [cmd(1), ino(4), offset(4), len(4), grant_id(4)]
        var tfs_msg: [17]byte
        tfs_msg[0] = 2  // TFS_CMD_READ
        vfs_msg_write_i32(tfs_msg, 1, ino)
        vfs_msg_write_i32(tfs_msg, 5, offset)
        vfs_msg_write_i32(tfs_msg, 9, len)
        vfs_msg_write_i32(tfs_msg, 13, grant_id)

        var be_reply: [64]byte
        ipc_send(backend, tfs_msg, 17, be_reply, 64)
        if be_reply[0] == 0
            val nr = vfs_msg_read_i32(be_reply, 1)
            oft_pos[fid] += nr
        ipc_reply(sender, be_reply, 5)

Handle WRITE with position tracking and cross-address-space support.
Client request:  [cmd(1), fid(4), len(4), buf_addr(4)]  (13 bytes)

    vfs_handle_write(sender: int, buf: *byte, backend: int)
        val handle = vfs_msg_read_i32(buf, 1)
        val len = vfs_msg_read_i32(buf, 5)
        val grant_id = vfs_msg_read_i32(buf, 9)

        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        if fid < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return

        if oft_type[fid] == OFT_TYPE_TTY
            vfs_tty_write(sender, fid, grant_id, len, buf)
            return

        if oft_type[fid] == OFT_TYPE_PIPE
            vfs_pipe_write(sender, fid, grant_id, len, buf)
            return

        if oft_type[fid] == OFT_TYPE_TCP
            vfs_tcp_write(sender, fid, grant_id, len, buf)
            return

        val ino = oft_ino[fid]
        val offset = oft_pos[fid]

        // Inline-path file writes: we have the payload in our IPC
        // buf (at offset 13) but TFS expects to grant_map against
        // the caller's address space. Create a local VFS-side
        // grant on `buf+13` so TFS can pull the data via the
        // existing protocol. The grant is scoped to this call
        // only (revoked on reply).
        var forward_grant = grant_id
        var inline_grant = -1
        if grant_id == -1
            inline_grant = svc_grant_create(
                u64(buf) + u64(13), len, GRANT_READ)
            if inline_grant < 0
                var err: [1]byte
                err[0] = -1
                ipc_reply(sender, err, 1)
                return
            forward_grant = inline_grant

        // Build TFS-format message: [cmd(1), ino(4), offset(4), len(4), grant_id(4)]
        var tfs_msg: [17]byte
        tfs_msg[0] = 3  // TFS_CMD_WRITE
        vfs_msg_write_i32(tfs_msg, 1, ino)
        vfs_msg_write_i32(tfs_msg, 5, offset)
        vfs_msg_write_i32(tfs_msg, 9, len)
        vfs_msg_write_i32(tfs_msg, 13, forward_grant)

        var be_reply: [64]byte
        ipc_send(backend, tfs_msg, 17, be_reply, 64)
        if inline_grant >= 0
            svc_grant_revoke(inline_grant)
        if be_reply[0] == 0
            val nw = vfs_msg_read_i32(be_reply, 1)
            oft_pos[fid] += nw
        ipc_reply(sender, be_reply, 5)

Handle CLOSE: resolve handle, free it and decrement oft refcount.
Client request:  [cmd(1), handle(4)]
Client reply:    [status(1)]

    vfs_do_close(sender: int, buf: *byte)
        val handle = vfs_msg_read_i32(buf, 1)
        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        var reply: [1]byte
        if fid < 0
            reply[0] = -1
        else
            vfs_handle_close(pid, handle)
            reply[0] = 0
        ipc_reply(sender, reply, 1)

Handle SEEK: resolve handle, adjust file position.
Client request:  [cmd(1), handle(4), offset(4), whence(1)]
Client reply:    [status(1), position(4)]
whence: 0 = SEEK_SET, 1 = SEEK_CUR, 2 = SEEK_END

For `SEEK_END` on `OFT_TYPE_FILE` we query the backend for the
current size via `TFS_CMD_STAT` and set `pos = size + offset`.
The negative-position guard rejects callers that pass an offset
more negative than the file size (Linux returns `-EINVAL`); the
client treats `status != 0` as `-EINVAL`.

    vfs_do_seek(sender: int, buf: *byte, backend: int)
        val handle = vfs_msg_read_i32(buf, 1)
        val offset = vfs_msg_read_i32(buf, 5)
        val whence = int(buf[9])
        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        var reply: [5]byte
        if fid < 0
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        if whence == 0
            if offset < 0
                reply[0] = -1
                ipc_reply(sender, reply, 1)
                return
            oft_pos[fid] = offset
        else if whence == 1
            val new_pos = oft_pos[fid] + offset
            if new_pos < 0
                reply[0] = -1
                ipc_reply(sender, reply, 1)
                return
            oft_pos[fid] = new_pos
        else if whence == 2
            if oft_type[fid] != OFT_TYPE_FILE
                reply[0] = -1
                ipc_reply(sender, reply, 1)
                return
            val ino = oft_ino[fid]
            var tfs_msg: [5]byte
            tfs_msg[0] = 6   // TFS_CMD_STAT
            vfs_msg_write_i32(tfs_msg, 1, ino)
            var stat_reply: [29]byte
            ipc_send(backend, tfs_msg, 5, stat_reply, 29)
            if stat_reply[0] != 0
                reply[0] = -1
                ipc_reply(sender, reply, 1)
                return
            val size = vfs_msg_read_i32(stat_reply, 17)
            val new_pos = size + offset
            if new_pos < 0
                reply[0] = -1
                ipc_reply(sender, reply, 1)
                return
            oft_pos[fid] = new_pos
        else
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, oft_pos[fid])
        ipc_reply(sender, reply, 5)

Handle INHERIT: copy handles from parent to child process.
Called by PM after creating a child process.
Request: [cmd(1), parent_pid(4), child_pid(4), num(1), pairs(N*2)]
Each pair is (parent_handle, child_slot) as single bytes.
Reply:   [status(1)]

    vfs_handle_inherit(sender: int, buf: *byte)
        val parent_pid = vfs_msg_read_i32(buf, 1)
        val child_pid = vfs_msg_read_i32(buf, 5)
        val num = int(buf[9])
        var i = 0
        while i < num
            val parent_h = int(buf[10 + i * 2])
            val child_slot = int(buf[11 + i * 2])
            val oft_idx = vfs_handle_lookup(parent_pid, parent_h)
            if oft_idx >= 0
                if child_slot < VFS_MAX_HANDLES
                    val slot = child_pid * VFS_MAX_HANDLES + child_slot
                    handle_oft[slot] = oft_idx
                    oft_ref[oft_idx] += 1
            i += 1
        var reply: [1]byte
        reply[0] = 0
        ipc_reply(sender, reply, 1)

Handle VFS_CMD_DUP_HANDLE: dup a handle from a source process into
a destination process so both processes' handles point at the same
OFT entry. Used by arbitrary-kind SCM_RIGHTS / `posix_fd_transplant`
to give a second process its own VFS handle (which lives in a
*per-pid* handle table) onto the same open file the source already
has open. Bumps `oft_ref` so a close from either side leaves the
other side intact.

Request: [cmd(1), src_pid_be(4), src_handle_be(4), dst_pid_be(4)] = 13
Reply:   [status(1), dst_handle_be(4)] = 5

Status: 0 success, -1 invalid src (handle not open / pid bad),
-2 dst handle table full.

    vfs_handle_dup(sender: int, buf: *byte)
        val src_pid = vfs_msg_read_i32(buf, 1)
        val src_handle = vfs_msg_read_i32(buf, 5)
        val dst_pid = vfs_msg_read_i32(buf, 9)
        var reply: [5]byte
        reply[1] = 0
        reply[2] = 0
        reply[3] = 0
        reply[4] = 0
        if src_pid < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if src_pid >= MAX_PROCESSES
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if dst_pid < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if dst_pid >= MAX_PROCESSES
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        val oft_idx = vfs_handle_lookup(src_pid, src_handle)
        if oft_idx < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if oft_ref[oft_idx] <= 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        val dst_handle = vfs_handle_alloc(dst_pid, oft_idx)
        if dst_handle < 0
            reply[0] = byte(-2)
            ipc_reply(sender, reply, 5)
            return
        oft_ref[oft_idx] += 1
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, dst_handle)
        ipc_reply(sender, reply, 5)


Phase 2B chunk 4 — `VFS_CMD_OFT_QUEUE_REF_BY_HANDLE`. Combined
lookup-and-bump for the sender shim's STREAM SENDMSG path: given
the sender's `(src_pid, src_handle)`, resolve to an OFT idx,
apply a ±1 delta to `oft_queued_refs`, and return the OFT idx so
the shim can stuff it into the cmsg payload (the receiver-side
will use it with `REGISTER_FD_BY_OFT` to mint its own handle).

Combining lookup + bump in one IPC saves a roundtrip per cmsg fd
on the SENDMSG hot path. The shim's roll-back path also uses the
same IPC with `delta = -1` and discards the returned idx.

Request: `cmd(1) + src_pid_be(4) + src_handle_be(4) + delta(1, signed) = 10`
Reply:   `status(1) + oft_idx_be(4) = 5`

Status: 0 = OK, -1 = bad pid / handle / delta, -2 = OFT idx
out of range (shouldn't happen — kept defensive).

    vfs_handle_oft_queue_ref_by_handle(sender: int, buf: *byte)
        val src_pid = vfs_msg_read_i32(buf, 1)
        val src_handle = vfs_msg_read_i32(buf, 5)
        val delta_raw = int(buf[9]) & 0xff
        var delta = 0
        if delta_raw == 1
            delta = 1
        else if delta_raw == 0xff
            delta = -1
        var reply: [5]byte
        reply[1] = 0
        reply[2] = 0
        reply[3] = 0
        reply[4] = 0
        if delta == 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if src_pid < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if src_pid >= MAX_PROCESSES
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        val oft_idx = vfs_handle_lookup(src_pid, src_handle)
        if oft_idx < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if oft_idx >= VFS_MAX_OPEN_FILES
            reply[0] = byte(-2)
            ipc_reply(sender, reply, 5)
            return
        if oft_ref[oft_idx] <= 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        oft_queued_refs[oft_idx] += delta
        if oft_queued_refs[oft_idx] < 0
            oft_queued_refs[oft_idx] = 0
        // No teardown to drive on the +1 case (oft_ref is still
        // >= 1). On the -1 rollback case the original handle is
        // still open in src_pid, so likewise no teardown — the
        // owner will close() in the normal path later.
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, oft_idx)
        ipc_reply(sender, reply, 5)


Phase 2B chunk 4 — `VFS_CMD_OFT_QUEUE_REF`. Drop or bump the
queued-ref counter on a known OFT idx. Used by the receiver
shim (after `REGISTER_FD_BY_OFT` succeeds) and by the unix
server's drop-on-close path on abandoned pending_scm tuples.

When `oft_ref + queued_refs` reaches 0 after the drop, run the
type-specific close-end action that `vfs_oft_free` skipped.

Request: `cmd(1) + oft_idx_be(4) + delta(1, signed) = 6`
Reply:   `status(1) = 1`

    vfs_handle_oft_queue_ref(sender: int, buf: *byte)
        val oft_idx = vfs_msg_read_i32(buf, 1)
        val delta_raw = int(buf[5]) & 0xff
        var delta = 0
        if delta_raw == 1
            delta = 1
        else if delta_raw == 0xff
            delta = -1
        var reply: [1]byte
        if delta == 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 1)
            return
        if oft_idx < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 1)
            return
        if oft_idx >= VFS_MAX_OPEN_FILES
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 1)
            return
        oft_queued_refs[oft_idx] += delta
        if oft_queued_refs[oft_idx] < 0
            oft_queued_refs[oft_idx] = 0
        if oft_ref[oft_idx] <= 0
            if oft_queued_refs[oft_idx] == 0
                // Run the type-specific close-end action
                // `vfs_oft_free` deferred while queued_refs > 0.
                if oft_type[oft_idx] == OFT_TYPE_PIPE
                    vfs_pipe_close_end(oft_idx)
                else if oft_type[oft_idx] == OFT_TYPE_TCP
                    vfs_tcp_close_end(oft_idx)
                else if oft_type[oft_idx] == OFT_TYPE_TCP_LISTEN
                    vfs_tcp_close_end(oft_idx)
        reply[0] = 0
        ipc_reply(sender, reply, 1)


Phase 2B chunk 4 — `VFS_CMD_REGISTER_FD_BY_OFT`. The receiver
shim's complement to `OFT_QUEUE_REF_BY_HANDLE`: given a
(dst_pid, oft_idx) pair carried in the cmsg payload, allocate a
fresh dst-side handle pointing at that OFT entry. Bumps
`oft_ref` so a close from the receiver doesn't tear the OFT
down before the queued ref drops.

Request: `cmd(1) + dst_pid_be(4) + oft_idx_be(4) = 9`
Reply:   `status(1) + dst_handle_be(4) = 5`

Status: 0 = OK, -1 = bad pid / oft idx / OFT not in use,
-2 = dst handle table full.

    vfs_handle_register_fd_by_oft(sender: int, buf: *byte)
        val dst_pid = vfs_msg_read_i32(buf, 1)
        val oft_idx = vfs_msg_read_i32(buf, 5)
        var reply: [5]byte
        reply[1] = 0
        reply[2] = 0
        reply[3] = 0
        reply[4] = 0
        if dst_pid < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if dst_pid >= MAX_PROCESSES
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if oft_idx < 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        if oft_idx >= VFS_MAX_OPEN_FILES
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        // Phase 2B chunk 4: accept the OFT as long as something —
        // either oft_ref or oft_queued_refs — keeps it alive. The
        // sender may have already close()'d its handle, dropping
        // oft_ref to 0; the SCM ref is what's holding the slot for
        // us, and our oft_ref += 1 below is what brings it back to
        // a "real" open count.
        if oft_ref[oft_idx] + oft_queued_refs[oft_idx] <= 0
            reply[0] = byte(-1)
            ipc_reply(sender, reply, 5)
            return
        val dst_handle = vfs_handle_alloc(dst_pid, oft_idx)
        if dst_handle < 0
            reply[0] = byte(-2)
            ipc_reply(sender, reply, 5)
            return
        oft_ref[oft_idx] += 1
        reply[0] = 0
        vfs_msg_write_i32(reply, 1, dst_handle)
        ipc_reply(sender, reply, 5)


Resolve a path to an inode via TFS OPEN.
Returns the inode or -1 on error.

    vfs_resolve_path(backend: int, path: *byte, path_len: int) -> int
        var open_msg: [128]byte
        open_msg[0] = 1  // TFS_CMD_OPEN
        var i = 0
        while i < path_len
            open_msg[1 + i] = path[i]
            i += 1
        var reply: [5]byte
        ipc_send(backend, open_msg, path_len + 1, reply, 5)
        if reply[0] != 0
            return -1
        vfs_msg_read_i32(reply, 1)

Split a path into parent directory path length and basename pointer.
For "/etc/passwd": parent_len=4 ("/etc"), basename points to "passwd".
For "/hello": parent_len=1 ("/"), basename points to "hello".
For "hello": parent_len=0, basename points to "hello".

    vfs_split_parent(path: *byte, path_len: int) -> int
        var last_slash = -1
        var i = 0
        while i < path_len
            if path[i] == 47  // '/'
                last_slash = i
            i += 1
        if last_slash <= 0
            return last_slash
        last_slash

Path-based CREATE: [cmd(1), type(1), mode_hi(1), mode_lo(1), path(N)]
Reply: [status(1), ino(4)]

    vfs_path_create(sender: int, buf: *byte, msg_len: int, backend: int)
        val ftype = int(buf[1])
        val perm = (int(buf[2]) << 8) | int(buf[3])
        val path: *byte = buf + 4
        val path_len = msg_len - 4
        val slash = vfs_split_parent(path, path_len)
        var parent_ino: int
        if slash <= 0
            parent_ino = vfs_resolve_path(backend, path, 0)
            if parent_ino < 0
                parent_ino = 1  // root inode
        else
            parent_ino = vfs_resolve_path(backend, path, slash)
        if parent_ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val name: *byte = path + slash + 1
        val name_len = path_len - slash - 1
        // Forward to TFS: [cmd(1), parent_ino(4), type(1), perm(2), name(N)]
        var tfs_msg: [128]byte
        tfs_msg[0] = 4  // TFS_CMD_CREATE
        vfs_msg_write_i32(tfs_msg, 1, parent_ino)
        tfs_msg[5] = byte(ftype)
        tfs_msg[6] = byte((perm >> 8) & 0xFF)
        tfs_msg[7] = byte(perm & 0xFF)
        var j = 0
        while j < name_len
            tfs_msg[8 + j] = name[j]
            j += 1
        var reply: [5]byte
        ipc_send(backend, tfs_msg, 8 + name_len, reply, 5)
        ipc_reply(sender, reply, 5)

Path-based UNLINK: [cmd(1), path(N)]
Reply: [status(1)]

    vfs_path_unlink(sender: int, buf: *byte, msg_len: int, backend: int)
        val path: *byte = buf + 1
        val path_len = msg_len - 1
        val slash = vfs_split_parent(path, path_len)
        var parent_ino: int
        if slash <= 0
            parent_ino = 1  // root
        else
            parent_ino = vfs_resolve_path(backend, path, slash)
        if parent_ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val name: *byte = path + slash + 1
        val name_len = path_len - slash - 1
        var tfs_msg: [128]byte
        tfs_msg[0] = 5  // TFS_CMD_UNLINK
        vfs_msg_write_i32(tfs_msg, 1, parent_ino)
        var j = 0
        while j < name_len
            tfs_msg[5 + j] = name[j]
            j += 1
        var reply: [1]byte
        ipc_send(backend, tfs_msg, 5 + name_len, reply, 1)
        ipc_reply(sender, reply, 1)

Path-based STAT: [cmd(1), path(N)]
Reply: [status(1), mode(4), nlinks(4), uid(4), gid(4), size(4), mtime(4), ctime(4)]

    vfs_path_stat(sender: int, buf: *byte, msg_len: int, backend: int)
        val path: *byte = buf + 1
        val path_len = msg_len - 1
        val ino = vfs_resolve_path(backend, path, path_len)
        if ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        var tfs_msg: [5]byte
        tfs_msg[0] = 6  // TFS_CMD_STAT
        vfs_msg_write_i32(tfs_msg, 1, ino)
        var reply: [29]byte
        ipc_send(backend, tfs_msg, 5, reply, 29)
        ipc_reply(sender, reply, 29)

Handle-based FSTAT: [cmd(1), handle(4)]
Reply: [status(1), mode(4), nlinks(4), uid(4), gid(4), size(4), mtime(4), ctime(4)]

For OFT_TYPE_FILE the inode is forwarded to TFS just like the
path-based STAT path. TTY/PIPE/TCP synthesise plausible
metadata locally — those object types have no on-disk inode,
but musl's `fstat()` is a routine probe libc uses on every
open fd (e.g. when deciding whether stdin is a tty), so a
"-1" reply would break common code paths. The synthesised
mode uses TFS's encoded ftype constant so the shim's
translation table keeps working uniformly.

    vfs_handle_fstat(sender: int, buf: *byte, backend: int)
        val handle = vfs_msg_read_i32(buf, 1)
        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        if fid < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        if oft_type[fid] == OFT_TYPE_FILE
            val ino = oft_ino[fid]
            var tfs_msg: [5]byte
            tfs_msg[0] = 6  // TFS_CMD_STAT
            vfs_msg_write_i32(tfs_msg, 1, ino)
            var reply: [29]byte
            ipc_send(backend, tfs_msg, 5, reply, 29)
            ipc_reply(sender, reply, 29)
            return
        // Non-file handles: synthesise enough metadata that
        // S_ISCHR / S_ISFIFO / S_ISSOCK probes work and size
        // queries don't return garbage. Permissions: 0o666 for
        // streams, matching Linux.
        var reply: [29]byte
        var i = 0
        while i < 29
            reply[i] = byte(0)
            i += 1
        var ftype = 0
        if oft_type[fid] == OFT_TYPE_TTY
            ftype = 3                     // TFS S_IFCHR
        else if oft_type[fid] == OFT_TYPE_PIPE
            ftype = 5                     // shim translates to S_IFIFO
        else if oft_type[fid] == OFT_TYPE_TCP
            ftype = 6                     // shim translates to S_IFSOCK
        else if oft_type[fid] == OFT_TYPE_TCP_LISTEN
            ftype = 6
        else
            // Unknown — fall back to "regular file" so musl's
            // S_ISREG check passes.
            ftype = 1
        val mode = (ftype << 12) | 0x1B6  // 0o666 perms
        vfs_msg_write_i32(reply, 1, mode)
        vfs_msg_write_i32(reply, 5, 1)    // nlinks
        // uid/gid/size/mtime/ctime stay zero.
        ipc_reply(sender, reply, 29)

Handle-based TRUNCATE: [cmd(1), handle(4), new_size(4)]
Reply: [status(1)]

Resolves the (sender_pid, handle) pair to an OFT entry, rejects
non-`OFT_TYPE_FILE` (TTY / PIPE / TCP can't be truncated; Linux
returns `EINVAL`), then forwards `TFS_CMD_TRUNCATE` to the
backend with the OFT's inode plus the requested new size. The
client's stored `oft_pos` is intentionally NOT touched — POSIX
ftruncate leaves the file offset alone, even if the truncation
moves it past EOF.

    vfs_handle_truncate(sender: int, buf: *byte, backend: int)
        val handle = vfs_msg_read_i32(buf, 1)
        val new_size = vfs_msg_read_i32(buf, 5)
        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        var reply: [1]byte
        if fid < 0
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        if oft_type[fid] != OFT_TYPE_FILE
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        if new_size < 0
            reply[0] = -1
            ipc_reply(sender, reply, 1)
            return
        val ino = oft_ino[fid]
        var tfs_msg: [9]byte
        tfs_msg[0] = byte(13)        // TFS_CMD_TRUNCATE
        vfs_msg_write_i32(tfs_msg, 1, ino)
        vfs_msg_write_i32(tfs_msg, 5, new_size)
        var be_reply: [1]byte
        ipc_send(backend, tfs_msg, 9, be_reply, 1)
        ipc_reply(sender, be_reply, 1)

Path-based MKDIR: [cmd(1), mode_hi(1), mode_lo(1), path(N)]
Reply: [status(1), ino(4)]

    vfs_path_mkdir(sender: int, buf: *byte, msg_len: int, backend: int)
        val perm = (int(buf[1]) << 8) | int(buf[2])
        val path: *byte = buf + 3
        val path_len = msg_len - 3
        val slash = vfs_split_parent(path, path_len)
        var parent_ino: int
        if slash <= 0
            parent_ino = 1  // root
        else
            parent_ino = vfs_resolve_path(backend, path, slash)
        if parent_ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val name: *byte = path + slash + 1
        val name_len = path_len - slash - 1
        var tfs_msg: [128]byte
        tfs_msg[0] = 7  // TFS_CMD_MKDIR
        vfs_msg_write_i32(tfs_msg, 1, parent_ino)
        tfs_msg[5] = byte((perm >> 8) & 0xFF)
        tfs_msg[6] = byte(perm & 0xFF)
        var j = 0
        while j < name_len
            tfs_msg[7 + j] = name[j]
            j += 1
        var reply: [5]byte
        ipc_send(backend, tfs_msg, 7 + name_len, reply, 5)
        ipc_reply(sender, reply, 5)

Path-based RMDIR: [cmd(1), path(N)]
Reply: [status(1)]

    vfs_path_rmdir(sender: int, buf: *byte, msg_len: int, backend: int)
        val path: *byte = buf + 1
        val path_len = msg_len - 1
        val slash = vfs_split_parent(path, path_len)
        var parent_ino: int
        if slash <= 0
            parent_ino = 1  // root
        else
            parent_ino = vfs_resolve_path(backend, path, slash)
        if parent_ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val name: *byte = path + slash + 1
        val name_len = path_len - slash - 1
        var tfs_msg: [128]byte
        tfs_msg[0] = 8  // TFS_CMD_RMDIR
        vfs_msg_write_i32(tfs_msg, 1, parent_ino)
        var j = 0
        while j < name_len
            tfs_msg[5 + j] = name[j]
            j += 1
        var reply: [1]byte
        ipc_send(backend, tfs_msg, 5 + name_len, reply, 1)
        ipc_reply(sender, reply, 1)

Path-based READDIR: [cmd(1), index(4), path(N)]
Reply: [status(1), ino(4), name(60)]

    vfs_path_readdir(sender: int, buf: *byte, msg_len: int, backend: int)
        val index = vfs_msg_read_i32(buf, 1)
        val path: *byte = buf + 5
        val path_len = msg_len - 5
        val dir_ino = vfs_resolve_path(backend, path, path_len)
        if dir_ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        var tfs_msg: [9]byte
        tfs_msg[0] = 9  // TFS_CMD_READDIR
        vfs_msg_write_i32(tfs_msg, 1, dir_ino)
        vfs_msg_write_i32(tfs_msg, 5, index)
        var reply: [65]byte
        ipc_send(backend, tfs_msg, 9, reply, 65)
        if reply[0] != 0
            ipc_reply(sender, reply, 1)
        else
            ipc_reply(sender, reply, 65)

Handle-based READDIR: [cmd(1), handle(4), index(4)]
Reply: [status(1), ino(4), name(60)]

The handle was returned by `open()` on the directory; the OFT
already knows its inode. Skips the path resolve that
`vfs_path_readdir` does — important when a `readdir` loop walks
N entries one at a time. Used by the shim's `sys_getdents64`.

    vfs_handle_readdir(sender: int, buf: *byte, backend: int)
        val handle = vfs_msg_read_i32(buf, 1)
        val index  = vfs_msg_read_i32(buf, 5)
        val pid = svc_get_thread_pid(sender)
        val fid = vfs_handle_lookup(pid, handle)
        if fid < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        if oft_type[fid] != OFT_TYPE_FILE
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val dir_ino = oft_ino[fid]
        var tfs_msg: [9]byte
        tfs_msg[0] = 9  // TFS_CMD_READDIR
        vfs_msg_write_i32(tfs_msg, 1, dir_ino)
        vfs_msg_write_i32(tfs_msg, 5, index)
        var reply: [65]byte
        ipc_send(backend, tfs_msg, 9, reply, 65)
        if reply[0] != 0
            ipc_reply(sender, reply, 1)
        else
            ipc_reply(sender, reply, 65)

Path-based CHMOD: [cmd(1), mode_hi(1), mode_lo(1), path(N)]
Reply: [status(1)]

    vfs_path_chmod(sender: int, buf: *byte, msg_len: int, backend: int)
        val perm = (int(buf[1]) << 8) | int(buf[2])
        val path: *byte = buf + 3
        val path_len = msg_len - 3
        val ino = vfs_resolve_path(backend, path, path_len)
        if ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        var tfs_msg: [7]byte
        tfs_msg[0] = 11  // TFS_CMD_CHMOD
        vfs_msg_write_i32(tfs_msg, 1, ino)
        tfs_msg[5] = byte((perm >> 8) & 0xFF)
        tfs_msg[6] = byte(perm & 0xFF)
        var reply: [1]byte
        ipc_send(backend, tfs_msg, 7, reply, 1)
        ipc_reply(sender, reply, 1)

Path-based RENAME: [cmd(1), old_path_len(1), old_path(N), new_path(M)]
Reply: [status(1)]

    vfs_path_rename(sender: int, buf: *byte, msg_len: int, backend: int)
        val old_path_len = int(buf[1])
        val old_path: *byte = buf + 2
        val new_path: *byte = buf + 2 + old_path_len
        val new_path_len = msg_len - 2 - old_path_len
        // Resolve old parent
        val old_slash = vfs_split_parent(old_path, old_path_len)
        var old_parent: int
        if old_slash <= 0
            old_parent = 1
        else
            old_parent = vfs_resolve_path(backend, old_path, old_slash)
        if old_parent < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        // Resolve new parent
        val new_slash = vfs_split_parent(new_path, new_path_len)
        var new_parent: int
        if new_slash <= 0
            new_parent = 1
        else
            new_parent = vfs_resolve_path(backend, new_path, new_slash)
        if new_parent < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val old_name: *byte = old_path + old_slash + 1
        val old_name_len = old_path_len - old_slash - 1
        val new_name: *byte = new_path + new_slash + 1
        val new_name_len = new_path_len - new_slash - 1
        // Forward to TFS: [cmd(1), old_parent(4), new_parent(4), old_name_len(1), old_name(N), new_name(M)]
        var tfs_msg: [128]byte
        tfs_msg[0] = 12  // TFS_CMD_RENAME
        vfs_msg_write_i32(tfs_msg, 1, old_parent)
        vfs_msg_write_i32(tfs_msg, 5, new_parent)
        tfs_msg[9] = byte(old_name_len)
        var j = 0
        while j < old_name_len
            tfs_msg[10 + j] = old_name[j]
            j += 1
        j = 0
        while j < new_name_len
            tfs_msg[10 + old_name_len + j] = new_name[j]
            j += 1
        var reply: [1]byte
        ipc_send(backend, tfs_msg, 10 + old_name_len + new_name_len, reply, 1)
        ipc_reply(sender, reply, 1)

Path-based SYMLINK: [cmd(1), target_len(2be), target(target_len), link_path(N)]
Reply: [status(1), ino(4)]
Resolves the link's parent dir, splits the basename, then forwards
TFS_CMD_SYMLINK with parent_ino + target + basename.

    vfs_path_symlink(sender: int, buf: *byte, msg_len: int, backend: int)
        val target_len = ((int(buf[1]) & 0xFF) << 8) | (int(buf[2]) & 0xFF)
        val target: *byte = buf + 3
        val link_path: *byte = buf + 3 + target_len
        val link_path_len = msg_len - 3 - target_len
        val slash = vfs_split_parent(link_path, link_path_len)
        var parent_ino: int
        if slash <= 0
            parent_ino = 1
        else
            parent_ino = vfs_resolve_path(backend, link_path, slash)
        if parent_ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        val name: *byte = link_path + slash + 1
        val name_len = link_path_len - slash - 1
        // Forward: [cmd(1), parent_ino(4), target_len(2), target(N), name(M)]
        var tfs_msg: [256]byte
        tfs_msg[0] = 14  // TFS_CMD_SYMLINK
        vfs_msg_write_i32(tfs_msg, 1, parent_ino)
        tfs_msg[5] = (target_len >> 8) & 0xFF
        tfs_msg[6] = target_len & 0xFF
        var ti = 0
        while ti < target_len
            tfs_msg[7 + ti] = target[ti]
            ti += 1
        var ni = 0
        while ni < name_len
            tfs_msg[7 + target_len + ni] = name[ni]
            ni += 1
        var reply: [5]byte
        ipc_send(backend, tfs_msg, 7 + target_len + name_len, reply, 5)
        ipc_reply(sender, reply, 5)

Path-based READLINK: [cmd(1), path(N)]
Reply: [status(1), len(2be), target(len)]

    vfs_path_readlink(sender: int, buf: *byte, msg_len: int, backend: int)
        val path: *byte = buf + 1
        val path_len = msg_len - 1
        val ino = vfs_resolve_path(backend, path, path_len)
        if ino < 0
            var err: [1]byte
            err[0] = -1
            ipc_reply(sender, err, 1)
            return
        var tfs_msg: [5]byte
        tfs_msg[0] = 15  // TFS_CMD_READLINK
        vfs_msg_write_i32(tfs_msg, 1, ino)
        var reply: [251]byte
        ipc_send(backend, tfs_msg, 5, reply, 251)
        if reply[0] != 0
            ipc_reply(sender, reply, 1)
            return
        val n = ((int(reply[1]) & 0xFF) << 8) | (int(reply[2]) & 0xFF)
        ipc_reply(sender, reply, 3 + n)

The VFS server loop. Registers as "fs", waits for TFS to
come up, mounts root on TFS, then proxies all requests to
the appropriate backend.

    vfs_server()
        // Initialize handle table, pipe state, and epoll subscribers
        vfs_handle_init()
        vfs_pipe_init()
        vfs_epoll_init()

        // Register as "fs"
        vfs_port = port_create()
        port_register(vfs_port, "fs")

        // Wait for TFS to register
        while vfs_lookup_tfs() < 0
            sleep(1)

        // Mount root "/" on TFS
        var root_prefix: [2]byte
        root_prefix[0] = 47  // /
        root_prefix[1] = 0
        vfs_mount(root_prefix, 1, vfs_tfs_port)

        // Register "vfs" scheme pointing to TFS backend
        var vfs_scheme: [4]byte
        vfs_scheme[0] = 118  // v
        vfs_scheme[1] = 102  // f
        vfs_scheme[2] = 115  // s
        vfs_scheme[3] = 0
        vfs_register_scheme(vfs_scheme, 3, vfs_tfs_port)

        // Signal RS that VFS is ready
        rs_ready()

        // Server loop: receive requests, forward to backend, relay reply.
        // 256-byte buffer (bumped Phase 0e) handles SYMLINK with one
        // 60-char target + one 60-char link path comfortably, plus the
        // existing RENAME with two 60-char names.
        var buf: [256]byte
        while 1 == 1
            val sender = ipc_recv(vfs_port, buf, 256)
            if sender >= 0
                val msg_len = ipc_last_msg_len()
                val cmd = int(buf[0])

                // Resolve backend (all inodes belong to root fs for now)
                val backend = mount_port[0]

                if backend < 0
                    var err_reply: [1]byte
                    err_reply[0] = -1
                    ipc_reply(sender, err_reply, 1)
                else if cmd == VFS_CMD_OPEN
                    vfs_handle_open(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_READ
                    vfs_handle_read(sender, buf, backend)
                else if cmd == VFS_CMD_WRITE
                    vfs_handle_write(sender, buf, backend)
                else if cmd == VFS_CMD_CLOSE
                    vfs_do_close(sender, buf)
                else if cmd == VFS_CMD_SEEK
                    vfs_do_seek(sender, buf, backend)
                else if cmd == VFS_CMD_CONNECT
                    vfs_handle_connect(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_INHERIT
                    vfs_handle_inherit(sender, buf)
                else if cmd == VFS_CMD_DUP_HANDLE
                    vfs_handle_dup(sender, buf)
                else if cmd == VFS_CMD_OFT_QUEUE_REF_BY_HANDLE
                    vfs_handle_oft_queue_ref_by_handle(sender, buf)
                else if cmd == VFS_CMD_OFT_QUEUE_REF
                    vfs_handle_oft_queue_ref(sender, buf)
                else if cmd == VFS_CMD_REGISTER_FD_BY_OFT
                    vfs_handle_register_fd_by_oft(sender, buf)
                else if cmd == VFS_CMD_PIPE
                    vfs_handle_pipe(sender)
                else if cmd == VFS_CMD_ACCEPT
                    vfs_handle_accept(sender, buf)
                else if cmd == VFS_CMD_POLL
                    vfs_handle_poll(sender, buf)
                else if cmd == VFS_CMD_EPOLL_SUB
                    vfs_handle_epoll_sub(sender, buf)
                else if cmd == VFS_CMD_EPOLL_UNSUB
                    vfs_handle_epoll_unsub(sender, buf)
                else if cmd == VFS_CMD_EPOLL_INST_CLOSE
                    vfs_handle_epoll_inst_close(sender, buf)
                else if cmd == VFS_CMD_EXIT
                    // Process exited — close all its handles AND drop
                    // any epoll subscriptions registered against the
                    // sender thread so a crashed peer doesn't leak slots.
                    val exit_pid = vfs_msg_read_i32(buf, 1)
                    vfs_handle_close_all(exit_pid)
                    vfs_epoll_drop_owner(sender)
                    var exit_reply: [1]byte
                    exit_reply[0] = 0
                    ipc_reply(sender, exit_reply, 1)
                else if cmd == VFS_CMD_CREATE
                    vfs_path_create(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_UNLINK
                    vfs_path_unlink(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_STAT
                    vfs_path_stat(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_FSTAT
                    vfs_handle_fstat(sender, buf, backend)
                else if cmd == VFS_CMD_TRUNCATE
                    vfs_handle_truncate(sender, buf, backend)
                else if cmd == VFS_CMD_MKDIR
                    vfs_path_mkdir(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_RMDIR
                    vfs_path_rmdir(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_READDIR
                    vfs_path_readdir(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_READDIR_H
                    vfs_handle_readdir(sender, buf, backend)
                else if cmd == VFS_CMD_CHMOD
                    vfs_path_chmod(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_RENAME
                    vfs_path_rename(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_SYMLINK
                    vfs_path_symlink(sender, buf, msg_len, backend)
                else if cmd == VFS_CMD_READLINK
                    vfs_path_readlink(sender, buf, msg_len, backend)
                else
                    // Unknown command — forward and relay
                    var be_reply: [64]byte
                    ipc_send(backend, buf, msg_len, be_reply, 64)
                    val rlen = vfs_reply_len(cmd, int(be_reply[0]))
                    ipc_reply(sender, be_reply, rlen)
