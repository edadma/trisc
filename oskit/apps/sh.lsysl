OSKit Shell

Minimal interactive shell. Reads commands from the TTY,
tokenizes with strtok, and dispatches to built-in commands.

Built-in commands:
- echo [args...]   — print arguments
- ls [path]         — list directory
- cat path          — print file contents
- mkdir path        — create directory
- rm path           — remove file
- rmdir path        — remove empty directory
- pwd               — print working directory
- cd path           — change directory
- stat path         — show file info
- help              — list commands

    module oskit.apps

    import oskit.lib.{strtok, streq, strcpy, strcat}
    import oskit.fs.{strlen, ROOT_INODE}
    import oskit.services.{sleep}
    import oskit.drivers.tty.{tty_putc, tty_puts, tty_getc}
    import oskit.servers.{fs_open, fs_read, fs_write, fs_create, fs_unlink, fs_stat, fs_mkdir, fs_rmdir, fs_readdir}

Shell state: current working directory as inode and path string.

    var cwd_ino = 1
    var cwd_path: [128]i8

Output helpers. These use the TTY server for all I/O.

    sh_putc(ch: char)
        tty_putc(ch)

    sh_puts(s: *i8)
        tty_puts(s, strlen(s))

    sh_newline()
        sh_putc('\n')

    sh_putint(n: int)
        if n < 0
            sh_putc('-')
            sh_putint(-n)
            return
        if n >= 10
            sh_putint(n / 10)
        sh_putc('0' + (n % 10))

Read a line from the TTY with full line editing.

Supports: left/right arrow, Home/End, Delete, Backspace,
and character insertion at cursor position.

Redraw strategy: on any edit, redraws the entire line using
CR + prompt + buffer + ESC[K + ESC[nG to position cursor.
This avoids visible cursor animation.

    val PROMPT_LEN = 2

Append a CSI sequence with numeric parameter to a buffer:
ESC [ n ch.  Returns new position.

    sh_append_csi(out: *i8, pos: int, n: int, ch: i8) -> int
        var p = pos
        out[p] = 27
        p += 1
        out[p] = '['
        p += 1
        if n >= 100
            out[p] = i8('0' + n / 100)
            p += 1
        if n >= 10
            out[p] = i8('0' + (n / 10) % 10)
            p += 1
        out[p] = i8('0' + n % 10)
        p += 1
        out[p] = ch
        p += 1
        p

Emit a CSI sequence with numeric parameter directly.

    sh_csi_num(n: int, ch: char)
        sh_putc(27)
        sh_putc('[')
        if n >= 100
            sh_putc('0' + n / 100)
        if n >= 10
            sh_putc('0' + (n / 10) % 10)
        sh_putc('0' + n % 10)
        sh_putc(ch)

Redraw the full line in a single batched write.
Builds CR + prompt + buffer + ESC[K + ESC[nG into a local
buffer and sends it with one tty_puts call.

    var sh_out: [140]i8

    sh_refresh_line(buf: *i8, len: int, cursor: int)
        var p = 0
        sh_out[p] = 13
        p += 1
        sh_out[p] = '>'
        p += 1
        sh_out[p] = ' '
        p += 1
        // Copy line content (flush if approaching IPC limit)
        var i = 0
        while i < len
            if p >= 120
                tty_puts(&sh_out[0], p)
                p = 0
            sh_out[p] = buf[i]
            p += 1
            i += 1
        // ESC[K — clear to end of line
        p = sh_append_csi(&sh_out[0], p, 0, i8('K'))
        // ESC[nG — cursor to column (1-based)
        p = sh_append_csi(&sh_out[0], p, PROMPT_LEN + cursor + 1, i8('G'))
        tty_puts(&sh_out[0], p)

    sh_readline(buf: *i8, maxlen: int) -> int
        var len = 0
        var cursor = 0
        while len < maxlen - 1
            val ch = tty_getc()
            if ch == '\n'
                // Enter — done
                sh_putc('\n')
                buf[len] = 0
                return len
            else if ch == 8
                // Backspace — delete character before cursor
                if cursor > 0
                    var i = cursor - 1
                    while i < len - 1
                        buf[i] = buf[i + 1]
                        i += 1
                    len -= 1
                    cursor -= 1
                    sh_refresh_line(buf, len, cursor)
            else if ch == 27
                // Escape sequence
                val c2 = tty_getc()
                if c2 == '['
                    val c3 = tty_getc()
                    if c3 == 'C'
                        // Right arrow
                        if cursor < len
                            cursor += 1
                            sh_csi_num(PROMPT_LEN + cursor + 1, 'G')
                    else if c3 == 'D'
                        // Left arrow
                        if cursor > 0
                            cursor -= 1
                            sh_csi_num(PROMPT_LEN + cursor + 1, 'G')
                    else if c3 == 'H'
                        // Home
                        cursor = 0
                        sh_csi_num(PROMPT_LEN + 1, 'G')
                    else if c3 == 'F'
                        // End
                        cursor = len
                        sh_csi_num(PROMPT_LEN + cursor + 1, 'G')
                    else if c3 == '3'
                        // Could be Delete: ESC[3~
                        val c4 = tty_getc()
                        if c4 == '~'
                            if cursor < len
                                var i = cursor
                                while i < len - 1
                                    buf[i] = buf[i + 1]
                                    i += 1
                                len -= 1
                                sh_refresh_line(buf, len, cursor)
            else if ch >= ' '
                // Printable character — insert at cursor
                if len < maxlen - 1
                    var i = len
                    while i > cursor
                        buf[i] = buf[i - 1]
                        i -= 1
                    buf[cursor] = i8(ch)
                    len += 1
                    cursor += 1
                    if cursor == len
                        sh_putc(ch)
                    else
                        sh_refresh_line(buf, len, cursor)
        buf[len] = 0
        len

Path resolution helpers. Splits a path into parent directory
and basename. Resolves the parent to an inode.

resolve_parent(path) — Open the parent directory of path.
For "/dir/file" returns the inode of "/dir".
For "file" (no slash) returns cwd_ino.

    sh_resolve_parent(path: *i8) -> int
        // Find the last slash
        var last_slash = -1
        var i = 0
        while path[i] != 0
            if path[i] == '/'
                last_slash = i
            i += 1
        if last_slash == -1
            // No slash — parent is cwd
            return cwd_ino
        if last_slash == 0
            // "/file" — parent is root
            return ROOT_INODE
        // Temporarily null-terminate at last slash
        val saved = path[last_slash]
        path[last_slash] = 0
        val ino = sh_resolve_path(path)
        path[last_slash] = saved
        ino

sh_basename(path) — Return pointer to the last component of path.

    sh_basename(path: *i8) -> *i8
        var last_slash = -1
        var i = 0
        while path[i] != 0
            if path[i] == '/'
                last_slash = i
            i += 1
        if last_slash == -1
            return path
        path + last_slash + 1

sh_resolve_path(path) — Resolve a path to an inode.
Absolute paths start with /. Relative paths are resolved
from cwd by building an absolute path.

    sh_resolve_path(path: *i8) -> int
        if path[0] == '/'
            // Absolute path
            return fs_open(path)
        // Relative path — build absolute path
        var abspath: [256]i8
        strcpy(&abspath[0], &cwd_path[0])
        // Add separator if cwd is not "/"
        val cwdlen = strlen(&cwd_path[0])
        if cwdlen > 1
            abspath[cwdlen] = '/'
            abspath[cwdlen + 1] = 0
        else if cwdlen == 1
            // cwd is "/" — don't add extra slash
            abspath[1] = 0
        strcat(&abspath[0], path)
        fs_open(&abspath[0])

Built-in commands.

    cmd_echo(argc: int, argv: *i64)
        var i = 1
        while i < argc
            if i > 1
                sh_putc(' ')
            sh_puts(*i8(argv[i]))
            i += 1
        sh_newline()

    sh_not_found(name: *i8)
        sh_puts(name)
        var e: [13]i8
        e[0] = ':'
        e[1] = ' '
        e[2] = 'n'
        e[3] = 'o'
        e[4] = 't'
        e[5] = ' '
        e[6] = 'f'
        e[7] = 'o'
        e[8] = 'u'
        e[9] = 'n'
        e[10] = 'd'
        e[11] = '\n'
        e[12] = 0
        sh_puts(&e[0])

    sh_error()
        var e: [7]i8
        e[0] = 'e'
        e[1] = 'r'
        e[2] = 'r'
        e[3] = 'o'
        e[4] = 'r'
        e[5] = '\n'
        e[6] = 0
        sh_puts(&e[0])

    cmd_ls(argc: int, argv: *i64)
        var dir_ino = cwd_ino
        if argc > 1
            dir_ino = sh_resolve_path(*i8(argv[1]))
            if dir_ino < 0
                sh_not_found(*i8(argv[1]))
                return
        var entry_ino: int
        var entry_name: [14]i8
        var idx = 0
        while fs_readdir(dir_ino, idx, &entry_ino, &entry_name[0]) == 0
            // Skip . and ..
            if entry_name[0] != '.'
                sh_puts(&entry_name[0])
                sh_newline()
            else if entry_name[1] != 0
                if entry_name[1] != '.'
                    sh_puts(&entry_name[0])
                    sh_newline()
                else if entry_name[2] != 0
                    sh_puts(&entry_name[0])
                    sh_newline()
            idx += 1

    cmd_cat(argc: int, argv: *i64)
        if argc < 2
            var u: [15]i8
            u[0] = 'u'
            u[1] = 's'
            u[2] = 'a'
            u[3] = 'g'
            u[4] = 'e'
            u[5] = ':'
            u[6] = ' '
            u[7] = 'c'
            u[8] = 'a'
            u[9] = 't'
            u[10] = ' '
            u[11] = '<'
            u[12] = '>'
            u[13] = '\n'
            u[14] = 0
            sh_puts(&u[0])
            return
        val ino = sh_resolve_path(*i8(argv[1]))
        if ino < 0
            sh_not_found(*i8(argv[1]))
            return
        var buf: [128]i8
        var offset = 0
        var nr = fs_read(ino, &buf[0], offset, 128)
        while nr > 0
            var i = 0
            while i < nr
                sh_putc(int(buf[i]))
                i += 1
            offset += nr
            nr = fs_read(ino, &buf[0], offset, 128)
        sh_newline()

    cmd_mkdir(argc: int, argv: *i64)
        if argc < 2
            return
        val parent = sh_resolve_parent(*i8(argv[1]))
        if parent < 0
            sh_not_found(*i8(argv[1]))
            return
        val name = sh_basename(*i8(argv[1]))
        val result = fs_mkdir(parent, name, 0x1FF)
        if result < 0
            sh_error()

    cmd_rm(argc: int, argv: *i64)
        if argc < 2
            return
        val parent = sh_resolve_parent(*i8(argv[1]))
        if parent < 0
            return
        val name = sh_basename(*i8(argv[1]))
        val result = fs_unlink(parent, name)
        if result < 0
            sh_error()

    cmd_rmdir(argc: int, argv: *i64)
        if argc < 2
            return
        val parent = sh_resolve_parent(*i8(argv[1]))
        if parent < 0
            return
        val name = sh_basename(*i8(argv[1]))
        val result = fs_rmdir(parent, name)
        if result < 0
            sh_error()

    cmd_pwd()
        sh_puts(&cwd_path[0])
        sh_newline()

    cmd_cd(argc: int, argv: *i64)
        if argc < 2
            // cd with no args → go to root
            cwd_ino = ROOT_INODE
            cwd_path[0] = '/'
            cwd_path[1] = 0
            return
        val ino = sh_resolve_path(*i8(argv[1]))
        if ino < 0
            sh_not_found(*i8(argv[1]))
            return
        // Verify it's a directory
        var st: [7]int
        fs_stat(ino, &st[0])
        val ftype = (st[0] >> 12) & 0xF
        if ftype != 2
            var e: [16]i8
            e[0] = 'n'
            e[1] = 'o'
            e[2] = 't'
            e[3] = ' '
            e[4] = 'a'
            e[5] = ' '
            e[6] = 'd'
            e[7] = 'i'
            e[8] = 'r'
            e[9] = 'e'
            e[10] = 'c'
            e[11] = 't'
            e[12] = 'o'
            e[13] = 'r'
            e[14] = 'y'
            e[15] = 0
            sh_puts(&e[0])
            sh_newline()
            return
        cwd_ino = ino
        // Update cwd_path
        val arg1: *i8 = *i8(argv[1])
        if arg1[0] == '/'
            // Absolute path
            strcpy(&cwd_path[0], arg1)
        else
            // Relative path
            val cwdlen = strlen(&cwd_path[0])
            if cwdlen > 1
                cwd_path[cwdlen] = '/'
                cwd_path[cwdlen + 1] = 0
            strcat(&cwd_path[0], arg1)

    cmd_stat(argc: int, argv: *i64)
        if argc < 2
            return
        val ino = sh_resolve_path(*i8(argv[1]))
        if ino < 0
            sh_not_found(*i8(argv[1]))
            return
        var st: [7]int
        fs_stat(ino, &st[0])
        // Type
        val ftype = (st[0] >> 12) & 0xF
        var t1: [7]i8
        t1[0] = 't'
        t1[1] = 'y'
        t1[2] = 'p'
        t1[3] = 'e'
        t1[4] = ':'
        t1[5] = ' '
        t1[6] = 0
        sh_puts(&t1[0])
        if ftype == 1
            var r: [5]i8
            r[0] = 'f'
            r[1] = 'i'
            r[2] = 'l'
            r[3] = 'e'
            r[4] = 0
            sh_puts(&r[0])
        else if ftype == 2
            var d: [4]i8
            d[0] = 'd'
            d[1] = 'i'
            d[2] = 'r'
            d[3] = 0
            sh_puts(&d[0])
        else
            sh_putint(ftype)
        sh_newline()
        // Size
        var s1: [7]i8
        s1[0] = 's'
        s1[1] = 'i'
        s1[2] = 'z'
        s1[3] = 'e'
        s1[4] = ':'
        s1[5] = ' '
        s1[6] = 0
        sh_puts(&s1[0])
        sh_putint(st[4])
        sh_newline()
        // Inode
        var i1: [5]i8
        i1[0] = 'i'
        i1[1] = 'n'
        i1[2] = 'o'
        i1[3] = ':'
        i1[4] = 0
        sh_puts(&i1[0])
        sh_putc(' ')
        sh_putint(ino)
        sh_newline()

    cmd_help()
        var h: [45]i8
        // "echo ls cat mkdir rm rmdir pwd cd stat help\n"
        h[0] = 'e'
        h[1] = 'c'
        h[2] = 'h'
        h[3] = 'o'
        h[4] = ' '
        h[5] = 'l'
        h[6] = 's'
        h[7] = ' '
        h[8] = 'c'
        h[9] = 'a'
        h[10] = 't'
        h[11] = ' '
        h[12] = 'm'
        h[13] = 'k'
        h[14] = 'd'
        h[15] = 'i'
        h[16] = 'r'
        h[17] = ' '
        h[18] = 'r'
        h[19] = 'm'
        h[20] = ' '
        h[21] = 'r'
        h[22] = 'm'
        h[23] = 'd'
        h[24] = 'i'
        h[25] = 'r'
        h[26] = ' '
        h[27] = 'p'
        h[28] = 'w'
        h[29] = 'd'
        h[30] = ' '
        h[31] = 'c'
        h[32] = 'd'
        h[33] = ' '
        h[34] = 's'
        h[35] = 't'
        h[36] = 'a'
        h[37] = 't'
        h[38] = ' '
        h[39] = 'h'
        h[40] = 'e'
        h[41] = 'l'
        h[42] = 'p'
        h[43] = '\n'
        h[44] = 0
        sh_puts(&h[0])

Command dispatch table. Matches the first token against
known commands and calls the handler.

    val MAX_ARGS = 16

Command name constants.

    var _cmd_echo: [5]i8
    var _cmd_ls: [3]i8
    var _cmd_cat: [4]i8
    var _cmd_mkdir: [6]i8
    var _cmd_rm: [3]i8
    var _cmd_rmdir: [6]i8
    var _cmd_pwd: [4]i8
    var _cmd_cd: [3]i8
    var _cmd_stat: [5]i8
    var _cmd_help: [5]i8

    sh_init_cmds()
        _cmd_echo[0] = 'e'
        _cmd_echo[1] = 'c'
        _cmd_echo[2] = 'h'
        _cmd_echo[3] = 'o'
        _cmd_echo[4] = 0
        _cmd_ls[0] = 'l'
        _cmd_ls[1] = 's'
        _cmd_ls[2] = 0
        _cmd_cat[0] = 'c'
        _cmd_cat[1] = 'a'
        _cmd_cat[2] = 't'
        _cmd_cat[3] = 0
        _cmd_mkdir[0] = 'm'
        _cmd_mkdir[1] = 'k'
        _cmd_mkdir[2] = 'd'
        _cmd_mkdir[3] = 'i'
        _cmd_mkdir[4] = 'r'
        _cmd_mkdir[5] = 0
        _cmd_rm[0] = 'r'
        _cmd_rm[1] = 'm'
        _cmd_rm[2] = 0
        _cmd_rmdir[0] = 'r'
        _cmd_rmdir[1] = 'm'
        _cmd_rmdir[2] = 'd'
        _cmd_rmdir[3] = 'i'
        _cmd_rmdir[4] = 'r'
        _cmd_rmdir[5] = 0
        _cmd_pwd[0] = 'p'
        _cmd_pwd[1] = 'w'
        _cmd_pwd[2] = 'd'
        _cmd_pwd[3] = 0
        _cmd_cd[0] = 'c'
        _cmd_cd[1] = 'd'
        _cmd_cd[2] = 0
        _cmd_stat[0] = 's'
        _cmd_stat[1] = 't'
        _cmd_stat[2] = 'a'
        _cmd_stat[3] = 't'
        _cmd_stat[4] = 0
        _cmd_help[0] = 'h'
        _cmd_help[1] = 'e'
        _cmd_help[2] = 'l'
        _cmd_help[3] = 'p'
        _cmd_help[4] = 0

    sh_dispatch(argc: int, argv: *i64)
        if argc == 0
            return
        val cmd: *i8 = *i8(argv[0])
        if streq(cmd, &_cmd_echo[0]) == 1
            cmd_echo(argc, argv)
        else if streq(cmd, &_cmd_ls[0]) == 1
            cmd_ls(argc, argv)
        else if streq(cmd, &_cmd_cat[0]) == 1
            cmd_cat(argc, argv)
        else if streq(cmd, &_cmd_mkdir[0]) == 1
            cmd_mkdir(argc, argv)
        else if streq(cmd, &_cmd_rm[0]) == 1
            cmd_rm(argc, argv)
        else if streq(cmd, &_cmd_rmdir[0]) == 1
            cmd_rmdir(argc, argv)
        else if streq(cmd, &_cmd_pwd[0]) == 1
            cmd_pwd()
        else if streq(cmd, &_cmd_cd[0]) == 1
            cmd_cd(argc, argv)
        else if streq(cmd, &_cmd_stat[0]) == 1
            cmd_stat(argc, argv)
        else if streq(cmd, &_cmd_help[0]) == 1
            cmd_help()
        else
            sh_not_found(cmd)

The shell main loop. Prints a prompt, reads a line,
tokenizes it, and dispatches to the appropriate command.

    shell()
        // Initialize
        cwd_path[0] = '/'
        cwd_path[1] = 0
        sh_init_cmds()

        // Wait for servers to start
        sleep(5)

        var line: [256]i8
        var delim: [2]i8
        delim[0] = ' '
        delim[1] = 0

        var argv: [16]i64

        while 1 == 1
            // Print prompt: "> "
            sh_putc('>')
            sh_putc(' ')

            // Read a line
            val len = sh_readline(&line[0], 256)
            if len == 0
                continue

            // Tokenize
            var argc = 0
            var tok = strtok(&line[0], &delim[0])
            while i64(tok) != 0
                if argc < MAX_ARGS
                    argv[argc] = i64(tok)
                    argc += 1
                tok = strtok(*i8(0), &delim[0])

            // Dispatch
            sh_dispatch(argc, &argv[0])
