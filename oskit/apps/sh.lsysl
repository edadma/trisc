OSKit Shell

Minimal interactive shell. Reads commands from the TTY,
tokenizes with strtok, and dispatches to built-in commands.

Built-in commands:
- echo [args...]   — print arguments
- ls [path]         — list directory
- cat path          — print file contents
- mkdir path        — create directory
- rm path           — remove file
- rmdir path        — remove empty directory
- pwd               — print working directory
- cd path           — change directory
- stat path         — show file info
- help              — list commands

    module oskit.apps

    import oskit.fs.ROOT_INODE
    import posix.string.{strlen, strcmp, strcpy, strcat, strtok}
    import oskit.services.{sleep}
    import oskit.drivers.tty.{tty_putc, tty_puts, tty_getc}
    import oskit.servers.{fs_open, fs_read, fs_write, fs_create, fs_unlink, fs_stat, fs_mkdir, fs_rmdir, fs_readdir}

Shell state: current working directory as inode and path string.

    var cwd_ino = 1
    var cwd_path: [128]i8

Output helpers. These use the TTY server for all I/O.

    sh_putc(ch: char)
        tty_putc(ch)

    sh_puts(s: *byte)
        tty_puts(s, strlen(s))

    sh_print(s: string)
        tty_puts(*byte(s), len(s))

    cstr(s: *byte) -> string
        string(s, strlen(s))

    sh_newline()
        sh_putc('\n')

    sh_putint(n: int)
        if n < 0
            sh_putc('-')
            sh_putint(-n)
            return
        if n >= 10
            sh_putint(n / 10)
        sh_putc('0' + (n % 10))

Read a line from the TTY with full line editing.

Supports: left/right arrow, Home/End, Delete, Backspace,
and character insertion at cursor position.

Redraw strategy: on any edit, redraws the entire line using
CR + prompt + buffer + ESC[K + ESC[nG to position cursor.
This avoids visible cursor animation.

    val PROMPT_LEN = 2

Append a CSI sequence with numeric parameter to a buffer:
ESC [ n ch.  Returns new position.

    sh_append_csi(out: *i8, pos: int, n: int, ch: i8) -> int
        var p = pos
        out[p] = 27
        p += 1
        out[p] = '['
        p += 1
        if n >= 100
            out[p] = i8('0' + n / 100)
            p += 1
        if n >= 10
            out[p] = i8('0' + (n / 10) % 10)
            p += 1
        out[p] = i8('0' + n % 10)
        p += 1
        out[p] = ch
        p += 1
        p

Emit a CSI sequence with numeric parameter directly.

    sh_csi_num(n: int, ch: char)
        sh_putc(27)
        sh_putc('[')
        if n >= 100
            sh_putc('0' + n / 100)
        if n >= 10
            sh_putc('0' + (n / 10) % 10)
        sh_putc('0' + n % 10)
        sh_putc(ch)

Redraw the full line in a single batched write.
Builds CR + prompt + buffer + ESC[K + ESC[nG into a local
buffer and sends it with one tty_puts call.

    var sh_out: [140]i8

    sh_refresh_line(buf: *i8, len: int, cursor: int)
        var p = 0
        sh_out[p] = 13
        p += 1
        sh_out[p] = '>'
        p += 1
        sh_out[p] = ' '
        p += 1
        // Copy line content (flush if approaching IPC limit)
        for var i = 0; i < len; i++
            if p >= 120
                tty_puts(sh_out, p)
                p = 0
            sh_out[p] = buf[i]
            p += 1
        // ESC[K — clear to end of line
        p = sh_append_csi(sh_out, p, 0, i8('K'))
        // ESC[nG — cursor to column (1-based)
        p = sh_append_csi(sh_out, p, PROMPT_LEN + cursor + 1, i8('G'))
        tty_puts(sh_out, p)

    sh_readline(buf: *i8, maxlen: int) -> int
        var len = 0
        var cursor = 0
        while len < maxlen - 1
            val ch = tty_getc()
            if ch == '\n'
                // Enter — done
                sh_putc('\n')
                buf[len] = 0
                return len
            else if ch == 8
                // Backspace — delete character before cursor
                if cursor > 0
                    var i = cursor - 1
                    while i < len - 1
                        buf[i] = buf[i + 1]
                        i += 1
                    len -= 1
                    cursor -= 1
                    sh_refresh_line(buf, len, cursor)
            else if ch == 27
                // Escape sequence
                val c2 = tty_getc()
                if c2 == '['
                    val c3 = tty_getc()
                    if c3 == 'C'
                        // Right arrow
                        if cursor < len
                            cursor += 1
                            sh_csi_num(PROMPT_LEN + cursor + 1, 'G')
                    else if c3 == 'D'
                        // Left arrow
                        if cursor > 0
                            cursor -= 1
                            sh_csi_num(PROMPT_LEN + cursor + 1, 'G')
                    else if c3 == 'H'
                        // Home
                        cursor = 0
                        sh_csi_num(PROMPT_LEN + 1, 'G')
                    else if c3 == 'F'
                        // End
                        cursor = len
                        sh_csi_num(PROMPT_LEN + cursor + 1, 'G')
                    else if c3 == '3'
                        // Could be Delete: ESC[3~
                        val c4 = tty_getc()
                        if c4 == '~'
                            if cursor < len
                                var i = cursor
                                while i < len - 1
                                    buf[i] = buf[i + 1]
                                    i += 1
                                len -= 1
                                sh_refresh_line(buf, len, cursor)
            else if ch >= ' '
                // Printable character — insert at cursor
                if len < maxlen - 1
                    var i = len
                    while i > cursor
                        buf[i] = buf[i - 1]
                        i -= 1
                    buf[cursor] = i8(ch)
                    len += 1
                    cursor += 1
                    if cursor == len
                        sh_putc(ch)
                    else
                        sh_refresh_line(buf, len, cursor)
        buf[len] = 0
        len

Path resolution helpers. Splits a path into parent directory
and basename. Resolves the parent to an inode.

resolve_parent(path) — Open the parent directory of path.
For "/dir/file" returns the inode of "/dir".
For "file" (no slash) returns cwd_ino.

    sh_resolve_parent(path: *byte) -> int
        // Find the last slash
        var last_slash = -1
        var i = 0
        while path[i] != 0
            if path[i] == '/'
                last_slash = i
            i += 1
        if last_slash == -1
            // No slash — parent is cwd
            return cwd_ino
        if last_slash == 0
            // "/file" — parent is root
            return ROOT_INODE
        // Temporarily null-terminate at last slash
        val saved = path[last_slash]
        path[last_slash] = 0
        val ino = sh_resolve_path(path)
        path[last_slash] = saved
        ino

sh_basename(path) — Return pointer to the last component of path.

    sh_basename(path: *byte) -> *byte
        var last_slash = -1
        var i = 0
        while path[i] != 0
            if path[i] == '/'
                last_slash = i
            i += 1
        if last_slash == -1
            return path
        path + last_slash + 1

sh_resolve_path(path) — Resolve a path to an inode.
Absolute paths start with /. Relative paths are resolved
from cwd by building an absolute path.

    sh_resolve_path(path: *byte) -> int
        if path[0] == '/'
            return fs_open(path)
        // Relative path — build absolute path
        var abspath: [256]i8
        strcpy(abspath, cwd_path)
        val cwdlen = strlen(cwd_path)
        if cwdlen > 1
            abspath[cwdlen] = '/'
            abspath[cwdlen + 1] = 0
        else if cwdlen == 1
            abspath[1] = 0
        strcat(abspath, path)
        fs_open(abspath)

Built-in commands.

    cmd_echo(argc: int, argv: *i64)
        for var i = 1; i < argc; i++
            if i > 1
                sh_putc(' ')
            sh_puts(*byte(argv[i]))
        sh_newline()

    sh_not_found(name: *byte)
        sh_puts(name)
        sh_print(": not found\n")

    sh_error()
        sh_print("error\n")

    cmd_ls(argc: int, argv: *i64)
        var dir_ino = cwd_ino
        if argc > 1
            dir_ino = sh_resolve_path(*byte(argv[1]))
            if dir_ino < 0
                sh_not_found(*byte(argv[1]))
                return
        var entry_ino: int
        var entry_name: [14]i8
        var idx = 0
        while fs_readdir(dir_ino, idx, &entry_ino, entry_name) == 0
            // Skip . and ..
            if entry_name[0] != '.'
                sh_puts(entry_name)
                sh_newline()
            else if entry_name[1] != 0
                if entry_name[1] != '.'
                    sh_puts(entry_name)
                    sh_newline()
                else if entry_name[2] != 0
                    sh_puts(entry_name)
                    sh_newline()
            idx += 1

    cmd_cat(argc: int, argv: *i64)
        if argc < 2
            sh_print("usage: cat <file>\n")
            return
        val ino = sh_resolve_path(*byte(argv[1]))
        if ino < 0
            sh_not_found(*byte(argv[1]))
            return
        var buf: [128]i8
        var offset = 0
        var nr = fs_read(ino, buf, offset, 128)
        while nr > 0
            for var i = 0; i < nr; i++
                sh_putc(int(buf[i]))
            offset += nr
            nr = fs_read(ino, buf, offset, 128)
        sh_newline()

    cmd_mkdir(argc: int, argv: *i64)
        if argc < 2
            return
        val parent = sh_resolve_parent(*byte(argv[1]))
        if parent < 0
            sh_not_found(*byte(argv[1]))
            return
        val name = sh_basename(*byte(argv[1]))
        val result = fs_mkdir(parent, name, 0x1FF)
        if result < 0
            sh_error()

    cmd_rm(argc: int, argv: *i64)
        if argc < 2
            return
        val parent = sh_resolve_parent(*byte(argv[1]))
        if parent < 0
            return
        val name = sh_basename(*byte(argv[1]))
        val result = fs_unlink(parent, name)
        if result < 0
            sh_error()

    cmd_rmdir(argc: int, argv: *i64)
        if argc < 2
            return
        val parent = sh_resolve_parent(*byte(argv[1]))
        if parent < 0
            return
        val name = sh_basename(*byte(argv[1]))
        val result = fs_rmdir(parent, name)
        if result < 0
            sh_error()

    cmd_pwd(argc: int, argv: *i64)
        sh_puts(cwd_path)
        sh_newline()

    cmd_cd(argc: int, argv: *i64)
        if argc < 2
            // cd with no args → go to root
            cwd_ino = ROOT_INODE
            cwd_path[0] = '/'
            cwd_path[1] = 0
            return
        val ino = sh_resolve_path(*byte(argv[1]))
        if ino < 0
            sh_not_found(*byte(argv[1]))
            return
        // Verify it's a directory
        var st: [7]int
        fs_stat(ino, st)
        val ftype = (st[0] >> 12) & 0xF
        if ftype != 2
            sh_print("not a directory\n")
            return
        cwd_ino = ino
        // Update cwd_path
        // Update cwd_path
        val arg1 = cstr(*byte(argv[1]))
        if arg1[0] == '/'
            strcpy(cwd_path, arg1)
        else
            val cwdlen = strlen(cwd_path)
            if cwdlen > 1
                cwd_path[cwdlen] = '/'
                cwd_path[cwdlen + 1] = 0
            strcat(cwd_path, arg1)

    cmd_stat(argc: int, argv: *i64)
        if argc < 2
            return
        val ino = sh_resolve_path(*byte(argv[1]))
        if ino < 0
            sh_not_found(*byte(argv[1]))
            return
        var st: [7]int
        fs_stat(ino, st)
        // Type
        val ftype = (st[0] >> 12) & 0xF
        sh_print("type: ")
        if ftype == 1
            sh_print("file")
        else if ftype == 2
            sh_print("dir")
        else
            sh_putint(ftype)
        sh_newline()
        sh_print("size: ")
        sh_putint(st[4])
        sh_newline()
        sh_print("ino: ")
        sh_putint(ino)
        sh_newline()

    cmd_help(argc: int, argv: *i64)
        sh_print("echo ls cat mkdir rm rmdir pwd cd stat help\n")

Command dispatch table. Each entry pairs a command name with
its handler function. All handlers have the same signature
so they can be stored as function pointers.

    val MAX_ARGS = 16
    val NUM_CMDS = 10

    struct Command
        name: string
        handler: func(int, *i64)

    var cmds: [10]Command

    sh_init_cmds()
        cmds[0].name = "echo"
        cmds[0].handler = cmd_echo
        cmds[1].name = "ls"
        cmds[1].handler = cmd_ls
        cmds[2].name = "cat"
        cmds[2].handler = cmd_cat
        cmds[3].name = "mkdir"
        cmds[3].handler = cmd_mkdir
        cmds[4].name = "rm"
        cmds[4].handler = cmd_rm
        cmds[5].name = "rmdir"
        cmds[5].handler = cmd_rmdir
        cmds[6].name = "pwd"
        cmds[6].handler = cmd_pwd
        cmds[7].name = "cd"
        cmds[7].handler = cmd_cd
        cmds[8].name = "stat"
        cmds[8].handler = cmd_stat
        cmds[9].name = "help"
        cmds[9].handler = cmd_help

    sh_dispatch(argc: int, argv: *i64)
        if argc == 0
            return
        val cmd: *byte = *byte(argv[0])
        for var i = 0; i < NUM_CMDS; i++
            if strcmp(cmd, *byte(cmds[i].name)) == 0
                cmds[i].handler(argc, argv)
                return
        sh_not_found(cmd)

The shell main loop. Prints a prompt, reads a line,
tokenizes it, and dispatches to the appropriate command.

    shell()
        // Initialize
        cwd_path[0] = '/'
        cwd_path[1] = 0
        sh_init_cmds()

        // Wait for servers to start
        sleep(5)

        var line: [256]i8
        var delim: [2]i8
        delim[0] = ' '
        delim[1] = 0

        var argv: [16]i64

        while 1 == 1
            // Print prompt: "> "
            sh_putc('>')
            sh_putc(' ')

            // Read a line
            val len = sh_readline(line, 256)
            if len == 0
                continue

            // Tokenize
            var argc = 0
            var tok = strtok(line, delim)
            while i64(tok) != 0
                if argc < MAX_ARGS
                    argv[argc] = i64(tok)
                    argc += 1
                tok = strtok(*byte(0), delim)

            // Dispatch
            sh_dispatch(argc, argv)
