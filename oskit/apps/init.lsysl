OSKit Init — System Initialization

Started by RS as the last boot module. Reads `/etc/ttytab` to
spawn login/shell sessions via PM. When a session exits, init
respawns it so the terminal stays active.

Boot sequence:
1. kernel_main starts RS
2. RS starts servers: disk, tfs, tty, pm, vfs, ds
3. RS starts init (last, from boot module)
4. Init reads `/etc/ttytab` — spawns login/shell per terminal
5. Init loops, waiting for children and respawning

    module oskit.apps.init

    import oskit.services.{putc, rs_ready}
    import oskit.fs.{fs_open, fs_read, fs_close, fs_connect}
    import oskit.servers.{pm_spawn_handles, pm_waitpid}
    import oskit.ipc.{ipc_send, port_lookup}

Session table. Each entry records the program path and
the PID of the currently running session.

    val MAX_SESSIONS = 4

    var session_path: [4]string
    var session_pid: [4]int
    var session_count = 0

Parse `/etc/ttytab` and spawn a process for each entry.
Format: `terminal command` — one entry per line.
Supported commands: `login`, `nsh`.

    spawn_sessions()
        var buf: [256]byte
        val fid = fs_open("/etc/ttytab")
        if fid < 0
            // No ttytab — fall back to single login
            start_session("/bin/login")
            return
        val nr = fs_read(fid, &buf[0], 256)
        fs_close(fid)
        if nr <= 0
            start_session("/bin/login")
            return

        var pos = 0

        while pos < nr
            // Skip leading whitespace
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Skip comment lines
            if pos < nr
                if buf[pos] == '#'
                    while pos < nr
                        if buf[pos] == '\n'
                            break
                        pos += 1
                    if pos < nr
                        pos += 1
                    continue

            // Skip blank lines
            if pos >= nr
                break
            if buf[pos] == '\n'
                pos += 1
                continue

            // Parse terminal name (skip it — not used yet)
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1

            // Skip whitespace between fields
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Parse command name
            val cmd_start = pos
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1
            val cmd_len = pos - cmd_start

            // Skip to end of line
            while pos < nr
                if buf[pos] == '\n'
                    break
                pos += 1
            if pos < nr
                pos += 1

            // Spawn based on command
            if cmd_len > 0
                if cmd_len == 5
                    if buf[cmd_start] == 'l'
                        if buf[cmd_start + 1] == 'o'
                            if buf[cmd_start + 2] == 'g'
                                if buf[cmd_start + 3] == 'i'
                                    if buf[cmd_start + 4] == 'n'
                                        start_session("/bin/login")
                if cmd_len == 3
                    if buf[cmd_start] == 'n'
                        if buf[cmd_start + 1] == 's'
                            if buf[cmd_start + 2] == 'h'
                                start_session("/bin/nsh")

Start a session — spawn program and record in session table.

    start_session(path: string)
        if session_count >= MAX_SESSIONS
            return
        val pid = spawn_program(path)
        if pid > 0
            session_path[session_count] = path
            session_pid[session_count] = pid
            session_count += 1

Spawn an external program with inherited TTY handles.
Returns child PID or -1 on error.

    spawn_program(path: string) -> int
        val h_in = fs_connect("tty:0")
        val h_out = fs_connect("tty:0")
        val h_err = fs_connect("tty:0")

        var hmap: [6]byte
        hmap[0] = byte(h_in)
        hmap[1] = 0
        hmap[2] = byte(h_out)
        hmap[3] = 1
        hmap[4] = byte(h_err)
        hmap[5] = 2

        var argv: [1]string
        argv[0] = path
        val pid = pm_spawn_handles(path, argv, 1, &hmap[0], 3)

        fs_close(h_in)
        fs_close(h_out)
        fs_close(h_err)
        pid

Boot-time DHCP. Spawns `/bin/dhclient` synchronously before
opening logins so inet has a live IP/mask/gateway the first
time any userspace program calls out to the network. The
client's own retransmit budget (~60 s per RFC 2131 §4.1)
bounds how long this blocks — no external timeout needed.

Exit-code-based status only: dhclient prints its own
diagnostic lines during the handshake (DISCOVER/OFFER/bound),
so we just add one summary line here.

Failure is non-fatal. A diskless host without DHCP still has
working loopback and can still log in; the admin can rerun
`dhclient` by hand or set a static config.

    start_dhcp()
        val pid = spawn_program("/bin/dhclient")
        if pid <= 0
            init_print("network: dhcp spawn failed\n")
            return
        val code = pm_waitpid(pid)
        if code == 0
            init_print("network: dhcp ok\n")
        else
            init_print("network: dhcp failed\n")


Respawn loop. Wait for any child to exit, then respawn
the corresponding session.

    respawn_loop()
        while 1 == 1
            // Wait for any session to exit
            var i = 0
            var found = 0
            while i < session_count
                if session_pid[i] > 0
                    val code = pm_waitpid(session_pid[i])
                    // Child exited — respawn
                    val pid = spawn_program(session_path[i])
                    if pid > 0
                        session_pid[i] = pid
                    else
                        session_pid[i] = -1
                    found = 1
                    i = session_count
                i += 1

    init_print(s: string)
        val p = *byte(s)
        val n = len(s)
        var i = 0
        while i < n
            putc(p[i])
            i += 1

    init()
        // Signal RS that init is ready (for handshake)
        rs_ready()

        // All servers are up — acquire a DHCP lease before we
        // open logins. Blocks for up to ~60 s on a silent
        // network (dhclient's own retransmit budget).
        start_dhcp()

        // Now read /etc/ttytab and spawn sessions.
        init_print("Reading /etc/ttytab\n")
        spawn_sessions()

        // Wait for sessions to exit and respawn them
        respawn_loop()
