OSKit Init — System Initialization

Started by RS as the last boot module. Reads `/etc/ttytab` to
spawn login/shell sessions via PM. Runs as an isolated process
with its own page table.

Boot sequence:
1. kernel_main starts RS
2. RS starts servers: disk, tfs, tty, pm, vfs
3. RS starts init (last, from boot module)
4. Init reads `/etc/ttytab` — spawns login/shell per terminal

    module oskit.apps.init

    import oskit.services.{putc, rs_ready}
    import oskit.fs.{fs_open, fs_read, fs_close, fs_connect}
    import oskit.servers.{pm_spawn_handles}
    import oskit.ipc.{ipc_send, port_lookup}

Parse `/etc/ttytab` and spawn a process for each entry.
Format: `terminal command` — one entry per line.
Supported commands: `login`, `nsh`.

    spawn_sessions()
        var buf: [256]byte
        val fid = fs_open("/etc/ttytab")
        if fid < 0
            // No ttytab — fall back to single login
            spawn_program("/bin/login", "login")
            return
        val nr = fs_read(fid, buf, 256)
        fs_close(fid)
        if nr <= 0
            spawn_program("/bin/login", "login")
            return

        var pos = 0

        while pos < nr
            // Skip leading whitespace
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Skip comment lines
            if pos < nr
                if buf[pos] == '#'
                    while pos < nr
                        if buf[pos] == '\n'
                            break
                        pos += 1
                    if pos < nr
                        pos += 1
                    continue

            // Skip blank lines
            if pos >= nr
                break
            if buf[pos] == '\n'
                pos += 1
                continue

            // Parse terminal name (skip it — not used yet)
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1

            // Skip whitespace between fields
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Parse command name
            val cmd_start = pos
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1
            val cmd_len = pos - cmd_start

            // Skip to end of line
            while pos < nr
                if buf[pos] == '\n'
                    break
                pos += 1
            if pos < nr
                pos += 1

            // Spawn based on command
            if cmd_len > 0
                if cmd_len == 5
                    if buf[cmd_start] == 'l'
                        if buf[cmd_start + 1] == 'o'
                            if buf[cmd_start + 2] == 'g'
                                if buf[cmd_start + 3] == 'i'
                                    if buf[cmd_start + 4] == 'n'
                                        spawn_program("/bin/login", "login")
                if cmd_len == 3
                    if buf[cmd_start] == 'n'
                        if buf[cmd_start + 1] == 's'
                            if buf[cmd_start + 2] == 'h'
                                spawn_program("/bin/nsh", "nsh")

Spawn an external program with inherited TTY handles.

    spawn_program(path: string, args: string)
        val h_in = fs_connect("tty:0")
        val h_out = fs_connect("tty:0")
        val h_err = fs_connect("tty:0")

        var hmap: [6]byte
        hmap[0] = byte(h_in)
        hmap[1] = 0
        hmap[2] = byte(h_out)
        hmap[3] = 1
        hmap[4] = byte(h_err)
        hmap[5] = 2

        pm_spawn_handles(path, args, hmap, 3)

        fs_close(h_in)
        fs_close(h_out)
        fs_close(h_err)

    init_print(s: string)
        val p = *byte(s)
        val n = len(s)
        var i = 0
        while i < n
            putc(p[i])
            i += 1

    init()
        // Signal RS that init is ready (for handshake)
        rs_ready()

        // All servers are up — read /etc/ttytab and spawn sessions
        init_print("Reading /etc/ttytab\n")
        spawn_sessions()
