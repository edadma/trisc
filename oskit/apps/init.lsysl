OSKit Init — System Initialization

Started by RS as the last server. Reads `/etc/ttytab` to
spawn login/shell sessions. Runs as a kernel thread (will
be isolated as a boot module in a later step).

Boot sequence:
1. kernel_main starts RS
2. RS starts servers: disk, tfs, tty, pm, vfs
3. RS starts init (last)
4. Init reads `/etc/ttytab` — spawns login/shell per terminal

    module oskit.apps.init

    import oskit.kernel.{create_thread, kernel_stack_usp, kernel_stack_ssp}
    import oskit.services.{putc, rs_ready}
    import oskit.fs.{fs_open, fs_read, fs_close}
    import oskit.apps.login.{login}
    import oskit.apps.nsh.{nsh}

Stack slot counter for session threads. RS uses slots 0-6
(RS=0, 5 servers=1-5, init=6). Sessions start at 7.

    var init_next_slot = 7

    init_alloc_slot() -> int
        val s = init_next_slot
        init_next_slot += 1
        s

Parse `/etc/ttytab` and spawn a thread for each entry.
Format: `terminal command` — one entry per line.
Supported commands: `login`, `nsh`.

    spawn_sessions()
        var buf: [256]byte
        val fid = fs_open("/etc/ttytab")
        if fid < 0
            // No ttytab — fall back to single login
            val s = init_alloc_slot()
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return
        val nr = fs_read(fid, buf, 256)
        fs_close(fid)
        if nr <= 0
            val s = init_alloc_slot()
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return

        var pos = 0

        while pos < nr
            // Skip leading whitespace
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Skip comment lines
            if pos < nr
                if buf[pos] == '#'
                    while pos < nr
                        if buf[pos] == '\n'
                            break
                        pos += 1
                    if pos < nr
                        pos += 1
                    continue

            // Skip blank lines
            if pos >= nr
                break
            if buf[pos] == '\n'
                pos += 1
                continue

            // Parse terminal name (skip it — not used yet)
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1

            // Skip whitespace between fields
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Parse command name
            val cmd_start = pos
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1
            val cmd_len = pos - cmd_start

            // Skip to end of line
            while pos < nr
                if buf[pos] == '\n'
                    break
                pos += 1
            if pos < nr
                pos += 1

            // Spawn based on command
            if cmd_len > 0
                val s = init_alloc_slot()
                val usp = kernel_stack_usp(s)
                val ssp = kernel_stack_ssp(s)
                if cmd_len == 5
                    if buf[cmd_start] == 'l'
                        if buf[cmd_start + 1] == 'o'
                            if buf[cmd_start + 2] == 'g'
                                if buf[cmd_start + 3] == 'i'
                                    if buf[cmd_start + 4] == 'n'
                                        create_thread(login, usp, ssp, "login")
                if cmd_len == 3
                    if buf[cmd_start] == 'n'
                        if buf[cmd_start + 1] == 's'
                            if buf[cmd_start + 2] == 'h'
                                create_thread(nsh, usp, ssp, "nsh")

    init_print(s: string)
        val p = *byte(s)
        val n = len(s)
        var i = 0
        while i < n
            putc(p[i])
            i += 1

    init()
        // Signal RS that init is ready (for handshake)
        rs_ready()

        // All servers are up — read /etc/ttytab and spawn sessions
        init_print("Reading /etc/ttytab\n")
        spawn_sessions()
