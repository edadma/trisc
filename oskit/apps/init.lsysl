OSKit Init — System Initialization

The first userspace process. Spawns RS (Restart Server) as a
separate thread, waits for it to start all system servers,
then reads `/etc/ttytab` to spawn login sessions.

Boot sequence:
1. Init registers servers with RS
2. Init spawns RS thread (Minix 3-style: RS is first)
3. RS starts servers in order: disk, tfs, tty, pm, vfs
4. RS terminates — init continues
5. Init reads `/etc/ttytab` — spawns login/shell per terminal

Minix 3-style: core servers are hardcoded because init can't
read config files until the filesystem is up.

    module oskit.apps.init

    import oskit.kernel.{create_thread, kernel_stack_usp, kernel_stack_ssp}
    import oskit.servers.{rs_main, rs_alloc_slot, rs_add_server, tfs_server, pm_server, vfs_server}
    import oskit.drivers.disk.{disk_server}
    import oskit.drivers.kbd.{keyboard_init}
    import oskit.drivers.tty.{tty_server}
    import oskit.services.{putc, join, thread_id}
    import oskit.fs.{fs_open, fs_read, fs_close}
    import oskit.apps.login.{login}
    import oskit.apps.nsh.{nsh}

Stack slot counter. Init is slot 0 (created by kernel_main).
RS is slot 1. Servers and sessions use rs_alloc_slot().




Parse `/etc/ttytab` and spawn a thread for each entry.
Format: `terminal command` — one entry per line.
Supported commands: `login`, `nsh`.

    spawn_sessions()
        var buf: [256]byte
        val fid = fs_open("/etc/ttytab")
        if fid < 0
            // No ttytab — fall back to single login
            val s = rs_alloc_slot()
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return
        val nr = fs_read(fid, buf, 256)
        fs_close(fid)
        if nr <= 0
            val s = rs_alloc_slot()
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return

        var pos = 0

        while pos < nr
            // Skip leading whitespace
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Skip comment lines
            if pos < nr
                if buf[pos] == '#'
                    while pos < nr
                        if buf[pos] == '\n'
                            break
                        pos += 1
                    if pos < nr
                        pos += 1
                    continue

            // Skip blank lines
            if pos >= nr
                break
            if buf[pos] == '\n'
                pos += 1
                continue

            // Parse terminal name (skip it — not used yet)
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1

            // Skip whitespace between fields
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Parse command name
            val cmd_start = pos
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1
            val cmd_len = pos - cmd_start

            // Skip to end of line
            while pos < nr
                if buf[pos] == '\n'
                    break
                pos += 1
            if pos < nr
                pos += 1

            // Spawn based on command
            if cmd_len > 0
                val s = rs_alloc_slot()
                val usp = kernel_stack_usp(s)
                val ssp = kernel_stack_ssp(s)
                if cmd_len == 5
                    if buf[cmd_start] == 'l'
                        if buf[cmd_start + 1] == 'o'
                            if buf[cmd_start + 2] == 'g'
                                if buf[cmd_start + 3] == 'i'
                                    if buf[cmd_start + 4] == 'n'
                                        create_thread(login, usp, ssp, "login")
                if cmd_len == 3
                    if buf[cmd_start] == 'n'
                        if buf[cmd_start + 1] == 's'
                            if buf[cmd_start + 2] == 'h'
                                create_thread(nsh, usp, ssp, "nsh")

    init_print(s: string)
        val p = *byte(s)
        val n = len(s)
        var i = 0
        while i < n
            putc(p[i])
            i += 1

    init()
        // Init keyboard driver before servers (IRQ handler stays in kernel)
        keyboard_init()

        init_print("SLIX v0.0.1\nStarting servers:\n")

        // Register servers for RS to start (dependency order)
        var n: [5]byte
        n[0] = 100; n[1] = 105; n[2] = 115; n[3] = 107; n[4] = 0  // disk
        rs_add_server(i64(disk_server), &n[0], 4)
        n[0] = 116; n[1] = 102; n[2] = 115; n[3] = 0  // tfs
        rs_add_server(i64(tfs_server), &n[0], 3)
        n[0] = 116; n[1] = 116; n[2] = 121; n[3] = 0  // tty
        rs_add_server(i64(tty_server), &n[0], 3)
        n[0] = 112; n[1] = 109; n[2] = 0  // pm
        rs_add_server(i64(pm_server), &n[0], 2)
        n[0] = 118; n[1] = 102; n[2] = 115; n[3] = 0  // vfs
        rs_add_server(i64(vfs_server), &n[0], 3)

        // Spawn RS as a separate thread (Minix 3-style)
        val rs_tid = create_thread(rs_main, kernel_stack_usp(1), kernel_stack_ssp(1), "rs")

        // Wait for RS to finish starting all servers
        join(rs_tid)

        // All servers up — read /etc/ttytab and spawn sessions
        init_print("Reading /etc/ttytab\n")
        spawn_sessions()
