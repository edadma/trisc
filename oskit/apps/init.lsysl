OSKit Init — System Initialization

The first userspace process. Starts core servers in hardcoded
order (they must run before the filesystem is readable), then
reads `/etc/ttytab` to spawn login sessions.

Boot sequence:
1. Disk server — owns block device hardware
2. TFS server — filesystem, needs disk server
3. TTY server — terminal, needs keyboard hardware
4. PM server — process lifecycle management
5. Read `/etc/ttytab` — spawn login/shell per terminal

Minix 3-style: core servers are hardcoded because init can't
read config files until the filesystem is up.

    module oskit.apps.init

    import oskit.kernel.{create_thread, kernel_stack_usp, kernel_stack_ssp}
    import oskit.servers.{rs_main, rs_alloc_slot, rs_add_server, tfs_server, pm_server, vfs_server}
    import oskit.drivers.disk.{disk_server}
    import oskit.drivers.tty.{tty_server}
    import oskit.fs.{fs_open, fs_read, fs_close}
    import oskit.apps.login.{login}
    import oskit.apps.nsh.{nsh}

Stack slot counter. Init is slot 0 (created by kernel_main).
Each server and session gets the next slot.




Parse `/etc/ttytab` and spawn a thread for each entry.
Format: `terminal command` — one entry per line.
Supported commands: `login`, `nsh`.

    spawn_sessions()
        var buf: [256]byte
        val fid = fs_open("/etc/ttytab")
        if fid < 0
            // No ttytab — fall back to single login
            val s = rs_alloc_slot()
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return
        val nr = fs_read(fid, buf, 256)
        fs_close(fid)
        if nr <= 0
            val s = rs_alloc_slot()
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return

        var pos = 0

        while pos < nr
            // Skip leading whitespace
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Skip comment lines
            if pos < nr
                if buf[pos] == '#'
                    while pos < nr
                        if buf[pos] == '\n'
                            break
                        pos += 1
                    if pos < nr
                        pos += 1
                    continue

            // Skip blank lines
            if pos >= nr
                break
            if buf[pos] == '\n'
                pos += 1
                continue

            // Parse terminal name (skip it — not used yet)
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1

            // Skip whitespace between fields
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Parse command name
            val cmd_start = pos
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1
            val cmd_len = pos - cmd_start

            // Skip to end of line
            while pos < nr
                if buf[pos] == '\n'
                    break
                pos += 1
            if pos < nr
                pos += 1

            // Spawn based on command
            if cmd_len > 0
                val s = rs_alloc_slot()
                val usp = kernel_stack_usp(s)
                val ssp = kernel_stack_ssp(s)
                if cmd_len == 5
                    if buf[cmd_start] == 'l'
                        if buf[cmd_start + 1] == 'o'
                            if buf[cmd_start + 2] == 'g'
                                if buf[cmd_start + 3] == 'i'
                                    if buf[cmd_start + 4] == 'n'
                                        create_thread(login, usp, ssp, "login")
                if cmd_len == 3
                    if buf[cmd_start] == 'n'
                        if buf[cmd_start + 1] == 's'
                            if buf[cmd_start + 2] == 'h'
                                create_thread(nsh, usp, ssp, "nsh")

    init()
        // Register servers for RS to start (dependency order)
        var n: [5]byte
        n[0] = 100; n[1] = 105; n[2] = 115; n[3] = 107; n[4] = 0  // disk
        rs_add_server(i64(disk_server), &n[0], 4)
        n[0] = 116; n[1] = 102; n[2] = 115; n[3] = 0  // tfs
        rs_add_server(i64(tfs_server), &n[0], 3)
        n[0] = 116; n[1] = 116; n[2] = 121; n[3] = 0  // tty
        rs_add_server(i64(tty_server), &n[0], 3)
        n[0] = 112; n[1] = 109; n[2] = 0  // pm
        rs_add_server(i64(pm_server), &n[0], 2)
        n[0] = 118; n[1] = 102; n[2] = 115; n[3] = 0  // vfs
        rs_add_server(i64(vfs_server), &n[0], 3)

        // Run RS inline — starts all servers with synchronous
        // handshake, no sleeps, no extra thread
        rs_main()

        // All servers up — read /etc/ttytab and spawn sessions
        spawn_sessions()
