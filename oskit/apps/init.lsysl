OSKit Init — System Initialization

The first userspace process. Starts core servers in hardcoded
order (they must run before the filesystem is readable), then
reads `/etc/ttytab` to spawn login sessions.

Boot sequence:
1. Disk server — owns block device hardware
2. TFS server — filesystem, needs disk server
3. TTY server — terminal, needs keyboard hardware
4. PM server — process lifecycle management
5. Read `/etc/ttytab` — spawn login/shell per terminal

Minix 3-style: core servers are hardcoded because init can't
read config files until the filesystem is up.

    module oskit.apps.init

    import oskit.kernel.{create_thread, kernel_stack_usp, kernel_stack_ssp}
    import oskit.services.{sleep}
    import oskit.drivers.disk.{disk_server}
    import oskit.servers.{tfs_server, pm_server, vfs_server}
    import oskit.fs.{fs_open, fs_read, fs_close}
    import oskit.drivers.tty.{tty_server}
    import oskit.apps.login.{login}
    import oskit.apps.nsh.{nsh}

Stack slot counter. Init is slot 0 (created by kernel_main).
Each server and session gets the next slot.

    var next_stack_slot = 1

Parse `/etc/ttytab` and spawn a thread for each entry.
Format: `terminal command` — one entry per line.
Supported commands: `login`, `nsh`.

    spawn_sessions()
        var buf: [256]byte
        val fid = fs_open("/etc/ttytab")
        if fid < 0
            // No ttytab — fall back to single login
            val s = next_stack_slot
            next_stack_slot += 1
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return
        val nr = fs_read(fid, buf, 256)
        fs_close(fid)
        if nr <= 0
            val s = next_stack_slot
            next_stack_slot += 1
            create_thread(login, kernel_stack_usp(s), kernel_stack_ssp(s), "login")
            return

        var pos = 0

        while pos < nr
            // Skip leading whitespace
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Skip comment lines
            if pos < nr
                if buf[pos] == '#'
                    while pos < nr
                        if buf[pos] == '\n'
                            break
                        pos += 1
                    if pos < nr
                        pos += 1
                    continue

            // Skip blank lines
            if pos >= nr
                break
            if buf[pos] == '\n'
                pos += 1
                continue

            // Parse terminal name (skip it — not used yet)
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1

            // Skip whitespace between fields
            while pos < nr
                if buf[pos] != ' '
                    if buf[pos] != '\t'
                        break
                pos += 1

            // Parse command name
            val cmd_start = pos
            while pos < nr
                if buf[pos] == ' '
                    break
                if buf[pos] == '\t'
                    break
                if buf[pos] == '\n'
                    break
                pos += 1
            val cmd_len = pos - cmd_start

            // Skip to end of line
            while pos < nr
                if buf[pos] == '\n'
                    break
                pos += 1
            if pos < nr
                pos += 1

            // Spawn based on command
            if cmd_len > 0
                val s = next_stack_slot
                next_stack_slot += 1
                val usp = kernel_stack_usp(s)
                val ssp = kernel_stack_ssp(s)
                if cmd_len == 5
                    if buf[cmd_start] == 'l'
                        if buf[cmd_start + 1] == 'o'
                            if buf[cmd_start + 2] == 'g'
                                if buf[cmd_start + 3] == 'i'
                                    if buf[cmd_start + 4] == 'n'
                                        create_thread(login, usp, ssp, "login")
                if cmd_len == 3
                    if buf[cmd_start] == 'n'
                        if buf[cmd_start + 1] == 's'
                            if buf[cmd_start + 2] == 'h'
                                create_thread(nsh, usp, ssp, "nsh")

    init()
        // Start disk server first — TFS depends on it
        val disk_slot = next_stack_slot
        next_stack_slot += 1
        create_thread(disk_server, kernel_stack_usp(disk_slot), kernel_stack_ssp(disk_slot), "disk")
        sleep(5)

        // Start TFS, TTY, and PM servers
        val tfs_slot = next_stack_slot
        next_stack_slot += 1
        create_thread(tfs_server, kernel_stack_usp(tfs_slot), kernel_stack_ssp(tfs_slot), "tfs")

        val tty_slot = next_stack_slot
        next_stack_slot += 1
        create_thread(tty_server, kernel_stack_usp(tty_slot), kernel_stack_ssp(tty_slot), "tty")

        val pm_slot = next_stack_slot
        next_stack_slot += 1
        create_thread(pm_server, kernel_stack_usp(pm_slot), kernel_stack_ssp(pm_slot), "pm")

        // VFS server — registers as "fs", mounts root on TFS
        val vfs_slot = next_stack_slot
        next_stack_slot += 1
        create_thread(vfs_server, kernel_stack_usp(vfs_slot), kernel_stack_ssp(vfs_slot), "vfs")

        // Wait for servers to initialize and register ports.
        // VFS needs time to find TFS and mount root; 5 ticks was
        // too tight with the extra server thread.
        sleep(500)

        // Read /etc/ttytab and spawn sessions
        spawn_sessions()
