Login — SLIX Login Program

Minix 3-style login. Reads /etc/passwd and /etc/shadow,
authenticates the user, sets uid, then spawns the shell.

Passwd format: username:x:uid:gid:gecos:home:shell
Shadow format: username:password

Password field "x" in passwd means look up in shadow.
Passwords are currently stored in cleartext (placeholder
for std.crypto hash when available).

    module oskit.apps

    import oskit.services.{sleep, setuid}
    import oskit.drivers.tty.{tty_putc, tty_puts, tty_getc}
    import oskit.servers.fs_open
    import oskit.servers.fs_read

    extern nsh()

Buffered output.

    var login_out: [140]i8
    var login_outpos = 0

    login_flush()
        if login_outpos > 0
            tty_puts(login_out, login_outpos)
            login_outpos = 0

    login_putc(ch: char)
        if login_outpos >= 120
            login_flush()
        login_out[login_outpos] = i8(ch)
        login_outpos += 1

    login_print(s: string)
        val p = *byte(s)
        val n = len(s)
        for var i = 0; i < n; i++
            if login_outpos >= 120
                login_flush()
            login_out[login_outpos] = p[i]
            login_outpos += 1

    login_newline()
        login_putc('\n')
        login_flush()

Read a line from the TTY into buf. Returns length.
If echo is false, characters are not echoed (for passwords).

    login_readline(buf: *i8, maxlen: int, echo: int) -> int
        var blen = 0
        while blen < maxlen - 1
            val ch = tty_getc()
            if ch == '\n'
                login_newline()
                buf[blen] = 0
                return blen
            else if ch == 8
                if blen > 0
                    blen -= 1
                    if echo != 0
                        login_putc(8)
                        login_putc(' ')
                        login_putc(8)
                        login_flush()
            else if ch >= ' '
                buf[blen] = i8(ch)
                blen += 1
                if echo != 0
                    login_putc(ch)
                    login_flush()
        buf[blen] = 0
        blen

Compare two byte buffers for equality.

    bufcmp(a: *i8, alen: int, b: *i8, blen: int) -> int
        if alen != blen
            return 0
        for var i = 0; i < alen; i++
            if a[i] != b[i]
                return 0
        1

Read a file into a buffer. Returns bytes read.

    read_file(path: string, buf: *i8, maxlen: int) -> int
        val ino = fs_open(path)
        if ino < 0
            return -1
        var total = 0
        var nr = fs_read(ino, buf, 0, maxlen)
        total = nr
        total

Parse a colon-delimited field from a line buffer.
Sets field_start and field_len, returns position after
the delimiter (or end of line).

    parse_field(buf: *i8, pos: int, limit: int, field_start: *int, field_len: *int) -> int
        *field_start = pos
        var p = pos
        while p < limit
            if buf[p] == ':'
                *field_len = p - pos
                return p + 1
            if buf[p] == '\n'
                *field_len = p - pos
                return p + 1
            p += 1
        *field_len = p - pos
        p

Find a line in a passwd/shadow file matching a username.
Returns the position of the start of the matching line,
or -1 if not found.

    find_user_line(buf: *i8, buflen: int, user: *i8, userlen: int) -> int
        var pos = 0
        while pos < buflen
            // Find end of current line
            var eol = pos
            while eol < buflen
                if buf[eol] == '\n'
                    break
                eol += 1
            // Parse first field (username)
            var fstart: int
            var flen: int
            parse_field(buf, pos, eol, &fstart, &flen)
            // Compare with target username
            if bufcmp(buf + fstart, flen, user, userlen) != 0
                return pos
            // Next line
            pos = eol + 1
        -1

Look up a user in /etc/passwd. Returns uid or -1 on failure.

    lookup_passwd(user: *i8, userlen: int) -> int
        var filebuf: [512]i8
        val nr = read_file("/etc/passwd", filebuf, 512)
        if nr <= 0
            return -1
        val line = find_user_line(filebuf, nr, user, userlen)
        if line < 0
            return -1
        // Parse fields: username:x:uid:gid:gecos:home:shell
        var fstart: int
        var flen: int
        var pos = line
        val eol = line + nr  // conservative end
        // Skip username
        pos = parse_field(filebuf, pos, nr, &fstart, &flen)
        // Skip password field (should be "x")
        pos = parse_field(filebuf, pos, nr, &fstart, &flen)
        // Parse uid
        pos = parse_field(filebuf, pos, nr, &fstart, &flen)
        // Convert uid string to int
        var uid = 0
        for var i = 0; i < flen; i++
            uid = uid * 10 + int(filebuf[fstart + i]) - '0'
        uid

Look up a password in /etc/shadow. Returns 1 if match, 0 if not.

    check_shadow(user: *i8, userlen: int, pass: *i8, passlen: int) -> int
        var filebuf: [512]i8
        val nr = read_file("/etc/shadow", filebuf, 512)
        if nr <= 0
            return 0
        val line = find_user_line(filebuf, nr, user, userlen)
        if line < 0
            return 0
        // Parse fields: username:password
        var fstart: int
        var flen: int
        var pos = line
        // Skip username
        pos = parse_field(filebuf, pos, nr, &fstart, &flen)
        // Get password field
        parse_field(filebuf, pos, nr, &fstart, &flen)
        // Compare with provided password (cleartext for now)
        bufcmp(filebuf + fstart, flen, pass, passlen)

The login main loop. Prompts for credentials, authenticates,
sets uid, and runs the shell. Loops on failure or when shell exits.

    login()
        sleep(10)
        var user: [64]i8
        var pass: [64]i8

        while 1 == 1
            login_newline()
            login_print("login: ")
            login_flush()
            val ulen = login_readline(user, 64, 1)
            if ulen == 0
                continue
            login_print("password: ")
            login_flush()
            val plen = login_readline(pass, 64, 0)

            // Look up user
            val uid = lookup_passwd(user, ulen)
            if uid < 0
                sleep(3)
                login_print("Login incorrect\n")
                login_flush()
                continue

            // Check password
            if check_shadow(user, ulen, pass, plen) == 0
                sleep(3)
                login_print("Login incorrect\n")
                login_flush()
                continue

            // Authenticated — set uid and run shell
            setuid(uid)
            nsh()
            // Shell exited — loop back to login
