module oskit.config

// Thread and process limits
val MAX_THREADS    = 8
val MAX_PROCESSES  = 16
val NUM_PRIORITIES = 4
val DEFAULT_QUANTUM = 5

// Thread stack sizing (bytes)
val THREAD_STACK_SIZE = 0x4000
val THREAD_STACK_HALF = 0x2000

// Memory page size and physical page pool region
val PAGE_SIZE      = 4096
val KERNEL_L1_BASE = 0x7FE000
val PAGE_POOL_BASE = 0x620000
val PAGE_POOL_END  = 0x7FD000

// IPC port limit
val MAX_PORTS = 8

// Syscall table size
val MAX_SYSCALLS = 48

// Per-thread TLS slot count
val TLS_SLOTS = 4

// Software timer and IRQ handler pool sizes
val MAX_TIMERS = 8
val MAX_IRQS   = 8

// PM waiter queue size
val MAX_WAITERS = 8
