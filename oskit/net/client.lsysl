OSKit INET Client — Socket API
================================

Thin wrappers around the `oskit.servers.inet` IPC protocol.
Shape intentionally mirrors POSIX `socket(2)` so a future
libc-style `posix.sys.socket` layer can forward straight
through without reformatting messages.

First cut is UDP-only over loopback — see `oskit/servers/inet`
for the matching server.

    module oskit.net

    import oskit.ulib.{ipc_send, port_lookup}
    import std.net.{AF_INET, SOCK_DGRAM, ipv4, ipv4_octet}


Cached inet server port. Resolved lazily so the lookup doesn't
run until a program actually opens a socket.

    var inet_port = -1

    inet_get_port() -> int
        if inet_port < 0
            inet_port = port_lookup("inet")
        inet_port


Command codes — must track `oskit/servers/inet.lsysl`.

    val INET_CMD_SOCKET       = 1
    val INET_CMD_BIND         = 2
    val INET_CMD_SENDTO       = 3
    val INET_CMD_RECVFROM     = 4
    val INET_CMD_CLOSE        = 5
    val INET_CMD_TCP_CONNECT  = 10
    val INET_CMD_TCP_SEND     = 11
    val INET_CMD_TCP_RECV     = 12
    val INET_CMD_TCP_CLOSE    = 13
    val INET_CMD_TCP_LISTEN   = 14
    val INET_CMD_TCP_ACCEPT   = 15
    val INET_CMD_SET_IP_CONFIG = 16
    val INET_CMD_GET_IP_CONFIG = 17
    val INET_CMD_RECVFROM_TIMEOUT = 18
    val INET_CMD_ARP_PROBE    = 19
    val INET_CMD_ICMP_SEND    = 21
    val INET_CMD_ICMP_CHECK   = 22
    val INET_CMD_TCP_DEBUG    = 20
    val INET_CMD_ICMP_UNREACH_INJECT = 38
    val INET_CMD_TCP_INJECT_FAIL = 42
    val INET_CMD_IP_REASM_SELFTEST = 44
    val INET_CMD_IP_REASM_OVERLAP_TEST = 45
    val INET_CMD_IP_REASM_TIMEOUT_TEST = 46
    val INET_CMD_TCP_SEND_PARK_TEST = 47
    val INET_CMD_TCP_ARP_REPLAY_TEST = 48
    val INET_CMD_PID_EXIT_SELFTEST   = 49
    val INET_CMD_GET_STATS           = 50
    val INET_CMD_TCP_OOO_SELFTEST = 99

    val ARP_PROBE_OP_START    = 0
    val ARP_PROBE_OP_SEND     = 1
    val ARP_PROBE_OP_CHECK    = 2
    val ARP_PROBE_OP_ANNOUNCE = 3

    val INET_MAX_DATA     = 1472
    val INET_MAX_TCP_SEG  = 480


### Byte-buffer helpers (matching the server's big-endian wire
format).

    net_write_u16(p: *byte, off: int, v: int)
        p[off]     = byte((v >> 8) & 0xff)
        p[off + 1] = byte(v & 0xff)

    net_read_u16(p: *byte, off: int) -> int
        ((int(p[off]) & 0xff) << 8) | (int(p[off + 1]) & 0xff)

    net_write_ipv4(p: *byte, off: int, ip: u32)
        p[off]     = byte(ipv4_octet(ip, 0))
        p[off + 1] = byte(ipv4_octet(ip, 1))
        p[off + 2] = byte(ipv4_octet(ip, 2))
        p[off + 3] = byte(ipv4_octet(ip, 3))

    net_read_ipv4(p: *byte, off: int) -> u32
        ipv4(int(p[off]), int(p[off + 1]), int(p[off + 2]), int(p[off + 3]))

    net_read_i32(p: *byte, off: int) -> int
        val b0 = int(p[off]     & 0xff) << 24
        val b1 = int(p[off + 1] & 0xff) << 16
        val b2 = int(p[off + 2] & 0xff) << 8
        val b3 = int(p[off + 3] & 0xff)
        b0 | b1 | b2 | b3


### socket

Create a new socket. Returns the inet-local fd on success, or
-1 on error. Only `AF_INET` / `SOCK_DGRAM` is accepted today.

    socket(family: int, sock_type: int, proto: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [4]byte
        msg[0] = byte(INET_CMD_SOCKET)
        msg[1] = byte(family & 0xff)
        msg[2] = byte(sock_type & 0xff)
        msg[3] = byte(proto & 0xff)
        var reply: [2]byte
        ipc_send(port, msg, 4, reply, 2)
        if reply[0] != 0
            return -1
        int(reply[1]) & 0xff


### bind

Bind a socket to a local port on `ip`. `ip` is a host-order u32
(see `std.net.ipv4`). Returns 0 on success, -1 on failure.

    bind(fd: int, ip: u32, port_num: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = byte(INET_CMD_BIND)
        msg[1] = byte(fd & 0xff)
        msg[2] = byte(AF_INET & 0xff)
        net_write_u16(msg, 3, port_num)
        net_write_ipv4(msg, 5, ip)
        var reply: [1]byte
        ipc_send(port, msg, 9, reply, 1)
        if reply[0] != 0
            return -1
        0


### sendto

Send a datagram to (`dst_ip`, `dst_port`). Returns the number of
bytes accepted, or -1 on error.

    sendto(fd: int, data: *byte, dlen: int, dst_ip: u32, dst_port: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        if dlen < 0
            return -1
        if dlen > INET_MAX_DATA
            return -1
        var msg: [1483]byte
        msg[0] = byte(INET_CMD_SENDTO)
        msg[1] = byte(fd & 0xff)
        msg[2] = byte(AF_INET & 0xff)
        net_write_u16(msg, 3, dst_port)
        net_write_ipv4(msg, 5, dst_ip)
        net_write_u16(msg, 9, dlen)
        var i = 0
        while i < dlen
            msg[11 + i] = data[i]
            i += 1
        var reply: [3]byte
        ipc_send(port, msg, 11 + dlen, reply, 3)
        if reply[0] != 0
            return -1
        net_read_u16(reply, 1)


### recvfrom

Block until a datagram is available on `fd`, then copy up to
`maxlen` bytes into `buf`. If `src_ip` / `src_port` are non-null
pointers, write the datagram's source into them. Returns the
payload length on success, -1 on error.

    recvfrom(fd: int, buf: *byte, maxlen: int, src_ip: *u32, src_port: *int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        if maxlen < 0
            return -1
        var cap_len = maxlen
        if cap_len > INET_MAX_DATA
            cap_len = INET_MAX_DATA
        var msg: [4]byte
        msg[0] = byte(INET_CMD_RECVFROM)
        msg[1] = byte(fd & 0xff)
        net_write_u16(msg, 2, cap_len)
        var reply: [1500]byte
        ipc_send(port, msg, 4, reply, 1500)
        if reply[0] != 0
            return -1
        val r_port = net_read_u16(reply, 2)
        val r_ip = net_read_ipv4(reply, 4)
        val r_len = net_read_u16(reply, 8)
        if i64(src_ip) != 0
            *src_ip = r_ip
        if i64(src_port) != 0
            *src_port = r_port
        var i = 0
        while i < r_len
            buf[i] = reply[10 + i]
            i += 1
        r_len


### recvfrom with timeout

Same as `recvfrom` but bounded: waits up to `timeout_ms`
milliseconds for a datagram. Returns:

- `>0` — bytes received (payload length)
- `0`  — timed out before a datagram arrived
- `-1` — error

A `timeout_ms` of 0 gives an immediate poll: returns queued bytes
if any, otherwise 0. Used by retransmit/renewal loops (dhclient,
future DNS client, etc.) that need to fail fast on a silent
network instead of hanging forever.

Wire layout: `cmd(1) + fd(1) + maxlen(2) + timeout_ms(4)` request;
reply matches `recvfrom`. Status byte: `0` = data, `1` = timeout,
`-1` (0xff) = error.

    recvfrom_timeout(fd: int, buf: *byte, maxlen: int,
                     src_ip: *u32, src_port: *int,
                     timeout_ms: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        if maxlen < 0
            return -1
        if timeout_ms < 0
            return -1
        var cap_len = maxlen
        if cap_len > INET_MAX_DATA
            cap_len = INET_MAX_DATA
        var msg: [8]byte
        msg[0] = byte(INET_CMD_RECVFROM_TIMEOUT)
        msg[1] = byte(fd & 0xff)
        net_write_u16(msg, 2, cap_len)
        net_write_u16(msg, 4, (timeout_ms >> 16) & 0xffff)
        net_write_u16(msg, 6, timeout_ms & 0xffff)
        var reply: [1500]byte
        ipc_send(port, msg, 8, reply, 1500)
        val status = int(reply[0]) & 0xff
        if status == 0xff
            return -1
        if status == 1
            return 0
        val r_port = net_read_u16(reply, 2)
        val r_ip = net_read_ipv4(reply, 4)
        val r_len = net_read_u16(reply, 8)
        if i64(src_ip) != 0
            *src_ip = r_ip
        if i64(src_port) != 0
            *src_port = r_port
        var i = 0
        while i < r_len
            buf[i] = reply[10 + i]
            i += 1
        r_len


### close

Release a socket. Returns 0 on success, -1 on error.

    close_socket(fd: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [2]byte
        msg[0] = byte(INET_CMD_CLOSE)
        msg[1] = byte(fd & 0xff)
        var reply: [1]byte
        ipc_send(port, msg, 2, reply, 1)
        if reply[0] != 0
            return -1
        0


TCP client wrappers
===================

Active-open only in phase 1: `tcp_connect` blocks until
ESTABLISHED, `tcp_send` returns once bytes are buffered (POSIX
`write()` semantics — no ACK wait), `tcp_recv` blocks until data
arrives or peer closes, `tcp_close` blocks until FIN is
acknowledged. `fd` is a 16-bit raw socket index (distinct from
UDP sockets).


### tcp_connect

Open a TCP connection to (`dst_ip`, `dst_port`). Returns the new
socket's fd on success, -1 on failure. Blocks in the caller
until the 3-way handshake completes or retransmits exhaust.

NOTE: phase 1 returns the local ephemeral port on success in the
`fd` channel — actual TCP socket indices are tracked server-side
and the protocol doesn't echo one back. We use the local port
as a handle; subsequent send/recv/close reference it.

Actually — for phase 1 the server-side slot IS the fd. The
inet_tcp_begin_connect() return value is the socket index, but
that's not handed to the client. To keep the protocol minimal
we'll plumb it through the status-reply so clients can pass it
to send/recv/close.

    tcp_connect(dst_ip: u32, dst_port: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [11]byte
        msg[0] = byte(INET_CMD_TCP_CONNECT)
        net_write_ipv4(msg, 1, dst_ip)
        net_write_u16(msg, 5, dst_port)
        // Phase E: SO_SNDBUF / SO_RCVBUF overrides (0 = use defaults).
        // The kernel-thread TCP client doesn't expose setsockopt, so
        // it always asks for defaults.
        net_write_u16(msg, 7, 0)
        net_write_u16(msg, 9, 0)
        var reply: [2]byte
        ipc_send(port, msg, 11, reply, 2)
        if reply[0] != 0
            return -1
        int(reply[1]) & 0xff


### tcp_send

Buffer `len` bytes into the socket's send buffer and put them on
the wire. Returns the number of bytes buffered (0..len), or -1
on error. 0 return means the send buffer still has unacked data
from a prior call — retry after a short delay.

    tcp_send(fd: int, data: *byte, len: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        if len < 0
            return -1
        var n = len
        if n > INET_MAX_TCP_SEG
            n = INET_MAX_TCP_SEG
        var msg: [485]byte
        msg[0] = byte(INET_CMD_TCP_SEND)
        net_write_u16(msg, 1, fd)
        net_write_u16(msg, 3, n)
        var i = 0
        while i < n
            msg[5 + i] = data[i]
            i += 1
        var reply: [3]byte
        ipc_send(port, msg, 5 + n, reply, 3)
        if reply[0] != 0
            return -1
        net_read_u16(reply, 1)


### tcp_recv

Copy up to `maxlen` bytes of received data into `buf`. Returns
the number of bytes written (>0), 0 if the peer has closed
(EOF), or -1 on error. Blocks until data is available or FIN
arrives.

    tcp_recv(fd: int, buf: *byte, maxlen: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        if maxlen < 0
            return -1
        var cap_len = maxlen
        if cap_len > INET_MAX_TCP_SEG
            cap_len = INET_MAX_TCP_SEG
        var msg: [5]byte
        msg[0] = byte(INET_CMD_TCP_RECV)
        net_write_u16(msg, 1, fd)
        net_write_u16(msg, 3, cap_len)
        var reply: [540]byte
        ipc_send(port, msg, 5, reply, 540)
        if reply[0] != 0
            return -1
        val r_len = net_read_u16(reply, 1)
        var i = 0
        while i < r_len
            buf[i] = reply[3 + i]
            i += 1
        r_len


### tcp_close

Emit FIN and block until the close handshake completes (or 2MSL
TIME_WAIT elapses). Returns 0 on success, -1 on error.

    tcp_close(fd: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [3]byte
        msg[0] = byte(INET_CMD_TCP_CLOSE)
        net_write_u16(msg, 1, fd)
        var reply: [1]byte
        ipc_send(port, msg, 3, reply, 1)
        if reply[0] != 0
            return -1
        0


### tcp_listen

Bind a listen socket to `local_port`. Returns the listen fd on
success (usable with `tcp_accept`) or -1 on error. Uses the
default backlog (TCP_LISTEN_BACKLOG, the upper cap inet enforces);
sysl callers wanting a smaller queue use `tcp_listen_backlog`.

    tcp_listen(local_port: int) -> int
        tcp_listen_backlog(local_port, 16)

`tcp_listen_backlog` is the explicit-backlog form: caller picks
the queue depth (clamped by inet to the TCP_LISTEN_BACKLOG ceiling
and `<=0` is normalised to 1 inside the server).

    tcp_listen_backlog(local_port: int, backlog: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = byte(INET_CMD_TCP_LISTEN)
        net_write_u16(msg, 1, local_port)
        var bl = backlog
        if bl < 0
            bl = 0
        if bl > 0xffff
            bl = 0xffff
        net_write_u16(msg, 3, bl)
        // Phase E: SO_SNDBUF / SO_RCVBUF overrides (0 = use defaults).
        net_write_u16(msg, 5, 0)
        net_write_u16(msg, 7, 0)
        var reply: [2]byte
        ipc_send(port, msg, 9, reply, 2)
        if reply[0] != 0
            return -1
        int(reply[1]) & 0xff


### tcp_accept

Block until a remote peer completes the three-way handshake on
a listen socket. Fills `peer_ip` (4 bytes) and `peer_port` (2
bytes) if non-null. Returns the child fd on success or -1 on
error.

    tcp_accept(fd: int, peer_ip: *byte, peer_port: *byte) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [3]byte
        msg[0] = byte(INET_CMD_TCP_ACCEPT)
        net_write_u16(msg, 1, fd)
        var reply: [8]byte
        ipc_send(port, msg, 3, reply, 8)
        if reply[0] != 0
            return -1
        if i64(peer_ip) != i64(0)
            peer_ip[0] = reply[2]
            peer_ip[1] = reply[3]
            peer_ip[2] = reply[4]
            peer_ip[3] = reply[5]
        if i64(peer_port) != i64(0)
            peer_port[0] = reply[6]
            peer_port[1] = reply[7]
        int(reply[1]) & 0xff


### inet_set_ip_config

Install (`ip`, `mask`, `gw`) on the inet server. The DHCP client
(Phase B) calls this after binding a lease; tools like `ifconfig`
could use it for manual config. Returns 0 on success, -1 on error.

    inet_set_ip_config(ip: u32, mask: u32, gw: u32) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [13]byte
        msg[0] = byte(INET_CMD_SET_IP_CONFIG)
        net_write_ipv4(msg, 1, ip)
        net_write_ipv4(msg, 5, mask)
        net_write_ipv4(msg, 9, gw)
        var reply: [1]byte
        ipc_send(port, msg, 13, reply, 1)
        if reply[0] != 0
            return -1
        0


### inet_get_ip_config

Read the current (`ip`, `mask`, `gw`). Each out pointer is written
only if non-null, so callers can ask for a subset. Returns 0 on
success, -1 on error.

    inet_get_ip_config(ip: *u32, mask: *u32, gw: *u32) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_GET_IP_CONFIG)
        var reply: [13]byte
        ipc_send(port, msg, 1, reply, 13)
        if reply[0] != 0
            return -1
        if i64(ip) != 0
            *ip = net_read_ipv4(reply, 1)
        if i64(mask) != 0
            *mask = net_read_ipv4(reply, 5)
        if i64(gw) != 0
            *gw = net_read_ipv4(reply, 9)
        0


### ARP probe (RFC 5227 §2.1.1)

Three helpers drive the server-side probe state machine:

- `arp_probe_start(ip)` arms the probe with a target address.
- `arp_probe_send(ip)` transmits one ARP probe (sender IP =
  0.0.0.0, target IP = `ip`). The caller invokes this up to
  PROBE_NUM times with RFC 5227 timing.
- `arp_probe_check()` returns 1 if any defender was observed,
  0 if the window was clean, and clears the probe state. -1
  on transport error. Callers treat `1` as "conflict, DECLINE
  this lease."

Wire: cmd(1) + op(1) + target(4) → status(1) + seen(1).

    arp_probe_send_op(op: int, ip: u32) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [6]byte
        msg[0] = byte(INET_CMD_ARP_PROBE)
        msg[1] = byte(op & 0xff)
        net_write_ipv4(msg, 2, ip)
        var reply: [2]byte
        ipc_send(port, msg, 6, reply, 2)
        if reply[0] != 0
            return -1
        int(reply[1]) & 0xff

    arp_probe_start(ip: u32) -> int
        arp_probe_send_op(ARP_PROBE_OP_START, ip)

    arp_probe_send(ip: u32) -> int
        arp_probe_send_op(ARP_PROBE_OP_SEND, ip)

    arp_probe_check() -> int
        arp_probe_send_op(ARP_PROBE_OP_CHECK, u32(0))

    arp_probe_announce(ip: u32) -> int
        arp_probe_send_op(ARP_PROBE_OP_ANNOUNCE, ip)


### icmp_send / icmp_check

`ping`-style, split into a non-blocking send + a non-blocking
poll so ping can scan all outstanding requests on its own cadence
rather than having the server block a worker.

`icmp_send(dst_ip, id, seq)` queues an ECHO_REQUEST and registers
(id, seq) so the reply can be correlated. Returns 0 on success
(frame sent or ARP miss fired), -1 if the ping table is full.

`icmp_check(id, seq, out_src_ip, out_rtt_ticks)` returns:
- `1` — reply arrived; src_ip + rtt_ticks filled in.
- `0` — still waiting; out vars untouched.
- `-1` — no such (id, seq) registered.

    icmp_send(dst_ip: u32, id: int, seq: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [9]byte
        msg[0] = byte(INET_CMD_ICMP_SEND)
        net_write_ipv4(msg, 1, dst_ip)
        msg[5] = byte((id >> 8) & 0xff)
        msg[6] = byte(id & 0xff)
        msg[7] = byte((seq >> 8) & 0xff)
        msg[8] = byte(seq & 0xff)
        var reply: [1]byte
        ipc_send(port, msg, 9, reply, 1)
        if reply[0] != 0
            return -1
        0

    icmp_check(id: int, seq: int, out_src_ip: *u32, out_rtt_ticks: *int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(INET_CMD_ICMP_CHECK)
        msg[1] = byte((id >> 8) & 0xff)
        msg[2] = byte(id & 0xff)
        msg[3] = byte((seq >> 8) & 0xff)
        msg[4] = byte(seq & 0xff)
        var reply: [9]byte
        ipc_send(port, msg, 5, reply, 9)
        val status = int(reply[0])
        if status != 0
            if status == 1
                return 0
            return -1
        *out_src_ip = ipv4(
            int(reply[1]) & 0xff,
            int(reply[2]) & 0xff,
            int(reply[3]) & 0xff,
            int(reply[4]) & 0xff)
        val rtt_hi = ((int(reply[5]) & 0xff) << 24) | ((int(reply[6]) & 0xff) << 16)
        val rtt_lo = ((int(reply[7]) & 0xff) << 8) | (int(reply[8]) & 0xff)
        *out_rtt_ticks = rtt_hi | rtt_lo
        1


### tcp_debug (test-only)

Query internal congestion-control state for an established TCP
socket. Used by tests to assert cwnd growth + RTO collapse
behaviour. Fills the six int fields of `out`; returns 0 on
success, -1 if the fd is invalid.

    struct TcpDebug
        state: int
        snd_cwnd: int
        snd_ssthresh: int
        snd_una: int
        snd_nxt: int
        snd_wnd: int
        send_len: int
        fast_recovery: int
        dup_ack_count: int
        sack_ok: int
        rexmit_count: int

    tcp_debug(fd: int, out: *TcpDebug) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [3]byte
        msg[0] = byte(INET_CMD_TCP_DEBUG)
        net_write_u16(msg, 1, fd)
        var reply: [42]byte
        ipc_send(port, msg, 3, reply, 42)
        if reply[0] != 0
            return -1
        out.state         = int(reply[1]) & 0xff
        out.snd_cwnd      = net_read_i32(reply, 2)
        out.snd_ssthresh  = net_read_i32(reply, 6)
        out.snd_una       = net_read_i32(reply, 10)
        out.snd_nxt       = net_read_i32(reply, 14)
        out.snd_wnd       = net_read_i32(reply, 18)
        out.send_len      = net_read_i32(reply, 22)
        out.fast_recovery = net_read_i32(reply, 26)
        out.dup_ack_count = net_read_i32(reply, 30)
        out.sack_ok       = net_read_i32(reply, 34)
        out.rexmit_count  = net_read_i32(reply, 38)
        0


### tcp_ooo_selftest (test-only)

Triggers the inet server's TCP out-of-order reassembly self-test.
Returns 0 on pass, a nonzero error code on failure.

    tcp_ooo_selftest() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_TCP_OOO_SELFTEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### ip_reasm_selftest (test-only)

Triggers the inet server's IPv4 fragmentation reassembly self-test.
Three IPv4 fragments of a 32-byte UDP datagram are injected
out-of-order; the assembled UDP arrives at port 9100 of whichever
socket is bound there. Returns 0 on inject success, nonzero on
inject failure.

    ip_reasm_selftest() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_IP_REASM_SELFTEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### ip_reasm_overlap_test (test-only)

Triggers the inet server's RFC 5722 overlap-fragment test. Two
fragments are injected for the same `(src, dst, id, proto)` tuple
where the second overlaps the first; the slot must be poisoned in
response. Returns 0 on pass, nonzero on failure.

    ip_reasm_overlap_test() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_IP_REASM_OVERLAP_TEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### ip_reasm_timeout_test (test-only)

Triggers the inet server's reassembly-timeout self-test. Injects
one first-fragment, force-expires its deadline, runs the scan
sweep, and verifies `inet_ip_reasm_timeouts_sent` advanced by one
(i.e. ICMP Time Exceeded emit was attempted). Returns 0 on pass,
nonzero on failure.

    ip_reasm_timeout_test() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_IP_REASM_TIMEOUT_TEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### tcp_send_park_test (test-only)

Triggers the inet server's TCP send-buf parking self-test (Phase
1 of the net-stack quality plan).  Allocates a scratch slot,
forces it ESTABLISHED with a full send_buf, parks a fake waiter,
drains the buffer, and verifies the ACK-path drain helper clears
the parked slot.  Returns 0 on pass, 1..6 on the failure step.

    tcp_send_park_test() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_TCP_SEND_PARK_TEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### tcp_arp_replay_test (test-only)

Triggers the inet server's ARP-driven TCP retransmit self-test
(Phase 1 chunk 2 of the net-stack quality plan).  Forces a
synthetic TCP slot to look "ARP-miss pending", inserts the
matching ARP entry, and verifies the drain pipeline clears the
flag.  Returns 0 on pass, 1..3 on the failure step.

    tcp_arp_replay_test() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_TCP_ARP_REPLAY_TEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### pid_exit_cleanup_test (test-only)

Triggers the inet server's PID_EXIT auxiliary-table cleanup
self-test (Phase 2 chunk 3).  Parks one ICMP ping and one
pending-UDP slot under a synthetic owner_tid, runs the cleanup
helpers, and verifies both slots freed.  Returns 0 on pass,
0x10..0x1f if the ping path failed at step 1..f, 0x20..0x2f if
the pending-UDP path failed.

    pid_exit_cleanup_test() -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [1]byte
        msg[0] = byte(INET_CMD_PID_EXIT_SELFTEST)
        var reply: [1]byte
        ipc_send(port, msg, 1, reply, 1)
        int(reply[0]) & 0xff


### get_stats

Phase 2 chunk 4 — caller-side introspection of the inet server's
per-tid resource use.  Pass `tid = 0` to query the calling tid;
nonzero `tid` lets a parent inspect a child or a test inspect a
synthetic owner (the inet server scans by `owner_tid` field).

Returns 0 on success and writes the three counts through the out
pointers.  `out_tcp_buf_bytes` is the sum of `send_buf_size +
recv_buf_size` over every in-use TCP slot owned by `tid`.

    get_stats(tid: int, out_tcp_count: *int, out_udp_count: *int, out_tcp_buf_bytes: *int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [5]byte
        msg[0] = byte(INET_CMD_GET_STATS)
        msg[1] = byte((tid >> 24) & 0xff)
        msg[2] = byte((tid >> 16) & 0xff)
        msg[3] = byte((tid >>  8) & 0xff)
        msg[4] = byte( tid        & 0xff)
        var reply: [17]byte
        ipc_send(port, msg, 5, reply, 17)
        if reply[0] != 0
            return -1
        *out_tcp_count = ((int(reply[1]) & 0xff) << 24) | ((int(reply[2]) & 0xff) << 16) | ((int(reply[3]) & 0xff) << 8) | (int(reply[4]) & 0xff)
        *out_udp_count = ((int(reply[5]) & 0xff) << 24) | ((int(reply[6]) & 0xff) << 16) | ((int(reply[7]) & 0xff) << 8) | (int(reply[8]) & 0xff)
        *out_tcp_buf_bytes = ((int(reply[9]) & 0xff) << 24) | ((int(reply[10]) & 0xff) << 16) | ((int(reply[11]) & 0xff) << 8) | (int(reply[12]) & 0xff)
        0


### icmp_unreach_inject (test-only)

Synthesizes an inbound ICMP type-3 / code-3 frame whose inner
UDP header carries `local_port` as its source port, and feeds it
through the inet server's RX dispatch. After this call, a UDP
socket bound to `local_port` will see ECONNREFUSED on its next
recvfrom (or have any parked recvfrom woken with the same).

Pairs with the egress emit landed in chunk 7 to close the
both-sides UDP error story.

    icmp_unreach_inject(local_port: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [3]byte
        msg[0] = byte(INET_CMD_ICMP_UNREACH_INJECT)
        msg[1] = byte((local_port >> 8) & 0xff)
        msg[2] = byte(local_port & 0xff)
        var reply: [1]byte
        ipc_send(port, msg, 3, reply, 1)
        int(reply[0]) & 0xff


### tcp_inject_fail (test-only)

Finds an `in_use` TCP slot in `SYN_SENT` whose `remote_port`
matches `rport`, sets its `pending_error = 111` (ECONNREFUSED),
and runs `close_slot` — mirroring what an inbound RST in
SYN_SENT would do without depending on slirp's RST timing
(which is unreliable enough that the Java SO_LINGER path is
worse than this synthetic injector for SO_ERROR async
testing).

    tcp_inject_fail(rport: int) -> int
        val port = inet_get_port()
        if port < 0
            return -1
        var msg: [3]byte
        msg[0] = byte(INET_CMD_TCP_INJECT_FAIL)
        msg[1] = byte((rport >> 8) & 0xff)
        msg[2] = byte(rport & 0xff)
        var reply: [1]byte
        ipc_send(port, msg, 3, reply, 1)
        int(reply[0]) & 0xff
