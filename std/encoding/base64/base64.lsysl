std.encoding.base64 — Base64 encoding
=====================================

Encodes and decodes byte slices as base64 strings per
[RFC 4648](https://datatracker.ietf.org/doc/html/rfc4648), matching
Go's `encoding/base64` standard alphabet **with** padding (the
`StdEncoding` variant in Go terms).

Base64 packs three input bytes (24 bits) into four 6-bit alphabet
characters, padding the encoded form with `=` when the input length
is not a multiple of three. The output is exactly $\lceil n/3 \rceil
\times 4$ characters for an $n$-byte input. Decoding is the inverse,
with input-validation errors surfaced via a `bool` "ok" flag in the
return tuple.

The alphabet is the standard one — A–Z, a–z, 0–9, `+`, `/` — so
strings produced here interoperate cleanly with any RFC-4648-compliant
decoder. The URL-safe variant (with `-`, `_` substituted) and the
no-padding variant are not yet provided.

    module std.encoding.base64

    import std.debug.{assert}


Constants
---------

The 64-character standard alphabet, indexed 0..63, plus the padding
character `=`.

    val ENCODE: [64]byte = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    val PAD: byte = byte('=')


Helpers
-------

### `decode_char` — alphabet character → 6-bit value

`decode_char(c)` maps a base64 character to its numeric value 0..63,
returning `-1` for the padding character `'='` and `-2` for any other
non-alphabet byte. Callers branch on the negative values to drive
state-machine decisions in `decode_string`.

    decode_char(c: byte) -> int
        if c >= byte('A') && c <= byte('Z')
            return int(c) - int(byte('A'))
        if c >= byte('a') && c <= byte('z')
            return int(c) - int(byte('a')) + 26
        if c >= byte('0') && c <= byte('9')
            return int(c) - int(byte('0')) + 52
        if c == byte('+')
            return 62
        if c == byte('/')
            return 63
        if c == byte('=')
            return -1                             // padding sentinel
        return -2                                 // invalid sentinel


Encoding
--------

### `encoded_len`

The encoded length of `n` input bytes, including padding. Each
3-byte chunk produces 4 alphabet characters; partial trailing chunks
are padded out to 4 with `=`. Algebraically:
$\mathrm{encoded\_len}(n) = 4 \lceil n/3 \rceil$.

    encoded_len(n: int) -> int = (n + 2) / 3 * 4


### `encode_to_string` — bytes → base64 string

Walks `src` in 3-byte chunks. Each chunk yields four 6-bit values
extracted by shifts and masks across the 24-bit window:

$$
\text{out}_0 = \text{src}_0 \gg 2,\quad
\text{out}_1 = (\text{src}_0 \,\&\, 3) \ll 4 \;|\; \text{src}_1 \gg 4
$$

$$
\text{out}_2 = (\text{src}_1 \,\&\, 15) \ll 2 \;|\; \text{src}_2 \gg 6,\quad
\text{out}_3 = \text{src}_2 \,\&\, 63
$$

The remainder branch handles 1- or 2-byte tails by zero-extending
the missing bits and emitting `=` characters in their slots.

    encode_to_string(src: []byte) -> string
        val n = len(src)
        if n == 0
            return ""

        val out_len = encoded_len(n)
        val buf = (new [out_len]byte)[:]
        val full = n / 3
        var pos = 0

Main loop: complete 3-byte → 4-character groups.

        for i in 0..<full
            val off = i * 3
            val b0 = int(src[off])
            val b1 = int(src[off + 1])
            val b2 = int(src[off + 2])
            buf[pos]     = ENCODE[b0 >> 2]
            buf[pos + 1] = ENCODE[((b0 & 3) << 4) | (b1 >> 4)]
            buf[pos + 2] = ENCODE[((b1 & 15) << 2) | (b2 >> 6)]
            buf[pos + 3] = ENCODE[b2 & 63]
            pos = pos + 4

Tail: 1 byte → 2 chars + `==`, 2 bytes → 3 chars + `=`.

        val rem = n % 3
        if rem == 1
            val b0 = int(src[n - 1])
            buf[pos]     = ENCODE[b0 >> 2]
            buf[pos + 1] = ENCODE[(b0 & 3) << 4]
            buf[pos + 2] = PAD
            buf[pos + 3] = PAD
        if rem == 2
            val b0 = int(src[n - 2])
            val b1 = int(src[n - 1])
            buf[pos]     = ENCODE[b0 >> 2]
            buf[pos + 1] = ENCODE[((b0 & 3) << 4) | (b1 >> 4)]
            buf[pos + 2] = ENCODE[(b1 & 15) << 2]
            buf[pos + 3] = PAD

        return string(buf)


Decoding
--------

### `decoded_len`

Upper bound on the decoded length of an `n`-character base64 string,
not yet accounting for padding. Each 4-character group decodes to up
to 3 bytes: $\mathrm{decoded\_len}(n) = 3 \lfloor n/4 \rfloor$.

    decoded_len(n: int) -> int = n / 4 * 3


### `decode_string` — base64 string → bytes

Returns `(bytes, ok)` where `ok` is `false` if the input contains
invalid characters, has length not divisible by four, or has
padding in any but the last 4-character group.

The output buffer is sized exactly: take the maximum from
`decoded_len`, then subtract one for each `=` in the final group
(0, 1, or 2).

    decode_string(s: string) -> ([]byte, bool)
        val n = len(s)

        if n == 0
            val empty = (new [0]byte)[:]
            return empty, true

A well-formed standard-base64 string with padding is always a multiple
of four characters. Anything else is malformed.

        if n % 4 != 0
            val empty = (new [0]byte)[:]
            return empty, false

Snapshot the string into a byte slice for indexed access.

        val src = (new [n]byte)[:]
        for i in 0..<n
            src[i] = byte(s[i])

Examine the last two characters to count trailing padding (0, 1, or
2 `=` signs); subtract that from the maximum decoded length to get
the exact output size.

        var pad_count = 0
        if src[n - 1] == PAD
            pad_count = pad_count + 1
        if src[n - 2] == PAD
            pad_count = pad_count + 1

        val out_len = n / 4 * 3 - pad_count
        val out = (new [out_len]byte)[:]
        val groups = n / 4
        var pos = 0

        for i in 0..<groups
            val off = i * 4
            val c0 = decode_char(src[off])
            val c1 = decode_char(src[off + 1])
            val c2 = decode_char(src[off + 2])
            val c3 = decode_char(src[off + 3])

The first two characters of every group must be alphabet characters
— never padding, never invalid.

            if c0 < 0 || c1 < 0
                val empty = (new [0]byte)[:]
                return empty, false

The third and fourth characters may be padding (`-1`) but never
invalid (`-2`).

            if c2 == -2
                val empty = (new [0]byte)[:]
                return empty, false

            if c3 == -2
                val empty = (new [0]byte)[:]
                return empty, false

Padding is only legal in the last 4-character group. Reject any
padding that appears earlier.

            val is_last = i == groups - 1
            if !is_last
                if c2 == -1 || c3 == -1
                    val empty = (new [0]byte)[:]
                    return empty, false

Emit one, two, or three output bytes depending on how much padding
the final group carries.

            if c2 == -1
                out[pos] = byte((c0 << 2) | (c1 >> 4))                  // two pads → 1 byte
                pos = pos + 1
            else if c3 == -1
                out[pos]     = byte((c0 << 2) | (c1 >> 4))              // one pad → 2 bytes
                out[pos + 1] = byte(((c1 & 15) << 4) | (c2 >> 2))
                pos = pos + 2
            else
                out[pos]     = byte((c0 << 2) | (c1 >> 4))              // no pad → 3 bytes
                out[pos + 1] = byte(((c1 & 15) << 4) | (c2 >> 2))
                out[pos + 2] = byte(((c2 & 3) << 6) | c3)
                pos = pos + 3

        return out, true


Tests
=====

### RFC 4648 §10 reference vectors

The seven canonical encode tests cover every padding case (`""`
through `"foobar"`), exercising the `(no pad, ==, =)` final-group
branches.

    #test
    test_encode_empty() -> unit
        val empty: [0]byte = ""
        assert(encode_to_string(empty[:]) == "", "empty")

    #test
    test_encode_f() -> unit
        val src: [1]byte = "f"
        assert(encode_to_string(src[:]) == "Zg==", "f")

    #test
    test_encode_fo() -> unit
        val src: [2]byte = "fo"
        assert(encode_to_string(src[:]) == "Zm8=", "fo")

    #test
    test_encode_foo() -> unit
        val src: [3]byte = "foo"
        assert(encode_to_string(src[:]) == "Zm9v", "foo")

    #test
    test_encode_foob() -> unit
        val src: [4]byte = "foob"
        assert(encode_to_string(src[:]) == "Zm9vYg==", "foob")

    #test
    test_encode_fooba() -> unit
        val src: [5]byte = "fooba"
        assert(encode_to_string(src[:]) == "Zm9vYmE=", "fooba")

    #test
    test_encode_foobar() -> unit
        val src: [6]byte = "foobar"
        assert(encode_to_string(src[:]) == "Zm9vYmFy", "foobar")


### `encode_to_string` — additional vectors

    #test
    test_encode_hello_world() -> unit
        val src: [13]byte = "Hello, World!"
        assert(encode_to_string(src[:]) == "SGVsbG8sIFdvcmxkIQ==", "Hello, World!")

    #test
    test_encode_binary_data() -> unit
        val src: [4]byte = [0xff, 0xfe, 0xfd, 0xfc]
        assert(encode_to_string(src[:]) == "//79/A==", "binary high bytes")


### `decode_string` — RFC 4648 vectors

    #test
    test_decode_empty() -> unit
        val out, ok = decode_string("")
        assert(ok, "ok")
        assert(len(out) == 0, "empty")

    #test
    test_decode_f() -> unit
        val out, ok = decode_string("Zg==")
        assert(ok, "ok")
        assert(len(out) == 1, "length")
        assert(out[0] == byte('f'), "f")

    #test
    test_decode_fo() -> unit
        val out, ok = decode_string("Zm8=")
        assert(ok, "ok")
        assert(len(out) == 2, "length")
        assert(out[0] == byte('f'), "f")
        assert(out[1] == byte('o'), "o")

    #test
    test_decode_foo() -> unit
        val out, ok = decode_string("Zm9v")
        assert(ok, "ok")
        assert(len(out) == 3, "length")
        assert(out[0] == byte('f'), "f")
        assert(out[1] == byte('o'), "o1")
        assert(out[2] == byte('o'), "o2")

    #test
    test_decode_foobar() -> unit
        val out, ok = decode_string("Zm9vYmFy")
        assert(ok, "ok")
        assert(len(out) == 6, "length")
        assert(out[0] == byte('f'), "f")
        assert(out[5] == byte('r'), "r")


### `decode_string` — additional vectors

    #test
    test_decode_hello_world() -> unit
        val out, ok = decode_string("SGVsbG8sIFdvcmxkIQ==")
        assert(ok, "ok")
        assert(len(out) == 13, "length")
        assert(out[0] == byte('H'), "H")
        assert(out[12] == byte('!'), "!")


### Round trips

`encode_to_string` followed by `decode_string` must recover the
original bytes exactly, including 0x00 and 0xFF.

    #test
    test_roundtrip_foo() -> unit
        val src: [3]byte = "foo"
        val encoded = encode_to_string(src[:])
        val decoded, ok = decode_string(encoded)
        assert(ok, "ok")
        assert(len(decoded) == 3, "length")
        for i in 0..<3
            assert(decoded[i] == src[i], s"byte $i")

    #test
    test_roundtrip_foobar() -> unit
        val src: [6]byte = "foobar"
        val encoded = encode_to_string(src[:])
        val decoded, ok = decode_string(encoded)
        assert(ok, "ok")
        assert(len(decoded) == 6, "length")
        for i in 0..<6
            assert(decoded[i] == src[i], s"byte $i")

    #test
    test_roundtrip_binary() -> unit
        val src: [5]byte = [0x00, 0x80, 0xff, 0x01, 0x7f]
        val encoded = encode_to_string(src[:])
        val decoded, ok = decode_string(encoded)
        assert(ok, "ok")
        assert(len(decoded) == 5, "length")
        for i in 0..<5
            assert(decoded[i] == src[i], s"byte $i")


### Invalid input rejection

`decode_string` must reject non-alphabet characters, lengths that are
not a multiple of 4, and embedded whitespace.

    #test
    test_decode_rejects_bad_char() -> unit
        val _, ok = decode_string("Zg!!")
        assert(!ok, "bad char rejected")

    #test
    test_decode_rejects_wrong_length() -> unit
        val _, ok = decode_string("Zg=")
        assert(!ok, "wrong length rejected")

    #test
    test_decode_rejects_space() -> unit
        val _, ok = decode_string("Zm 9v")
        assert(!ok, "space rejected")


### `decode_char`

    #test
    test_decode_char_A() -> unit
        assert(decode_char(byte('A')) == 0, "A=0")

    #test
    test_decode_char_Z() -> unit
        assert(decode_char(byte('Z')) == 25, "Z=25")

    #test
    test_decode_char_a() -> unit
        assert(decode_char(byte('a')) == 26, "a=26")

    #test
    test_decode_char_slash() -> unit
        assert(decode_char(byte('/')) == 63, "/=63")

    #test
    test_decode_char_pad() -> unit
        assert(decode_char(byte('=')) == -1, "pad=-1")

    #test
    test_decode_char_invalid() -> unit
        assert(decode_char(byte('!')) == -2, "invalid=-2")
