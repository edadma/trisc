std.utf8 — UTF-8 encoding and decoding
======================================

The `std.utf8` module provides the primitives for converting between
byte sequences and Unicode codepoints. Sysl strings are byte-oriented
`{ptr, len}` values with no enforced encoding, but by convention they
hold UTF-8. This module is what makes that convention usable.

The API follows Go's `unicode/utf8` package closely: invalid byte
sequences decode to the Unicode replacement character (U+FFFD) with a
consumed length of 1, letting callers skip one byte and continue
without aborting. Rust's "validity is a type invariant" approach is
stricter but requires up-front validation of every string at
construction time — a cost Sysl does not pay.

Codepoints are `char` (an alias for `u32`). Valid codepoints lie in
the range $[0, 0\text{xD7FF}] \cup [0\text{xE000}, 0\text{x10FFFF}]$;
the surrogate range $[0\text{xD800}, 0\text{xDFFF}]$ is excluded
because surrogates are a UTF-16 artefact and never appear in
well-formed UTF-8. Encodings are 1–4 bytes, with the lead byte
choosing the length:

| Width | Lead pattern | Continuations | Codepoint range |
|------:|:-------------|:--------------|:----------------|
| 1 | `0xxxxxxx` | none | $[0, 0\text{x7F}]$ |
| 2 | `110xxxxx` | `10xxxxxx` | $[0\text{x80}, 0\text{x7FF}]$ |
| 3 | `1110xxxx` | `10xxxxxx` ×2 | $[0\text{x800}, 0\text{xFFFF}]$ excl. surrogates |
| 4 | `11110xxx` | `10xxxxxx` ×3 | $[0\text{x10000}, 0\text{x10FFFF}]$ |

Invalid sequences include: truncated input, bad continuation bytes,
overlong encodings (using more bytes than necessary), surrogates, and
codepoints $> 0\text{x10FFFF}$.

Dependencies: `std.debug` (optional, for caller-side asserts).

    module std.utf8

    import std.debug.{assert}


Constants
---------

`RUNE_ERROR` is the Unicode replacement character (U+FFFD). Decoders
return it for invalid input; encoders emit it when given an invalid
codepoint.

`RUNE_SELF` is the boundary above which a codepoint requires
multi-byte encoding. Codepoints below `RUNE_SELF` are ASCII and
encode to exactly one byte equal to themselves.

`MAX_RUNE` is the largest valid Unicode codepoint, U+10FFFF.

`UTF_MAX` is the maximum number of bytes any single encoded rune
occupies — 4.

    val RUNE_ERROR: char = 0xFFFD
    val RUNE_SELF: char  = 0x80
    val MAX_RUNE: char   = 0x10FFFF
    val UTF_MAX: int     = 4


`valid_rune` — codepoint validity test
--------------------------------------

`valid_rune(r)` returns `true` iff `r` can be encoded as UTF-8:
non-surrogate, in the Unicode range. Cheap — one comparison in the
common (BMP non-surrogate) case.

    valid_rune(r: char) -> bool
        if r < 0xD800 then return true
        if r < 0xE000 then return false
        r <= MAX_RUNE


`rune_start` — lead-byte test
-----------------------------

`rune_start(b)` returns `true` iff `b` could be the first byte of a
UTF-8 encoding — i.e., not a continuation byte. Continuation bytes
match the pattern `10xxxxxx` ($0\text{x80}$ to $0\text{xBF}$), which
this test rejects with a single mask-and-compare.

Useful for resynchronizing after an invalid decode: scan forward
until `rune_start(b)` is true, then retry the decode.

    rune_start(b: byte) -> bool = (b & 0xC0) != 0x80


`rune_len` — encoded byte width
-------------------------------

`rune_len(r)` returns the number of bytes required to encode `r` as
UTF-8, or `-1` if `r` is not a valid codepoint.

    rune_len(r: char) -> int
        if r < 0x80 then return 1
        if r < 0x800 then return 2
        if r < 0xD800 then return 3
        if r < 0xE000 then return -1                 // surrogate range
        if r < 0x10000 then return 3
        if r <= MAX_RUNE then return 4
        -1


`encode_rune` — codepoint → bytes
---------------------------------

`encode_rune(p, r)` writes the UTF-8 encoding of `r` into `p` starting
at index 0 and returns the number of bytes written. Returns `0` if
`p` is too small to hold the encoding.

If `r` is not a valid codepoint, `RUNE_ERROR` (U+FFFD) is encoded in
its place. This matches Go's behaviour: lossy but non-panicking.

    encode_rune(p: []byte, r: char) -> int
        var c: char = r

        if !valid_rune(c) then c = RUNE_ERROR

        val n = len(p)

        if c < 0x80
            if n < 1 then return 0
            p[0] = byte(c)
            return 1

        if c < 0x800
            if n < 2 then return 0
            p[0] = byte(0xC0 | (c >> 6))             // 110xxxxx
            p[1] = byte(0x80 | (c & 0x3F))           // 10xxxxxx
            return 2

        if c < 0x10000
            if n < 3 then return 0
            p[0] = byte(0xE0 | (c >> 12))            // 1110xxxx
            p[1] = byte(0x80 | ((c >> 6) & 0x3F))    // 10xxxxxx
            p[2] = byte(0x80 | (c & 0x3F))           // 10xxxxxx
            return 3

        if n < 4 then return 0
        p[0] = byte(0xF0 | (c >> 18))                // 11110xxx
        p[1] = byte(0x80 | ((c >> 12) & 0x3F))       // 10xxxxxx
        p[2] = byte(0x80 | ((c >> 6) & 0x3F))        // 10xxxxxx
        p[3] = byte(0x80 | (c & 0x3F))               // 10xxxxxx
        4


`decode_rune` — bytes → codepoint
---------------------------------

`decode_rune(p)` decodes the first UTF-8 sequence in `p` and returns
the decoded codepoint together with the number of bytes consumed.

Result conventions (matching Go):

- Empty input returns `(RUNE_ERROR, 0)`.
- Any invalid sequence returns `(RUNE_ERROR, 1)`. Callers can skip
  one byte and continue, or use `rune_start` to resynchronize to the
  next plausible lead byte.
- Valid input returns the decoded rune and the actual byte width
  (1–4).

Invalid sequences include: lead byte outside the valid ranges,
truncated input (not enough continuation bytes), malformed
continuation bytes, overlong encodings, surrogate codepoints, and
codepoints exceeding `MAX_RUNE`.

    decode_rune(p: []byte) -> (char, int)
        val n = len(p)

        if n < 1 then return RUNE_ERROR, 0

        val b0: byte = p[0]

        if b0 < 0x80 then return char(b0), 1

The byte range $[0\text{x80}, 0\text{xC1}]$ contains continuation
bytes ($\geq 0\text{x80}$, $< 0\text{xC0}$) and the only two lead
bytes that would always be overlong ($0\text{xC0}, 0\text{xC1}$
encode codepoints $< 0\text{x80}$ that should have been single-byte).
Both are invalid and consume one byte.

        if b0 < 0xC2 then return RUNE_ERROR, 1

**2-byte sequence** — lead byte in $[0\text{xC2}, 0\text{xDF}]$ plus
one continuation. Reassemble: 5 bits of lead $\Vert$ 6 bits of cont.

        if b0 < 0xE0
            if n < 2 then return RUNE_ERROR, 1

            val b1: byte = p[1]

            if (b1 & 0xC0) != 0x80 then return RUNE_ERROR, 1

            val r: char = (char(b0 & 0x1F) << 6) | char(b1 & 0x3F)

            return r, 2

**3-byte sequence** — lead in $[0\text{xE0}, 0\text{xEF}]$ plus two
continuations. Reassemble: 4 + 6 + 6 = 16 bits. After decoding,
reject overlong (codepoint $< 0\text{x800}$) and surrogate
($0\text{xD800}$..$0\text{xDFFF}$) results.

        if b0 < 0xF0
            if n < 3 then return RUNE_ERROR, 1

            val b1: byte = p[1]
            val b2: byte = p[2]

            if (b1 & 0xC0) != 0x80 then return RUNE_ERROR, 1
            if (b2 & 0xC0) != 0x80 then return RUNE_ERROR, 1

            val r: char = (char(b0 & 0x0F) << 12) | (char(b1 & 0x3F) << 6) | char(b2 & 0x3F)

            if r < 0x800 then return RUNE_ERROR, 1                  // overlong
            if r >= 0xD800 && r < 0xE000 then return RUNE_ERROR, 1  // surrogate

            return r, 3

**4-byte sequence** — lead in $[0\text{xF0}, 0\text{xF4}]$ plus three
continuations. Reassemble: 3 + 6 + 6 + 6 = 21 bits. Reject overlong
(codepoint $< 0\text{x10000}$) and out-of-range
($> 0\text{x10FFFF}$).

        if b0 < 0xF5
            if n < 4 then return RUNE_ERROR, 1

            val b1: byte = p[1]
            val b2: byte = p[2]
            val b3: byte = p[3]

            if (b1 & 0xC0) != 0x80 then return RUNE_ERROR, 1
            if (b2 & 0xC0) != 0x80 then return RUNE_ERROR, 1
            if (b3 & 0xC0) != 0x80 then return RUNE_ERROR, 1

            val r: char = (char(b0 & 0x07) << 18) | (char(b1 & 0x3F) << 12) | (char(b2 & 0x3F) << 6) | char(b3 & 0x3F)

            if r < 0x10000 then return RUNE_ERROR, 1                // overlong
            if r > MAX_RUNE then return RUNE_ERROR, 1               // out of range

            return r, 4

Lead byte $\geq 0\text{xF5}$ would imply a codepoint past
$0\text{x10FFFF}$ and is rejected outright.

        return RUNE_ERROR, 1


`rune_count` — count codepoints in a slice
------------------------------------------

`rune_count(p)` returns the number of UTF-8 codepoints in `p`. Each
invalid byte sequence contributes one to the count, since it decodes
to a single `RUNE_ERROR`.

The implementation inlines a fast lead-byte classifier instead of
calling `decode_rune` per codepoint. The classifier produces the
same byte width that a full decode would (or 1 for invalid leads),
so the totals agree without paying for actual decoding.

    rune_count(p: []byte) -> int
        val n = len(p)

        var i = 0
        var count = 0

        while i < n
            var b: byte = p[i]
            var size: int = 1

            if b < 0x80 then size = 1                // ASCII
            else if b < 0xC2 then size = 1           // continuation or overlong lead
            else if b < 0xE0 then size = 2           // 2-byte lead
            else if b < 0xF0 then size = 3           // 3-byte lead
            else if b < 0xF5 then size = 4           // 4-byte lead
            else size = 1                            // out-of-range lead

            if i + size > n then size = 1            // truncated tail counts as 1

            i += size
            count++

        count


`valid` — well-formed UTF-8 check
---------------------------------

`valid(p)` returns `true` iff `p` is entirely well-formed UTF-8.
Returns `true` for the empty slice.

`decode_rune` returns `(RUNE_ERROR, 1)` for both an invalid sequence
*and* a valid three-byte encoding of U+FFFD itself. To distinguish,
`valid` peeks at the raw bytes when it sees `(RUNE_ERROR, 1)`: a real
U+FFFD is encoded as `EF BF BD`, so we look for that exact sequence
and treat it as valid (consuming 3 bytes); anything else with an
error result is genuinely invalid.

    valid(p: []byte) -> bool
        val n = len(p)

        var i = 0

        while i < n
            var size: int = 0
            var _r: char = 0

            _r, size = decode_rune(p[i:])

            if _r == RUNE_ERROR && size == 1
                if i + 3 <= n && p[i] == 0xEF && p[i+1] == 0xBF && p[i+2] == 0xBD
                    size = 3
                else
                    return false

            i += size

        true


Design notes
------------

**Why `(rune, int)` returns.** Decoding needs to produce both the
value and the byte width. Named structs would be clearer but heavier;
Sysl's tuple return keeps call sites compact and matches Go's idiom.

**Why `rune_count` inlines the size lookup.** Calling `decode_rune`
for every rune would double the per-codepoint work for the common
case of valid input. The inline classifier is faster and correct: it
produces the same total as `decode_rune` would, because invalid leads
in Go's model consume exactly one byte (`size = 1`) — and the
classifier falls through to that default for any ambiguous byte.

**`valid` vs `decode_rune` ambiguity.** Without the explicit U+FFFD
peek (`EF BF BD`), `valid` would incorrectly report any string
containing the literal replacement character as invalid. The
disambiguation only adds a one-time three-byte comparison along the
error path, so the common case (no errors) is unaffected.

**No streaming decoder.** A future iterator protocol will add
`runes(s)` to `std.strings`, but the primitives here are all
index-and-slice based. This module knows nothing about strings as a
type — just byte slices.


Tests
=====

### `valid_rune` and `rune_start`

    #test
    test_valid_rune_ascii() -> unit
        assert(valid_rune(0x41), "'A' is valid")
        assert(valid_rune(0x00), "U+0000 is valid")
        assert(valid_rune(0x7F), "U+007F is valid")

    #test
    test_valid_rune_rejects_surrogates() -> unit
        assert(!valid_rune(0xD800), "low surrogate start")
        assert(!valid_rune(0xDFFF), "high surrogate end")

    #test
    test_valid_rune_accepts_bmp_edges() -> unit
        assert(valid_rune(0xD7FF), "just before surrogates")
        assert(valid_rune(0xE000), "just after surrogates")

    #test
    test_valid_rune_rejects_above_max() -> unit
        assert(valid_rune(0x10FFFF), "MAX_RUNE itself")
        assert(!valid_rune(0x110000), "one past MAX_RUNE")

    #test
    test_rune_start_classifies_bytes() -> unit
        assert(rune_start(0x00), "ASCII")
        assert(rune_start(0x7F), "ASCII max")
        assert(!rune_start(0x80), "continuation byte start")
        assert(!rune_start(0xBF), "continuation byte end")
        assert(rune_start(0xC0), "2-byte lead (even if overlong)")
        assert(rune_start(0xE0), "3-byte lead")
        assert(rune_start(0xF0), "4-byte lead")


### `rune_len` — byte width by range

    #test
    test_rune_len_by_range() -> unit
        assert(rune_len(0x00) == 1, "NUL")
        assert(rune_len(0x7F) == 1, "max 1-byte")
        assert(rune_len(0x80) == 2, "min 2-byte")
        assert(rune_len(0x7FF) == 2, "max 2-byte")
        assert(rune_len(0x800) == 3, "min 3-byte")
        assert(rune_len(0xFFFF) == 3, "max 3-byte")
        assert(rune_len(0x10000) == 4, "min 4-byte")
        assert(rune_len(0x10FFFF) == 4, "MAX_RUNE")

    #test
    test_rune_len_rejects_invalid() -> unit
        assert(rune_len(0xD800) == -1, "surrogate")
        assert(rune_len(0xDFFF) == -1, "surrogate")
        assert(rune_len(0x110000) == -1, "above MAX_RUNE")


### `encode_rune` and `decode_rune` — round trip

Sample one codepoint from each of the four byte widths, encode it,
then decode the result and check that both the codepoint and the
width survive intact.

    #test
    test_roundtrip_ascii() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0x41)

        assert(n == 1, "ASCII is 1 byte")
        assert(buf[0] == 0x41, "raw byte match")

        val r, m = decode_rune(buf[:n])
        assert(r == 0x41, "decode gives 'A'")
        assert(m == 1, "consumed 1 byte")

    #test
    test_roundtrip_2byte() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0xE9)        // U+00E9 (é)
        assert(n == 2, "2 bytes")

        val r, m = decode_rune(buf[:n])
        assert(r == 0xE9, "decoded codepoint")
        assert(m == 2, "consumed 2 bytes")

    #test
    test_roundtrip_3byte() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0x20AC)      // U+20AC (€)
        assert(n == 3, "3 bytes")

        val r, m = decode_rune(buf[:n])
        assert(r == 0x20AC, "decoded codepoint")
        assert(m == 3, "consumed 3 bytes")

    #test
    test_roundtrip_4byte() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0x1F600)     // U+1F600 (😀)
        assert(n == 4, "4 bytes")

        val r, m = decode_rune(buf[:n])
        assert(r == 0x1F600, "decoded codepoint")
        assert(m == 4, "consumed 4 bytes")

    #test
    test_roundtrip_max_rune() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0x10FFFF)
        assert(n == 4, "MAX_RUNE is 4 bytes")

        val r, m = decode_rune(buf[:n])
        assert(r == 0x10FFFF, "MAX_RUNE round-trips")
        assert(m == 4, "consumed 4 bytes")


### `encode_rune` — invalid codepoints become RUNE_ERROR

    #test
    test_encode_surrogate_becomes_replacement() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0xD800)

        assert(n == 3, "RUNE_ERROR is 3 bytes")

        val r, m = decode_rune(buf[:n])
        assert(r == RUNE_ERROR, "decoded as U+FFFD")
        assert(m == 3, "consumed 3 bytes")

    #test
    test_encode_above_max_becomes_replacement() -> unit
        val buf = new [4]byte
        val n = encode_rune(buf[:], 0x200000)

        assert(n == 3, "RUNE_ERROR encoding")

        val r, m = decode_rune(buf[:n])
        assert(r == RUNE_ERROR, "decoded as U+FFFD")

    #test
    test_encode_buffer_too_small() -> unit
        val buf = new [1]byte
        val n = encode_rune(buf[:], 0xE9)
        assert(n == 0, "cannot encode 2-byte into 1-byte buffer")


### `decode_rune` — invalid input returns `(RUNE_ERROR, 1)`

Every pathological input we can construct must consume exactly one
byte and return the replacement character — that's the contract that
lets resynchronization (skip one byte and retry) make progress.

    #test
    test_decode_empty() -> unit
        val buf: []byte = []

        val r, n = decode_rune(buf)
        assert(r == RUNE_ERROR, "empty yields replacement")
        assert(n == 0, "empty consumes zero")

    #test
    test_decode_lone_continuation() -> unit
        val buf = new [1]byte
        buf[0] = 0x80

        val r, n = decode_rune(buf[:])
        assert(r == RUNE_ERROR, "continuation byte alone")
        assert(n == 1, "skip one byte")

    #test
    test_decode_truncated_2byte() -> unit
        val buf = new [1]byte
        buf[0] = 0xC3                            // lead of a 2-byte sequence with no continuation

        val r, n = decode_rune(buf[:])
        assert(r == RUNE_ERROR, "missing continuation")
        assert(n == 1, "skip one byte")

    #test
    test_decode_bad_continuation() -> unit
        val buf = new [2]byte
        buf[0] = 0xC3
        buf[1] = 0x40                            // not a continuation byte (top bits != 10)

        val r, n = decode_rune(buf[:])
        assert(r == RUNE_ERROR, "malformed continuation")
        assert(n == 1, "skip one byte")

    #test
    test_decode_overlong_2byte() -> unit
        val buf = new [2]byte
        buf[0] = 0xC0                            // would decode to U+0000 — overlong, must reject
        buf[1] = 0x80

        val r, n = decode_rune(buf[:])
        assert(r == RUNE_ERROR, "overlong 2-byte rejected")
        assert(n == 1, "skip one byte")

    #test
    test_decode_surrogate_3byte() -> unit
        val buf = new [3]byte
        buf[0] = 0xED                            // ED A0 80 = U+D800 — surrogate, invalid
        buf[1] = 0xA0
        buf[2] = 0x80

        val r, n = decode_rune(buf[:])
        assert(r == RUNE_ERROR, "surrogate rejected")
        assert(n == 1, "skip one byte")


### `rune_count`

    #test
    test_rune_count_ascii() -> unit
        val buf = new [5]byte
        buf[0] = byte('H')
        buf[1] = byte('e')
        buf[2] = byte('l')
        buf[3] = byte('l')
        buf[4] = byte('o')

        assert(rune_count(buf[:]) == 5, "5 ASCII runes")

    #test
    test_rune_count_mixed_widths() -> unit
        val buf = new [6]byte
        buf[0] = byte('A')                       // 1-byte ASCII
        buf[1] = 0xC3                            // 2-byte lead
        buf[2] = 0xA9                            // continuation: completes é
        buf[3] = 0xE2                            // 3-byte lead
        buf[4] = 0x82                            // continuation
        buf[5] = 0xAC                            // continuation: completes €

        assert(rune_count(buf[:]) == 3, "A é €")

    #test
    test_rune_count_empty() -> unit
        val buf: []byte = []
        assert(rune_count(buf) == 0, "empty has zero runes")


### `valid`

    #test
    test_valid_ascii() -> unit
        val buf = new [3]byte
        buf[0] = byte('a')
        buf[1] = byte('b')
        buf[2] = byte('c')

        assert(valid(buf[:]), "ASCII is valid")

    #test
    test_valid_empty_is_true() -> unit
        val buf: []byte = []
        assert(valid(buf), "empty is valid UTF-8")

    #test
    test_valid_replacement_char_passes() -> unit
        val buf = new [3]byte
        buf[0] = 0xEF                            // EF BF BD = literal U+FFFD, must be accepted
        buf[1] = 0xBF
        buf[2] = 0xBD

        assert(valid(buf[:]), "literal U+FFFD is valid input")

    #test
    test_valid_rejects_lone_continuation() -> unit
        val buf = new [1]byte
        buf[0] = 0x80
        assert(!valid(buf[:]), "continuation byte alone")

    #test
    test_valid_rejects_overlong() -> unit
        val buf = new [2]byte
        buf[0] = 0xC0
        buf[1] = 0x80
        assert(!valid(buf[:]), "overlong encoding")
