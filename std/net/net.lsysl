std.net — Networking primitives
===============================

Core types and helpers for networking: IPv4 addresses, MAC
addresses, byte-order conversion for on-the-wire protocols, and
the POSIX-style `AF_*`, `SOCK_*`, and `IPPROTO_*` constants the
socket layer reuses.

Host-order vs network-order
---------------------------

IP and TCP/UDP headers store multi-byte fields in network byte
order (big-endian). All three SLIX targets (TRISC, x86_64,
aarch64) run little-endian, so `htons` / `htonl` byte-swap. The
stored form of an `ipv4` value is **host-order** — you only
apply `htonl` at the moment a u32 is written into a packet
buffer (or read out of one).

Dependencies: none.

    module std.net

    import std.debug.{assert}


Byte order
----------

### htons

Host-to-network byte order for a 16-bit value. Takes and returns
`int` (sysl's default width) so call sites don't need to cast to
`u16`; bits above 15 are ignored.

    htons(v: int) -> int
        ((v & 0xff) << 8) | ((v >> 8) & 0xff)


### ntohs

Network-to-host byte order for a 16-bit value. Symmetric with
`htons`.

    ntohs(v: int) -> int
        htons(v)


### htonl

Host-to-network byte order for a 32-bit value.

    htonl(v: u32) -> u32
        ((v & 0xffu32) << 24u32) | ((v & 0xff00u32) << 8u32) | ((v >> 8u32) & 0xff00u32) | ((v >> 24u32) & 0xffu32)


### ntohl

Network-to-host byte order for a 32-bit value.

    ntohl(v: u32) -> u32
        htonl(v)


IPv4 addresses
--------------

Stored as a `u32` in host byte order so that comparison and
display work with normal integer operations.

### ipv4

Build an IPv4 address from four octets given in the familiar
`a.b.c.d` order. The result is a host-order u32 whose most
significant byte is `a`.

    ipv4(a: int, b: int, c: int, d: int) -> u32
        (u32(a & 0xff) << 24u32) | (u32(b & 0xff) << 16u32) | (u32(c & 0xff) << 8u32) | u32(d & 0xff)


### ipv4_octet

Extract octet `i` (0..3) from a host-order IPv4 value, with
`i == 0` returning the most significant byte.

    ipv4_octet(ip: u32, i: int) -> int
        if i == 0
            return int((ip >> 24u32) & 0xffu32)
        if i == 1
            return int((ip >> 16u32) & 0xffu32)
        if i == 2
            return int((ip >> 8u32) & 0xffu32)
        int(ip & 0xffu32)


### parse_ipv4

Parse a dotted-quad literal into a host-order u32. Returns 0 on
success and -1 on malformed input. No leading/trailing
whitespace; rejects anything other than digits, dots, and
end-of-string.

    parse_ipv4(s: string, out: *u32) -> int
        val p = *byte(s)
        val n = len(s)
        var octets: [4]int
        var oi = 0
        var cur = 0
        var have_digits = 0
        var i = 0
        while i < n
            val c = int(p[i])
            if c >= '0' && c <= '9'
                cur = cur * 10 + (c - '0')
                if cur > 255
                    return -1
                have_digits = 1
            else if c == '.'
                if have_digits == 0
                    return -1
                if oi >= 3
                    return -1
                octets[oi] = cur
                oi += 1
                cur = 0
                have_digits = 0
            else
                return -1
            i += 1
        if have_digits == 0
            return -1
        if oi != 3
            return -1
        octets[3] = cur
        *out = ipv4(octets[0], octets[1], octets[2], octets[3])
        0


Common addresses
----------------

    val INADDR_ANY: u32       = 0u32
    val INADDR_LOOPBACK: u32  = 0x7f000001u32
    val INADDR_BROADCAST: u32 = 0xffffffffu32


Socket constants
----------------

Mirror the POSIX numbering so a future POSIX-compat shim can
forward calls verbatim.

    val AF_INET       = 2

    val SOCK_STREAM   = 1
    val SOCK_DGRAM    = 2
    val SOCK_RAW      = 3

    val IPPROTO_IP    = 0
    val IPPROTO_ICMP  = 1
    val IPPROTO_TCP   = 6
    val IPPROTO_UDP   = 17


MAC addresses
-------------

Stored as a packed 6-byte array in on-wire order.

    struct MacAddr
        bytes: [6]byte


### mac_is_broadcast

True when every byte is `0xff`.

    mac_is_broadcast(m: *MacAddr) -> int
        var i = 0
        while i < 6
            if m.bytes[i] != 0xff
                return 0
            i += 1
        1


### mac_equal

Byte-wise equality. Returns 1 on match, 0 otherwise.

    mac_equal(a: *MacAddr, b: *MacAddr) -> int
        var i = 0
        while i < 6
            if a.bytes[i] != b.bytes[i]
                return 0
            i += 1
        1


Tests
=====


### Byte order

    #test
    test_htons_swaps() -> unit
        assert(htons(0x1234) == 0x3412, "htons 0x1234")
        assert(htons(0x00ff) == 0xff00, "htons low byte")
        assert(htons(0) == 0, "htons zero")

    #test
    test_ntohs_inverts_htons() -> unit
        assert(ntohs(htons(0x1234)) == 0x1234, "ntohs roundtrip")
        assert(ntohs(htons(0xbeef)) == 0xbeef, "ntohs deadbeef half")

    #test
    test_htonl_swaps() -> unit
        assert(htonl(0x12345678u32) == 0x78563412u32, "htonl swap")
        assert(htonl(0u32) == 0u32, "htonl zero")
        assert(htonl(0xffffffffu32) == 0xffffffffu32, "htonl all ones")

    #test
    test_ntohl_inverts_htonl() -> unit
        assert(ntohl(htonl(0xdeadbeefu32)) == 0xdeadbeefu32, "ntohl roundtrip")


### IPv4

    #test
    test_ipv4_builds_msb_first() -> unit
        val ip = ipv4(192, 168, 1, 1)
        assert(ip == 0xc0a80101u32, "192.168.1.1")

    #test
    test_ipv4_localhost() -> unit
        assert(ipv4(127, 0, 0, 1) == INADDR_LOOPBACK, "127.0.0.1 matches INADDR_LOOPBACK")

    #test
    test_ipv4_octet_extracts() -> unit
        val ip = ipv4(10, 20, 30, 40)
        assert(ipv4_octet(ip, 0) == 10, "octet 0")
        assert(ipv4_octet(ip, 1) == 20, "octet 1")
        assert(ipv4_octet(ip, 2) == 30, "octet 2")
        assert(ipv4_octet(ip, 3) == 40, "octet 3")

    #test
    test_parse_ipv4_ok() -> unit
        var out: u32 = 0u32
        assert(parse_ipv4("192.168.1.1", &out) == 0, "parse ok")
        assert(out == 0xc0a80101u32, "parse value")

    #test
    test_parse_ipv4_loopback() -> unit
        var out: u32 = 0u32
        assert(parse_ipv4("127.0.0.1", &out) == 0, "parse loopback")
        assert(out == INADDR_LOOPBACK, "loopback value")

    #test
    test_parse_ipv4_rejects_empty_octet() -> unit
        var out: u32 = 0u32
        assert(parse_ipv4("..", &out) == -1, "empty octets")

    #test
    test_parse_ipv4_rejects_overflow() -> unit
        var out: u32 = 0u32
        assert(parse_ipv4("256.0.0.0", &out) == -1, "256 out of range")

    #test
    test_parse_ipv4_rejects_too_few() -> unit
        var out: u32 = 0u32
        assert(parse_ipv4("1.2.3", &out) == -1, "only 3 octets")

    #test
    test_parse_ipv4_rejects_trailing_junk() -> unit
        var out: u32 = 0u32
        assert(parse_ipv4("1.2.3.4x", &out) == -1, "trailing char")


### MAC

    #test
    test_mac_broadcast_all_ff() -> unit
        var m: MacAddr
        var i = 0
        while i < 6
            m.bytes[i] = 0xff
            i += 1
        assert(mac_is_broadcast(&m) == 1, "all ff is broadcast")

    #test
    test_mac_broadcast_rejects_mixed() -> unit
        var m: MacAddr
        var i = 0
        while i < 6
            m.bytes[i] = 0xff
            i += 1
        m.bytes[2] = 0x00
        assert(mac_is_broadcast(&m) == 0, "mixed is not broadcast")

    #test
    test_mac_equal() -> unit
        var a: MacAddr
        var b: MacAddr
        var i = 0
        while i < 6
            a.bytes[i] = byte(i + 1)
            b.bytes[i] = byte(i + 1)
            i += 1
        assert(mac_equal(&a, &b) == 1, "equal")
        b.bytes[3] = 0
        assert(mac_equal(&a, &b) == 0, "differ at 3")
