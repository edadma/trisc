std.strconv — Numeric and boolean string conversion
=====================================================

The `std.strconv` module parses and formats primitive values
as decimal strings. It is the second-lowest text-handling
module in the standard library: it depends only on `std.mem`
for byte manipulation, and is itself the foundation for
`std.builder` (which uses it for numeric interpolation) and
for user code that needs to read or write simple numeric text.

API shape:

- **Parsers** take a `string` and return `Result[T, Error]`,
  where `T` is the parsed type (`bool`, `i64`, `int`) and
  `Error` is from `std.errors`. On success the result is
  `Ok(value)`; on failure it is `Err(new_error(msg))` with a
  short message describing the failure reason. Callers use
  `match`, `?`, `unwrap`, or `is_ok`/`is_err` to handle the
  result.

- **Formatters** return a freshly-allocated `string` containing
  the decimal representation. A second, lower-level form
  (`format_*_into`) writes into a caller-supplied buffer and
  returns the number of bytes written, which is what
  `std.builder` will call internally to avoid an allocation.

Dependencies: `std.mem` (not directly used in this file, but
conceptually part of the layering).


    module std.strconv

    import std.debug.{assert}
    import std.errors.{Error, new_error}
    import std.result.{Result, Ok, Err, is_ok, is_err, unwrap, unwrap_err}


Parsers
-------

### parse_bool

`parse_bool(s)` recognizes exactly `"true"`, `"false"`, `"1"`,
and `"0"`. No leading or trailing whitespace, no alternate
casings (`"True"`, `"TRUE"`, `"yes"`, `"no"` all reject). The
strict set keeps this module unopinionated — callers that
want lenient behavior can normalize their input first.

    parse_bool(s: string) -> Result[bool, Error]
        val n = len(s)

        if n == 1
            if s[0] == byte('1') then return Ok(true)
            if s[0] == byte('0') then return Ok(false)
            return Err(new_error("invalid bool"))

        if n == 4 && s[0] == byte('t') && s[1] == byte('r') && s[2] == byte('u') && s[3] == byte('e') then return Ok(true)
        if n == 5 && s[0] == byte('f') && s[1] == byte('a') && s[2] == byte('l') && s[3] == byte('s') && s[4] == byte('e') then return Ok(false)

        return Err(new_error("invalid bool"))


### parse_i64

`parse_i64(s)` parses a decimal integer with an optional
leading `+` or `-`. At least one digit is required. The entire
input must be consumed; trailing non-digits cause failure.

The full 64-bit signed range `[-2^63, 2^63-1]` is supported,
including `MIN_I64` (which cannot be represented as a positive
magnitude). This is achieved by accumulating the value as a
negative number: `|MIN_I64|` is one larger than `MAX_I64`, so
negative-accumulation covers the whole range with one code path.

    parse_i64(s: string) -> Result[i64, Error]
        val n = len(s)

        if n == 0 then return Err(new_error("invalid integer"))

        var i = 0
        var neg = false

        if s[0] == byte('+')
            i = 1
        else if s[0] == byte('-')
            neg = true
            i = 1

        if i >= n then return Err(new_error("invalid integer"))

Accumulate as a *negative* i64. The signed range is asymmetric —
$|\mathrm{MIN\_I64}| = \mathrm{MAX\_I64} + 1$ — so building the value
on the negative side covers MIN_I64 with the same code path. `LIMIT`
is $\lfloor \mathrm{MIN\_I64} / 10 \rfloor$, the largest magnitude
that can survive a `* 10` without wrapping.

        var acc: i64 = 0i64
        val LIMIT: i64 = -922337203685477580i64

        while i < n
            val b = s[i]

            if b < byte('0') || b > byte('9') then return Err(new_error("invalid integer"))

            val d: i64 = i64(b - byte('0'))

            if acc < LIMIT then return Err(new_error("integer overflow"))
            if acc == LIMIT && d > 8i64 then return Err(new_error("integer overflow"))

            acc = acc * 10i64 - d
            i++

        if neg then return Ok(acc)

For a positive result we negate. The single value `acc == MIN_I64`
would overflow `-acc` (since `-MIN_I64 > MAX_I64`); reject that case
explicitly before negating.

        if acc < -9223372036854775807i64 then return Err(new_error("integer overflow"))

        return Ok(-acc)


### parse_int

`parse_int(s)` is `parse_i64` narrowed to the 32-bit signed
range. Values outside `[MIN_I32, MAX_I32]` return
`Err(new_error("integer overflow"))` even if they are valid
i64 values.

    parse_int(s: string) -> Result[int, Error]
        val r = parse_i64(s)

        if is_err(r) then return Err(unwrap_err(r))

        val v = unwrap(r)

        if v > 2147483647i64 then return Err(new_error("integer overflow"))
        if v < -2147483648i64 then return Err(new_error("integer overflow"))

        return Ok(int(v))


Formatters
----------

### format_bool

`format_bool(b)` returns `"true"` or `"false"` as a string.

    format_bool(b: bool) -> string
        if b then "true" else "false"


### format_i64_into

`format_i64_into(dst, n)` writes the decimal representation of
`n` into `dst` starting at index 0, and returns the number of
bytes written. Returns `0` if `dst` is too small (maximum of
20 bytes is required, for `-9223372036854775808`).

Digits are generated by repeated division. To handle `MIN_I64`,
the value is accumulated negatively throughout, so `-n` is
never computed on a positive overflow path.

    format_i64_into(dst: []byte, n: i64) -> int
        val cap = len(dst)

        if cap < 1 then return 0

Operate on a negative copy of `x` so we never compute `-MIN_I64`
(which would overflow). The digit extraction below uses unary minus
on the modulus, so the produced digits are non-negative either way.

        var x: i64 = n

        if x > 0i64 then x = -x

A 20-byte scratch buffer is enough for any `i64`: 19 digits plus an
optional sign byte. Digits are written from the right and the final
slice from `i` to 20 is the formatted number.

        val tmp = new [20]byte
        var i = 20

        if x == 0i64
            i--
            tmp[i] = byte('0')
        else
            while x < 0i64
                i--

                val d: i64 = -(x - (x / 10i64) * 10i64)

                tmp[i] = byte(int(byte('0')) + int(d))
                x = x / 10i64

        if n < 0i64
            i--
            tmp[i] = byte('-')

        val written: int = 20 - i

        if written > cap then return 0

        for j in 0..<written do dst[j] = tmp[i + j]

        written


### format_i64

`format_i64(n)` returns the decimal representation of `n` as
a freshly-allocated `string`.

    format_i64(n: i64) -> string
        val buf = new [20]byte
        val written = format_i64_into(buf[:], n)

        string(buf[:written])


### format_int

`format_int(n)` is `format_i64` on an `int` value.

    format_int(n: int) -> string = format_i64(i64(n))


Multi-base parsing
------------------

### digit_val

`digit_val(b, base)` returns the numeric value of byte `b`
in the given base, or -1 if invalid.

    digit_val(b: byte, base: int) -> int
        if b >= byte('0') && b <= byte('9')
            val v = int(b - byte('0'))
            if v < base then return v
            return -1
        if b >= byte('a') && b <= byte('z')
            val v = 10 + int(b - byte('a'))
            if v < base then return v
            return -1
        if b >= byte('A') && b <= byte('Z')
            val v = 10 + int(b - byte('A'))
            if v < base then return v
            return -1
        return -1


### parse_i64_base

`parse_i64_base(s, base)` parses an integer in the given base
(2–36). Accepts an optional leading `+` or `-`. Digits above 9
use letters a–z (case-insensitive).

    parse_i64_base(s: string, base: int) -> Result[i64, Error]
        val n = len(s)

        if n == 0 then return Err(new_error("invalid integer"))
        if base < 2 || base > 36 then return Err(new_error("invalid base"))

        var i = 0
        var neg = false

        if s[0] == byte('+')
            i = 1
        else if s[0] == byte('-')
            neg = true
            i = 1

        if i >= n then return Err(new_error("invalid integer"))

Same negative-accumulation trick as `parse_i64`, generalized over an
arbitrary base. The pre-multiply check rejects any value that would
exceed the magnitude of MIN_I64 once multiplied; the post-subtract
sign check catches the remaining "MIN_I64 ± 1 digit" edge cases.

        var acc: i64 = 0i64
        val b: i64 = i64(base)
        val limit: i64 = -9223372036854775807i64 / b - 1i64

        while i < n
            val d = digit_val(s[i], base)

            if d < 0 then return Err(new_error("invalid digit for base"))

            if acc < limit then return Err(new_error("integer overflow"))

            acc = acc * b - i64(d)

            if acc > 0i64 then return Err(new_error("integer overflow"))    // wrapped past MIN_I64

            i++

        if neg then return Ok(acc)

        if acc < -9223372036854775807i64 then return Err(new_error("integer overflow"))

        return Ok(-acc)


### parse_int_base

`parse_int_base(s, base)` is `parse_i64_base` narrowed to
32-bit signed range.

    parse_int_base(s: string, base: int) -> Result[int, Error]
        val r = parse_i64_base(s, base)

        if is_err(r) then return Err(unwrap_err(r))

        val v = unwrap(r)

        if v > 2147483647i64 then return Err(new_error("integer overflow"))
        if v < -2147483648i64 then return Err(new_error("integer overflow"))

        return Ok(int(v))


Multi-base formatting
---------------------

### format_i64_base_into

`format_i64_base_into(dst, n, base)` writes the representation
of `n` in the given base (2–36) into `dst`. Digits above 9 use
lowercase letters a–z. Returns the number of bytes written.

    format_i64_base_into(dst: []byte, n: i64, base: int) -> int
        val cap = len(dst)

        if cap < 1 then return 0
        if base < 2 || base > 36 then return 0

        val b: i64 = i64(base)
        val digits: [36]byte = "0123456789abcdefghijklmnopqrstuvwxyz"

        var x: i64 = n
        if x > 0i64 then x = -x

        val tmp = new [65]byte
        var i = 65

        if x == 0i64
            i--
            tmp[i] = byte('0')
        else
            while x < 0i64
                i--
                val d: i64 = -(x - (x / b) * b)
                tmp[i] = digits[int(d)]
                x = x / b

        if n < 0i64
            i--
            tmp[i] = byte('-')

        val written = 65 - i

        if written > cap then return 0

        for j in 0..<written do dst[j] = tmp[i + j]

        written


### format_i64_base

`format_i64_base(n, base)` returns the string representation
of `n` in the given base.

    format_i64_base(n: i64, base: int) -> string
        val buf = new [65]byte
        val written = format_i64_base_into(buf[:], n, base)
        string(buf[:written])


### format_int_base

`format_int_base(n, base)` is `format_i64_base` on an `int`.

    format_int_base(n: int, base: int) -> string = format_i64_base(i64(n), base)


Design notes
------------

**Why `Result[T, Error]`.** Parsers return `Result[T, Error]`
using `std.result.Result` and `std.errors.Error`. This gives
callers pattern matching (`Ok(v)` / `Err(e)`), `?` propagation,
`unwrap`, and `is_ok`/`is_err` — the full Rust-style error
handling toolkit. Error messages are short strings describing
the failure reason (`"invalid integer"`, `"integer overflow"`,
`"invalid bool"`, etc.).

**Why strict parsing.** `parse_i64(" 42 ")` fails, not succeeds.
This module is a primitive; lenient behavior (whitespace
trimming, alternate radices, thousands separators) belongs in
higher-level modules that explicitly opt in. A strict primitive
can always be wrapped; a lenient one cannot be unwrapped.

**Why parse_bool accepts "1"/"0".** Many data sources (CLI
flags, CSV, config files) emit `1`/`0` for booleans. Accepting
both pays for itself immediately. Rejecting `"True"`/`"TRUE"`
is deliberate: locale-dependent or case-insensitive matching
belongs outside the primitive.

**Multi-base support.** `parse_i64_base(s, base)` and
`format_i64_base(n, base)` support bases 2–36, matching
Go's `strconv.ParseInt` and `strconv.FormatInt`. Digits
above 9 use lowercase a–z; parsing accepts both cases.

**No floating-point yet.** `parse_f64` / `format_f64` require
IEEE 754 rounding, shortest-representation algorithms
(Grisu3/Ryu), and scientific notation — enough complexity to
justify their own module (`std.strconv.float` or similar).
Deferred until there's concrete demand from user code.

**Allocation in format_i64.** The public formatters allocate.
Callers in hot paths should use `format_i64_into` with a
caller-owned buffer; `std.builder` will do exactly this. The
allocation is small (up to 20 bytes, ref-counted), so it is
fine for most uses.


Tests
=====

### parse_bool

    #test
    test_parse_bool_true() -> unit
        val r = parse_bool("true")
        assert(is_ok(r), "true recognized")
        assert(unwrap(r), "value is true")

    #test
    test_parse_bool_false() -> unit
        val r = parse_bool("false")
        assert(is_ok(r), "false recognized")
        assert(!unwrap(r), "value is false")

    #test
    test_parse_bool_one() -> unit
        val r = parse_bool("1")
        assert(is_ok(r), "1 recognized")
        assert(unwrap(r), "value is true")

    #test
    test_parse_bool_zero() -> unit
        val r = parse_bool("0")
        assert(is_ok(r), "0 recognized")
        assert(!unwrap(r), "value is false")

    #test
    test_parse_bool_rejects_caps() -> unit
        val r1 = parse_bool("True")
        assert(is_err(r1), "True rejected")

        val r2 = parse_bool("TRUE")
        assert(is_err(r2), "TRUE rejected")

    #test
    test_parse_bool_rejects_yes_no() -> unit
        val r1 = parse_bool("yes")
        assert(is_err(r1), "yes rejected")

        val r2 = parse_bool("no")
        assert(is_err(r2), "no rejected")

    #test
    test_parse_bool_rejects_whitespace() -> unit
        val r = parse_bool(" true")
        assert(is_err(r), "leading space rejected")

    #test
    test_parse_bool_rejects_empty() -> unit
        val r = parse_bool("")
        assert(is_err(r), "empty rejected")


### parse_i64

    #test
    test_parse_i64_zero() -> unit
        val r = parse_i64("0")
        assert(is_ok(r), "zero parses")
        assert(unwrap(r) == 0i64, "value")

    #test
    test_parse_i64_positive() -> unit
        val r = parse_i64("42")
        assert(is_ok(r), "parses")
        assert(unwrap(r) == 42i64, "value")

    #test
    test_parse_i64_explicit_plus() -> unit
        val r = parse_i64("+123")
        assert(is_ok(r), "plus sign accepted")
        assert(unwrap(r) == 123i64, "value")

    #test
    test_parse_i64_negative() -> unit
        val r = parse_i64("-42")
        assert(is_ok(r), "negative parses")
        assert(unwrap(r) == -42i64, "value")

    #test
    test_parse_i64_max() -> unit
        val r = parse_i64("9223372036854775807")
        assert(is_ok(r), "MAX_I64 parses")
        assert(unwrap(r) == 9223372036854775807i64, "value")

    #test
    test_parse_i64_min() -> unit
        val r = parse_i64("-9223372036854775808")
        assert(is_ok(r), "MIN_I64 parses (edge case)")
        assert(unwrap(r) == -9223372036854775807i64 - 1i64, "value")

    #test
    test_parse_i64_overflow_positive() -> unit
        val r = parse_i64("9223372036854775808")
        assert(is_err(r), "MAX_I64+1 rejects")

    #test
    test_parse_i64_overflow_negative() -> unit
        val r = parse_i64("-9223372036854775809")
        assert(is_err(r), "MIN_I64-1 rejects")

    #test
    test_parse_i64_rejects_empty() -> unit
        val r = parse_i64("")
        assert(is_err(r), "empty rejects")

    #test
    test_parse_i64_rejects_sign_only() -> unit
        val r1 = parse_i64("+")
        assert(is_err(r1), "lone plus")

        val r2 = parse_i64("-")
        assert(is_err(r2), "lone minus")

    #test
    test_parse_i64_rejects_non_digit() -> unit
        val r1 = parse_i64("12x3")
        assert(is_err(r1), "embedded non-digit")

        val r2 = parse_i64("abc")
        assert(is_err(r2), "all letters")

    #test
    test_parse_i64_rejects_trailing_garbage() -> unit
        val r = parse_i64("42 ")
        assert(is_err(r), "trailing space")

    #test
    test_parse_i64_rejects_leading_zeros_are_ok() -> unit
        val r = parse_i64("007")
        assert(is_ok(r), "leading zeros permitted")
        assert(unwrap(r) == 7i64, "value")


### parse_int

    #test
    test_parse_int_basic() -> unit
        val r = parse_int("100")
        assert(is_ok(r), "parses")
        assert(unwrap(r) == 100, "value")

    #test
    test_parse_int_range_check_positive() -> unit
        val r = parse_int("2147483648")
        assert(is_err(r), "MAX_I32+1 rejects")

    #test
    test_parse_int_range_check_negative() -> unit
        val r = parse_int("-2147483649")
        assert(is_err(r), "MIN_I32-1 rejects")

    #test
    test_parse_int_max() -> unit
        val r = parse_int("2147483647")
        assert(is_ok(r), "MAX_I32 parses")
        assert(unwrap(r) == 2147483647, "value")


### format_bool

    #test
    test_format_bool_true() -> unit
        assert(format_bool(true) == "true", "true")

    #test
    test_format_bool_false() -> unit
        assert(format_bool(false) == "false", "false")


### format_i64 and format_int

    #test
    test_format_i64_zero() -> unit
        assert(format_i64(0i64) == "0", "zero")

    #test
    test_format_i64_positive() -> unit
        assert(format_i64(42i64) == "42", "positive")

    #test
    test_format_i64_negative() -> unit
        assert(format_i64(-42i64) == "-42", "negative")

    #test
    test_format_i64_max() -> unit
        assert(format_i64(9223372036854775807i64) == "9223372036854775807", "MAX_I64")

    #test
    test_format_i64_min() -> unit
        assert(format_i64(-9223372036854775807i64 - 1i64) == "-9223372036854775808", "MIN_I64")

    #test
    test_format_int_basic() -> unit
        assert(format_int(100) == "100", "positive")
        assert(format_int(-100) == "-100", "negative")
        assert(format_int(0) == "0", "zero")


### round-trips

    #test
    test_roundtrip_i64_positive() -> unit
        val n = 1234567890i64
        val r = parse_i64(format_i64(n))
        assert(is_ok(r), "parses back")
        assert(unwrap(r) == n, "value preserved")

    #test
    test_roundtrip_i64_negative() -> unit
        val n = -9876543210i64
        val r = parse_i64(format_i64(n))
        assert(is_ok(r), "parses back")
        assert(unwrap(r) == n, "value preserved")

    #test
    test_roundtrip_i64_min() -> unit
        val n = -9223372036854775807i64 - 1i64
        val r = parse_i64(format_i64(n))
        assert(is_ok(r), "MIN_I64 round-trips")
        assert(unwrap(r) == n, "value preserved")

    #test
    test_roundtrip_bool_true() -> unit
        val r = parse_bool(format_bool(true))
        assert(is_ok(r), "parses back")
        assert(unwrap(r), "value preserved")

    #test
    test_roundtrip_bool_false() -> unit
        val r = parse_bool(format_bool(false))
        assert(is_ok(r), "parses back")
        assert(!unwrap(r), "value preserved")


### parse_i64_base

    #test
    test_parse_hex_basic() -> unit
        val r = parse_i64_base("ff", 16)
        assert(is_ok(r), "parses")
        assert(unwrap(r) == 255i64, "value")

    #test
    test_parse_hex_uppercase() -> unit
        val r = parse_i64_base("FF", 16)
        assert(is_ok(r), "uppercase accepted")
        assert(unwrap(r) == 255i64, "value")

    #test
    test_parse_hex_mixed_case() -> unit
        val r = parse_i64_base("DeAdBeEf", 16)
        assert(is_ok(r), "mixed case")
        assert(unwrap(r) == 3735928559i64, "value")

    #test
    test_parse_hex_zero() -> unit
        val r = parse_i64_base("0", 16)
        assert(is_ok(r), "parses")
        assert(unwrap(r) == 0i64, "value")

    #test
    test_parse_hex_negative() -> unit
        val r = parse_i64_base("-1a", 16)
        assert(is_ok(r), "negative hex")
        assert(unwrap(r) == -26i64, "value")

    #test
    test_parse_binary() -> unit
        val r = parse_i64_base("11010", 2)
        assert(is_ok(r), "binary")
        assert(unwrap(r) == 26i64, "value")

    #test
    test_parse_octal() -> unit
        val r = parse_i64_base("777", 8)
        assert(is_ok(r), "octal")
        assert(unwrap(r) == 511i64, "value")

    #test
    test_parse_base36() -> unit
        val r = parse_i64_base("zz", 36)
        assert(is_ok(r), "base36")
        assert(unwrap(r) == 1295i64, "value")

    #test
    test_parse_hex_rejects_invalid_digit() -> unit
        val r = parse_i64_base("fg", 16)
        assert(is_err(r), "g invalid in base 16")

    #test
    test_parse_binary_rejects_2() -> unit
        val r = parse_i64_base("102", 2)
        assert(is_err(r), "2 invalid in base 2")

    #test
    test_parse_base_rejects_invalid_base() -> unit
        val r1 = parse_i64_base("0", 1)
        assert(is_err(r1), "base 1 rejected")
        val r2 = parse_i64_base("0", 37)
        assert(is_err(r2), "base 37 rejected")

    #test
    test_parse_hex_empty() -> unit
        val r = parse_i64_base("", 16)
        assert(is_err(r), "empty rejected")


### format_i64_base

    #test
    test_format_hex_basic() -> unit
        assert(format_i64_base(255i64, 16) == "ff", "ff")

    #test
    test_format_hex_zero() -> unit
        assert(format_i64_base(0i64, 16) == "0", "zero")

    #test
    test_format_hex_negative() -> unit
        assert(format_i64_base(-26i64, 16) == "-1a", "negative hex")

    #test
    test_format_binary() -> unit
        assert(format_i64_base(26i64, 2) == "11010", "binary")

    #test
    test_format_octal() -> unit
        assert(format_i64_base(511i64, 8) == "777", "octal")

    #test
    test_format_base36() -> unit
        assert(format_i64_base(1295i64, 36) == "zz", "base36")

    #test
    test_format_hex_large() -> unit
        assert(format_i64_base(3735928559i64, 16) == "deadbeef", "deadbeef")


### round-trips (multi-base)

    #test
    test_roundtrip_hex() -> unit
        val n = 48879i64
        val r = parse_i64_base(format_i64_base(n, 16), 16)
        assert(is_ok(r), "parses back")
        assert(unwrap(r) == n, "value preserved")

    #test
    test_roundtrip_binary() -> unit
        val n = 12345i64
        val r = parse_i64_base(format_i64_base(n, 2), 2)
        assert(is_ok(r), "parses back")
        assert(unwrap(r) == n, "value preserved")

    #test
    test_roundtrip_octal() -> unit
        val n = -4096i64
        val r = parse_i64_base(format_i64_base(n, 8), 8)
        assert(is_ok(r), "parses back")
        assert(unwrap(r) == n, "value preserved")
