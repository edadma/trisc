std.parsyl — combinator parsing (single literate source)
=========================================================

This module is a **pedagogical** parser-combinator library for Sysl.
Parsers are **closures** with type `func(string, int) -> ParseMaybe[T]`;
combinators (`alt`, `seq`, `map`, repetition) return **new** closures
that capture their arguments.

**Why one file?** Generic data types (`enum ParseMaybe[T]` here) are not
re-exported across same-module sibling paths in the current Sysl driver, so
splitting the implementation into multiple `.lsysl` files would force redundant
monomorphic copies. Keeping the whole lesson in `parsyl.lsysl` lets the
prose, API, and executable `#test` blocks live together.

**Reading path:** skim the prose headers in order, then jump to the
**Tests** section at the bottom to see everything execute under `sysl test std/parsyl`.

| Section | Content |
|---------|---------|
| Types and combinators | `ParseMaybe`, `succeed`, `lit`, `alt`, `seq`, `map`, `run_all_*`, repetition |
| Natural numbers | Digit `map`, `many1_int`, decimal fold |
| Tests | small examples and integration checks |


Core types and combinators
-------------------------

A **hit** stores both the advanced cursor `pos` and semantic `value`.
`Miss` means "this parser does not match starting at this index".

    module std.parsyl

    enum ParseMaybe[T]
        Got(pos: int, value: T)
        Miss

    succeed[T](v: T) -> func(string, int) -> ParseMaybe[T] =
        (s: string, i: int) ->
            val captured = v
            Got(i, captured)

    fail[T]() -> func(string, int) -> ParseMaybe[T] =
        (s: string, i: int) -> Miss

    satisfy(pred: func(int) -> bool) -> func(string, int) -> ParseMaybe[int] =
        (s: string, pos: int) ->
            if pos >= len(s) then Miss
            else
                val next = pos + 1
                if pred(s[pos]) then Got(next, s[pos]) else Miss

    lit(ch: int) -> func(string, int) -> ParseMaybe[int] =
        satisfy((x: int) -> x == ch)

    alt[T](a: func(string, int) -> ParseMaybe[T], b: func(string, int) -> ParseMaybe[T]) -> func(string, int) -> ParseMaybe[T] =
        (s: string, i: int) ->
            a(s, i) match
                Got(p, v) -> Got(p, v)
                Miss -> b(s, i)

    seq[A, B](a: func(string, int) -> ParseMaybe[A], b: func(string, int) -> ParseMaybe[B]) -> func(string, int) -> ParseMaybe[(A, B)] =
        (s: string, i: int) ->
            a(s, i) match
                Got(p1, va) ->
                    b(s, p1) match
                        Got(p2, vb) -> Got(p2, (va, vb))
                        Miss -> Miss
                Miss -> Miss

    map[A, B](p: func(string, int) -> ParseMaybe[A], f: func(A) -> B) -> func(string, int) -> ParseMaybe[B] =
        (s: string, i: int) ->
            p(s, i) match
                Got(p, v) -> Got(p, f(v))
                Miss -> Miss

    run_all[T](p: func(string, int) -> ParseMaybe[T], input: string) -> ParseMaybe[T] =
        p(input, 0) match
            Got(p, v) ->
                if p != len(input) then Miss
                else Got(len(input), v)
            Miss -> Miss

    run_all_int(p: func(string, int) -> ParseMaybe[int], input: string) -> ParseMaybe[int] =
        p(input, 0) match
            Got(p, v) ->
                if p != len(input) then Miss
                else Got(len(input), v)
            Miss -> Miss

    run_all_ints(p: func(string, int) -> ParseMaybe[[]int], input: string) -> ParseMaybe[[]int] =
        p(input, 0) match
            Got(p, v) ->
                if p != len(input) then Miss
                else Got(len(input), v)
            Miss -> Miss

    many0_int(p: func(string, int) -> ParseMaybe[int]) -> func(string, int) -> ParseMaybe[[]int] =
        (s: string, i0: int) ->
            var i = i0
            val mem = new [256]int
            var acc = mem[:0]
            var done = false
            while !done
                p(s, i) match
                    Got(pos, vv) ->
                        acc = append(acc, vv)
                        i = pos
                    Miss ->
                        done = true
            Got(i, acc)

    many1_int(p: func(string, int) -> ParseMaybe[int]) -> func(string, int) -> ParseMaybe[[]int] =
        (s: string, i0: int) ->
            p(s, i0) match
                Miss -> Miss
                Got(p1, v0) ->
                    var i = p1
                    val mem = new [256]int
                    var acc = append(mem[:0], v0)
                    var done = false
                    while !done
                        p(s, i) match
                            Got(pos, vv) ->
                                acc = append(acc, vv)
                                i = pos
                            Miss ->
                                done = true
                    Got(i, acc)


Natural numbers (map + many1)
------------------------------

    private digit_code_unit() -> func(string, int) -> ParseMaybe[int] =
        satisfy(ch -> int('0') <= ch <= int('9'))

    private digit_value() -> func(string, int) -> ParseMaybe[int] =
        map(digit_code_unit(), (ch: int) -> ch - int('0'))

    private fold_decimal(digits: []int) -> int
        var acc = 0
        for i in 0..<len(digits)
            acc = acc * 10 + digits[i]
        acc

    natural() -> func(string, int) -> ParseMaybe[int] =
        map(many1_int(digit_value()), (ds: []int) -> fold_decimal(ds))

    private digit_pred(ch: int) -> bool =
        int('0') <= ch <= int('9')

    private digit_unit() -> func(string, int) -> ParseMaybe[int] =
        satisfy(digit_pred)


Tests
=====

Smoke, literals, `seq`, repetition, naturals: each `#test` is a tiny
worked example (run `sysl test std/parsyl`).

    #test
    smoke_lit_then_run_all() -> void
        val p = lit(int('z'))
        run_all_int(p, "z") match
            Got(_, ch) -> expect(ch, int('z'), "literal round-trip")
            Miss -> assert(false, "lit(z)")

    #test
    ex_lit_a_matches() -> void
        val p = lit(int('a'))
        run_all_int(p, "a") match
            Got(_, _) -> assert(true, "ok")
            Miss -> assert(false, "expected a")

    #test
    ex_lit_a_rejects_b() -> void
        val p = lit(int('a'))
        run_all_int(p, "b") match
            Got(_, _) -> assert(false, "no match")
            Miss -> assert(true, "ok")

    #test
    ex_alt_ab_accepts_either_byte() -> void
        val p = alt(lit(int('a')), lit(int('b')))
        run_all_int(p, "a") match
            Got(_, _) -> assert(true, "a")
            Miss -> assert(false, "a")
        run_all_int(p, "b") match
            Got(_, _) -> assert(true, "b")
            Miss -> assert(false, "b")

    #test
    ex_seq_ab_then_map() -> void
        val raw = seq(lit(int('a')), lit(int('b')))
        val p = map(raw, (pair: (int, int)) -> pair.0 + pair.1)
        run_all_int(p, "ab") match
            Got(_, sum) -> expect(sum, int('a') + int('b'), "sum")
            Miss -> assert(false, "ab")

    #test
    integration_xy_checksum() -> void
        val p = map(
            seq(lit(int('x')), lit(int('y'))),
            (pair: (int, int)) -> pair.0 * 1000 + pair.1)
        run_all_int(p, "xy") match
            Got(_, v) -> expect(v, int('x') * 1000 + int('y'), "checksum")
            Miss -> assert(false, "xy")

    #test
    ex_many0_allows_empty() -> void
        val p = many0_int(digit_unit())
        run_all_ints(p, "") match
            Got(_, codes) -> expect(len(codes), 0, "zero digits")
            Miss -> assert(false, "many0 empty")

    #test
    ex_many1_needs_at_least_one() -> void
        val p = many1_int(digit_unit())
        run_all_ints(p, "") match
            Got(_, _) -> assert(false, "empty fail")
            Miss -> assert(true, "ok")
        run_all_ints(p, "2048") match
            Got(_, codes) ->
                expect(len(codes), 4, "four bytes")
                expect(codes[0], int('2'), "first")
            Miss -> assert(false, "2048")

    #test
    integration_natural_answers() -> void
        run_all_int(natural(), "99") match
            Got(_, n) -> expect(n, 99, "two-digit")
            Miss -> assert(false, "99")

    #test
    integration_natural_rejects_trailing_garbage() -> void
        run_all_int(natural(), "42!") match
            Got(_, _) -> assert(false, "trailing junk")
            Miss -> assert(true, "ok")

    #test
    ex_natural_single_digit() -> void
        run_all_int(natural(), "7") match
            Got(_, n) -> expect(n, 7, "digit")
            Miss -> assert(false, "7")

    #test
    ex_natural_leading_zeros_count() -> void
        run_all_int(natural(), "007") match
            Got(_, n) -> expect(n, 7, "leading zeros")
            Miss -> assert(false, "007")

    #test
    ex_natural_large_constant() -> void
        run_all_int(natural(), "2048") match
            Got(_, n) -> expect(n, 2048, "2048")
            Miss -> assert(false, "2048")

    #test
    ex_natural_rejects_empty() -> void
        run_all_int(natural(), "") match
            Got(_, _) -> assert(false, "empty")
            Miss -> assert(true, "ok")
