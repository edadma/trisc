std.parsyl.tests — `#test` examples
===================================

Library API is split across `types.lsysl`, `combinators.lsysl`, and `natural.lsysl`
(same `module std.parsyl`). This file holds `#test` entry points and a small
Pratt-style integer expression parser (`+ - * /`, parentheses, `natural()`, spaces)
exercised via `expect`. Run `sysl test std/parsyl` to compile every `.lsysl` in the
directory as one package.


    module std.parsyl

    // ---- Integer expression parser (+ - * / parentheses, natural numbers, optional spaces) ----

    private expr_skip_ws(s: string, i: int) -> int
        var j = i
        while j < len(s)
            if s[j] == int(' ')
                j = j + 1
            else
                break
        j

    private expr_prec(ch: int) -> int
        if ch == int('+') then 1
        else
            if ch == int('-') then 1
            else
                if ch == int('*') then 2
                else
                    if ch == int('/') then 2
                    else -1

    private expr_apply_op(acc: int, op: int, rhs: int) -> int
        if op == int('+') then acc + rhs
        else
            if op == int('-') then acc - rhs
            else
                if op == int('*') then acc * rhs
                else
                    if op == int('/') then acc / rhs
                    else acc

    private expr_parse_loop(s: string, pos: int, acc: int, min_prec: int) -> ParseMaybe[int]
        if pos >= len(s) then Got(pos, acc)
        else
            val pr = expr_prec(int(s[pos]))
            if pr < min_prec then Got(pos, acc)
            else
                val op = int(s[pos])
                expr_parse_prec(s, pos + 1, pr + 1) match
                    Miss -> Miss
                    Got(p1, rhs) ->
                        val acc2 = expr_apply_op(acc, op, rhs)
                        expr_parse_loop(s, expr_skip_ws(s, p1), acc2, min_prec)

    private expr_parse_prec(s: string, i: int, min_prec: int) -> ParseMaybe[int]
        expr_atom(s, i) match
            Miss -> Miss
            Got(p0, lhs) -> expr_parse_loop(s, expr_skip_ws(s, p0), lhs, min_prec)

    private expr_atom(s: string, i: int) -> ParseMaybe[int]
        val j0 = expr_skip_ws(s, i)
        if j0 >= len(s) then Miss
        else if s[j0] == int('(') then
            expr_parse_prec(s, j0 + 1, 0) match
                Miss -> Miss
                Got(p, v) ->
                    val k = expr_skip_ws(s, p)
                    if k < len(s)
                        if s[k] == int(')')
                            Got(k + 1, v)
                        else
                            Miss
                    else
                        Miss
        else
            natural()(s, j0)

    expression_parser() -> (string, int) -> ParseMaybe[int] =
        (s: string, i: int) -> expr_parse_prec(s, i, 0)

    #test
    integration_expression_parser() -> unit
        val p = expression_parser()
        run_all_int(p, "1+2") match
            Got(_, v) -> expect(v, 3, "1+2")
            Miss -> assert(false, "1+2")
        run_all_int(p, "2*3+4") match
            Got(_, v) -> expect(v, 10, "2*3+4 left assoc")
            Miss -> assert(false, "2*3+4")
        run_all_int(p, "(1+2)*3") match
            Got(_, v) -> expect(v, 9, "parens")
            Miss -> assert(false, "(1+2)*3")
        run_all_int(p, "10-3-2") match
            Got(_, v) -> expect(v, 5, "10-3-2")
            Miss -> assert(false, "10-3-2")
        run_all_int(p, "(1+3)/2") match
            Got(_, v) -> expect(v, 2, "division")
            Miss -> assert(false, "(1+3)/2")
        run_all_int(p, " 42 ") match
            Got(_, v) -> expect(v, 42, "spaces")
            Miss -> assert(false, "spaces")
        run_all_int(p, "2+3*4") match
            Got(_, v) -> expect(v, 14, "precedence")
            Miss -> assert(false, "2+3*4")

    #test
    smoke_lit_then_run_all() -> unit
        val p = lit(int('z'))
        run_all_int(p, "z") match
            Got(_, ch) -> expect(ch, int('z'), "literal round-trip")
            Miss -> assert(false, "lit(z)")

    #test
    ex_lit_a_matches() -> unit
        val p = lit(int('a'))
        run_all_int(p, "a") match
            Got(_, _) -> assert(true, "ok")
            Miss -> assert(false, "expected a")

    #test
    ex_lit_a_rejects_b() -> unit
        val p = lit(int('a'))
        run_all_int(p, "b") match
            Got(_, _) -> assert(false, "no match")
            Miss -> assert(true, "ok")

    #test
    ex_alt_ab_accepts_either_byte() -> unit
        val p = alt(lit(int('a')), lit(int('b')))
        run_all_int(p, "a") match
            Got(_, _) -> assert(true, "a")
            Miss -> assert(false, "a")
        run_all_int(p, "b") match
            Got(_, _) -> assert(true, "b")
            Miss -> assert(false, "b")

    #test
    ex_seq_ab_then_map() -> unit
        val raw = seq(lit(int('a')), lit(int('b')))
        val p = map(raw, (pair: (int, int)) -> pair.0 + pair.1)
        run_all_int(p, "ab") match
            Got(_, sum) -> expect(sum, int('a') + int('b'), "sum")
            Miss -> assert(false, "ab")

    #test
    integration_xy_checksum() -> unit
        val p = map(
            seq(lit(int('x')), lit(int('y'))),
            (pair: (int, int)) -> pair.0 * 1000 + pair.1)
        run_all_int(p, "xy") match
            Got(_, v) -> expect(v, int('x') * 1000 + int('y'), "checksum")
            Miss -> assert(false, "xy")

    #test
    ex_many0_allows_empty() -> unit
        val p = many0_int(digit_unit())
        run_all_ints(p, "") match
            Got(_, codes) -> expect(len(codes), 0, "zero digits")
            Miss -> assert(false, "many0 empty")

    #test
    ex_many1_needs_at_least_one() -> unit
        val p = many1_int(digit_unit())
        run_all_ints(p, "") match
            Got(_, _) -> assert(false, "empty fail")
            Miss -> assert(true, "ok")
        run_all_ints(p, "2048") match
            Got(_, codes) ->
                expect(len(codes), 4, "four bytes")
                expect(codes[0], int('2'), "first")
            Miss -> assert(false, "2048")

    #test
    integration_natural_answers() -> unit
        run_all_int(natural(), "99") match
            Got(_, n) -> expect(n, 99, "two-digit")
            Miss -> assert(false, "99")

    #test
    integration_natural_rejects_trailing_garbage() -> unit
        run_all_int(natural(), "42!") match
            Got(_, _) -> assert(false, "trailing junk")
            Miss -> assert(true, "ok")

    #test
    ex_natural_single_digit() -> unit
        run_all_int(natural(), "7") match
            Got(_, n) -> expect(n, 7, "digit")
            Miss -> assert(false, "7")

    #test
    ex_natural_leading_zeros_count() -> unit
        run_all_int(natural(), "007") match
            Got(_, n) -> expect(n, 7, "leading zeros")
            Miss -> assert(false, "007")

    #test
    ex_natural_large_constant() -> unit
        run_all_int(natural(), "2048") match
            Got(_, n) -> expect(n, 2048, "2048")
            Miss -> assert(false, "2048")

    #test
    ex_natural_rejects_empty() -> unit
        run_all_int(natural(), "") match
            Got(_, _) -> assert(false, "empty")
            Miss -> assert(true, "ok")
