std.heap — Generic binary min-heap
===================================

The `std.heap` module provides `MinHeap[T]`, a generic binary
min-heap backed by a growable `[]T` slice. The comparator
function is stored in the struct, so callers just push/pop
without passing it each time.

The heap maintains the invariant: for every node at index `i`,
`less(data[i], data[child])` is true for both children. The
root (`data[0]`) is always the minimum element.

**Complexity:**
- `push`: O(log n) amortized
- `pop`: O(log n)
- `peek`: O(1)
- `len`, `empty`: O(1)
- `remove_at`: O(log n)

Dependencies: none (only needs `append` built-in for slice growth).


    module std.heap


MinHeap
-------

`MinHeap[T]` holds a slice of elements and a comparator.
Construct one with `new_min_heap` or `new_min_heap_cap`.

    struct MinHeap[T]
        data: []T
        less: (T, T) -> bool


new_min_heap
------------

`new_min_heap[T](less)` returns an empty heap with default
initial capacity (16 elements).

`new_min_heap_cap[T](cap, less)` returns an empty heap
pre-allocated for `cap` elements, avoiding early reallocations.

    new_min_heap[T](less: (T, T) -> bool) -> MinHeap[T]
        val arr = new [16]T
        MinHeap[T](arr[:0], less)

    new_min_heap_cap[T](cap: int, less: (T, T) -> bool) -> MinHeap[T]
        val arr = new [cap]T
        MinHeap[T](arr[:0], less)


len / empty
-----------

    heap_len[T](h: *MinHeap[T]) -> int = len(h.data)

    heap_empty[T](h: *MinHeap[T]) -> bool = len(h.data) == 0


peek
----

`heap_peek` returns the minimum element without removing it.
Panics if the heap is empty.

    heap_peek[T](h: *MinHeap[T]) -> T
        assert(len(h.data) > 0, "peek on empty heap")
        h.data[0]


push
----

`heap_push` appends an element and sifts it up to restore
the heap invariant.

    heap_push[T](h: *MinHeap[T], v: T)
        h.data = append(h.data, v)
        _sift_up(h, len(h.data) - 1)


pop
---

`heap_pop` removes and returns the minimum element. The last
element is moved to the root and sifted down. Panics if empty.

    heap_pop[T](h: *MinHeap[T]) -> T
        val n = len(h.data)
        assert(n > 0, "pop on empty heap")
        val min = h.data[0]
        val last = n - 1
        h.data[0] = h.data[last]
        h.data = h.data[:last]
        if last > 0
            _sift_down(h, 0)
        min


remove_at
---------

`heap_remove_at` removes the element at the given index.
The last element replaces it, then sifts up or down as needed.

    heap_remove_at[T](h: *MinHeap[T], index: int)
        val n = len(h.data)
        assert(index >= 0 && index < n, "remove_at: index out of bounds")
        val last = n - 1
        if index == last
            h.data = h.data[:last]
            return
        h.data[index] = h.data[last]
        h.data = h.data[:last]
        // The replacement might need to go up or down
        _sift_up(h, index)
        _sift_down(h, index)


Internal helpers
----------------

`_sift_up` moves element at `i` upward until the heap
invariant is restored.

    private _sift_up[T](h: *MinHeap[T], i: int)
        var pos = i
        while pos > 0
            val parent = (pos - 1) / 2
            if h.less(h.data[pos], h.data[parent])
                val tmp = h.data[pos]
                h.data[pos] = h.data[parent]
                h.data[parent] = tmp
                pos = parent
            else
                return

`_sift_down` moves element at `i` downward until the heap
invariant is restored.

    private _sift_down[T](h: *MinHeap[T], i: int)
        val n = len(h.data)
        var pos = i
        while true
            val left = 2 * pos + 1
            val right = 2 * pos + 2
            var smallest = pos
            if left < n && h.less(h.data[left], h.data[smallest])
                smallest = left
            if right < n && h.less(h.data[right], h.data[smallest])
                smallest = right
            if smallest == pos
                return
            val tmp = h.data[pos]
            h.data[pos] = h.data[smallest]
            h.data[smallest] = tmp
            pos = smallest


Tests
-----

    #test
    test_push_pop_single() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 42)
        assert(heap_len(&h) == 1, "len after push")
        assert(heap_peek(&h) == 42, "peek")
        val v = heap_pop(&h)
        assert(v == 42, "pop value")
        assert(heap_empty(&h), "empty after pop")

    #test
    test_push_pop_ordered() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 1)
        heap_push(&h, 2)
        heap_push(&h, 3)
        assert(heap_pop(&h) == 1, "first")
        assert(heap_pop(&h) == 2, "second")
        assert(heap_pop(&h) == 3, "third")

    #test
    test_push_pop_reverse() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 3)
        heap_push(&h, 2)
        heap_push(&h, 1)
        assert(heap_pop(&h) == 1, "min first")
        assert(heap_pop(&h) == 2, "second")
        assert(heap_pop(&h) == 3, "third")

    #test
    test_push_pop_interleaved() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 5)
        heap_push(&h, 3)
        assert(heap_pop(&h) == 3, "pop 3")
        heap_push(&h, 1)
        heap_push(&h, 4)
        assert(heap_pop(&h) == 1, "pop 1")
        assert(heap_pop(&h) == 4, "pop 4")
        assert(heap_pop(&h) == 5, "pop 5")

    #test
    test_duplicates() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 3)
        heap_push(&h, 1)
        heap_push(&h, 3)
        heap_push(&h, 1)
        assert(heap_pop(&h) == 1, "first 1")
        assert(heap_pop(&h) == 1, "second 1")
        assert(heap_pop(&h) == 3, "first 3")
        assert(heap_pop(&h) == 3, "second 3")

    #test
    test_remove_at_middle() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 1)
        heap_push(&h, 3)
        heap_push(&h, 2)
        heap_push(&h, 5)
        heap_push(&h, 4)
        // Remove element at index 1 (could be 3 or 2 depending on heap shape)
        // After removal, all remaining elements should still come out sorted
        heap_remove_at(&h, 1)
        assert(heap_len(&h) == 4, "len after remove")
        val a = heap_pop(&h)
        val b = heap_pop(&h)
        val c = heap_pop(&h)
        val d = heap_pop(&h)
        assert(a <= b && b <= c && c <= d, "sorted after remove")

    #test
    test_remove_at_root() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 1)
        heap_push(&h, 3)
        heap_push(&h, 2)
        heap_remove_at(&h, 0)
        assert(heap_pop(&h) == 2, "new min after root removal")
        assert(heap_pop(&h) == 3, "last")

    #test
    test_remove_at_last() -> unit
        var h = new_min_heap(int_less)
        heap_push(&h, 1)
        heap_push(&h, 2)
        heap_push(&h, 3)
        heap_remove_at(&h, 2)
        assert(heap_len(&h) == 2, "len")
        assert(heap_pop(&h) == 1, "first")
        assert(heap_pop(&h) == 2, "second")

    #test
    test_many_elements() -> unit
        var h = new_min_heap(int_less)
        // Push 20 elements in scrambled order
        heap_push(&h, 15)
        heap_push(&h, 3)
        heap_push(&h, 18)
        heap_push(&h, 7)
        heap_push(&h, 1)
        heap_push(&h, 12)
        heap_push(&h, 20)
        heap_push(&h, 9)
        heap_push(&h, 5)
        heap_push(&h, 14)
        heap_push(&h, 2)
        heap_push(&h, 11)
        heap_push(&h, 19)
        heap_push(&h, 6)
        heap_push(&h, 4)
        heap_push(&h, 17)
        heap_push(&h, 8)
        heap_push(&h, 13)
        heap_push(&h, 16)
        heap_push(&h, 10)
        assert(heap_len(&h) == 20, "len 20")
        // Pop all — must come out in ascending order
        var prev = heap_pop(&h)
        for var i = 1; i < 20; i++
            val cur = heap_pop(&h)
            assert(cur >= prev, "ascending order")
            prev = cur
        assert(heap_empty(&h), "empty at end")

    #test(should_panic: "pop on empty heap")
    test_pop_empty_panics() -> unit
        var h = new_min_heap(int_less)
        val _ = heap_pop(&h)

    #test(should_panic: "peek on empty heap")
    test_peek_empty_panics() -> unit
        var h = new_min_heap(int_less)
        val _ = heap_peek(&h)

Test helper — simple integer comparator.

    private int_less(a: int, b: int) -> bool = a < b
