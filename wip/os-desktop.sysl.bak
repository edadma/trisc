// OS-based windowed desktop demo
// Uses the full OS stack: kernel, IPC, display server, mouse driver
// The display server handles mouse input and window management via IPC
// Client app creates windows and draws content through the display server API

import oskit.*

FB_WIDTH  = 1440
FB_HEIGHT = 900

// The display server thread — boots up the graphical subsystem
server_main()
    putc('S')  // server starting
    display_server(FB_WIDTH, FB_HEIGHT)

// Helper: convert int array to i8 array for display server API
fill(surf: int, x: int, y: int, w: int, h: int, r: int, g: int, b: int, a: int)
    ds_set_color(r, g, b, a)
    ds_fill_rect(surf, x, y, w, h)

text(surf: int, x: int, y: int, sz: int, style: int, s: *i8, len: int, r: int, g: int, b: int)
    ds_set_color(r, g, b, 255)
    ds_draw_text(surf, x, y, sz, style, s, len)

// String data as i8 arrays for the display server API
t_mon: [14]i8 = [83, 121, 115, 116, 101, 109, 32, 77, 111, 110, 105, 116, 111, 114]
t_editor: [9]i8 = [99, 111, 100, 101, 46, 115, 121, 115, 108]
t_terminal: [8]i8 = [84, 101, 114, 109, 105, 110, 97, 108]
