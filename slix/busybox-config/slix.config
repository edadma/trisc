# SLIX busybox config overlay
#
# This file is *appended* to a baseline .config produced by `make
# allnoconfig` in build-busybox.sh. Each `CONFIG_X=y` line turns on
# one applet or feature; `# CONFIG_X is not set` flips a y-by-default
# to n.
#
# After append, build-busybox.sh runs `yes "" | make oldconfig` to
# accept the default for any kconfig dependency we didn't pin
# explicitly. For `choice` blocks (mutually-exclusive options) you
# MUST set exactly one CONFIG_X=y — multiple `is not set` lines on the
# same choice will trigger an interactive prompt that breaks the build.
#
# Start tiny: just enough to prove the toolchain produces a working
# ELF and that PT_INTERP + ld-musl + libc.so + __libc_start_main all
# land. Once `busybox echo hello` runs, the applet set grows
# incrementally — every new applet that surfaces a missing musl or
# kernel syscall is its own debug round.

# === core: applet dispatcher + minimal runtime ============================
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y

# === v0 applets ===========================================================
CONFIG_ECHO=y
CONFIG_TRUE=y
CONFIG_FALSE=y

# === v1 applets — file I/O ================================================
# cat: open()/read()/write(). First applet to exercise the read side of the
# musl→shim→vfs pipeline. Surfaces any gaps in openat/read.
CONFIG_CAT=y

# ls: opendir()/readdir()/getdents64 + lstat. First applet to exercise
# directory enumeration. Surfaces any gaps in getdents64 / stat-family
# of the musl→shim→vfs pipeline.
CONFIG_LS=y

# === v2 applets — read-side text utilities ================================
# All operate on existing stdio/read paths that cat validated. Low risk
# batch — surface any missing libc helpers (getline, fgets variants,
# regex.h for grep) rather than new syscalls.
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_GREP=y

# === v3 applets — write-side filesystem ====================================
# mkdir/rmdir/rm exercise VFS_CMD_{MKDIR,RMDIR,UNLINK}_C, all of which
# already exist and are tested by test_mkdir / test_unlink / test_rmdir.
# cp adds nothing new (open + read + write + close). mv uses rename(2)
# which lands as SYS_renameat / renameat2 — already handled in shim.
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y

# === v4 applet — minimal sh (ash) for pipeline demo =======================
# Minimal ash for the master-roadmap acceptance bar
#   `cat /etc/passwd | grep root | wc -l` -> "1"
# Needs fork(), exec(), pipe(), waitpid() — all shipped from the
# Phase-1 trilogy and exercised by test_pipe. Job control / aliases /
# bash-compat / random off to keep the binary small and reduce
# signal-handling surface.
CONFIG_ASH=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y

# === installation behavior =================================================
# Choice block — must pick exactly one. Symlinks match what the TFS
# ramdisk packer will produce when installing applet aliases. (The
# choice value affects `make install` only; we don't run that step.)
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_INSTALL_NO_USR=y

# === toolchain knobs ======================================================
# We supply CFLAGS / LDFLAGS via the build-busybox.sh env. Leave
# kconfig's CONFIG_CROSS_COMPILER_PREFIX empty because we use a
# wrapper script (cc-wrapper.sh) instead of the gcc-prefix convention.
CONFIG_CROSS_COMPILER_PREFIX=""
CONFIG_SYSROOT=""
CONFIG_EXTRA_CFLAGS=""
CONFIG_EXTRA_LDFLAGS=""
CONFIG_EXTRA_LDLIBS=""

# Static linking off — we want PIE/dynamic against ld-musl.
# CONFIG_STATIC is not set

# CONFIG_PIE=y puts -fpie in CFLAGS (every compile) and -pie in
# CFLAGS_busybox (final link only — Makefile.flags lines 132-135).
# This is the *only* clean way busybox 1.37 lets us add -pie to
# the final link without also leaking it into the intermediate
# `ld -r` calls that merge built-in.o files (which would error
# with "-r and -pie may not be used together").
CONFIG_PIE=y
