Generic type aliases — same-file
================================

A generic type alias `type Pair[A, B] = ...` is a pure
type-level abbreviation: it has no codegen of its own; each
use site substitutes the arguments and the body is treated
as if written inline.

This file pins the same-file form. Cross-file generic
aliases live in `generic_alias_cross_file.lsysl`.

    module sysl.tests.lang_features

Alias to a function type — fully instantiated at use site
---------------------------------------------------------

A `(T) -> T` alias names a closure shape. Functions taking
this alias at a concrete instantiation accept any closure of
the right shape — there is no nominal newtype, so no cast is
required.

    type GabUnary[T] = (T) -> T

    apply_unary_int(f: GabUnary[int], x: int) -> int = f(x)

    #test
    test_alias_function_type() -> unit
        val r = apply_unary_int(x -> x + 1, 41)
        assert(r == 42, s"42 should be 42, got $r")

Two-parameter alias
-------------------

    type GabBin[A, B] = (A, A) -> B

    use_bin(f: GabBin[int, int], a: int, b: int) -> int = f(a, b)

    #test
    test_alias_two_params() -> unit
        val r = use_bin(_ + _, 10, 20)
        assert(r == 30, s"10+20 should be 30, got $r")

Generic alias as a struct field type
-------------------------------------

Previously failed with "'GabUnary' is not a generic type"
because struct fields are resolved in pass 0.5 (before the
main declaration pass registers `genericTypeAliases`). The
pre-pass now seeds `genericTypeAliases` so field-type
resolution sees the alias.

    struct GabPipeline
        f: GabUnary[int]
        bias: int

    apply_pipeline(p: GabPipeline, x: int) -> int = p.f(x) + p.bias

    #test
    test_alias_as_field_basic() -> unit
        val p = GabPipeline(x -> x * 2, 7)
        val r = apply_pipeline(p, 10)
        assert(r == 27, s"2*10+7 should be 27, got $r")

    #test
    test_alias_as_field_swap_closure() -> unit
        val p = GabPipeline(x -> x + 100, 1)
        val r = apply_pipeline(p, 4)
        assert(r == 105, s"4+100+1 should be 105, got $r")

### Two-parameter alias in a struct field

    struct GabComputer
        op: GabBin[int, int]
        seed: int

    run_computer(c: GabComputer, a: int, b: int) -> int = c.op(a, b) + c.seed

    #test
    test_alias_two_param_field() -> unit
        val c = GabComputer(_ + _, 1000)
        val r = run_computer(c, 30, 70)
        assert(r == 1100, s"30+70+1000 should be 1100, got $r")

    #test
    test_alias_two_param_field_mul() -> unit
        val c = GabComputer(_ * _, 0)
        assert(run_computer(c, 6, 7) == 42, "6*7+0")
