Interface Box Lifetime
======================

When a concrete value gets boxed into an interface, the boxed
iface holds a `data_ptr` that points at the original concrete
value's storage — the box is by reference, not by copy. This
makes mutating methods through the iface propagate back to the
caller (pinned by `iface_mutating_self.lsysl`), but it also
means the box's `data_ptr` is only valid as long as the source
value's storage is.

This file pins:

- Passing an iface to a function and back again.
- Iface stored in an iface-typed local; repeated dispatch.
- Calling iface method many times in sequence.
- Mutating through iface, reading back through the same iface.

Known gaps (not pinned here):

- SVM struct-field string aliasing — see the feedback memo.

File-local prefix `Sibl` (Sysl Iface Box Lifetime).

    module sysl.tests.lang_features

Passing iface through a function
---------------------------------

`Tally` is the value-struct source; `IntHolder` is the iface.

    interface IntHolder
        value() -> int

    struct Tally
        n: int

    Tally.value() -> int = self.n

    relay(h: IntHolder) -> int = h.value()

### Source survives a single iface call

    #test
    test_sibl_pass_and_call() -> unit
        var c = Tally(42)
        val v = relay(c)
        assert(v == 42, s"got $v")

### Source survives nested iface calls

    nested_relay(h: IntHolder) -> int = relay(h)

    #test
    test_sibl_pass_through_two_frames() -> unit
        var c = Tally(99)
        val v = nested_relay(c)
        assert(v == 99, s"got $v")

### Three levels of forwarding

    three_relay(h: IntHolder) -> int = nested_relay(h)

    #test
    test_sibl_pass_through_three_frames() -> unit
        var c = Tally(7)
        val v = three_relay(c)
        assert(v == 7, s"got $v")

Iface stored in a local
------------------------

### Many calls through a single iface local

    #test
    test_sibl_many_calls_via_local() -> unit
        var c = Tally(11)
        val h: IntHolder = c
        val a = h.value()
        val b = h.value()
        val d = h.value()
        val e = h.value()
        assert(a == 11, "1st call")
        assert(b == 11, "2nd call")
        assert(d == 11, "3rd call")
        assert(e == 11, "4th call")

### Two iface locals from the same source

    #test
    test_sibl_two_locals_same_source() -> unit
        var c = Tally(55)
        val h1: IntHolder = c
        val h2: IntHolder = c
        assert(h1.value() == h2.value(), "consistent")
        assert(h1.value() == 55, "value")

### Iface in a loop body — N invocations stable

    #test
    test_sibl_iface_in_loop_body() -> unit
        var c = Tally(3)
        val h: IntHolder = c
        var sum = 0
        var i = 0
        while i < 4
            sum = sum + h.value()
            i = i + 1
        assert(sum == 12, s"got $sum")

Mutating through iface, reading back through iface
---------------------------------------------------

    interface MutTally
        tick() -> unit
        get() -> int

    Tally.tick() -> unit
        self.n = self.n + 1

    Tally.get() -> int = self.n

### Five ticks via iface, then read-back through iface

    #test
    test_sibl_five_ticks_read_back() -> unit
        var c = Tally(0)
        val m: MutTally = c
        m.tick()
        m.tick()
        m.tick()
        m.tick()
        m.tick()
        assert(m.get() == 5, s"got ${m.get()}")
        assert(c.n == 5, s"caller's c.n; got ${c.n}")

### Interleaved tick + get through iface

    #test
    test_sibl_interleaved_tick_get() -> unit
        var c = Tally(0)
        val m: MutTally = c
        m.tick()
        val a = m.get()
        m.tick()
        m.tick()
        val b = m.get()
        m.tick()
        val d = m.get()
        assert(a == 1, "after 1st tick")
        assert(b == 3, "after 3rd tick")
        assert(d == 4, "after 4th tick")


Iface as struct field type
---------------------------

A `struct S { f: Iface }` embeds a boxed iface inline. Was a 🟡
gap (analyzer rejected interface names in struct-field-type
position). Fixed by pre-seeding `interfaceTypes` in pass 0.5 and
re-running `resolveStructsAndEnums` after the main pass picks up
the real method list, plus auto-boxing concrete-to-iface in the
struct-construct arg coercer (parallel to the function-call-arg
auto-box).

    struct Wrapper
        inner: IntHolder
        bias: int

    Wrapper.total() -> int = self.inner.value() + self.bias

### Basic field-iface dispatch

    #test
    test_sibl_iface_field_in_struct() -> unit
        val c = Tally(40)
        val w = Wrapper(c, 2)
        assert(w.total() == 42, s"40 + 2 = 42, got ${w.total()}")
        assert(w.inner.value() == 40, s"direct field dispatch: got ${w.inner.value()}")
        assert(w.bias == 2, "bias preserved")

### Two wrappers, same source struct

    #test
    test_sibl_two_wrappers_same_source() -> unit
        val src = Tally(10)
        val w1 = Wrapper(src, 1)
        val w2 = Wrapper(src, 100)
        assert(w1.total() == 11, s"w1 total: ${w1.total()}")
        assert(w2.total() == 110, s"w2 total: ${w2.total()}")
        // Independent bias values
        assert(w1.bias == 1, "w1 bias")
        assert(w2.bias == 100, "w2 bias")


Returning iface from a fn with local source
--------------------------------------------

When an iface is constructed from a local value and returned from
its constructing function, the iface's `data_ptr` would otherwise
point at a dead stack frame. The analyzer marks return-position
iface boxes as `owns=true`; LLVM-derived codegens heap-copy the
source struct so the data buffer outlives the source slot. The
interpreter naturally returns by value (the iface holds the
struct's value, not a pointer to it); SVM/TRISC's bump-allocated
memory stack persists across returns by construction. Also
required an analyzer fix: `ReturnStmtAST` was not auto-boxing for
iface return types (the existing fn-arg / var-decl / struct-field
auto-box paths didn't apply to return values).

    factory_value() -> IntHolder
        var c = Tally(42)
        return c

    factory_with_branches(x: int) -> IntHolder
        if x > 0
            var pos = Tally(1)
            return pos
        else
            var neg = Tally(-1)
            return neg

### Basic: return iface boxed from local

    #test
    test_sibl_return_iface_local() -> unit
        val h = factory_value()
        assert(h.value() == 42, s"got ${h.value()}")

### Two distinct factory calls hand back independent data

    #test
    test_sibl_two_factory_calls() -> unit
        val a = factory_value()
        val b = factory_value()
        assert(a.value() == 42, s"a; got ${a.value()}")
        assert(b.value() == 42, s"b; got ${b.value()}")

### Branched return — each branch's local boxed and returned

    #test
    test_sibl_branched_return() -> unit
        val a = factory_with_branches(5)
        val b = factory_with_branches(-5)
        assert(a.value() == 1, s"pos; got ${a.value()}")
        assert(b.value() == -1, s"neg; got ${b.value()}")

### Factory result used through a forwarding function

    drain_value(h: IntHolder) -> int = h.value()

    #test
    test_sibl_factory_through_fn() -> unit
        val h = factory_value()
        assert(drain_value(h) == 42, "factory → relay")
