Loop variable is a copy
-----------------------

Per value-semantics, the loop variable `x` is a fresh copy
each iteration. Mutating it must not affect the source.

    #test
    test_loop_var_is_copy() -> unit
        var a = [1, 2, 3]
        for x in a
            x = 999    // local mutation; source untouched
        // Source unchanged
        assert(a[0] == 1 && a[1] == 2 && a[2] == 3,
            s"a should be [1,2,3] after loop, got [${a[0]},${a[1]},${a[2]}]")

Empty slice iterates zero times
-------------------------------

    #test
    test_iter_empty() -> unit
        var a = [10, 20, 30]
        var hits = 0
        for x in a[1:1]    // empty
            hits = hits + 1
        assert(hits == 0, s"empty slice should iterate 0 times, got $hits")
