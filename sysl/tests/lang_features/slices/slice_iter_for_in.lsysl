Iteration over slices and arrays
================================

`for x in s` iterates the elements of a slice or array. Each
iteration binds `x` to a fresh copy of the element (value
semantics — mutating `x` doesn't affect the source).

    module sysl.tests.lang_features

Iterate a literal array
-----------------------

    #test
    test_iter_array_sum() -> unit
        var a = [1, 2, 3, 4, 5]
        var sum = 0
        for x in a
            sum = sum + x
        assert(sum == 15, s"sum of [1..5] should be 15, got $sum")

Iterate a sub-slice
-------------------

Now uniform on all 7 backends after the parser-level for-each
desugar (sysl@<chunk1-cluster-A>) — the source slice expression
`a[1:4]` is captured into a fresh local before the loop, so the
backend sees a stable slice descriptor instead of re-evaluating
the sub-slice on every iteration.

    #test
    test_iter_subslice_via_while() -> unit
        var a = [10, 20, 30, 40, 50]
        val s = a[1:4]
        var sum = 0
        var i = 0
        while i < len(s)
            sum = sum + s[i]
            i = i + 1
        assert(sum == 90, s"sum of a[1:4] should be 90, got $sum")

    #test
    test_iter_subslice_for_in() -> unit
        var a = [10, 20, 30, 40, 50]
        var sum = 0
        for x in a[1:4]
            sum = sum + x
        assert(sum == 90, s"sum of a[1:4] via for-in; got $sum")

    #test
    test_iter_dynamic_array() -> unit
        val d: &[]int = new [5]int
        var i = 0
        while i < len(d)
            d[i] = (i + 1) * 10
            i = i + 1
        var sum = 0
        for x in d[:]
            sum = sum + x
        assert(sum == 150, s"dynamic array via for-in; got $sum")

Loop variable is a copy
-----------------------

Per value-semantics, the loop variable `x` is a fresh copy
each iteration. Mutating it must not affect the source.

    #test
    test_loop_var_is_copy() -> unit
        var a = [1, 2, 3]
        for x in a
            x = 999    // local mutation; source untouched
        // Source unchanged
        assert(a[0] == 1 && a[1] == 2 && a[2] == 3,
            s"a should be [1,2,3] after loop, got [${a[0]},${a[1]},${a[2]}]")

Empty slice iterates zero times
-------------------------------

    #test
    test_iter_empty() -> unit
        var a = [10, 20, 30]
        var hits = 0
        for x in a[1:1]    // empty
            hits = hits + 1
        assert(hits == 0, s"empty slice should iterate 0 times, got $hits")
