Dynamic-array bounds checking
=============================

`new [n]int` yields a `&[]int` of length `n`. Out-of-bounds
indexing is a runtime trap: the program halts via the panic /
abort path. Every backend that materialises a slice descriptor
honours this. The raw `*T` pointer mode is explicitly *not*
bounds-checked — it's the unsafe escape hatch for kernel code.

The dropped 🟡 placeholder is restored — bounds checks are now
universal on every backend.

    module sysl.tests.lang_features

In-bounds reads return zero-init contents
-----------------------------------------

    #test
    test_in_bounds_read() -> unit
        val a: &[]int = new [5]int
        assert(a[0] == 0, s"a[0] should be 0, got ${a[0]}")
        assert(a[4] == 0, s"a[4] should be 0, got ${a[4]}")

In-bounds writes followed by reads
----------------------------------

    #test
    test_in_bounds_write_read() -> unit
        val a: &[]int = new [3]int
        a[0] = 1
        a[1] = 22
        a[2] = 333
        assert(a[0] == 1 && a[1] == 22 && a[2] == 333,
            s"a = [${a[0]},${a[1]},${a[2]}], expected [1,22,333]")

Index equal to length traps
----------------------------

The length-3 array has valid indices 0, 1, 2. Reading `a[3]` is
out of bounds and must trap.

    #test(should_panic)
    test_index_equal_to_len() -> unit
        val a: &[]int = new [3]int
        val _x = a[3]

Index well past the end traps
-----------------------------

    #test(should_panic)
    test_index_past_len() -> unit
        val a: &[]int = new [3]int
        val _x = a[100]

Negative index traps
--------------------

Sysl int is signed; a negative index sexts to a huge unsigned
value and falls outside `[0, len)`.

    #test(should_panic)
    test_negative_index() -> unit
        val a: &[]int = new [5]int
        val _x = a[-1]

Out-of-bounds store traps
-------------------------

    #test(should_panic)
    test_oob_store() -> unit
        val a: &[]int = new [3]int
        a[5] = 7

Fixed-array OOB read traps
--------------------------

A direct `[n]T` (stack-allocated fixed array, no slice descriptor)
also bounds-checks against the compile-time size. This was a
separate codegen path on most backends from the slice / ref-slice
case and was easy to miss in the initial round of fixes.

    #test(should_panic)
    test_fixed_array_oob_read() -> unit
        var a: [4]int
        a[0] = 10
        a[1] = 20
        a[2] = 30
        a[3] = 40
        val _x = a[4]

Fixed-array OOB store traps
---------------------------

    #test(should_panic)
    test_fixed_array_oob_store() -> unit
        var a: [4]int
        a[0] = 10
        a[10] = 99
