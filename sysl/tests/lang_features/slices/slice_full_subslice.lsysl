Sub-slicing with omitted bounds — `arr[:]`, `arr[i:]`, `arr[:j]`
================================================================

When the lower or upper bound of a slice expression is
omitted, it defaults to:

  - lower bound: `0`
  - upper bound: `len(source)`

These are the sugar forms; they should produce the same
slice as the explicit forms.

    module sysl.tests.lang_features

`arr[:]` — copy of whole length as a slice
------------------------------------------

    #test
    test_full_slice() -> unit
        var a = [1, 2, 3, 4, 5]
        val s = a[:]
        assert(len(s) == 5, s"len(a[:]) should be 5, got ${len(s)}")
        assert(s[0] == 1 && s[4] == 5,
            s"a[:][0]=${s[0]}, a[:][4]=${s[4]}, expected 1, 5")

`arr[i:]` — from index i to end
-------------------------------

    #test
    test_open_upper_bound() -> unit
        var a = [10, 20, 30, 40, 50]
        val s = a[2:]
        assert(len(s) == 3, s"len(a[2:]) should be 3, got ${len(s)}")
        assert(s[0] == 30 && s[1] == 40 && s[2] == 50,
            s"a[2:] = [${s[0]},${s[1]},${s[2]}], expected [30,40,50]")

`arr[:j]` — from start up to j
------------------------------

    #test
    test_open_lower_bound() -> unit
        var a = [10, 20, 30, 40, 50]
        val s = a[:3]
        assert(len(s) == 3, s"len(a[:3]) should be 3, got ${len(s)}")
        assert(s[0] == 10 && s[1] == 20 && s[2] == 30,
            s"a[:3] = [${s[0]},${s[1]},${s[2]}], expected [10,20,30]")

Omitted bounds mirror the explicit ones
---------------------------------------

    #test
    test_omitted_matches_explicit() -> unit
        var a = [1, 2, 3, 4, 5]
        val sFull1 = a[:]
        val sFull2 = a[0:5]
        assert(len(sFull1) == len(sFull2),
            s"len(a[:])=${len(sFull1)}, len(a[0:5])=${len(sFull2)}")
        val sTail1 = a[2:]
        val sTail2 = a[2:5]
        assert(len(sTail1) == len(sTail2),
            s"len(a[2:])=${len(sTail1)}, len(a[2:5])=${len(sTail2)}")
