Fixed-array literal — type inference, indexing, length
=======================================================

A bare `[a, b, c]` literal whose element types unify gives a
fixed-size array of length 3: `[3]int`. The array is a value
type — copied on assignment, on argument pass, on return.
Indexing reads/writes an element; `len(arr)` returns the
compile-time length.

These tests pin:

  - Type inference: `var a = [1, 2, 3]` is `[3]int` and
    behaves like one (read, write, length).
  - Element read and write through indexing.
  - `len(arr)` returns the static length.
  - Iteration via index.

Out-of-bounds traps live in `dynamic_array_bounds.lsysl` —
they're shared with dynamic-array semantics.

    module sysl.tests.lang_features

Simple element read
-------------------

    #test
    test_literal_read() -> unit
        var a = [10, 20, 30]
        assert(a[0] == 10, s"a[0] should be 10, got ${a[0]}")
        assert(a[1] == 20, s"a[1] should be 20, got ${a[1]}")
        assert(a[2] == 30, s"a[2] should be 30, got ${a[2]}")

Element write through indexing
------------------------------

    #test
    test_literal_write() -> unit
        var a = [0, 0, 0]
        a[0] = 100
        a[1] = 200
        a[2] = 300
        assert(a[0] == 100 && a[1] == 200 && a[2] == 300,
            s"after writes: a=[${a[0]},${a[1]},${a[2]}], expected [100,200,300]")

Length via len()
----------------

    #test
    test_literal_len() -> unit
        var a = [1, 2, 3, 4, 5]
        assert(len(a) == 5, s"len([5 elements]) should be 5, got ${len(a)}")
        var empty: [3]int = [0, 0, 0]
        assert(len(empty) == 3, s"len([3]int) should be 3, got ${len(empty)}")

Iteration accumulates
---------------------

    #test
    test_literal_iter_sum() -> unit
        var a = [1, 2, 3, 4, 5]
        var sum = 0
        var i = 0
        while i < len(a)
            sum = sum + a[i]
            i = i + 1
        assert(sum == 15, s"sum of [1,2,3,4,5] should be 15, got $sum")

Single-element array
--------------------

    #test
    test_single_element() -> unit
        var a = [42]
        assert(len(a) == 1, s"len([42]) should be 1, got ${len(a)}")
        assert(a[0] == 42, s"a[0] should be 42, got ${a[0]}")
        a[0] = 99
        assert(a[0] == 99, s"after write a[0] should be 99, got ${a[0]}")
