Function-pointer values and bare-name calls
===========================================

A bare top-level function name in expression position is a
first-class function value — a function pointer. It can be
stored in a `val`, passed as an argument, and called directly
with `fp(args)`. Unlike a closure literal, a top-level fn has
no captured environment; the function value is just the code
address.

This file pins the function-pointer round-trip on all seven
backends: bind, pass, call, store-and-recall.

    module sysl.tests.lang_features

    fpc_double(x: int) -> int = x * 2

    fpc_square(x: int) -> int = x * x

    fpc_apply(f: (int) -> int, x: int) -> int = f(x)

Bare-name fn in val, called directly
------------------------------------

The top-level fn is bound to a local. The local has a fn-value
type and can be called with `f(x)` exactly like the original.

    #test
    test_bind_and_call() -> unit
        val f = fpc_double
        assert(f(7) == 14, s"f(7) should be 14, got ${f(7)}")
        assert(f(0) == 0, s"f(0) should be 0, got ${f(0)}")
        assert(f(-3) == -6, s"f(-3) should be -6, got ${f(-3)}")

Fn-pointer passed to a hof
--------------------------

A bare top-level name in arg position passes the fn value to
the hof. The hof's parameter is a fn type and calling it
dispatches to the original fn.

    #test
    test_pass_to_hof() -> unit
        val r1 = fpc_apply(fpc_double, 9)
        val r2 = fpc_apply(fpc_square, 9)
        assert(r1 == 18, s"apply(double, 9) should be 18, got $r1")
        assert(r2 == 81, s"apply(square, 9) should be 81, got $r2")

Reassigning the fn-pointer var
------------------------------

A `var` of fn-pointer type can be reassigned to a different
top-level fn. Each call goes through whichever fn is currently
bound.

    #test
    test_reassign_fn_pointer() -> unit
        var f = fpc_double
        assert(f(10) == 20, "double(10) is 20")
        f = fpc_square
        assert(f(10) == 100, "square(10) is 100")
        f = fpc_double
        assert(f(5) == 10, "back to double, 10")

Two fn pointers used side by side
---------------------------------

Two distinct fn-pointer vals coexist without aliasing. Calling
one doesn't change the other.

    #test
    test_two_pointers_independent() -> unit
        val a = fpc_double
        val b = fpc_square
        // Interleave calls — neither should disturb the other
        assert(a(3) == 6, "a(3)=6")
        assert(b(3) == 9, "b(3)=9")
        assert(a(4) == 8, "a(4)=8")
        assert(b(4) == 16, "b(4)=16")

Hof returns a fn-pointer it was given
-------------------------------------

Previously the SVM backend crashed on this with "address not
found" — the 16-byte fn-pointer descriptor's func_ptr slot
held a value that didn't survive the return path. Now stable
across all 7 backends.

    fpc_id_fn(f: (int) -> int) -> (int) -> int = f

    #test
    test_hof_returns_input_fn() -> unit
        val g = fpc_id_fn(fpc_double)
        assert(g(7) == 14, s"g(7) expected 14, got ${g(7)}")
        // Call again to exercise that nothing was consumed.
        assert(g(11) == 22, s"g(11) expected 22, got ${g(11)}")

Hof selects one of two fn-pointers based on a flag
--------------------------------------------------

A multi-arg HOF that picks between fn-pointers exercises both
arg-passing of two fn-ptrs and return-position fn-ptr selection.

    fpc_pick(use_square: bool, a: (int) -> int, b: (int) -> int) -> (int) -> int
        if use_square then return a
        return b

    #test
    test_hof_pick_square() -> unit
        val g = fpc_pick(true, fpc_square, fpc_double)
        assert(g(5) == 25, s"got ${g(5)}")

    #test
    test_hof_pick_double() -> unit
        val g = fpc_pick(false, fpc_square, fpc_double)
        assert(g(5) == 10, s"got ${g(5)}")

Inline-call returned fn-pointer
-------------------------------

Apply the HOF's result without binding it to a local — pins
that the descriptor returned on the data stack can be called
directly by the next expression.

    #test
    test_inline_call() -> unit
        val r = fpc_id_fn(fpc_double)(8)
        assert(r == 16, s"inline call expected 16, got $r")

