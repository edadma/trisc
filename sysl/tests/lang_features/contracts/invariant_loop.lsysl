Loop `invariant` Clauses — Happy-Path Coverage
===============================================

Per reference (see `// invariant <bool>` in the loop section):

```sysl
for i = 0; i < n; i++
    invariant i >= 0
    invariant i <= n, "i in range"
    body()
```

- `invariant <bool> [, "msg"]` must appear in the leading header of
  a loop body. The analyzer hoists it to the loop's cut point and
  runs it at the top of every iteration, regardless of source order.
- Multiple invariants are allowed; all are checked each iteration.
- A false invariant traps with `loop invariant check failed[: msg]`.
- An invariant placed outside the loop header (after a non-invariant
  statement, nested inside `if`/`match`, or outside any loop) is a
  static error.
- `loop_entry(expr)` may only appear inside a loop invariant; it
  snapshots `expr` once when control first reaches the loop.

This file pins the **happy-path** behaviour of `invariant` across all
seven backends — every test runs a loop with invariants that *hold*
on every iteration and asserts the loop's externally visible side
effect is correct. Failing-invariant (trap) tests are deferred to a
future uniform runtime-trap harness.

File-local prefix `Ivl` (InVariant-Loop).

    module sysl.tests.lang_features


`while` loop with a single invariant
-------------------------------------

### Counter monotone non-negative

    #test
    test_ivl_while_single() -> unit
        var i: int = 0
        while i < 5
            invariant i >= 0
            i = i + 1
        assert(i == 5, s"got $i")


`while` loop with multiple invariants
--------------------------------------

### Two invariants, both hold each step

    #test
    test_ivl_while_multiple() -> unit
        var i: int = 0
        var sum: int = 0
        while i < 4
            invariant i >= 0
            invariant sum >= 0
            sum = sum + i
            i = i + 1
        assert(i == 4, s"i=$i")
        assert(sum == 6, s"sum=0+1+2+3=6, got $sum")

### Three invariants with a message clause

The invariant `sum == i` holds at the top of every iteration because
the body increments both in lock-step.

    #test
    test_ivl_three_with_msg() -> unit
        var i: int = 0
        var sum: int = 0
        while i < 3
            invariant i >= 0
            invariant sum >= 0
            invariant sum == i, "sum tracks i in lock-step"
            sum = sum + 1
            i = i + 1
        assert(i == 3, s"i=$i")
        assert(sum == 3, s"sum increments with i, got $sum")


C-style `for` loop with invariant
----------------------------------

    #test
    test_ivl_for_basic() -> unit
        var total: int = 0
        for i = 0; i < 5; i++
            invariant i >= 0
            invariant total >= 0
            total = total + i
        assert(total == 10, s"0+1+2+3+4=10, got $total")


Invariant captures `loop_entry(expr)`
--------------------------------------

### `i >= loop_entry(i)` — monotone w.r.t. initial value

    #test
    test_ivl_loop_entry_basic() -> unit
        var i: int = 7
        var iters: int = 0
        while i < 12
            invariant i >= loop_entry(i)
            i = i + 1
            iters = iters + 1
        assert(i == 12, s"i=$i")
        assert(iters == 5, s"iters=$iters")

### `loop_entry(i) == 0` — i started at 0 (constant snapshot)

    #test
    test_ivl_loop_entry_constant() -> unit
        var x: int = 0
        var i: int = 0
        for i = 0; i < 4; i++
            invariant loop_entry(i) == 0
            invariant x >= loop_entry(x), "x monotone w.r.t. entry"
            x = x + i
        assert(x == 6, s"x=0+1+2+3=6, got $x")


Loop invariant in a nested loop
--------------------------------

### Outer + inner both have their own loop_entry

    #test
    test_ivl_nested() -> unit
        var products: int = 0
        for i = 1; i < 4; i++
            invariant i >= 1
            for j = 1; j < 4; j++
                invariant j >= 1
                invariant loop_entry(j) == 1
                products = products + i * j
        // sum_{i=1..3} sum_{j=1..3} i*j = (1+2+3)^2 = 36
        assert(products == 36, s"got $products")


Invariant uses arithmetic on the loop var
------------------------------------------

### `2 * i` always within bounds

    #test
    test_ivl_arith() -> unit
        var i: int = 0
        var sum: int = 0
        while i < 10
            invariant 0 <= 2 * i, "non-negative double"
            invariant 2 * i <= 20, "bounded double"
            sum = sum + 2 * i
            i = i + 1
        // sum of 2*i for i=0..9 = 2*(0+1+...+9) = 90
        assert(sum == 90, s"got $sum")


Invariant interleaved with `variant`
-------------------------------------

Per reference: `invariant` and `variant` can be freely interleaved in
the leading loop header.

    #test
    test_ivl_with_variant() -> unit
        var remaining: int = 5
        var processed: int = 0
        while remaining > 0
            invariant remaining >= 0
            variant remaining
            processed = processed + 1
            remaining = remaining - 1
        assert(remaining == 0, s"remaining=$remaining")
        assert(processed == 5, s"processed=$processed")


Invariant on a `do ... while` (if supported) — using `while` instead
---------------------------------------------------------------------

Plain while-loop variant — pins the same shape from a slightly
different start state.

    #test
    test_ivl_while_decreasing() -> unit
        var n: int = 6
        var k: int = 0
        while n > 0
            invariant n >= 0
            invariant k >= 0
            k = k + 1
            n = n - 1
        assert(n == 0, s"n=$n")
        assert(k == 6, s"k=$k")


`for i in range` form with invariant
-------------------------------------

### `for i in 0..<n => body` with invariant inside

    #test
    test_ivl_for_in_range() -> unit
        var sum: int = 0
        for i in 0..<5
            invariant i >= 0
            invariant sum >= 0
            sum = sum + i
        assert(sum == 10, s"got $sum")
