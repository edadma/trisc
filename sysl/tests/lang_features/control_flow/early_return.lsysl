Early returns from various contexts
===================================

`return expr` (with value) and `return` (unit) exit the
function immediately. Test that early-return paths interact
correctly with loops, conditionals, and ARC. The latter is
especially important: an early return must release the same
locals as a late return.

    module sysl.tests.lang_features

Early return from inside a while loop
-------------------------------------

    first_geq(arr: [5]int, threshold: int) -> int
        var i = 0
        while i < len(arr)
            if arr[i] >= threshold then return arr[i]
            i = i + 1
        return -1

    #test
    test_early_return_from_loop() -> unit
        var a = [1, 3, 5, 7, 9]
        assert(first_geq(a, 4) == 5, s"first_geq(a,4) should be 5, got ${first_geq(a, 4)}")
        assert(first_geq(a, 0) == 1, s"first_geq(a,0) should be 1, got ${first_geq(a, 0)}")
        assert(first_geq(a, 10) == -1, s"first_geq(a,10) should be -1, got ${first_geq(a, 10)}")

Early return from nested blocks
-------------------------------

    deep_decision(x: int) -> int
        if x > 0 then
            if x > 100 then return 2
            return 1
        if x < 0 then return -1
        return 0

    #test
    test_deep_decision() -> unit
        assert(deep_decision(50)  == 1,  s"deep_decision(50) should be 1, got ${deep_decision(50)}")
        assert(deep_decision(200) == 2,  s"deep_decision(200) should be 2, got ${deep_decision(200)}")
        assert(deep_decision(-1)  == -1, s"deep_decision(-1) should be -1, got ${deep_decision(-1)}")
        assert(deep_decision(0)   == 0,  s"deep_decision(0) should be 0, got ${deep_decision(0)}")

Early return with ref locals — refcount cleanup on every path
-------------------------------------------------------------

If the implementation only decrements refs on the "natural" function-end
path, early-return leaks. If it over-decrements, we underflow.

    struct ErBox
        v: int

    var er_deinit_count: int = 0
    ErBox.deinit() -> unit
        er_deinit_count = er_deinit_count + 1

    early_or_late(choose_early: bool) -> int
        val r: &ErBox = new ErBox(42)
        if choose_early then return r.v
        // Else path: an extra alloc + access, then return.
        val r2: &ErBox = new ErBox(r.v + 1)
        return r2.v

    #test
    test_early_return_drops_refs() -> unit
        er_deinit_count = 0
        val v = early_or_late(true)
        assert(v == 42, s"v should be 42, got $v")
        assert(er_deinit_count == 1, s"deinit should fire once after early return, got $er_deinit_count")

    #test
    test_late_return_drops_refs() -> unit
        er_deinit_count = 0
        val v = early_or_late(false)
        assert(v == 43, s"v should be 43, got $v")
        // Both r and r2 drop on the late-return path.
        assert(er_deinit_count == 2, s"deinit should fire twice, got $er_deinit_count")


Both branches early-return — merge block is unreachable
--------------------------------------------------------

`if cond { return a } else { return b }` makes the syntactic merge
block dead. The LLVM codegen previously emitted a tail `load %T,
%T* 0` + `ret` in that merge block whenever the if's type was an
aggregate (struct / iface), tripping clang's
`integer constant must have integer type` rejector. Fixed by
emitting `unreachable` in the merge block when both branches
returned, and skipping the trailing load+ret in `genBlock` when
`genExpr` of the last statement had already terminated. Other
backends handled the shape correctly already.

    struct ErPair
        a: int
        b: int

    pick_pair(x: int) -> ErPair
        if x > 0
            return ErPair(1, 2)
        else
            return ErPair(3, 4)

### Both-branch-return aggregate (struct)

    #test
    test_both_return_pos() -> unit
        val p = pick_pair(5)
        assert(p.a == 1, s"a; got ${p.a}")
        assert(p.b == 2, s"b; got ${p.b}")

    #test
    test_both_return_neg() -> unit
        val p = pick_pair(-5)
        assert(p.a == 3, s"a; got ${p.a}")
        assert(p.b == 4, s"b; got ${p.b}")

### Both-branch-return scalar (was always fine — pin it)

    abs_via_branches(x: int) -> int
        if x >= 0
            return x
        else
            return 0 - x

    #test
    test_abs_via_branches() -> unit
        assert(abs_via_branches(5) == 5, "pos")
        assert(abs_via_branches(-7) == 7, "neg")
        assert(abs_via_branches(0) == 0, "zero")

### Both-branch-return string

    sign_label(x: int) -> string
        if x > 0
            return "positive"
        else
            return "non-positive"

    #test
    test_sign_label() -> unit
        assert(sign_label(5) == "positive", "pos")
        assert(sign_label(-1) == "non-positive", "neg")
        assert(sign_label(0) == "non-positive", "zero")

### Nested both-branch-return

    classify(x: int) -> int
        if x > 0
            if x > 10
                return 2
            else
                return 1
        else
            return 0

    #test
    test_classify_nested() -> unit
        assert(classify(20) == 2, "big-pos")
        assert(classify(5) == 1, "small-pos")
        assert(classify(0) == 0, "zero")
        assert(classify(-1) == 0, "neg")
