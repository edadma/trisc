String indexing and substring slicing
=====================================

Sysl strings are UTF-8 byte sequences. Two surfaces this
file pins:

  - `s[i]` — single-byte index, yielding `byte` (`u8`).
  - `s[i:j]` — substring slice, yielding `string` over the
    half-open range `[i, j)`.

The slice form supports omitted bounds: `s[:j]` (prefix),
`s[i:]` (suffix), `s[:]` (full copy). An empty range
`s[i:i]` yields the empty string.

Indexing is **byte-wise**, never rune-wise — `s[i]` does
not decode UTF-8. A multi-byte character at position `i`
produces its individual UTF-8 bytes when iterated.

The two surfaces share Go-like semantics (`s[i:j]`); the
prose below pins behaviour, not implementation choice (e.g.
"is the result a view or a copy?" — sysl currently semantics-
pins value, not aliasing).

File-local prefix `Sis` (string-index-slice).

    module sysl.tests.lang_features

`s[i]` is a single byte
-----------------------

Pinned end-to-end: byte value, type (compares against
`byte('c')`), and out-of-the-source-string round-trip
through a `var`.

    #test
    test_sis_index_basic() -> unit
        val s = "hello"
        assert(s[0] == byte('h'), s"s[0]; got ${int(s[0])}")
        assert(s[4] == byte('o'), s"s[4]; got ${int(s[4])}")

    #test
    test_sis_index_via_var() -> unit
        val s = "abc"
        val i = 1
        assert(s[i] == byte('b'), "indexing with a var")

    #test
    test_sis_index_in_expression() -> unit
        val s = "AB"
        val sum = int(s[0]) + int(s[1])
        assert(sum == 65 + 66, s"sum; got $sum")

`s[i:j]` — middle slice
-----------------------

`s[i:j]` is half-open: it contains bytes at positions `i`
through `j-1`. The result is a `string`, comparable with
`==` and queryable with `len(...)`.

    #test
    test_sis_substring_middle() -> unit
        val s = "hello"
        val sub = s[1:4]
        assert(len(sub) == 3, s"sub len; got ${len(sub)}")
        assert(sub == "ell", s"sub value; got '$sub'")

    #test
    test_sis_substring_first_char() -> unit
        val s = "hello"
        assert(s[0:1] == "h", "first byte as substring")
        assert(len(s[0:1]) == 1, "length 1")

    #test
    test_sis_substring_last_char() -> unit
        val s = "hello"
        assert(s[4:5] == "o", "last byte as substring")

`s[:j]` — prefix
----------------

    #test
    test_sis_prefix_omitted_lo() -> unit
        val s = "hello"
        assert(s[:3] == "hel", s"prefix 3; got '${s[:3]}'")
        assert(s[:0] == "", "zero-length prefix")
        assert(s[:5] == "hello", "full-length prefix == original")

`s[i:]` — suffix
----------------

    #test
    test_sis_suffix_omitted_hi() -> unit
        val s = "hello"
        assert(s[2:] == "llo", s"suffix from 2; got '${s[2:]}'")
        assert(s[5:] == "", "zero-length suffix at end")
        assert(s[0:] == "hello", "suffix from 0 == original")

`s[:]` — full copy
------------------

    #test
    test_sis_full_slice() -> unit
        val s = "hello"
        val t = s[:]
        assert(t == s, "full slice value equals original")
        assert(len(t) == 5, "and length")
        assert(t == "hello", "compares to the literal")

Empty slice `s[i:i]`
--------------------

A half-open range with `lo == hi` is empty regardless of
position. Empty slices satisfy `len == 0` and `== ""`.

    #test
    test_sis_empty_slice_at_start() -> unit
        val s = "hello"
        val e = s[0:0]
        assert(len(e) == 0, "empty at start: len 0")
        assert(e == "", "empty at start: value")

    #test
    test_sis_empty_slice_in_middle() -> unit
        val s = "hello"
        val e = s[2:2]
        assert(len(e) == 0, "empty mid: len 0")
        assert(e == "", "empty mid: value")

    #test
    test_sis_empty_slice_at_end() -> unit
        val s = "hello"
        val e = s[5:5]
        assert(len(e) == 0, "empty end: len 0")
        assert(e == "", "empty end: value")

Slicing the empty string
------------------------

The only legal slice of `""` is `[0:0]` / `[:0]` / `[0:]` /
`[:]`, and they all yield `""` again.

    #test
    test_sis_slice_of_empty() -> unit
        val e = ""
        assert(e[:] == "", "[:] of empty")
        assert(e[0:0] == "", "[0:0] of empty")
        assert(len(e[:]) == 0, "len of [:]")

Slice with computed bounds
--------------------------

The bounds may be any int expression — variables, fn
results, arithmetic. The behaviour matches a literal-bounds
slice with the same numeric values.

    sis_three() -> int = 3

    #test
    test_sis_slice_with_var_bounds() -> unit
        val s = "abcdef"
        val lo = 1
        val hi = sis_three() + 1   // 4
        val sub = s[lo:hi]
        assert(sub == "bcd", s"computed bounds; got '$sub'")
        assert(len(sub) == 3, "length 3")

Slice byte-by-byte through index
--------------------------------

A substring is a `string`, so it can itself be indexed.
Bytes in the substring are the same bytes from the source.

    #test
    test_sis_index_into_substring() -> unit
        val s = "hello"
        val mid = s[1:4]               // "ell"
        assert(int(mid[0]) == int('e'), "mid[0] is 'e'")
        assert(int(mid[1]) == int('l'), "mid[1] is 'l'")
        assert(int(mid[2]) == int('l'), "mid[2] is 'l'")
        assert(len(mid) == 3, "mid length is 3")

Substring participates in concat
--------------------------------

A `s[i:j]` result is a regular `string`, so the codegen
must produce a real value that `+` accepts on either side.

    #test
    test_sis_substring_concat_left() -> unit
        val s = "hello"
        val out = s[1:3] + "x"
        assert(out == "elx", s"concat right; got '$out'")
        assert(len(out) == 3, "length 3")

    #test
    test_sis_substring_concat_right() -> unit
        val s = "hello"
        val out = "X" + s[3:5]
        assert(out == "Xlo", s"concat left; got '$out'")

    #test
    test_sis_substring_concat_both() -> unit
        val s = "abcdefg"
        val out = s[1:3] + s[4:6]      // "bc" + "ef"
        assert(out == "bcef", s"concat sub+sub; got '$out'")

Substring through fn boundary
-----------------------------

The result must be a normal string returnable from / passable
to a function. This pins the codegen-stable representation
(length-prefixed buffer, ARC-clean) for sliced strings.

    sis_mid(s: string) -> string = s[1:4]

    #test
    test_sis_substring_returned() -> unit
        val sub = sis_mid("hello")
        assert(sub == "ell", s"returned; got '$sub'")
        assert(len(sub) == 3, "length 3")

UTF-8 multi-byte: indexing reads raw bytes
------------------------------------------

`"ñ"` is `0xC3 0xB1`. Indexing reads each byte; slicing on
byte boundaries works exactly as for ASCII.

    #test
    test_sis_utf8_index() -> unit
        val s = "ñ"
        assert(len(s) == 2, "byte length of 'ñ' is 2")
        assert(int(s[0]) == 0xC3, s"first byte; got 0x${int(s[0])}")
        assert(int(s[1]) == 0xB1, s"second byte; got 0x${int(s[1])}")

    #test
    test_sis_utf8_slice_one_codepoint() -> unit
        val s = "ñ"
        val both = s[0:2]
        assert(len(both) == 2, "two-byte slice")
        assert(both == "ñ", "value round-trip")

    #test
    test_sis_utf8_slice_at_codepoint_boundary() -> unit
        val s = "aña"               // 'a' (1) + 'ñ' (2) + 'a' (1) = 4 bytes
        assert(len(s) == 4, "byte length 4")
        val mid = s[1:3]            // the 'ñ' bytes
        assert(len(mid) == 2, "mid len 2")
        assert(mid == "ñ", "mid value")
        assert(s[0:1] == "a", "prefix 'a'")
        assert(s[3:4] == "a", "trailing 'a'")

Equality of two substring results
---------------------------------

Two `s[i:j]` results with equal contents compare equal via
`==`, regardless of source position.

    #test
    test_sis_substring_eq_across_source_positions() -> unit
        val s = "abcabc"
        val a = s[0:3]
        val b = s[3:6]
        assert(a == b, "'abc' from two source positions are equal")
        assert(len(a) == 3 && len(b) == 3, "and equal length")
