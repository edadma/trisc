Pointer arithmetic
==================

`p + n` advances a `*T` by `n * sizeof(T)` bytes — the result
points to element `n` past the original. The natural use is
walking an array via a pointer rather than via indices.

    module sysl.tests.lang_features

Increment by elements
---------------------

    #test
    test_p_plus_one() -> unit
        var a = [10, 20, 30, 40]
        var p: *int = &a[0]
        var q: *int = p + 1
        assert(*q == 20, s"*(p+1) should be 20, got ${*q}")
        var r: *int = p + 3
        assert(*r == 40, s"*(p+3) should be 40, got ${*r}")

Walk array via pointer
----------------------

    #test
    test_walk_via_pointer() -> unit
        var a = [1, 2, 3, 4, 5]
        var p: *int = &a[0]
        var sum = 0
        var i = 0
        while i < 5
            sum = sum + *(p + i)
            i = i + 1
        assert(sum == 15, s"sum via pointer walk should be 15, got $sum")

Read first element via &a[0]
----------------------------

    #test
    test_read_first_via_addr() -> unit
        var a = [100, 200, 300]
        var p: *int = &a[0]
        assert(*p == 100, s"*p should be 100, got ${*p}")

Write through advanced pointer
------------------------------

    #test
    test_write_via_advanced_ptr() -> unit
        var a = [0, 0, 0, 0]
        var p: *int = &a[0]
        *(p + 2) = 99
        assert(a[2] == 99, s"a[2] should be 99 after *(p+2)=99, got ${a[2]}")
        // Other elements untouched
        assert(a[0] == 0 && a[1] == 0 && a[3] == 0,
            s"a[0,1,3] = (${a[0]},${a[1]},${a[3]}), expected (0,0,0)")
