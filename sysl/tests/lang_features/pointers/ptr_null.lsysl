Branch on null via a fn
-----------------------

A kernel pattern: check before dereferencing.

    safe_get(p: *int, fallback: int) -> int
        if p == *int(0) then return fallback
        return *p

    #test
    test_branch_on_null() -> unit
        var x: int = 7
        var real: *int = &x
        var nullp: *int = *int(0)
        assert(safe_get(real,  -1) == 7,  s"safe_get(real, -1) should be 7, got ${safe_get(real, -1)}")
        assert(safe_get(nullp, -1) == -1, s"safe_get(null, -1) should be -1, got ${safe_get(nullp, -1)}")
