@main
TOS System Services

User-facing API for TOS kernel services.

Syscall numbers:
  0 = sleep           — block for N timer ticks
  1 = putc            — write character to stdout
  2 = yield           — voluntary context switch
  3 = exit            — terminate current thread
  4 = join            — wait for another thread to terminate
  5 = thread_id       — get current thread index
  6 = uptime          — get tick counter
  7 = thread_count    — get number of created threads
  8 = thread_state    — get state of a thread
  9 = thread_name     — get name pointer of a thread
  10 = sleep_until    — block until absolute tick
  11 = ctx_switches   — get context switch count for a thread
  12 = cpu_ticks      — get CPU ticks for a thread
  13 = total_switches — get global context switch count
  14 = set_watchdog   — set watchdog quanta limit (0 = disable)
@

  extern syscall(number: int, arg: int) -> int

  val SYS_SLEEP          = 0
  val SYS_PUTC           = 1
  val SYS_YIELD          = 2
  val SYS_EXIT           = 3
  val SYS_JOIN           = 4
  val SYS_THREAD_ID      = 5
  val SYS_UPTIME         = 6
  val SYS_THREAD_COUNT   = 7
  val SYS_THREAD_STATE   = 8
  val SYS_THREAD_NAME    = 9
  val SYS_SLEEP_UNTIL    = 10
  val SYS_KBHIT          = 11
  val SYS_GETKEY         = 12
  val SYS_CTX_SWITCHES   = 13
  val SYS_CPU_TICKS      = 14
  val SYS_TOTAL_SWITCHES = 15
  val SYS_SET_WATCHDOG   = 16
  val SYS_PANIC          = 17
  val SYS_CHECK_STACK    = 18
  val SYS_SUSPEND        = 19
  val SYS_RESUME         = 20
  val SYS_TLS_SET        = 21
  val SYS_TLS_GET        = 22
  val SYS_NOTIFY_SEND    = 23
  val SYS_NOTIFY_WAIT    = 24
  val SYS_NOTIFY_READ    = 25
  val SYS_EVENT_WAIT     = 26
  val SYS_EVENT_SET      = 27
  val SYS_EVENT_CLEAR    = 28

@api sleep(ticks) — Block the calling thread for N timer ticks.

  sleep(ticks: int)
      syscall(SYS_SLEEP, ticks)

@api putc(ch) — Write a character to stdout.

  putc(ch: int)
      syscall(SYS_PUTC, ch)

@api yield() — Voluntary context switch. Resets watchdog counter.

  yield()
      syscall(SYS_YIELD, 0)

@api exit() — Terminate the calling thread.

  exit()
      syscall(SYS_EXIT, 0)

@api join(id) — Wait for the specified thread to terminate.

  join(id: int)
      syscall(SYS_JOIN, id)

@api thread_id() -> int — Return the current thread's index.

  thread_id() -> int
      syscall(SYS_THREAD_ID, 0)

@api uptime() -> int — Return the current tick counter.

  uptime() -> int
      syscall(SYS_UPTIME, 0)

@api get_thread_count() -> int — Return the number of created threads.

  get_thread_count() -> int
      syscall(SYS_THREAD_COUNT, 0)

@api get_thread_state(id) -> int — Return the state of a thread.

  get_thread_state(id: int) -> int
      syscall(SYS_THREAD_STATE, id)

@api get_thread_name(id) -> int — Return the name pointer of a thread.

  get_thread_name(id: int) -> int
      syscall(SYS_THREAD_NAME, id)

@api sleep_until(tick) — Block until the tick counter reaches the given value.

  sleep_until(tick: int)
      syscall(SYS_SLEEP_UNTIL, tick)

@api kbhit() -> int — Return 1 if a keyboard event is buffered.

  kbhit() -> int
      syscall(SYS_KBHIT, 0)

@api getkey() -> int — Return next keyboard event (packed: scancode|flags|mods), or 0.

  getkey() -> int
      syscall(SYS_GETKEY, 0)

@api get_ctx_switches(id) -> int — Return context switch count for a thread.

  get_ctx_switches(id: int) -> int
      syscall(SYS_CTX_SWITCHES, id)

@api get_cpu_ticks(id) -> int — Return total CPU ticks for a thread.

  get_cpu_ticks(id: int) -> int
      syscall(SYS_CPU_TICKS, id)

@api get_total_switches() -> int — Return global context switch count.

  get_total_switches() -> int
      syscall(SYS_TOTAL_SWITCHES, 0)

@api set_watchdog(limit) — Set watchdog quanta limit. 0 disables.

  set_watchdog(limit: int)
      syscall(SYS_SET_WATCHDOG, limit)

@api panic() — Halt all threads and stop the system.

  panic()
      syscall(SYS_PANIC, 0)

@api check_stack(addr) -> int — Check stack canary at addr. Returns 1 if intact.

  check_stack(addr: int) -> int
      syscall(SYS_CHECK_STACK, addr)

@api suspend(id) — Suspend a thread without terminating it.

  suspend(id: int)
      syscall(SYS_SUSPEND, id)

@api resume(id) — Resume a suspended thread.

  resume(id: int)
      syscall(SYS_RESUME, id)

@api putstr(s) — Print a null-terminated string.

  putstr(s: *byte)
      var i = 0
      while s[i] != 0
          putc(s[i])
          i += 1

@api notify_send_to(id, value) — Send a notification value to a thread.

  notify_send_to(id: int, value: int)
      syscall(SYS_NOTIFY_SEND, (id << 24) | (value & 0xFFFFFF))

@api notify_wait() — Block until a notification arrives.

  notify_wait()
      syscall(SYS_NOTIFY_WAIT, 0)

@api notify_read_self() -> int — Read and clear own notification value.

  notify_read_self() -> int
      syscall(SYS_NOTIFY_READ, 0)

@api event_wait(mask, wait_all) — Block until event bits match mask.

  event_wait(mask: int, wait_all: int)
      syscall(SYS_EVENT_WAIT, (wait_all << 24) | (mask & 0xFFFFFF))

@api event_set(id, bits) — Set event bits on a thread.

  event_set(id: int, bits: int)
      syscall(SYS_EVENT_SET, (id << 24) | (bits & 0xFFFFFF))

@api event_clear(id, bits) — Clear event bits on a thread.

  event_clear(id: int, bits: int)
      syscall(SYS_EVENT_CLEAR, (id << 24) | (bits & 0xFFFFFF))

@api tls_set(slot, value) — Set thread-local storage value (value must fit in 24 bits).

@tech
Packs slot (8 bits) and value (24 bits) into one syscall arg.
Slot range: 0-3. Value range: 0 to 16777215.
@

  tls_set(slot: int, value: int)
      syscall(SYS_TLS_SET, (slot << 24) | (value & 0xFFFFFF))

@api tls_get(slot) -> int — Get thread-local storage value for the current thread.

  tls_get(slot: int) -> int
      syscall(SYS_TLS_GET, slot)
