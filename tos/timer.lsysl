@main
TOS Timer Driver

Handles timer IRQ 0. Acknowledges the timer device and calls the
kernel to increment ticks and wake sleeping threads. The IRQ
dispatcher in boot.asm handles the context switch after this
handler returns.

Device registers:
  0x100020 + 0-3 = PERIOD (4 bytes, write)
  0x100020 + 4   = CONTROL (1 byte, write: nonzero = start)
  0x100020 + 5   = STATUS (1 byte, R/W: write to ack)
@

  val TIMER_BASE    = 0x100020
  val TIMER_STATUS  = 0x100025
  val TIMER_CONTROL = 0x100024
  val TIMER_IRQ     = 0

  extern register_irq(irq: int, handler: int)
  extern tick_and_wake()

@api timer_init(period_ms) — Initialize and start the timer, register IRQ handler.

  timer_init(period_ms: int)
      register_irq(TIMER_IRQ, timer_handler)

      // Write period (big-endian 32-bit)
      val period_base: *i8 = TIMER_BASE
      *(period_base + 0) = (period_ms >> 24) & 0xFF
      *(period_base + 1) = (period_ms >> 16) & 0xFF
      *(period_base + 2) = (period_ms >> 8) & 0xFF
      *(period_base + 3) = period_ms & 0xFF

      // Start timer
      val control: *i8 = TIMER_CONTROL
      *control = 1

@tech
timer_handler — Called by the generic IRQ dispatcher in boot.asm.

Acknowledges the timer and updates kernel tick/wake state. The
dispatcher handles the context switch after this returns (since
IRQ 0 always triggers preemption).
@

  timer_handler()
      // Acknowledge timer (clears fired flag and lowers IRQ on controller)
      val status: *i8 = TIMER_STATUS
      *status = 0

      // Kernel handles tick counting and waking sleeping threads
      tick_and_wake()
