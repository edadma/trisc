@main
Red-Black Tree

A balanced binary search tree with O(log n) insert, remove,
and find-min operations. Uses a statically allocated node pool
with an intrusive free list — no heap allocation required.

Designed for use in OS schedulers (keyed on virtual runtime)
but generic enough for any i64-keyed, int-valued mapping.

Red-black invariants maintained by this implementation:
  1. Every node is red or black
  2. The root is black
  3. No red node has a red child
  4. Every path from root to nil has the same black depth
@

  val RB_BLACK = 0
  val RB_RED   = 1
  val NIL      = -1

  struct RBNode
      key: i64
      value: int
      left: int
      right: int
      parent: int
      color: int
      next_free: int

@tech
The tree state is held in a Tree struct. The node pool is a
separate array passed by pointer, so multiple trees can share
the same pool or each tree can have its own.
@

  struct Tree
      root: int
      count: int
      pool: *RBNode
      free_head: int

@api tree_init(t, pool, pool_size) — Initialize a tree with an external node pool.

@tech
Links all nodes into a free list through the next_free field.
@

  tree_init(t: *Tree, pool: *RBNode, pool_size: int)
      t.root = NIL
      t.count = 0
      t.pool = pool
      var i = 0
      while i < pool_size - 1
          t.pool[i].next_free = i + 1
          i += 1
      t.pool[pool_size - 1].next_free = NIL
      t.free_head = 0

@tech
alloc_node — Take a node from the free list. Returns node index or NIL if full.
@

  alloc_node(t: *Tree) -> int
      val idx = t.free_head
      if idx == NIL
          return NIL
      t.free_head = t.pool[idx].next_free
      t.pool[idx].left = NIL
      t.pool[idx].right = NIL
      t.pool[idx].parent = NIL
      t.pool[idx].color = RB_RED
      t.pool[idx].next_free = NIL
      idx

@tech
free_node — Return a node to the free list.
@

  free_node(t: *Tree, idx: int)
      t.pool[idx].next_free = t.free_head
      t.free_head = idx

@tech
node_color — Safe color accessor that treats NIL as black.
@

  node_color(t: *Tree, idx: int) -> int
      if idx == NIL
          return RB_BLACK
      t.pool[idx].color

  set_color(t: *Tree, idx: int, c: int)
      if idx != NIL
          t.pool[idx].color = c

@tech
rotate_left and rotate_right — Standard BST rotations used
during rebalancing after insert and remove.
@

  rotate_left(t: *Tree, x: int)
      val y = t.pool[x].right

      t.pool[x].right = t.pool[y].left
      if t.pool[y].left != NIL
          t.pool[t.pool[y].left].parent = x

      t.pool[y].parent = t.pool[x].parent
      if t.pool[x].parent == NIL
          t.root = y
      else
          if x == t.pool[t.pool[x].parent].left
              t.pool[t.pool[x].parent].left = y
          else
              t.pool[t.pool[x].parent].right = y

      t.pool[y].left = x
      t.pool[x].parent = y

  rotate_right(t: *Tree, y: int)
      val x = t.pool[y].left

      t.pool[y].left = t.pool[x].right
      if t.pool[x].right != NIL
          t.pool[t.pool[x].right].parent = y

      t.pool[x].parent = t.pool[y].parent
      if t.pool[y].parent == NIL
          t.root = x
      else
          if y == t.pool[t.pool[y].parent].left
              t.pool[t.pool[y].parent].left = x
          else
              t.pool[t.pool[y].parent].right = x

      t.pool[x].right = y
      t.pool[y].parent = x

@tech
insert_fixup — Restore red-black invariants after insertion.
The new node is red. Walk up the tree fixing red-red violations
by recoloring or rotating.
@

  insert_fixup(t: *Tree, z_in: int)
      var z = z_in
      while t.pool[z].parent != NIL
          val p = t.pool[z].parent
          if t.pool[p].color != RB_RED
              break
          val gp = t.pool[p].parent
          if gp == NIL
              break
          if p == t.pool[gp].left
              val uncle = t.pool[gp].right
              if node_color(t, uncle) == RB_RED
                  // Case 1: uncle is red — recolor
                  t.pool[p].color = RB_BLACK
                  set_color(t, uncle, RB_BLACK)
                  t.pool[gp].color = RB_RED
                  z = gp
              else
                  if z == t.pool[p].right
                      // Case 2: z is right child — rotate left
                      z = p
                      rotate_left(t, z)
                  // Case 3: z is left child — rotate right
                  val p2 = t.pool[z].parent
                  val gp2 = t.pool[p2].parent
                  t.pool[p2].color = RB_BLACK
                  t.pool[gp2].color = RB_RED
                  rotate_right(t, gp2)
          else
              // Mirror: parent is right child of grandparent
              val uncle = t.pool[gp].left
              if node_color(t, uncle) == RB_RED
                  t.pool[p].color = RB_BLACK
                  set_color(t, uncle, RB_BLACK)
                  t.pool[gp].color = RB_RED
                  z = gp
              else
                  if z == t.pool[p].left
                      z = p
                      rotate_right(t, z)
                  val p2 = t.pool[z].parent
                  val gp2 = t.pool[p2].parent
                  t.pool[p2].color = RB_BLACK
                  t.pool[gp2].color = RB_RED
                  rotate_left(t, gp2)
      // Root must be black
      t.pool[t.root].color = RB_BLACK

@api rb_insert(t, key, value) -> int — Insert a key-value pair. Returns node index or NIL if pool is full.

  rb_insert(t: *Tree, key: i64, value: int) -> int
      val z = alloc_node(t)
      if z == NIL
          return NIL
      t.pool[z].key = key
      t.pool[z].value = value

      // Standard BST insert
      var parent = NIL
      var cur = t.root
      while cur != NIL
          parent = cur
          if key < t.pool[cur].key
              cur = t.pool[cur].left
          else
              cur = t.pool[cur].right

      t.pool[z].parent = parent
      if parent == NIL
          t.root = z
      else
          if key < t.pool[parent].key
              t.pool[parent].left = z
          else
              t.pool[parent].right = z

      t.count += 1
      insert_fixup(t, z)
      z

@api rb_find_min(t) -> int — Return the index of the node with the smallest key, or NIL if empty.

  rb_find_min(t: *Tree) -> int
      if t.root == NIL
          return NIL
      var cur = t.root
      while t.pool[cur].left != NIL
          cur = t.pool[cur].left
      cur

@tech
transplant — Replace subtree rooted at u with subtree rooted at v.
Used during node removal.
@

  transplant(t: *Tree, u: int, v: int)
      if t.pool[u].parent == NIL
          t.root = v
      else
          val p = t.pool[u].parent
          if u == t.pool[p].left
              t.pool[p].left = v
          else
              t.pool[p].right = v
      if v != NIL
          t.pool[v].parent = t.pool[u].parent

@tech
remove_fixup — Restore red-black invariants after removal.
Called when a black node was removed, which may violate the
equal-black-depth invariant.
@

  remove_fixup(t: *Tree, x_in: int, xp_in: int)
      var x = x_in
      var xp = xp_in
      while x != t.root
          if node_color(t, x) == RB_RED
              break
          if xp == NIL
              break
          if x == t.pool[xp].left
              var w = t.pool[xp].right
              if w == NIL
                  break
              if t.pool[w].color == RB_RED
                  // Case 1: sibling is red
                  t.pool[w].color = RB_BLACK
                  t.pool[xp].color = RB_RED
                  rotate_left(t, xp)
                  w = t.pool[xp].right
                  if w == NIL
                      break
              if node_color(t, t.pool[w].left) == RB_BLACK
                  if node_color(t, t.pool[w].right) == RB_BLACK
                      // Case 2: both children of sibling are black
                      t.pool[w].color = RB_RED
                      x = xp
                      xp = t.pool[x].parent
                      continue
              if node_color(t, t.pool[w].right) == RB_BLACK
                  // Case 3: sibling's right child is black
                  set_color(t, t.pool[w].left, RB_BLACK)
                  t.pool[w].color = RB_RED
                  rotate_right(t, w)
                  w = t.pool[xp].right
              // Case 4: sibling's right child is red
              t.pool[w].color = t.pool[xp].color
              t.pool[xp].color = RB_BLACK
              set_color(t, t.pool[w].right, RB_BLACK)
              rotate_left(t, xp)
              x = t.root
              break
          else
              // Mirror: x is right child
              var w = t.pool[xp].left
              if w == NIL
                  break
              if t.pool[w].color == RB_RED
                  t.pool[w].color = RB_BLACK
                  t.pool[xp].color = RB_RED
                  rotate_right(t, xp)
                  w = t.pool[xp].left
                  if w == NIL
                      break
              if node_color(t, t.pool[w].right) == RB_BLACK
                  if node_color(t, t.pool[w].left) == RB_BLACK
                      t.pool[w].color = RB_RED
                      x = xp
                      xp = t.pool[x].parent
                      continue
              if node_color(t, t.pool[w].left) == RB_BLACK
                  set_color(t, t.pool[w].right, RB_BLACK)
                  t.pool[w].color = RB_RED
                  rotate_left(t, w)
                  w = t.pool[xp].left
              t.pool[w].color = t.pool[xp].color
              t.pool[xp].color = RB_BLACK
              set_color(t, t.pool[w].left, RB_BLACK)
              rotate_right(t, xp)
              x = t.root
              break
      set_color(t, x, RB_BLACK)

@api rb_remove(t, z) — Remove node at index z from the tree.

  rb_remove(t: *Tree, z: int)
      val y_orig_color = t.pool[z].color
      var x = NIL
      var xp = NIL

      if t.pool[z].left == NIL
          x = t.pool[z].right
          xp = t.pool[z].parent
          transplant(t, z, t.pool[z].right)
      else
          if t.pool[z].right == NIL
              x = t.pool[z].left
              xp = t.pool[z].parent
              transplant(t, z, t.pool[z].left)
          else
              // Find in-order successor (min of right subtree)
              var y = t.pool[z].right
              while t.pool[y].left != NIL
                  y = t.pool[y].left
              val y_color = t.pool[y].color
              x = t.pool[y].right
              if t.pool[y].parent == z
                  xp = y
              else
                  xp = t.pool[y].parent
                  transplant(t, y, t.pool[y].right)
                  t.pool[y].right = t.pool[z].right
                  t.pool[t.pool[y].right].parent = y
              transplant(t, z, y)
              t.pool[y].left = t.pool[z].left
              t.pool[t.pool[y].left].parent = y
              t.pool[y].color = t.pool[z].color
              if y_color == RB_BLACK
                  remove_fixup(t, x, xp)
                  free_node(t, z)
                  t.count -= 1
                  return

      if y_orig_color == RB_BLACK
          remove_fixup(t, x, xp)
      free_node(t, z)
      t.count -= 1

@api rb_node_key(t, idx) -> i64 — Get the key of a node.

  rb_node_key(t: *Tree, idx: int) -> i64
      t.pool[idx].key

@api rb_node_value(t, idx) -> int — Get the value of a node.

  rb_node_value(t: *Tree, idx: int) -> int
      t.pool[idx].value

@api rb_count(t) -> int — Return the number of nodes in the tree.

  rb_count(t: *Tree) -> int
      t.count

@api rb_empty(t) -> int — Return 1 if the tree is empty, 0 otherwise.

  rb_empty(t: *Tree) -> int
      if t.root == NIL
          1
      else
          0
