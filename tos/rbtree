@main
Red-Black Tree

A balanced binary search tree with O(log n) insert, remove,
and find-min operations. Uses a statically allocated node pool
with an intrusive free list — no heap allocation required.

Designed for use in OS schedulers (keyed on virtual runtime)
but generic enough for any i64-keyed, int-valued mapping.

Red-black invariants maintained by this implementation:
  1. Every node is red or black
  2. The root is black
  3. No red node has a red child
  4. Every path from root to nil has the same black depth
@

  val RB_BLACK = 0
  val RB_RED   = 1
  val NIL      = -1
  val RB_MAX_NODES = 64

  struct RBNode
      key: i64
      value: int
      left: int
      right: int
      parent: int
      color: int
      next_free: int

@tech
The tree state is held in a Tree struct. The node pool is a
separate array passed by pointer, so multiple trees can share
the same pool or each tree can have its own.
@

  struct Tree
      root: int
      count: int
      pool: *RBNode
      free_head: int

@tech
node_at — Helper to access a node in the tree's pool by index.
Sysl does not support chained field-access-then-index (t.pool[i]),
so this function bridges the gap.
@

  node_at(t: *Tree, idx: int) -> *RBNode
      var p: *RBNode = t.pool
      &p[idx]

@api tree_init(t, pool, pool_size) — Initialize a tree with an external node pool.

@tech
Links all nodes into a free list through the next_free field.
@

  tree_init(t: *Tree, pool: *RBNode, pool_size: int)
      t.root = NIL
      t.count = 0
      t.pool = pool
      // Build free list
      var i = 0
      while i < pool_size - 1
          var n: *RBNode = &pool[i]
          n.next_free = i + 1
          i += 1
      var last: *RBNode = &pool[pool_size - 1]
      last.next_free = NIL
      t.free_head = 0

@tech
alloc_node — Take a node from the free list. Returns node index or NIL if full.
@

  alloc_node(t: *Tree) -> int
      val idx = t.free_head
      if idx == NIL
          return NIL
      var n: *RBNode = node_at(t, idx)
      t.free_head = n.next_free
      n.left = NIL
      n.right = NIL
      n.parent = NIL
      n.color = RB_RED
      n.next_free = NIL
      idx

@tech
free_node — Return a node to the free list.
@

  free_node(t: *Tree, idx: int)
      var n: *RBNode = node_at(t, idx)
      n.next_free = t.free_head
      t.free_head = idx

@tech
rotate_left and rotate_right — Standard BST rotations used
during rebalancing after insert and remove.
@

  rotate_left(t: *Tree, x: int)
      var xn: *RBNode = node_at(t, x)
      val y = xn.right
      var yn: *RBNode = node_at(t, y)

      xn.right = yn.left
      if yn.left != NIL
          var ln: *RBNode = node_at(t, yn.left)
          ln.parent = x

      yn.parent = xn.parent
      if xn.parent == NIL
          t.root = y
      else
          var pn: *RBNode = node_at(t,xn.parent]
          if x == pn.left
              pn.left = y
          else
              pn.right = y

      yn.left = x
      xn.parent = y

  rotate_right(t: *Tree, y: int)
      var yn: *RBNode = node_at(t, y)
      val x = yn.left
      var xn: *RBNode = node_at(t, x)

      yn.left = xn.right
      if xn.right != NIL
          var rn: *RBNode = node_at(t,xn.right]
          rn.parent = y

      xn.parent = yn.parent
      if yn.parent == NIL
          t.root = x
      else
          var pn: *RBNode = node_at(t,yn.parent]
          if y == pn.left
              pn.left = x
          else
              pn.right = x

      xn.right = y
      yn.parent = x

@tech
node_color — Safe color accessor that treats NIL as black.
@

  node_color(t: *Tree, idx: int) -> int
      if idx == NIL
          return RB_BLACK
      var n: *RBNode = node_at(t, idx)
      n.color

  set_color(t: *Tree, idx: int, c: int)
      if idx != NIL
          var n: *RBNode = node_at(t, idx)
          n.color = c

@tech
insert_fixup — Restore red-black invariants after insertion.
The new node is red. Walk up the tree fixing red-red violations
by recoloring or rotating.
@

  insert_fixup(t: *Tree, z_in: int)
      var z = z_in
      var zn: *RBNode = node_at(t, z)
      while zn.parent != NIL
          var pn: *RBNode = node_at(t,zn.parent]
          if pn.color != RB_RED
              break
          val pp = pn.parent
          if pp == NIL
              break
          var gpn: *RBNode = node_at(t,pp]
          if zn.parent == gpn.left
              val uncle = gpn.right
              if node_color(t, uncle) == RB_RED
                  // Case 1: uncle is red — recolor
                  pn.color = RB_BLACK
                  set_color(t, uncle, RB_BLACK)
                  gpn.color = RB_RED
                  z = pp
                  zn = node_at(t, z)
              else
                  if z == pn.right
                      // Case 2: z is right child — rotate left
                      z = zn.parent
                      rotate_left(t, z)
                      zn = node_at(t, z)
                      pn = node_at(t,zn.parent]
                      gpn = node_at(t,pn.parent]
                  // Case 3: z is left child — rotate right
                  pn.color = RB_BLACK
                  gpn.color = RB_RED
                  rotate_right(t, pn.parent)
          else
              // Mirror: parent is right child of grandparent
              val uncle = gpn.left
              if node_color(t, uncle) == RB_RED
                  pn.color = RB_BLACK
                  set_color(t, uncle, RB_BLACK)
                  gpn.color = RB_RED
                  z = pp
                  zn = node_at(t, z)
              else
                  if z == pn.left
                      z = zn.parent
                      rotate_right(t, z)
                      zn = node_at(t, z)
                      pn = node_at(t,zn.parent]
                      gpn = node_at(t,pn.parent]
                  pn.color = RB_BLACK
                  gpn.color = RB_RED
                  rotate_left(t, pn.parent)
      // Root must be black
      var root: *RBNode = node_at(t,t.root]
      root.color = RB_BLACK

@api rb_insert(t, key, value) -> int — Insert a key-value pair. Returns node index or NIL if pool is full.

  rb_insert(t: *Tree, key: i64, value: int) -> int
      val z = alloc_node(t)
      if z == NIL
          return NIL
      var zn: *RBNode = node_at(t, z)
      zn.key = key
      zn.value = value

      // Standard BST insert
      var parent = NIL
      var cur = t.root
      while cur != NIL
          parent = cur
          var cn: *RBNode = node_at(t,cur]
          if key < cn.key
              cur = cn.left
          else
              cur = cn.right

      zn.parent = parent
      if parent == NIL
          t.root = z
      else
          var pn: *RBNode = node_at(t,parent]
          if key < pn.key
              pn.left = z
          else
              pn.right = z

      t.count += 1
      insert_fixup(t, z)
      z

@api rb_find_min(t) -> int — Return the index of the node with the smallest key, or NIL if empty.

  rb_find_min(t: *Tree) -> int
      if t.root == NIL
          return NIL
      var cur = t.root
      var cn: *RBNode = node_at(t,cur]
      while cn.left != NIL
          cur = cn.left
          cn = node_at(t,cur]
      cur

@tech
transplant — Replace subtree rooted at u with subtree rooted at v.
Used during node removal.
@

  transplant(t: *Tree, u: int, v: int)
      var un: *RBNode = node_at(t,u]
      if un.parent == NIL
          t.root = v
      else
          var pn: *RBNode = node_at(t,un.parent]
          if u == pn.left
              pn.left = v
          else
              pn.right = v
      if v != NIL
          var vn: *RBNode = node_at(t,v]
          vn.parent = un.parent

@tech
remove_fixup — Restore red-black invariants after removal.
Called when a black node was removed, which may violate the
equal-black-depth invariant.
@

  remove_fixup(t: *Tree, x_in: int, xp_in: int)
      var x = x_in
      var xp = xp_in
      while x != t.root
          if node_color(t, x) == RB_RED
              break
          if xp == NIL
              break
          var pn: *RBNode = node_at(t,xp]
          if x == pn.left
              var w = pn.right
              if w == NIL
                  break
              var wn: *RBNode = node_at(t,w]
              if wn.color == RB_RED
                  // Case 1: sibling is red
                  wn.color = RB_BLACK
                  pn.color = RB_RED
                  rotate_left(t, xp)
                  pn = node_at(t,xp]
                  w = pn.right
                  if w == NIL
                      break
                  wn = node_at(t,w]
              if node_color(t, wn.left) == RB_BLACK
                  if node_color(t, wn.right) == RB_BLACK
                      // Case 2: both children of sibling are black
                      wn.color = RB_RED
                      x = xp
                      var xn: *RBNode = node_at(t, x)
                      xp = xn.parent
                      continue
              if node_color(t, wn.right) == RB_BLACK
                  // Case 3: sibling's right child is black
                  set_color(t, wn.left, RB_BLACK)
                  wn.color = RB_RED
                  rotate_right(t, w)
                  pn = node_at(t,xp]
                  w = pn.right
                  wn = node_at(t,w]
              // Case 4: sibling's right child is red
              wn.color = pn.color
              pn.color = RB_BLACK
              set_color(t, wn.right, RB_BLACK)
              rotate_left(t, xp)
              x = t.root
              break
          else
              // Mirror: x is right child
              var w = pn.left
              if w == NIL
                  break
              var wn: *RBNode = node_at(t,w]
              if wn.color == RB_RED
                  wn.color = RB_BLACK
                  pn.color = RB_RED
                  rotate_right(t, xp)
                  pn = node_at(t,xp]
                  w = pn.left
                  if w == NIL
                      break
                  wn = node_at(t,w]
              if node_color(t, wn.right) == RB_BLACK
                  if node_color(t, wn.left) == RB_BLACK
                      wn.color = RB_RED
                      x = xp
                      var xn: *RBNode = node_at(t, x)
                      xp = xn.parent
                      continue
              if node_color(t, wn.left) == RB_BLACK
                  set_color(t, wn.right, RB_BLACK)
                  wn.color = RB_RED
                  rotate_left(t, w)
                  pn = node_at(t,xp]
                  w = pn.left
                  wn = node_at(t,w]
              wn.color = pn.color
              pn.color = RB_BLACK
              set_color(t, wn.left, RB_BLACK)
              rotate_right(t, xp)
              x = t.root
              break
      set_color(t, x, RB_BLACK)

@api rb_remove(t, z) — Remove node at index z from the tree.

  rb_remove(t: *Tree, z: int)
      var zn: *RBNode = node_at(t, z)
      var y = z
      var yn: *RBNode = node_at(t, y)
      val y_orig_color = yn.color
      var x = NIL
      var xp = NIL

      if zn.left == NIL
          x = zn.right
          xp = zn.parent
          transplant(t, z, zn.right)
      else
          if zn.right == NIL
              x = zn.left
              xp = zn.parent
              transplant(t, z, zn.left)
          else
              // Find in-order successor (min of right subtree)
              y = zn.right
              yn = node_at(t, y)
              while yn.left != NIL
                  y = yn.left
                  yn = node_at(t, y)
              val y_color = yn.color
              x = yn.right
              if yn.parent == z
                  xp = y
              else
                  xp = yn.parent
                  transplant(t, y, yn.right)
                  yn.right = zn.right
                  var rn: *RBNode = node_at(t,yn.right]
                  rn.parent = y
              transplant(t, z, y)
              yn.left = zn.left
              var ln: *RBNode = node_at(t, yn.left)
              ln.parent = y
              yn.color = zn.color
              if y_color == RB_BLACK
                  remove_fixup(t, x, xp)
                  free_node(t, z)
                  t.count -= 1
                  return

      if y_orig_color == RB_BLACK
          remove_fixup(t, x, xp)
      free_node(t, z)
      t.count -= 1

@api rb_node_key(t, idx) -> i64 — Get the key of a node.

  rb_node_key(t: *Tree, idx: int) -> i64
      var n: *RBNode = node_at(t, idx)
      n.key

@api rb_node_value(t, idx) -> int — Get the value of a node.

  rb_node_value(t: *Tree, idx: int) -> int
      var n: *RBNode = node_at(t, idx)
      n.value

@api rb_count(t) -> int — Return the number of nodes in the tree.

  rb_count(t: *Tree) -> int
      t.count

@api rb_empty(t) -> int — Return 1 if the tree is empty, 0 otherwise.

  rb_empty(t: *Tree) -> int
      if t.root == NIL
          1
      else
          0
