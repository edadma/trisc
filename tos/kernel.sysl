/*
 * ============================================================================
 * TOS (Tiny OS) — Kernel
 * ============================================================================
 *
 * OS primitives:
 *   - Thread data structures (TCB)
 *   - Thread creation (building initial stack frames)
 *   - Scheduler (round-robin with sleep support)
 *   - sleep_current() — blocks current thread until wake time
 *
 * All kernel services are accessed through trap 0 (syscall).
 * The trap handler in boot.asm dispatches based on r1:
 *   0 = sleep(ticks)    — block for N timer ticks
 *   1 = putc(char)      — write character to stdout
 *   2 = yield()         — voluntary context switch
 *
 * ============================================================================
 */


/*
 * ============================================================================
 * Constants
 * ============================================================================
 */

val MAX_THREADS = 8

// Thread states
val STATE_READY      = 0
val STATE_RUNNING    = 1
val STATE_BLOCKED    = 2
val STATE_TERMINATED = 3


/*
 * ============================================================================
 * Thread Control Block (TCB)
 * ============================================================================
 */

struct Task
    ssp: int
    state: int
    wake_tick: int
    name: *byte


/*
 * ============================================================================
 * Kernel Global State
 * ============================================================================
 */

var tasks: [8]Task
var current_thread = 0
var thread_count = 0
var ticks = 0


/*
 * ============================================================================
 * create_thread — Create a new thread
 * ============================================================================
 *
 * Builds a fake stack frame so the scheduler can "restore" it.
 *
 * Frame layout (matches timer ISR save order):
 *   SP+0:  USP          SP+32: r3
 *   SP+8:  r6           SP+40: r2
 *   SP+16: r5           SP+48: r1
 *   SP+24: r4           SP+56: PC
 *                        SP+64: PSR
 * ============================================================================
 */

create_thread(entry_point: int, usp: int, ssp: int, name: *byte)
    var sp = ssp

    sp -= 8
    *sp = 0                 // PSR = 0 (user mode, interrupts enabled)
    sp -= 8
    *sp = entry_point       // PC

    sp -= 8
    *sp = 0                 // r1
    sp -= 8
    *sp = 0                 // r2
    sp -= 8
    *sp = 0                 // r3
    sp -= 8
    *sp = 0                 // r4
    sp -= 8
    *sp = 0                 // r5
    sp -= 8
    *sp = 0                 // r6

    sp -= 8
    *sp = usp               // USP

    val idx = thread_count
    var t: *Task = &tasks[idx]
    t.ssp = sp
    t.state = STATE_READY
    t.wake_tick = 0
    t.name = name
    thread_count += 1


/*
 * ============================================================================
 * sleep_current — Block the current thread for N ticks
 * ============================================================================
 *
 * Called from the trap handler (in supervisor mode) before schedule().
 * Sets the current thread to BLOCKED with a wake time.
 *
 * ============================================================================
 */

sleep_current(nticks: int)
    var cur: *Task = &tasks[current_thread]
    cur.state = STATE_BLOCKED
    cur.wake_tick = ticks + nticks


/*
 * ============================================================================
 * schedule — Round-robin scheduler with sleep support
 * ============================================================================
 *
 * Called from timer ISR and trap handler.
 *   1. Saves current SSP into TCB
 *   2. Wakes any threads whose sleep time has expired
 *   3. Picks the next READY thread (round-robin)
 *   4. Returns that thread's SSP
 *
 * If no threads are READY, returns the current thread's SSP (no switch).
 *
 * ============================================================================
 */

schedule(current_ssp: int) -> int
    ticks += 1

    // Save current thread's stack pointer
    var cur: *Task = &tasks[current_thread]
    cur.ssp = current_ssp
    if cur.state == STATE_RUNNING
        cur.state = STATE_READY

    // Wake threads whose sleep time has expired
    var i = 0
    while i < thread_count
        var t: *Task = &tasks[i]
        if t.state == STATE_BLOCKED
            if ticks >= t.wake_tick
                t.state = STATE_READY
        i += 1

    // Find next READY thread (round-robin)
    var next = current_thread + 1
    if next >= thread_count
        next = 0
    var checked = 0
    while checked < thread_count
        var t: *Task = &tasks[next]
        if t.state == STATE_READY
            current_thread = next
            t.state = STATE_RUNNING
            return t.ssp
        next += 1
        if next >= thread_count
            next = 0
        checked += 1

    // No ready threads — stay on current (shouldn't happen with idle task)
    cur.state = STATE_RUNNING
    current_ssp


/*
 * ============================================================================
 * first_thread_ssp — Return SSP of thread 0
 * ============================================================================
 */

first_thread_ssp() -> int
    var first: *Task = &tasks[0]
    first.ssp
