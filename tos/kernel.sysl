# ============================================================================
# TOS — Kernel (Sysl)
# ============================================================================
#
# Thread management and scheduling logic.
# Called from assembly boot code and timer ISR.
#
# ============================================================================

# Maximum number of threads
val MAX_THREADS = 8

# Thread control block table — each entry is a saved SSP (8 bytes)
# tcb[i] holds the supervisor stack pointer for thread i
tcb: [8]int

# Current thread index and total count
var current_thread = 0
var thread_count = 0


# ============================================================================
# create_thread — set up a new thread
# ============================================================================
#
# Builds a fake supervisor stack frame so the scheduler can "restore"
# into this thread as if it had been preempted.
#
# Stack frame layout (low address = top of stack):
#   [USP] [r6] [r5] [r4] [r3] [r2] [r1] [PC] [PSR]
#
# entry_point: where the thread starts executing
# usp:         top of the thread's user stack
# ssp:         top of the thread's supervisor stack
#
# ============================================================================

create_thread(entry_point: int, usp: int, ssp: int)
    # Build frame from bottom (high address) to top (low address)
    # The supervisor stack grows downward
    var sp = ssp

    # PSR — user mode, interrupts enabled
    sp -= 8
    *sp = 0

    # PC — thread entry point
    sp -= 8
    *sp = entry_point

    # r1 through r6 — zeroed (fresh thread)
    sp -= 8
    *sp = 0
    sp -= 8
    *sp = 0
    sp -= 8
    *sp = 0
    sp -= 8
    *sp = 0
    sp -= 8
    *sp = 0
    sp -= 8
    *sp = 0

    # USP — user stack pointer
    sp -= 8
    *sp = usp

    # Store the constructed SSP in the TCB
    tcb[thread_count] = sp
    thread_count += 1


# ============================================================================
# schedule — round-robin scheduler
# ============================================================================
#
# Called from timer ISR with current SSP.
# Saves it in the current thread's TCB, picks the next thread,
# returns the next thread's SSP.
#
# ============================================================================

schedule(current_ssp: int) -> int
    # Save current thread's stack pointer
    tcb[current_thread] = current_ssp

    # Round-robin: advance to next thread
    current_thread += 1
    if current_thread >= thread_count
        current_thread = 0

    # Return the next thread's saved SSP
    tcb[current_thread]


# ============================================================================
# kernel_main — called from boot.asm
# ============================================================================
#
# Sets up threads and starts the first one.
# Does not return.
#
# ============================================================================

kernel_main()
    # Create user threads
    #   Thread 0: task_a, user stack at 0x6000, supervisor stack at 0x5000
    #   Thread 1: task_b, user stack at 0x8000, supervisor stack at 0x7000
    #   Thread 2: idle,   user stack at 0xA000, supervisor stack at 0x9000
    create_thread(task_a, 0x6000, 0x5000)
    create_thread(task_b, 0x8000, 0x7000)
    create_thread(idle_task, 0xA000, 0x9000)

    # Start timer — write interval (ms) to timer device at 0xFFE8
    val timer_addr = 0xFFE8
    *timer_addr = 10

    # Start first thread — this never returns
    # start_first_thread is assembly: loads context and RTEs
    start_first_thread(tcb[0])
