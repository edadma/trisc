/*
 * ============================================================================
 * TOS (Tiny OS) — Kernel
 * ============================================================================
 *
 * This file contains all kernel logic written in Sysl:
 *
 *   - Thread data structures (TCB)
 *   - Thread creation (building initial stack frames)
 *   - Scheduler (round-robin policy)
 *   - Kernel initialization (kernel_main)
 *
 * The only assembly in TOS is the boot code and ISR entry/exit.
 * Everything else — including the scheduler's decision logic — is here.
 *
 * ============================================================================
 */


/*
 * ============================================================================
 * Constants
 * ============================================================================
 */

// Maximum number of threads the system supports.
// This determines the size of the TCB array.
val MAX_THREADS = 8

// Timer device: writing a value (in milliseconds) to this address
// starts the periodic timer interrupt.
val TIMER_DEVICE = 0xFFE8

// Scheduling interval in milliseconds.
// 10ms = 100 Hz — a reasonable tick rate for an RTOS.
val TICK_MS = 10

// Thread states — stored in the Task struct's "state" field.
// Currently only READY is used (all threads are always runnable).
// BLOCKED and TERMINATED are defined for future use.
val STATE_READY      = 0    // thread is runnable
val STATE_RUNNING    = 1    // thread is currently executing (the active thread)
val STATE_BLOCKED    = 2    // thread is waiting for something (future: sleep, I/O)
val STATE_TERMINATED = 3    // thread has exited (future: thread exit)


/*
 * ============================================================================
 * Thread Control Block (TCB)
 * ============================================================================
 *
 * Each thread is represented by a Task struct.
 *
 * The key insight: the entire register context (r1-r6, USP, PC, PSR)
 * lives on the thread's supervisor stack — NOT in the TCB. The TCB
 * only stores the supervisor stack pointer, which points to the saved
 * context. This keeps the TCB tiny and the context switch simple:
 * save SSP → swap SSP → restore from new SSP.
 *
 * ============================================================================
 */

struct Task
    ssp: int                // saved supervisor stack pointer
    state: int              // thread state (STATE_READY, etc.)
    priority: int           // scheduling priority (0 = highest, not yet used)
    name: *byte             // human-readable name (for debugging)


/*
 * ============================================================================
 * Kernel Global State
 * ============================================================================
 */

// Array of all thread control blocks.
var tasks: [8]Task

// Index of the currently running thread (0 to thread_count-1).
var current_thread = 0

// Total number of threads that have been created.
var thread_count = 0


/*
 * ============================================================================
 * create_thread — Create a new thread
 * ============================================================================
 *
 * This function does NOT start the thread. It builds a fake stack frame
 * on the thread's supervisor stack so that the scheduler can later
 * "restore" this frame as if the thread had been preempted.
 *
 * The fake frame has the same layout as what the timer ISR saves:
 *
 *   Offset  Contents     Value for new thread
 *   ──────  ────────     ────────────────────
 *   SP+0    USP          user stack top (provided by caller)
 *   SP+8    r6           0 (no return address)
 *   SP+16   r5           0
 *   SP+24   r4           0
 *   SP+32   r3           0
 *   SP+40   r2           0
 *   SP+48   r1           0
 *   SP+56   PC           entry_point (where the thread starts)
 *   SP+64   PSR          0 (user mode, interrupts enabled)
 *
 * When the scheduler first switches to this thread, it pops this
 * frame, restoring "registers" that were never actually saved.
 * The RTE instruction pops PC (= entry_point) and PSR (= user mode),
 * and the thread begins executing at its entry point in user mode.
 *
 * Arguments:
 *   entry_point — address of the function where the thread starts
 *   usp         — top of the thread's user stack (grows downward)
 *   ssp         — top of the thread's supervisor stack (grows downward)
 *   name        — pointer to a string name (for debugging)
 *
 * ============================================================================
 */

create_thread(entry_point: int, usp: int, ssp: int, name: *byte)
    // Start at the top of the supervisor stack and build downward.
    // Each field is 8 bytes (64-bit values on TRISC).
    var sp = ssp

    /* ---- Build the hardware-pushed part (bottom of frame) ---- */

    // PSR: user mode with interrupts enabled.
    // Bit 0 = 0 means user mode. Bit 1 = 0 means interrupts enabled.
    sp -= 8                 // make room for PSR
    *sp = 0                 // PSR = 0 (user mode, interrupts enabled)

    // PC: the address where this thread will start executing.
    sp -= 8                 // make room for PC
    *sp = entry_point       // PC = thread entry point

    /* ---- Build the ISR-saved part (top of frame) ---- */

    // r1 through r6: all zero (fresh thread, no register state yet).
    // When the scheduler "restores" these, the thread starts with
    // all registers cleared.
    sp -= 8                 // r1
    *sp = 0
    sp -= 8                 // r2
    *sp = 0
    sp -= 8                 // r3
    *sp = 0
    sp -= 8                 // r4
    *sp = 0
    sp -= 8                 // r5
    *sp = 0
    sp -= 8                 // r6
    *sp = 0

    // USP: the thread's user stack pointer. When the thread starts,
    // this will be restored as the user stack, and the thread's
    // function calls and local variables will use this stack.
    sp -= 8                 // USP
    *sp = usp

    /* ---- Store the thread in the TCB array ---- */

    // The TCB just records the SSP (which points to the top of the
    // constructed frame above) plus metadata.
    val idx = thread_count  // index for the new thread
    var t: *Task = &tasks[idx]  // pointer to the new TCB entry

    t.ssp = sp              // save the constructed stack pointer
    t.state = STATE_READY   // thread is ready to run
    t.priority = 0          // default priority
    t.name = name           // save the name pointer

    // Increment the thread count.
    thread_count += 1


/*
 * ============================================================================
 * schedule — Round-robin scheduler
 * ============================================================================
 *
 * Called from the timer ISR (in assembly) with the current thread's
 * supervisor stack pointer. This function:
 *
 *   1. Saves the SSP into the current thread's TCB
 *   2. Picks the next runnable thread (round-robin)
 *   3. Returns the new thread's SSP
 *
 * The timer ISR then restores registers from the new thread's stack
 * and RTEs into it.
 *
 * This is a non-preemptive function — it runs with interrupts disabled
 * (we're inside an ISR), so it must be fast. No blocking, no allocation.
 *
 * Arguments:
 *   current_ssp — the current thread's supervisor stack pointer
 *                 (r7 at the point where all registers were saved)
 *
 * Returns:
 *   The next thread's supervisor stack pointer
 *
 * ============================================================================
 */

schedule(current_ssp: int) -> int
    /*
     * Save the current thread's stack pointer.
     * The timer ISR already saved all registers onto the supervisor
     * stack. We just need to record WHERE that saved context is
     * (i.e., what the SSP was after all the pushes).
     */
    var cur: *Task = &tasks[current_thread]
    cur.ssp = current_ssp

    // Mark current thread as ready (no longer running)
    cur.state = STATE_READY

    /*
     * Find the next runnable thread.
     * Simple round-robin: try the next thread, wrap around if needed.
     * In the future, this could check thread state (skip blocked threads)
     * and respect priorities.
     */
    var next = current_thread + 1  // start with the next thread

    // Wrap around to thread 0 if we've gone past the last thread
    if next >= thread_count
        next = 0

    // TODO: skip threads that are BLOCKED or TERMINATED
    // For now, all threads are always READY.

    // Switch to the next thread
    current_thread = next
    var nxt: *Task = &tasks[next]
    nxt.state = STATE_RUNNING

    /*
     * Return the new thread's saved SSP.
     * The timer ISR will set r7 = this value and pop all registers
     * from the new thread's stack, then RTE back to user mode.
     */
    nxt.ssp


/*
 * ============================================================================
 * kernel_main — Kernel initialization
 * ============================================================================
 *
 * Called from boot.asm after the supervisor stack is set up.
 * This function:
 *
 *   1. Creates all user threads (building their initial stack frames)
 *   2. Starts the timer (enabling preemptive scheduling)
 *   3. Launches the first thread (never returns)
 *
 * ============================================================================
 */

kernel_main()
    /*
     * Create user threads.
     *
     * Each thread gets:
     *   - An entry point (the function it starts executing)
     *   - A user stack (for the thread's own variables and calls)
     *   - A supervisor stack (for saving context during interrupts)
     *   - A name (for debugging)
     *
     * Memory layout for thread stacks (see boot.asm memory map):
     *   Thread 0: SSP top = 0x5000, USP top = 0x6000
     *   Thread 1: SSP top = 0x7000, USP top = 0x8000
     *   Thread 2: SSP top = 0x9000, USP top = 0xA000
     *   Thread 3: SSP top = 0xB000, USP top = 0xC000
     */

    // Thread 0: Task A — prints 'A' characters
    create_thread(task_a, 0x6000, 0x5000, "task_a")

    // Thread 1: Task B — prints 'B' characters
    create_thread(task_b, 0x8000, 0x7000, "task_b")

    // Thread 2: Task C — counts up and prints digits
    create_thread(task_c, 0xA000, 0x9000, "task_c")

    // Thread 3: Idle task — runs when nothing else is ready
    create_thread(idle_task, 0xC000, 0xB000, "idle")

    /*
     * Start the timer.
     *
     * Writing the interval (in milliseconds) to the timer device
     * starts periodic interrupts. Each interrupt fires the timer ISR,
     * which calls schedule() to perform a context switch.
     */
    val timer: *int = TIMER_DEVICE
    *timer = TICK_MS        // start timer: interrupt every TICK_MS ms

    /*
     * Launch the first thread.
     *
     * start_first_thread() is an assembly function that:
     *   1. Sets r7 = thread 0's saved SSP
     *   2. Pops all registers (they were set to 0 by create_thread)
     *   3. RTEs into user mode at the thread's entry point
     *
     * This function never returns. From this point on, the kernel
     * only runs inside interrupt handlers (timer ISR, trap handler).
     */
    var first: *Task = &tasks[0]
    start_first_thread(first.ssp)
