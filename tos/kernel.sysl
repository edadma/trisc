/*
 * ============================================================================
 * TOS (Tiny OS) — Kernel
 * ============================================================================
 *
 * OS primitives:
 *   - Thread data structures (TCB)
 *   - Thread creation (building initial stack frames)
 *   - Scheduler (round-robin)
 *
 * The application provides kernel_main(), which calls create_thread()
 * for each task, starts the timer, and returns the first thread's SSP.
 * Boot assembly handles the rest (start_first_thread via RTE).
 *
 * ============================================================================
 */


/*
 * ============================================================================
 * Constants
 * ============================================================================
 */

val MAX_THREADS = 8

// Thread states
val STATE_READY      = 0
val STATE_RUNNING    = 1
val STATE_BLOCKED    = 2
val STATE_TERMINATED = 3


/*
 * ============================================================================
 * Thread Control Block (TCB)
 * ============================================================================
 *
 * The entire register context (r1-r6, USP, PC, PSR) lives on the
 * thread's supervisor stack, not in the TCB. The TCB only stores
 * the supervisor stack pointer, which points to the saved context.
 *
 * ============================================================================
 */

struct Task
    ssp: int
    state: int
    priority: int
    name: *byte


/*
 * ============================================================================
 * Kernel Global State
 * ============================================================================
 */

var tasks: [8]Task
var current_thread = 0
var thread_count = 0


/*
 * ============================================================================
 * create_thread — Create a new thread
 * ============================================================================
 *
 * Builds a fake stack frame on the thread's supervisor stack so that
 * the scheduler can "restore" it as if the thread had been preempted.
 *
 * Frame layout (same as what the timer ISR saves):
 *
 *   Offset  Contents     Value for new thread
 *   SP+0    USP          user stack top
 *   SP+8    r6           0
 *   SP+16   r5           0
 *   SP+24   r4           0
 *   SP+32   r3           0
 *   SP+40   r2           0
 *   SP+48   r1           0
 *   SP+56   PC           entry_point
 *   SP+64   PSR          0 (user mode, interrupts enabled)
 *
 * Arguments:
 *   entry_point — address of the thread's start function
 *   usp         — top of user stack (grows downward)
 *   ssp         — top of supervisor stack (grows downward)
 *   name        — pointer to a string name (for debugging)
 *
 * ============================================================================
 */

create_thread(entry_point: int, usp: int, ssp: int, name: *byte)
    var sp = ssp

    // Hardware-pushed part (bottom of frame)
    sp -= 8
    *sp = 0                 // PSR = 0 (user mode, interrupts enabled)
    sp -= 8
    *sp = entry_point       // PC = thread entry point

    // ISR-saved part (top of frame)
    sp -= 8
    *sp = 0                 // r1
    sp -= 8
    *sp = 0                 // r2
    sp -= 8
    *sp = 0                 // r3
    sp -= 8
    *sp = 0                 // r4
    sp -= 8
    *sp = 0                 // r5
    sp -= 8
    *sp = 0                 // r6

    // USP
    sp -= 8
    *sp = usp

    // Store in TCB array
    val idx = thread_count
    var t: *Task = &tasks[idx]
    t.ssp = sp
    t.state = STATE_READY
    t.priority = 0
    t.name = name
    thread_count += 1


/*
 * ============================================================================
 * schedule — Round-robin scheduler
 * ============================================================================
 *
 * Called from the timer ISR with the current thread's SSP.
 * Saves SSP, picks next runnable thread, returns its SSP.
 *
 * Arguments:
 *   current_ssp — current thread's supervisor stack pointer
 *
 * Returns:
 *   Next thread's supervisor stack pointer
 *
 * ============================================================================
 */

schedule(current_ssp: int) -> int
    var cur: *Task = &tasks[current_thread]
    cur.ssp = current_ssp
    cur.state = STATE_READY

    var next = current_thread + 1
    if next >= thread_count
        next = 0

    current_thread = next
    var nxt: *Task = &tasks[next]
    nxt.state = STATE_RUNNING
    nxt.ssp


/*
 * ============================================================================
 * first_thread_ssp — Return SSP of thread 0
 * ============================================================================
 *
 * Called by kernel_main after creating all threads, to pass to boot asm.
 *
 * ============================================================================
 */

first_thread_ssp() -> int
    var first: *Task = &tasks[0]
    first.ssp
