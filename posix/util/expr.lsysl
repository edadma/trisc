expr — evaluate expressions (POSIX)
=====================================

The `expr` utility evaluates an expression and writes the
result to standard output. Each token of the expression is a
separate command-line argument, following POSIX conventions.

Supported operators (lowest to highest precedence):

- `|` — logical OR (returns first nonzero/nonempty operand)
- `&` — logical AND (returns first operand if both nonzero)
- `=` `!=` `<` `<=` `>` `>=` — comparison (numeric if both
  are integers, otherwise lexicographic; returns 1 or 0)
- `+` `-` — addition and subtraction
- `*` `/` `%` — multiplication, division, modulo
- `STRING : REGEX` — regex match (BRE, anchored at start)
- `( expr )` — grouping

POSIX string keywords (parsed at the primary level):

- `length STRING` — returns the length of STRING
- `substr STRING POS LEN` — returns substring (1-based)
- `index STRING CHARS` — returns 1-based position of first
  char in CHARS found in STRING, or 0
- `+ TOKEN` — treats TOKEN as a string literal, suppressing
  keyword interpretation (e.g. `+ length` is the string
  `"length"`, not the keyword)

The `:` operator matches STRING against a BRE pattern,
implicitly anchored at the start (`^` is prepended). If the
pattern contains `\(...\)`, the result is the text captured
by the first group. Otherwise the result is the number of
characters matched. On no match, returns `""` (with a group)
or `"0"` (without).

Exit status: 0 if the result is nonzero/nonempty, 1 if zero
or empty, 2 on syntax or evaluation error.

Dependencies: std.process, std.io, std.string.


Imports and global state
------------------------

The parser walks through argv using a global position counter.

    import std.process.*
    import std.io.*
    import std.string.*
    import std.regex.*

    var pos: int
    var ac: int


Error handling
--------------

Any syntax or evaluation error prints a message to stderr and
exits immediately with code 2.

    err(msg: string)
        write_string(STDERR, s"expr: $msg\n")
        exit(2)


Token access
------------

The parser treats argv entries as tokens. `peek` looks ahead
without consuming; `next` consumes and returns; `eat` tries
to consume a specific token.

    peek() -> string
        if pos >= ac then ""
        else argv(pos)

    next() -> string
        if pos >= ac then err("syntax error: unexpected end of expression")

        val tok = argv(pos)

        pos++
        tok

    eat(tok: string) -> bool
        if pos < ac && equal(peek(), tok)
            pos++
            return true

        false


Numeric helpers
---------------

POSIX expr treats values as integers when possible. These
helpers detect and parse integer strings.

    is_integer(s: string) -> bool
        if length(s) == 0 then return false

        var start = 0

        if char_at(s, 0) == '-'
            if length(s) == 1 then return false

            start = 1

        for var i = start; i < length(s); i++
            val c = char_at(s, i)

            if c < '0' || c > '9' then return false

        true

    parse_int(s: string) -> i64 = to_int(s)


Comparison
----------

If both operands are valid integers, comparison is numeric.
Otherwise it falls back to lexicographic ordering.

    compare(a: string, b: string) -> int
        if is_integer(a) && is_integer(b)
            val ia = parse_int(a)
            val ib = parse_int(b)

            if ia < ib then return -1
            elif ia > ib then return 1
            else return 0

        val la = length(a)
        val lb = length(b)
        val n = if la < lb then la else lb

        for var i = 0; i < n; i++
            val ca = char_at(a, i)
            val cb = char_at(b, i)

            if ca < cb then return -1
            elif ca > cb then return 1

        if la < lb then -1
        elif la > lb then 1
        else 0


Recursive descent parser
-------------------------

Each precedence level in the grammar corresponds to one
parsing function. Lower-precedence operators sit higher in
the call tree: `parse_or` calls `parse_and`, which calls
`parse_cmp`, and so on down to `parse_primary`. This
structure ensures that tighter-binding operators are
evaluated first — exactly how precedence works in arithmetic.

The pattern for left-associative binary operators is always
the same:

1. Parse the left operand at the next-higher precedence.
2. While the current token is one of this level's operators,
   consume it, parse the right operand, and fold the result
   into `left`.

This naturally produces left-to-right evaluation.

Since `parse_primary` may encounter a parenthesized
subexpression, it calls back to `parse_expr` — creating
mutual recursion. Sysl resolves function references by name
regardless of declaration order, so no forward declaration
is needed.


### Primary: literals, keywords, and parenthesized groups

The bottom of the precedence hierarchy. A primary is one of:

- `( expr )` — parenthesized subexpression
- `length STRING` — string length
- `substr STRING POS LEN` — 1-based substring extraction
- `index STRING CHARS` — position of first matching char
- `+ TOKEN` — suppress keyword interpretation, treat as
  literal string
- a bare token — string or integer literal

Note that in POSIX expr, there are no unary operators — `-3`
is just the token `"-3"`, not unary minus applied to `3`.

The `+` prefix is how POSIX expr escapes keywords. Without
it, `expr length` would be a syntax error (missing operand
to `length`). With `expr + length`, the string `"length"` is
treated as a literal value.

    parse_primary() -> string
        val tok = peek()

        tok match
            "(" ->
                val _ = next()
                val result = parse_expr()

                if !eat(")") then err("syntax error: missing ')'")

                return result
            "+" ->
                val _ = next()

                if equal(peek(), "") then err("syntax error: missing operand after '+'")

                return next()
            "length" ->
                val _ = next()
                val s = parse_primary()

                return from_int(i64(length(s)))
            "substr" ->
                val _ = next()
                val s = parse_primary()
                val p = parse_primary()
                val n = parse_primary()

                if !is_integer(p) || !is_integer(n) then err("non-integer argument to substr")

                val start = int(parse_int(p))
                val count = int(parse_int(n))

                if start < 1 || count < 0 then return ""

                return substr(s, start - 1, count)
            "index" ->
                val _ = next()
                val s = parse_primary()
                val chars = parse_primary()

                for var i = 0; i < length(s); i++
                    val c = char_at(s, i)

                    for var j = 0; j < length(chars); j++
                        if c == char_at(chars, j) then return from_int(i64(i + 1))

                return "0"
            "" -> err("syntax error: missing operand")
            _ -> return next()


### Match: `STRING : REGEX`

The `:` operator has higher precedence than `*`/`/`/`%`.
It matches the left operand (a string) against the right
operand (a BRE pattern), with an implicit `^` anchor.

If the pattern contains `\(...\)`, the result is the text
of the first capture group. Otherwise it is the number of
characters in the match. On failure, the result is `""` (if
a group exists) or `"0"`.

    parse_match() -> string
        var left = parse_primary()

        while equal(peek(), ":")
            val _ = next()
            val pattern = next()

            /* Prepend ^ for implicit start anchor */
            val anchored = s"^$pattern"
            val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre(anchored)

            if parse_err then err("invalid regular expression")

            val insts = compile(root, nodes, n_groups)
            val m = exec(insts, classes, left, n_groups)

            if n_groups > 0
                /* Has capture group — return captured text or "" */
                if m.matched()
                    val s, en = m.group(1)

                    if s >= 0
                        left = substr(left, s, en - s)
                    else
                        left = ""
                else
                    left = ""
            else
                /* No capture — return character count or "0" */
                if m.matched()
                    val _, en = m.group(0)

                    left = from_int(i64(en))
                else
                    left = "0"

        left


### Multiplicative: `*`, `/`, `%`

Both operands must be integers — POSIX expr has no
floating-point support. Division by zero is a hard error
(exit 2), not a special return value.

    parse_mul() -> string
        var left = parse_match()

        while equal(peek(), "*") || equal(peek(), "/") || equal(peek(), "%")
            val op = next()
            val right = parse_primary()

            if !is_integer(left) || !is_integer(right) then err("non-integer argument")

            val a = parse_int(left)
            val b = parse_int(right)

            left = op match
                "*" -> from_int(a * b)
                "/" ->
                    if b == 0 then err("division by zero")

                    from_int(a / b)
                _ ->
                    if b == 0 then err("division by zero")

                    from_int(a % b)

        left


### Additive: `+`, `-`

Same structure as multiplicative, one step lower in
precedence. The `while` loop handles chains like
`1 + 2 + 3` left-to-right.

    parse_add() -> string
        var left = parse_mul()

        while equal(peek(), "+") || equal(peek(), "-")
            val op = next()
            val right = parse_mul()

            if !is_integer(left) || !is_integer(right) then err("non-integer argument")

            val a = parse_int(left)
            val b = parse_int(right)

            left = op match
                "+" -> from_int(a + b)
                _ -> from_int(a - b)

        left


### Comparison: `=`, `!=`, `<`, `<=`, `>`, `>=`

Comparisons are not chainable in POSIX expr — at most one
comparison operator is consumed. If both operands parse as
integers, comparison is numeric; otherwise it is
lexicographic. The result is always "1" (true) or "0"
(false).

This is where `compare()` earns its keep: the caller just
checks the sign of the return value against the operator,
without caring whether the comparison was numeric or string.

    parse_cmp() -> string
        var left = parse_add()
        val op = peek()

        if equal(op, "=") || equal(op, "!=") || equal(op, "<") || equal(op, "<=") || equal(op, ">") || equal(op, ">=")
            val _ = next()
            val right = parse_add()
            val c = compare(left, right)

            val result = op match
                "="  -> c == 0
                "!=" -> c != 0
                "<"  -> c < 0
                "<=" -> c <= 0
                ">"  -> c > 0
                _    -> c >= 0

            left = if result then "1" else "0"

        left


### Logical AND: `&`

POSIX semantics: if either operand is zero or the empty
string, the result is "0". Otherwise the result is the
first (left) operand. Both sides are always evaluated —
there is no short-circuit in POSIX expr's `&`.

    parse_and() -> string
        var left = parse_cmp()

        while eat("&")
            val right = parse_cmp()

            if (equal(left, "0") || equal(left, "")) || (equal(right, "0") || equal(right, ""))
                left = "0"

        left


### Logical OR: `|`

If the left operand is nonzero and nonempty, it is the
result. Otherwise the right operand is the result. Like `&`,
both sides are always evaluated.

This is useful for providing defaults:
`expr "$X" "|" "fallback"` returns `$X` if set, otherwise
`"fallback"`.

    parse_or() -> string
        var left = parse_and()

        while eat("|")
            val right = parse_and()

            if equal(left, "0") || equal(left, "")
                left = right

        left


### Entry point

The top-level expression is an OR expression — the
lowest-precedence operator.

    parse_expr() -> string = parse_or()


Main
----

Parse argv, evaluate, print result, and set exit status per
POSIX: 0 if nonzero/nonempty, 1 if zero or empty, 2+ on
error.

    main() -> int
        ac = argc()

        if ac < 1
            write_string(STDERR, "expr: missing operand\n")
            return 2

        pos = 0
        val result = parse_expr()

        if pos < ac then err("syntax error: unexpected extra tokens")

        puts(result)
        putchar(10)

        if equal(result, "0") || equal(result, "") then 1
        else 0


Tests
-----

Unit tests for the helper functions. The parser itself is
best tested end-to-end via the command line, but the numeric
and comparison helpers can be verified in isolation.


### `is_integer`

    #test
    test_is_integer_positive() -> unit
        assert(is_integer("42"), "positive int")

    #test
    test_is_integer_negative() -> unit
        assert(is_integer("-7"), "negative int")

    #test
    test_is_integer_zero() -> unit
        assert(is_integer("0"), "zero")

    #test
    test_is_integer_not_alpha() -> unit
        assert(!is_integer("abc"), "alpha not int")

    #test
    test_is_integer_empty() -> unit
        assert(!is_integer(""), "empty not int")

    #test
    test_is_integer_bare_minus() -> unit
        assert(!is_integer("-"), "bare minus not int")

    #test
    test_is_integer_mixed() -> unit
        assert(!is_integer("12x"), "mixed not int")


### `compare`

    #test
    test_compare_numeric_equal() -> unit
        assert(compare("42", "42") == 0, "equal")

    #test
    test_compare_numeric_less() -> unit
        assert(compare("3", "10") < 0, "3 < 10 numerically")

    #test
    test_compare_numeric_greater() -> unit
        assert(compare("10", "3") > 0, "10 > 3 numerically")

    #test
    test_compare_string_less() -> unit
        assert(compare("abc", "def") < 0, "abc < def")

    #test
    test_compare_string_equal() -> unit
        assert(compare("hello", "hello") == 0, "equal strings")

    #test
    test_compare_mixed_uses_string() -> unit
        assert(compare("abc", "42") != 0, "mixed → string compare")


### POSIX string keywords

These test the `length`, `substr`, and `index` keywords by
calling the parsing functions directly. We set up the global
state to simulate argv, then call `parse_primary` which
handles keyword dispatch.

Since `parse_primary` reads from `argv()`, these tests must
invoke `expr` end-to-end. Instead we test the underlying
`std.string` functions that the keywords delegate to.

    #test
    test_length_empty() -> unit
        assert(length("") == 0, "empty string length")

    #test
    test_length_nonempty() -> unit
        assert(length("hello") == 5, "hello length")

    #test
    test_substr_basic() -> unit
        assert(equal(substr("hello", 1, 3), "ell"), "substr 1 3")

    #test
    test_substr_middle() -> unit
        assert(equal(substr("hello", 2, 2), "ll"), "substr 2 2")

    #test
    test_substr_past_end() -> unit
        assert(equal(substr("hi", 0, 100), "hi"), "substr past end")

    #test
    test_index_found() -> unit
        val s = "hello"
        var result = 0

        for var i = 0; i < length(s); i++
            val c = char_at(s, i)

            if c == 'e'
                result = i + 1
                break

        assert(result == 2, "e at position 2")

    #test
    test_index_not_found() -> unit
        val s = "hello"
        var result = 0

        for var i = 0; i < length(s); i++
            val c = char_at(s, i)

            if c == 'z'
                result = i + 1
                break

        assert(result == 0, "z not found")


### `:` regex match operator

These tests exercise the regex match logic by calling the
underlying `std.regex` functions directly, mirroring what
`parse_match` does.

    #test
    test_match_count_basic() -> unit
        /* "abcdef" : "abc" → 3 (three chars matched) */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^abc")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "abcdef", n_groups)

        assert(m.matched(), "should match")

        val _, en = m.group(0)

        assert(en == 3, s"matched 3 chars, got $en")

    #test
    test_match_count_star() -> unit
        /* "aabbb" : "a*" → 2 (greedy match of a's) */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^a*")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "aabbb", n_groups)

        assert(m.matched(), "should match")

        val _, en = m.group(0)

        assert(en == 2, s"matched 2 chars, got $en")

    #test
    test_match_count_no_match() -> unit
        /* "hello" : "xyz" → 0 (no match) */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^xyz")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "hello", n_groups)

        assert(!m.matched(), "should not match")

    #test
    test_match_capture_basic() -> unit
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^\\(abc\\)")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "abcdef", n_groups)

        assert(m.matched(), "should match")
        assert(n_groups == 1, "one capture group")

        val s, en = m.group(1)

        assert(s == 0, "group start")
        assert(en == 3, s"group end=3, got $en")

    #test
    test_match_capture_digits() -> unit
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^[a-z]*\\([0-9]*\\)")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "abc123def", n_groups)

        assert(m.matched(), "should match")

        val s, en = m.group(1)

        assert(s == 3, s"group start=3, got $s")
        assert(en == 6, s"group end=6, got $en")
        assert(equal(substr("abc123def", s, en - s), "123"), "captured 123")

    #test
    test_match_capture_no_match() -> unit
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^\\(xyz\\)")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "hello", n_groups)

        assert(!m.matched(), "should not match")

    #test
    test_match_dot_star() -> unit
        /* "foobar" : ".*" → 6 (matches entire string) */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^.*")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "foobar", n_groups)

        assert(m.matched(), "should match")

        val _, en = m.group(0)

        assert(en == 6, s"matched 6 chars, got $en")

    #test
    test_match_capture_path_basename() -> unit
        /* Classic use: extract filename from path */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^.*/\\(.*\\)")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "/usr/bin/cat", n_groups)

        assert(m.matched(), "should match")

        val s, en = m.group(1)

        assert(equal(substr("/usr/bin/cat", s, en - s), "cat"), "captured basename")

    #test
    test_match_capture_extension() -> unit
        /* Extract file extension */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^.*\\.\\(.*\\)")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "file.tar.gz", n_groups)

        assert(m.matched(), "should match")

        val s, en = m.group(1)

        assert(equal(substr("file.tar.gz", s, en - s), "gz"), "captured extension")

    #test
    test_match_empty_string() -> unit
        /* "" : ".*" → 0 (empty match) */
        val root, nodes, classes, n_groups, parse_err, _, _ = parse_bre("^.*")
        val insts = compile(root, nodes, n_groups)
        val m = exec(insts, classes, "", n_groups)

        assert(m.matched(), "should match empty")

        val _, en = m.group(0)

        assert(en == 0, "matched 0 chars")
