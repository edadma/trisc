/* tr — translate characters */
import std.process.*
import std.io.*
import std.string.*

/* Usage: tr string1 string2
 * Reads stdin, replaces characters in string1 with
 * corresponding characters in string2.
 */

main() -> int
    if argc() < 3
        write_str(STDERR, "tr: missing operand\n")
        return 1

    val set1 = argv(1)
    val set2 = argv(2)

    var buf: [4096]u8
    var n = read(STDIN, buf, 4096)

    while n > 0
        for i in 0..<n
            val ch = int(buf[i])

            for j in 0..<length(set1)
                if ch == char_at(set1, j)
                    if j < length(set2)
                        buf[i] = char_at(set2, j)
                    else
                        buf[i] = char_at(set2, length(set2) - 1)

                    break

        write(STDOUT, buf, n)
        n = read(STDIN, buf, 4096)

    0
