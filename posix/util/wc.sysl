/* wc — word, line, and byte count */
import std.process.*
import std.fs.*
import std.string.*

struct wc_counts
    lines: int
    words: int
    bytes: int

wc_count(content: string) -> wc_counts
    var lines = 0
    var words = 0
    val bytes = length(content)
    var in_word = false

    for var j = 0; j < bytes; j++
        val c = char_at(content, j)

        if c == '\n' then lines++

        if c == ' ' || c == '\t' || c == '\n' || c == '\r'
            in_word = false
        else if !in_word
            in_word = true
            words++

    wc_counts(lines, words, bytes)

main() -> int
    if argc() < 2
        puts("usage: wc file ...\n")
        return 1

    var total_lines = 0
    var total_words = 0
    var total_bytes = 0

    for var i = 1; i < argc(); i++
        val content = read_file(argv(i))

        if length(content) == 0 && !exists(argv(i))
            puts(s"wc: ${argv(i)}: No such file or directory\n")
            return 1

        val w = wc_count(content)
        val lines = w.lines
        val words = w.words
        val bytes = w.bytes

        puti(lines)
        putchar(' ')
        puti(words)
        putchar(' ')
        puti(bytes)
        putchar(' ')
        puts(argv(i))
        putchar('\n')

        total_lines += lines
        total_words += words
        total_bytes += bytes

    if argc() > 2
        puti(total_lines)
        putchar(' ')
        puti(total_words)
        putchar(' ')
        puti(total_bytes)
        puts(" total\n")

    0

#test
test_wc_empty() -> unit
    val w = wc_count("")

    assert(w.lines == 0, "lines")
    assert(w.words == 0, "words")
    assert(w.bytes == 0, "bytes")

#test
test_wc_one_line() -> unit
    val w = wc_count("hello world\n")

    assert(w.lines == 1, "lines")
    assert(w.words == 2, "words")
    assert(w.bytes == 12, "bytes")

#test
test_wc_multiline() -> unit
    val w = wc_count("a b\nc\n")

    assert(w.lines == 2, "lines")
    assert(w.words == 3, "words")
