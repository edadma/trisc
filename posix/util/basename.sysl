/* basename — return non-directory portion of a pathname */
import std/process.*
import std/string.*

main() -> int
    if argc() < 2
        puts("usage: basename path [suffix]\n")
        return 1

    var s = argv(1)
    val slen = length(s)

    // Strip trailing slashes
    var end = slen

    while end > 1 && char_at(s, end - 1) == '/'
        end--

    if end == 0
        puts("/\n")
        return 0

    // Find last slash
    var start = end - 1

    while start > 0 && char_at(s, start - 1) != '/'
        start--

    var result = substr(s, start, end - start)

    // Strip suffix if provided
    if argc() > 2
        val suffix = argv(2)
        val rlen = length(result)
        val suflen = length(suffix)

        if suflen < rlen && ends_with(result, suffix)
            result = substr(result, 0, rlen - suflen)

    puts(result)
    putc('\n')
    0
