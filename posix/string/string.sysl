module posix.string

import posix.ctype.{tolower}

/*
 * string.sysl — String and memory operations (<string.h>)
 *
 * Null-terminated byte string functions and raw memory operations.
 * No OS dependency — usable in bare-metal programs.
 */

/* Return the length of null-terminated string s. */
strlen(s: *byte) -> int
    var i = 0

    while s[i] != 0 do i++

    i

/* Compare two strings. Returns <0, 0, or >0. */
strcmp(a: *byte, b: *byte) -> int
    while *a != 0 && *b != 0
        val d = int(*a) - int(*b)

        if d != 0 then return d

        a++
        b++

    int(*a) - int(*b)

/* Compare at most n bytes of two strings. */
strncmp(a: *byte, b: *byte, n: int) -> int
    var i = 0

    while i < n && *a != 0 && *b != 0
        val d = int(*a) - int(*b)

        if d != 0 then return d

        a++
        b++
        i++

    if i == n then 0
    else int(*a) - int(*b)

/* Copy src to dst, including the null terminator. */
strcpy(dst: *byte, src: *byte) -> *byte
    val ret = dst

    for var p = src; *p != 0; p++ do *dst++ = *p

    *dst = 0
    ret

/* Copy at most n bytes from src to dst, padding with nulls. */
strncpy(dst: *byte, src: *byte, n: int) -> *byte
    val ret = dst
    var i = 0

    while i < n && *src != 0
        *dst++ = *src++
        i++

    while i < n
        *dst++ = 0
        i++

    ret

/* Append src to the end of dst. */
strcat(dst: *byte, src: *byte) -> *byte
    val ret = dst

    while *dst != 0 do dst++

    for var p = src; *p != 0; p++ do *dst++ = *p

    *dst = 0
    ret

/* Append at most n bytes of src to dst. */
strncat(dst: *byte, src: *byte, n: int) -> *byte
    val ret = dst

    while *dst != 0 do dst++

    var i = 0

    while i < n && *src != 0
        *dst++ = *src++
        i++

    *dst = 0
    ret

/* Return index of first occurrence of c in s, or -1. */
strchr(s: *byte, c: int) -> int
    for var i = 0; s[i] != 0; i++
        if s[i] == c then return i

    -1

/* Return index of last occurrence of c in s, or -1. */
strrchr(s: *byte, c: int) -> int
    var result = -1

    for var i = 0; s[i] != 0; i++
        if s[i] == c then result = i

    result

/* Find first occurrence of needle in haystack. Returns pointer or null. */
strstr(haystack: *byte, needle: *byte) -> *byte
    if *needle == 0 then return haystack

    while *haystack != 0
        var h = haystack
        var n = needle

        while *h != 0 && *n != 0 && *h == *n
            h++
            n++

        if *n == 0 then return haystack

        haystack++

    *byte(0)

/* Return length of initial segment of s containing only bytes in accept. */
strspn(s: *byte, accept: *byte) -> int
    var i = 0

    while s[i] != 0
        var found = false

        for var p = accept; *p != 0; p++
            if s[i] == *p
                found = true
                break

        if !found then return i

        i++

    i

/* Return length of initial segment of s containing no bytes in reject. */
strcspn(s: *byte, reject: *byte) -> int
    var i = 0

    while s[i] != 0
        for var p = reject; *p != 0; p++
            if s[i] == *p then return i

        i++

    i

/* Find first occurrence in s of any byte in accept. Returns pointer or null. */
strpbrk(s: *byte, accept: *byte) -> *byte
    while *s != 0
        for var p = accept; *p != 0; p++
            if *s == *p then return s

        s++

    *byte(0)

/* Tokenize string. First call passes the string, subsequent calls pass null. */
var _strtok_pos: *byte = *byte(0)

strtok(s: *byte, delim: *byte) -> *byte
    var p = if s != *byte(0) then s else _strtok_pos

    if p == *byte(0) then return *byte(0)

    // Skip leading delimiters
    while *p != 0
        var is_delim = false

        for var d = delim; *d != 0; d++
            if *p == *d
                is_delim = true
                break

        if !is_delim then break

        p++

    if *p == 0
        _strtok_pos = *byte(0)
        return *byte(0)

    val token = p

    // Find end of token
    while *p != 0
        for var d = delim; *d != 0; d++
            if *p == *d
                *p = 0
                _strtok_pos = p + 1
                return token

        p++

    _strtok_pos = *byte(0)
    token

/* Fill n bytes of dst with value v. */
memset(dst: *byte, v: int, n: int) -> *byte
    for i in 0..<n do dst[i] = v

    dst

/* Copy n bytes from src to dst (must not overlap). */
memcpy(dst: *byte, src: *byte, n: int) -> *byte
    for i in 0..<n do dst[i] = src[i]

    dst

/* Copy n bytes from src to dst (handles overlapping regions). */
memmove(dst: *byte, src: *byte, n: int) -> *byte
    if dst < src
        for i in 0..<n do dst[i] = src[i]
    else if dst > src
        for i in n - 1 downTo 0 do dst[i] = src[i]

    dst

/* Compare n bytes of a and b. Returns <0, 0, or >0. */
memcmp(a: *byte, b: *byte, n: int) -> int
    for i in 0..<n
        val d = int(a[i]) - int(b[i])

        if d != 0 then return d

    0

/* Find first occurrence of c in the first n bytes of s. Returns pointer or null. */
memchr(s: *byte, c: int, n: int) -> *byte
    for i in 0..<n
        if s[i] == c then return s + i

    *byte(0)

/* Search n bytes of s for c, starting from the end. */
memrchr(s: *byte, c: int, n: int) -> *byte
    var i = n

    while i > 0
        i--

        if s[i] == c then return s + i

    *byte(0)

/* Copy src to dst, guaranteeing null-termination. Returns strlen(src). */
strlcpy(dst: *byte, src: *byte, dstsize: int) -> int
    var i = 0

    if dstsize > 0
        while i < dstsize - 1 && src[i] != 0
            dst[i] = src[i]
            i++

        dst[i] = 0

    while src[i] != 0 do i++

    i

/* Append src to dst, guaranteeing null-termination. Returns strlen(dst) + strlen(src). */
strlcat(dst: *byte, src: *byte, dstsize: int) -> int
    var dlen = 0

    while dlen < dstsize && dst[dlen] != 0 do dlen++

    if dlen == dstsize then return dlen + strlen(src)

    var i = 0

    while dlen + i + 1 < dstsize && src[i] != 0
        dst[dlen + i] = src[i]
        i++

    dst[dlen + i] = 0

    while src[i] != 0 do i++

    dlen + i

/* Reverse a null-terminated string in place. Returns the string pointer. */
strrev(s: *byte) -> *byte
    var lo = 0
    var hi = strlen(s) - 1

    while lo < hi
        val t = s[lo]

        s[lo] = s[hi]
        s[hi] = t
        lo++
        hi--

    s

/* Extract a token from *stringp, delimited by any byte in delim.
 * Updates *stringp to point past the delimiter (or null if end).
 * Returns the original *stringp, or null if *stringp was null.
 */
strsep(stringp: **byte, delim: *byte) -> *byte
    val s = *stringp

    if s == *byte(0) then return *byte(0)

    var p = s

    while *p != 0
        for var d = delim; *d != 0; d++
            if *p == *d
                *p = 0
                *stringp = p + 1
                return s

        p++

    *stringp = *byte(0)
    s

/* Case-insensitive comparison of two strings. Returns <0, 0, or >0. */
strcasecmp(a: *byte, b: *byte) -> int
    var pa = a
    var pb = b

    while *pa != 0 && *pb != 0
        val d = tolower(int(*pa)) - tolower(int(*pb))

        if d != 0 then return d

        pa++
        pb++

    tolower(int(*pa)) - tolower(int(*pb))

/* Case-insensitive comparison of at most n bytes. */
strncasecmp(a: *byte, b: *byte, n: int) -> int
    for i in 0..<n
        if a[i] == 0 && b[i] == 0 then return 0

        val d = tolower(int(a[i])) - tolower(int(b[i]))

        if d != 0 then return d

        if a[i] == 0 || b[i] == 0 then return d

    0

/* Case-insensitive substring search. Returns pointer to match or null. */
strcasestr(haystack: *byte, needle: *byte) -> *byte
    if *needle == 0 then return haystack

    val nlen = strlen(needle)
    var p = haystack

    while *p != 0
        if strncasecmp(p, needle, nlen) == 0 then return p

        p++

    *byte(0)

/* Bounded strlen: return length of s, or maxlen if no NUL found within maxlen bytes. */
strnlen(s: *byte, maxlen: int) -> int
    var i = 0

    while i < maxlen && s[i] != 0 do i++

    i

/* Like strcpy but returns pointer to the NUL terminator in dst. */
stpcpy(dst: *byte, src: *byte) -> *byte
    var d = dst
    var s = src

    while *s != 0 do *d++ = *s++

    *d = 0
    d

/* Like strncpy but returns pointer to NUL or dst+n. Does NOT pad with NULs beyond the copy. */
stpncpy(dst: *byte, src: *byte, n: int) -> *byte
    var i = 0

    while i < n && src[i] != 0
        dst[i] = src[i]
        i++

    val result = dst + i

    while i < n
        dst[i] = 0
        i++

    result

/* Locale-aware string comparison. In the C locale, identical to strcmp. */
strcoll(a: *byte, b: *byte) -> int = strcmp(a, b)

/* Locale-aware string transform. In the C locale, copies at most n bytes of src to dst. */
strxfrm(dst: *byte, src: *byte, n: int) -> int
    val slen = strlen(src)

    if n > 0
        var copy = if slen < n then slen else n - 1

        for i in 0..<copy do dst[i] = src[i]

        dst[copy] = 0

    slen

/* NOTE: strdup/strndup live in posix.stdlib to avoid circular dependency
 * (posix.string ↔ posix.stdlib via memset/malloc). */

/* Reentrant strtok. Uses *saveptr instead of static state. */
strtok_r(s: *byte, delim: *byte, saveptr: **byte) -> *byte
    var p = if s != *byte(0) then s else *saveptr

    if p == *byte(0) then return *byte(0)

    /* Skip leading delimiters */
    while *p != 0
        var is_delim = false

        for var d = delim; *d != 0; d++
            if *p == *d
                is_delim = true
                break

        if !is_delim then break

        p++

    if *p == 0
        *saveptr = *byte(0)
        return *byte(0)

    val token = p

    /* Find end of token */
    while *p != 0
        for var d = delim; *d != 0; d++
            if *p == *d
                *p = 0
                *saveptr = p + 1
                return token

        p++

    *saveptr = *byte(0)
    token

/* Map error number to string. */
strerror(errnum: int) -> string
    errnum match
        0  -> "Success"
        1  -> "Operation not permitted"
        2  -> "No such file or directory"
        3  -> "No such process"
        4  -> "Interrupted system call"
        5  -> "Input/output error"
        6  -> "No such device or address"
        7  -> "Argument list too long"
        8  -> "Exec format error"
        9  -> "Bad file descriptor"
        10 -> "No child processes"
        11 -> "Resource temporarily unavailable"
        12 -> "Cannot allocate memory"
        13 -> "Permission denied"
        14 -> "Bad address"
        16 -> "Device or resource busy"
        17 -> "File exists"
        18 -> "Invalid cross-device link"
        19 -> "No such device"
        20 -> "Not a directory"
        21 -> "Is a directory"
        22 -> "Invalid argument"
        23 -> "Too many open files in system"
        24 -> "Too many open files"
        25 -> "Inappropriate ioctl for device"
        27 -> "File too large"
        28 -> "No space left on device"
        29 -> "Illegal seek"
        30 -> "Read-only file system"
        31 -> "Too many links"
        32 -> "Broken pipe"
        33 -> "Numerical argument out of domain"
        34 -> "Numerical result out of range"
        35 -> "Resource deadlock avoided"
        36 -> "File name too long"
        37 -> "No locks available"
        38 -> "Function not implemented"
        39 -> "Directory not empty"
        _  -> "Unknown error"


/* ===== Tests ===== */

/* Note: *byte functions that need NUL-terminated buffers are
 * primarily tested via the Scala test suite. The #test functions
 * below cover what's testable in the interpreter. */

#test
test_strerror_success() -> unit
    assert(strerror(0) == "Success", "errno 0")

#test
test_strerror_enoent() -> unit
    assert(strerror(2) == "No such file or directory", "ENOENT")

#test
test_strerror_eperm() -> unit
    assert(strerror(1) == "Operation not permitted", "EPERM")

#test
test_strerror_eacces() -> unit
    assert(strerror(13) == "Permission denied", "EACCES")

#test
test_strerror_enosys() -> unit
    assert(strerror(38) == "Function not implemented", "ENOSYS")

#test
test_strerror_unknown() -> unit
    assert(strerror(999) == "Unknown error", "unknown")

#test
test_memset_basic() -> unit
    var buf = new [5]byte

    memset(buf, int('x'), 5)

    for var i = 0; i < 5; i++
        assert(buf[i] == int('x'), s"byte $i is x")

#test
test_memset_zero() -> unit
    var buf = new [5]byte

    buf[0] = int('a')
    buf[1] = int('b')
    memset(buf, 0, 5)

    for var i = 0; i < 5; i++
        assert(buf[i] == 0, s"byte $i is 0")

#test
test_memcpy_basic() -> unit
    var src = new [5]byte
    var dst = new [5]byte

    src[0] = 1
    src[1] = 2
    src[2] = 3
    memcpy(dst, src, 3)
    assert(dst[0] == 1, "byte 0")
    assert(dst[1] == 2, "byte 1")
    assert(dst[2] == 3, "byte 2")

#test
test_memcmp_equal() -> unit
    var a = new [3]byte
    var b = new [3]byte

    a[0] = 1
    a[1] = 2
    a[2] = 3
    b[0] = 1
    b[1] = 2
    b[2] = 3
    assert(memcmp(a, b, 3) == 0, "equal")

#test
test_memcmp_less() -> unit
    var a = new [3]byte
    var b = new [3]byte

    a[0] = 1
    a[1] = 2
    b[0] = 1
    b[1] = 3
    assert(memcmp(a, b, 2) < 0, "a < b")

#test
test_memchr_found() -> unit
    var buf = new [5]byte

    buf[0] = int('a')
    buf[1] = int('b')
    buf[2] = int('c')
    val p = memchr(buf, int('b'), 3)
    assert(p != *byte(0), "found")

#test
test_memchr_not_found() -> unit
    var buf = new [3]byte

    buf[0] = int('a')
    buf[1] = int('b')
    buf[2] = int('c')
    assert(memchr(buf, int('z'), 3) == *byte(0), "not found")
