module posix.math

/*
 * math.sysl — Floating-point math operations (<math.h>)
 *
 * Hardware-backed via TRISC float instructions where available.
 * No OS dependency — usable in bare-metal programs.
 */

val PI = 3.14159265358979323846
val LN2 = 0.69314718055994530942
val LN10 = 2.30258509299404568402
val E = 2.71828182845904523536
val HUGE_VAL = 1.0e308

/* Test whether x is NaN. NaN is the only value not equal to itself. */
isnan(x: double) -> int = int(x != x)

/* Test whether x is positive or negative infinity. */
isinf(x: double) -> int = int(x == 1.0e308 * 10.0 || x == -1.0e308 * 10.0)

/* Test whether x is finite (not NaN and not infinity). */
isfinite(x: double) -> int = int(isnan(x) == 0 && isinf(x) == 0)

/* Return 1 if x is negative (including -0.0), 0 otherwise. */
signbit(x: double) -> int
    if x < 0.0 then 1
    elif x == 0.0 && 1.0 / x < 0.0 then 1
    else 0

/* Return the absolute value of x. */
fabs(x: double) -> double = asm("fabs r1, r1")

/* Return the smaller of a and b. */
fmin(a: double, b: double) -> double = if a < b then a else b

/* Return the larger of a and b. */
fmax(a: double, b: double) -> double = if a > b then a else b

/* Return the square root of x. */
sqrt(x: double) -> double = asm("fsqrt r1, r1")

/* Truncate x toward zero. */
trunc(x: double) -> double = double(int(x))

/* Round x toward negative infinity. */
floor(x: double) -> double
    val t = trunc(x)

    if x < 0.0 && t != x then t - 1.0
    else t

/* Round x toward positive infinity. */
ceil(x: double) -> double
    val t = trunc(x)

    if x > 0.0 && t != x then t + 1.0
    else t

/* Round x to the nearest integer, halfway cases away from zero. */
round(x: double) -> double
    if x >= 0.0 then floor(x + 0.5)
    else ceil(x - 0.5)

/* Return the floating-point remainder of x / y. */
fmod(x: double, y: double) -> double = x - trunc(x / y) * y

/* Copy the sign of y onto the magnitude of x. */
copysign(x: double, y: double) -> double
    val mag = fabs(x)

    if y < 0.0 then -mag
    else mag

/* Return x raised to the power y. */
fpow(x: double, y: double) -> double
    asm("addi r2, r5, 24")
    asm("ldd r2, r2, r0")
    asm("fpow r1, r2")

/* Return the sine of x (radians). */
sin(x: double) -> double = asm("fsin r1, r1")

/* Return the cosine of x (radians). */
cos(x: double) -> double = asm("fcos r1, r1")

/* Return the tangent of x (radians). */
tan(x: double) -> double = asm("ftan r1, r1")

/* Return the arc sine of x. Result in [-pi/2, pi/2]. */
asin(x: double) -> double = asm("fasin r1, r1")

/* Return the arc cosine of x. Result in [0, pi]. */
acos(x: double) -> double = asm("facos r1, r1")

/* Return the arc tangent of x. Result in [-pi/2, pi/2]. */
atan(x: double) -> double = asm("fatan r1, r1")

/* Return the arc tangent of y/x, using signs to determine quadrant. Result in [-pi, pi]. */
atan2(y: double, x: double) -> double
    asm("addi r2, r5, 24")
    asm("ldd r2, r2, r0")
    asm("fatan2 r1, r2")

/* Return e raised to the power x. */
exp(x: double) -> double = asm("fexp r1, r1")

/* Return the natural logarithm of x. */
log(x: double) -> double = asm("flog r1, r1")

/* Return 2 raised to the power x. */
exp2(x: double) -> double = exp(x * LN2)

/* Return the base-2 logarithm of x. */
log2(x: double) -> double = log(x) / LN2

/* Return the base-10 logarithm of x. */
log10(x: double) -> double = log(x) / LN10

/* Return the hyperbolic sine of x. */
sinh(x: double) -> double
    val ex = exp(x)

    (ex - 1.0 / ex) / 2.0

/* Return the hyperbolic cosine of x. */
cosh(x: double) -> double
    val ex = exp(x)

    (ex + 1.0 / ex) / 2.0

/* Return the hyperbolic tangent of x. */
tanh(x: double) -> double
    val ex = exp(x)
    val emx = 1.0 / ex

    (ex - emx) / (ex + emx)

/* Split x into normalized fraction and exponent.
 * Returns the fraction f where 0.5 <= |f| < 1.0.
 * Stores the exponent in *exp such that x = f * 2^exp. */
frexp(x: double, e: *int) -> double
    if x == 0.0
        *e = 0
        return 0.0

    var m = fabs(x)
    var n = 0

    while m >= 1.0
        m /= 2.0
        n++

    while m < 0.5
        m *= 2.0
        n--

    *e = n

    if x < 0.0 then -m
    else m

/* Return x * 2^n. */
ldexp(x: double, n: int) -> double
    var result = x

    if n >= 0
        for var i = 0; i < n; i++
            result *= 2.0
    else
        for var i = 0; i < -n; i++
            result /= 2.0

    result

/* Split x into integer and fractional parts.
 * Returns the fractional part. Stores the integer part in *iptr. */
modf(x: double, iptr: *double) -> double
    val t = trunc(x)

    *iptr = t
    x - t
