module posix.limits

/*
 * limits.sysl — Implementation-defined constants (<limits.h>)
 *
 * Numeric limits for integer types on TRISC (64-bit registers, big-endian).
 */

/* Signed 8-bit */
val I8_MIN = -128
val I8_MAX = 127

/* Unsigned 8-bit */
val U8_MAX = 255
val BYTE_MAX = 255

/* Signed 16-bit */
val I16_MIN = -32768
val I16_MAX = 32767

/* Unsigned 16-bit */
val U16_MAX = 65535

/* Signed 32-bit (int) */
val INT_MIN = -2147483648
val INT_MAX = 2147483647
val I32_MIN = -2147483648
val I32_MAX = 2147483647

/* Unsigned 32-bit (char) */
val U32_MAX = 4294967295i64
val CHAR_MAX = 4294967295i64

/* Signed 64-bit */
val I64_MIN = -9223372036854775807i64 - 1i64
val I64_MAX = 9223372036854775807i64

/* Path and name limits */
val PATH_MAX = 4096
val NAME_MAX = 255
