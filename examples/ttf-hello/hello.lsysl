TTF Hello World — renders anti-aliased text on the framebuffer using
Monaco 16px font data generated by the fonts tool.

  DISPLAY_CTRL = 0xFF06
  FB_BASE = 0x10000
  FB_WIDTH = 640
  FB_HEIGHT = 480
  FONT_CELL_W = 10
  FONT_CELL_H = 16
  FONT_FIRST = 32
  FONT_LAST = 126
  FONT_COUNT = 95

  dc_write(offset: int, v: int)
      p: *i8 = *i8(DISPLAY_CTRL + offset)
      *p = byte(v)

  init_fb()
      dc_write(0, 1)
      dc_write(2, FB_WIDTH >> 8)
      dc_write(3, FB_WIDTH & 0xFF)
      dc_write(4, FB_HEIGHT >> 8)
      dc_write(5, FB_HEIGHT & 0xFF)
      dc_write(1, 1)

  // Set a pixel with alpha blending (text color over black background)
  set_pixel(x: int, y: int, r: int, g: int, b: int, a: int)
      if x >= 0 && x < FB_WIDTH && y >= 0 && y < FB_HEIGHT
          offset = (y * FB_WIDTH + x) * 4
          p: *i8 = *i8(FB_BASE + offset)
          // Blend: out = color * alpha / 255
          *p = byte(r * a / 255)
          p = p + 1
          *p = byte(g * a / 255)
          p = p + 1
          *p = byte(b * a / 255)
          p = p + 1
          *p = byte(a)

  // Draw a single character at pixel position (x, y) with color (r, g, b)
  draw_char(x: int, y: int, ch: int, r: int, g: int, b: int)
      if ch < FONT_FIRST || ch > FONT_LAST then return
      idx = ch - FONT_FIRST
      base = idx * FONT_CELL_W * FONT_CELL_H
      for row = 0; row < FONT_CELL_H; row++
          for col = 0; col < FONT_CELL_W; col++
              a = font_data[base + row * FONT_CELL_W + col]
              if a > 0
                  set_pixel(x + col, y + row, r, g, b, a)

  // Draw a string at pixel position (x, y)
  draw_text(x: int, y: int, s: *byte, len: int, r: int, g: int, b: int)
      for i = 0; i < len; i++
          draw_char(x + i * FONT_CELL_W, y, s[i], r, g, b)

  main() -> int
      init_fb()

      // "Hello World!" as byte array
      msg: [12]byte = [72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 33]

      // White text centered
      draw_text(220, 220, msg, 12, 255, 255, 255)

      // Green text
      draw_text(220, 250, msg, 12, 0, 255, 100)

      // Cyan text
      draw_text(220, 280, msg, 12, 100, 200, 255)

      // Yellow text, larger offset
      draw_text(220, 310, msg, 12, 255, 230, 50)

      0

