// FizzBuzz — prints numbers 1 to 30, replacing multiples of 3 with 'F',
// multiples of 5 with 'B', and multiples of both with 'X'
main() -> int
    for i = 1; i <= 30; i++
        if i % 15 == 0 then putchar(88)       // X
        else if i % 3 == 0 then putchar(70)    // F
        else if i % 5 == 0 then putchar(66)    // B
        else if i < 10 then putchar(48 + i)    // digit
        else
            putchar(48 + i / 10)
            putchar(48 + i % 10)
        putchar(10)
    0
