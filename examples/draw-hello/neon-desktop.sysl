// Neon desktop — dark mode with glowing accents

DISPLAY_CTRL = 0x100008
DRAW_ENGINE  = 0x1000A0
FB_WIDTH  = 1440
FB_HEIGHT = 900

DE_EXEC       = 0
DE_X1         = 2
DE_Y1         = 4
DE_X2         = 6
DE_Y2         = 8
DE_R          = 10
DE_G          = 11
DE_B          = 12
DE_A          = 13
DE_LINE_W     = 14
DE_FONT_SIZE  = 20
DE_FONT_STYLE = 22
DE_CORNER_R   = 23
DE_TEXT_BUF   = 32

// Global string data
slix_path: [29]int = [101, 120, 97, 109, 112, 108, 101, 115, 47, 100, 114, 97, 119, 45, 104, 101, 108, 108, 111, 47, 115, 108, 105, 120, 46, 112, 110, 103, 0]
s_prompt: [2]int = [62, 95]
s_terminal: [8]int = [84, 101, 114, 109, 105, 110, 97, 108]
s_f: [1]int = [70]
s_files: [5]int = [70, 105, 108, 101, 115]
s_gear: [1]int = [42]
s_settings: [8]int = [83, 101, 116, 116, 105, 110, 103, 115]
s_mon: [14]int = [83, 121, 115, 116, 101, 109, 32, 77, 111, 110, 105, 116, 111, 114]
s_cpu_u: [9]int = [67, 80, 85, 32, 85, 115, 97, 103, 101]
s_cpu: [8]int = [67, 80, 85, 58, 32, 52, 50, 37]
s_mem: [11]int = [77, 101, 109, 58, 32, 50, 53, 54, 32, 77, 66]
s_thr: [11]int = [84, 104, 114, 101, 97, 100, 115, 58, 32, 49, 50]
s_up: [13]int = [85, 112, 116, 105, 109, 101, 58, 32, 48, 48, 58, 52, 50]
s_ed: [9]int = [99, 111, 100, 101, 46, 115, 121, 115, 108]
s_1: [1]int = [49]
s_2: [1]int = [50]
s_3: [1]int = [51]
s_4: [1]int = [52]
s_5: [1]int = [53]
s_6: [1]int = [54]
s_7: [1]int = [55]
s_8: [1]int = [56]
s_9: [1]int = [57]
s_import: [6]int = [105, 109, 112, 111, 114, 116]
s_tos: [5]int = [116, 111, 115, 46, 42]
s_kmain: [11]int = [107, 101, 114, 110, 101, 108, 95, 109, 97, 105, 110]
s_arrow: [6]int = [40, 41, 32, 45, 62, 32]
s_int: [3]int = [105, 110, 116]
s_create: [13]int = [99, 114, 101, 97, 116, 101, 95, 116, 104, 114, 101, 97, 100]
s_worker: [8]int = [40, 119, 111, 114, 107, 101, 114, 41]
s_timer: [10]int = [116, 105, 109, 101, 114, 95, 105, 110, 105, 116]
s_lp: [1]int = [40]
s_1000: [4]int = [49, 48, 48, 48]
s_rp: [1]int = [41]
s_first: [16]int = [102, 105, 114, 115, 116, 95, 116, 104, 114, 101, 97, 100, 95, 115, 115, 112]
s_parens: [2]int = [40, 41]
s_wfn: [6]int = [119, 111, 114, 107, 101, 114]
s_putc: [4]int = [112, 117, 116, 99]
s_charH: [3]int = [39, 72, 39]
s_sleep: [5]int = [115, 108, 101, 101, 112]
s_10: [2]int = [49, 48]
s_banner1: [12]int = [83, 76, 73, 88, 32, 79, 83, 32, 118, 48, 46, 49]
s_banner2: [18]int = [84, 82, 73, 83, 67, 32, 67, 80, 85, 32, 64, 32, 49, 48, 48, 77, 72, 122]
s_user: [9]int = [114, 111, 111, 116, 64, 115, 108, 105, 120]
s_sep: [4]int = [58, 126, 35, 32]
s_neofetch: [8]int = [110, 101, 111, 102, 101, 116, 99, 104]
s_os: [3]int = [79, 83, 58]
s_slix: [8]int = [83, 76, 73, 88, 32, 48, 46, 49]
s_cpul: [4]int = [67, 80, 85, 58]
s_trisc16: [12]int = [84, 82, 73, 83, 67, 32, 49, 54, 45, 98, 105, 116]
s_meml: [4]int = [77, 101, 109, 58]
s_memv: [11]int = [49, 32, 77, 66, 32, 47, 32, 52, 32, 77, 66]
s_shell: [6]int = [83, 104, 101, 108, 108, 58]
s_sh: [2]int = [115, 104]
s_S: [1]int = [83]
s_wifi: [4]int = [87, 105, 70, 105]
s_bat: [4]int = [49, 48, 48, 37]
s_clock: [5]int = [50, 51, 58, 52, 50]

dc_write(offset: int, v: int)
    p: *i8 = *i8(DISPLAY_CTRL + offset)
    *p = byte(v)

init_fb()
    dc_write(0, 1)
    dc_write(2, FB_WIDTH >> 8)
    dc_write(3, FB_WIDTH & 0xFF)
    dc_write(4, FB_HEIGHT >> 8)
    dc_write(5, FB_HEIGHT & 0xFF)
    dc_write(1, 1)

de_write8(offset: int, v: int)
    p: *i8 = *i8(DRAW_ENGINE + offset)
    *p = byte(v)

de_write16(offset: int, v: int)
    p: *i16 = *i16(DRAW_ENGINE + offset)
    *p = i16(v)

de_exec(cmd: int)
    de_write8(DE_EXEC, cmd)

de_color(r: int, g: int, b: int, a: int)
    de_write8(DE_R, r)
    de_write8(DE_G, g)
    de_write8(DE_B, b)
    de_write8(DE_A, a)

de_pos(x: int, y: int)
    de_write16(DE_X1, x)
    de_write16(DE_Y1, y)

de_size(w: int, h: int)
    de_write16(DE_X2, w)
    de_write16(DE_Y2, h)

de_font(size: int, style: int)
    de_write16(DE_FONT_SIZE, size)
    de_write8(DE_FONT_STYLE, style)

de_corner(r: int)
    de_write8(DE_CORNER_R, r)

de_text(s: *int, len: int)
    var i = 0
    while i < len
        if i >= 31 then break
        de_write8(DE_TEXT_BUF + i, s[i])
        i += 1
    de_write8(DE_TEXT_BUF + i, 0)

draw_text(x: int, y: int, s: *int, len: int, r: int, g: int, b: int)
    de_color(r, g, b, 255)
    de_pos(x, y)
    de_text(s, len)
    de_exec(0x09)

fill_rect(x: int, y: int, w: int, h: int, r: int, g: int, b: int)
    de_color(r, g, b, 255)
    de_pos(x, y)
    de_size(w, h)
    de_exec(0x10)

fill_rect_a(x: int, y: int, w: int, h: int, r: int, g: int, b: int, a: int)
    de_color(r, g, b, a)
    de_pos(x, y)
    de_size(w, h)
    de_exec(0x10)

fill_rrect_a(x: int, y: int, w: int, h: int, r: int, g: int, b: int, a: int, cr: int)
    de_color(r, g, b, a)
    de_corner(cr)
    de_pos(x, y)
    de_size(w, h)
    de_exec(0x14)

fill_rrect(x: int, y: int, w: int, h: int, r: int, g: int, b: int, cr: int)
    de_color(r, g, b, 255)
    de_corner(cr)
    de_pos(x, y)
    de_size(w, h)
    de_exec(0x14)

stroke_rrect(x: int, y: int, w: int, h: int, r: int, g: int, b: int, lw: int, cr: int)
    de_color(r, g, b, 255)
    de_corner(cr)
    de_write16(DE_LINE_W, lw)
    de_pos(x, y)
    de_size(w, h)
    de_exec(0x15)

fill_circle(cx: int, cy: int, radius: int, r: int, g: int, b: int)
    de_color(r, g, b, 255)
    de_pos(cx, cy)
    de_write16(DE_X2, radius)
    de_exec(0x06)
    de_exec(0x08)
    de_exec(0x05)

draw_line(x1: int, y1: int, x2: int, y2: int, r: int, g: int, b: int, lw: int)
    de_color(r, g, b, 255)
    de_write16(DE_LINE_W, lw)
    de_pos(x1, y1)
    de_size(x2, y2)
    de_exec(0x11)

draw_neon_window(x: int, y: int, w: int, h: int, title: *int, tlen: int, br: int, bg: int, bb: int)
    stroke_rrect(x - 2, y - 2, w + 4, h + 4, br, bg, bb, 24, 14)
    fill_rrect_a(x, y, w, h, 18, 18, 28, 230, 12)
    fill_rrect_a(x, y, w, 32, 25, 25, 38, 240, 12)
    fill_rect_a(x, y + 20, w, 12, 25, 25, 38, 240)
    draw_line(x + 12, y + 33, x + w - 12, y + 33, br, bg, bb, 16)
    de_font(12, 1)
    draw_text(x + 40, y + 22, title, tlen, 200, 200, 220)
    fill_circle(x + 16, y + 16, 5, 255, 60, 90)
    fill_circle(x + w - 28, y + 16, 5, 255, 200, 50)
    fill_circle(x + w - 14, y + 16, 5, 50, 255, 120)

main() -> int
    init_fb()

    // Background
    de_color(10, 10, 18, 255)
    de_exec(0x01)

    // Ambient glow
    fill_rrect_a(100, 200, 400, 400, 0, 255, 255, 8, 200)
    fill_rrect_a(900, 100, 500, 300, 255, 0, 200, 6, 150)
    fill_rrect_a(600, 500, 600, 400, 100, 0, 255, 5, 200)

    // SLIX logo centered on desktop
    de_text(slix_path, 28)
    de_pos(520, 250)
    de_size(400, 400)
    de_exec(0x12)

    // Desktop icons
    fill_rrect(30, 30, 56, 48, 25, 25, 40, 8)
    stroke_rrect(30, 30, 56, 48, 0, 255, 200, 16, 8)
    de_font(18, 1)
    draw_text(42, 63, s_prompt, 2, 0, 255, 200)
    de_font(10, 0)
    draw_text(30, 95, s_terminal, 8, 150, 150, 170)

    fill_rrect(30, 120, 56, 48, 25, 25, 40, 8)
    stroke_rrect(30, 120, 56, 48, 200, 100, 255, 16, 8)
    de_font(22, 1)
    draw_text(44, 153, s_f, 1, 200, 100, 255)
    de_font(10, 0)
    draw_text(38, 185, s_files, 5, 150, 150, 170)

    fill_rrect(30, 210, 56, 48, 25, 25, 40, 8)
    stroke_rrect(30, 210, 56, 48, 255, 160, 50, 16, 8)
    de_font(18, 1)
    draw_text(46, 243, s_gear, 1, 255, 160, 50)
    de_font(10, 0)
    draw_text(28, 275, s_settings, 8, 150, 150, 170)

    // Window 1: System Monitor
    draw_neon_window(120, 40, 500, 360, s_mon, 14, 0, 220, 255)
    fill_rect(135, 85, 470, 120, 12, 12, 20)
    de_font(10, 0)
    draw_text(140, 100, s_cpu_u, 9, 0, 200, 230)
    draw_line(140, 190, 200, 160, 0, 255, 220, 24)
    draw_line(200, 160, 260, 175, 0, 255, 220, 24)
    draw_line(260, 175, 320, 130, 0, 255, 220, 24)
    draw_line(320, 130, 380, 150, 0, 255, 220, 24)
    draw_line(380, 150, 440, 120, 0, 255, 220, 24)
    draw_line(440, 120, 500, 140, 0, 255, 220, 24)
    draw_line(500, 140, 560, 110, 0, 255, 220, 24)
    draw_line(560, 110, 595, 135, 0, 255, 220, 24)
    de_font(13, 0)
    draw_text(140, 230, s_cpu, 8, 0, 230, 255)
    draw_text(140, 252, s_mem, 11, 0, 230, 255)
    draw_text(140, 274, s_thr, 11, 0, 230, 255)
    draw_text(140, 296, s_up, 13, 0, 230, 255)
    fill_rect(350, 240, 150, 12, 20, 20, 35)
    fill_rect(350, 240, 95, 12, 0, 200, 230)
    fill_rect(350, 262, 150, 12, 20, 20, 35)
    fill_rect(350, 262, 60, 12, 0, 200, 230)

    // Window 2: Editor
    draw_neon_window(350, 250, 580, 380, s_ed, 9, 220, 50, 255)
    fill_rect(365, 295, 550, 320, 15, 15, 22)
    de_font(12, 0)
    draw_text(372, 315, s_1, 1, 60, 60, 80)
    draw_text(372, 335, s_2, 1, 60, 60, 80)
    draw_text(372, 355, s_3, 1, 60, 60, 80)
    draw_text(372, 375, s_4, 1, 60, 60, 80)
    draw_text(372, 395, s_5, 1, 60, 60, 80)
    draw_text(372, 415, s_6, 1, 60, 60, 80)
    draw_text(372, 435, s_7, 1, 60, 60, 80)
    draw_text(372, 455, s_8, 1, 60, 60, 80)
    draw_text(372, 475, s_9, 1, 60, 60, 80)
    draw_text(400, 315, s_import, 6, 220, 80, 255)
    draw_text(452, 315, s_tos, 5, 200, 200, 220)
    draw_text(400, 355, s_kmain, 11, 0, 220, 255)
    draw_text(496, 355, s_arrow, 6, 150, 150, 170)
    draw_text(544, 355, s_int, 3, 255, 160, 50)
    draw_text(420, 375, s_create, 13, 0, 220, 255)
    draw_text(532, 375, s_worker, 8, 200, 200, 220)
    draw_text(420, 395, s_timer, 10, 0, 220, 255)
    draw_text(507, 395, s_lp, 1, 150, 150, 170)
    draw_text(514, 395, s_1000, 4, 255, 180, 80)
    draw_text(548, 395, s_rp, 1, 150, 150, 170)
    draw_text(420, 415, s_first, 16, 0, 220, 255)
    draw_text(558, 415, s_parens, 2, 150, 150, 170)
    draw_text(400, 455, s_wfn, 6, 0, 220, 255)
    draw_text(452, 455, s_parens, 2, 150, 150, 170)
    draw_text(420, 475, s_putc, 4, 0, 220, 255)
    draw_text(454, 475, s_lp, 1, 150, 150, 170)
    draw_text(462, 475, s_charH, 3, 50, 255, 120)
    draw_text(486, 475, s_rp, 1, 150, 150, 170)
    draw_text(420, 495, s_sleep, 5, 0, 220, 255)
    draw_text(463, 495, s_lp, 1, 150, 150, 170)
    draw_text(470, 495, s_10, 2, 255, 180, 80)
    draw_text(486, 495, s_rp, 1, 150, 150, 170)
    fill_rect(400, 510, 7, 14, 220, 80, 255)

    // Window 3: Terminal
    draw_neon_window(750, 60, 560, 280, s_terminal, 8, 50, 255, 120)
    fill_rect(765, 105, 530, 220, 8, 8, 14)
    de_font(12, 0)
    draw_text(780, 125, s_banner1, 12, 50, 255, 120)
    draw_text(780, 145, s_banner2, 18, 50, 255, 120)
    draw_text(780, 175, s_user, 9, 0, 220, 255)
    draw_text(852, 175, s_sep, 4, 120, 120, 140)
    draw_text(882, 175, s_neofetch, 8, 220, 220, 240)
    draw_text(780, 200, s_os, 3, 80, 80, 100)
    draw_text(820, 200, s_slix, 8, 50, 255, 120)
    draw_text(780, 218, s_cpul, 4, 80, 80, 100)
    draw_text(820, 218, s_trisc16, 12, 220, 220, 240)
    draw_text(780, 236, s_meml, 4, 80, 80, 100)
    draw_text(820, 236, s_memv, 11, 220, 220, 240)
    draw_text(780, 254, s_shell, 6, 80, 80, 100)
    draw_text(830, 254, s_sh, 2, 220, 220, 240)
    fill_rect(780, 275, 16, 12, 40, 40, 40)
    fill_rect(800, 275, 16, 12, 200, 60, 60)
    fill_rect(820, 275, 16, 12, 60, 200, 60)
    fill_rect(840, 275, 16, 12, 200, 200, 60)
    fill_rect(860, 275, 16, 12, 60, 60, 200)
    fill_rect(880, 275, 16, 12, 200, 60, 200)
    fill_rect(900, 275, 16, 12, 60, 200, 200)
    fill_rect(920, 275, 16, 12, 200, 200, 200)
    draw_text(780, 305, s_user, 9, 0, 220, 255)
    draw_text(852, 305, s_sep, 4, 120, 120, 140)
    fill_rect(885, 295, 8, 14, 50, 255, 120)

    // Taskbar
    fill_rect_a(0, 860, FB_WIDTH, 40, 15, 15, 25, 230)
    draw_line(0, 860, FB_WIDTH, 860, 0, 200, 255, 16)
    fill_circle(30, 880, 14, 20, 20, 35)
    stroke_rrect(16, 866, 28, 28, 0, 220, 255, 20, 14)
    de_font(12, 1)
    draw_text(22, 885, s_S, 1, 0, 255, 255)
    fill_rrect_a(60, 866, 130, 28, 30, 30, 50, 200, 6)
    stroke_rrect(60, 866, 130, 28, 0, 220, 255, 16, 6)
    de_font(11, 0)
    draw_text(75, 884, s_mon, 14, 0, 220, 255)
    fill_rrect_a(200, 866, 100, 28, 30, 30, 50, 200, 6)
    stroke_rrect(200, 866, 100, 28, 220, 50, 255, 16, 6)
    draw_text(215, 884, s_ed, 9, 220, 80, 255)
    fill_rrect_a(310, 866, 110, 28, 30, 30, 50, 200, 6)
    stroke_rrect(310, 866, 110, 28, 50, 255, 120, 16, 6)
    draw_text(325, 884, s_terminal, 8, 50, 255, 120)
    draw_text(1280, 884, s_wifi, 4, 50, 255, 120)
    draw_text(1330, 884, s_bat, 4, 0, 220, 255)
    de_font(14, 1)
    draw_text(1385, 884, s_clock, 5, 0, 255, 255)

    de_exec(0x0A)
    0
