// SUIT state for the monitor window
var name_buf: [32]i8
var name_len = 0
t_greeting: [8]i8 = [72, 101, 108, 108, 111, 44, 32, 0]  // "Hello, "

// Draw SUIT UI in the monitor window
// Window position for coordinate translation
val WIN1_X = 20
val WIN1_Y = 30

t_click: [8]i8 = [67, 108, 105, 99, 107, 32, 109, 101]  // "Click me"

draw_monitor_ui(surf: int)
    ui_begin(surf, 420, 240, WIN1_X, WIN1_Y)
    ui_label(&t_cpu_u[0], 9)
    ui_label(&t_cpu[0], 8)
    ui_label(&t_mem[0], 11)
    ui_input(&name_buf[0], 31, &name_len)
    if ui_button(&t_click[0], 8) != 0
        putc('B')
    ui_end()

// Draw editor content (direct DrawEngine)
draw_editor(surf: int)
    de_target(surf)
    de_color(15, 15, 22, 255)
    ds_exec(0x01)  // CLEAR

    // Line numbers
    text(surf, 7, 20, 12, 0, &t_1[0], 1, 60, 60, 80)
    text(surf, 7, 40, 12, 0, &t_2[0], 1, 60, 60, 80)
    text(surf, 7, 60, 12, 0, &t_3[0], 1, 60, 60, 80)
    text(surf, 7, 80, 12, 0, &t_4[0], 1, 60, 60, 80)
    text(surf, 7, 100, 12, 0, &t_5[0], 1, 60, 60, 80)
    text(surf, 7, 120, 12, 0, &t_6[0], 1, 60, 60, 80)
    text(surf, 7, 140, 12, 0, &t_7[0], 1, 60, 60, 80)
    text(surf, 7, 160, 12, 0, &t_8[0], 1, 60, 60, 80)
    text(surf, 7, 180, 12, 0, &t_9[0], 1, 60, 60, 80)

    // Code
    text(surf, 35, 20, 12, 0, &t_import[0], 6, 220, 80, 255)
    text(surf, 87, 20, 12, 0, &t_tos[0], 5, 200, 200, 220)
    text(surf, 35, 60, 12, 0, &t_kmain[0], 11, 0, 220, 255)
    text(surf, 131, 60, 12, 0, &t_arrow[0], 6, 150, 150, 170)
    text(surf, 179, 60, 12, 0, &t_int[0], 3, 255, 160, 50)
    text(surf, 55, 80, 12, 0, &t_create[0], 13, 0, 220, 255)
    text(surf, 167, 80, 12, 0, &t_worker[0], 8, 200, 200, 220)
    text(surf, 55, 100, 12, 0, &t_timer[0], 10, 0, 220, 255)
    text(surf, 142, 100, 12, 0, &t_1000[0], 4, 255, 180, 80)
    text(surf, 55, 120, 12, 0, &t_sleep[0], 5, 0, 220, 255)
    text(surf, 98, 120, 12, 0, &t_1000[0], 4, 255, 180, 80)
    text(surf, 35, 160, 12, 0, &t_putc[0], 4, 0, 220, 255)
    text(surf, 69, 160, 12, 0, &t_charH[0], 3, 50, 255, 120)

    // Cursor
    fill(surf, 35, 175, 7, 14, 220, 80, 255, 255)

// Draw terminal content (direct DrawEngine)
draw_terminal(surf: int)
    de_target(surf)
    de_color(8, 8, 14, 255)
    ds_exec(0x01)  // CLEAR

    text(surf, 15, 20, 12, 0, &t_banner1[0], 12, 50, 255, 120)
    text(surf, 15, 40, 12, 0, &t_banner2[0], 18, 50, 255, 120)
    text(surf, 15, 70, 12, 0, &t_user[0], 9, 0, 220, 255)
    text(surf, 87, 70, 12, 0, &t_sep[0], 4, 120, 120, 140)
    text(surf, 117, 70, 12, 0, &t_neofetch[0], 8, 220, 220, 240)
    text(surf, 15, 95, 12, 0, &t_os[0], 3, 80, 80, 100)
    text(surf, 55, 95, 12, 0, &t_slix[0], 8, 50, 255, 120)
    text(surf, 15, 113, 12, 0, &t_cpul[0], 4, 80, 80, 100)
    text(surf, 55, 113, 12, 0, &t_trisc16[0], 12, 220, 220, 240)
    text(surf, 15, 131, 12, 0, &t_meml[0], 4, 80, 80, 100)
    text(surf, 55, 131, 12, 0, &t_memv[0], 11, 220, 220, 240)
    text(surf, 15, 149, 12, 0, &t_shell[0], 6, 80, 80, 100)
    text(surf, 65, 149, 12, 0, &t_sh[0], 2, 220, 220, 240)

    // Color blocks
    fill(surf, 15, 170, 16, 12, 40, 40, 40, 255)
    fill(surf, 35, 170, 16, 12, 200, 60, 60, 255)
    fill(surf, 55, 170, 16, 12, 60, 200, 60, 255)
    fill(surf, 75, 170, 16, 12, 200, 200, 60, 255)
    fill(surf, 95, 170, 16, 12, 60, 60, 200, 255)
    fill(surf, 115, 170, 16, 12, 200, 60, 200, 255)
    fill(surf, 135, 170, 16, 12, 60, 200, 200, 255)
    fill(surf, 155, 170, 16, 12, 200, 200, 200, 255)

    // Second prompt
    text(surf, 15, 200, 12, 0, &t_user[0], 9, 0, 220, 255)
    text(surf, 87, 200, 12, 0, &t_sep[0], 4, 120, 120, 140)
    fill(surf, 120, 190, 8, 14, 50, 255, 120, 255)

// HID scancode to ASCII (basic printable chars)
// HID scancodes: a-z = 0x04-0x1D, 1-9 = 0x1E-0x26, 0 = 0x27, space = 0x2C
// Returns 0 for non-printable
hid_to_ascii(sc: int, mods: int) -> int
    val shift = mods & 1
    if sc >= 0x04
        if sc <= 0x1D
            // a-z
            if shift != 0
                return sc - 0x04 + 65  // A-Z
            return sc - 0x04 + 97  // a-z
    if sc >= 0x1E
        if sc <= 0x26
            // 1-9
            return sc - 0x1E + 49
    if sc == 0x27
        return 48  // 0
    if sc == 0x2C
        return 32  // space
    if sc == 0x28
        return 10  // enter
    if sc == 0x2D
        return 45  // -
    if sc == 0x2E
        return 61  // =
    if sc == 0x36
        return 44  // ,
    if sc == 0x37
        return 46  // .
    if sc == 0x38
        return 47  // /
    0

// Client app — creates windows and draws content via display server IPC
app_main()
    putc('A')  // app started

    // Wait for display server port to become available
    var port = ds_connect()
    while port < 0
        yield()
        port = ds_connect()
    putc('P')  // port found

    // Create three windows via IPC — ds_create_window returns surface ID for drawing
    val surf1 = ds_create_window(20, 30, 420, 240, 3, &t_mon[0], 14)
    putc('1')
    draw_monitor_ui(surf1)
    putc('a')

    val surf2 = ds_create_window(20, 520, 500, 200, 3, &t_editor[0], 9)
    putc('2')
    draw_editor(surf2)
    putc('b')

    val surf3 = ds_create_window(880, 30, 530, 220, 3, &t_terminal[0], 8)
    putc('3')
    draw_terminal(surf3)
    putc('c')

    // Final composite to show everything
    ds_composite()
    putc('!')

    // SUIT event loop — redraw on key events and mouse release only
    var prev_mb = 0

    while true
        var dirty = 0
        val key = ds_get_key()
        if key != 0
            if _suit_focus >= 0
                ui_process_key(key, &name_buf[0], 31, &name_len)
            dirty = 1
        val mb = mouse_buttons & 1
        // Only redraw on release (when click fires), not on press
        if prev_mb != 0
            if mb == 0
                dirty = 1
        prev_mb = mb
        if dirty != 0
            draw_monitor_ui(surf1)
            ds_composite()
        else
            yield()

// Kernel entry point — boot the OS
kernel_main() -> int
    ipc_init()
    keyboard_init()
    mouse_init()

    // Display server and client at same priority (round-robin scheduling)
    create_thread_pri(server_main, 0x20000, 0x1F000, "disp", 0)
    create_thread_pri(app_main, 0x30000, 0x2F000, "app", 0)

    register_irq(TIMER_IRQ, timer_handler)
    timer_init(1000)
    first_thread_ssp()
