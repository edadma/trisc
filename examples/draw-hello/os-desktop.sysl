// OS-based windowed desktop demo
// Uses the full OS stack: kernel, IPC, display server, mouse driver
// Window creation and compositing go through IPC to the display server.
// Drawing uses direct DrawEngine register writes for performance (client-side rendering).

import oskit.kernel.*
import oskit.services.*
import oskit.ipc.*
import oskit.arch.{timer_init, timer_handler, TIMER_IRQ}
import oskit.drivers.display.*
import oskit.drivers.kbd.*
import suit.*
import oskit.drivers.mouse.*

FB_WIDTH  = 1440
FB_HEIGHT = 900

// Direct DrawEngine helpers for client-side rendering (no IPC overhead)
// Uses ds_write8/ds_write16/ds_exec from the display server module
de_color(r: int, g: int, b: int, a: int)
    ds_write8(DE_R, r)
    ds_write8(DE_G, g)
    ds_write8(DE_B, b)
    ds_write8(DE_A, a)

de_pos(x: int, y: int)
    ds_write16(DE_X1, x)
    ds_write16(DE_Y1, y)

de_sz(w: int, h: int)
    ds_write16(DE_X2, w)
    ds_write16(DE_Y2, h)

de_target(surf: int)
    ds_write8(DE_TARGET, surf)

de_text(s: *i8, len: int)
    var i = 0
    while i < len
        if i >= 31 then break
        ds_write8(DE_TEXT_BUF + i, int(s[i]))
        i += 1
    ds_write8(DE_TEXT_BUF + i, 0)

// The display server thread — boots up the graphical subsystem
server_main()
    putc('S')  // server starting
    display_server(FB_WIDTH, FB_HEIGHT)

// Drawing helpers using direct DrawEngine access
fill(surf: int, x: int, y: int, w: int, h: int, r: int, g: int, b: int, a: int)
    de_target(surf)
    de_color(r, g, b, a)
    de_pos(x, y)
    de_sz(w, h)
    ds_exec(0x10)

text(surf: int, x: int, y: int, sz: int, style: int, s: *i8, len: int, r: int, g: int, b: int)
    de_target(surf)
    de_color(r, g, b, 255)
    de_pos(x, y)
    ds_write16(DE_FONT_SIZE, sz)
    ds_write8(DE_FONT_STYLE, style)
    de_text(s, len)
    ds_exec(0x09)

