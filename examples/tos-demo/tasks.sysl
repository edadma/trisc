/*
 * TOS Demo — User tasks
 *
 * Tasks use kernel syscalls:
 *   sleep(ticks) — block for N timer ticks (100 ticks ≈ 1 second)
 *   putc(char)   — write character to stdout
 *
 * Expected output:
 *   A
 *   A
 *   B
 *   A
 *   A
 *   B
 *   ...
 */

extern sleep(ticks: int)
extern putc(ch: int)

task_a()
    while true
        putc(65)            // 'A'
        putc(10)            // newline
        sleep(100)          // ~1 second

task_b()
    while true
        putc(66)            // 'B'
        putc(10)            // newline
        sleep(200)          // ~2 seconds

idle_task()
    while true
        0                   // spin — timer preempts us
