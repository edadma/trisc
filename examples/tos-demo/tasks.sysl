/*
 * TOS Demo — User tasks
 *
 * Each task runs in user mode with its own stack.
 * The timer interrupt preempts them transparently.
 *
 * Expected output: interleaved characters like AABB0AABB1AABB2...
 */

val STDOUT = 0xFF00

putc(ch: int)
    val p: *i8 = STDOUT
    *p = ch

delay(n: int)
    var i = 0
    while i < n
        i += 1

task_a()
    while true
        putc(65)            // 'A'
        delay(2000)

task_b()
    while true
        putc(66)            // 'B'
        delay(2000)

task_c()
    var count = 0
    while true
        putc(count + 48)    // '0'-'9'
        count += 1
        if count >= 10
            count = 0
        delay(3000)

idle_task()
    while true
        asm("wfi")
