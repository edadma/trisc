/*
 * TOS Demo — Kernel initialization (application-provided)
 *
 * kernel_main() is called by boot.asm. It must:
 *   1. Create all user threads via create_thread()
 *   2. Start the timer for preemptive scheduling
 *   3. Return the first thread's SSP
 */

import "kernel"
import "tasks"

val TIMER_DEVICE = 0xFFE8
val TICK_CYCLES = 10000

kernel_main() -> int
    create_thread(task_a, 0x6000, 0x5000, "task_a")
    create_thread(task_b, 0x8000, 0x7000, "task_b")

    // Start the timer (10000 cycles per tick)
    val period: *i32 = TIMER_DEVICE
    *period = TICK_CYCLES
    val control: *i8 = TIMER_DEVICE + 4
    *control = 1

    first_thread_ssp()
