// Parser combinator exercise — with generic type aliases

enum Result[T]
    Ok(value: T, pos: int)
    Fail(pos: int)

type Parser[T] = (string, int) -> Result[T]

// === Combinators using the alias ===

map[A](p: Parser[A], f: (A) -> int) -> Parser[int]
    (input, pos) ->
        p(input, pos) match
            Ok(v, p2) -> Ok(f(v), p2)
            Fail(p2) -> Fail(p2)

alt[A](p1: Parser[A], p2: Parser[A]) -> Parser[A]
    (input, pos) ->
        p1(input, pos) match
            Ok(v, p2_pos) -> Ok(v, p2_pos)
            Fail(_) -> p2(input, pos)

// === Primitives ===

nat(input: string, pos: int) -> Result[int]
    var p = pos
    var n = 0
    var found = false
    while p < len(input) && input[p] >= '0' && input[p] <= '9'
        n = n * 10 + int(input[p]) - int('0')
        p++
        found = true
    if found then Ok(n, p) else Fail(pos)

// === Expression parser ===

parse_factor(input: string, pos: int) -> Result[int]
    if pos < len(input) && input[pos] == '('
        val v, p2 = parse_expr(input, pos + 1)?
        if p2 < len(input) && input[p2] == ')'
            Ok(v, p2 + 1)
        else Fail(p2)
    else
        nat(input, pos)

parse_term(input: string, pos: int) -> Result[int]
    var acc, cur = parse_factor(input, pos)?
    var done = false
    while !done
        if cur < len(input) && input[cur] == '*'
            val right, p3 = parse_factor(input, cur + 1)?
            acc = acc * right
            cur = p3
        elif cur < len(input) && input[cur] == '/'
            val right, p3 = parse_factor(input, cur + 1)?
            acc = acc / right
            cur = p3
        else done = true
    Ok(acc, cur)

parse_expr(input: string, pos: int) -> Result[int]
    var acc, cur = parse_term(input, pos)?
    var done = false
    while !done
        if cur < len(input) && input[cur] == '+'
            val right, p3 = parse_term(input, cur + 1)?
            acc = acc + right
            cur = p3
        elif cur < len(input) && input[cur] == '-'
            val right, p3 = parse_term(input, cur + 1)?
            acc = acc - right
            cur = p3
        else done = true
    Ok(acc, cur)

eval(s: string) -> int
    parse_expr(s, 0) match
        Ok(v, _) -> v
        Fail(_) -> -1

main() -> int
    val a = eval("2+3*4")       // 14
    val b = eval("(1+2)*3+4")   // 13
    val c = eval("100-50/2")    // 75
    a + b + c
