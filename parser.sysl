// Parser combinator exercise — builds an AST, then evaluates it
//
// Demonstrates: generic type aliases, generic combinators, def, closures,
// fluent method chaining, if-is pattern matching, ? propagation, and
// arena-allocated AST nodes.

// === Core types ===

enum Result[T]
    Ok(value: T, pos: int)
    Fail(pos: int)

type Parser[T] = (string, int) -> Result[T]

// === AST — arena-allocated node pool ===

val ND_NUM = 0
val ND_ADD = 1
val ND_SUB = 2
val ND_MUL = 3
val ND_DIV = 4

struct Node
    tag: int
    value: int      // for ND_NUM
    left: int       // node index
    right: int      // node index

var pool: [256]Node
var pool_size = 0

mk_num(v: int) -> int
    val idx = pool_size
    pool[idx] = Node(ND_NUM, v, 0, 0)
    pool_size++
    idx

mk_binop(tag: int, l: int, r: int) -> int
    val idx = pool_size
    pool[idx] = Node(tag, 0, l, r)
    pool_size++
    idx

// === AST evaluation ===

eval_node(idx: int) -> int
    val n = pool[idx]
    if n.tag == ND_NUM then n.value
    elif n.tag == ND_ADD then eval_node(n.left) + eval_node(n.right)
    elif n.tag == ND_SUB then eval_node(n.left) - eval_node(n.right)
    elif n.tag == ND_MUL then eval_node(n.left) * eval_node(n.right)
    elif n.tag == ND_DIV then eval_node(n.left) / eval_node(n.right)
    else panic("bad node tag")

// === Generic combinators ===

map[A, B](p: Parser[A], f: (A) -> B) -> Parser[B]
    (input: string, pos: int) ->
        p(input, pos) match
            Ok(v, p2) -> Ok(f(v), p2)
            Fail(p2) -> Fail(p2)

alt[A](p1: Parser[A], p2: Parser[A]) -> Parser[A]
    (input: string, pos: int) ->
        p1(input, pos) match
            Ok(v, p2) -> Ok(v, p2)
            Fail(_) -> p2(input, pos)

skip_right[A, B](p1: Parser[A], p2: Parser[B]) -> Parser[A]
    (input: string, pos: int) ->
        p1(input, pos) match
            Ok(v, p2_pos) ->
                p2(input, p2_pos) match
                    Ok(_, p3) -> Ok(v, p3)
                    Fail(fp) -> Fail(fp)
            Fail(fp) -> Fail(fp)

skip_left[A, B](p1: Parser[A], p2: Parser[B]) -> Parser[B]
    (input: string, pos: int) ->
        p1(input, pos) match
            Ok(_, p2_pos) -> p2(input, p2_pos)
            Fail(fp) -> Fail(fp)

between[A](open: Parser[int], p: Parser[A], close: Parser[int]) -> Parser[A]
    (input: string, pos: int) ->
        open(input, pos) match
            Ok(_, p2) ->
                p(input, p2) match
                    Ok(v, p3) ->
                        close(input, p3) match
                            Ok(_, p4) -> Ok(v, p4)
                            Fail(fp) -> Fail(fp)
                    Fail(fp) -> Fail(fp)
            Fail(fp) -> Fail(fp)

unwrap_or[T](r: Result[T], default: T) -> T
    r match
        Ok(v, _) -> v
        Fail(_) -> default

// === Character primitives ===

char_if(pred: (int) -> bool, input: string, pos: int) -> Result[int]
    if pos < len(input) && pred(input[pos]) then Ok(int(input[pos]), pos + 1)
    else Fail(pos)

char_exact(ch: int, input: string, pos: int) -> Result[int]
    if pos < len(input) && input[pos] == ch then Ok(ch, pos + 1)
    else Fail(pos)

// === Number parser — returns node index ===

nat(input: string, pos: int) -> Result[int]
    var p = pos
    var n = 0
    var found = false
    while p < len(input) && input[p] >= '0' && input[p] <= '9'
        n = n * 10 + int(input[p]) - int('0')
        p++
        found = true
    if found then Ok(mk_num(n), p) else Fail(pos)

// === Expression parser — builds AST, returns node index ===

parse_factor(input: string, pos: int) -> Result[int]
    if pos < len(input) && input[pos] == '('
        val node, p2 = parse_expr(input, pos + 1)?
        if p2 < len(input) && input[p2] == ')'
            Ok(node, p2 + 1)
        else Fail(p2)
    else
        nat(input, pos)

parse_term(input: string, pos: int) -> Result[int]
    var left, cur = parse_factor(input, pos)?
    var done = false
    while !done
        if cur < len(input) && input[cur] == '*'
            val right, p3 = parse_factor(input, cur + 1)?
            left = mk_binop(ND_MUL, left, right)
            cur = p3
        elif cur < len(input) && input[cur] == '/'
            val right, p3 = parse_factor(input, cur + 1)?
            left = mk_binop(ND_DIV, left, right)
            cur = p3
        else done = true
    Ok(left, cur)

parse_expr(input: string, pos: int) -> Result[int]
    var left, cur = parse_term(input, pos)?
    var done = false
    while !done
        if cur < len(input) && input[cur] == '+'
            val right, p3 = parse_term(input, cur + 1)?
            left = mk_binop(ND_ADD, left, right)
            cur = p3
        elif cur < len(input) && input[cur] == '-'
            val right, p3 = parse_term(input, cur + 1)?
            left = mk_binop(ND_SUB, left, right)
            cur = p3
        else done = true
    Ok(left, cur)

// === High-level API ===

eval_str(s: string) -> int
    pool_size = 0
    if parse_expr(s, 0) is Ok(root, _) then eval_node(root) else -1

// === Wrapper struct with methods for fluent chaining ===

struct P
    run: Parser[int]

P.map_to(f: (int) -> int) -> P = P(map(self.run, f))
P.or(other: P) -> P = P(alt(self.run, other.run))
P.skip_r(other: P) -> P = P(skip_right(self.run, other.run))
P.skip_l(other: P) -> P = P(skip_left(self.run, other.run))
P.between(open: P, close: P) -> P = P(between(open.run, self.run, close.run))
P.parse(input: string, pos: int) -> Result[int] = self.run(input, pos)

def p_nat = P(nat)
def p_char(ch: int) -> P = P((input: string, pos: int) -> char_exact(ch, input, pos))

// === Tests: AST construction + evaluation ===

#test
test_num() -> unit
    assert(eval_str("42") == 42, "number")

#test
test_add() -> unit
    assert(eval_str("2+3") == 5, "addition")

#test
test_precedence() -> unit
    assert(eval_str("2+3*4") == 14, "mul before add")

#test
test_parens() -> unit
    assert(eval_str("(1+2)*3+4") == 13, "parens override precedence")

#test
test_sub_div() -> unit
    assert(eval_str("100-50/2") == 75, "sub and div")

#test
test_nested_parens() -> unit
    assert(eval_str("((2+3))") == 5, "nested parens")

#test
test_complex() -> unit
    assert(eval_str("(2+3)*(4-1)") == 15, "complex expression")

#test
test_fail() -> unit
    assert(eval_str("") == -1, "empty string fails")

// === Tests: AST structure ===

#test
test_ast_num_node() -> unit
    pool_size = 0
    val idx = mk_num(7)
    assert(pool[idx].tag == ND_NUM, "num tag")
    assert(pool[idx].value == 7, "num value")

#test
test_ast_binop_node() -> unit
    pool_size = 0
    val l = mk_num(3)
    val r = mk_num(4)
    val idx = mk_binop(ND_ADD, l, r)
    assert(pool[idx].tag == ND_ADD, "add tag")
    assert(pool[idx].left == l, "left child")
    assert(pool[idx].right == r, "right child")

#test
test_ast_tree_eval() -> unit
    pool_size = 0
    // Build: (2 + 3) * 4
    val two = mk_num(2)
    val three = mk_num(3)
    val sum = mk_binop(ND_ADD, two, three)
    val four = mk_num(4)
    val product = mk_binop(ND_MUL, sum, four)
    assert(eval_node(product) == 20, "manual tree eval")

#test
test_pool_reset() -> unit
    pool_size = 0
    mk_num(1)
    mk_num(2)
    assert(pool_size == 2, "pool grew")
    pool_size = 0
    mk_num(99)
    assert(pool_size == 1, "pool reset")
    assert(pool[0].value == 99, "reused slot")

// === Tests: combinator primitives ===

is_digit(ch: int) -> bool = ch >= '0' && ch <= '9'
to_digit(ch: int) -> int = ch - int('0')

digit(input: string, pos: int) -> Result[int]
    char_if(is_digit, input, pos) match
        Ok(ch, p2) -> Ok(to_digit(ch), p2)
        Fail(fp) -> Fail(fp)

parse_a(input: string, pos: int) -> Result[int] = char_exact(int('a'), input, pos)
parse_b(input: string, pos: int) -> Result[int] = char_exact(int('b'), input, pos)
def parse_a_or_b = alt(parse_a, parse_b)

negate_node(idx: int) -> int = mk_binop(ND_SUB, mk_num(0), idx)
def parse_neg = map(nat, negate_node)

open_paren(input: string, pos: int) -> Result[int] = char_exact(int('('), input, pos)
close_paren(input: string, pos: int) -> Result[int] = char_exact(int(')'), input, pos)
def parse_parens = between(open_paren, nat, close_paren)

#test
test_digit() -> unit
    digit("5abc", 0) match
        Ok(v, p) ->
            assert(v == 5, "digit value")
            assert(p == 1, "digit pos")
        Fail(_) -> panic("expected Ok")

#test
test_alt_first() -> unit
    if parse_a_or_b("abc", 0) is Ok(v, _) then assert(v == int('a'), "alt first")
    else panic("expected Ok")

#test
test_alt_second() -> unit
    if parse_a_or_b("bcd", 0) is Ok(v, _) then assert(v == int('b'), "alt second")
    else panic("expected Ok")

#test
test_alt_fail() -> unit
    if parse_a_or_b("xyz", 0) is Ok(_, _) then panic("expected Fail")

#test
test_map_negate() -> unit
    pool_size = 0
    pool_size = 0
    if parse_neg("42", 0) is Ok(idx, _) then assert(eval_node(idx) == -42, "map negate")
    else panic("expected Ok")

#test
test_between_parens() -> unit
    pool_size = 0
    parse_parens("(99)", 0) match
        Ok(idx, p) ->
            assert(eval_node(idx) == 99, "between value")
            assert(p == 4, "between consumed all")
        Fail(_) -> panic("expected Ok")

#test
test_between_missing_close() -> unit
    pool_size = 0
    if parse_parens("(99", 0) is Ok(_, _) then panic("expected Fail")

#test
test_unwrap_or_ok() -> unit
    val r: Result[int] = Ok(42, 0)
    assert(unwrap_or(r, -1) == 42, "unwrap_or on Ok")

#test
test_unwrap_or_fail() -> unit
    val r: Result[int] = Fail(0)
    assert(unwrap_or(r, -1) == -1, "unwrap_or on Fail")

// === Tests: fluent API ===

double_node(idx: int) -> int = mk_binop(ND_ADD, idx, idx)

#test
test_fluent_map() -> unit
    pool_size = 0
    p_nat.map_to(double_node).parse("3", 0) match
        Ok(idx, _) -> assert(eval_node(idx) == 6, "fluent map: 3+3=6")
        Fail(_) -> panic("expected Ok")

#test
test_fluent_or() -> unit
    p_char(int('x')).or(p_char(int('y'))).parse("y!", 0) match
        Ok(v, _) -> assert(v == int('y'), "fluent or")
        Fail(_) -> panic("expected Ok")

#test
test_fluent_between() -> unit
    pool_size = 0
    p_nat.between(p_char(int('(')), p_char(int(')'))).parse("(55)", 0) match
        Ok(idx, p2) ->
            assert(eval_node(idx) == 55, "fluent between value")
            assert(p2 == 4, "fluent between pos")
        Fail(_) -> panic("expected Ok")

#test
test_fluent_chain() -> unit
    pool_size = 0
    p_nat.map_to(negate_node).or(p_char(int('?'))).parse("7", 0) match
        Ok(idx, _) -> assert(eval_node(idx) == -7, "fluent chain")
        Fail(_) -> panic("expected Ok")

main() -> int
    val a = eval_str("2+3*4")       // 14
    val b = eval_str("(1+2)*3+4")   // 13
    val c = eval_str("100-50/2")    // 75
    a + b + c
