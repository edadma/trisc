// Parser combinator exercise — generic type aliases + generic combinators

enum Result[T]
    Ok(value: T, pos: int)
    Fail(pos: int)

type Parser[T] = (string, int) -> Result[T]

// === Generic combinators ===

map[A, B](p: Parser[A], f: (A) -> B) -> Parser[B]
    (input: string, pos: int) ->
        p(input, pos) match
            Ok(v, p2) -> Ok(f(v), p2)
            Fail(p2) -> Fail(p2)

alt[A](p1: Parser[A], p2: Parser[A]) -> Parser[A]
    (input: string, pos: int) ->
        p1(input, pos) match
            Ok(v, p2) -> Ok(v, p2)
            Fail(_) -> p2(input, pos)

// skip_right: run two parsers, keep left result
skip_right[A, B](p1: Parser[A], p2: Parser[B]) -> Parser[A]
    (input: string, pos: int) ->
        p1(input, pos) match
            Ok(v, p2_pos) ->
                p2(input, p2_pos) match
                    Ok(_, p3) -> Ok(v, p3)
                    Fail(fp) -> Fail(fp)
            Fail(fp) -> Fail(fp)

// skip_left: run two parsers, keep right result
skip_left[A, B](p1: Parser[A], p2: Parser[B]) -> Parser[B]
    (input: string, pos: int) ->
        p1(input, pos) match
            Ok(_, p2_pos) -> p2(input, p2_pos)
            Fail(fp) -> Fail(fp)

// between: parse surrounded value (e.g., parenthesized expression)
between[A](open: Parser[int], p: Parser[A], close: Parser[int]) -> Parser[A]
    (input: string, pos: int) ->
        open(input, pos) match
            Ok(_, p2) ->
                p(input, p2) match
                    Ok(v, p3) ->
                        close(input, p3) match
                            Ok(_, p4) -> Ok(v, p4)
                            Fail(fp) -> Fail(fp)
                    Fail(fp) -> Fail(fp)
            Fail(fp) -> Fail(fp)

// unwrap_or: extract value or default
unwrap_or[T](r: Result[T], default: T) -> T
    r match
        Ok(v, _) -> v
        Fail(_) -> default

// === Character primitives ===

char_if(pred: (int) -> bool, input: string, pos: int) -> Result[int]
    if pos < len(input) && pred(input[pos]) then Ok(int(input[pos]), pos + 1)
    else Fail(pos)

char_exact(ch: int, input: string, pos: int) -> Result[int]
    if pos < len(input) && input[pos] == ch then Ok(ch, pos + 1)
    else Fail(pos)

// === Number parser ===

nat(input: string, pos: int) -> Result[int]
    var p = pos
    var n = 0
    var found = false
    while p < len(input) && input[p] >= '0' && input[p] <= '9'
        n = n * 10 + int(input[p]) - int('0')
        p++
        found = true
    if found then Ok(n, p) else Fail(pos)

// === Expression parser using ? propagation ===

parse_factor(input: string, pos: int) -> Result[int]
    if pos < len(input) && input[pos] == '('
        val v, p2 = parse_expr(input, pos + 1)?
        if p2 < len(input) && input[p2] == ')'
            Ok(v, p2 + 1)
        else Fail(p2)
    else
        nat(input, pos)

parse_term(input: string, pos: int) -> Result[int]
    var acc, cur = parse_factor(input, pos)?
    var done = false
    while !done
        if cur < len(input) && input[cur] == '*'
            val right, p3 = parse_factor(input, cur + 1)?
            acc = acc * right
            cur = p3
        elif cur < len(input) && input[cur] == '/'
            val right, p3 = parse_factor(input, cur + 1)?
            acc = acc / right
            cur = p3
        else done = true
    Ok(acc, cur)

parse_expr(input: string, pos: int) -> Result[int]
    var acc, cur = parse_term(input, pos)?
    var done = false
    while !done
        if cur < len(input) && input[cur] == '+'
            val right, p3 = parse_term(input, cur + 1)?
            acc = acc + right
            cur = p3
        elif cur < len(input) && input[cur] == '-'
            val right, p3 = parse_term(input, cur + 1)?
            acc = acc - right
            cur = p3
        else done = true
    Ok(acc, cur)

eval_expr(s: string) -> int
    unwrap_or(parse_expr(s, 0), -1)

// === Combinator-based parsers using def ===

// Parse a digit using char_if + map
is_digit(ch: int) -> bool = ch >= '0' && ch <= '9'
to_digit(ch: int) -> int = ch - int('0')

digit(input: string, pos: int) -> Result[int]
    char_if(is_digit, input, pos) match
        Ok(ch, p2) -> Ok(to_digit(ch), p2)
        Fail(fp) -> Fail(fp)

// Parse 'a' or 'b' using alt + def
parse_a(input: string, pos: int) -> Result[int] = char_exact(int('a'), input, pos)
parse_b(input: string, pos: int) -> Result[int] = char_exact(int('b'), input, pos)
def parse_a_or_b = alt(parse_a, parse_b)

// Parse number, negate with map + def
negate(x: int) -> int = 0 - x
def parse_neg = map(nat, negate)

// Parse parenthesized expression using between + def
open_paren(input: string, pos: int) -> Result[int] = char_exact(int('('), input, pos)
close_paren(input: string, pos: int) -> Result[int] = char_exact(int(')'), input, pos)
def parse_parens = between(open_paren, nat, close_paren)

// === Wrapper struct with methods for fluent chaining ===

struct P
    run: Parser[int]

P.map_to(f: (int) -> int) -> P = P(map(self.run, f))
P.or(other: P) -> P = P(alt(self.run, other.run))
P.skip_r(other: P) -> P = P(skip_right(self.run, other.run))
P.skip_l(other: P) -> P = P(skip_left(self.run, other.run))
P.between(open: P, close: P) -> P = P(between(open.run, self.run, close.run))
P.parse(input: string, pos: int) -> Result[int] = self.run(input, pos)

// Fluent constructors
def p_nat = P(nat)
def p_char(ch: int) -> P = P((input: string, pos: int) -> char_exact(ch, input, pos))

// === Fluent API tests ===

triple(x: int) -> int = x * 3
negate2(x: int) -> int = 0 - x

#test
test_fluent_map() -> unit
    p_nat.map_to(triple).parse("14", 0) match
        Ok(v, _) -> assert(v == 42, "fluent map")
        Fail(_) -> panic("expected Ok")

#test
test_fluent_or() -> unit
    p_char(int('x')).or(p_char(int('y'))).parse("y!", 0) match
        Ok(v, _) -> assert(v == int('y'), "fluent or")
        Fail(_) -> panic("expected Ok")

#test
test_fluent_between() -> unit
    p_nat.between(p_char(int('(')), p_char(int(')'))).parse("(55)", 0) match
        Ok(v, p2) ->
            assert(v == 55, "fluent between value")
            assert(p2 == 4, "fluent between pos")
        Fail(_) -> panic("expected Ok")

#test
test_fluent_chain() -> unit
    p_nat.map_to(negate2).or(p_char(int('?'))).parse("7", 0) match
        Ok(v, _) -> assert(v == -7, "fluent chain")
        Fail(_) -> panic("expected Ok")

// === Tests ===

#test
test_eval_simple() -> unit
    assert(eval_expr("42") == 42, "simple number")

#test
test_eval_add() -> unit
    assert(eval_expr("2+3") == 5, "addition")

#test
test_eval_precedence() -> unit
    assert(eval_expr("2+3*4") == 14, "precedence")

#test
test_eval_parens() -> unit
    assert(eval_expr("(1+2)*3+4") == 13, "parens")

#test
test_eval_sub_div() -> unit
    assert(eval_expr("100-50/2") == 75, "sub and div")

#test
test_eval_nested_parens() -> unit
    assert(eval_expr("((2+3))") == 5, "nested parens")

#test
test_eval_complex() -> unit
    assert(eval_expr("(2+3)*(4-1)") == 15, "complex")

#test
test_eval_fail() -> unit
    assert(eval_expr("") == -1, "empty string fails")

#test
test_digit() -> unit
    digit("5abc", 0) match
        Ok(v, p) ->
            assert(v == 5, "digit value")
            assert(p == 1, "digit pos")
        Fail(_) -> panic("expected Ok")

#test
test_alt_first() -> unit
    parse_a_or_b("abc", 0) match
        Ok(v, _) -> assert(v == int('a'), "alt picks first")
        Fail(_) -> panic("expected Ok")

#test
test_alt_second() -> unit
    parse_a_or_b("bcd", 0) match
        Ok(v, _) -> assert(v == int('b'), "alt picks second")
        Fail(_) -> panic("expected Ok")

#test
test_alt_fail() -> unit
    parse_a_or_b("xyz", 0) match
        Ok(_, _) -> panic("expected Fail")
        Fail(_) -> assert(true, "alt fails correctly")

#test
test_map_negate() -> unit
    parse_neg("42", 0) match
        Ok(v, _) -> assert(v == -42, "map negates")
        Fail(_) -> panic("expected Ok")

#test
test_between_parens() -> unit
    parse_parens("(99)", 0) match
        Ok(v, p) ->
            assert(v == 99, "between value")
            assert(p == 4, "between consumed all")
        Fail(_) -> panic("expected Ok")

#test
test_between_missing_close() -> unit
    parse_parens("(99", 0) match
        Ok(_, _) -> panic("expected Fail")
        Fail(_) -> assert(true, "between fails on missing close")

#test
test_unwrap_or_ok() -> unit
    val r: Result[int] = Ok(42, 0)
    assert(unwrap_or(r, -1) == 42, "unwrap_or on Ok")

#test
test_unwrap_or_fail() -> unit
    val r: Result[int] = Fail(0)
    assert(unwrap_or(r, -1) == -1, "unwrap_or on Fail")

main() -> int
    val a = eval_expr("2+3*4")       // 14
    val b = eval_expr("(1+2)*3+4")   // 13
    val c = eval_expr("100-50/2")    // 75
    a + b + c
